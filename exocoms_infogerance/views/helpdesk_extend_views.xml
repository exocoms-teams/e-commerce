<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_form_inherit_infogerance" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.infogerance</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="x_infogerance_contract_id"
                       groups="sales_team.group_sale_salesman"/>
                <field name="x_equipment_id"
                       domain="[('contract_id', '=', x_infogerance_contract_id)]"
                       groups="sales_team.group_sale_salesman"/>
            </field>
            <field name="priority" position="after">
                <field name="x_intervention_type"/>
                <field name="x_is_paid_upfront"/>
                <field name="x_payment_date"
                       attrs="{'invisible': [('x_is_paid_upfront', '=', False)]}"/>
            </field>
            <footer position="after">
                <group name="anydesk_info" string="AnyDesk">
                    <field name="x_anydesk_id"/>
                    <button name="action_start_anydesk" type="object"
                            string="Lancer AnyDesk"
                            attrs="{'invisible': [('x_anydesk_id', '=', False)]}"
                            class="btn-info"/>
                    <button name="action_validate_intervention" type="object"
                            string="Valider le paiement"
                            attrs="{'invisible': [('x_is_paid_upfront', '=', True)]}"
                            class="btn-success"/>
                </group>
            </footer>
        </field>
    </record>

    <record id="helpdesk_ticket_view_kanban_inherit_infogerance" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban.inherit.infogerance</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_kanban"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="x_infogerance_contract_id"/>
                <field name="x_intervention_type"/>
                <field name="x_is_paid_upfront"/>
            </field>
        </field>
    </record>

    <record id="helpdesk_ticket_view_tree_inherit_infogerance" model="ir.ui.view">
        <field name="name">helpdesk.ticket.tree.inherit.infogerance</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="x_infogerance_contract_id"/>
                <field name="x_intervention_type"/>
                <field name="x_is_paid_upfront"/>
            </field>
        </field>
    </record>
</odoo>
