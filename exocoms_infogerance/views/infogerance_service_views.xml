<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_infogerance_service_tree" model="ir.ui.view">
        <field name="name">exocoms.infogerance.service.tree</field>
        <field name="model">exocoms.infogerance.service</field>
        <field name="arch" type="xml">
            <tree>
                <field name="contract_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="subtotal" sum="Total"/>
            </tree>
        </field>
    </record>

    <record id="view_infogerance_service_form" model="ir.ui.view">
        <field name="name">exocoms.infogerance.service.form</field>
        <field name="model">exocoms.infogerance.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="contract_id"/>
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="unit_price"/>
                        <field name="subtotal"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
