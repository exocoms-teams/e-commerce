<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_infogerance_equipment_tree" model="ir.ui.view">
        <field name="name">exocoms.infogerance.equipment.tree</field>
        <field name="model">exocoms.infogerance.equipment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="contract_id"/>
                <field name="equipment_name"/>
                <field name="equipment_type"/>
                <field name="serial_number"/>
                <field name="brand"/>
                <field name="location"/>
                <field name="anydesk_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_infogerance_equipment_form" model="ir.ui.view">
        <field name="name">exocoms.infogerance.equipment.form</field>
        <field name="model">exocoms.infogerance.equipment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="equipment_name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="equipment_type"/>
                            <field name="serial_number"/>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="date_installed"/>
                            <field name="warranty_end"/>
                            <field name="purchase_value"/>
                            <field name="ip_address"/>
                            <field name="mac_address"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Accès à distance">
                        <group>
                            <field name="anydesk_id"/>
                            <field name="anydesk_password" widget="password"/>
                        </group>
                    </group>
                    <group string="Photo">
                        <field name="image" widget="image"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" widget="html"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_exocoms_infogerance_equipment" model="ir.actions.act_window">
        <field name="name">Équipements</field>
        <field name="res_model">exocoms.infogerance.equipment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_exocoms_infogerance_equipment"
              name="Équipements"
              parent="menu_exocoms_infogerance"
              action="action_exocoms_infogerance_equipment"
              sequence="20"/>

</odoo>
