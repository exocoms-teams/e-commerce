<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ÉQUIPES HELPDESK INFOGÉRANCE -->
    <record id="helpdesk_team_infogerance" model="helpdesk.team">
        <field name="name">Support Infogérance</field>
        <field name="description">Équipe dédiée aux clients infogérance Exocoms</field>
        <field name="use_helpdesk_sale_timesheet" eval="True"/>
        <field name="use_rating" eval="True"/>
        <field name="use_sla" eval="True"/>
        <field name="auto_assignment" eval="True"/>
        <field name="assign_method">randomly</field>
    </record>

    <!-- Catégories gérées via le champ Selection x_ticket_category sur helpdesk.ticket
         (voir helpdesk_extend.py) — plus besoin de records helpdesk.ticket.type -->

    <!-- SLAs -->
    <record id="helpdesk_sla_critique" model="helpdesk.sla">
        <field name="name">SLA Critique - 4h</field>
        <field name="team_id" ref="helpdesk_team_infogerance"/>
        <field name="stage_id" ref="helpdesk.helpdesk_ticket_stage_new"/>
        <field name="priority">3</field>
        <field name="time" eval="4"/>
        <field name="time_unit">hour</field>
    </record>
    <record id="helpdesk_sla_normal" model="helpdesk.sla">
        <field name="name">SLA Normal - 24h</field>
        <field name="team_id" ref="helpdesk_team_infogerance"/>
        <field name="stage_id" ref="helpdesk.helpdesk_ticket_stage_new"/>
        <field name="priority">1</field>
        <field name="time" eval="24"/>
        <field name="time_unit">hour</field>
    </record>

</odoo>
