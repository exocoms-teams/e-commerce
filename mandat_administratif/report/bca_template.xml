<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_bca">
<t t-call="web.html_container">
<t t-foreach="docs" t-as="o">
<t t-call="web.external_layout">
<div class="page">

  <!-- EN-TÊTE -->
  <div class="row mb-3">
    <div class="col-7">
      <h2 class="text-primary mb-0">BON DE COMMANDE ADMINISTRATIF</h2>
      <h5 class="text-muted">MANDAT ADMINISTRATIF</h5>
      <small class="text-muted">
        Décret n°2012-1246 du 7/11/2012 (GBCP) | Art. L.1617-1 CGCT | Art. L.2192-10 CCP
      </small>
    </div>
    <div class="col-5">
      <table class="table table-sm table-bordered" style="font-size:9.5px;">
        <tr><td class="bg-light fw-bold" style="width:50%">N° de mandat</td>
            <td><strong><t t-esc="o.mandat_numero or 'En cours…'"/></strong></td></tr>
        <tr><td class="bg-light fw-bold">Réf. BCA organisme</td>
            <td><t t-esc="o.reference_bon_commande or '-'"/></td></tr>
        <tr><td class="bg-light fw-bold">Date d'émission</td>
            <td><t t-esc="o.date_order" t-options='{"widget":"date","format":"dd/MM/yyyy"}'/></td></tr>
        <tr><td class="bg-light fw-bold">Délai de paiement</td>
            <td><t t-esc="o.delai_paiement_jours"/> jours</td></tr>
        <tr><td class="bg-light fw-bold">Date limite paiement</td>
            <td><t t-if="o.date_limite_paiement">
                  <t t-esc="o.date_limite_paiement" t-options='{"widget":"date","format":"dd/MM/yyyy"}'/>
                </t><t t-else="">-</t></td></tr>
        <tr><td class="bg-light fw-bold">Nomenclature</td>
            <td><t t-esc="o.nomenclature_budgetaire or 'M14'"/></td></tr>
        <tr><td class="bg-light fw-bold">État</td>
            <td>
              <t t-if="o.mandat_state == 'draft'">BCA en attente</t>
              <t t-elif="o.mandat_state == 'bca_emis'">BCA émis</t>
              <t t-elif="o.mandat_state == 'service_fait'">Service fait certifié</t>
              <t t-elif="o.mandat_state == 'pec'">Prise en charge comptable</t>
              <t t-elif="o.mandat_state == 'mandate'">Mandaté</t>
              <t t-elif="o.mandat_state == 'paye'">Payé</t>
              <t t-elif="o.mandat_state == 'annule'">Annulé</t>
            </td></tr>
      </table>
    </div>
  </div>

  <hr style="border-top:2px solid #0d6efd;"/>

  <!-- PARTIES -->
  <div class="row mb-3">
    <div class="col-6">
      <div class="border p-2" style="background:#f0f7ff;font-size:10px;">
        <strong style="font-size:11px;">ACHETEUR PUBLIC</strong><br/>
        <strong><t t-esc="o.partner_id.name"/></strong><br/>
        <t t-if="o.acheteur_service"><em><t t-esc="o.acheteur_service"/></em><br/></t>
        <t t-if="o.partner_id.street"><t t-esc="o.partner_id.street"/><br/></t>
        <t t-if="o.partner_id.zip or o.partner_id.city">
          <t t-esc="o.partner_id.zip"/> <t t-esc="o.partner_id.city"/><br/>
        </t>
        <t t-if="o.acheteur_siret">
          SIRET : <strong><t t-esc="o.acheteur_siret"/></strong><br/>
        </t>
        <t t-if="o.acheteur_contact">Gestionnaire : <t t-esc="o.acheteur_contact"/><br/></t>
        <t t-if="o.comptable_public">
          Comptable assignataire : <t t-esc="o.comptable_public"/>
        </t>
      </div>
    </div>
    <div class="col-6">
      <div class="border p-2" style="background:#f0fff0;font-size:10px;">
        <strong style="font-size:11px;">FOURNISSEUR</strong><br/>
        <strong><t t-esc="o.company_id.name"/></strong><br/>
        <t t-if="o.company_id.street"><t t-esc="o.company_id.street"/><br/></t>
        <t t-if="o.company_id.zip or o.company_id.city">
          <t t-esc="o.company_id.zip"/> <t t-esc="o.company_id.city"/><br/>
        </t>
        <t t-if="o.company_id.vat">N° TVA : <t t-esc="o.company_id.vat"/><br/></t>
        <t t-if="o.fournisseur_iban">IBAN : <strong><t t-esc="o.fournisseur_iban"/></strong><br/></t>
        <t t-if="o.fournisseur_bic">BIC : <t t-esc="o.fournisseur_bic"/></t>
      </div>
    </div>
  </div>

  <!-- ENGAGEMENT -->
  <div class="bg-primary text-white p-1 px-2 mb-1" style="font-size:11px;font-weight:bold;">
    INFORMATIONS D'ENGAGEMENT
  </div>
  <table class="table table-sm table-bordered mb-3" style="font-size:9.5px;">
    <tr>
      <td class="bg-light fw-bold" style="width:25%">Objet</td>
      <td colspan="3"><t t-esc="o.objet_marche or '-'"/></td>
    </tr>
    <tr>
      <td class="bg-light fw-bold">N° EJ</td>
      <td><t t-esc="o.numero_engagement or '-'"/></td>
      <td class="bg-light fw-bold">Date engagement</td>
      <td>
        <t t-if="o.date_engagement">
          <t t-esc="o.date_engagement" t-options='{"widget":"date","format":"dd/MM/yyyy"}'/>
        </t><t t-else="">-</t>
      </td>
    </tr>
    <tr>
      <td class="bg-light fw-bold">N° marché</td>
      <td><t t-esc="o.numero_marche or '-'"/></td>
      <td class="bg-light fw-bold">Ordonnateur</td>
      <td>
        <t t-esc="o.ordonnateur or '-'"/>
        <t t-if="o.qualite_ordonnateur"> (<t t-esc="o.qualite_ordonnateur"/>)</t>
      </td>
    </tr>
  </table>

  <!-- IMPUTATION BUDGÉTAIRE -->
  <t t-if="o.imputation_ids">
  <div class="bg-primary text-white p-1 px-2 mb-1" style="font-size:11px;font-weight:bold;">
    IMPUTATION BUDGÉTAIRE
  </div>
  <table class="table table-sm table-bordered mb-3" style="font-size:9.5px;">
    <thead>
      <tr class="bg-light">
        <th>Section</th><th>Chapitre</th><th>Article</th>
        <th>Opération</th><th>Exercice</th>
        <th class="text-end">Crédit ouvert</th>
        <th class="text-end">Disponible</th>
        <th class="text-end">Montant engagé</th>
      </tr>
    </thead>
    <tbody>
      <t t-foreach="o.imputation_ids" t-as="imp">
      <tr>
        <td><t t-esc="'Fct' if imp.section == 'fonctionnement' else 'Inv'"/></td>
        <td><t t-esc="imp.chapitre"/></td>
        <td><t t-esc="imp.article"/></td>
        <td><t t-esc="imp.operation or '-'"/></td>
        <td><t t-esc="imp.exercice"/></td>
        <td class="text-end">
          <t t-esc="imp.credit_ouvert" t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
        </td>
        <td class="text-end">
          <t t-esc="imp.disponible" t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
        </td>
        <td class="text-end">
          <t t-esc="imp.montant_engage" t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
        </td>
      </tr>
      </t>
    </tbody>
  </table>
  </t>

  <!-- LIGNES DE COMMANDE -->
  <div class="bg-primary text-white p-1 px-2 mb-1" style="font-size:11px;font-weight:bold;">
    DÉTAIL DE LA COMMANDE
  </div>
  <table class="table table-sm table-striped mb-2" style="font-size:9.5px;">
    <thead>
      <tr class="bg-light">
        <th style="width:4%">N°</th>
        <th style="width:36%">Désignation</th>
        <th class="text-center">Qté</th>
        <th class="text-center">U.</th>
        <th class="text-end">P.U. HT</th>
        <th class="text-center">Rem.</th>
        <th class="text-center">TVA</th>
        <th class="text-end">Montant HT</th>
      </tr>
    </thead>
    <tbody>
      <t t-foreach="o.order_line" t-as="line">
      <tr>
        <td><t t-esc="line_index + 1"/></td>
        <td>
          <strong><t t-esc="line.product_id.name or line.name or ''"/></strong>
          <t t-if="line.name and line.product_id and line.name != line.product_id.name">
            <br/><small class="text-muted"><t t-esc="line.name"/></small>
          </t>
        </td>
        <td class="text-center"><t t-esc="line.product_uom_qty"/></td>
        <td class="text-center"><t t-esc="line.product_uom_id.name"/></td>
        <td class="text-end">
          <t t-esc="line.price_unit" t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
        </td>
        <td class="text-center">
          <t t-if="line.discount"><t t-esc="line.discount"/>%</t><t t-else="">-</t>
        </td>
        <td class="text-center">
          <t t-foreach="line.tax_ids" t-as="tax"><t t-esc="tax.amount"/>% </t>
        </td>
        <td class="text-end">
          <t t-esc="line.price_subtotal" t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
        </td>
      </tr>
      </t>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="7" class="text-end fw-bold">Total HT</td>
        <td class="text-end">
          <t t-esc="o.amount_untaxed" t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
        </td>
      </tr>
      <tr>
        <td colspan="7" class="text-end">TVA</td>
        <td class="text-end">
          <t t-esc="o.amount_tax" t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
        </td>
      </tr>
      <t t-if="o.regime_tva_public == 'fctva' and o.montant_fctva">
      <tr>
        <td colspan="7" class="text-end text-info">dont FCTVA récupérable (<t t-esc="o.taux_fctva"/>%)</td>
        <td class="text-end text-info">
          <t t-esc="o.montant_fctva" t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
        </td>
      </tr>
      </t>
      <tr style="background:#e9f5ff;">
        <td colspan="7" class="text-end fw-bold">TOTAL TTC (montant du mandat)</td>
        <td class="text-end fw-bold text-primary" style="font-size:1.05em;">
          <t t-esc="o.amount_total" t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
        </td>
      </tr>
    </tfoot>
  </table>

  <!-- SERVICE FAIT -->
  <t t-if="o.service_fait_certifie">
  <div class="bg-success text-white p-1 px-2 mb-1" style="font-size:11px;font-weight:bold;">
    CERTIFICATION DU SERVICE FAIT
  </div>
  <table class="table table-sm table-bordered mb-3" style="font-size:9.5px;">
    <tr>
      <td class="bg-light fw-bold">Certifié par</td>
      <td><t t-esc="o.certificateur_service_fait or '-'"/></td>
      <td class="bg-light fw-bold">Date</td>
      <td>
        <t t-if="o.date_service_fait">
          <t t-esc="o.date_service_fait" t-options='{"widget":"date","format":"dd/MM/yyyy"}'/>
        </t><t t-else="">-</t>
      </td>
    </tr>
    <t t-if="o.reserve_service_fait">
    <tr>
      <td class="bg-light fw-bold">Réserves</td>
      <td colspan="3"><t t-esc="o.reserve_service_fait"/></td>
    </tr>
    </t>
  </table>
  </t>

  <!-- PIÈCES JUSTIFICATIVES -->
  <t t-if="o.pj_ids">
  <div class="bg-primary text-white p-1 px-2 mb-1" style="font-size:11px;font-weight:bold;">
    PIÈCES JUSTIFICATIVES (Décret n°2016-33 du 20/01/2016)
  </div>
  <table class="table table-sm table-bordered mb-3" style="font-size:9.5px;">
    <thead>
      <tr class="bg-light">
        <th>Type</th><th>Libellé</th><th>Référence</th>
        <th class="text-center">Oblig.</th><th class="text-center">Fournie</th>
      </tr>
    </thead>
    <tbody>
      <t t-foreach="o.pj_ids" t-as="pj">
      <tr t-att-style="'background:#d4edda' if pj.fournie else ('background:#f8d7da' if pj.obligatoire else '')">
        <td><t t-esc="pj.type_pj"/></td>
        <td><t t-esc="pj.libelle"/></td>
        <td><t t-esc="pj.reference or '-'"/></td>
        <td class="text-center"><t t-if="pj.obligatoire">✓</t><t t-else="">–</t></td>
        <td class="text-center"><t t-if="pj.fournie">✓</t><t t-else="">✗</t></td>
      </tr>
      </t>
    </tbody>
  </table>
  </t>

  <!-- OBSERVATIONS -->
  <t t-if="o.note_mandat">
  <div class="bg-light p-1 px-2 mb-1 fw-bold" style="font-size:11px;">
    OBSERVATIONS / MENTIONS PARTICULIÈRES
  </div>
  <p style="font-size:9.5px;"><t t-esc="o.note_mandat"/></p>
  </t>

  <!-- SIGNATURES -->
  <div class="row mt-4">
    <div class="col-4 border text-center p-3" style="font-size:9.5px;">
      <p class="fw-bold">L'ORDONNATEUR</p>
      <p><t t-esc="o.ordonnateur or ''"/></p>
      <p><em><t t-esc="o.qualite_ordonnateur or ''"/></em></p>
      <br/>
      <div style="height:50px;border-bottom:1px dashed #aaa;"></div>
      <small class="text-muted">Signature et date</small>
    </div>
    <div class="col-4 border text-center p-3" style="font-size:9.5px;">
      <p class="fw-bold">LE COMPTABLE PUBLIC</p>
      <p><t t-esc="o.comptable_public or ''"/></p>
      <br/><br/>
      <div style="height:50px;border-bottom:1px dashed #aaa;"></div>
      <small class="text-muted">Visa et date de paiement</small>
    </div>
    <div class="col-4 border text-center p-3" style="font-size:9.5px;">
      <p class="fw-bold">LE FOURNISSEUR</p>
      <p><t t-esc="o.company_id.name"/></p>
      <br/><br/>
      <div style="height:50px;border-bottom:1px dashed #aaa;"></div>
      <small class="text-muted">Bon pour accord</small>
    </div>
  </div>

  <!-- MENTIONS LÉGALES -->
  <div class="mt-3 p-2" style="background:#f8f9fa;font-size:7.5px;border:1px solid #dee2e6;">
    <strong>Base légale :</strong>
    Art. L.2192-10 du Code de la commande publique : délai global de paiement =
    <t t-esc="o.delai_paiement_jours"/> jours.
    Tout dépassement donne lieu à intérêts moratoires (taux : <t t-esc="o.taux_interet_moratoire"/>%)
    et à une indemnité forfaitaire de <t t-esc="o.indemnite_forfaitaire"/>€ (art. L.2192-12 CCP).
    Comptable assignataire : <t t-esc="o.comptable_public or 'N/A'"/>.
    Le présent document constitue un engagement juridique de l'acheteur public.
  </div>

</div>
</t>
</t>
</t>
</template>
</odoo>
