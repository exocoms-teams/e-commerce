<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_bca" model="ir.actions.report">
        <field name="name">Bon de Commande Administratif (BCA)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mandat_administratif.report_bca</field>
        <field name="report_file">mandat_administratif.report_bca</field>
        <field name="print_report_name">'BCA-' + (object.mandat_numero or object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
    </record>

    <record id="action_report_bordereau" model="ir.actions.report">
        <field name="name">Bordereau de mandats</field>
        <field name="model">mandat.bordereau</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mandat_administratif.report_bordereau</field>
        <field name="report_file">mandat_administratif.report_bordereau</field>
        <field name="print_report_name">object.name or 'Bordereau'</field>
        <field name="binding_model_id" ref="mandat_administratif.model_mandat_bordereau"/>
    </record>
</odoo>
