<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_chorus" model="ir.ui.view">
        <field name="name">res.config.settings.form.chorus.pro</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='analytic']" position="after">
                <block title="Chorus Pro — Mandat administratif" id="chorus_pro_settings">
                    <setting id="chorus_api_setting"
                             string="Envoi automatique via l'API PISTE/AIFE"
                             help="Dépose les factures des entités publiques directement sur Chorus Pro (service deposerFluxFacture).">
                        <field name="chorus_api_active"/>
                        <div class="content-group" invisible="not chorus_api_active">
                            <div class="row mt8">
                                <label for="chorus_api_mode" class="col-lg-4 o_light_label"/>
                                <field name="chorus_api_mode" class="col-lg-6"/>
                            </div>
                            <div class="row">
                                <label for="chorus_piste_client_id" class="col-lg-4 o_light_label"/>
                                <field name="chorus_piste_client_id" class="col-lg-6" password="True"/>
                            </div>
                            <div class="row">
                                <label for="chorus_piste_client_secret" class="col-lg-4 o_light_label"/>
                                <field name="chorus_piste_client_secret" class="col-lg-6" password="True"/>
                            </div>
                            <div class="row">
                                <label for="chorus_technical_login" class="col-lg-4 o_light_label"/>
                                <field name="chorus_technical_login" class="col-lg-6"/>
                            </div>
                            <div class="row">
                                <label for="chorus_technical_password" class="col-lg-4 o_light_label"/>
                                <field name="chorus_technical_password" class="col-lg-6" password="True"/>
                            </div>
                            <div class="row">
                                <label for="chorus_flux_syntax" class="col-lg-4 o_light_label"/>
                                <field name="chorus_flux_syntax" class="col-lg-6"/>
                            </div>
                            <div class="mt8">
                                <button name="action_test_chorus_connection"
                                        type="object"
                                        string="Tester la connexion"
                                        class="btn-link"
                                        icon="fa-plug"/>
                            </div>
                            <div class="text-muted mt8">
                                Identifiants OAuth de votre application PISTE
                                (piste.gouv.fr) et compte technique créé sur
                                Chorus Pro (Raccordement API). Commencez en
                                Sandbox avec le portail de qualification.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
