<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulaire de redirection : poste la référence de transaction vers
         la route de traitement qui met la transaction en attente. -->
    <template id="redirect_form" name="Mandat administratif — formulaire de redirection">
        <form t-att-action="api_url" method="post">
            <input type="hidden" name="reference" t-att-value="reference"/>
        </form>
    </template>

</odoo>
