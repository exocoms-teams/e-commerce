<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_mandat_administratif" model="ir.ui.view">
        <field name="name">res.partner.form.mandat.administratif</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <widget name="web_ribbon" title="Entité publique" bg_color="text-bg-info"
                        invisible="not is_public_entity"/>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="inside">
                <group name="mandat_administratif" string="Mandat administratif – Chorus Pro">
                    <group>
                        <field name="is_public_entity"/>
                        <field name="nature_juridique" invisible="not is_public_entity"/>
                        <field name="nomenclature_budgetaire" invisible="not is_public_entity"/>
                        <field name="siret_public" invisible="not is_public_entity" placeholder="14 chiffres"/>
                    </group>
                    <group invisible="not is_public_entity">
                        <field name="chorus_service_code"/>
                        <field name="code_tiers_chorus"/>
                        <field name="chorus_engagement_required"/>
                        <field name="service_public"/>
                        <field name="comptable_public"/>
                        <field name="regime_tva_public"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_mandat" model="ir.ui.view">
        <field name="name">res.partner.select.mandat.administratif</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='type_company']" position="after">
                <separator/>
                <filter string="Entités publiques" name="public_entities"
                        domain="[('is_public_entity', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
