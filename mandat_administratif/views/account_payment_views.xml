<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ═══════════════════════════════════════════════════════════════════
     FORMULAIRE DE PAIEMENT — Mandat Administratif
     L'agent comptable sélectionne la méthode "Mandat Administratif"
     dans le champ standard "Méthode de paiement". Le bloc MA s'affiche
     automatiquement avec tous les champs obligatoires.
     ═══════════════════════════════════════════════════════════════════ -->

<record id="view_account_payment_form_ma" model="ir.ui.view">
    <field name="name">account.payment.form.mandat</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form"/>
    <field name="arch" type="xml">

        <!-- Champ calculé invisible nécessaire pour les conditions -->
        <xpath expr="//field[@name='payment_method_line_id']" position="after">
            <field name="is_mandat_administratif" invisible="1"/>
        </xpath>

        <!-- Tout le bloc MA s'insère après la référence de communication -->
        <xpath expr="//field[@name='memo']" position="after">

            <!-- ── Bandeau d'information ──────────────────────────────── -->
            <div class="alert alert-info mb-3" role="status" invisible="not is_mandat_administratif">
                🏛 <strong>Paiement par Mandat Administratif</strong> –
                Conformément au décret n°2012-1246 (GBCP) et à l'art. L.1617-1 CGCT.
                Tous les champs marqués * sont obligatoires avant validation.
            </div>

            <!-- ── Sélection du BCA source ────────────────────────────── -->
            <group string="📄 Documents sources" invisible="not is_mandat_administratif" col="2">
                <field name="mandat_sale_order_id"
                       help="Sélectionnez le BCA pour pré-remplir automatiquement les champs"/>
                <field name="mandat_invoice_id"
                       help="Facture liée au mandat (si disponible)"/>
            </group>

            <!-- ── Identification du mandat ───────────────────────────── -->
            <group string="🔖 Identification du mandat" invisible="not is_mandat_administratif" col="2">
                <field name="mandat_numero"          required="is_mandat_administratif"/>
                <field name="numero_engagement"/>
                <field name="reference_bon_commande"/>
                <field name="acheteur_siret"/>
                <field name="date_mandatement"       required="is_mandat_administratif"/>
                <field name="reference_bordereau"/>
            </group>

            <!-- ── Ordonnancement ─────────────────────────────────────── -->
            <group string="⚖️ Ordonnancement" invisible="not is_mandat_administratif" col="2">
                <field name="ordonnateur"         required="is_mandat_administratif"/>
                <field name="qualite_ordonnateur" required="is_mandat_administratif"/>
                <field name="comptable_public"    required="is_mandat_administratif"/>
            </group>

            <!-- ── Service fait (obligatoire) ────────────────────────── -->
            <group string="✅ Certification du service fait" invisible="not is_mandat_administratif" col="2">
                <field name="service_fait_certifie" widget="boolean_toggle"
                       required="is_mandat_administratif"/>
                <field name="date_service_fait" invisible="not service_fait_certifie"/>
                <field name="certificateur_sf"  invisible="not service_fait_certifie"/>
            </group>

            <!-- ── RIB fournisseur / virement SEPA ───────────────────── -->
            <group string="🏦 Virement SEPA – RIB fournisseur" invisible="not is_mandat_administratif" col="2">
                <field name="fournisseur_iban"   required="is_mandat_administratif"/>
                <field name="fournisseur_bic"/>
                <field name="fournisseur_banque"/>
                <field name="rib_certifie" widget="boolean_toggle" required="is_mandat_administratif"/>
            </group>

            <!-- ── Imputation budgétaire ──────────────────────────────── -->
            <group string="📊 Imputation budgétaire" invisible="not is_mandat_administratif">
                <field name="imputation_ids" nolabel="1" colspan="2">
                    <list editable="bottom">
                        <field name="section"/>
                        <field name="chapitre" required="1"/>
                        <field name="article"  required="1"/>
                        <field name="sous_article" optional="hide"/>
                        <field name="exercice"/>
                        <field name="montant_mandate"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
            </group>

            <!-- ── Pièces justificatives ──────────────────────────────── -->
            <group string="📎 Pièces justificatives (Décret n°2016-33)" invisible="not is_mandat_administratif">
                <field name="pj_ids" nolabel="1" colspan="2">
                    <list editable="bottom"
                          decoration-success="fournie"
                          decoration-danger="not fournie and obligatoire">
                        <field name="type_pj"/>
                        <field name="libelle"/>
                        <field name="obligatoire" widget="boolean_toggle"/>
                        <field name="fournie"     widget="boolean_toggle"/>
                        <field name="date_reception" invisible="not fournie"/>
                    </list>
                </field>
            </group>

            <!-- ── Chorus Pro ─────────────────────────────────────────── -->
            <group string="🌐 Chorus Pro" invisible="not is_mandat_administratif" col="2">
                <field name="structure_chorus"/>
                <field name="service_chorus"/>
                <field name="statut_chorus" widget="badge"/>
                <field name="numero_chorus" invisible="statut_chorus == 'non_envoye'"/>
            </group>

            <!-- ── Alerte intérêts moratoires ─────────────────────────── -->
            <div class="alert alert-warning" role="status"
                 invisible="not is_mandat_administratif or montant_interet_moratoire == 0">
                ⚠️ <strong>Intérêts moratoires calculés :</strong>
                <field name="montant_interet_moratoire" widget="monetary" nolabel="1" readonly="1"/>
                (à régler en sus du principal – art. L.2192-12 CCP)
            </div>

            <!-- ── Observations ───────────────────────────────────────── -->
            <group string="📝 Observations" invisible="not is_mandat_administratif">
                <field name="note_mandat" nolabel="1" colspan="2"/>
            </group>

        </xpath>
    </field>
</record>

<!-- Vue liste paiements : colonne N° mandat -->
<record id="view_account_payment_tree_ma" model="ir.ui.view">
    <field name="name">account.payment.tree.mandat</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_tree"/>
    <field name="arch" type="xml">
        <xpath expr="//list" position="inside">
            <field name="mandat_numero" optional="show" string="N° Mandat"/>
            <field name="is_mandat_administratif" optional="show" string="MA" widget="boolean"/>
        </xpath>
    </field>
</record>

</odoo>
