<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_mandat_administratif" model="ir.ui.view">
        <field name="name">account.move.form.mandat.administratif</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Boutons d'en-tête : dépôt Chorus Pro -->
            <xpath expr="//header" position="inside">
                <field name="is_public_entity_partner" invisible="1"/>
                <field name="chorus_sent" invisible="1"/>
                <button name="action_open_chorus_pro"
                        type="object"
                        string="Ouvrir Chorus Pro"
                        invisible="not is_public_entity_partner or move_type not in ('out_invoice', 'out_refund')"/>
                <button name="action_mark_chorus_sent"
                        type="object"
                        string="Déposée sur Chorus Pro"
                        class="btn-secondary"
                        invisible="not is_public_entity_partner or chorus_sent or state != 'posted' or move_type not in ('out_invoice', 'out_refund')"/>
                <button name="action_reset_chorus_sent"
                        type="object"
                        string="Annuler le dépôt Chorus Pro"
                        invisible="not chorus_sent"/>
            </xpath>

            <!-- Onglet Autres informations : bloc Chorus Pro -->
            <xpath expr="//page[@name='other_info']" position="inside">
                <group name="mandat_administratif"
                       string="Mandat administratif — Chorus Pro"
                       invisible="not is_public_entity_partner">
                    <group>
                        <field name="engagement_juridique"
                               placeholder="ex. EJ2600012345"/>
                        <field name="chorus_service_code"/>
                    </group>
                    <group>
                        <field name="chorus_sent" readonly="1"/>
                        <field name="chorus_sent_date" readonly="1"
                               invisible="not chorus_sent"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>

    <!-- Filtre : factures d'entités publiques non déposées sur Chorus Pro -->
    <record id="view_account_invoice_filter_mandat" model="ir.ui.view">
        <field name="name">account.move.select.mandat.administratif</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='draft']" position="before">
                <filter string="À déposer sur Chorus Pro"
                        name="chorus_to_send"
                        domain="[('partner_id.commercial_partner_id.is_public_entity', '=', True), ('chorus_sent', '=', False), ('state', '=', 'posted')]"/>
                <filter string="Déposées sur Chorus Pro"
                        name="chorus_sent"
                        domain="[('chorus_sent', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

</odoo>
