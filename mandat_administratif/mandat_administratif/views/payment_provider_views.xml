<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form_mandat_administratif" model="ir.ui.view">
        <field name="name">payment.provider.form.mandat.administratif</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="after">
                <group name="mandat_administratif_config"
                       string="Mandat administratif"
                       invisible="code != 'mandat_administratif'">
                    <field name="mandat_payment_delay"/>
                    <field name="mandat_require_engagement"/>
                    <div class="text-muted" colspan="2">
                        Ce mode de paiement n'est proposé au checkout qu'aux
                        clients marqués « Entité publique (mandat administratif) »
                        sur leur fiche contact. La transaction est mise en attente,
                        la facture est ensuite déposée sur Chorus Pro et réglée
                        par virement du comptable public.
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
