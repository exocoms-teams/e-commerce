<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Création du site Cam Surveillance -->
        <record id="cam_surveillance_website" model="website">
            <field name="name">Cam Surveillance Store</field>
            <field name="sequence">20</field>
            <field name="homepage_url">/cam-home</field>
        </record>

        <!-- Menu du site -->
        <record id="menu_accueil" model="website.menu">
            <field name="name">Accueil</field>
            <field name="url">/cam-home</field>
            <field name="website_id" ref="cam_surveillance_website"/>
            <field name="sequence">10</field>
        </record>

        <record id="menu_cameras" model="website.menu">
            <field name="name">Caméras réseau</field>
            <field name="url">/shop</field>
            <field name="website_id" ref="cam_surveillance_website"/>
            <field name="sequence">20</field>
        </record>

        <record id="menu_enregistreurs" model="website.menu">
            <field name="name">Enregistreurs</field>
            <field name="url">/shop</field>
            <field name="website_id" ref="cam_surveillance_website"/>
            <field name="sequence">30</field>
        </record>

        <record id="menu_controle" model="website.menu">
            <field name="name">Contrôle d'accès</field>
            <field name="url">/shop</field>
            <field name="website_id" ref="cam_surveillance_website"/>
            <field name="sequence">40</field>
        </record>

        <record id="menu_contact" model="website.menu">
            <field name="name">Contact</field>
            <field name="url">/contactus</field>
            <field name="website_id" ref="cam_surveillance_website"/>
            <field name="sequence">50</field>
        </record>

    </data>
</odoo>