<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Catégories produits internes (nouvelles familles) -->
        <record id="cam_categ_access_control" model="product.category">
            <field name="name">Contrôle d'accès</field>
        </record>

        <record id="cam_categ_storage" model="product.category">
            <field name="name">Stockage et enregistreurs</field>
        </record>

        <!-- Catégories publiques (affichage sur /shop) -->
        <record id="cam_public_categ_access_control" model="product.public.category">
            <field name="name">Contrôle d'accès</field>
        </record>

        <record id="cam_public_categ_storage" model="product.public.category">
            <field name="name">Stockage et enregistreurs</field>
        </record>

        <!-- PRODUIT 1 -->
        <record id="cam_product_1" model="product.template">
            <field name="name">AXIS M3905-R Dome Camera</field>
            <field name="list_price">450.00</field>
            <field name="type">consu</field>
            <field name="is_published">True</field>
            <field name="website_id" ref="cam_surveillance_website"/>
            <field name="image_1920" type="base64" file="cam_surveillance/static/src/img/cam1.jpg"/>
            <field name="description_sale">Caméra dôme de surveillance embarquée pour intérieur, vidéo HDTV 2 MP.</field>
            <field name="categ_id" ref="camera_reseau"/>
            <field name="public_categ_ids" eval="[(4, ref('public_camera_reseau'))]"/>
        </record>

        <!-- PRODUIT 2 -->
        <record id="cam_product_2" model="product.template">
            <field name="name">AXIS P9117-PV Corner Camera</field>
            <field name="list_price">890.00</field>
            <field name="type">consu</field>
            <field name="is_published">True</field>
            <field name="website_id" ref="cam_surveillance_website"/>
            <field name="image_1920" type="base64" file="cam_surveillance/static/src/img/cam2.jpg"/>
            <field name="description_sale">Caméra d'angle 6 MP sans angle mort, idéale pour les zones sensibles.</field>
            <field name="categ_id" ref="camera_reseau"/>
            <field name="public_categ_ids" eval="[(4, ref('public_camera_reseau'))]"/>
        </record>

        <!-- PRODUIT 3 -->
        <record id="cam_product_3" model="product.template">
            <field name="name">AXIS Q9227-SLV Corner Camera</field>
            <field name="list_price">1290.00</field>
            <field name="type">consu</field>
            <field name="is_published">True</field>
            <field name="website_id" ref="cam_surveillance_website"/>
            <field name="image_1920" type="base64" file="cam_surveillance/static/src/img/cam3.jpg"/>
            <field name="description_sale">Caméra 5 MP anti-ligature résistante aux chocs, acier inoxydable.</field>
            <field name="categ_id" ref="camera_reseau"/>
            <field name="public_categ_ids" eval="[(4, ref('public_camera_reseau'))]"/>
        </record>

        <!-- PRODUIT 4 -->
        <record id="cam_product_4" model="product.template">
            <field name="name">AXIS Q9307-LV Dome Camera</field>
            <field name="list_price">99.99</field>
            <field name="type">consu</field>
            <field name="is_published">True</field>
            <field name="website_id" ref="cam_surveillance_website"/>
            <field name="image_1920" type="base64" file="cam_surveillance/static/src/img/cam4.jpg"/>
            <field name="description_sale">Caméra dôme fixe avec vision nocturne et grand angle, idéale en intérieur.</field>
            <field name="categ_id" ref="camera_reseau"/>
            <field name="public_categ_ids" eval="[(4, ref('public_camera_reseau'))]"/>
        </record>

        <!-- ===================== CONTRÔLE D'ACCÈS ===================== -->

        <!-- PRODUIT 5 -->
        <record id="cam_product_5" model="product.template">
            <field name="name">Lecteur de badge RFID</field>
            <field name="list_price">149.00</field>
            <field name="type">consu</field>
            <field name="is_published">True</field>
            <field name="website_id" ref="cam_surveillance_website"/>
            <field name="categ_id" ref="cam_categ_access_control"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('cam_public_categ_access_control')])]"/>
            <field name="description_sale">Lecteur de badge RFID pour contrôle d'accès, compatible cartes et badges de proximité 13.56 MHz.</field>
        </record>

        <!-- PRODUIT 6 -->
        <record id="cam_product_6" model="product.template">
            <field name="name">Interphone vidéo IP</field>
            <field name="list_price">329.00</field>
            <field name="type">consu</field>
            <field name="is_published">True</field>
            <field name="website_id" ref="cam_surveillance_website"/>
            <field name="categ_id" ref="cam_categ_access_control"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('cam_public_categ_access_control')])]"/>
            <field name="description_sale">Interphone vidéo IP avec caméra grand angle, audio bidirectionnel et intégration réseau.</field>
        </record>

        <!-- PRODUIT 7 -->
        <record id="cam_product_7" model="product.template">
            <field name="name">Gâche électrique 12V</field>
            <field name="list_price">79.00</field>
            <field name="type">consu</field>
            <field name="is_published">True</field>
            <field name="website_id" ref="cam_surveillance_website"/>
            <field name="categ_id" ref="cam_categ_access_control"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('cam_public_categ_access_control')])]"/>
            <field name="description_sale">Gâche électrique 12V pour portes et portails, compatible avec la plupart des systèmes de contrôle d'accès.</field>
        </record>

        <!-- ===================== STOCKAGE ET ENREGISTREURS ===================== -->

        <!-- PRODUIT 8 -->
        <record id="cam_product_8" model="product.template">
            <field name="name">Enregistreur NVR 8 voies</field>
            <field name="list_price">399.00</field>
            <field name="type">consu</field>
            <field name="is_published">True</field>
            <field name="website_id" ref="cam_surveillance_website"/>
            <field name="categ_id" ref="cam_categ_storage"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('cam_public_categ_storage')])]"/>
            <field name="description_sale">Enregistreur réseau NVR 8 voies, compatible caméras IP jusqu'à 8 MP, gestion à distance.</field>
        </record>

        <!-- PRODUIT 9 -->
        <record id="cam_product_9" model="product.template">
            <field name="name">Disque dur surveillance 4 To</field>
            <field name="list_price">129.00</field>
            <field name="type">consu</field>
            <field name="is_published">True</field>
            <field name="website_id" ref="cam_surveillance_website"/>
            <field name="categ_id" ref="cam_categ_storage"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('cam_public_categ_storage')])]"/>
            <field name="description_sale">Disque dur 4 To spécialement conçu pour l'enregistrement vidéo continu 24/7.</field>
        </record>

        <!-- PRODUIT 10 -->
        <record id="cam_product_10" model="product.template">
            <field name="name">Enregistreur NVR 16 voies</field>
            <field name="list_price">699.00</field>
            <field name="type">consu</field>
            <field name="is_published">True</field>
            <field name="website_id" ref="cam_surveillance_website"/>
            <field name="categ_id" ref="cam_categ_storage"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('cam_public_categ_storage')])]"/>
            <field name="description_sale">Enregistreur réseau NVR 16 voies haute capacité, idéal pour sites multi-caméras.</field>
        </record>

    </data>
</odoo>