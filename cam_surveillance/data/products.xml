        <!-- PRODUIT 8 : NVR 8 voies -->
        <record id="nvr_8" model="product.template">
            <field name="name">Enregistreur NVR 8 voies</field>
            <field name="list_price">399.00</field>
            <field name="type">consu</field>
            <field name="is_storable">True</field>
            <field name="is_published">True</field>
            <field name="website_id" ref="cam_surveillance_website"/>
            <field name="categ_id" ref="enregistreur_nvr"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('public_enregistreur_nvr')])]"/>
            <field name="description_sale">Enregistreur réseau NVR 8 voies, compatible caméras IP jusqu'à 8 MP, gestion à distance.</field>
            <field name="attribute_line_ids" eval="[
                    (0, 0, {
                        'attribute_id': ref('product_attribute_enregistreur'),
                        'value_ids': [(6, 0, [ref('attrib_value_enregistreur_nvr')])]
                    }),
                    (0, 0, {
                        'attribute_id': ref('nb_voies_enregistrement'),
                        'value_ids': [(6, 0, [ref('nb_voies_enregistrement_8')])]
                    })
                ]"/>
        </record>

