<?xml version="1.0" encoding="utf-8"?>
<!--
Liste des produits disponibles sur le /shop

Les images des produits sont en .webp
Voir categories.xml pour plus d'information sur les filtres

-->


<odoo>
    <data noupdate="1">

       <!-- ===================== CAMÉRAS DE SURVEILLANCE ===================== -->

        <!-- PRODUIT 1 -->
        <record id="cam_product_1" model="product.template">
                <field name="name">AXIS M3905-R Dome Camera</field>
                <field name="list_price">450.00</field>
                <field name="type">consu</field> 
                <field name="is_published">True</field>
                <field name="website_id" ref="cam_surveillance_website"/>
                <field name="image_1920" type="base64" file="cam_surveillance/static/src/img/cam1.webp"/>
                <field name="description_sale">Caméra dôme de surveillance embarquée pour intérieur, vidéo HDTV 2 MP.</field>
                <field name="categ_id" ref="cam_dome"/>
                <field name="public_categ_ids" eval="[(4, ref('public_cam_dome'))]"/>
                <field name="product_tag_ids" eval="[(6, 0, [ref('brand_axis'), ref('interieur')])]"/>
                <field name="attribute_line_ids" eval="[
                        (0, 0, {
                            'attribute_id': ref('camera_resolution'),
                            'value_ids': [(6, 0, [ref('camera_resolution_1080p')])]
                        })
                    ]"/>
            </record>

