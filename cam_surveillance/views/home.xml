<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue de la page d'accueil -->
    <record id="cam_home_view" model="ir.ui.view">
        <field name="name">cam.home</field>
        <field name="type">qweb</field>
        <field name="key">cam_surveillance.cam_home</field>
        <field name="arch" type="xml">
            <t t-name="cam_surveillance.cam_home">
                <t t-call="website.layout">
                    <div id="wrap">

                        <!-- Hero -->
                        <section class="cam-hero">
                            <div class="cam-hero-content">
                                <div class="cam-hero-badge">Revendeur certifié AXIS · Vidéosurveillance professionnelle</div>
                                <h1 class="cam-hero-title">La sécurité intelligente
                                    <span>pour votre entreprise</span>
                                </h1>
                                <p class="cam-hero-subtitle">Caméras réseau, contrôle d'accès et solutions de vidéosurveillance. Livraison rapide et support technique gratuit.</p>
                                <div class="cam-hero-buttons">
                                    <a href="/shop" class="cam-btn-primary">Voir nos produits</a>
                                   <a href="/contactus" class="cam-btn-secondary cam-btn-audit">Demander un audit gratuit</a>
                                </div>
                                <div class="cam-hero-stats">
                                    <div class="cam-stat">
                                        <span class="cam-stat-number">500+</span>
                                        <span class="cam-stat-label">Produits</span>
                                    </div>
                                    <div class="cam-stat">
                                        <span class="cam-stat-number">24/7</span>
                                        <span class="cam-stat-label">Support</span>
                                    </div>
                                    <div class="cam-stat">
                                        <span class="cam-stat-number">5 ans</span>
                                        <span class="cam-stat-label">Garantie</span>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Bandeau promo -->
                        <div class="cam-promo-banner">
                            <div class="cam-promo-track">
                                <span>Livraison gratuite dès 500€</span>
                                <span>Support technique offert</span>
                                <span>Garantie 5 ans AXIS</span>
                                <span>Revendeur certifié AXIS</span>
                                <span>Expédition sous 24h</span>
                                <span>Livraison gratuite dès 500€</span>
                                <span>Support technique offert</span>
                                <span>Garantie 5 ans AXIS</span>
                                <span>Revendeur certifié AXIS</span>
                                <span>Expédition sous 24h</span>
                            </div>
                        </div>

                        <!-- Produits -->
                        <section class="cam-products">
                            <div class="cam-container">
                                <div class="cam-section-header">
                                    <h2>Nos produits les plus demandés</h2>
                                    <p>Caméras et équipements AXIS certifiés, prêts à déployer</p>
                                </div>
                                <div class="cam-products-grid">
                                    <t t-foreach="request.env['product.template'].search([('is_published','=',True)], limit=8)" t-as="product">
                                        <a t-attf-href="/shop/#{product.id}" class="cam-product-card">
                                            <div class="cam-product-img">
                                                <t t-if="product.image_512">
                                                    <img t-attf-src="/web/image/product.template/#{product.id}/image_512" t-att-alt="product.name"/>
                                                </t>
                                                <t t-else="">
                                                    <div class="cam-product-noimg">—</div>
                                                </t>
                                            </div>
                                            <div class="cam-product-body">
                                                <h3 t-esc="product.name"/>
                                                <div class="cam-product-footer">
                                                    <span class="cam-product-price" t-esc="'%.2f € HT' % product.list_price"/>
                                                    <span class="cam-btn-sm">Voir</span>
                                                </div>
                                            </div>
                                        </a>
                                    </t>
                                </div>
                                <div class="cam-products-footer">
                                    <a href="/shop" class="cam-btn-secondary">Voir tous nos produits</a>
                                </div>
                            </div>
                        </section>

                        <!-- Catégories -->
                        <section class="cam-categories">
                            <div class="cam-container">
                                <div class="cam-section-header">
                                    <h2>Nos catégories de produits</h2>
                                    <p>Large gamme de produits IP à plateforme ouverte AXIS</p>
                                </div>
                                <div class="cam-cat-grid">
                                    <a href="/shop/category/cameras-reseaux-1" class="cam-cat-card">
                                        <h3>Caméras réseau</h3>
                                        <p>Innovation, qualité et performance</p>
                                        <span class="cam-cat-link">Voir</span>
                                    </a>
                                    <a href="/shop/category/stockage_enregistreurs-2" class="cam-cat-card">
                                        <h3>Stockage et enregistreurs</h3>
                                        <p>Solutions cloud, edge et on-site</p>
                                        <span class="cam-cat-link">Voir</span>
                                    </a>
                                    <a href="/shop/category/controle_acces-3" class="cam-cat-card cam-cat-featured">
                                        <h3>Contrôle d'accès</h3>
                                        <p>Flexible et sécurisé</p>
                                        <span class="cam-cat-link">Voir</span>
                                    </a>
                                    <a href="/shop/category/audio_reseau-4" class="cam-cat-card">
                                        <h3>Audio réseau</h3>
                                        <p>Le son chic et facile</p>
                                        <span class="cam-cat-link">Voir</span>
                                    </a>
                                    <a href="/shop/category/periferiques_radar-5" class="cam-cat-card">
                                        <h3>Périphériques radar</h3>
                                        <p>Protection étendue</p>
                                        <span class="cam-cat-link">Voir</span>
                                    </a>
                                    <a href="/shop/category/accesoires-6" class="cam-cat-card">
                                        <h3>Accessoires</h3>
                                        <p>Tout pour compléter vos systèmes</p>
                                        <span class="cam-cat-link">Voir</span>
                                    </a>
                                </div>
                            </div>
                        </section>

                        <!-- Pourquoi nous -->
                        <section class="cam-why">
                            <div class="cam-container">
                                <div class="cam-section-header">
                                    <h2>Pourquoi nous choisir ?</h2>
                                    <p>La référence en vidéosurveillance professionnelle</p>
                                </div>
                                <div class="cam-why-grid">
                                    <div class="cam-why-card">
                                        <h3>Revendeur certifié AXIS</h3>
                                        <p>Partenaire officiel AXIS Communications, leader mondial de la vidéosurveillance IP</p>
                                    </div>
                                    <div class="cam-why-card">
                                        <h3>Livraison rapide</h3>
                                        <p>Expédition sous 24h pour tous les produits en stock</p>
                                    </div>
                                    <div class="cam-why-card">
                                        <h3>Support technique gratuit</h3>
                                        <p>Notre équipe d'experts vous accompagne à chaque étape</p>
                                    </div>
                                    <div class="cam-why-card">
                                        <h3>Garantie 5 ans</h3>
                                        <p>Tous nos produits AXIS bénéficient d'une garantie de 5 ans</p>
                                    </div>
                                </div>
                            </div>
                        </section>

                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- Page liée au site Cam Surveillance -->
    <record id="cam_home_page" model="website.page">
        <field name="name">Accueil</field>
        <field name="url">/</field>
        <field name="website_id" ref="cam_surveillance_website"/>
        <field name="view_id" ref="cam_home_view"/>
        <field name="is_published">True</field>
        <field name="priority">1</field>
    </record>

</odoo>