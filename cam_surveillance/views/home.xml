<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- La vue de la page d'accueil -->
    <record id="cam_home_view" model="ir.ui.view">
        <field name="name">cam.home</field>
        <field name="type">qweb</field>
        <field name="key">cam_surveillance.cam_home</field>
        <field name="arch" type="xml">
            <t t-name="cam_surveillance.cam_home">
                <t t-call="website.layout">
                    <div id="wrap">

                        <!-- HERO -->
                        <section class="cam-hero">
                            <div class="cam-hero-content">
                                <div class="cam-hero-badge">
                                    Revendeur certifié AXIS · Vidéosurveillance professionnelle
                                </div>
                                <h1 class="cam-hero-title">
                                    La sécurité intelligente
                                    <span>pour votre entreprise</span>
                                </h1>
                                <p class="cam-hero-subtitle">
                                    Caméras réseau, contrôle d'accès et solutions de vidéosurveillance.
                                    Livraison rapide et support technique gratuit.
                                </p>
                                <div class="cam-hero-buttons">
                                    <a href="/shop" class="cam-btn-primary">Voir nos produits</a>
                                    <a href="/contact" class="cam-btn-secondary">Demander un audit gratuit</a>
                                </div>
                            </div>
                        </section>

                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- La page liée à TON site -->
    <record id="cam_home_page" model="website.page">
        <field name="name">Accueil</field>
        <field name="url">/cam-home</field>
        <field name="website_id" ref="cam_surveillance_website"/>
        <field name="view_id" ref="cam_home_view"/>
        <field name="is_published">True</field>
    </record>

<!-- CATÉGORIES -->
                <section class="cam-categories">
                    <div class="cam-container">
                        <div class="cam-section-header">
                            <h2>Nos Catégories de Produits</h2>
                            <p>Large gamme de produits AXIS</p>
                        </div>
                        <div class="cam-cat-grid">
                            <a href="/shop" class="cam-cat-card">
                                <div class="cam-cat-icon">📷</div>
                                <h3>Caméras réseau</h3>
                                <p>Innovation et qualité</p>
                            </a>
                            <a href="/shop" class="cam-cat-card">
                                <div class="cam-cat-icon">💾</div>
                                <h3>Enregistreurs</h3>
                                <p>Stockage fiable</p>
                            </a>
                            <a href="/shop" class="cam-cat-card cam-cat-featured">
                                <div class="cam-cat-icon">🔐</div>
                                <h3>Contrôle d'accès</h3>
                                <p>Flexible et sécurisé</p>
                            </a>
                            <a href="/shop" class="cam-cat-card">
                                <div class="cam-cat-icon">🔊</div>
                                <h3>Audio réseau</h3>
                                <p>Son professionnel</p>
                            </a>
                            <a href="/shop" class="cam-cat-card">
                                <div class="cam-cat-icon">📡</div>
                                <h3>Radar</h3>
                                <p>Protection étendue</p>
                            </a>
                            <a href="/shop" class="cam-cat-card">
                                <div class="cam-cat-icon">🔩</div>
                                <h3>Accessoires</h3>
                                <p>Tout le nécessaire</p>
                            </a>
                        </div>
                    </div>
                </section>
</odoo>