<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue de la page d'accueil -->
    <record id="cam_home_view" model="ir.ui.view">
        <field name="name">cam.home</field>
        <field name="type">qweb</field>
        <field name="key">cam_surveillance.cam_home</field>
        <field name="arch" type="xml">
            <t t-name="cam_surveillance.cam_home">
                <t t-call="website.layout">
                    <div id="wrap">

                        <!-- Hero Section Slide 4 -->
                        <section class="cam-hero">
                            <div class="cam-hero-content">
                                <div class="cam-hero-badge">
                                    <i class="fa fa-check-circle me-1" aria-hidden="true"/> Revendeur certifié AXIS · Vidéosurveillance professionnelle
                                </div>
                                <h1 class="cam-hero-title">La sécurité intelligente
                                    <span>pour votre entreprise</span>
                                </h1>
                                <p class="cam-hero-subtitle">Caméras réseau, contrôle d'accès et solutions de vidéosurveillance. Livraison rapide et support technique gratuit.</p>
                                
                                <div class="cam-hero-buttons">
                                    <a href="/shop" class="cam-btn-primary">Voir nos produits</a>
                                    <a href="/contactus" class="cam-btn-secondary cam-btn-audit">Demander un audit gratuit</a>
                                </div>

                                <div class="cam-hero-stats">
                                    <div class="cam-stat">
                                        <span class="cam-stat-number">500+</span>
                                        <span class="cam-stat-label">Produits certifiés</span>
                                    </div>
                                    <div class="cam-stat">
                                        <span class="cam-stat-number">24/7</span>
                                        <span class="cam-stat-label">Support expert</span>
                                    </div>
                                    <div class="cam-stat">
                                        <span class="cam-stat-number">5 ans</span>
                                        <span class="cam-stat-label">Garantie constructeur</span>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Produits les plus demandés -->
                        <section class="cam-products">
                            <div class="cam-container">
                                <div class="cam-section-header">
                                    <h2>Nos produits les plus demandés</h2>
                                    <p>Caméras et équipements AXIS certifiés, prêts à déployer</p>
                                </div>
                                <div class="cam-products-grid">
                                    <t t-foreach="request.env['product.template'].search([('is_published','=',True)], order='sales_count desc', limit=8)" t-as="product">
                                        <a t-attf-href="/shop/#{product.id}" class="cam-product-card">
                                            <div class="cam-product-img">
                                                <t t-if="product.image_512">
                                                    <img t-attf-src="/web/image/product.template/#{product.id}/image_512" t-att-alt="product.name" loading="lazy"/>
                                                </t>
                                                <t t-else="">
                                                    <div class="cam-product-noimg">—</div>
                                                </t>
                                            </div>
                                            <div class="cam-product-body">
                                                <h3 t-esc="product.name"/>
                                                
                                                <!-- Badge Stock -->
                                                <div class="cam-stock-status mt-1 mb-2">
                                                    <t t-if="'qty_available' in product._fields">
                                                        <t t-if="product.sudo().qty_available &gt; 0">
                                                            <span class="badge bg-success text-white">
                                                                <i class="fa fa-box me-1"/> En stock (<t t-esc="int(product.sudo().qty_available)"/>)
                                                            </span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge bg-danger text-white">
                                                                <i class="fa fa-times-circle me-1"/> Rupture de stock
                                                            </span>
                                                        </t>
                                                    </t>
                                                </div>
                                                
                                                <div class="cam-product-footer">
                                                    <span class="cam-product-price">
                                                        <span t-field="product.list_price"
                                                              t-options="{
                                                                  'widget': 'monetary',
                                                                  'display_currency': website.currency_id,
                                                              }"/>
                                                        <t t-esc="'HT' if website.show_line_subtotals_tax_selection == 'tax_excluded' else 'TTC'"/>
                                                    </span>
                                                    <span class="cam-btn-sm">Voir</span>
                                                </div>
                                            </div>
                                        </a>
                                    </t>
                                </div>
                                <div class="cam-products-footer">
                                    <a href="/shop" class="cam-btn-secondary">Voir tous nos produits</a>
                                </div>
                            </div>
                        </section>

                        <!-- Catégories -->
                        <section class="cam-categories">
                            <div class="cam-container">
                                <div class="cam-section-header">
                                    <h2>Nos catégories de produits</h2>
                                    <p>Large gamme de produits IP à plateforme ouverte AXIS</p>
                                </div>
                                <div class="cam-cat-grid">
                                    <t t-foreach="request.env['product.public.category'].search([('parent_id', '=', False)])" t-as="cat">
                                        <a t-attf-href="/shop/category/#{slug(cat)}" class="cam-cat-card">
                                            <h3 t-field="cat.name"/>
                                            <p>Découvrez notre gamme</p>
                                            <span class="cam-cat-link">Voir la catégorie</span>
                                        </a>
                                    </t>
                                </div>
                            </div>
                        </section>

                        <!-- Marques Partenaires avec images placeholders / icônes au-dessus du nom -->
                        <section class="cam-brands">
                            <div class="cam-container">
                                <div class="cam-section-header">
                                    <h2>Nos marques partenaires</h2>
                                    <p>Les plus grands constructeurs mondiaux de vidéosurveillance et contrôle d'accès</p>
                                </div>
                                <div class="cam-brands-grid">
                                    <div class="cam-brand-card">
                                        <div class="cam-brand-img-wrap">
                                            <img src="/cam_surveillance/static/src/img/brands/axis.png" alt="AXIS" loading="lazy" t-att-onerror="'this.style.display=\\'none\\'; this.nextElementSibling.style.display=\\'block\\';'"/>
                                            <i class="fa fa-shield-alt cam-brand-icon-fallback" style="display:none;"/>
                                        </div>
                                        <span class="cam-brand-logo">AXIS</span>
                                    </div>
                                    <div class="cam-brand-card">
                                        <div class="cam-brand-img-wrap">
                                            <img src="/cam_surveillance/static/src/img/brands/hikvision.png" alt="HIKVISION" loading="lazy" t-att-onerror="'this.style.display=\\'none\\'; this.nextElementSibling.style.display=\\'block\\';'"/>
                                            <i class="fa fa-video cam-brand-icon-fallback" style="display:none;"/>
                                        </div>
                                        <span class="cam-brand-logo">HIKVISION</span>
                                    </div>
                                    <div class="cam-brand-card">
                                        <div class="cam-brand-img-wrap">
                                            <img src="/cam_surveillance/static/src/img/brands/dahua.png" alt="DAHUA" loading="lazy" t-att-onerror="'this.style.display=\\'none\\'; this.nextElementSibling.style.display=\\'block\\';'"/>
                                            <i class="fa fa-camera-retro cam-brand-icon-fallback" style="display:none;"/>
                                        </div>
                                        <span class="cam-brand-logo">DAHUA</span>
                                    </div>
                                    <div class="cam-brand-card">
                                        <div class="cam-brand-img-wrap">
                                            <img src="/cam_surveillance/static/src/img/brands/reolink.png" alt="REOLINK" loading="lazy" t-att-onerror="'this.style.display=\\'none\\'; this.nextElementSibling.style.display=\\'block\\';'"/>
                                            <i class="fa fa-eye cam-brand-icon-fallback" style="display:none;"/>
                                        </div>
                                        <span class="cam-brand-logo">REOLINK</span>
                                    </div>
                                    <div class="cam-brand-card">
                                        <div class="cam-brand-img-wrap">
                                            <img src="/cam_surveillance/static/src/img/brands/bosch.png" alt="BOSCH" loading="lazy" t-att-onerror="'this.style.display=\\'none\\'; this.nextElementSibling.style.display=\\'block\\';'"/>
                                            <i class="fa fa-cogs cam-brand-icon-fallback" style="display:none;"/>
                                        </div>
                                        <span class="cam-brand-logo">BOSCH</span>
                                    </div>
                                    <div class="cam-brand-card">
                                        <div class="cam-brand-img-wrap">
                                            <img src="/cam_surveillance/static/src/img/brands/hanwha.png" alt="HANWHA" loading="lazy" t-att-onerror="'this.style.display=\\'none\\'; this.nextElementSibling.style.display=\\'block\\';'"/>
                                            <i class="fa fa-network-wired cam-brand-icon-fallback" style="display:none;"/>
                                        </div>
                                        <span class="cam-brand-logo">HANWHA</span>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Pourquoi nous choisir -->
                        <section class="cam-why">
                            <div class="cam-container">
                                <div class="cam-section-header">
                                    <h2>Pourquoi nous choisir ?</h2>
                                    <p>La référence en vidéosurveillance professionnelle</p>
                                </div>
                                <div class="cam-why-grid">
                                    <div class="cam-why-card">
                                        <h3>Revendeur certifié AXIS</h3>
                                        <p>Partenaire officiel AXIS Communications, leader mondial de la vidéosurveillance IP</p>
                                    </div>
                                    <div class="cam-why-card">
                                        <h3>Livraison rapide</h3>
                                        <p>Expédition sous 24h pour tous les produits en stock</p>
                                    </div>
                                    <div class="cam-why-card">
                                        <h3>Support technique gratuit</h3>
                                        <p>Notre équipe d'experts vous accompagne à chaque étape</p>
                                    </div>
                                    <div class="cam-why-card">
                                        <h3>Garantie 5 ans</h3>
                                        <p>Tous nos produits AXIS bénéficient d'une garantie de 5 ans</p>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Avis clients (Conditionnel au module portal_rating) -->
                        <t t-if="env['ir.module.module'].sudo().search([('name', '=', 'portal_rating'), ('state', '=', 'installed')])">
                            <section class="cam-reviews-simple py-5">
                                <div class="cam-container text-center">
                                    <div class="cam-section-header mb-4">
                                        <h2>Ce que disent nos clients</h2>
                                        <div class="cam-global-rating mt-2">
                                            <span class="cam-rating-stars">
                                                <i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/>
                                            </span>
                                            <span class="cam-rating-text"><strong>4,8/5</strong> — 312 avis vérifiés</span>
                                        </div>
                                    </div>

                                    <div class="cam-reviews-grid">
                                        <div class="cam-review-card">
                                            <div class="cam-review-stars">
                                                <i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/>
                                            </div>
                                            <p class="cam-review-comment">"Matériel parfait et livraison très rapide."</p>
                                            <strong>Jean-Marc D.</strong>
                                        </div>

                                        <div class="cam-review-card">
                                            <div class="cam-review-stars">
                                                <i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/>
                                            </div>
                                            <p class="cam-review-comment">"Service client réactif et très professionnel."</p>
                                            <strong>Sophie L.</strong>
                                        </div>

                                        <div class="cam-review-card">
                                            <div class="cam-review-stars">
                                                <i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/>
                                            </div>
                                            <p class="cam-review-comment">"Produits AXIS de qualité, je recommande."</p>
                                            <strong>Pierre M.</strong>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </t>

                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- Page liée au site Cam Surveillance -->
    <record id="cam_home_page" model="website.page">
        <field name="name">Accueil</field>
        <field name="url">/</field>
        <field name="website_id" ref="cam_surveillance_website"/>
        <field name="view_id" ref="cam_home_view"/>
        <field name="is_published">True</field>
        <field name="priority">1</field>
    </record>

</odoo>