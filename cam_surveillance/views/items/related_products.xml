<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="custom_product_accessory_recommendations" model="ir.ui.view">
        <field name="name">product.custom.accessory.recommendations</field>
        <field name="inherit_id" ref="website_sale.product"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@id='product_full_description']" position="after">

                <t t-if="product.accessory_product_ids">
                    <section class="container mt-5 mb-5 custom-accessory-section">
                        <div class="cam-section-header">
                            <h3>Accessoires fréquemment achetés ensemble</h3>
                        </div>

                        <div class="cam-products-grid">
                            <t t-foreach="product.accessory_product_ids" t-as="acc_product">
                                <a t-att-href="acc_product.website_url" class="cam-product-card cam-product-card--related">
                                    <div class="cam-product-img">
                                        <img t-att-src="website.image_url(acc_product, 'image_1024')"
                                             t-att-alt="acc_product.name"/>
                                    </div>
                                    <div class="cam-product-body">
                                        <h3><t t-esc="acc_product.name"/></h3>
                                        <div class="cam-product-footer">
                                            <span class="cam-product-price">
                                                <t t-esc="acc_product.list_price" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                            </span>
                                            <span class="cam-btn-sm">Voir</span>
                                        </div>
                                    </div>
                                </a>
                            </t>
                        </div>
                    </section>
                </t>

            </xpath>

        </field>
    </record>
</odoo>