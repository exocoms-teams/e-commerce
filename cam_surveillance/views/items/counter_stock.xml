<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_product_stock_qty" inherit_id="website_sale.product" name="Affichage Stock Personnalisé">
        <xpath expr="//div[@id='product_details']" position="inside">
            
            <!-- Zone d'affichage du stock -->
            <div class="my-3 custom-stock-counter">
                
                <!-- Si le stock est strictement supérieur à 0 -->
                <t t-if="product.sudo().qty_available &gt; 0">
                    <span class="cam-badge-stock-in cam-badge-stock-in--lg">
                        <i class="fa fa-check-circle me-1"/>
                        <span t-esc="int(product.sudo().qty_available)"/> unités en stock
                    </span>
                </t>
                
                <!-- Si le stock est égal ou inférieur à 0 -->
                <t t-else="">
                    <span class="cam-badge-stock-out cam-badge-stock-out--lg">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        Rupture de stock
                    </span>
                </t>

            </div>

        </xpath>
    </template>

    <template id="custom_product_item_stock" inherit_id="website_sale.products_item" name="Stock sur Etiquette Produit Shop">
        <xpath expr="//div[hasclass('o_wsale_product_information')]" position="inside">
            <t t-set="prod_obj" t-value="product or record"/>
            <div t-if="prod_obj and 'qty_available' in prod_obj._fields" class="mt-2 custom-shop-stock-badge">
                <t t-if="prod_obj.sudo().qty_available &gt; 0">
                    <span class="cam-badge-stock-in">
                        <i class="fa fa-box me-1"/>
                        <span t-esc="int(prod_obj.sudo().qty_available)"/> en stock
                    </span>
                </t>
                <t t-else="">
                    <span class="cam-badge-stock-out">
                        Rupture
                    </span>
                </t>
            </div>
        </xpath>
    </template>
</odoo>