<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="home_hero" name="Cam Hero Section">
        <section class="cam-hero">
            <div class="cam-hero-content">
                <div class="cam-hero-badge">
                    <i class="fa fa-check-circle me-1" aria-hidden="true"/> Revendeur certifié AXIS · Vidéosurveillance professionnelle
                </div>
                <h1 class="cam-hero-title">La sécurité intelligente
                    <span>pour votre entreprise</span>
                </h1>
                <p class="cam-hero-subtitle">Caméras réseau, contrôle d'accès et solutions de vidéosurveillance. Livraison rapide et support technique gratuit.</p>
        
                <div class="cam-hero-buttons">
                    <a href="/shop" class="cam-btn-primary">Voir nos produits</a>
                    <a href="/contactus" class="cam-btn-secondary cam-btn-audit">Demander un audit gratuit</a>
                </div>
        
                <div class="cam-hero-stats">
                    <div class="cam-stat">
                        <span class="cam-stat-number">500+</span>
                        <span class="cam-stat-label">Produits certifiés</span>
                    </div>
                    <div class="cam-stat">
                        <span class="cam-stat-number">24/7</span>
                        <span class="cam-stat-label">Support expert</span>
                    </div>
                    <div class="cam-stat">
                        <span class="cam-stat-number">5 ans</span>
                        <span class="cam-stat-label">Garantie constructeur</span>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
