<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="home_brand" name="Cam brand Section">
        <section class="cam-brands">
            <div class="cam-container">
                <div class="cam-section-header">
                    <h2>Nos marques partenaires</h2>
                    <p>Les plus grands constructeurs mondiaux de vidéosurveillance et contrôle d'accès</p>
                </div>
                <div class="cam-brands-grid">
                    <div class="cam-brand-card">
                        <img src='cam_surveillance/static/src/img/axis_logo.webp' alt='logo AXIS'/>
                        <span class="cam-brand-logo">AXIS</span>
                    </div>
                    <div class="cam-brand-card">
                        <img src='cam_surveillance/static/src/img/HIKVISION_logo.webp' alt='logo HIKVISION'/>
                        <span class="cam-brand-logo">HIKVISION</span>
                    </div>
                    <div class="cam-brand-card">
                        <img src='cam_surveillance/static/src/img/DAHUA_logo.webp' alt='logo DAHUA'/>
                        <span class="cam-brand-logo">DAHUA</span>
                    </div>
                    <div class="cam-brand-card">
                        <img src='cam_surveillance/static/src/img/REOLINK_logo.webp' alt='logo REOLINK'/>
                        <span class="cam-brand-logo">REOLINK</span>
                    </div>
                    <div class="cam-brand-card">
                        <img src='cam_surveillance/static/src/img/BOSCH_logo.webp' alt='logo BOSCH'/>
                        <span class="cam-brand-logo">BOSCH</span>
                    </div>
                    <div class="cam-brand-card">
                        <img src='cam_surveillance/static/src/img/HANWHA_logo.webp' alt='logo HANWHA'/>
                        <span class="cam-brand-logo">HANWHA</span>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>