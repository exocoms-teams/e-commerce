<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="home_reviews" name="Cam reviews Section">
        <t t-if="env['ir.module.module'].sudo().search([('name', '=', 'portal_rating'), ('state', '=', 'installed')])">
            <section class="cam-reviews-simple py-5">
                <div class="cam-container text-center">
                    <div class="cam-section-header mb-4">
                        <h2>Ce que disent nos clients</h2>
                        <div class="cam-global-rating mt-2">
                            <span class="cam-rating-stars">
                                <i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/>
                            </span>
                            <span class="cam-rating-text"><strong>4,8/5</strong> — 312 avis vérifiés</span>
                        </div>
                    </div>
        
                    <div class="cam-reviews-grid">
                        <div class="cam-review-card">
                            <div class="cam-review-stars">
                                <i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/>
                            </div>
                            <p class="cam-review-comment">"Matériel parfait et livraison très rapide."</p>
                            <strong>Jean-Marc D.</strong>
                        </div>
        
                        <div class="cam-review-card">
                            <div class="cam-review-stars">
                                <i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/>
                            </div>
                            <p class="cam-review-comment">"Service client réactif et très professionnel."</p>
                            <strong>Sophie L.</strong>
                        </div>
        
                        <div class="cam-review-card">
                            <div class="cam-review-stars">
                                <i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/>
                            </div>
                            <p class="cam-review-comment">"Produits AXIS de qualité, je recommande."</p>
                            <strong>Pierre M.</strong>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>
</odoo>