<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_product_stock_qty" inherit_id="website_sale.product" name="Affichage Stock Personnalisé">
        <xpath expr="//div[@id='product_details']" position="inside">
            
            <!-- Zone d'affichage du stock -->
            <div class="my-3 custom-stock-counter">
                
                <!-- Si le stock est strictement supérieur à 0 -->
                <t t-if="product.sudo().qty_available &gt; 0">
                    <span class="badge bg-success text-white p-2" style="font-size: 0.9rem;">
                        <i class="fa fa-check-circle me-1"/>
                        <span t-esc="int(product.sudo().qty_available)"/> unités en stock
                    </span>
                </t>
                
                <!-- Si le stock est égal ou inférieur à 0 -->
                <t t-else="">
                    <span class="badge bg-danger text-white p-2" style="font-size: 0.9rem;">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        Rupture de stock
                    </span>
                </t>

            </div>

        </xpath>
    </template>
</odoo>