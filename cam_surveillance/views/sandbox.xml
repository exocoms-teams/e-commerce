<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Page bac à sable : affiche tous les composants pour validation visuelle -->
    <record id="cam_sandbox_view" model="ir.ui.view">
        <field name="name">cam.sandbox</field>
        <field name="type">qweb</field>
        <field name="key">cam_surveillance.cam_sandbox</field>
        <field name="arch" type="xml">
            <t t-name="cam_surveillance.cam_sandbox">
                <t t-call="website.layout">
                    <div id="wrap">

                        <section class="cam-container" style="padding: 60px 20px;">

                            <div class="cam-section-header">
                                <h2>🧪 Bac à sable — Composants CSS</h2>
                                <p>Bibliothèque de référence Cam Surveillance</p>
                            </div>

                            <!-- ===== BOUTONS ===== -->
                            <div style="margin-bottom: 60px;">
                                <h3 style="margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px;">
                                    1. Boutons
                                </h3>

                                <div style="margin-bottom: 20px;">
                                    <h4 style="color: #888; margin-bottom: 12px;">Primary</h4>
                                    <a href="#" class="cam-btn-primary">Normal</a>
                                    <span style="margin: 0 8px;"/>
                                    <button class="cam-btn-primary" disabled="disabled">Disabled</button>
                                </div>

                                <div style="margin-bottom: 20px;">
                                    <h4 style="color: #888; margin-bottom: 12px;">Secondary</h4>
                                    <a href="#" class="cam-btn-secondary">Normal</a>
                                    <span style="margin: 0 8px;"/>
                                    <button class="cam-btn-secondary" disabled="disabled">Disabled</button>
                                </div>

                                <div style="margin-bottom: 20px;">
                                    <h4 style="color: #888; margin-bottom: 12px;">Small (cam-btn-sm)</h4>
                                    <a href="#" class="cam-btn-sm">Voir</a>
                                    <span style="margin: 0 8px;"/>
                                    <button class="cam-btn-sm" disabled="disabled">Disabled</button>
                                </div>

                                <div style="background: #111; padding: 20px; border-radius: 8px;">
                                    <h4 style="color: #888; margin-bottom: 12px;">Focus test</h4>
                                    <p style="color: #888; font-size: 0.85rem; margin-bottom: 12px;">
                                        Utilise la touche Tab pour naviguer et vérifier le style :focus-visible
                                    </p>
                                    <button class="cam-btn-primary">Focus me (Tab)</button>
                                    <span style="margin: 0 8px;"/>
                                    <button class="cam-btn-secondary">Focus me (Tab)</button>
                                    <span style="margin: 0 8px;"/>
                                    <button class="cam-btn-sm">Focus me (Tab)</button>
                                </div>
                            </div>

                            <!-- ===== BADGES DE STOCK ===== -->
                            <div style="margin-bottom: 60px;">
                                <h3 style="margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px;">
                                    2. Badges de stock
                                </h3>

                                <div style="margin-bottom: 20px;">
                                    <h4 style="color: #888; margin-bottom: 12px;">Taille standard (shop / home)</h4>
                                    <span class="cam-badge-stock-in">
                                        <i class="fa fa-box me-1"/>12 en stock
                                    </span>
                                    <span style="margin: 0 12px;"/>
                                    <span class="cam-badge-stock-out">
                                        Rupture
                                    </span>
                                </div>

                                <div>
                                    <h4 style="color: #888; margin-bottom: 12px;">Taille large (fiche produit)</h4>
                                    <span class="cam-badge-stock-in cam-badge-stock-in--lg">
                                        <i class="fa fa-check-circle me-1"/>12 unités en stock
                                    </span>
                                    <span style="margin: 0 12px;"/>
                                    <span class="cam-badge-stock-out cam-badge-stock-out--lg">
                                        <i class="fa fa-exclamation-triangle me-1"/>Rupture de stock
                                    </span>
                                </div>
                            </div>

                            <!-- ===== BADGES GÉNÉRAUX ===== -->
                            <div style="margin-bottom: 60px;">
                                <h3 style="margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px;">
                                    3. Badges généraux
                                </h3>
                                <div class="cam-footer-badges">
                                    <span class="cam-badge">Certifié AXIS</span>
                                    <span class="cam-badge">Garantie 5 ans</span>
                                </div>
                                <div style="margin-top: 15px;">
                                    <div class="cam-hero-badge">Revendeur certifié AXIS · Vidéosurveillance professionnelle</div>
                                </div>
                            </div>

                            <!-- ===== CARTES PRODUIT ===== -->
                            <div style="margin-bottom: 60px;">
                                <h3 style="margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px;">
                                    4. Cartes produit
                                </h3>

                                <h4 style="color: #888; margin-bottom: 12px;">Standard (home / shop)</h4>
                                <div class="cam-products-grid" style="margin-bottom: 30px;">
                                    <div class="cam-product-card">
                                        <div class="cam-product-img">
                                            <div class="cam-product-noimg">—</div>
                                        </div>
                                        <div class="cam-product-body">
                                            <h3>AXIS M3905-R Dome Camera</h3>
                                            <div class="cam-stock-status mt-1 mb-2">
                                                <span class="cam-badge-stock-in">
                                                    <i class="fa fa-box me-1"/>5 en stock
                                                </span>
                                            </div>
                                            <div class="cam-product-footer">
                                                <span class="cam-product-price">450,00 € HT</span>
                                                <span class="cam-btn-sm">Voir</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="cam-product-card">
                                        <div class="cam-product-img">
                                            <div class="cam-product-noimg">—</div>
                                        </div>
                                        <div class="cam-product-body">
                                            <h3>Enregistreur NVR 16 voies</h3>
                                            <div class="cam-stock-status mt-1 mb-2">
                                                <span class="cam-badge-stock-out">
                                                    Rupture
                                                </span>
                                            </div>
                                            <div class="cam-product-footer">
                                                <span class="cam-product-price">699,00 € HT</span>
                                                <span class="cam-btn-sm">Voir</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <h4 style="color: #888; margin-bottom: 12px;">Variante related (produits associés)</h4>
                                <div class="cam-products-grid">
                                    <div class="cam-product-card cam-product-card--related">
                                        <div class="cam-product-img">
                                            <div class="cam-product-noimg">—</div>
                                        </div>
                                        <div class="cam-product-body">
                                            <h3>Disque dur 4 To</h3>
                                            <div class="cam-product-footer">
                                                <span class="cam-product-price">129,00 €</span>
                                                <span class="cam-btn-sm">Voir</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="cam-product-card cam-product-card--related">
                                        <div class="cam-product-img">
                                            <div class="cam-product-noimg">—</div>
                                        </div>
                                        <div class="cam-product-body">
                                            <h3>Lecteur de badge RFID</h3>
                                            <div class="cam-product-footer">
                                                <span class="cam-product-price">149,00 €</span>
                                                <span class="cam-btn-sm">Voir</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ===== CATÉGORIES ===== -->
                            <div style="margin-bottom: 60px;">
                                <h3 style="margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px;">
                                    5. Cartes catégorie
                                </h3>
                                <div class="cam-cat-grid">
                                    <a href="#" class="cam-cat-card">
                                        <h3>Caméras réseau</h3>
                                        <p>Découvrez notre gamme</p>
                                        <span class="cam-cat-link">Voir</span>
                                    </a>
                                    <a href="#" class="cam-cat-card cam-cat-featured">
                                        <h3>Contrôle d'accès</h3>
                                        <p>Découvrez notre gamme</p>
                                        <span class="cam-cat-link">Voir</span>
                                    </a>
                                    <a href="#" class="cam-cat-card">
                                        <h3>Enregistreurs</h3>
                                        <p>Découvrez notre gamme</p>
                                        <span class="cam-cat-link">Voir</span>
                                    </a>
                                </div>
                            </div>

                            <!-- ===== SECTION HEADER ===== -->
                            <div style="margin-bottom: 60px;">
                                <h3 style="margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px;">
                                    6. Section Header
                                </h3>
                                <div class="cam-section-header">
                                    <h2>Titre de section</h2>
                                    <p>Sous-titre descriptif de la section</p>
                                </div>
                            </div>

                            <!-- ===== BANDEAU PROMO ===== -->
                            <div style="margin-bottom: 60px;">
                                <h3 style="margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px;">
                                    7. Bandeau promotionnel
                                </h3>
                            </div>
                        </section>

                        <div class="cam-promo-banner">
                            <div class="cam-promo-track">
                                <span>Livraison gratuite dès 500€</span>
                                <span>Support technique offert</span>
                                <span>Garantie 5 ans AXIS</span>
                                <span>Revendeur certifié AXIS</span>
                                <span>Expédition sous 24h</span>
                                <span>Livraison gratuite dès 500€</span>
                                <span>Support technique offert</span>
                                <span>Garantie 5 ans AXIS</span>
                                <span>Revendeur certifié AXIS</span>
                                <span>Expédition sous 24h</span>
                            </div>
                        </div>

                        <section class="cam-container" style="padding: 40px 20px;">
                            <!-- ===== WHY CARDS ===== -->
                            <div style="margin-bottom: 60px;">
                                <h3 style="margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px;">
                                    8. Cartes "Pourquoi nous"
                                </h3>
                                <div class="cam-why-grid">
                                    <div class="cam-why-card">
                                        <h3>Revendeur certifié AXIS</h3>
                                        <p>Partenaire officiel AXIS Communications</p>
                                    </div>
                                    <div class="cam-why-card">
                                        <h3>Livraison rapide</h3>
                                        <p>Expédition sous 24h</p>
                                    </div>
                                    <div class="cam-why-card">
                                        <h3>Support technique</h3>
                                        <p>Accompagnement gratuit</p>
                                    </div>
                                    <div class="cam-why-card">
                                        <h3>Garantie 5 ans</h3>
                                        <p>Tous produits AXIS</p>
                                    </div>
                                </div>
                            </div>
                        </section>

                    </div>
                </t>
            </t>
        </field>
    </record>

</odoo>
