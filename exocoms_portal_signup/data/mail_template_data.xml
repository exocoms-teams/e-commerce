<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_signup_activation" model="mail.template">
            <field name="name">Portail : activation du compte</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Activez votre compte {{ object.company_id.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email_formatted or object.login }}</field>
            <field name="lang">{{ object.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin:0;padding:0;background:#f5f6f8;">
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background:#f5f6f8;padding:24px 0;">
        <tr>
            <td align="center">
                <table border="0" cellpadding="0" cellspacing="0" width="600"
                      style="max-width:600px;background:#ffffff;border-radius:6px;
                             font-family:Arial,Helvetica,sans-serif;color:#333333;">
                    <tr>
                        <td style="padding:28px 32px 8px 32px;">
                            <p style="margin:0 0 16px 0;font-size:16px;">
                                Bonjour <t t-out="object.name or ''">Client</t>,
                            </p>
                            <p style="margin:0 0 16px 0;font-size:15px;line-height:22px;">
                                Merci pour votre inscription sur
                                <strong t-out="object.company_id.name or ''">notre site</strong>.
                                Il ne reste qu'une étape : confirmer votre adresse email.
                            </p>
                            <p style="margin:0 0 24px 0;font-size:15px;line-height:22px;">
                                <strong>Votre compte n'est pas encore actif.</strong>
                                Vous ne pourrez pas vous connecter avant d'avoir
                                cliqué sur le bouton ci-dessous.
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding:0 32px 24px 32px;">
                            <a t-att-href="object.exocoms_activation_url"
                               style="display:inline-block;padding:13px 30px;background:#0b5fff;
                                      color:#ffffff;text-decoration:none;border-radius:4px;
                                      font-size:16px;font-weight:bold;">
                                Activer mon compte
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:0 32px 24px 32px;">
                            <p style="margin:0 0 8px 0;font-size:13px;color:#777777;line-height:19px;">
                                Ce lien est valable jusqu'au
                                <t t-out="format_datetime(object.exocoms_activation_expiry, tz=object.tz, dt_format='short', lang_code=object.lang)">…</t>.
                                Passé ce délai, vous pourrez en demander un nouveau
                                depuis la page de connexion.
                            </p>
                            <p style="margin:0 0 8px 0;font-size:13px;color:#777777;line-height:19px;">
                                Si le bouton ne fonctionne pas, copiez ce lien
                                dans votre navigateur :<br/>
                                <span t-out="object.exocoms_activation_url"
                                      style="word-break:break-all;color:#0b5fff;">…</span>
                            </p>
                            <p style="margin:16px 0 0 0;font-size:13px;color:#777777;line-height:19px;">
                                Vous n'êtes pas à l'origine de cette inscription ?
                                Ignorez simplement cet email : le compte sera
                                supprimé automatiquement.
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:16px 32px 28px 32px;border-top:1px solid #ebebeb;">
                            <p style="margin:0;font-size:13px;color:#999999;line-height:19px;">
                                <strong t-out="object.company_id.name or ''">Société</strong><br/>
                                <t t-if="object.company_id.phone">
                                    <t t-out="object.company_id.phone">—</t><br/>
                                </t>
                                <t t-if="object.company_id.website">
                                    <t t-out="object.company_id.website">—</t>
                                </t>
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</div>
            </field>
        </record>
    </data>
</odoo>
