<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_activation" model="ir.ui.view">
        <field name="name">res.users.form.exocoms.activation</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="exocoms_activation" string="Activation du compte"
                      groups="base.group_system">
                    <group>
                        <group string="État">
                            <field name="exocoms_email_verified"/>
                            <field name="exocoms_activation_date"
                                   invisible="not exocoms_activation_date"/>
                            <field name="exocoms_activation_expiry"
                                   invisible="exocoms_email_verified"/>
                        </group>
                        <group string="Emails">
                            <field name="exocoms_activation_sent_date"/>
                            <field name="exocoms_activation_email_count"/>
                        </group>
                    </group>
                    <group string="Lien en cours" invisible="exocoms_email_verified">
                        <field name="exocoms_activation_url" readonly="1"/>
                    </group>
                    <div class="mt-2" invisible="exocoms_email_verified">
                        <button name="action_exocoms_resend_activation"
                                type="object"
                                string="Renvoyer l'email d'activation"
                                class="btn-primary"/>
                        <button name="action_exocoms_force_activation"
                                type="object"
                                string="Activer manuellement"
                                class="btn-secondary ms-2"
                                confirm="Activer ce compte sans confirmation de l'adresse email ?"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_users_search_activation" model="ir.ui.view">
        <field name="name">res.users.search.exocoms.activation</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_search"/>
        <field name="arch" type="xml">
            <search position="inside">
                <separator/>
                <filter name="filter_activation_pending"
                        string="Activation en attente"
                        domain="[('exocoms_email_verified', '=', False), ('active', '=', False)]"/>
            </search>
        </field>
    </record>

</odoo>
