<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="signup_pending" name="Inscription : vérifiez vos emails">
        <t t-call="web.login_layout">
            <div class="text-center mb-3">
                <h4 t-if="blocked" class="mb-3">Compte non activé</h4>
                <h4 t-else="" class="mb-3">Vérifiez votre boîte mail</h4>
            </div>

            <div t-if="error" class="alert alert-warning" role="alert">
                <t t-out="error">Erreur</t>
            </div>
            <div t-if="resent" class="alert alert-success" role="alert">
                Un nouveau lien d'activation vient de vous être envoyé.
            </div>

            <p t-if="blocked" class="text-muted">
                Votre compte existe mais n'a pas encore été activé. Ouvrez
                l'email que nous vous avons envoyé
                <t t-if="login">à <strong t-out="login">votre adresse</strong></t>
                et cliquez sur le lien d'activation.
            </p>
            <p t-else="" class="text-muted">
                Nous venons de vous envoyer un email
                <t t-if="login">à <strong t-out="login">votre adresse</strong></t>.
                Cliquez sur le lien qu'il contient pour activer votre compte.
                Tant que ce n'est pas fait, la connexion reste impossible.
            </p>

            <p class="text-muted small">
                Rien reçu au bout de quelques minutes ? Pensez à regarder dans
                vos courriers indésirables.
            </p>

            <form t-if="login" action="/signup/resend" method="post" class="mt-3">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="login" t-att-value="login"/>
                <button type="submit" class="btn btn-secondary w-100">
                    Renvoyer l'email d'activation
                </button>
            </form>

            <div class="text-center small mt-3">
                <a href="/web/login">Retour à la connexion</a>
            </div>
        </t>
    </template>

    <template id="signup_activation_result" name="Résultat de l'activation">
        <t t-call="web.login_layout">

            <t t-if="state == 'done'">
                <div class="text-center mb-3">
                    <h4 class="mb-3">Compte activé</h4>
                </div>
                <div class="alert alert-success" role="alert">
                    Votre adresse email est confirmée et votre compte est actif.
                </div>
                <a t-att-href="login_url" class="btn btn-primary w-100">
                    Me connecter
                </a>
            </t>

            <t t-elif="state == 'expired'">
                <div class="text-center mb-3">
                    <h4 class="mb-3">Lien expiré</h4>
                </div>
                <p class="text-muted">
                    Ce lien d'activation n'est plus valable. Demandez-en un
                    nouveau, il sera envoyé immédiatement.
                </p>
                <form action="/signup/resend" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="login" t-att-value="login"/>
                    <button type="submit" class="btn btn-primary w-100">
                        Recevoir un nouveau lien
                    </button>
                </form>
            </t>

            <t t-else="">
                <div class="text-center mb-3">
                    <h4 class="mb-3">Lien invalide</h4>
                </div>
                <p class="text-muted">
                    Ce lien d'activation n'est pas reconnu. Il a peut-être déjà
                    été utilisé — dans ce cas, votre compte est actif et vous
                    pouvez vous connecter normalement.
                </p>
                <a href="/web/login" class="btn btn-primary w-100">
                    Aller à la connexion
                </a>
            </t>

            <div class="text-center small mt-3">
                <a href="/">Retour à l'accueil</a>
            </div>
        </t>
    </template>

</odoo>
