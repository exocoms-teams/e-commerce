<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.exocoms.portal.signup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="auth_signup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- On utilise le XPath robuste validé sur le Staging -->
            <xpath expr="//setting[.//field[@name='auth_signup_reset_password']]" position="before">
                <setting id="exocoms_portal_signup_block"
                         string="Inscription portail (EXOCOMS)"
                         help="Paramètres de sécurité, validité et purge des comptes portail">

                    <div class="content-group mt16">
                        <field name="exocoms_block_disposable" class="o_light_label"/>
                        <label for="exocoms_block_disposable" string="Refuser les adresses jetables" class="ms-2 fw-bold"/>
                        <p class="text-muted">Rejette les inscriptions provenant des domaines marqués « Refusé ».</p>
                    </div>

                    <div class="content-group mt16">
                        <field name="exocoms_check_mx" class="o_light_label"/>
                        <label for="exocoms_check_mx" string="Vérifier le domaine (DNS)" class="ms-2 fw-bold"/>
                        <p class="text-muted">Contrôle que le domaine de l'adresse peut recevoir du courrier. Ignoré si dnspython n'est pas installé.</p>
                    </div>

                    <div class="content-group mt16">
                        <field name="exocoms_restrict_allowed" class="o_light_label"/>
                        <label for="exocoms_restrict_allowed" string="Limiter aux domaines autorisés" class="ms-2 fw-bold"/>
                        <p class="text-muted">N'accepte que les domaines marqués « Autorisé ».</p>
                    </div>

                    <div class="content-group mt16">
                        <label for="exocoms_token_ttl_hours" class="o_light_label fw-bold"/>
                        <field name="exocoms_token_ttl_hours" class="text-end ms-2" style="width: 80px;"/> heures
                        <p class="text-muted">Validité du lien d'activation : durée pendant laquelle le lien reçu par email reste utilisable.</p>
                    </div>

                    <div class="content-group mt16">
                        <label for="exocoms_purge_days" class="o_light_label fw-bold"/>
                        <field name="exocoms_purge_days" class="text-end ms-2" style="width: 80px;"/> jours
                        <p class="text-muted">Purge des inscriptions non activées : suppression automatique des comptes jamais activés. 0 désactive la purge.</p>
                    </div>

                    <div class="content-group mt16">
                        <label for="exocoms_resend_interval" class="o_light_label fw-bold"/>
                        <field name="exocoms_resend_interval" class="text-end ms-2" style="width: 80px;"/> secondes
                        <p class="text-muted">Délai entre deux envois : protection contre les demandes de renvoi répétées.</p>
                    </div>

                    <div class="content-group mt16">
                        <label for="exocoms_max_resend" class="o_light_label fw-bold"/>
                        <field name="exocoms_max_resend" class="text-end ms-2" style="width: 80px;"/>
                        <p class="text-muted">Nombre maximum d'emails d'activation : plafond par inscription. 0 pour illimité.</p>
                    </div>

                    <div class="content-group mt16">
                        <field name="exocoms_reveal_pending" class="o_light_label"/>
                        <label for="exocoms_reveal_pending" string="Signaler « compte non activé »" class="ms-2 fw-bold"/>
                        <p class="text-muted">Décoché, l'existence d'une adresse n'est jamais confirmée à un tiers lors d'un échec de connexion.</p>
                    </div>

                </setting>
            </xpath>
        </field>
    </record>

</odoo>