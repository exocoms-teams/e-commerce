<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Valeurs par défaut, utilisées par les sociétés qui n'ont pas de
             valeur propre (champs res.company.debranding_*). -->

        <record id="param_debranding_name" model="ir.config_parameter">
            <field name="key">debranding.name</field>
            <field name="value">EXOCOMS</field>
        </record>

        <record id="param_debranding_url" model="ir.config_parameter">
            <field name="key">debranding.url</field>
            <field name="value">https://www.exocoms.fr</field>
        </record>

        <record id="param_debranding_documentation_url" model="ir.config_parameter">
            <field name="key">debranding.documentation_url</field>
            <field name="value"></field>
        </record>

        <record id="param_debranding_support_url" model="ir.config_parameter">
            <field name="key">debranding.support_url</field>
            <field name="value"></field>
        </record>

        <record id="param_debranding_logo_url" model="ir.config_parameter">
            <field name="key">debranding.logo_url</field>
            <field name="value">/logo.png</field>
        </record>

        <record id="param_debranding_theme_color" model="ir.config_parameter">
            <field name="key">debranding.theme_color</field>
            <field name="value"></field>
        </record>

        <!-- Mode de rendu : False = marque figée dans les templates. -->
        <record id="param_debranding_multi_company" model="ir.config_parameter">
            <field name="key">debranding.multi_company</field>
            <field name="value">False</field>
        </record>

        <record id="param_debranding_hide_version" model="ir.config_parameter">
            <field name="key">debranding.hide_version</field>
            <field name="value">True</field>
        </record>

        <record id="param_debranding_excluded_modules" model="ir.config_parameter">
            <field name="key">debranding.excluded_modules</field>
            <field name="value">iap,iap_mail,iap_extract,iap_crm,partner_autocomplete,mail_plugin,google_gmail,google_calendar,google_drive,microsoft_outlook,microsoft_calendar,payment,web_editor,base_setup_iap</field>
        </record>

        <record id="param_web_app_name" model="ir.config_parameter">
            <field name="key">web.web_app_name</field>
            <field name="value">EXOCOMS</field>
        </record>

    </data>
</odoo>
