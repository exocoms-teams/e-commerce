<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="layout" name="monetiques.fr Layout" inherit_id="website.layout" customize_show="False">
        <!-- Remplacement du Header (Optimisé) -->
        <xpath expr="//header" position="replace">
            <header class="mq-header" id="top" role="banner">
                <div class="mq-container">
                    <a href="/" class="mq-logo" aria-label="Accueil">EXO<span style="color:#1E40AF">COMS</span></a>

                    <nav id="mqNav" aria-label="Menu principal">
                        <ul class="mq-nav">
                            <li class="mq-nav-item"><a href="/" class="mq-nav-link">Accueil</a></li>
                            <li class="mq-nav-item"><a href="/shop" class="mq-nav-link">Boutique</a></li>
                            <li class="mq-nav-item"><a href="/contactus" class="mq-nav-link">Contact</a></li>
                            <li class="mq-nav-item mq-mobile-only" style="display:none;"><a href="/shop/cart" class="mq-nav-link">Panier</a></li>
                            <li class="mq-nav-item mq-mobile-only" style="display:none;"><a href="/web/login" class="mq-nav-link">Connexion</a></li>
                        </ul>
                    </nav>

                    <div class="mq-nav-actions">
                        <a href="/shop/cart" class="mq-nav-cart" aria-label="Mon panier">
                            <i class="fa fa-shopping-cart" aria-hidden="true"/>
                        </a>
                        <a href="/web/login" class="mq-btn-secondary">Connexion</a>
                        <button class="mq-burger" id="mqBurger" aria-label="Menu" aria-expanded="false" aria-controls="mqNav">
                            <span/><span/><span/>
                        </button>
                    </div>
                </div>
            </header>

            <!-- Script JS pour activer le menu Burger (3 tirets) -->
            <script type="text/javascript">
                document.addEventListener("DOMContentLoaded", function() {
                    const burger = document.getElementById('mqBurger');
                    const nav = document.getElementById('mqNav');
                    
                    if (burger &amp;&amp; nav) {
                        burger.addEventListener('click', function() {
                            const isExpanded = burger.getAttribute('aria-expanded') === 'true';
                            burger.setAttribute('aria-expanded', !isExpanded);
                            nav.classList.toggle('active');
                            burger.classList.toggle('toggle');
                        });
                    }
                });
            </script>
        </xpath>

        <xpath expr="//footer" position="replace">
            <t t-call="monetique_theme.footer"/>
        </xpath>
    </template>

    <template id="footer" name="monetiques.fr Footer">
        <footer class="mn-footer">
            <div class="mn-footer__top">
                <div class="mn-container">
                    <div class="mn-footer__grid">
                        <div class="mn-footer__brand">
                            <a href="/" class="mn-footer__logo">monetiques<span style="color:#3B82F6">.fr</span></a>
                            <p>Infrastructure de paiement securisee depuis 2005.</p>
                            <div class="mn-footer__badges">
                                <span class="mn-badge">PCI DSS</span>
                                <span class="mn-badge">NF525</span>
                                <span class="mn-badge">ISO 27001</span>
                            </div>
                        </div>
                        <div class="mn-footer__col">
                            <h4>Solutions</h4>
                            <ul>
                                <li><a href="/shop">Boutique</a></li>
                                <li><a href="/solutions/tpe">Terminaux TPE</a></li>
                                <li><a href="/solutions/encaissement">Encaissement</a></li>
                            </ul>
                        </div>
                        <div class="mn-footer__col">
                            <h4>Services</h4>
                            <ul>
                                <li><a href="/support">Support 7j/7</a></li>
                                <li><a href="/support">Maintenance</a></li>
                            </ul>
                        </div>
                        <div class="mn-footer__col">
                            <h4>Entreprise</h4>
                            <ul>
                                <li><a href="/a-propos">A propos</a></li>
                                <li><a href="/emplois">Emplois</a></li>
                                <li><a href="/contact">Contact</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mn-footer__bottom">
                <div class="mn-container">
                    <p>&#169; 2025 monetiques.fr SAS. Tous droits reserves.</p>
                    <nav>
                        <a href="/mentions-legales">Mentions legales</a>
                        <a href="/confidentialite">Confidentialite</a>
                        <a href="/cgv">CGV</a>
                    </nav>
                </div>
            </div>
        </footer>
    </template>

</odoo>