<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue liste -->
    <record id="luxury_destination_list_view" model="ir.ui.view">
        <field name="name">luxury.destination.list</field>
        <field name="model">luxury.destination</field>
        <field name="arch" type="xml">
            <list string="Destinations">
                <field name="name"/>
                <field name="pays_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="luxury_destination_form_view" model="ir.ui.view">
        <field name="name">luxury.destination.form</field>
        <field name="model">luxury.destination</field>
        <field name="arch" type="xml">
            <form string="Destination">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="pays_id"/>
                        <field name="active"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_luxury_destination" model="ir.actions.act_window">
        <field name="name">Destinations</field>
        <field name="res_model">luxury.destination</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_luxury_root"
              name="Luxury Services"
              sequence="99"/>

    <menuitem id="menu_luxury_destinations"
              name="Destinations"
              parent="menu_luxury_root"
              action="action_luxury_destination"/>
</odoo>