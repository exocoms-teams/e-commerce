<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="luxury_maintenance_page" name="Page Maintenance VIP">
    <t t-call="website.layout">

        <t t-if="error">
            <div class="container mt-3">
                <div class="alert alert-danger">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    <t t-esc="error"/>
                </div>
            </div>
        </t>

        <!-- ═══════════════════════════════════════════
             SECTION 1 — HERO
        ═══════════════════════════════════════════ -->
        <section class="maintenance-hero position-relative d-flex align-items-center"
                 style="min-height: 520px; background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 50%, #0d0d0d 100%);">
            <div class="maintenance-hero-overlay position-absolute w-100 h-100"
                 style="background: rgba(0,0,0,0.55); top:0; left:0;"/>
            <div class="container position-relative text-white py-5">
                <div class="row justify-content-center text-center">
                    <div class="col-lg-8">
                        <p class="text-uppercase fw-bold mb-2"
                           style="color: #c9a84c; letter-spacing: 4px; font-size: 0.85rem;">
                            Service Premium
                        </p>
                        <h1 class="display-4 fw-bold mb-3">
                            Excellence &amp; Entretien
                        </h1>
                        <p class="lead mb-4" style="color: #cccccc;">
                            Votre flotte entre de bonnes mains — maintenance certifiée
                            pour yachts et jets privés, disponible <strong>24h/24, 7j/7</strong>,
                            partout dans le monde.
                        </p>
                        <div class="d-flex gap-3 justify-content-center flex-wrap">
                            <a href="#devis"
                               class="btn btn-lg px-4 py-2 fw-semibold"
                               style="background: #c9a84c; color: #000; border-radius: 2px;">
                                <i class="fa fa-file-text me-2"/>
                                Demander un devis
                            </a>
                            <a href="tel:+33100000000"
                               class="btn btn-lg btn-outline-light px-4 py-2 fw-semibold"
                               style="border-radius: 2px;">
                                <i class="fa fa-phone me-2"/>
                                Nous appeler
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══════════════════════════════════════════
             SECTION 2 — NOS SERVICES
        ═══════════════════════════════════════════ -->
        <section class="py-5" style="background: #f8f8f8;">
            <div class="container">
                <div class="text-center mb-5">
                    <p class="text-uppercase fw-bold mb-1"
                       style="color: #c9a84c; letter-spacing: 3px; font-size: 0.8rem;">
                        Ce que nous faisons
                    </p>
                    <h2 class="fw-bold" style="color: #1a1a1a;">Nos Services</h2>
                    <div class="mx-auto mt-2"
                         style="width: 50px; height: 2px; background: #c9a84c;"/>
                </div>

                <div class="row g-4">

                    <!-- Yachts -->
                    <div class="col-12">
                        <h4 class="fw-bold mb-3 d-flex align-items-center gap-2"
                            style="color: #1a1a1a;">
                            <i class="fa fa-ship" style="color: #c9a84c;"/>
                            Yachts
                        </h4>
                    </div>

                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm p-4"
                             style="border-top: 3px solid #c9a84c !important;">
                            <div class="mb-3">
                                <i class="fa fa-cogs fa-2x" style="color: #c9a84c;"/>
                            </div>
                            <h5 class="fw-bold">Maintenance Mécanique</h5>
                            <p class="text-muted mb-0">
                                Révision complète des moteurs, systèmes de propulsion,
                                hydraulique et mécanique de bord.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm p-4"
                             style="border-top: 3px solid #c9a84c !important;">
                            <div class="mb-3">
                                <i class="fa fa-wifi fa-2x" style="color: #c9a84c;"/>
                            </div>
                            <h5 class="fw-bold">Électronique &amp; Navigation</h5>
                            <p class="text-muted mb-0">
                                Maintenance et mise à jour des systèmes GPS, radar,
                                AIS, pilote automatique et électronique de bord.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm p-4"
                             style="border-top: 3px solid #c9a84c !important;">
                            <div class="mb-3">
                                <i class="fa fa-paint-brush fa-2x" style="color: #c9a84c;"/>
                            </div>
                            <h5 class="fw-bold">Coque &amp; Carlingue</h5>
                            <p class="text-muted mb-0">
                                Antifouling, peinture, traitement osmotique,
                                polissage et entretien des surfaces extérieures.
                            </p>
                        </div>
                    </div>

                    <!-- Jets -->
                    <div class="col-12 mt-4">
                        <h4 class="fw-bold mb-3 d-flex align-items-center gap-2"
                            style="color: #1a1a1a;">
                            <i class="fa fa-plane" style="color: #c9a84c;"/>
                            Jets Privés
                        </h4>
                    </div>

                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm p-4"
                             style="border-top: 3px solid #c9a84c !important;">
                            <div class="mb-3">
                                <i class="fa fa-wrench fa-2x" style="color: #c9a84c;"/>
                            </div>
                            <h5 class="fw-bold">Révision Moteur &amp; Cellule</h5>
                            <p class="text-muted mb-0">
                                Inspection complète certifiée, révision des réacteurs
                                et contrôle structurel de la cellule.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm p-4"
                             style="border-top: 3px solid #c9a84c !important;">
                            <div class="mb-3">
                                <i class="fa fa-desktop fa-2x" style="color: #c9a84c;"/>
                            </div>
                            <h5 class="fw-bold">Avionique</h5>
                            <p class="text-muted mb-0">
                                Mise à jour des systèmes de navigation, FMS,
                                communications et équipements de cockpit.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm p-4"
                             style="border-top: 3px solid #c9a84c !important;">
                            <div class="mb-3">
                                <i class="fa fa-star fa-2x" style="color: #c9a84c;"/>
                            </div>
                            <h5 class="fw-bold">Intérieur &amp; Confort</h5>
                            <p class="text-muted mb-0">
                                Rénovation de la cabine, remplacement des sièges,
                                finitions premium et systèmes de divertissement.
                            </p>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- ═══════════════════════════════════════════
             SECTION 3 — POURQUOI NOUS
        ═══════════════════════════════════════════ -->
        <section class="py-5" style="background: #1a1a2e;">
            <div class="container">
                <div class="text-center mb-5">
                    <p class="text-uppercase fw-bold mb-1"
                       style="color: #c9a84c; letter-spacing: 3px; font-size: 0.8rem;">
                        Nos engagements
                    </p>
                    <h2 class="fw-bold text-white">Pourquoi nous choisir</h2>
                    <div class="mx-auto mt-2"
                         style="width: 50px; height: 2px; background: #c9a84c;"/>
                </div>
                <div class="row g-4 text-center text-white">
                    <div class="col-md-4">
                        <div class="p-4">
                            <i class="fa fa-bolt fa-3x mb-3" style="color: #c9a84c;"/>
                            <h4 class="fw-bold">Intervention Rapide</h4>
                            <p style="color: #aaa;">
                                Technicien sur site sous 24h, partout en Europe
                                et dans les grandes marinas mondiales.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-4">
                            <i class="fa fa-globe fa-3x mb-3" style="color: #c9a84c;"/>
                            <h4 class="fw-bold">Réseau Mondial</h4>
                            <p style="color: #aaa;">
                                Plus de 50 pays couverts, réseau de partenaires
                                certifiés dans les plus grands aéroports et ports.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-4">
                            <i class="fa fa-certificate fa-3x mb-3" style="color: #c9a84c;"/>
                            <h4 class="fw-bold">Techniciens Certifiés</h4>
                            <p style="color: #aaa;">
                                Agréés par les constructeurs, certifiés EASA
                                pour l'aviation et ISO pour la maintenance navale.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══════════════════════════════════════════
             SECTION 4 — TARIFS
        ═══════════════════════════════════════════ -->
        <section class="py-5" style="background: #fff;">
            <div class="container">
                <div class="text-center mb-5">
                    <p class="text-uppercase fw-bold mb-1"
                       style="color: #c9a84c; letter-spacing: 3px; font-size: 0.8rem;">
                        Transparence
                    </p>
                    <h2 class="fw-bold" style="color: #1a1a1a;">Nos Formules</h2>
                    <div class="mx-auto mt-2"
                         style="width: 50px; height: 2px; background: #c9a84c;"/>
                </div>
                <div class="row g-4 justify-content-center">

                    <div class="col-md-4">
                        <div class="card border-0 shadow text-center p-4 h-100">
                            <h5 class="fw-bold mb-1">Intervention Ponctuelle</h5>
                            <p class="text-muted small mb-3">Dépannage ou réparation unique</p>
                            <div class="my-3">
                                <span class="display-6 fw-bold" style="color: #c9a84c;">
                                    Sur devis
                                </span>
                            </div>
                            <ul class="list-unstyled text-start text-muted small">
                                <li class="mb-2">
                                    <i class="fa fa-check me-2" style="color: #c9a84c;"/>
                                    Diagnostic complet inclus
                                </li>
                                <li class="mb-2">
                                    <i class="fa fa-check me-2" style="color: #c9a84c;"/>
                                    Pièces d'origine garanties
                                </li>
                                <li class="mb-2">
                                    <i class="fa fa-check me-2" style="color: #c9a84c;"/>
                                    Rapport d'intervention détaillé
                                </li>
                            </ul>
                            <a href="#devis"
                               class="btn mt-auto fw-semibold"
                               style="background: #c9a84c; color: #000; border-radius: 2px;">
                                Demander un devis
                            </a>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card border-0 shadow text-center p-4 h-100"
                             style="border-top: 4px solid #c9a84c !important;">
                            <p class="text-uppercase fw-bold small mb-1"
                               style="color: #c9a84c; letter-spacing: 2px;">
                                Recommandé
                            </p>
                            <h5 class="fw-bold mb-1">Contrat Annuel Yacht</h5>
                            <p class="text-muted small mb-3">Entretien préventif complet</p>
                            <div class="my-3">
                                <span class="display-6 fw-bold" style="color: #c9a84c;">
                                    2 500€
                                </span>
                                <span class="text-muted">/mois</span>
                            </div>
                            <ul class="list-unstyled text-start text-muted small">
                                <li class="mb-2">
                                    <i class="fa fa-check me-2" style="color: #c9a84c;"/>
                                    2 visites d'entretien/mois
                                </li>
                                <li class="mb-2">
                                    <i class="fa fa-check me-2" style="color: #c9a84c;"/>
                                    Priorité d'intervention 24h
                                </li>
                                <li class="mb-2">
                                    <i class="fa fa-check me-2" style="color: #c9a84c;"/>
                                    Rapport mensuel de l'état du yacht
                                </li>
                            </ul>
                            <a href="#devis"
                               class="btn mt-auto fw-semibold"
                               style="background: #c9a84c; color: #000; border-radius: 2px;">
                                Souscrire
                            </a>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card border-0 shadow text-center p-4 h-100">
                            <h5 class="fw-bold mb-1">Contrat Annuel Jet</h5>
                            <p class="text-muted small mb-3">Maintenance aéronautique certifiée</p>
                            <div class="my-3">
                                <span class="display-6 fw-bold" style="color: #c9a84c;">
                                    3 500€
                                </span>
                                <span class="text-muted">/mois</span>
                            </div>
                            <ul class="list-unstyled text-start text-muted small">
                                <li class="mb-2">
                                    <i class="fa fa-check me-2" style="color: #c9a84c;"/>
                                    Inspection mensuelle certifiée
                                </li>
                                <li class="mb-2">
                                    <i class="fa fa-check me-2" style="color: #c9a84c;"/>
                                    Gestion du carnet de maintenance
                                </li>
                                <li class="mb-2">
                                    <i class="fa fa-check me-2" style="color: #c9a84c;"/>
                                    Technicien EASA dédié
                                </li>
                            </ul>
                            <a href="#devis"
                               class="btn mt-auto fw-semibold"
                               style="background: #c9a84c; color: #000; border-radius: 2px;">
                                Souscrire
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- ═══════════════════════════════════════════
             SECTION 5 — FORMULAIRE DEVIS
        ═══════════════════════════════════════════ -->
        <section id="devis" class="py-5" style="background: #f8f8f8;">
            <div class="container">
                <div class="text-center mb-5">
                    <p class="text-uppercase fw-bold mb-1"
                       style="color: #c9a84c; letter-spacing: 3px; font-size: 0.8rem;">
                        Gratuit &amp; Sans engagement
                    </p>
                    <h2 class="fw-bold" style="color: #1a1a1a;">Demander un Devis</h2>
                    <div class="mx-auto mt-2"
                         style="width: 50px; height: 2px; background: #c9a84c;"/>
                </div>
                <div class="row justify-content-center">
                    <div class="col-lg-7">
                        <div class="card border-0 shadow p-4 p-md-5">
                            <form action="/maintenance/submit" method="POST">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>

                                <!-- Identité -->
                                <h5 class="fw-bold mb-3" style="color: #1a1a1a;">
                                    <i class="fa fa-user me-2" style="color: #c9a84c;"/>
                                    Vos coordonnées
                                </h5>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-semibold">Nom complet *</label>
                                        <input type="text" name="client_name"
                                               class="form-control" required="1"/>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-semibold">Email *</label>
                                        <input type="email" name="client_email"
                                               class="form-control" required="1"/>
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label fw-semibold">Téléphone</label>
                                    <input type="tel" name="client_phone"
                                           class="form-control"/>
                                </div>

                                <!-- Véhicule -->
                                <h5 class="fw-bold mb-3" style="color: #1a1a1a;">
                                    <i class="fa fa-cogs me-2" style="color: #c9a84c;"/>
                                    Votre véhicule
                                </h5>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-semibold">Type *</label>
                                        <select name="type_vehicule"
                                                class="form-select" required="1">
                                            <option value="">-- Sélectionner --</option>
                                            <option value="yacht">Yacht</option>
                                            <option value="jet">Jet Privé</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-semibold">Année de fabrication</label>
                                        <input type="number" name="annee"
                                               class="form-control"
                                               placeholder="ex: 2018"/>
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label fw-semibold">Modèle *</label>
                                    <input type="text" name="modele"
                                           class="form-control" required="1"
                                           placeholder="ex: Sunseeker Predator 74"/>
                                </div>

                                <!-- Intervention -->
                                <h5 class="fw-bold mb-3" style="color: #1a1a1a;">
                                    <i class="fa fa-wrench me-2" style="color: #c9a84c;"/>
                                    Intervention souhaitée
                                </h5>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Type d'intervention *</label>
                                    <select name="type_intervention"
                                            class="form-select" required="1">
                                        <option value="">-- Sélectionner --</option>
                                        <option value="mecanique">Maintenance mécanique</option>
                                        <option value="electronique">Électronique / Navigation</option>
                                        <option value="coque">Coque / Carlingue</option>
                                        <option value="interieur">Intérieur / Confort</option>
                                        <option value="avionique">Avionique (jet)</option>
                                        <option value="revision">Révision complète</option>
                                        <option value="autre">Autre</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">
                                        Localisation actuelle du véhicule *
                                    </label>
                                    <input type="text" name="localisation"
                                           class="form-control" required="1"
                                           placeholder="ex: Port de Monaco, Aéroport Nice"/>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label fw-semibold">
                                        Description / Détails supplémentaires
                                    </label>
                                    <textarea name="description"
                                              class="form-control" rows="4"
                                              placeholder="Décrivez le problème ou la prestation souhaitée..."/>
                                </div>

                                <div class="d-grid">
                                    <button type="submit"
                                            class="btn btn-lg fw-bold py-3"
                                            style="background: #c9a84c; color: #000; border-radius: 2px;">
                                        <i class="fa fa-paper-plane me-2"/>
                                        Envoyer ma demande
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══════════════════════════════════════════
             SECTION 6 — RÉASSURANCE
        ═══════════════════════════════════════════ -->
        <section class="py-4" style="background: #0a0a0a;">
            <div class="container">
                <div class="row text-center text-white g-3">
                    <div class="col-6 col-md-3">
                        <i class="fa fa-check-circle me-2" style="color: #c9a84c;"/>
                        <span class="small fw-semibold">Devis gratuit sous 24h</span>
                    </div>
                    <div class="col-6 col-md-3">
                        <i class="fa fa-clock-o me-2" style="color: #c9a84c;"/>
                        <span class="small fw-semibold">Disponible 24h/24 7j/7</span>
                    </div>
                    <div class="col-6 col-md-3">
                        <i class="fa fa-shield me-2" style="color: #c9a84c;"/>
                        <span class="small fw-semibold">Pièces d'origine garanties</span>
                    </div>
                    <div class="col-6 col-md-3">
                        <i class="fa fa-globe me-2" style="color: #c9a84c;"/>
                        <span class="small fw-semibold">Intervention mondiale</span>
                    </div>
                </div>
            </div>
        </section>

    </t>
</template>

<template id="luxury_maintenance_confirm" name="Confirmation Maintenance">
    <t t-call="website.layout">
        <div class="container py-5">
            <div class="row justify-content-center">
                <div class="col-lg-6 text-center">

                    <div class="mb-4">
                        <i class="fa fa-check-circle fa-5x"
                           style="color: #c9a84c;"/>
                    </div>

                    <h1 class="fw-bold mb-3" style="color: #1a1a1a;">
                        Demande envoyée !
                    </h1>

                    <p class="lead text-muted mb-4">
                        Merci <strong t-esc="client_name"/>,
                        votre demande de maintenance a bien été reçue.
                        Notre équipe vous contactera sous <strong>24h</strong>
                        à l'adresse <strong t-esc="client_email"/>.
                    </p>

                    <div class="card border-0 shadow-sm p-4 mb-4 text-start">
                        <p class="mb-2">
                            <i class="fa fa-check me-2" style="color: #c9a84c;"/>
                            Devis gratuit sans engagement
                        </p>
                        <p class="mb-2">
                            <i class="fa fa-check me-2" style="color: #c9a84c;"/>
                            Réponse sous 24h par email
                        </p>
                        <p class="mb-0">
                            <i class="fa fa-check me-2" style="color: #c9a84c;"/>
                            Technicien certifié disponible 24/7
                        </p>
                    </div>

                    <a href="/maintenance"
                       class="btn btn-outline-secondary me-2">
                        <i class="fa fa-arrow-left me-2"/>
                        Retour
                    </a>
                    <a href="/"
                       class="btn fw-semibold"
                       style="background: #c9a84c; color: #000;">
                        <i class="fa fa-home me-2"/>
                        Accueil
                    </a>

                </div>
            </div>
        </div>
    </t>
</template>
</odoo>