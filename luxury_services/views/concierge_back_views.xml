<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════
         SÉQUENCE
    ═══════════════════════════════════════════ -->
    <record id="seq_luxury_concierge" model="ir.sequence">
        <field name="name">Luxury Concierge</field>
        <field name="code">luxury.concierge.request</field>
        <field name="prefix">CONC/</field>
        <field name="padding">5</field>
    </record>

    <!-- ═══════════════════════════════════════════
         VUE LISTE
    ═══════════════════════════════════════════ -->
    <record id="view_luxury_concierge_list" model="ir.ui.view">
        <field name="name">luxury.concierge.request.list</field>
        <field name="model">luxury.concierge.request</field>
        <field name="arch" type="xml">
            <list string="Demandes Conciergerie"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'in_progress'"
                  decoration-primary="state == 'proposal'"
                  decoration-success="state in ('confirmed', 'done')"
                  decoration-danger="state == 'cancel'">
                <field name="name"/>
                <field name="client_name"/>
                <field name="client_firstname"/>
                <field name="client_email"/>
                <field name="client_phone"/>
                <field name="type_service"/>
                <field name="destination"/>
                <field name="date_souhaitee"/>
                <field name="nb_personnes"/>
                <field name="budget"/>
                <field name="state"/>
                <field name="create_date" string="Reçue le"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════
         VUE FORMULAIRE
    ═══════════════════════════════════════════ -->
    <record id="view_luxury_concierge_form" model="ir.ui.view">
        <field name="name">luxury.concierge.request.form</field>
        <field name="model">luxury.concierge.request</field>
        <field name="arch" type="xml">
            <form string="Demande Conciergerie">
                <header>
                    <button name="action_in_progress"
                            string="Prendre en charge"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_proposal"
                            string="Proposition envoyée"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_confirm"
                            string="Confirmer"
                            type="object"
                            class="btn-success"
                            invisible="state != 'proposal'"/>
                    <button name="action_done"
                            string="Marquer terminée"
                            type="object"
                            class="btn-success"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel"
                            string="Annuler"
                            type="object"
                            class="btn-danger"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_reset"
                            string="Remettre en Nouvelle"
                            type="object"
                            invisible="state != 'cancel'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,in_progress,proposal,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group string="Informations client">
                        <group>
                            <field name="client_name"/>
                            <field name="client_firstname"/>
                            <field name="client_email"/>
                            <field name="client_phone"/>
                        </group>
                    </group>

                    <group string="Détails de la demande">
                        <group>
                            <field name="type_service"/>
                            <field name="destination"/>
                            <field name="date_souhaitee"/>
                        </group>
                        <group>
                            <field name="nb_personnes"/>
                            <field name="budget"/>
                        </group>
                    </group>

                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>

                    <group string="Notes internes">
                        <field name="notes_internes" nolabel="1"/>
                    </group>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════
         ACTION
    ═══════════════════════════════════════════ -->
    <record id="action_luxury_concierge" model="ir.actions.act_window">
        <field name="name">Demandes Conciergerie</field>
        <field name="res_model">luxury.concierge.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ═══════════════════════════════════════════
         MENU
    ═══════════════════════════════════════════ -->
    <menuitem id="menu_luxury_concierge"
              name="Conciergerie"
              parent="menu_luxury_root"
              action="action_luxury_concierge"
              sequence="30"/>

</odoo>