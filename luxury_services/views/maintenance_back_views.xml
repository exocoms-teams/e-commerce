<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════
         SÉQUENCE
    ═══════════════════════════════════════════ -->
    <record id="seq_luxury_maintenance" model="ir.sequence">
        <field name="name">Luxury Maintenance</field>
        <field name="code">luxury.maintenance.request</field>
        <field name="prefix">MAINT/</field>
        <field name="padding">5</field>
    </record>

    <!-- ═══════════════════════════════════════════
         VUE LISTE
    ═══════════════════════════════════════════ -->
    <record id="view_luxury_maintenance_list" model="ir.ui.view">
        <field name="name">luxury.maintenance.request.list</field>
        <field name="model">luxury.maintenance.request</field>
        <field name="arch" type="xml">
            <list string="Demandes de maintenance"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'in_progress'"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'cancel'">
                <field name="name"/>
                <field name="client_name"/>
                <field name="client_firstname"/>
                <field name="client_email"/>
                <field name="client_phone"/>
                <field name="type_vehicule"/>
                <field name="modele"/>
                <field name="type_intervention"/>
                <field name="localisation"/>
                <field name="state"/>
                <field name="create_date" string="Reçue le"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════
         VUE FORMULAIRE
    ═══════════════════════════════════════════ -->
    <record id="view_luxury_maintenance_form" model="ir.ui.view">
        <field name="name">luxury.maintenance.request.form</field>
        <field name="model">luxury.maintenance.request</field>
        <field name="arch" type="xml">
            <form string="Demande de Maintenance">
                <header>
                    <button name="action_in_progress"
                            string="Prendre en charge"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_done"
                            string="Marquer terminée"
                            type="object"
                            class="btn-success"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel"
                            string="Annuler"
                            type="object"
                            class="btn-danger"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_reset"
                            string="Remettre en Nouvelle"
                            type="object"
                            invisible="state != 'cancel'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,in_progress,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group string="Informations client">
                        <group>
                            <field name="client_name"/>
                            <field name="client_email"/>
                            <field name="client_firstname"/>
                            <field name="client_phone"/>
                        </group>
                    </group>

                    <group string="Véhicule">
                        <group>
                            <field name="type_vehicule"/>
                            <field name="modele"/>
                        </group>
                        <group>
                            <field name="annee"/>
                            <field name="localisation"/>
                        </group>
                    </group>

                    <group string="Intervention souhaitée">
                        <group>
                            <field name="type_intervention"/>
                        </group>
                    </group>

                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>

                </sheet>

                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════
         ACTION
    ═══════════════════════════════════════════ -->
    <record id="action_luxury_maintenance" model="ir.actions.act_window">
        <field name="name">Demandes de Maintenance</field>
        <field name="res_model">luxury.maintenance.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ═══════════════════════════════════════════
         MENU
    ═══════════════════════════════════════════ -->
    <menuitem id="menu_luxury_maintenance"
              name="Maintenance"
              parent="menu_luxury_root"
              action="action_luxury_maintenance"
              sequence="20"/>

</odoo>