<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_luxury" model="ir.ui.view">
        <field name="name">product.template.form.luxury</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            
            <xpath expr="//sheet" position="inside">
                <field name="is_luxury_product" invisible="1"/>
            </xpath>
            
            <xpath expr="//notebook" position="inside">
                <page string="Luxury Services" name="luxury_services" invisible="not is_luxury_product">
                    <group string="Informations générales">
                        <group>
                            <field name="categorie_luxe"/>
                            <field name="type_service"/>
                            <field name="disponible"
                                   invisible="type_service == 'vente'"/>
                        </group>
                    </group>
                    <group string="Caractéristiques yacht"
                           invisible="categorie_luxe != 'yacht'">
                        <group>
                            <field name="longueur"/>
                            <field name="capacite_personnes"/>
                        </group>
                         <group>
                            
                            <field name="nb_cabines"/>
                            <field name="vitesse_croisiere"/>
                            <field name="annee_fabrication"/>
                            <field name="pavillon"/>
                        </group>
                    </group>
                    <group string="Informations Jet"
                        invisible="categorie_luxe != 'jet'">

                        <field name="constructeur_jet"/>
                        <field name="modele_jet"/>
                        <field name="autonomie_vol"/>
                        <field name="vitesse_max"/>
                        <field name="nombre_moteurs"/>
                        <field name="altitude_max"/>
                        <field name="equipage"/>

                    </group>
                    <group string="Location"
                           invisible="type_service == 'vente'">
                        <group>
                            <field name="duree_min_location"/>
                            <field name="prix_location_jour"/>
                        </group>

                        <group string="Destinations disponibles">
                            <field name="destination_ids"
                                   widget="many2many_tags"
                                   placeholder="Ajouter une destination..."/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>