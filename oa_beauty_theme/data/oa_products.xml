<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================== -->
        <!-- SKINCARE PRODUCTS                              -->
        <!-- ============================================== -->

        <!-- 1. O&A Hydrating Cleanser -->
        <record id="product_cleanser" model="product.template">
            <field name="name">O&amp;A Hydrating Cleanser</field>
            <field name="list_price">38.00</field>
            <field name="type">consu</field>
            <field name="sale_ok">True</field>
            <field name="website_published">True</field>
            <field name="public_categ_ids" eval="[(4, ref('public_category_skincare'))]"/>
            <field name="description_sale">Un nettoyant doux qui purifie sans assécher. Infusé à l'acide hyaluronique pour une peau propre et rebondie.</field>
            <field name="oa_key_ingredients">Acide Hyaluronique, Extrait de Thé Vert, Squalane</field>
            <field name="oa_type">Nettoyant visage</field>
            <field name="oa_finish">Rafraîchissant</field>
            <field name="oa_best_for">Tous types de peaux, particulièrement les peaux sèches</field>
        </record>

        <!-- 2. O&A Vitamin C Serum -->
        <record id="product_vitaminc" model="product.template">
            <field name="name">O&amp;A Vitamin C Serum</field>
            <field name="list_price">85.00</field>
            <field name="type">consu</field>
            <field name="sale_ok">True</field>
            <field name="website_published">True</field>
            <field name="public_categ_ids" eval="[(4, ref('public_category_skincare'))]"/>
            <field name="description_sale">Un sérum puissant et antioxydant qui illumine le teint, réduit les taches brunes et raffermit la peau avec 15% de vitamine C pure.</field>
            <field name="oa_key_ingredients">15% Acide L-Ascorbique, Vitamine E, Acide Férulique</field>
            <field name="oa_type">Sérum</field>
            <field name="oa_finish">Éclatant</field>
            <field name="oa_best_for">Teint terne, anti-âge</field>
        </record>

        <!-- 3. O&A Hyaluronic Essence -->
        <record id="product_hyaluronic" model="product.template">
            <field name="name">O&amp;A Hyaluronic Essence</field>
            <field name="list_price">55.00</field>
            <field name="type">consu</field>
            <field name="sale_ok">True</field>
            <field name="website_published">True</field>
            <field name="public_categ_ids" eval="[(4, ref('public_category_skincare'))]"/>
            <field name="description_sale">Une essence repulpante intense qui désaltère la peau. La première étape cruciale pour maximiser l'hydratation.</field>
            <field name="oa_key_ingredients">Acide Hyaluronique Multi-Poids, Eau de Rose</field>
            <field name="oa_type">Essence</field>
            <field name="oa_finish">Rosé</field>
            <field name="oa_best_for">Peaux déshydratées</field>
        </record>

        <!-- 4. O&A Radiance Moisturizer -->
        <record id="product_moisturizer" model="product.template">
            <field name="name">O&amp;A Radiance Moisturizer</field>
            <field name="list_price">68.00</field>
            <field name="type">consu</field>
            <field name="sale_ok">True</field>
            <field name="website_published">True</field>
            <field name="public_categ_ids" eval="[(4, ref('public_category_skincare'))]"/>
            <field name="description_sale">Crème de jour légère mais profondément nourrissante. Fixe l'hydratation et crée une base parfaite pour le maquillage.</field>
            <field name="oa_key_ingredients">Céramides, Niacinamide, Squalane</field>
            <field name="oa_type">Crème Hydratante</field>
            <field name="oa_finish">Naturel, Lumineux</field>
            <field name="oa_best_for">Soin quotidien</field>
        </record>

        <!-- 5. O&A Night Repair Cream -->
        <record id="product_nightcream" model="product.template">
            <field name="name">O&amp;A Night Repair Cream</field>
            <field name="list_price">95.00</field>
            <field name="type">consu</field>
            <field name="sale_ok">True</field>
            <field name="website_published">True</field>
            <field name="public_categ_ids" eval="[(4, ref('public_category_skincare'))]"/>
            <field name="description_sale">Un soin de nuit luxueux qui régénère la barrière cutanée pendant votre sommeil. Réveillez-vous avec une peau renouvelée.</field>
            <field name="oa_key_ingredients">Peptides, Rétinol doux, Beurre de Karité</field>
            <field name="oa_type">Soin de Nuit</field>
            <field name="oa_finish">Riche</field>
            <field name="oa_best_for">Régénération nocturne, anti-âge</field>
        </record>


        <!-- ============================================== -->
        <!-- MAKEUP PRODUCTS                                -->
        <!-- ============================================== -->

        <!-- 6. O&A Velvet Lipstick -->
        <record id="product_lipstick" model="product.template">
            <field name="name">O&amp;A Velvet Lipstick</field>
            <field name="list_price">34.00</field>
            <field name="type">consu</field>
            <field name="sale_ok">True</field>
            <field name="website_published">True</field>
            <field name="public_categ_ids" eval="[(4, ref('public_category_makeup'))]"/>
            <field name="description_sale">Une couleur intense et audacieuse alliée à un confort absolu. Finition mate veloutée qui n'assèche pas les lèvres.</field>
            <field name="oa_key_ingredients">Huile de Jojoba, Beurre de Cacao</field>
            <field name="oa_type">Rouge à Lèvres</field>
            <field name="oa_finish">Mat Velouté</field>
            <field name="oa_best_for">Longue tenue</field>
        </record>

        <!-- 7. O&A Radiant Foundation -->
        <record id="product_foundation" model="product.template">
            <field name="name">O&amp;A Radiant Foundation</field>
            <field name="list_price">52.00</field>
            <field name="type">consu</field>
            <field name="sale_ok">True</field>
            <field name="website_published">True</field>
            <field name="public_categ_ids" eval="[(4, ref('public_category_makeup'))]"/>
            <field name="description_sale">Fond de teint sérum à couvrance modulable. Fusionne avec la peau pour un fini 'seconde peau' naturel et éclatant.</field>
            <field name="oa_key_ingredients">Squalane, Pigments minéraux purs</field>
            <field name="oa_type">Fond de Teint</field>
            <field name="oa_finish">Lumineux, Naturel</field>
            <field name="oa_best_for">Couvrance modulable, peau perfectionnée</field>
        </record>

        <!-- 8. O&A Soft Glow Blush -->
        <record id="product_blush" model="product.template">
            <field name="name">O&amp;A Soft Glow Blush</field>
            <field name="list_price">28.00</field>
            <field name="type">consu</field>
            <field name="sale_ok">True</field>
            <field name="website_published">True</field>
            <field name="public_categ_ids" eval="[(4, ref('public_category_makeup'))]"/>
            <field name="description_sale">Un blush crème léger qui fond sur les joues pour une couleur naturelle et un éclat subtil.</field>
            <field name="oa_key_ingredients">Extraits de fruits, Vitamine E</field>
            <field name="oa_type">Blush Crème</field>
            <field name="oa_finish">Glowy, Naturel</field>
            <field name="oa_best_for">Effet bonne mine immédiat</field>
        </record>

        <!-- 9. O&A Volume Mascara -->
        <record id="product_mascara" model="product.template">
            <field name="name">O&amp;A Volume Mascara</field>
            <field name="list_price">30.00</field>
            <field name="type">consu</field>
            <field name="sale_ok">True</field>
            <field name="website_published">True</field>
            <field name="public_categ_ids" eval="[(4, ref('public_category_makeup'))]"/>
            <field name="description_sale">Un mascara ultra-noir qui allonge et donne un volume spectaculaire sans faire de paquets.</field>
            <field name="oa_key_ingredients">Cires végétales, Panthénol</field>
            <field name="oa_type">Mascara</field>
            <field name="oa_finish">Volume et Longueur</field>
            <field name="oa_best_for">Regard intense</field>
        </record>

        <!-- 10. O&A Precision Eyeliner -->
        <record id="product_eyeliner" model="product.template">
            <field name="name">O&amp;A Precision Eyeliner</field>
            <field name="list_price">24.00</field>
            <field name="type">consu</field>
            <field name="sale_ok">True</field>
            <field name="website_published">True</field>
            <field name="public_categ_ids" eval="[(4, ref('public_category_makeup'))]"/>
            <field name="description_sale">Un eyeliner liquide avec une pointe ultra-fine pour un tracé noir corbeau precis et longue tenue.</field>
            <field name="oa_key_ingredients">Pigments Carbone purs</field>
            <field name="oa_type">Eyeliner Liquide</field>
            <field name="oa_finish">Mat</field>
            <field name="oa_best_for">Oeil de chat, precision</field>
        </record>

    </data>
</odoo>
