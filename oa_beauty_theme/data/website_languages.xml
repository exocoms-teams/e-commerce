<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Activate Languages -->
    <record id="base.lang_fr" model="res.lang">
        <field name="active" eval="True"/>
    </record>
    <record id="base.lang_en" model="res.lang">
        <field name="active" eval="True"/>
    </record>
    <record id="base.lang_ar" model="res.lang">
        <field name="active" eval="True"/>
    </record>

    <!-- Configure Website -->
    <record id="oa_beauty_theme.oa_beauty_website" model="website">
        <field name="language_ids" eval="[(6, 0, [
            ref('base.lang_fr'),
            ref('base.lang_en'),
            ref('base.lang_ar')
        ])]"/>
        <field name="default_lang_id" ref="base.lang_fr"/>
        <field name="domain">oa-atelier.com</field>
    </record>
</odoo>
