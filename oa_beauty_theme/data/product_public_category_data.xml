<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Public e-commerce categories — mirror the filter-btn data-filter values
        from the original index.html (all / Lips / Face / Skincare / Eyes).
        "All" is the default /shop view and needs no separate record.

        NOTE: `product.public.category` only has a plain `sequence` field.
        `website_sequence` exists on `product.template` (website_sale), not
        on the public category model — using it here raised:
        ValueError: Invalid field 'website_sequence' in 'product.public.category'
        which crashed module install. Use `sequence` instead.
    -->
    <record id="public_category_lips" model="product.public.category">
        <field name="name">Lips</field>
        <field name="sequence">10</field>
    </record>

    <record id="public_category_face" model="product.public.category">
        <field name="name">Face</field>
        <field name="sequence">20</field>
    </record>

    <record id="public_category_skincare" model="product.public.category">
        <field name="name">Skincare</field>
        <field name="sequence">30</field>
    </record>

    <record id="public_category_eyes" model="product.public.category">
        <field name="name">Eyes</field>
        <field name="sequence">40</field>
    </record>
</odoo>
