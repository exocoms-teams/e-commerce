<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- These map 1:1 onto the data-filter values used by the original
         .filter-btn buttons in index.html. "All" is NOT created as a
         category — it's the native "no filter" state of the /shop page. -->
    <record id="public_category_lips" model="product.public.category">
        <field name="name">Lips</field>
    </record>

    <record id="public_category_face" model="product.public.category">
        <field name="name">Face</field>
    </record>

    <record id="public_category_skincare" model="product.public.category">
        <field name="name">Skincare</field>
    </record>

    <record id="public_category_eyes" model="product.public.category">
        <field name="name">Eyes</field>
    </record>

</odoo>
