        <!-- 1. O&amp;A Lumière — Women's, Floral/Fresh -->
        <record id="frag_lumiere" model="product.template">
            <field name="name">O&amp;A Lumière</field>
            <field name="type">consu</field>
            <field name="list_price">185.00</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="is_published">True</field>
            <field name="website_sequence">100</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('public_category_fragrances'), ref('public_category_frag_women'), ref('public_category_frag_new')])]"/>
            <field name="description_sale">A luminous ode to golden mornings. O&amp;A Lumière captures the first rays of sunlight filtering through a Mediterranean garden — sparkling citrus dances with dewy petals before settling into a warm, skin-like embrace. An effortlessly radiant signature for the modern woman.</field>
            <field name="oa_type">Eau de Parfum — 50ml</field>
            <field name="oa_is_coming_soon" eval="True"/>
            <field name="oa_fragrance_top_notes">Bergamot, Italian Mandarin, Pink Pepper</field>
            <field name="oa_fragrance_heart_notes">Orange Blossom, Jasmine Sambac, White Peach</field>
            <field name="oa_fragrance_base_notes">White Musk, Ambroxan, Cashmere Wood</field>
            <field name="oa_mood">Radiant, Luminous, Joyful</field>
            <field name="image_1920" type="base64" file="oa_beauty_theme/static/src/img/perfume_lumiere.png"/>
        </record>

