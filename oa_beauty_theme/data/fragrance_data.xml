<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ═══════════════════════════════════════════════════════
             O&amp;A BEAUTY — LUXURY FRAGRANCE COLLECTION
             "Official Collection Coming Soon"
             These are elegant placeholders for upcoming launches.
             ═══════════════════════════════════════════════════════ -->

        <!-- 1. Chanel N°5 — Women's -->
        <record id="frag_lumiere" model="product.template">
            <field name="name">Chanel N°5</field>
            <field name="type">consu</field>
            <field name="list_price">145.00</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="is_published">True</field>
            <field name="website_sequence">100</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('public_category_fragrances'), ref('public_category_frag_women'), ref('public_category_frag_new')])]"/>
            <field name="description_sale">L'essence même de la féminité. Un bouquet légendaire, mystérieux et intemporel. Chanel N°5 est le premier parfum abstrait, mariant des aldéhydes étincelants à un cœur somptueux d'ylang-ylang, jasmin et rose de mai, sur un fond poudré et sensuel.</field>
            <field name="oa_type">Eau de Parfum — 50ml</field>
            <field name="oa_is_coming_soon" eval="False"/>
            <field name="oa_fragrance_top_notes">Aldéhydes, Néroli, Ylang-Ylang</field>
            <field name="oa_fragrance_heart_notes">Jasmin de Grasse, Rose de Mai, Iris</field>
            <field name="oa_fragrance_base_notes">Bois de Santal, Vanille, Vétiver</field>
            <field name="oa_mood">Intemporel, Mythique, Poudré</field>
            <field name="image_1920" type="base64" file="oa_beauty_theme/static/src/img/perfume_lumiere.png"/>
        </record>

        <!-- 2. Yves Saint Laurent Libre — Women's -->
        <record id="frag_eclat" model="product.template">
            <field name="name">YSL Libre</field>
            <field name="type">consu</field>
            <field name="list_price">120.00</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="is_published">True</field>
            <field name="website_sequence">101</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('public_category_fragrances'), ref('public_category_frag_women')])]"/>
            <field name="description_sale">Le parfum de la liberté. Une tension brûlante entre la lavande de France, traditionnellement masculine, et la sensualité brûlante de la fleur d'oranger du Maroc. Un sillage floral audacieux et couture pour les femmes qui tracent leur propre chemin.</field>
            <field name="oa_type">Eau de Parfum — 50ml</field>
            <field name="oa_is_coming_soon" eval="False"/>
            <field name="oa_fragrance_top_notes">Lavande, Mandarine, Cassis</field>
            <field name="oa_fragrance_heart_notes">Fleur d'Oranger, Jasmin, Lavande</field>
            <field name="oa_fragrance_base_notes">Vanille de Madagascar, Ambre gris, Cèdre</field>
            <field name="oa_mood">Audacieux, Libre, Sensationnel</field>
            <field name="image_1920" type="base64" file="oa_beauty_theme/static/src/img/perfume_eclat.png"/>
        </record>

        <!-- 3. Bleu de Chanel — Men's -->
        <record id="frag_noire" model="product.template">
            <field name="name">Bleu de Chanel</field>
            <field name="type">consu</field>
            <field name="list_price">110.00</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="is_published">True</field>
            <field name="website_sequence">102</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('public_category_fragrances'), ref('public_category_frag_men'), ref('public_category_frag_bestsellers')])]"/>
            <field name="description_sale">L'éloge de la liberté masculine dans un sillage boisé aromatique. Une signature intemporelle logée dans un flacon d'un bleu énigmatique. Bleu de Chanel révèle une fraîcheur tonique de pamplemousse et menthe avant de s'épanouir sur un accord ambré boisé noble.</field>
            <field name="oa_type">Eau de Parfum — 50ml</field>
            <field name="oa_is_coming_soon" eval="False"/>
            <field name="oa_fragrance_top_notes">Pamplemousse, Citron, Menthe, Poivre Rose</field>
            <field name="oa_fragrance_heart_notes">Gingembre, Muscade, Jasmin</field>
            <field name="oa_fragrance_base_notes">Encens, Vétiver, Cèdre, Bois de Santal</field>
            <field name="oa_mood">Magnétique, Élégant, Captivant</field>
            <field name="image_1920" type="base64" file="oa_beauty_theme/static/src/img/perfume_noire.png"/>
        </record>

        <!-- 4. Miss Dior — Women's -->
        <record id="frag_velvet_rose" model="product.template">
            <field name="name">Miss Dior</field>
            <field name="type">consu</field>
            <field name="list_price">135.00</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="is_published">True</field>
            <field name="website_sequence">103</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('public_category_fragrances'), ref('public_category_frag_women'), ref('public_category_frag_bestsellers')])]"/>
            <field name="description_sale">Un souffle d'amour et d'optimisme. Miss Dior se réinvente avec un bouquet floral coloré : des notes de rose de Grasse, de pivoine et d'iris sont illuminées par un accord de muguet tendre, reposant sur une base de bois tendres et vanille.</field>
            <field name="oa_type">Eau de Parfum — 50ml</field>
            <field name="oa_is_coming_soon" eval="False"/>
            <field name="oa_fragrance_top_notes">Iris, Pivoine, Muguet</field>
            <field name="oa_fragrance_heart_notes">Rose de Grasse, Pêche, Abricot</field>
            <field name="oa_fragrance_base_notes">Vanille, Fève Tonka, Musc, Benjoin</field>
            <field name="oa_mood">Romantique, Pétillant, Floral</field>
            <field name="image_1920" type="base64" file="oa_beauty_theme/static/src/img/perfume_velvet_rose.png"/>
        </record>

        <!-- 5. J'adore de Dior — Women's -->
        <record id="frag_golden_bloom" model="product.template">
            <field name="name">Dior J'adore</field>
            <field name="type">consu</field>
            <field name="list_price">140.00</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="is_published">True</field>
            <field name="website_sequence">104</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('public_category_fragrances'), ref('public_category_frag_women'), ref('public_category_frag_new')])]"/>
            <field name="description_sale">Le grand féminin floral de Dior. Un bouquet façonné au détail près, comme une fleur sur mesure. L'essence d'ylang-ylang des Comores et la rose damascena s'unissent au jasmin sambac et au jasmin de Grasse pour une harmonie lumineuse et sensuelle.</field>
            <field name="oa_type">Eau de Parfum — 50ml</field>
            <field name="oa_is_coming_soon" eval="False"/>
            <field name="oa_fragrance_top_notes">Ylang-Ylang des Comores, Poire, Pêche</field>
            <field name="oa_fragrance_heart_notes">Rose Damascena, Jasmin de Grasse, Jasmin Sambac</field>
            <field name="oa_fragrance_base_notes">Musc Blanc, Mûre, Vanille</field>
            <field name="oa_mood">Lumineux, Majestueux, Sensuel</field>
            <field name="image_1920" type="base64" file="oa_beauty_theme/static/src/img/perfume_golden_bloom.png"/>
        </record>

        <!-- 6. Dior Sauvage — Men's -->
        <record id="frag_midnight_orchid" model="product.template">
            <field name="name">Dior Sauvage</field>
            <field name="type">consu</field>
            <field name="list_price">115.00</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="is_published">True</field>
            <field name="website_sequence">105</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('public_category_fragrances'), ref('public_category_frag_men'), ref('public_category_frag_bestsellers')])]"/>
            <field name="description_sale">Un acte de création inspiré des grands espaces. Un ciel bleu azur qui surplombe un désert rocheux chauffé à blanc. Sauvage dévoile une fraîcheur brute et noble portée par la bergamote de Calabre, soutenue par le sillage boisé puissant de l'ambroxan.</field>
            <field name="oa_type">Eau de Parfum — 60ml</field>
            <field name="oa_is_coming_soon" eval="False"/>
            <field name="oa_fragrance_top_notes">Bergamote de Calabre, Poivre de Sichuan</field>
            <field name="oa_fragrance_heart_notes">Lavande, Poivre rose, Patchouli, Vétiver</field>
            <field name="oa_fragrance_base_notes">Ambroxan, Cèdre, Labdanum</field>
            <field name="oa_mood">Brut, Frais, Puissant</field>
            <field name="image_1920" type="base64" file="oa_beauty_theme/static/src/img/perfume_midnight_orchid.png"/>
        </record>

    </data>
</odoo>
