<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- The "Shade" attribute itself ships with the module so its
         technical configuration (color swatches, always-create-variant)
         is consistent across dev/staging/production. The 29 individual
         shade VALUES (Rose Petal, Berry Kiss, Porcelain, Onyx, ...) are
         catalog content, not structure, so they are imported from
         02_product_attribute_values.csv instead of hard-coded here. -->
    <record id="attribute_shade" model="product.attribute">
        <field name="name">Shade</field>
        <field name="display_type">color</field>
        <field name="create_variant">always</field>
        <!-- create_variant="always": every shade is a distinct sellable
             variant (own barcode/stock), matching the original UX where
             selecting a shade is a real product choice, not just a
             cosmetic label. -->
    </record>

</odoo>
