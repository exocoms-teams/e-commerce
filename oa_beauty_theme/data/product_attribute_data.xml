<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Shade product attribute — replaces the custom .shade-circle JS picker
            from the original product.js. display_type='color' renders native
            Odoo colour swatches; create_variant='always' creates one product.product
            per shade combination.
        -->
        <record id="attribute_shade" model="product.attribute">
            <field name="name">Shade</field>
            <field name="display_type">color</field>
            <field name="create_variant">always</field>
        </record>
    </data>
</odoo>
