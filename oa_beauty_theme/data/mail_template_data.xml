<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_oai_order_confirmation" model="mail.template">
            <field name="name">O&amp;A Atelier: Order Confirmation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Votre Rituel Beauté est en route - Commande {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="description">Template envoyé aux clients après validation de commande.</field>
            <field name="body_html" type="html"><![CDATA[
<div style="margin:0;padding:0;background-color:#FDFBF7;font-family:'Jost',Helvetica,Arial,sans-serif;color:#3A3238;">
  <table border="0" cellpadding="0" cellspacing="0" width="100%" style="min-width:100%;background-color:#FDFBF7;">
    <tr>
      <td align="center">
        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width:600px;margin:40px auto;background-color:#ffffff;border:1px solid #EBE4E0;">
          <tr>
            <td align="center" style="padding:40px 20px;background-color:#FDFBF7;border-bottom:1px solid #EBE4E0;">
              <h1 style="margin:0;font-family:'Cormorant Garamond',Georgia,serif;font-weight:400;font-size:28px;letter-spacing:0.1em;color:#3A3238;">O.A.I BEAUTY</h1>
            </td>
          </tr>
          <tr>
            <td style="padding:40px 40px 20px 40px;">
              <p style="margin:0 0 20px 0;font-size:16px;line-height:1.6;">Chère/Cher <t t-esc="object.partner_id.name"/>,</p>
              <p style="margin:0 0 20px 0;font-size:16px;line-height:1.6;">Merci pour votre confiance. Nous avons le plaisir de vous confirmer la réception de votre commande <strong><t t-esc="object.name"/></strong>.</p>
              <p style="margin:0 0 30px 0;font-size:16px;line-height:1.6;">Votre rituel est actuellement préparé avec le plus grand soin par notre conciergerie. Vous recevrez un second e-mail contenant le numéro de suivi dès que votre colis quittera notre atelier.</p>
              <div style="text-align:center;margin:40px 0;"><a t-att-href="object.get_base_url() + '/my/orders/' + str(object.id)" style="background-color:#3A3238;color:#FDFBF7;padding:14px 28px;text-decoration:none;font-size:14px;letter-spacing:0.1em;text-transform:uppercase;">Voir ma commande</a></div>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:30px 40px;background-color:#FDFBF7;border-top:1px solid #EBE4E0;">
              <p style="margin:0 0 10px 0;font-family:'Cormorant Garamond',Georgia,serif;font-size:18px;font-style:italic;color:#9A7B8A;">La beauté à deux voix. Révélée, jamais déguisée.</p>
              <p style="margin:0;font-size:12px;color:#999999;">O&amp;A Atelier - Paris<br/><a href="mailto:contact@oa-atelier.com" style="color:#9A7B8A;text-decoration:none;">contact@oa-atelier.com</a></p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</div>
            ]]></field>
        </record>
    </data>
</odoo>
