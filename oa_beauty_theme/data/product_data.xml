<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 
            These records are left empty INTENTIONALLY.
            Odoo's `ir.model.data` expects these XML IDs to exist in the module.
            By leaving them empty, Odoo will not delete them on upgrade, 
            but it will also not overwrite any fields (like `is_published` or `active`).
            This allows users to archive or modify products without them resetting on module update.
        -->
        
        <!-- 01 — Sérum Signature -->
        <record id="product_serum_signature" model="product.template">
        </record>

        <!-- 02 — Fond de Teint Lumière -->
        <record id="product_fond_de_teint_lumiere" model="product.template">
        </record>

        <!-- 03 — Baume Lèvres -->
        <record id="product_baume_levres" model="product.template">
        </record>

        <!-- 04 — Palette Regard -->
        <record id="product_palette_regard" model="product.template">
        </record>

        <!-- 05 — Huile Corps -->
        <record id="product_huile_corps" model="product.template">
        </record>

        <!-- 06 — Eau de Parfum 'Trinité' -->
        <record id="product_parfum_trinite" model="product.template">
        </record>
    </data>
</odoo>
