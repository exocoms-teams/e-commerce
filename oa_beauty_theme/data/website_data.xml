<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="oa_beauty_website" model="website">
        <field name="name">OA Atelier</field>
        <field name="domain">https://oa-atelier.com</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="website_page_homepage" model="website.page">
        <field name="name">O&amp;A Atelier — Home</field>
        <field name="url">/</field>
        <field name="view_id" ref="oa_beauty_theme.view_homepage_lumiere"/>
        <field name="is_published" eval="True"/>
        <field name="is_homepage" eval="True"/>
        <field name="website_id" ref="oa_beauty_theme.oa_beauty_website"/>
    </record>

</odoo>
