<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Bind the homepage view to URL "/" and mark it as the homepage.
        The view itself (QWeb arch) lives in views/website_homepage.xml.
        Separating view from page record is required in Odoo 19:
        website.page has no 'arch' or 'type' or 'key' fields — those
        belong to ir.ui.view.
    -->
    <record id="website_page_homepage" model="website.page">
        <field name="name">O&amp;A Beauty — Home</field>
        <field name="url">/</field>
        <field name="view_id" ref="oa_beauty_theme.view_homepage_lumiere"/>
        <field name="is_published" eval="True"/>
        <field name="is_homepage" eval="True"/>
    </record>

</odoo>
