<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="oa_beauty_website" model="website">
        <field name="name">OA Atelier</field>
        <!-- Le domaine oa-atelier.com sera configuré manuellement via l'interface Odoo
             uniquement sur l'environnement de production, après configuration DNS chez IONOS -->
        <field name="domain">oa-atelier.com</field>
        <field name="company_id" ref="base.main_company"/>
    </record>


</odoo>
