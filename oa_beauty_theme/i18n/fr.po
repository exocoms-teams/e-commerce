#. module: oa_beauty_theme
msgid ""
"<strong>1 à 2 fois par semaine :</strong> appliquez sur peau humide, massez "
"doucement en mouvements circulaires, puis rincez."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Acide hyaluronique triphasé</strong> — trois poids moléculaires "
"distincts pour une hydratation en profondeur, en surface et entre les deux. "
"La peau est comblée à chaque strate."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Après la douche :</strong> appliquez sur peau encore légèrement "
"humide pour renforcer l'hydratation et garder une sensation de douceur toute"
" la journée."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Après le nettoyage :</strong> appliquez 3 à 4 presses dans le creux "
"des mains, puis tapotez doucement sur le visage et le cou."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Avant la crème :</strong> laissez pénétrer quelques secondes pour "
"maximiser l'hydratation et l'absorption des actifs."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Avant le maquillage :</strong> vaporisez sur le visage, puis "
"appliquez le soin suivant pour un rendu plus souple et plus lumineux."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Avant toute exposition :</strong> appliquez une quantité généreuse "
"sur le visage, le cou et les zones exposées 15 à 20 minutes avant le soleil."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Couleur du quotidien :</strong><br/>Appliquez directement depuis "
"l'étui en partant du centre des lèvres vers les coins. Lissez avec la pulpe "
"du doigt pour fondre la couleur et créer un effet \"lèvres teintées de "
"l'intérieur\"."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>En journée :</strong> vaporisez à 20 centimètres du visage et "
"laissez sécher naturellement. L'effet est surtout agréable après un long "
"trajet, un moment stressant ou de la chaleur."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Extrait de niacinamide (vitamine B3) à 3 %</strong> — pour unifier "
"le teint, atténuer les rougeurs et soutenir la barrière cutanée tout au long"
" de la journée."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Extrait de rose de Damas bio</strong> — sélectionné pour sa richesse"
" en polyphénols naturels. Il révèle l'éclat, unifie le teint et protège la "
"peau des agressions quotidiennes."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Huile de jojoba bio</strong> — pour ce fini « peau fraîche » qui "
"rappelle une peau hydratée naturellement, sans effet brillant ni effet mat "
"artificiel."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Identification :</strong> nom, prenom, adresse e-mail, telephone."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Intensité &amp; Drama</strong> <em>(mixtes)</em> : Quatre teintes "
"profondes pour les regards affirmés."
msgstr ""

#. module: oa_beauty_theme
msgid "<strong>La pyramide olfactive :</strong>"
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Le conseil d'Irina :</strong><br/>\"Portez 'Trinité' comme une "
"deuxième peau — ni trop, ni pas assez. Deux vaporisations suffisent pour que"
" votre présence précède votre entrée dans la pièce.\""
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Le matin :</strong> appliquez 2 pressions sur les mains humides, "
"faites mousser légèrement, puis massez en mouvements doux sur le visage, "
"depuis le front jusqu'au menton."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Le matin :</strong> appliquez une petite quantité sur une peau "
"nettoyée et légèrement humide. L'eau aide à capter l'hydratation et donne un"
" fini plus souple."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Le matin :</strong> sur peau nettoyée, le produit peut se superposer"
" à votre soin hydratant et servir de base légère au maquillage."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Le matin et le soir :</strong> appliquez une petite quantité au bout"
" des doigts puis tapotez délicatement sur le contour de l'œil sans étirer la"
" peau."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Le matin et/ou le soir, après le nettoyage et avant la "
"crème.</strong>"
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Le nuage de parfum :</strong><br/>Vaporisez 'Trinité' en l'air "
"devant vous, à hauteur de visage, et traversez lentement le nuage. Le parfum"
" se dépose uniformément sur vos cheveux et vêtements."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Le soir :</strong> massez la crème en appuyant doucement du bout des"
" doigts sur le visage et le cou pour favoriser le confort cutané."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Le soir :</strong> travaillez le produit sur les zones les plus "
"exposées à la pollution et au maquillage, en insistant sur la zone T et le "
"contour du visage."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Les points de chaleur :</strong><br/>Vaporisez sur les poignets, la "
"nuque, le creux des coudes, derrière les genoux. Ces zones pulsent doucement"
" et diffusent le parfum en continu."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Lumières &amp; Bases</strong> <em>(finitions satinées)</em> : Quatre"
" teintes claires à appliquer sur l'ensemble de la paupière pour illuminer."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Lèvres baisers :</strong><br/>Appliquez une première couche, "
"tamponnez délicatement avec un mouchoir pour fixer, puis déposez une seconde"
" couche. Le pigment est scellé, la tenue prolongée, le brillant intact."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Massage ritualisé :</strong><br/>Versez 5 à 8 gouttes dans la paume."
" Frottez lentement les deux mains pour réchauffer l'huile. Commencez par les"
" pieds, remontez lentement vers le cœur (drainage lymphatique naturel)."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Navigation :</strong> adresse IP, cookies essentiels et analytiques."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Ne pas frotter :</strong><br/>La règle absolue. Frotter les poignets"
" l'un contre l'autre \"casse\" les molécules de tête du parfum et en altère "
"la composition."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Option 1 — Les doigts (effet seconde peau) :</strong><br/>Déposez "
"une noisette sur le dos de la main. Prélevez avec le bout des doigts et "
"tapotez en partant du centre du visage vers les tempes, en fondu sur les "
"contours. La chaleur des doigts fond le produit dans la peau pour un "
"résultat parfaitement naturel."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Option 2 — L'éponge humide (effet aérien) :</strong><br/>Humidifiez "
"légèrement une éponge de maquillage. Prélevez le fond de teint et appliquez "
"par tamponnements successifs — jamais en frottant. L'éponge humide dilue "
"imperceptiblement le produit pour un voile encore plus léger."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Option 3 — Le pinceau (effet couture) :</strong><br/>Utilisez un "
"pinceau plat à fond de teint pour une application plus couvrant sur les "
"zones souhaitées, en laissant le reste du visage en application doigt pour "
"conserver le contraste naturel."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Poudres de soie d'origine végétale</strong> — pour une texture "
"aérienne qui s'adapte à la morphologie de chaque pore sans jamais s'y "
"déposer de façon visible."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Pour les peaux très sèches :</strong> appliquez une couche "
"légèrement plus généreuse sur les joues, le front et le cou en petites "
"pressions puis terminez par quelques gestes circulaires."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Pour un effet plus lumineux :</strong> déposez une minuscule touche "
"sur les zones en relief comme les pommettes et l'arc de Cupidon."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Pour un regard plus structuré :</strong> fondez à l'aide du pinceau "
"ou du doigt pour obtenir un résultat plus fluide et homogène."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Pour un trait naturel :</strong> tracez le contour de l'arc à la "
"base, puis remplissez au fil des poils avec un mouvement doux et léger."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Profil Beaute :</strong> type de peau, preferences olfactives "
"(optionnel)."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Regard intense :</strong><br/>Commencez par une base de teinte "
"foncée en V sur les coins extérieurs. Déposez une teinte satiné moyenne sur "
"le centre de la paupière mobile. Foncez la racine des cils au pinceau liner "
"fin. Posez une touche de satiné clair sur le coin interne de l'œil."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Regard nude éveillé :</strong><br/>Balayez une teinte satiné clair "
"sur toute la paupière. Appliquez une teinte mate transition dans le creux "
"avec un pinceau biseauté. Estompez. Soulignez légèrement la racine des cils "
"avec une teinte sombre."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Règle d'or O.A.I :</strong><br/>Toujours commencer par l'œil, avant "
"le fond de teint — pour éviter la \"chute\" de fards de vous forcer à "
"retravailler le teint. Et toujours finir au doigt."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Sculpture &amp; Transition</strong> <em>(finitions mates)</em> : "
"Quatre teintes moyennes pour définir le creux de l'œil et fondre les "
"contrastes."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Soin pur :</strong><br/>Appliquez généreusement avant de dormir, "
"pour un effet \"lip mask\" naturel. Le matin, vos lèvres sont regonflées, "
"douces, régénérées."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Soir :</strong> appliquez une couche fine sur peau parfaitement "
"propre, en évitant le contour des yeux. Laissez agir pendant 10 à 15 "
"minutes, puis laissez le produit pénétrer en douceur."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Sur les zones sèches :</strong> coudes, genoux et talons : ajoutez "
"une seconde couche puis massez légèrement pour plus de confort."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Sur peau humide :</strong><br/>Après la douche, sans sécher "
"complètement — appliquez l'huile sur peau encore légèrement humide. L'eau "
"forme une émulsion naturelle qui améliore la pénétration et laisse la peau "
"nacrée, jamais collante."
msgstr ""

#. module: oa_beauty_theme
msgid "<strong>Sur une peau propre, après votre soin habituel.</strong>"
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Transactions :</strong> historique d'achats, adresses de livraison."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>Zone de confort :</strong><br/>Sur les coudes secs, genoux ou talons"
" : appliquez une quantité généreuse et couvrez d'une chaussette chaude ou "
"d'un gant de coton une heure."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>À la fin du maquillage :</strong> utilisez un large pinceau et "
"appliquez très légèrement sur le visage pour fixer et lisser l'ensemble."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>À utiliser dès le premier signe de fatigue :</strong> en massant "
"doucement le contour pour une sensation rassérénante immédiate."
msgstr ""

#. module: oa_beauty_theme
msgid ""
"<strong>À éviter sur peau irritée :</strong> laissez le produit agir "
"uniquement sur les zones de texture ou de brillance, sans frotter fortement."
msgstr ""

