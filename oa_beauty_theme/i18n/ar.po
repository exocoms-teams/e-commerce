msgid "La Beauté Éditoriale"
msgstr "الجمال التحريري"

msgid "Trois Regards,<br/>Une Beauté"
msgstr "ثلاث رؤى،<br/>جمال واحد"

msgid "Formules transparentes, textures sensorielles, élégance sans compromis. Célébrez votre essence naturelle."
msgstr "تركيبات شفافة، ملمس حسي، وأناقة بلا تنازلات. احتفلي بجوهرك الطبيعي."

msgid "Découvrir la Collection"
msgstr "اكتشفي المجموعة"

msgid "Sérum Glow"
msgstr "سيروم النضارة"

msgid "Fond de Teint Lumineux"
msgstr "كريم أساس مضيء"

msgid "Texture"
msgstr "الملمس"

msgid "La beauté révélée,<br/><span class=\"oa-editorial-accent\">jamais déguisée.</span>"
msgstr "جمال مكشوف،<br/><span class=\"oa-editorial-accent\">وليس مزيفاً.</span>"

msgid "Notre Manifeste"
msgstr "بياننا"

msgid "Le Soin."
msgstr "العناية بالبشرة."

msgid "Nourrir en profondeur. Préparer la toile."
msgstr "تغذية عميقة. تحضير مثالي للبشرة."

msgid "Explorer"
msgstr "استكشاف"

msgid "La Couleur."
msgstr "اللون."

msgid "Sublimer avec audace. Exalter la confiance."
msgstr "إبراز بجرأة. تعزيز الثقة."

msgid "Science &amp; Nature"
msgstr "العلم والطبيعة"

msgid "Ingrédients Actifs de <span class=\"oa-editorial-accent\">Haute Performance</span>"
msgstr "مكونات فعالة <span class=\"oa-editorial-accent\">عالية الأداء</span>"

msgid "Squalane"
msgstr "السكوالين"

msgid "Hydratation Bio-compatible"
msgstr "ترطيب متوافق حيوياً"

msgid "Imite les huiles naturelles de la peau pour retenir l'hydratation sans obstruer les pores."
msgstr "يحاكي الزيوت الطبيعية للبشرة للاحتفاظ بالرطوبة دون سد المسام."

msgid "Acide Hyaluronique"
msgstr "حمض الهيالورونيك"

msgid "Repulpe &amp; Lisse"
msgstr "يمتلئ وينعم"

msgid "Attire l'eau à la surface de la peau pour un aspect radieux, rebondi et rajeuni."
msgstr "يجذب الماء إلى سطح البشرة لمظهر مشرق، ممتلئ ومجدد."

msgid "Vitamine C"
msgstr "فيتامين سي"

msgid "Éclat Antioxydant"
msgstr "إشراقة مضادة للأكسدة"

msgid "Illumine le teint, estompe les taches sombres et défend la peau contre les agresseurs environnementaux."
msgstr "يضيء البشرة، يزيل البقع الداكنة ويحمي البشرة من العوامل البيئية الضارة."

msgid "La Communauté O&amp;A Beauty"
msgstr "مجتمع O&A Beauty"

msgid "Rejoignez plus de <span class=\"oa-editorial-accent oa-counter-10k\" style=\"color: var(--oa-lilac);\">10000</span> clientes satisfaites"
msgstr "انضمي إلى أكثر من <span class=\"oa-editorial-accent oa-counter-10k\" style=\"color: var(--oa-lilac);\">10000</span> عميلة راضية"

msgid "Get the Look"
msgstr "احصلي على الإطلالة"

msgid "L'essentiel pour un fini naturel et lumineux."
msgstr "الأساسيات للحصول على لمسة نهائية طبيعية ومضيئة."

msgid "Voir tout"
msgstr "عرض الكل"
