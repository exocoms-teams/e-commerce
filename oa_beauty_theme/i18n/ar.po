#. module: oa_beauty_theme
msgid "<strong>1 à 2 fois par semaine :</strong> appliquez sur peau humide, massez doucement en mouvements circulaires, puis rincez."
msgstr "<strong>1 إلى 2 مرات أسبوعياً:</strong> ضعيه على بشرة رطبة، دلكي بلطف بحركات دائرية، ثم اشطفيه."

#. module: oa_beauty_theme
msgid "<strong>Acide hyaluronique triphasé</strong> — trois poids moléculaires distincts pour une hydratation en profondeur, en surface et entre les deux. La peau est comblée à chaque strate."
msgstr "<strong>حمض الهيالورونيك ثلاثي الأطوار</strong> — ثلاثة أوزان جزيئية مختلفة لترطيب عميق، سطحي، ومتوسط. تمتلئ البشرة بالرطوبة في كل طبقة."

#. module: oa_beauty_theme
msgid "<strong>Après la douche :</strong> appliquez sur peau encore légèrement humide pour renforcer l'hydratation et garder une sensation de douceur toute la journée."
msgstr "<strong>بعد الاستحمام:</strong> ضعيه على بشرة لا تزال رطبة قليلاً لتعزيز الترطيب والحفاظ على نعومة طوال اليوم."

#. module: oa_beauty_theme
msgid "<strong>Après le nettoyage :</strong> appliquez 3 à 4 presses dans le creux des mains, puis tapotez doucement sur le visage et le cou."
msgstr "<strong>بعد التنظيف:</strong> ضعي 3 إلى 4 ضغطات في راحة يدك، ثم ربتي بلطف على الوجه والرقبة."

#. module: oa_beauty_theme
msgid "<strong>Avant la crème :</strong> laissez pénétrer quelques secondes pour maximiser l'hydratation et l'absorption des actifs."
msgstr "<strong>قبل الكريم:</strong> اتركيه يتغلغل لبضع ثوانٍ لتعظيم الترطيب وامتصاص المكونات النشطة."

#. module: oa_beauty_theme
msgid "<strong>Avant le maquillage :</strong> vaporisez sur le visage, puis appliquez le soin suivant pour un rendu plus souple et plus lumineux."
msgstr "<strong>قبل المكياج:</strong> رشي على الوجه، ثم طبقي العناية التالية لمظهر أكثر مرونة وإشراقاً."

#. module: oa_beauty_theme
msgid "<strong>Avant toute exposition :</strong> appliquez une quantité généreuse sur le visage, le cou et les zones exposées 15 à 20 minutes avant le soleil."
msgstr "<strong>قبل أي تعرض للشمس:</strong> ضعي كمية سخية على الوجه والرقبة والمناطق المكشوفة قبل 15 إلى 20 دقيقة من التعرض للشمس."

#. module: oa_beauty_theme
msgid "<strong>Couleur du quotidien :</strong><br/>Appliquez directement depuis l'étui en partant du centre des lèvres vers les coins. Lissez avec la pulpe du doigt pour fondre la couleur et créer un effet \"lèvres teintées de l'intérieur\"."
msgstr "<strong>لون يومي:</strong><br/>طبقيه مباشرة من العبوة بدءاً من وسط الشفاه نحو الزوايا. امسحي بلب الإصبع لدمج اللون وخلق تأثير \"شفاه ملونة من الداخل\"."

#. module: oa_beauty_theme
msgid "<strong>En journée :</strong> vaporisez à 20 centimètres du visage et laissez sécher naturellement. L'effet est surtout agréable après un long trajet, un moment stressant ou de la chaleur."
msgstr "<strong>خلال النهار:</strong> رشي على بعد 20 سم من الوجه واتركيه يجف طبيعياً. التأثير لطيف خاصة بعد سفر طويل، لحظة توتر، أو حرارة."

#. module: oa_beauty_theme
msgid "<strong>Extrait de niacinamide (vitamine B3) à 3 %</strong> — pour unifier le teint, atténuer les rougeurs et soutenir la barrière cutanée tout au long de la journée."
msgstr "<strong>مستخلص النياسيناميد (فيتامين B3) بنسبة 3٪</strong> — لتوحيد لون البشرة، تخفيف الاحمرار، ودعم حاجز البشرة طوال اليوم."

#. module: oa_beauty_theme
msgid "<strong>Extrait de rose de Damas bio</strong> — sélectionné pour sa richesse en polyphénols naturels. Il révèle l'éclat, unifie le teint et protège la peau des agressions quotidiennes."
msgstr "<strong>مستخلص وردة دمشق العضوية</strong> — مختار لغناه بالبوليفينول الطبيعي. يكشف الإشراق، يوحد اللون، ويحمي البشرة من الاعتداءات اليومية."

#. module: oa_beauty_theme
msgid "<strong>Huile de jojoba bio</strong> — pour ce fini « peau fraîche » qui rappelle une peau hydratée naturellement, sans effet brillant ni effet mat artificiel."
msgstr "<strong>زيت الجوجوبا العضوي</strong> — لمنح تشطيب \"بشرة منتعشة\" يذكرنا ببشرة مرطبة طبيعياً، دون لمعان زائد أو مطفية مصطنعة."

#. module: oa_beauty_theme
msgid "<strong>Identification :</strong> nom, prenom, adresse e-mail, telephone."
msgstr "<strong>التعريف:</strong> الاسم، اللقب، البريد الإلكتروني، الهاتف."

#. module: oa_beauty_theme
msgid "<strong>Intensité &amp; Drama</strong> <em>(mixtes)</em> : Quatre teintes profondes pour les regards affirmés."
msgstr "<strong>كثافة ودراما</strong> <em>(مختلطة)</em>: أربع درجات عميقة للنظرات الجريئة."

#. module: oa_beauty_theme
msgid "<strong>La pyramide olfactive :</strong>"
msgstr "<strong>الهرم العطري:</strong>"

#. module: oa_beauty_theme
msgid "<strong>Le conseil d'Irina :</strong><br/>\"Portez 'Trinité' comme une deuxième peau — ni trop, ni pas assez. Deux vaporisations suffisent pour que votre présence précède votre entrée dans la pièce.\""
msgstr "<strong>نصيحة إيرينا:</strong><br/>\"ارتدي 'ترينيتي' كبشرة ثانية — لا كثيراً ولا قليلاً. رشتان تكفيان لجعل حضورك يسبق دخولك الغرفة.\""

#. module: oa_beauty_theme
msgid "<strong>Le matin :</strong> appliquez 2 pressions sur les mains humides, faites mousser légèrement, puis massez en mouvements doux sur le visage, depuis le front jusqu'au menton."
msgstr "<strong>صباحاً:</strong> ضعي ضغطتين على يدين مبللتين، اصنعي رغوة خفيفة، ثم دلكي بحركات ناعمة على الوجه، من الجبين حتى الذقن."

#. module: oa_beauty_theme
msgid "<strong>Le matin :</strong> appliquez une petite quantité sur une peau nettoyée et légèrement humide. L'eau aide à capter l'hydratation et donne un fini plus souple."
msgstr "<strong>صباحاً:</strong> ضعي كمية صغيرة على بشرة نظيفة ورطبة قليلاً. الماء يساعد على احتباس الترطيب ويمنح تشطيباً أكثر مرونة."

#. module: oa_beauty_theme
msgid "<strong>Le matin :</strong> sur peau nettoyée, le produit peut se superposer à votre soin hydratant et servir de base légère au maquillage."
msgstr "<strong>صباحاً:</strong> على بشرة نظيفة، يمكن للمنتج أن ي_layer فوق مرطبك ويعمل كأساس خفيف للمكياج."

#. module: oa_beauty_theme
msgid "<strong>Le matin et le soir :</strong> appliquez une petite quantité au bout des doigts puis tapotez délicatement sur le contour de l'œil sans étirer la peau."
msgstr "<strong>صباحاً ومساءً:</strong> ضعي كمية صغيرة على أطراف الأصابع ثم ربتي بلطف حول العين دون سحب البشرة."

#. module: oa_beauty_theme
msgid "<strong>Le matin et/ou le soir, après le nettoyage et avant la crème.</strong>"
msgstr "<strong>صباحاً و/أو مساءً، بعد التنظيف وقبل الكريم.</strong>"

#. module: oa_beauty_theme
msgid "<strong>Le nuage de parfum :</strong><br/>Vaporisez 'Trinité' en l'air devant vous, à hauteur de visage, et traversez lentement le nuage. Le parfum se dépose uniformément sur vos cheveux et vêtements."
msgstr "<strong>سحابة العطر:</strong><br/>رشي 'ترينيتي' في الهواء أمامك على مستوى الوجه، وامشي ببطء خلال السحابة. يستقر العطر بشكل موحد على شعرك وملابسك."

#. module: oa_beauty_theme
msgid "<strong>Le soir :</strong> massez la crème en appuyant doucement du bout des doigts sur le visage et le cou pour favoriser le confort cutané."
msgstr "<strong>مساءً:</strong> دلكي الكريم بالضغط بلطف بأطراف الأصابع على الوجه والرقبة لتعزيز راحة البشرة."

#. module: oa_beauty_theme
msgid "<strong>Le soir :</strong> travaillez le produit sur les zones les plus exposées à la pollution et au maquillage, en insistant sur la zone T et le contour du visage."
msgstr "<strong>مساءً:</strong> اعملي المنتج على المناطق الأكثر تعرضاً للتلوث والمكياج، مع التركيز على المنطقة T ومحيط الوجه."

#. module: oa_beauty_theme
msgid "<strong>Les points de chaleur :</strong><br/>Vaporisez sur les poignets, la nuque, le creux des coudes, derrière les genoux. Ces zones pulsent doucement et diffusent le parfum en continu."
msgstr "<strong>نقاط الحرارة:</strong><br/>رشي على المعصمين، مؤخرة الرقبة، تجويف المرفقين، خلف الركبتين. هذه المناطق تنبض بلطف وتنشر العطر باستمرار."

#. module: oa_beauty_theme
msgid "<strong>Lumières &amp; Bases</strong> <em>(finitions satinées)</em> : Quatre teintes claires à appliquer sur l'ensemble de la paupière pour illuminer."
msgstr "<strong>إضاءات وقواعد</strong> <em>(تشطيبات ساتانية)</em>: أربع درجات فاتحة توضع على كامل الجفن للإضاءة."

#. module: oa_beauty_theme
msgid "<strong>Lèvres baisers :</strong><br/>Appliquez une première couche, tamponnez délicatement avec un mouchoir pour fixer, puis déposez une seconde couche. Le pigment est scellé, la tenue prolongée, le brillant intact."
msgstr "<strong>شفاه القبلات:</strong><br/>طبقي طبقة أولى، ربتي بلطف بمنديل للتثبيت، ثم ضعي طبقة ثانية. يتم تثبيت الصبغة، تطول مدة الثبات، ويبقى اللمعان intact."

#. module: oa_beauty_theme
msgid "<strong>Massage ritualisé :</strong><br/>Versez 5 à 8 gouttes dans la paume. Frottez lentement les deux mains pour réchauffer l'huile. Commencez par les pieds, remontez lentement vers le cœur (drainage lymphatique naturel)."
msgstr "<strong>تدليك طقوسي:</strong><br/>صبّي 5 إلى 8 قطرات في راحة اليد. افركي اليدين ببطء لتدفئة الزيت. ابدئي بالقدمين، واصعدي ببطء نحو القلب (تصريف لمفاوي طبيعي)."

#. module: oa_beauty_theme
msgid "<strong>Navigation :</strong> adresse IP, cookies essentiels et analytiques."
msgstr "<strong>التصفح:</strong> عنوان IP، ملفات تعريف الارتباط الأساسية والتحليلية."

#. module: oa_beauty_theme
msgid "<strong>Ne pas frotter :</strong><br/>La règle absolue. Frotter les poignets l'un contre l'autre \"casse\" les molécules de tête du parfum et en altère la composition."
msgstr "<strong>لا تفركي:</strong><br/>القاعدة الذهبية. فرك المعصمين ببعضهما \"يكسر\" جزيئات رأس العطر ويغير تركيبته."

#. module: oa_beauty_theme
msgid "<strong>Option 1 — Les doigts (effet seconde peau) :</strong><br/>Déposez une noisette sur le dos de la main. Prélevez avec le bout des doigts et tapotez en partant du centre du visage vers les tempes, en fondu sur les contours. La chaleur des doigts fond le produit dans la peau pour un résultat parfaitement naturel."
msgstr "<strong>الخيار 1 — الأصابع (تأثير البشرة الثانية):</strong><br/>ضعي كمية بحجم حبة البندق على ظهر اليد. خذيها بأطراف الأصابع وربتي بدءاً من وسط الوجه نحو الصدغين، مع الدمج عند الحدود. حرارة الأصابع تذيب المنتج في البشرة لنتيجة طبيعية تماماً."

#. module: oa_beauty_theme
msgid "<strong>Option 2 — L'éponge humide (effet aérien) :</strong><br/>Humidifiez légèrement une éponge de maquillage. Prélevez le fond de teint et appliquez par tamponnements successifs — jamais en frottant. L'éponge humide dilue imperceptiblement le produit pour un voile encore plus léger."
msgstr "<strong>الخيار 2 — الإسفنجة الرطبة (تأثير هوائي):</strong><br/>بللي إسفنجة المكياج قليلاً. خذي كريم الأساس وطبقيه بالتربيت المتتابع — أبداً بالفرك. الإسفنجة الرطبة تخفف المنتج بشكل غير محسوس لطبقة أخف."

#. module: oa_beauty_theme
msgid "<strong>Option 3 — Le pinceau (effet couture) :</strong><br/>Utilisez un pinceau plat à fond de teint pour une application plus couvrant sur les zones souhaitées, en laissant le reste du visage en application doigt pour conserver le contraste naturel."
msgstr "<strong>الخيار 3 — الفرشاة (تأثير عالي الدقة):</strong><br/>استخدمي فرشاة مسطحة لكريم الأساس لتغطية أعلى في المناطق المطلوبة، مع ترك باقي الوجه بتطبيق الأصابع للحفاظ على التباين الطبيعي."

#. module: oa_beauty_theme
msgid "<strong>Poudres de soie d'origine végétale</strong> — pour une texture aérienne qui s'adapte à la morphologie de chaque pore sans jamais s'y déposer de façon visible."
msgstr "<strong>مساحيق حرير نباتية المصدر</strong> — لقوام هوائي يتكيف مع شكل كل مسام دون أن يترسب فيها بشكل مرئي."

#. module: oa_beauty_theme
msgid "<strong>Pour les peaux très sèches :</strong> appliquez une couche légèrement plus généreuse sur les joues, le front et le cou en petites pressions puis terminez par quelques gestes circulaires."
msgstr "<strong>للبراش الجافة جداً:</strong> ضعي طبقة أكثر سخاءً قليلاً على الخدين والجبهة والرقبة بضغطات صغيرة، ثم أنهِي بحركات دائرية."

#. module: oa_beauty_theme
msgid "<strong>Pour un effet plus lumineux :</strong> déposez une minuscule touche sur les zones en relief comme les pommettes et l'arc de Cupidon."
msgstr "<strong>لتأثير أكثر إشراقاً:</strong> ضعي لمسة صغيرة جداً على المناطق البارزة مثل عظام الوجنتين وقوس كيوبيد."

#. module: oa_beauty_theme
msgid "<strong>Pour un regard plus structuré :</strong> fondez à l'aide du pinceau ou du doigt pour obtenir un résultat plus fluide et homogène."
msgstr "<strong>لنظرة أكثر تحديداً:</strong> امزجي باستخدام الفرشاة أو الإصبع للحصول على نتيجة أكثر سيولة وتجانساً."

#. module: oa_beauty_theme
msgid "<strong>Pour un trait naturel :</strong> tracez le contour de l'arc à la base, ثم املئي اتباعاً للشعيرات بحركة ناعمة وخفيفة."
msgstr "<strong>لخط طبيعي:</strong> ارسمي محيط القوس من القاعدة، ثم املئي اتباعاً لاتجاه الشعيرات بحركة ناعمة وخفيفة."

#. module: oa_beauty_theme
msgid "<strong>Profil Beaute :</strong> type de peau, preferences olfactives (optionnel)."
msgstr "<strong>الملف الجمالي:</strong> نوع البشرة، التفضيلات العطرية (اختياري)."

#. module: oa_beauty_theme
msgid "<strong>Regard intense :</strong><br/>Commencez par une base de teinte foncée en V sur les coins extérieurs. Déposez une teinte satiné moyenne sur le centre de la paupière mobile. Foncez la racine des cils au pinceau liner fin. Posez une touche de satiné clair sur le coin interne de l'œil."
msgstr "<strong>نظرة مكثفة:</strong><br/>ابدئي بقاعدة داكنة على شكل V في الزوايا الخارجية. ضعي درجة ساتانية متوسطة على مركز الجفن المتحرك. غمقي جذور الرموش بفرشاة رفيعة. ضعي لمسة ساتانية فاتحة على الزاوية الداخلية للعين."

#. module: oa_beauty_theme
msgid "<strong>Regard nude éveillé :</strong><br/>Balayez une teinte satiné clair sur toute la paupière. Appliquez une teinte mate transition dans le creux avec un pinceau biseauté. Estompez. Soulignez légèrement la racine des cils avec une teinte sombre."
msgstr "<strong>نظرة نيود يقظة:</strong><br/>مرري درجة ساتانية فاتحة على كامل الجفن. طبقي درجة مات متوسطة في التجويف بفرشاة مائلة. امزجي. خططي جذور الرموش قليلاً بدرجة داكنة."

#. module: oa_beauty_theme
msgid "<strong>Règle d'or O.A.I :</strong><br/>Toujours commencer par l'œil, avant le fond de teint — pour éviter la \"chute\" de fards de vous forcer à retravailler le teint. Et toujours finir au doigt."
msgstr "<strong>قاعدة O.A.I الذهبية:</strong><br/>ابدئي دائماً بالعين، قبل كريم الأساس — لتجنب \"تساقط\" ظلال العيون الذي يضطرك لإعادة العمل على البشرة. وأنهِي دائماً بالإصبع."

#. module: oa_beauty_theme
msgid "<strong>Sculpture &amp; Transition</strong> <em>(finitions mates)</em> : Quatre teintes moyennes pour définir le creux de l'œil et fondre les contrastes."
msgstr "<strong>نحت وانتقال</strong> <em>(تشطيبات مطفية)</em>: أربع درجات متوسطة لتحديد تجويف العين ودمج التباينات."

#. module: oa_beauty_theme
msgid "<strong>Soin pur :</strong><br/>Appliquez généreusement avant de dormir, pour un effet \"lip mask\" naturel. Le matin, vos lèvres sont regonflées, douces, régénérées."
msgstr "<strong>عناية مركزة:</strong><br/>طبقي بكثرة قبل النوم، لتأثير \"قناع شفاه\" طبيعي. صباحاً، تكون شفتاك ممتلئتين، ناعمتين، ومتجددتين."

#. module: oa_beauty_theme
msgid "<strong>Soir :</strong> appliquez une couche fine sur peau parfaitement propre, en évitant le contour des yeux. Laissez agir pendant 10 à 15 minutes, puis laissez le produit pénétrer en douceur."
msgstr "<strong>مساءً:</strong> ضعي طبقة رقيقة على بشرة نظيفة تماماً، مع تجنب محيط العين. اتركيه يعمل لمدة 10 إلى 15 دقيقة، ثم دعي المنتج يتغلغل بلطف."

#. module: oa_beauty_theme
msgid "<strong>Sur les zones sèches :</strong> coudes, genoux et talons : ajoutez une seconde couche puis massez légèrement pour plus de confort."
msgstr "<strong>على المناطق الجافة:</strong> المرفقان، الركبتان والكعبان: أضيفي طبقة ثانية ثم دلكي قليلاً لمزيد من الراحة."

#. module: oa_beauty_theme
msgid "<strong>Sur peau humide :</strong><br/>Après la douche, sans sécher complètement — appliquez l'huile sur peau encore légèrement humide. L'eau forme une émulsion naturelle qui améliore la pénétration et laisse la peau nacrée, jamais collante."
msgstr "<strong>على بشرة رطبة:</strong><br/>بعد الاستحمام، دون تجفيف كامل — ضعي الزيت على بشرة لا تزال رطبة قليلاً. يشكل الماء مستحلباً طبيعياً يحسن الاختراق ويترك البشرة ناعمة ولامعة، وليست لزجة أبداً."

#. module: oa_beauty_theme
msgid "<strong>Sur une peau propre, après votre soin habituel.</strong>"
msgstr "<strong>على بشرة نظيفة، بعد عنايةك المعتادة.</strong>"

#. module: oa_beauty_theme
msgid "<strong>Transactions :</strong> historique d'achats, adresses de livraison."
msgstr "<strong>المعاملات:</strong> سجل المشتريات، عناوين التوصيل."

#. module: oa_beauty_theme
msgid "<strong>Zone de confort :</strong><br/>Sur les coudes secs, genoux ou talons : appliquez une quantité généreuse et couvrez d'une chaussette chaude ou d'un gant de coton une heure."
msgstr "<strong>منطقة الراحة:</strong><br/>على المرفقين الجافين، الركبتين أو الكعبين: ضعي كمية سخية وغطي بجورب دافئ أو قفاز قطني لمدة ساعة."

#. module: oa_beauty_theme
msgid "<strong>À la fin du maquillage :</strong> utilisez un large pinceau et appliquez très légèrement sur le visage pour fixer et lisser l'ensemble."
msgstr "<strong>في نهاية المكياج:</strong> استخدمي فرشاة واسعة وطبقي بخفة شديدة على الوجه لتثبيت وتنعيم المظهر العام."

#. module: oa_beauty_theme
msgid "<strong>À utiliser dès le premier signe de fatigue :</strong> en massant doucement le contour pour une sensation rassérénante immédiate."
msgstr "<strong>لل使用 عند أول علامة تعب:</strong> بدلك المحيط بلطف لشعور مهدئ فوري."

#. module: oa_beauty_theme
msgid "<strong>À éviter sur peau irritée :</strong> laissez le produit agir uniquement sur les zones de texture ou de brillance, sans frotter fortement."
msgstr "<strong>تجنبي استخدامه على بشرة متهيجة:</strong> دعي المنتج يعمل فقط على مناطق الملمس أو اللمعان، دون فرك قوي."

