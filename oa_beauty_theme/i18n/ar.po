msgstr "<xpath expr=\"//body\" position=\"inside\"> <!-- شريط سفلي للجوال — HTML ثابت 100%. يستخدم عداد السلة الفئة \"my_cart_quantity\" التي يقوم Odoo website_sale JS بتحديثها تلقائياً عبر AJAX. لا توجد استدعاءات Python، لا يوجد sale_get_order()، لا يوجد hasattr. --> <nav id=\"oa_bottom_bar\" class=\"oa-bottom-bar d-flex d-md-none justify-content-around align-items-center\"> <!-- الرئيسية --> <a href=\"/\" class=\"oa-nav-item\"> <i class=\"fa fa-home\"></i> <span class=\"oa-nav-label\">الرئيسية</span>"

