<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="oa_beauty_search_overlay" inherit_id="website.layout" name="O&amp;A Beauty Intelligent Search">
        <xpath expr="//head" position="inside">
            <t t-if="request.params.get('search')">
                <meta name="robots" content="noindex,follow"/>
            </t>
        </xpath>

        <xpath expr="//body" position="inside">
            <div id="oa_search_overlay" class="oa-search-overlay" aria-hidden="true">
                <div class="oa-search-panel" role="dialog" aria-modal="true" aria-labelledby="oa_search_title">
                    <button type="button" class="oa-search-close" aria-label="Fermer la recherche">
                        <i class="fa fa-times"></i>
                    </button>
                    <div class="oa-search-head">
                        <span class="oa-search-kicker">Recherche O&amp;A Beauty</span>
                        <h2 id="oa_search_title">Trouvez votre rituel.</h2>
                    </div>
                    <form class="oa-search-form" action="/shop" method="get">
                        <i class="fa fa-search"></i>
                        <input id="oa_search_input" name="search" type="search" autocomplete="off" placeholder="Sérum peau sèche, parfum floral, vitamine C..." aria-label="Recherche produit"/>
                        <button type="submit">Rechercher</button>
                    </form>
                    <div class="oa-search-status" aria-live="polite"></div>
                    <div class="oa-search-results" id="oa_search_results"></div>
                    <div class="oa-search-empty" id="oa_search_empty" hidden="hidden">
                        <p class="oa-search-empty-title">Aucun résultat trouvé.</p>
                        <p class="oa-search-empty-copy">Vous ne savez pas encore ce que vous cherchez ?</p>
                        <div class="oa-search-empty-actions">
                            <a href="/beauty-advisor" class="oa-search-advisor">Essayez notre Beauty Advisor</a>
                            <a href="/shop" class="oa-search-secondary">Explorer la boutique</a>
                        </div>
                    </div>
                    <div class="oa-search-suggestions" id="oa_search_suggestions"></div>
                    <a id="oa_search_all" class="oa-search-all" href="/shop" hidden="hidden">Voir tous les résultats</a>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
