<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="view_homepage_lumiere" inherit_id="website.homepage" name="OA Beauty Homepage">

        <xpath expr="//div[@id='wrap']" position="replace">

            <t t-set="additional_title">O&amp;A Beauty — Clean Luxury Cosmetics</t>

            <t t-set="hp_products"
               t-value="request.env['product.template'].sudo().search([
                    ('is_published','=',True),
                    ('sale_ok','=',True)
               ], order='website_sequence asc, id asc', limit=3)"/>

            <div id="wrap" class="oe_structure oa-page">

                <!-- HERO -->
                <section class="oa-hero" id="home">
                    <div class="oa-hero-content text-center">
                        <h1 class="oa-hero-h1">Trois Regards, <span class="oa-grad">Une Beauté</span></h1>
                        <p class="oa-hero-sub">Formules transparentes. Beauté sans compromis.</p>

                        <a href="/shop" class="oa-btn-primary mt-4 d-inline-block">Découvrir la Collection</a>
                    </div>
                </section>

                <!-- FOUNDERS -->
                <section class="oa-about py-5" style="background-color: var(--oa-ivory);">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-6 mb-4 mb-lg-0 text-center text-lg-start">
                                <h2 class="oa-heading">Notre Histoire</h2>
                                <p class="lead" style="color: var(--oa-prune); font-weight: 500;">Trio &amp; Élégance</p>
                                <p class="text-muted mt-3">L'histoire de O.A.I Beauty est celle d'une rencontre entre trois exigences. Olesea, notre âme créative, imagine la sensorialité parfaite. Amalia, experte produit, transforme cette vision en formules pures et fiables. Irina porte notre voix pour partager cette beauté authentique avec vous.</p>
                                <div class="d-flex mt-4 justify-content-center justify-content-lg-start gap-4">
                                    <div class="text-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 60px; height: 60px; background-color: #e8e0ff; color: var(--oa-prune); font-weight: bold; font-size: 1.2rem;">OL</div>
                                        <h6 class="mb-0">Olesea</h6>
                                        <small class="text-muted">Directrice créative</small>
                                    </div>
                                    <div class="text-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 60px; height: 60px; background-color: #f3e8fa; color: var(--oa-prune); font-weight: bold; font-size: 1.2rem;">AM</div>
                                        <h6 class="mb-0">Amalia</h6>
                                        <small class="text-muted">Directrice produit</small>
                                    </div>
                                    <div class="text-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 60px; height: 60px; background-color: #fae8fc; color: var(--oa-prune); font-weight: bold; font-size: 1.2rem;">IR</div>
                                        <h6 class="mb-0">Irina</h6>
                                        <small class="text-muted">Directrice marketing</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 text-center">
                                <div class="p-5 rounded-4 shadow-sm" style="background-color: var(--oa-lilac);">
                                    <h3 class="mb-0" style="color: var(--oa-prune); font-family: var(--oa-font-display); font-style: italic; font-size: 2.5rem;">"La beauté révélée, jamais déguisée."</h3>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- PRODUCTS -->
                <section class="oa-shop-preview">
                    <h2 class="oa-heading">Notre Collection</h2>

                    <div t-if="hp_products" class="oa-products-preview">
                        <t t-foreach="hp_products" t-as="hp_prod">
                            <a t-att-href="hp_prod.website_url" class="oa-product-card">

                                <img t-att-src="'/web/image/product.template/%s/image_512' % hp_prod.id"
                                     t-att-alt="hp_prod.name"/>

                                <h3 t-esc="hp_prod.name"/>

                            </a>
                        </t>
                    </div>

                </section>

            </div>

        </xpath>

    </template>

</odoo>