<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="view_homepage_lumiere" name="OA Beauty Homepage">
        <t t-call="website.layout">

            <t t-set="additional_title">O&amp;A Atelier - Clean Luxury Cosmetics</t>

            <t t-set="featured_products" t-value="[
                    request.env.ref('oa_beauty_theme.product_serum_signature').sudo(),
                    request.env.ref('oa_beauty_theme.product_fond_de_teint_lumiere').sudo(),
                    request.env.ref('oa_beauty_theme.product_baume_levres').sudo(),
                    request.env.ref('oa_beauty_theme.product_palette_regard').sudo()
            ]"/>

            <div id="wrap" class="oa-page overflow-hidden">

                <div class="oe_structure" id="oa_home_before_hero"/>

                <div class="oe_structure" id="oa_home_hero">
                    <section class="position-relative d-flex align-items-center" style="min-height: 85vh; background: linear-gradient(145deg, var(--oa-bg-alt) 0%, var(--oa-ivory) 100%);">
                        <div class="position-absolute top-0 start-0 w-100 h-100 overflow-hidden" style="z-index: 1; pointer-events: none;">
                            <div class="position-absolute oa-float-item" style="top: -10%; right: -5%; width: 40vw; height: 40vw; background: radial-gradient(circle, rgba(214,204,220,0.4) 0%, transparent 70%); border-radius: 50%;"></div>
                            <div class="position-absolute oa-float-item-delayed" style="bottom: -15%; left: -10%; width: 50vw; height: 50vw; background: radial-gradient(circle, rgba(235,224,213,0.6) 0%, transparent 70%); border-radius: 50%;"></div>
                        </div>
                        <div class="container position-relative py-5">
                            <div class="row align-items-center">
                                <div class="col-lg-6 mb-5 mb-lg-0 text-center text-lg-start">
                                    <span class="d-block mb-3 text-uppercase fw-bold" style="letter-spacing: 0.2em; color: var(--oa-mauve); font-size: 0.85rem;">La Beaute Editoriale</span>
                                    <h1 class="oa-editorial-h1 mb-4">Trois Regards,<br/><span class="oa-editorial-accent">Une Beaute</span></h1>
                                    <p class="lead mb-5 mx-auto mx-lg-0" style="max-width: 450px; color: var(--oa-prune); font-weight: 300; font-size: 1.15rem; line-height: 1.6;">Formules transparentes, textures sensorielles, elegance sans compromis. Celebrez votre essence naturelle.</p>
                                    <a href="/shop" class="oa-btn-primary d-inline-flex align-items-center" style="padding: 18px 40px; font-size: 0.9rem;">
                                        Decouvrir la Collection <i class="fa fa-long-arrow-right ms-3"></i>
                                    </a>
                                </div>
                                <div class="col-lg-6 position-relative">
                                    <div class="row g-3 align-items-center">
                                        <div class="col-6">
                                            <div class="oa-organic-shape-1 oa-img-zoom shadow-sm" style="height: 400px;">
                                                <img src="/oa_beauty_theme/static/src/img/oa_serum_glow.png" class="w-100 h-100 object-fit-cover" alt="Serum Glow" loading="lazy"/>
                                            </div>
                                        </div>
                                        <div class="col-6 position-relative">
                                            <div class="oa-float-wrapper mb-3" style="margin-left: -30px;">
                                                <div class="oa-organic-shape-2 oa-img-zoom shadow-lg" style="height: 250px; background-color: white;">
                                                    <img src="/oa_beauty_theme/static/src/img/oa_foundation.png" class="w-100 h-100 object-fit-cover" alt="Fond de Teint Lumineux" loading="lazy"/>
                                                </div>
                                            </div>
                                            <div class="oa-pill-shape oa-img-zoom shadow-sm" style="height: 180px;">
                                                <img src="/oa_beauty_theme/static/src/img/oa_texture.png" class="w-100 h-100 object-fit-cover" alt="Texture" loading="lazy"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="oe_structure" id="oa_home_marquee">
                    <div class="oa-marquee-section">
                        <div class="oa-marquee-track">
                            <div class="oa-marquee-item"><div class="oa-marquee-dot"></div>Clean Beauty</div>
                            <div class="oa-marquee-item"><div class="oa-marquee-dot"></div>100% Vegan</div>
                            <div class="oa-marquee-item"><div class="oa-marquee-dot"></div>Cruelty-Free</div>
                            <div class="oa-marquee-item"><div class="oa-marquee-dot"></div>Luxury Skincare</div>
                            <div class="oa-marquee-item"><div class="oa-marquee-dot"></div>Sensory Textures</div>
                            <div class="oa-marquee-item"><div class="oa-marquee-dot"></div>Clean Beauty</div>
                            <div class="oa-marquee-item"><div class="oa-marquee-dot"></div>100% Vegan</div>
                            <div class="oa-marquee-item"><div class="oa-marquee-dot"></div>Cruelty-Free</div>
                            <div class="oa-marquee-item"><div class="oa-marquee-dot"></div>Luxury Skincare</div>
                            <div class="oa-marquee-item"><div class="oa-marquee-dot"></div>Sensory Textures</div>
                        </div>
                    </div>
                </div>

                <div class="oe_structure" id="oa_home_story">
                    <section class="py-5 oa-reveal" style="background-color: white;">
                        <div class="container py-5">
                            <div class="row align-items-center gx-5">
                                <div class="col-lg-5 mb-5 mb-lg-0 position-relative">
                                    <div class="oa-arch-shape oa-img-zoom overflow-hidden shadow-sm" style="height: 600px; background-color: var(--oa-bg-alt);">
                                        <img src="/oa_beauty_theme/static/src/img/oa_founders_portrait.png" class="w-100 h-100 object-fit-cover" alt="Portrait Editorial" loading="lazy"/>
                                    </div>
                                    <div class="position-absolute oa-float-item bg-white p-4 shadow-lg text-center" style="bottom: 50px; right: -30px; border-radius: 50%; width: 140px; height: 140px; display: flex; flex-direction: column; justify-content: center;">
                                        <span class="d-block fw-bold fs-4" style="color: var(--oa-prune);">100%</span>
                                        <span class="text-uppercase" style="font-size: 0.6rem; letter-spacing: 0.1em; color: var(--oa-mauve);">Clean<br/>Beauty</span>
                                    </div>
                                </div>
                                <div class="col-lg-6 offset-lg-1">
                                    <h2 class="oa-editorial-h2 mb-4">La beaute revelee,<br/><span class="oa-editorial-accent">jamais deguisee.</span></h2>
                                    <p class="mb-4" style="font-size: 1.1rem; line-height: 1.8; color: #555;">L'histoire de O&amp;A Atelier est nee d'une fusion entre creativite, science et narration. <strong>Olesea</strong> sculpte la sensorialite de chaque produit, <strong>Amalia</strong> exige l'excellence des formules actives, et <strong>Irina</strong> tisse l'esthetique visuelle qui donne vie a la marque.</p>
                                    <p class="mb-5" style="font-size: 1.1rem; line-height: 1.8; color: #555;">Nous creons des produits qui celebrent vos imperfections autant que vos atouts, avec une formulation transparente et une touche de luxe.</p>
                                    <a href="/about" class="text-uppercase fw-bold text-decoration-none" style="letter-spacing: 0.15em; color: var(--oa-prune); border-bottom: 1px solid var(--oa-prune); padding-bottom: 5px;">Notre Manifeste</a>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="oe_structure" id="oa_home_collections">
                    <section class="py-5 oa-reveal" style="background-color: var(--oa-ivory);">
                        <div class="container py-5">
                            <div class="text-center mb-5">
                                <span class="d-block mb-3 text-uppercase fw-bold" style="letter-spacing: 0.2em; color: var(--oa-mauve); font-size: 0.85rem;">Collections</span>
                                <h2 class="oa-editorial-h2" style="font-size: clamp(1.8rem, 4vw, 2.8rem);">Explorez nos <span class="oa-editorial-accent">Univers</span></h2>
                                <p class="text-muted mt-2">Des rituels sensoriels penses pour sublimer chaque instant de votre journee.</p>
                            </div>
                            <div class="row g-4 justify-content-center oa-reveal-stagger">
                                <div class="col-sm-6 col-lg-3 oa-reveal-child">
                                    <a t-attf-href="/shop/category/{{ slug(request.env.ref('oa_beauty_theme.public_category_skincare')) }}" class="oa-category-card">
                                        <img src="/oa_beauty_theme/static/src/img/oa_serum_glow.png" class="oa-category-img" alt="Soin de la peau" loading="lazy"/>
                                        <div class="oa-category-info"><div class="oa-category-name">Le Soin</div><div class="oa-category-count">12 Produits</div></div>
                                    </a>
                                </div>
                                <div class="col-sm-6 col-lg-3 oa-reveal-child">
                                    <a t-attf-href="/shop/category/{{ slug(request.env.ref('oa_beauty_theme.public_category_makeup')) }}" class="oa-category-card">
                                        <img src="/oa_beauty_theme/static/src/img/oa_foundation.png" class="oa-category-img" alt="Maquillage" loading="lazy"/>
                                        <div class="oa-category-info"><div class="oa-category-name">Le Maquillage</div><div class="oa-category-count">8 Produits</div></div>
                                    </a>
                                </div>
                                <div class="col-sm-6 col-lg-3 oa-reveal-child">
                                    <a t-attf-href="/shop/category/{{ slug(request.env.ref('oa_beauty_theme.public_category_fragrances')) }}" class="oa-category-card">
                                        <img src="/oa_beauty_theme/static/src/img/oa_texture.png" class="oa-category-img" alt="Parfums" loading="lazy"/>
                                        <div class="oa-category-info"><div class="oa-category-name">Les Parfums</div><div class="oa-category-count">6 Creations</div></div>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="oe_structure" id="oa_home_ingredients">
                    <section class="py-5 oa-reveal" style="background-color: white;">
                        <div class="container py-5 text-center">
                            <span class="d-block mb-3 text-uppercase fw-bold" style="letter-spacing: 0.2em; color: var(--oa-mauve); font-size: 0.85rem;">Science &amp; Nature</span>
                            <h2 class="oa-editorial-h2 mb-5">Ingredients Actifs de <span class="oa-editorial-accent">Haute Performance</span></h2>
                            <div class="row justify-content-center mt-5">
                                <div class="col-md-4 mb-4 mb-md-0 d-flex flex-column align-items-center">
                                    <div class="oa-placeholder-ingredient mb-4 oa-float-item"><span style="color: var(--oa-prune); font-style: italic; font-family: var(--oa-font-display); font-size: 1.5rem;">Squalane</span></div>
                                    <h4 class="fs-5 fw-bold" style="color: var(--oa-prune);">Hydratation Bio-compatible</h4>
                                    <p class="text-muted small px-3">Imite les huiles naturelles de la peau pour retenir l'hydratation sans obstruer les pores.</p>
                                </div>
                                <div class="col-md-4 mb-4 mb-md-0 d-flex flex-column align-items-center">
                                    <div class="oa-placeholder-ingredient mb-4 oa-float-item-delayed"><span style="color: var(--oa-prune); font-style: italic; font-family: var(--oa-font-display); font-size: 1.5rem;">Acide Hyaluronique</span></div>
                                    <h4 class="fs-5 fw-bold" style="color: var(--oa-prune);">Repulpe &amp; Lisse</h4>
                                    <p class="text-muted small px-3">Attire l'eau a la surface de la peau pour un aspect radieux, rebondi et rajeuni.</p>
                                </div>
                                <div class="col-md-4 d-flex flex-column align-items-center">
                                    <div class="oa-placeholder-ingredient mb-4 oa-float-item"><span style="color: var(--oa-prune); font-style: italic; font-family: var(--oa-font-display); font-size: 1.5rem;">Vitamine C</span></div>
                                    <h4 class="fs-5 fw-bold" style="color: var(--oa-prune);">Eclat Antioxydant</h4>
                                    <p class="text-muted small px-3">Illumine le teint, estompe les taches sombres et defend la peau contre les agresseurs environnementaux.</p>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="oe_structure" id="oa_home_social_proof">
                    <section class="py-5 oa-reveal" style="background-color: var(--oa-prune); color: white;">
                        <div class="container py-4 text-center">
                            <div class="row align-items-center justify-content-center">
                                <div class="col-lg-10">
                                    <span class="d-block mb-3 text-uppercase fw-bold" style="letter-spacing: 0.2em; color: var(--oa-mauve); font-size: 0.85rem;">La Communaute O&amp;A Atelier</span>
                                    <h2 class="oa-editorial-h2 mb-4 text-white">Rejoignez plus de <span class="oa-editorial-accent oa-counter-10k" style="color: var(--oa-lilac);">10000</span> clientes satisfaites</h2>
                                    <div class="mb-5">
                                        <i class="fa fa-star text-warning fs-4 mx-1"></i><i class="fa fa-star text-warning fs-4 mx-1"></i>
                                        <i class="fa fa-star text-warning fs-4 mx-1"></i><i class="fa fa-star text-warning fs-4 mx-1"></i>
                                        <i class="fa fa-star text-warning fs-4 mx-1"></i>
                                        <span class="ms-3 fs-5 fw-bold">4.8/5</span>
                                    </div>
                                    <div class="row g-4 text-start justify-content-center oa-reveal-stagger">
                                        <div class="col-md-4 oa-reveal-child">
                                            <div class="oa-testimonial-card">
                                                <p class="oa-testimonial-text">Les textures sont incroyables. Mon teint n'a jamais ete aussi lumineux. Le Serum Glow est devenu mon indispensable.</p>
                                                <div class="oa-testimonial-author">
                                                    <div class="oa-testimonial-avatar">SM</div>
                                                    <div><div class="oa-testimonial-name">Sophie M.</div><div class="oa-testimonial-badge">Acheteuse verifiee</div></div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 oa-reveal-child">
                                            <div class="oa-testimonial-card">
                                                <p class="oa-testimonial-text">Enfin du maquillage qui prend soin de ma peau sensible. La couvrance est parfaite et le rendu tellement naturel!</p>
                                                <div class="oa-testimonial-author">
                                                    <div class="oa-testimonial-avatar">CT</div>
                                                    <div><div class="oa-testimonial-name">Claire T.</div><div class="oa-testimonial-badge">Acheteuse verifiee</div></div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 d-none d-md-block oa-reveal-child">
                                            <div class="oa-testimonial-card">
                                                <p class="oa-testimonial-text">Une vraie experience de luxe, de l'emballage jusqu'aux resultats visibles sur ma peau. Je suis conquise.</p>
                                                <div class="oa-testimonial-author">
                                                    <div class="oa-testimonial-avatar">AD</div>
                                                    <div><div class="oa-testimonial-name">Amandine D.</div><div class="oa-testimonial-badge">Acheteuse verifiee</div></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>

                <t t-set="frag_products" t-value="request.env['product.template'].sudo().search([
                    ('is_published','=',True),
                    ('oa_is_coming_soon','=',True)
                ], order='website_sequence asc', limit=6)"/>

                <div class="oe_structure" id="oa_home_fragrances">
                    <section class="oa-fragrance-section py-5 oa-reveal" t-if="frag_products">
                        <div class="oa-glow-orb" style="width:500px;height:500px;top:-150px;left:-100px;background:radial-gradient(circle,rgba(158,123,157,0.15) 0%,transparent 70%);"></div>
                        <div class="container position-relative py-5">
                            <div class="text-center mb-5">
                                <span class="d-block mb-3 text-uppercase fw-bold" style="letter-spacing:0.25em;color:var(--oa-lilac);font-size:0.8rem;">Nouvelle Collection</span>
                                <h2 class="oa-editorial-h2 text-white mb-3" style="font-size:clamp(2rem,5vw,3.5rem);">L'Univers des <span style="color:var(--oa-lilac);font-style:italic;">Parfums</span></h2>
                                <p style="color:rgba(255,255,255,0.65);max-width:500px;margin:0 auto;font-size:1.05rem;line-height:1.7;">Six creations olfactives d'exception, nees de l'alliance entre la science des fleurs et l'art de la seduction.</p>
                            </div>
                            <div class="row g-4 justify-content-center">
                                <t t-foreach="frag_products" t-as="fp">
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <a t-att-href="fp.website_url" class="oa-fragrance-card d-block text-decoration-none text-white h-100">
                                            <div class="d-flex flex-column h-100 justify-content-between">
                                                <div>
                                                    <span t-field="fp.image_1920" t-options="{'widget':'image','class':'w-100','style':'max-height:180px;object-fit:contain;filter:drop-shadow(0 8px 25px rgba(0,0,0,0.5));','loading':'lazy'}"/>
                                                    <div class="oa-fragrance-card-type mt-3" t-esc="fp.oa_type or 'Eau de Parfum'"/>
                                                    <div class="oa-fragrance-card-name" t-esc="fp.name"/>
                                                </div>
                                                <div class="mt-auto">
                                                    <div class="oa-fragrance-card-price" t-esc="fp.list_price" t-options="{'widget':'monetary','display_currency':website.currency_id}"/>
                                                    <div class="mt-2"><span style="font-size:0.65rem;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.4);">Collection a venir</span></div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </t>
                            </div>
                            <div class="text-center mt-5">
                                <a t-attf-href="/shop/category/{{ slug(request.env.ref('oa_beauty_theme.public_category_fragrances')) }}" class="btn btn-outline-light rounded-0 px-5 py-3 text-uppercase" style="letter-spacing:0.15em;font-size:0.85rem;">Explorer la Collection</a>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="oe_structure" id="oa_home_trust">
                    <section class="py-5 oa-reveal" style="background:var(--oa-prune);">
                        <div class="container py-4">
                            <div class="text-center mb-5">
                                <span class="d-block mb-2 text-uppercase fw-bold" style="letter-spacing:0.2em;color:var(--oa-lilac);font-size:0.8rem;">Notre Engagement</span>
                                <h2 class="oa-editorial-h2 text-white" style="font-size:clamp(1.5rem,3vw,2.5rem);">La Confiance,<br/><span style="color:var(--oa-lilac);font-style:italic;">au coeur de tout.</span></h2>
                            </div>
                            <div class="row g-0 text-center">
                                <div class="col-6 col-md-4 col-lg-2 d-flex align-items-stretch"><div class="oa-trust-item d-flex flex-column justify-content-center align-items-center w-100"><span class="oa-trust-icon">&#x2728;</span><div class="oa-trust-value">10K+</div><div class="oa-trust-label">Clientes Satisfaites</div></div></div>
                                <div class="col-6 col-md-4 col-lg-2 d-flex align-items-stretch"><div class="oa-trust-item d-flex flex-column justify-content-center align-items-center w-100"><span class="oa-trust-icon">&#x25CE;</span><div class="oa-trust-value">98%</div><div class="oa-trust-label">Satisfaction</div></div></div>
                                <div class="col-6 col-md-4 col-lg-2 d-flex align-items-stretch"><div class="oa-trust-item d-flex flex-column justify-content-center align-items-center w-100"><i class="fa fa-paw oa-trust-icon"></i><div class="oa-trust-label" style="font-size:0.85rem;margin-top:8px;">Cruelty-Free</div></div></div>
                                <div class="col-6 col-md-4 col-lg-2 d-flex align-items-stretch"><div class="oa-trust-item d-flex flex-column justify-content-center align-items-center w-100"><i class="fa fa-leaf oa-trust-icon"></i><div class="oa-trust-label" style="font-size:0.85rem;margin-top:8px;">100% Vegan</div></div></div>
                                <div class="col-6 col-md-4 col-lg-2 d-flex align-items-stretch"><div class="oa-trust-item d-flex flex-column justify-content-center align-items-center w-100"><i class="fa fa-lock oa-trust-icon"></i><div class="oa-trust-label" style="font-size:0.85rem;margin-top:8px;">Paiement Securise</div></div></div>
                                <div class="col-6 col-md-4 col-lg-2 d-flex align-items-stretch"><div class="oa-trust-item d-flex flex-column justify-content-center align-items-center w-100"><i class="fa fa-truck oa-trust-icon"></i><div class="oa-trust-label" style="font-size:0.85rem;margin-top:8px;">Livraison Rapide</div></div></div>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="oe_structure" id="oa_home_featured_products">
                    <section class="py-5 position-relative oa-reveal" style="background-color: var(--oa-bg-alt);">
                        <div class="position-absolute top-0 end-0 h-100" style="width: 30%; background-color: var(--oa-ivory); z-index: 0;"></div>
                        <div class="container position-relative py-5">
                            <div class="d-flex justify-content-between align-items-end mb-5">
                                <div>
                                    <h2 class="oa-editorial-h2">Get the <span class="oa-editorial-accent">Look</span></h2>
                                    <p class="text-muted" style="letter-spacing: 0.05em;">L'essentiel pour un fini naturel et lumineux.</p>
                                </div>
                                <a href="/shop" class="text-uppercase fw-bold text-decoration-none d-none d-md-block" style="letter-spacing: 0.15em; color: var(--oa-prune); border-bottom: 1px solid var(--oa-prune);">Voir tout</a>
                            </div>
                            <div class="row g-4">
                                <t t-foreach="featured_products" t-as="featured_product">
                                    <div class="col-md-6 col-lg-3">
                                        <div class="oa-product-card">
                                            <a t-att-href="featured_product.website_url" class="d-block text-decoration-none">
                                                <div class="oa-product-img position-relative overflow-hidden mb-3" style="aspect-ratio: 3/4; background-color: white;">
                                                    <span t-field="featured_product.image_1920" t-options="{'widget':'image','class':'w-100 h-100 object-fit-cover','loading':'lazy'}"/>
                                                    <button class="oa-quick-add">Quick View</button>
                                                </div>
                                            </a>
                                            <div class="oa-product-info text-start">
                                                <div class="oa-product-stars">
                                                    <i class="fa fa-star filled"></i><i class="fa fa-star filled"></i><i class="fa fa-star filled"></i><i class="fa fa-star filled"></i><i class="fa fa-star filled"></i>
                                                </div>
                                                <span class="text-uppercase mb-1 d-block" style="font-size: 0.65rem; letter-spacing: 0.15em; color: var(--oa-mauve);" t-esc="featured_product.public_categ_ids[:1].name if featured_product.public_categ_ids else 'O&amp;A Atelier'"/>
                                                <a t-att-href="featured_product.website_url" class="text-decoration-none">
                                                    <h3 class="mb-2 fs-5 text-dark" style="font-family: var(--oa-font-display);" t-esc="featured_product.name"/>
                                                </a>
                                                <div class="text-muted" style="font-size: 0.9rem;" t-esc="featured_product.list_price" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                            <div class="text-center mt-4 d-block d-md-none">
                                <a href="/shop" class="text-uppercase fw-bold text-decoration-none" style="letter-spacing: 0.15em; color: var(--oa-prune); border-bottom: 1px solid var(--oa-prune);">Voir tout</a>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="oe_structure oe_empty" id="oa_home_after_content"/>

                <!-- SCROLL-REVEAL JAVASCRIPT -->
                <script>
                    document.addEventListener("DOMContentLoaded", function() {
                        const revealElements = document.querySelectorAll('.oa-reveal, .oa-reveal-stagger');
                        
                        const checkReveal = () => {
                            const triggerBottom = window.innerHeight * 0.85;
                            revealElements.forEach(el => {
                                const rect = el.getBoundingClientRect();
                                if (rect.top &lt; triggerBottom) {
                                    el.classList.add('oa-revealed');
                                }
                            });
                        };
                        
                        window.addEventListener('scroll', checkReveal);
                        // Trigger once on load
                        setTimeout(checkReveal, 200);
                    });
                </script>

            </div>
        </t>
    </template>

    <record id="website_page_homepage" model="website.page">
