        <field name="view_id" ref="oa_beauty_theme.view_homepage_lumiere"/>
        <field name="is_published" eval="True"/>
        <field name="is_homepage" eval="True"/>
        <field name="website_id" ref="oa_beauty_theme.oa_beauty_website"/>
    </record>

