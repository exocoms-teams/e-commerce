<?xml version="1.0" encoding="utf-8"?>
<odoo>



    <!--
        Style the address formatting to look more premium
    -->
    <template id="oa_beauty_checkout_address" inherit_id="website_sale.checkout_layout" name="O&amp;A Beauty — Checkout Layout">
        <xpath expr="(//div)[1]" position="before">
            <div class="container mt-4 mb-2 text-center" style="font-family: var(--oa-font-display); color: var(--oa-prune);">
                <h1 class="h3 fw-light mb-1">Expédition &amp; Paiement</h1>
                <p class="text-muted small text-uppercase" style="letter-spacing: 0.1em;">Finalisez votre commande en toute sécurité</p>
                
                <div class="mt-3 p-3 rounded" style="background-color: var(--oa-ivory); border: 1px solid rgba(0,0,0,0.05); display: inline-block;">
                    <div class="d-flex justify-content-center gap-3 text-muted align-items-center">
                        <span class="small fw-bold text-uppercase me-2" style="color: var(--oa-prune);">Paiement 100% Sécurisé</span>
                        <i class="fa-brands fa-cc-stripe fs-3" title="Stripe"></i>
                        <i class="fa-brands fa-cc-visa fs-3" title="Visa"></i>
                        <i class="fa-brands fa-cc-mastercard fs-3" title="Mastercard"></i>
                        <i class="fa-brands fa-cc-amex fs-3" title="American Express"></i>
                        <i class="fa-brands fa-cc-apple-pay fs-3" title="Apple Pay"></i>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
