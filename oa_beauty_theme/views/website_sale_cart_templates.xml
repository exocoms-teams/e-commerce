<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Epic 2: Premium Cart Experience
        Inherit the cart page to inject luxury branding.
    -->
    <template id="oa_beauty_cart" inherit_id="website_sale.cart" name="O&amp;A Beauty — Cart">
        <!-- Add a subtle header message above the cart -->
        <xpath expr="(//div)[1]" position="before">
            <div class="container mt-4 mb-2 text-center" style="font-family: var(--oa-font-display); color: var(--oa-prune);">
                <h1 class="h3 fw-light mb-1">Votre Rituel Beauté</h1>
                <p class="text-muted small text-uppercase" style="letter-spacing: 0.1em;">Finalisez votre sélection</p>
            </div>
        </xpath>
    </template>

</odoo>
