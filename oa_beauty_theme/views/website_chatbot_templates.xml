<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Floating Chatbot Widget injected into every page -->
    <template id="oa_beauty_chatbot_widget" inherit_id="website.layout" name="O&amp;A Atelier Chatbot">
        <xpath expr="//body" position="inside">

            <!-- Floating Toggle Button -->
            <button id="oa_chat_toggle" class="oa-chat-toggle" aria-label="Ouvrir l'assistant beauté">
                <i class="fa fa-comments oa-chat-icon-open"></i>
                <i class="fa fa-times oa-chat-icon-close" style="display:none;"></i>
            </button>

            <!-- Chat Window -->
            <div id="oa_chat_window" class="oa-chat-window" style="display:none;" aria-live="polite">

                <!-- Header -->
                <div class="oa-chat-header">
                    <div class="oa-chat-avatar">
                        <i class="fa fa-magic"></i>
                    </div>
                    <div>
                        <div class="oa-chat-header-name">Assistant O&amp;A</div>
                        <div class="oa-chat-header-status">
                            <span class="oa-chat-status-dot"></span> En ligne
                        </div>
                    </div>
                    <button class="oa-chat-close ms-auto" id="oa_chat_close" aria-label="Fermer le chat">
                        <i class="fa fa-times"></i>
                    </button>
                </div>

                <!-- Message Area -->
                <div class="oa-chat-messages" id="oa_chat_messages">
                    <div class="oa-chat-msg oa-chat-msg--bot">
                        <p>Bonjour ! 👋 Je suis votre assistant O&amp;A Atelier. Posez-moi vos questions sur nos produits, vos routines de soin, la livraison ou les retours !</p>
                    </div>
                    <!-- Quick Reply Chips -->
                    <div class="oa-chat-quick-replies" id="oa_chat_quick_replies">
                        <button class="oa-chat-chip" data-msg="Quels sont vos meilleurs produits pour peau sèche ?">Peau sèche</button>
                        <button class="oa-chat-chip" data-msg="Quelle est votre politique de retour ?">Retours</button>
                        <button class="oa-chat-chip" data-msg="Comment fonctionne la livraison ?">Livraison</button>
                        <button class="oa-chat-chip" data-msg="Parlez-moi du sérum à la vitamine C">Vitamine C</button>
                    </div>
                </div>

                <!-- Typing indicator (hidden by default) -->
                <div class="oa-chat-typing" id="oa_chat_typing" style="display:none;">
                    <span></span><span></span><span></span>
                </div>

                <!-- Input Area -->
                <div class="oa-chat-input-wrap">
                    <input type="text"
                           id="oa_chat_input"
                           class="oa-chat-input"
                           placeholder="Posez votre question sur O&amp;A Atelier…"
                           maxlength="300"
                           autocomplete="off"/>
                    <button id="oa_chat_send" class="oa-chat-send" aria-label="Envoyer le message">
                        <i class="fa fa-paper-plane"></i>
                    </button>
                </div>

            </div>

        </xpath>
    </template>

</odoo>
