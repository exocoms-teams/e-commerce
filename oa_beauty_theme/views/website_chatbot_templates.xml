<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Floating Chatbot Widget injected into every page -->
    <template id="oa_beauty_chatbot_widget" inherit_id="website.layout" name="O&amp;A Beauty Chatbot">
        <xpath expr="//body" position="inside">

            <!-- Floating Toggle Button -->
            <button id="oa_chat_toggle" class="oa-chat-toggle" aria-label="Open Beauty Assistant">
                <i class="fa fa-comments oa-chat-icon-open"></i>
                <i class="fa fa-times oa-chat-icon-close" style="display:none;"></i>
            </button>

            <!-- Chat Window -->
            <div id="oa_chat_window" class="oa-chat-window" style="display:none;" aria-live="polite">

                <!-- Header -->
                <div class="oa-chat-header">
                    <div class="oa-chat-avatar">
                        <i class="fa fa-magic"></i>
                    </div>
                    <div>
                        <div class="oa-chat-header-name">O&amp;A Assistant</div>
                        <div class="oa-chat-header-status">
                            <span class="oa-chat-status-dot"></span> Online
                        </div>
                    </div>
                    <button class="oa-chat-close ms-auto" id="oa_chat_close" aria-label="Close chat">
                        <i class="fa fa-times"></i>
                    </button>
                </div>

                <!-- Message Area -->
                <div class="oa-chat-messages" id="oa_chat_messages">
                    <div class="oa-chat-msg oa-chat-msg--bot">
                        <p>Bonjour ! 👋 I am your O&amp;A Beauty Assistant. Ask me anything about our products, skincare tips, shipping or returns!</p>
                    </div>
                    <!-- Quick Reply Chips -->
                    <div class="oa-chat-quick-replies" id="oa_chat_quick_replies">
                        <button class="oa-chat-chip" data-msg="What are your best products for dry skin?">Dry skin tips</button>
                        <button class="oa-chat-chip" data-msg="What is your return policy?">Returns</button>
                        <button class="oa-chat-chip" data-msg="How does shipping work?">Shipping</button>
                        <button class="oa-chat-chip" data-msg="Tell me about Vitamin C serum">Vitamin C</button>
                    </div>
                </div>

                <!-- Typing indicator (hidden by default) -->
                <div class="oa-chat-typing" id="oa_chat_typing" style="display:none;">
                    <span></span><span></span><span></span>
                </div>

                <!-- Input Area -->
                <div class="oa-chat-input-wrap">
                    <input type="text"
                           id="oa_chat_input"
                           class="oa-chat-input"
                           placeholder="Ask anything about O&amp;A Beauty…"
                           maxlength="300"
                           autocomplete="off"/>
                    <button id="oa_chat_send" class="oa-chat-send" aria-label="Send message">
                        <i class="fa fa-paper-plane"></i>
                    </button>
                </div>

            </div>

        </xpath>
    </template>

</odoo>
