<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Add "Beauty Profile" to the Portal Menu -->
    <template id="oa_portal_my_home_menu_beauty" name="Portal layout : beauty profile menu" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'beauty_profile'" class="breadcrumb-item active">
                Mon Profil Beauté
            </li>
        </xpath>
    </template>

    <template id="oa_portal_my_home_beauty" name="Portal My Home : beauty profile entry" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Profil Beauté</t>
                <t t-set="url" t-value="'/my/beauty_profile'"/>
                <t t-set="placeholder_count" t-value="'1'"/>
            </t>
        </xpath>
    </template>

    <!-- 2. The Beauty Profile Form Page -->
    <template id="oa_beauty_profile_page" name="My Beauty Profile">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Mon Profil Beauté</t>
            
            <div id="wrap">
                <div class="container py-5">
                    <div class="row align-items-center mb-4">
                        <div class="col-12 col-md-8">
                            <h2 class="oa-editorial-h2 mb-2">Votre Profil Beauté</h2>
                            <p class="text-muted">Personnalisez votre expérience O&amp;A Beauty pour des recommandations sur mesure.</p>
                        </div>
                    </div>
                    
                    <form action="/my/beauty_profile/submit" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        
                        <div class="row bg-white p-4 shadow-sm border rounded">
                            
                            <div class="col-12 col-md-6 mb-4">
                                <label class="form-label fw-bold" style="color: var(--oa-prune);">Type de Peau</label>
                                <select name="skin_type" class="form-select">
                                    <option value="" t-att-selected="not partner.oa_skin_type">Sélectionner</option>
                                    <option value="normal" t-att-selected="partner.oa_skin_type == 'normal'">Normale</option>
                                    <option value="dry" t-att-selected="partner.oa_skin_type == 'dry'">Sèche</option>
                                    <option value="oily" t-att-selected="partner.oa_skin_type == 'oily'">Grasse</option>
                                    <option value="combination" t-att-selected="partner.oa_skin_type == 'combination'">Mixte</option>
                                    <option value="sensitive" t-att-selected="partner.oa_skin_type == 'sensitive'">Sensible</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-6 mb-4">
                                <label class="form-label fw-bold" style="color: var(--oa-prune);">Préoccupation Principale</label>
                                <select name="skin_concern" class="form-select">
                                    <option value="" t-att-selected="not partner.oa_skin_concern">Sélectionner</option>
                                    <option value="aging" t-att-selected="partner.oa_skin_concern == 'aging'">Anti-âge</option>
                                    <option value="acne" t-att-selected="partner.oa_skin_concern == 'acne'">Acné &amp; Imperfections</option>
                                    <option value="hyperpigmentation" t-att-selected="partner.oa_skin_concern == 'hyperpigmentation'">Hyperpigmentation</option>
                                    <option value="dullness" t-att-selected="partner.oa_skin_concern == 'dullness'">Teint Terne</option>
                                    <option value="redness" t-att-selected="partner.oa_skin_concern == 'redness'">Rougeurs</option>
                                    <option value="dehydration" t-att-selected="partner.oa_skin_concern == 'dehydration'">Déshydratation</option>
                                </select>
                            </div>
                            
                            <div class="col-12 col-md-6 mb-4">
                                <label class="form-label fw-bold" style="color: var(--oa-prune);">Famille Olfactive Préférée</label>
                                <select name="fragrance_pref" class="form-select">
                                    <option value="" t-att-selected="not partner.oa_fragrance_preference">Sélectionner</option>
                                    <option value="floral" t-att-selected="partner.oa_fragrance_preference == 'floral'">Florale</option>
                                    <option value="woody" t-att-selected="partner.oa_fragrance_preference == 'woody'">Boisée</option>
                                    <option value="oriental" t-att-selected="partner.oa_fragrance_preference == 'oriental'">Orientale</option>
                                    <option value="fresh" t-att-selected="partner.oa_fragrance_preference == 'fresh'">Fraîche</option>
                                    <option value="gourmand" t-att-selected="partner.oa_fragrance_preference == 'gourmand'">Gourmande</option>
                                </select>
                            </div>

                            <div class="col-12 mb-4 mt-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="newsletter_optin" name="newsletter_optin" t-att-checked="partner.oa_newsletter_optin"/>
                                    <label class="form-check-label" for="newsletter_optin">
                                        Je souhaite recevoir la newsletter O&amp;A Beauty et l'accès exclusif aux nouveautés.
                                    </label>
                                </div>
                            </div>
                            
                            <div class="col-12 text-end">
                                <button type="submit" class="oa-btn-primary px-4 py-2">Mettre à jour mon profil</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>

</odoo>
