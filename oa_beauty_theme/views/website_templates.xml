                    <div class="container text-center">
                        <h3 class="mb-3" style="font-family: var(--oa-font-display); color: var(--oa-prune); font-size: 2.2rem; font-style: italic;">Rejoignez le Cercle O&amp;A Beauty</h3>
                        <p class="mb-4 text-muted" style="font-family: var(--oa-font-body); max-width: 500px; margin: 0 auto; font-size: 0.9rem; letter-spacing: 0.05em;">Abonnez-vous pour accéder en exclusivité aux nouveaux lancements, rituels de beauté et événements privés.</p>
                        <div class="oa-newsletter-wrapper">
                            <div class="oa-newsletter-form input-group d-flex justify-content-center mx-auto" style="max-width: 450px;">
                                <input
                                    type="email"
                                    name="email"
                                    class="oa-newsletter-email form-control rounded-0"
                                    placeholder="Votre adresse e-mail"
                                    autocomplete="email"
                                    aria-label="Adresse e-mail pour la newsletter"
                                    style="border: 1px solid var(--oa-border); border-right: none; background: transparent; font-size: 0.9rem; padding: 12px 20px; box-shadow: none; outline: none;"/>
                                <button
                                    type="button"
                                    class="oa-newsletter-btn btn text-white rounded-0 px-4 d-flex align-items-center justify-content-center"
                                    aria-label="S'abonner à la newsletter"
                                    style="background-color: var(--oa-prune); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.15em; font-weight: 500; border: 1px solid var(--oa-prune); margin-left: -1px; min-height: 48px; cursor: pointer;">S'abonner</button>
                            </div>
                        </div>
                    </div>
                </section>

