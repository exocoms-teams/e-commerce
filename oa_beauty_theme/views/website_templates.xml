<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Inject Google Fonts and Font Awesome 6 into the <head> of every page.
        web.layout is the base HTML skeleton template — the //head xpath is
        one of the most stable in the entire Odoo codebase (it's literally
        the HTML <head> element) and has not changed across versions.
    -->
    <template id="oa_beauty_head_assets" inherit_id="web.layout" name="O&amp;A Beauty — Head Assets">
        <xpath expr="//head" position="inside">
            <!-- Preconnect for performance -->
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <!-- Google Fonts: Cormorant Garamond (display) + Jost (body) -->
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&amp;family=Jost:wght@300;400;500;600&amp;display=swap"/>
            <!-- Font Awesome 6 — required for fa-brands fa-instagram/tiktok/pinterest -->
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uo0qcPxh4Plh7eecAlmChMD1EjyFg6J5BCFSgQ==" crossorigin="anonymous" referrerpolicy="no-referrer"/>
            
            <!-- ANALYTICS & TRACKING PLACEHOLDERS (Epic 5) -->
            <!-- Google Analytics 4 -->
            <!-- <script async="async" src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
            <script>
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', 'G-XXXXXXXXXX');
            </script> -->
            
            <!-- Meta Pixel Code -->
            <!-- <script>
              !function(f,b,e,v,n,t,s)
              {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
              n.callMethod.apply(n,arguments):n.queue.push(arguments)};
              if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
              n.queue=[];t=b.createElement(e);t.async=!0;
              t.src=v;s=b.getElementsByTagName(e)[0];
              s.parentNode.insertBefore(t,s)}(window, document,'script',
              'https://connect.facebook.net/en_US/fbevents.js');
              fbq('init', 'XXXXXXXXXXXXXXXX');
              fbq('track', 'PageView');
            </script> -->
        </xpath>
    </template>

    <!--
        Epic 6 & 1: Newsletter et Réseaux Sociaux dans le Footer
    -->
    <template id="oa_beauty_footer" inherit_id="website.layout" name="O&amp;A Beauty — Footer">
        <xpath expr="//footer" position="replace">
            <footer id="bottom" class="oa-footer bg-white">
                
                <!-- Newsletter Section -->
                <section class="oa-footer-newsletter py-5 border-bottom">
                    <div class="container text-center">
                        <h3 class="mb-3" style="font-family: var(--oa-font-display); color: var(--oa-prune); font-size: 2.2rem; font-style: italic;">Rejoignez le Cercle O&amp;A Beauty</h3>
                        <p class="mb-4 text-muted" style="font-family: var(--oa-font-body); max-width: 500px; margin: 0 auto; font-size: 0.9rem; letter-spacing: 0.05em;">Abonnez-vous pour accéder en exclusivité aux nouveaux lancements, rituels de beauté et événements privés.</p>
                        <form class="d-flex justify-content-center mx-auto" style="max-width: 450px;">
                            <input type="email" class="form-control me-0 rounded-0" placeholder="Votre adresse e-mail" style="border: 1px solid var(--oa-border); border-right: none; background: transparent; font-size: 0.9rem; padding: 12px 20px; box-shadow: none;"/>
                            <button type="submit" class="btn text-white rounded-0 px-4" style="background-color: var(--oa-prune); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.15em; font-weight: 500;">S'abonner</button>
                        </form>
                    </div>
                </section>

                <!-- Main Footer Content -->
                <section class="oa-footer-main py-5">
                    <div class="container">
                        <div class="row gx-5">
                            <!-- Column 1: Brand -->
                            <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                                <h4 class="mb-4" style="font-family: var(--oa-font-display); color: var(--oa-prune); font-size: 1.8rem;">O&amp;A Beauty</h4>
                                <p class="text-muted" style="font-size: 0.85rem; line-height: 1.8; letter-spacing: 0.05em; padding-right: 20px;">
                                    Une marque de cosmétiques de luxe dédiée à la célébration de la beauté naturelle grâce à des formulations propres, performantes et d'une élégance éditoriale.
                                </p>
                            </div>

                            <!-- Column 2: Shop -->
                            <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                                <h6 class="text-uppercase mb-4" style="color: var(--oa-prune); font-weight: 600; letter-spacing: 0.15em; font-size: 0.8rem;">Boutique</h6>
                                <ul class="list-unstyled mb-0 oa-footer-links">
                                    <li class="mb-3"><a href="/shop/category/skincare" class="text-muted text-decoration-none">Soins de la Peau</a></li>
                                    <li class="mb-3"><a href="/shop/category/makeup" class="text-muted text-decoration-none">Maquillage</a></li>
                                    <li class="mb-3"><a href="/best-sellers" class="text-muted text-decoration-none">Meilleures Ventes</a></li>
                                    <li class="mb-3"><a href="/new-arrivals" class="text-muted text-decoration-none">Nouveautés</a></li>
                                </ul>
                            </div>

                            <!-- Column 3: Customer Care -->
                            <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                                <h6 class="text-uppercase mb-4" style="color: var(--oa-prune); font-weight: 600; letter-spacing: 0.15em; font-size: 0.8rem;">Service Client</h6>
                                <ul class="list-unstyled mb-0 oa-footer-links">
                                    <li class="mb-3"><a href="/contact-us" class="text-muted text-decoration-none">Nous Contacter</a></li>
                                    <li class="mb-3"><a href="/faq" class="text-muted text-decoration-none">FAQ</a></li>
                                    <li class="mb-3"><a href="/shipping-delivery" class="text-muted text-decoration-none">Livraison et Expédition</a></li>
                                    <li class="mb-3"><a href="/returns" class="text-muted text-decoration-none">Retours et Remboursements</a></li>
                                </ul>
                            </div>

                            <!-- Column 4: Community -->
                            <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                                <h6 class="text-uppercase mb-4" style="color: var(--oa-prune); font-weight: 600; letter-spacing: 0.15em; font-size: 0.8rem;">Communauté</h6>
                                <ul class="list-unstyled mb-0 oa-footer-links">
                                    <li class="mb-3">
                                        <a href="https://instagram.com" class="text-muted text-decoration-none d-flex align-items-center">
                                            <i class="fa-brands fa-instagram me-3 fs-5"></i> Instagram
                                        </a>
                                    </li>
                                    <li class="mb-3">
                                        <a href="https://tiktok.com" class="text-muted text-decoration-none d-flex align-items-center">
                                            <i class="fa-brands fa-tiktok me-3 fs-5"></i> TikTok
                                        </a>
                                    </li>
                                    <li class="mb-3">
                                        <a href="https://pinterest.com" class="text-muted text-decoration-none d-flex align-items-center">
                                            <i class="fa-brands fa-pinterest me-3 fs-5"></i> Pinterest
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Bottom Row -->
                <section class="oa-footer-bottom py-4" style="background-color: var(--oa-ivory);">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                                <span class="text-muted" style="font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;">
                                    &amp;copy; 2026 O&amp;A Beauty. Tous droits réservés.
                                </span>
                            </div>
                            <div class="col-md-6 text-center text-md-end">
                                <a href="/privacy" class="text-muted text-decoration-none me-4" style="font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;">Politique de Confidentialité</a>
                                <a href="/terms" class="text-muted text-decoration-none" style="font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;">Conditions Générales</a>
                            </div>
                        </div>
                    </div>
                </section>
            </footer>
        </xpath>
    </template>

</odoo>
