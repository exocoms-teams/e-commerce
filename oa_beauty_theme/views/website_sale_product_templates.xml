<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Single inheritance point, on purpose.

        The previous version of this file had TWO separate inherited
        templates:
          1. inherit_id="website_sale.product_accordion" -> #product_accordion
          2. inherit_id="website_sale.product"            -> #add_to_cart_wrap

        On the live instance, (1) installed cleanly but (2) failed with
        "Element '' cannot be located in parent view" — meaning
        #add_to_cart_wrap does not exist in this Odoo.sh database's actual
        website_sale.product template (likely an Enterprise-vs-Community
        markup difference, since the public Odoo source only confirms
        Community markup).

        Fix: drop the second, unconfirmed anchor entirely. Everything
        (specs, ingredients, AND trust badges) now lives inside the one
        anchor that is empirically proven to work on this exact database:
        #product_accordion.
    -->

    <template id="product_accordion_oa_specs" inherit_id="website_sale.product_accordion">
        <xpath expr="//div[@id='product_accordion']" position="inside">

            <!-- Item 1: Type / Finish / Best For / Key Ingredients -->
            <div class="accordion-item" t-if="product.oa_type or product.oa_finish or product.oa_best_for or product.oa_key_ingredients">
                <div class="accordion-header my-0 h6">
                    <button class="accordion-button collapsed fw-medium" type="button"
                            data-bs-toggle="collapse" data-bs-target="#oa_specifications"
                            aria-expanded="false" aria-controls="oa_specifications">
                        Product Details
                    </button>
                </div>
                <div id="oa_specifications" class="accordion-collapse collapse" data-bs-parent="#product_accordion">
                    <div class="accordion-body pt-0">

                        <!-- .detail-specs equivalent: Type / Finish / Best For -->
                        <div class="o_oa_specs row mt-2" t-if="product.oa_type or product.oa_finish or product.oa_best_for">
                            <div class="col-12 col-md-4" t-if="product.oa_type">
                                <span class="o_oa_spec_label text-muted d-block">Type</span>
                                <span class="o_oa_spec_value" t-esc="product.oa_type"/>
                            </div>
                            <div class="col-12 col-md-4" t-if="product.oa_finish">
                                <span class="o_oa_spec_label text-muted d-block">Finish</span>
                                <span class="o_oa_spec_value" t-esc="product.oa_finish"/>
                            </div>
                            <div class="col-12 col-md-4" t-if="product.oa_best_for">
                                <span class="o_oa_spec_label text-muted d-block">Best For</span>
                                <span class="o_oa_spec_value" t-esc="product.oa_best_for"/>
                            </div>
                        </div>

                        <!-- .detail-ingredients equivalent -->
                        <div class="o_oa_ingredients mt-3" t-if="product.oa_key_ingredients">
                            <span class="o_oa_ing_label text-uppercase text-muted d-block">Key Ingredients</span>
                            <p class="o_oa_ing_value mb-0" t-esc="product.oa_key_ingredients"/>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Item 2: Trust badges (.detail-meta equivalent). Static
                 across all products on the original site, so hard-coded
                 here rather than modeled as fields. -->
            <div class="accordion-item">
                <div class="accordion-header my-0 h6">
                    <button class="accordion-button collapsed fw-medium" type="button"
                            data-bs-toggle="collapse" data-bs-target="#oa_trust_badges"
                            aria-expanded="false" aria-controls="oa_trust_badges">
                        Delivery &amp; Returns
                    </button>
                </div>
                <div id="oa_trust_badges" class="accordion-collapse collapse" data-bs-parent="#product_accordion">
                    <div class="accordion-body pt-0">
                        <div class="o_oa_trust_badges">
                            <p><i class="fa fa-truck me-2"/>Free delivery on orders over $60</p>
                            <p><i class="fa fa-rotate-left me-2"/>30-day hassle-free returns</p>
                            <p><i class="fa fa-leaf me-2"/>Cruelty-free &amp; clean formula</p>
                        </div>
                    </div>
                </div>
            </div>

        </xpath>
    </template>

</odoo>
