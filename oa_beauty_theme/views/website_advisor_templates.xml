<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        O&A Beauty Advisor Page
        Accessible at /beauty-advisor
        Injected as a standalone website page.
    -->
    <template id="oa_beauty_advisor_page" name="O&amp;A Beauty Advisor">
        <t t-call="website.layout">
            <t t-set="head">
                <title>Beauty Advisor | O&amp;A Beauty</title>
                <meta name="description" content="Get your personalized luxury skincare and makeup routine from O&amp;A Beauty's AI Beauty Advisor."/>
            </t>

            <div id="wrap" class="oa-advisor-wrap">

                <!-- Hero Header -->
                <section class="oa-advisor-hero text-center">
                    <div class="container">
                        <p class="oa-advisor-eyebrow">YOUR PERSONAL</p>
                        <h1 class="oa-advisor-title">Beauty Advisor</h1>
                        <p class="oa-advisor-subtitle">Answer a few questions and discover your personalized O&amp;A Beauty ritual.</p>
                    </div>
                </section>

                <!-- Quiz Container -->
                <section class="oa-advisor-quiz-section">
                    <div class="container">
                        <div class="oa-advisor-quiz-card" id="oa_advisor_quiz">

                            <!-- Progress Bar -->
                            <div class="oa-advisor-progress-wrap">
                                <div class="oa-advisor-progress-bar" id="oa_advisor_progress" style="width: 20%"></div>
                            </div>
                            <p class="oa-advisor-step-label" id="oa_advisor_step_label">Step 1 of 5</p>

                            <!-- Step 1: Skin Type -->
                            <div class="oa-advisor-step active" data-step="1">
                                <h3 class="oa-advisor-question">What is your skin type?</h3>
                                <div class="oa-advisor-options" data-field="skin_type">
                                    <button class="oa-advisor-option" data-value="dry">🌵 Dry</button>
                                    <button class="oa-advisor-option" data-value="oily">💧 Oily</button>
                                    <button class="oa-advisor-option" data-value="combination">☯️ Combination</button>
                                    <button class="oa-advisor-option" data-value="normal">✨ Normal</button>
                                    <button class="oa-advisor-option" data-value="sensitive">🌸 Sensitive</button>
                                </div>
                            </div>

                            <!-- Step 2: Main Concern -->
                            <div class="oa-advisor-step" data-step="2">
                                <h3 class="oa-advisor-question">What is your main skin concern?</h3>
                                <div class="oa-advisor-options" data-field="main_concern">
                                    <button class="oa-advisor-option" data-value="acne">🔴 Acne</button>
                                    <button class="oa-advisor-option" data-value="hyperpigmentation">⚡ Hyperpigmentation</button>
                                    <button class="oa-advisor-option" data-value="redness">🌹 Redness</button>
                                    <button class="oa-advisor-option" data-value="dehydration">🌊 Dehydration</button>
                                    <button class="oa-advisor-option" data-value="aging">⏳ Anti-aging</button>
                                    <button class="oa-advisor-option" data-value="dullness">💫 Dullness</button>
                                    <button class="oa-advisor-option" data-value="pores">🔬 Large Pores</button>
                                </div>
                            </div>

                            <!-- Step 3: Makeup Preference -->
                            <div class="oa-advisor-step" data-step="3">
                                <h3 class="oa-advisor-question">What is your makeup style?</h3>
                                <div class="oa-advisor-options" data-field="makeup_preference">
                                    <button class="oa-advisor-option" data-value="natural">🌿 Natural</button>
                                    <button class="oa-advisor-option" data-value="everyday">☀️ Everyday</button>
                                    <button class="oa-advisor-option" data-value="glamorous">✨ Glamorous</button>
                                </div>
                            </div>

                            <!-- Step 4: Budget -->
                            <div class="oa-advisor-step" data-step="4">
                                <h3 class="oa-advisor-question">What is your beauty budget?</h3>
                                <div class="oa-advisor-options" data-field="budget">
                                    <button class="oa-advisor-option" data-value="essential">💚 Essential (€20-€40)</button>
                                    <button class="oa-advisor-option" data-value="standard">💜 Standard (€40-€80)</button>
                                    <button class="oa-advisor-option" data-value="premium">💛 Premium (€80+)</button>
                                </div>
                            </div>

                            <!-- Step 5: Optional - Age Range -->
                            <div class="oa-advisor-step" data-step="5">
                                <h3 class="oa-advisor-question">What is your age range? (Optional)</h3>
                                <div class="oa-advisor-options" data-field="age_range">
                                    <button class="oa-advisor-option" data-value="18-25">18–25</button>
                                    <button class="oa-advisor-option" data-value="25-35">25–35</button>
                                    <button class="oa-advisor-option" data-value="35-45">35–45</button>
                                    <button class="oa-advisor-option" data-value="45+">45+</button>
                                    <button class="oa-advisor-option" data-value="skip">Prefer not to say</button>
                                </div>
                            </div>

                            <!-- Navigation -->
                            <div class="oa-advisor-nav mt-4">
                                <button class="oa-advisor-btn-back" id="oa_advisor_back" style="display:none">← Back</button>
                                <button class="oa-advisor-btn-next" id="oa_advisor_next" disabled="disabled">Next →</button>
                            </div>

                        </div>

                        <!-- Loading state -->
                        <div class="oa-advisor-loading" id="oa_advisor_loading" style="display:none">
                            <div class="oa-advisor-spinner"></div>
                            <p>Curating your personalized routine…</p>
                        </div>

                        <!-- Results -->
                        <div class="oa-advisor-results" id="oa_advisor_results" style="display:none">
                            <div class="oa-advisor-explanation" id="oa_advisor_explanation"></div>

                            <h3 class="oa-advisor-results-title">Your Personalized Routine</h3>
                            <div class="oa-advisor-routine-steps" id="oa_advisor_routine"></div>

                            <h3 class="oa-advisor-results-title mt-5">Recommended for You</h3>
                            <div class="oa-advisor-products-grid" id="oa_advisor_products"></div>

                            <div class="text-center mt-5">
                                <button class="oa-btn-accent" id="oa_advisor_restart">← Restart Advisor</button>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

    <!-- Inject "Beauty Advisor" CTA into every page body -->
    <template id="oa_advisor_floating_cta" inherit_id="website.layout" name="O&amp;A Beauty Advisor CTA">
        <xpath expr="//body" position="inside">
            <a href="/beauty-advisor" id="oa_advisor_fab" class="oa-advisor-fab" title="Beauty Advisor">
                <i class="fa fa-magic"></i>
                <span class="oa-advisor-fab-label">Beauty Advisor</span>
            </a>
        </xpath>
    </template>

    <!-- Register the /beauty-advisor route as a page -->
    <record id="oa_advisor_page_ir" model="ir.ui.view">
        <field name="name">oa_beauty_advisor_page</field>
        <field name="type">qweb</field>
        <field name="key">oa_beauty_theme.oa_beauty_advisor_page</field>
        <field name="arch" type="xml">
            <t/>
        </field>
    </record>

    <record id="website_page_advisor" model="website.page">
        <field name="name">Beauty Advisor</field>
        <field name="url">/beauty-advisor</field>
        <field name="view_id" ref="oa_beauty_theme.oa_beauty_advisor_page"/>
        <field name="is_published">True</field>
        <field name="website_indexed">True</field>
    </record>

</odoo>
