<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        O&A Beauty Advisor Page
        Accessible at /beauty-advisor
        Injected as a standalone website page.
    -->
    <template id="oa_beauty_advisor_page" name="Conseiller beauté O&amp;A">
        <t t-call="website.layout">
            <t t-set="head">
                <title>Conseiller beauté | O&amp;A Atelier</title>
                <meta name="description" content="Obtenez une routine beauté personnalisée grâce au Beauty Advisor O&amp;A Atelier."/>
            </t>

            <div id="wrap" class="oa-advisor-wrap">

                <!-- Hero Header -->
                <section class="oa-advisor-hero text-center">
                    <div class="container">
                        <p class="oa-advisor-eyebrow">VOTRE CONSEILLER</p>
                        <h1 class="oa-advisor-title">Conseiller beauté</h1>
                        <p class="oa-advisor-subtitle">Répondez à quelques questions et découvrez votre rituel O&amp;A Atelier personnalisé.</p>
                    </div>
                </section>

                <!-- Quiz Container -->
                <section class="oa-advisor-quiz-section">
                    <div class="container">
                        <div class="oa-advisor-quiz-card" id="oa_advisor_quiz">

                            <!-- Progress Bar -->
                            <div class="oa-advisor-progress-wrap">
                                <div class="oa-advisor-progress-bar" id="oa_advisor_progress" style="width: 20%"></div>
                            </div>
                            <p class="oa-advisor-step-label" id="oa_advisor_step_label">Étape 1 sur 5</p>

                            <!-- Step 1: Skin Type -->
                            <div class="oa-advisor-step active" data-step="1">
                                <h3 class="oa-advisor-question">Quel est votre type de peau ?</h3>
                                <div class="oa-advisor-options" data-field="skin_type">
                                    <button class="oa-advisor-option" data-value="dry">🌵 Sèche</button>
                                    <button class="oa-advisor-option" data-value="oily">💧 Grasse</button>
                                    <button class="oa-advisor-option" data-value="combination">☯️ Mixte</button>
                                    <button class="oa-advisor-option" data-value="normal">✨ Normale</button>
                                    <button class="oa-advisor-option" data-value="sensitive">🌸 Sensible</button>
                                </div>
                            </div>

                            <!-- Step 2: Main Concern -->
                            <div class="oa-advisor-step" data-step="2">
                                <h3 class="oa-advisor-question">Quelle est votre principale préoccupation cutanée ?</h3>
                                <div class="oa-advisor-options" data-field="main_concern">
                                    <button class="oa-advisor-option" data-value="acne">🔴 Acné</button>
                                    <button class="oa-advisor-option" data-value="hyperpigmentation">⚡ Hyperpigmentation</button>
                                    <button class="oa-advisor-option" data-value="redness">🌹 Rougeurs</button>
                                    <button class="oa-advisor-option" data-value="dehydration">🌊 Déshydratation</button>
                                    <button class="oa-advisor-option" data-value="aging">⏳ Anti-âge</button>
                                    <button class="oa-advisor-option" data-value="dullness">💫 Teint terne</button>
                                    <button class="oa-advisor-option" data-value="pores">🔬 Pores dilatés</button>
                                </div>
                            </div>

                            <!-- Step 3: Makeup Preference -->
                            <div class="oa-advisor-step" data-step="3">
                                <h3 class="oa-advisor-question">Quel est votre style de maquillage ?</h3>
                                <div class="oa-advisor-options" data-field="makeup_preference">
                                    <button class="oa-advisor-option" data-value="natural">🌿 Naturel</button>
                                    <button class="oa-advisor-option" data-value="everyday">☀️ Quotidien</button>
                                    <button class="oa-advisor-option" data-value="glamorous">✨ Glamour</button>
                                </div>
                            </div>

                            <!-- Step 4: Budget -->
                            <div class="oa-advisor-step" data-step="4">
                                <h3 class="oa-advisor-question">Quel est votre budget beauté ?</h3>
                                <div class="oa-advisor-options" data-field="budget">
                                    <button class="oa-advisor-option" data-value="essential">💚 Essentiel (€20-€40)</button>
                                    <button class="oa-advisor-option" data-value="standard">💜 Standard (€40-€80)</button>
                                    <button class="oa-advisor-option" data-value="premium">💛 Premium (€80+)</button>
                                </div>
                            </div>

                            <!-- Step 5: Optional - Age Range -->
                            <div class="oa-advisor-step" data-step="5">
                                <h3 class="oa-advisor-question">Quelle est votre tranche d'âge ? (facultatif)</h3>
                                <div class="oa-advisor-options" data-field="age_range">
                                    <button class="oa-advisor-option" data-value="18-25">18–25</button>
                                    <button class="oa-advisor-option" data-value="25-35">25–35</button>
                                    <button class="oa-advisor-option" data-value="35-45">35–45</button>
                                    <button class="oa-advisor-option" data-value="45+">45+</button>
                                    <button class="oa-advisor-option" data-value="skip">Je préfère ne pas répondre</button>
                                </div>
                            </div>

                            <!-- Navigation -->
                            <div class="oa-advisor-nav mt-4">
                                <button class="oa-advisor-btn-back" id="oa_advisor_back" style="display:none">← Retour</button>
                                <button class="oa-advisor-btn-next" id="oa_advisor_next" disabled="disabled">Suivant →</button>
                            </div>

                        </div>

                        <!-- Loading state -->
                        <div class="oa-advisor-loading" id="oa_advisor_loading" style="display:none">
                            <div class="oa-advisor-spinner"></div>
                            <p>Nous préparons votre routine personnalisée…</p>
                        </div>

                        <!-- Results -->
                        <div class="oa-advisor-results" id="oa_advisor_results" style="display:none">
                            <div class="oa-advisor-explanation" id="oa_advisor_explanation"></div>

                            <h3 class="oa-advisor-results-title">Votre routine personnalisée</h3>
                            <div class="oa-advisor-routine-steps" id="oa_advisor_routine"></div>

                            <h3 class="oa-advisor-results-title mt-5">Recommandé pour vous</h3>
                            <div class="oa-advisor-products-grid" id="oa_advisor_products"></div>

                            <div class="text-center mt-5">
                                <button class="oa-btn-accent" id="oa_advisor_restart">← Recommencer</button>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

    <!-- Inject "Beauty Advisor" CTA into every page body -->
    <template id="oa_advisor_floating_cta" inherit_id="website.layout" name="O&amp;A Atelier Advisor CTA">
        <xpath expr="//body" position="inside">
            <a href="/beauty-advisor" id="oa_advisor_fab" class="oa-advisor-fab" title="Conseiller beauté">
                <i class="fa fa-magic"></i>
                <span class="oa-advisor-fab-label">Conseiller beauté</span>
            </a>
        </xpath>
    </template>

    <!-- Register the /beauty-advisor route as a page -->
    <record id="oa_advisor_page_ir" model="ir.ui.view">
        <field name="name">oa_beauty_advisor_page</field>
        <field name="type">qweb</field>
        <field name="key">oa_beauty_theme.oa_beauty_advisor_page</field>
        <field name="arch" type="xml">
            <t/>
        </field>
    </record>

    <record id="website_page_advisor" model="website.page">
        <field name="website_id" ref="oa_beauty_theme.oa_beauty_website"/>
        <field name="name">Conseiller beauté</field>
        <field name="url">/beauty-advisor</field>
        <field name="view_id" ref="oa_beauty_theme.oa_beauty_advisor_page"/>
        <field name="is_published">True</field>
        <field name="website_indexed">True</field>
    </record>

</odoo>
