<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_oa_form_view" model="ir.ui.view">
        <field name="name">product.template.oa.beauty.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='description_sale']" position="before">

                <group string="O&amp;A Atelier Specs" name="oa_beauty_specs">
                    <field name="oa_type" placeholder="e.g. Cleanser, Lipstick" help="Type of product for technical sorting."/>
                    <field name="oa_finish" placeholder="e.g. Matte, Dewy" help="The visual finish applied to makeup."/>
                    <field name="oa_best_for" placeholder="e.g. Dry Skin, Evening" help="Target skin type or use case."/>
                    <field name="oa_key_ingredients" help="Comma-separated list of star ingredients."/>
                </group>
                <group string="O&amp;A Fragrance &amp; Status" name="oa_beauty_fragrance">
                    <field name="oa_is_coming_soon" help="If checked, Add to Cart is disabled and a 'Coming Soon' badge is displayed."/>
                    <field name="oa_mood" placeholder="e.g. Elegant, Sensual" help="The emotional mood this fragrance evokes."/>
                    <field name="oa_fragrance_top_notes" placeholder="e.g. Bergamot, Mandarin" help="First impression, evaporates quickly."/>
                    <field name="oa_fragrance_heart_notes" placeholder="e.g. Rose, Jasmine" help="The core of the fragrance."/>
                    <field name="oa_fragrance_base_notes" placeholder="e.g. Vanilla, Musk" help="The lingering scent foundation."/>
                </group>
                <group string="O&amp;A SEO &amp; Editorial" name="oa_beauty_editorial">
                    <field name="oa_seo_keywords" placeholder="e.g. luxury skincare, natural serum" help="Keywords injected into meta tags for SEO."/>
                    <field name="oa_benefits" widget="html" help="Displayed in the product page accordion under 'Bienfaits'."/>
                    <field name="oa_how_to_use" widget="html" help="Displayed in the product page accordion under 'Conseils'."/>
                </group>

            </xpath>

        </field>
    </record>

</odoo>