<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_oa_form_view" model="ir.ui.view">
        <field name="name">product.template.oa.beauty.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='description_sale']" position="before">

                <group string="O&amp;A Beauty Specs" name="oa_beauty_specs">
                    <field name="oa_type" placeholder="e.g. Cleanser, Lipstick"/>
                    <field name="oa_finish" placeholder="e.g. Matte, Dewy"/>
                    <field name="oa_best_for" placeholder="e.g. Dry Skin, Evening"/>
                    <field name="oa_key_ingredients"/>
                </group>
                <group string="O&amp;A Fragrance &amp; Status" name="oa_beauty_fragrance">
                    <field name="oa_is_coming_soon"/>
                    <field name="oa_mood" placeholder="e.g. Elegant, Sensual"/>
                    <field name="oa_fragrance_top_notes" placeholder="e.g. Bergamot, Mandarin"/>
                    <field name="oa_fragrance_heart_notes" placeholder="e.g. Rose, Jasmine"/>
                    <field name="oa_fragrance_base_notes" placeholder="e.g. Vanilla, Musk"/>
                </group>

            </xpath>

        </field>
    </record>

</odoo>