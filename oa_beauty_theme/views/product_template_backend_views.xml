<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_oa_form_view" model="ir.ui.view">
        <field name="name">product.template.oa.beauty.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='description_sale']" position="before">

                <group string="O&amp;A Beauty — Cosmetic Specs" name="oa_beauty_specs">

                    <field name="oa_type"
                           placeholder="e.g. Lip Colour, Brightening Serum"/>

                    <field name="oa_finish"
                           placeholder="e.g. Matte Velvet, Natural Satin"/>

                    <field name="oa_best_for"
                           placeholder="e.g. Long-lasting wear, Dry &amp; mature skin"/>

                    <field name="oa_key_ingredients"
                           placeholder="e.g. Shea Butter, Vitamin E, Jojoba Oil"/>

                </group>

            </xpath>

        </field>
    </record>

</odoo>