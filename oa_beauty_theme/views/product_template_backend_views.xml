<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_oa_specs" model="ir.ui.view">
        <field name="name">product.template.form.oa.specs</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Anchor on the Sales tab's description_sale field, which is
                 present on every Odoo 19 product form. Verify in your
                 instance (Settings > Technical > Views, with developer
                 mode "Edit View" on the product form) if this xpath does
                 not match after an Odoo upgrade. -->
            <xpath expr="//field[@name='description_sale']" position="before">
                <group string="O&amp;A Beauty — Cosmetic Specs" name="oa_beauty_specs">
                    <field name="oa_type" placeholder="e.g. Lip Colour"/>
                    <field name="oa_finish" placeholder="e.g. Matte Velvet"/>
                    <field name="oa_best_for" placeholder="e.g. Long-lasting wear"/>
                    <field name="oa_key_ingredients" placeholder="e.g. Shea Butter, Vitamin E, Jojoba Oil"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
