<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================================= -->
    <!-- OVERRIDE LOGIN PAGE (/web/login)                                        -->
    <!-- ======================================================================= -->
    <template id="login_luxury" inherit_id="web.login" name="Luxury Login">
        <xpath expr="//t[@t-call='web.login_layout']" position="replace">
            <t t-call="website.layout">
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                
                <div class="container-fluid p-0">
                    <div class="row g-0" style="min-height: 100vh;">
                        
                        <!-- LEFT SIDE: Image -->
                        <div class="col-lg-6 d-none d-lg-block position-relative" style="background-color: var(--oa-bg-alt);">
                            <div class="position-absolute w-100 h-100 oa-img-zoom" style="top: 0; left: 0;">
                                <!-- Ideally, we would point to a real image. Using a placeholder or brand color for now -->
                                <div class="w-100 h-100" style="background: linear-gradient(135deg, var(--oa-bg-alt) 0%, var(--oa-ivory) 100%); display: flex; align-items: center; justify-content: center;">
                                    <h1 class="oa-editorial-h1" style="color: var(--oa-prune); font-size: 4rem; opacity: 0.1;">O&amp;A Atelier</h1>
                                </div>
                            </div>
                        </div>
                        
                        <!-- RIGHT SIDE: Form -->
                        <div class="col-lg-6 d-flex flex-column align-items-center justify-content-center bg-white p-5">
                            
                            <!-- Logo -->
                            <div class="mb-5 text-center">
                                <a href="/" class="text-decoration-none">
                                    <span class="fs-3 fw-bold" style="color: var(--oa-prune); letter-spacing: 0.15em;">O&amp;A BEAUTY</span>
                                </a>
                            </div>

                            <div class="w-100" style="max-width: 400px;">
                                <h2 class="oa-editorial-h2 mb-2 text-center">Bon retour</h2>
                                <p class="text-muted text-center mb-4 small">Connectez-vous pour accéder à votre espace privilégié.</p>
                                
                                <form class="oe_login_form" role="form" t-attf-action="/web/login" method="post" onsubmit="this.action = '/web/login' + location.hash">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="redirect" t-att-value="redirect"/>
                                    
                                    <div class="mb-3">
                                        <label for="login" class="form-label small text-uppercase fw-bold text-muted" style="letter-spacing: 0.1em;">Email</label>
                                        <input type="text" placeholder="votre@email.com" name="login" t-att-value="login" id="login" t-attf-class="form-control rounded-0 p-3 #{'is-invalid' if error else ''}" required="required" autofocus="autofocus" autocapitalize="off"/>
                                    </div>

                                    <div class="mb-4">
                                        <div class="d-flex justify-content-between">
                                            <label for="password" class="form-label small text-uppercase fw-bold text-muted" style="letter-spacing: 0.1em;">Mot de passe</label>
                                            <a t-if="reset_password_enabled" t-attf-href="/web/reset_password?{{ keep_query() }}" class="small text-decoration-none" style="color: var(--oa-mauve);">Oublié ?</a>
                                        </div>
                                        <input type="password" placeholder="••••••••" name="password" id="password" t-attf-class="form-control rounded-0 p-3 #{'is-invalid' if error else ''}" required="required" autocomplete="current-password" maxlength="4096"/>
                                    </div>

                                    <p class="alert alert-danger mb-4 rounded-0 small" t-if="error" role="alert">
                                        <i class="fa fa-exclamation-circle me-2"></i> <t t-esc="error"/>
                                    </p>
                                    <p class="alert alert-success mb-4 rounded-0 small" t-if="message" role="status">
                                        <t t-esc="message"/>
                                    </p>

                                    <div class="d-grid mb-4">
                                        <button type="submit" class="oa-btn-primary border-0 rounded-0 py-3">Connexion</button>
                                    </div>

                                    <!-- OAuth Providers (if any) -->
                                    <t t-set="providers" t-value="providers or []"/>
                                    <t t-if="len(providers) &gt; 0">
                                        <div class="text-center mb-4">
                                            <span class="text-muted small">Ou connectez-vous avec</span>
                                        </div>
                                        <div class="d-flex gap-2 justify-content-center mb-4">
                                            <t t-foreach="providers" t-as="p">
                                                <a t-att-href="p['auth_link']" class="btn btn-outline-dark rounded-0 px-4">
                                                    <i t-att-class="p['css_class']"/> <t t-esc="p['body']"/>
                                                </a>
                                            </t>
                                        </div>
                                    </t>

                                    <div t-if="signup_enabled" class="text-center mt-3">
                                        <span class="text-muted small">Nouveau ici ?</span>
                                        <a t-attf-href="/web/signup?{{ keep_query() }}" class="text-decoration-none fw-bold" style="color: var(--oa-prune);">Créer un compte</a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <!-- ======================================================================= -->
    <!-- OVERRIDE SIGNUP PAGE (/web/signup)                                      -->
    <!-- ======================================================================= -->
    <template id="signup_luxury" inherit_id="auth_signup.signup" name="Luxury Signup">
        <xpath expr="//t[@t-call='web.login_layout']" position="replace">
            <t t-call="website.layout">
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                
                <div class="container-fluid p-0">
                    <div class="row g-0" style="min-height: 100vh;">
                        
                        <!-- LEFT SIDE: Form -->
                        <div class="col-lg-6 d-flex flex-column align-items-center justify-content-center bg-white p-5 order-2 order-lg-1">
                            
                            <!-- Logo -->
                            <div class="mb-4 text-center">
                                <a href="/" class="text-decoration-none">
                                    <span class="fs-3 fw-bold" style="color: var(--oa-prune); letter-spacing: 0.15em;">O&amp;A BEAUTY</span>
                                </a>
                            </div>

                            <div class="w-100" style="max-width: 400px;">
                                <h2 class="oa-editorial-h2 mb-2 text-center">Rejoindre le Cercle</h2>
                                <p class="text-muted text-center mb-4 small">Créez votre compte pour des rituels beauté personnalisés.</p>
                                
                                <form class="oe_signup_form" role="form" method="post" t-if="not message">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="token" t-att-value="token"/>
                                    <input type="hidden" name="redirect" t-att-value="redirect"/>
                                    
                                    <div class="mb-3">
                                        <label for="name" class="form-label small text-uppercase fw-bold text-muted" style="letter-spacing: 0.1em;">Nom complet</label>
                                        <input type="text" name="name" t-att-value="name" id="name" class="form-control rounded-0 p-3" placeholder="Jane Doe" required="required" autofocus="autofocus" autocapitalize="off"/>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <label for="login" class="form-label small text-uppercase fw-bold text-muted" style="letter-spacing: 0.1em;">Email</label>
                                        <input type="email" name="login" t-att-value="login" id="login" class="form-control rounded-0 p-3" placeholder="votre@email.com" required="required" autocapitalize="off"/>
                                    </div>

                                    <div class="mb-3">
                                        <label for="password" class="form-label small text-uppercase fw-bold text-muted" style="letter-spacing: 0.1em;">Mot de passe</label>
                                        <input type="password" name="password" id="password" class="form-control rounded-0 p-3" placeholder="••••••••" required="required" autocomplete="current-password" t-att-autofocus="'autofocus' if login and not only_passwords else None" maxlength="4096"/>
                                    </div>
                                    
                                    <div class="mb-4">
                                        <label for="confirm_password" class="form-label small text-uppercase fw-bold text-muted" style="letter-spacing: 0.1em;">Confirmer le mot de passe</label>
                                        <input type="password" name="confirm_password" id="confirm_password" class="form-control rounded-0 p-3" placeholder="••••••••" required="required" maxlength="4096"/>
                                    </div>

                                    <p class="alert alert-danger mb-4 rounded-0 small" t-if="error" role="alert">
                                        <i class="fa fa-exclamation-circle me-2"></i> <t t-esc="error"/>
                                    </p>

                                    <div class="d-grid mb-4">
                                        <button type="submit" class="oa-btn-primary border-0 rounded-0 py-3">Créer mon compte</button>
                                    </div>

                                    <div class="text-center mt-3">
                                        <span class="text-muted small">Déjà membre ?</span>
                                        <a t-attf-href="/web/login?{{ keep_query() }}" class="text-decoration-none fw-bold" style="color: var(--oa-prune);">Connexion</a>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- RIGHT SIDE: Image -->
                        <div class="col-lg-6 d-none d-lg-block position-relative order-1 order-lg-2" style="background-color: var(--oa-lilac);">
                            <div class="position-absolute w-100 h-100 oa-img-zoom" style="top: 0; left: 0;">
                                <div class="w-100 h-100" style="background: linear-gradient(135deg, var(--oa-lilac) 0%, var(--oa-bg-alt) 100%); display: flex; align-items: center; justify-content: center;">
                                    <i class="fa fa-spa" style="color: var(--oa-prune); font-size: 8rem; opacity: 0.1;"></i>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <!-- ======================================================================= -->
    <!-- OVERRIDE RESET PASSWORD PAGE (/web/reset_password)                      -->
    <!-- ======================================================================= -->
    <template id="reset_password_luxury" inherit_id="auth_signup.reset_password" name="Luxury Reset Password">
        <xpath expr="//t[@t-call='web.login_layout']" position="replace">
            <t t-call="website.layout">
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                
                <div class="container-fluid p-0">
                    <div class="row g-0 justify-content-center align-items-center" style="min-height: 100vh; background-color: var(--oa-bg-alt);">
                        <div class="col-md-6 col-lg-4 bg-white p-5 shadow-lg" style="border: 1px solid var(--oa-border);">
                            
                            <div class="mb-5 text-center">
                                <a href="/" class="text-decoration-none">
                                    <span class="fs-3 fw-bold" style="color: var(--oa-prune); letter-spacing: 0.15em;">O&amp;A BEAUTY</span>
                                </a>
                            </div>

                            <h2 class="oa-editorial-h2 mb-2 text-center">Mot de passe oublié</h2>
                            <p class="text-muted text-center mb-4 small">Saisissez votre e-mail pour recevoir les instructions de réinitialisation.</p>

                            <t t-if="not message">
                                <form role="form" method="post" t-if="not message">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <div class="mb-4">
                                        <label for="login" class="form-label small text-uppercase fw-bold text-muted" style="letter-spacing: 0.1em;">Email</label>
                                        <input type="text" name="login" t-att-value="login" id="login" class="form-control rounded-0 p-3" placeholder="votre@email.com" required="required" autofocus="autofocus" autocapitalize="off"/>
                                    </div>

                                    <p class="alert alert-danger mb-4 rounded-0 small" t-if="error" role="alert">
                                        <i class="fa fa-exclamation-circle me-2"></i> <t t-esc="error"/>
                                    </p>

                                    <div class="d-grid mb-4">
                                        <button type="submit" class="oa-btn-primary border-0 rounded-0 py-3">Confirmer</button>
                                    </div>
                                    <div class="text-center mt-3">
                                        <a t-if="not token" t-attf-href="/web/login?{{ keep_query() }}" class="text-decoration-none small text-muted">Retour à la connexion</a>
                                        <a t-if="invalid_token" href="/web/login" class="text-decoration-none small text-muted">Retour à la connexion</a>
                                    </div>
                                </form>
                            </t>
                            <t t-if="message">
                                <p class="alert alert-success mb-4 rounded-0 small" role="status">
                                    <i class="fa fa-check-circle me-2"></i> <t t-esc="message"/>
                                </p>
                                <div class="text-center mt-3">
                                    <a href="/web/login" class="text-decoration-none small text-muted">Retour à la connexion</a>
                                </div>
                            </t>

                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
