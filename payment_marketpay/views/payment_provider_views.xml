<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit.marketpay</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'marketpay'">
                    <field name="marketpay_merchant_id" required="code == 'marketpay' and state != 'disabled'"/>
                    <field name="marketpay_secret_key" required="code == 'marketpay' and state != 'disabled'" password="True"/>
                    <field name="marketpay_key_id" required="code == 'marketpay' and state != 'disabled'"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
