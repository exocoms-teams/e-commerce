<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="redirect_form">
        <!-- This form is automatically submitted by Odoo's payment Javascript to redirect the user to the gateway -->
        <form t-att-action="api_url" method="post">
            <input type="hidden" name="merchant_id" t-att-value="marketpay_merchant_id"/>
            <input type="hidden" name="amount" t-att-value="marketpay_amount"/>
            <input type="hidden" name="currency" t-att-value="marketpay_currency"/>
            <input type="hidden" name="reference" t-att-value="marketpay_reference"/>
            <input type="hidden" name="return_url" t-att-value="marketpay_return_url"/>
            <input type="hidden" name="webhook_url" t-att-value="marketpay_webhook_url"/>
            <input type="hidden" name="signature" t-att-value="marketpay_signature"/>
        </form>
    </template>
</odoo>
