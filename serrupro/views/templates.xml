<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- SerruPro Homepage Template -->
        <template id="homepage" name="SerruPro Homepage">
            <t t-call="website.layout">
                <!-- Hero Section -->
                <section class="serrupro-hero" style="background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%); color: white; padding: 80px 0; text-align: center;">
                    <div class="container">
                        <h1 style="font-size: 3rem; font-weight: bold; margin-bottom: 20px;">Bienvenue chez SerruPro</h1>
                        <p style="font-size: 1.3rem; margin-bottom: 30px;">Vos experts en serrurerie - Disponibles 24h/24, 7j/7</p>
                        <a href="#contact" class="btn btn-warning btn-lg" style="padding: 12px 40px; font-weight: bold;">
                            Demander un devis
                        </a>
                    </div>
                </section>

                <!-- About Section -->
                <section class="serrupro-about" style="padding: 60px 0; background-color: #f8f9fa;">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <h2 style="font-size: 2.2rem; font-weight: bold; margin-bottom: 20px; color: #1a1a1a;">
                                    Qui sommes-nous ?
                                </h2>
                                <p style="font-size: 1.1rem; line-height: 1.8; color: #555; margin-bottom: 15px;">
                                    SerruPro est votre partenaire de confiance en serrurerie depuis plus de 10 ans. 
                                    Nous offrons des services professionnels, rapides et de qualité pour tous vos besoins.
                                </p>
                                <p style="font-size: 1.1rem; line-height: 1.8; color: #555;">
                                    Notre équipe d'experts certifiés garantit votre satisfaction et la sécurité de vos biens.
                                </p>
                            </div>
                            <div class="col-md-6">
                                <img src="https://placehold.co/400x300?text=Services+Serrurerie" alt="Services SerruPro" style="width: 100%; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);"/>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Services Section -->
                <section class="serrupro-services" style="padding: 60px 0; background-color: white;">
                    <div class="container">
                        <h2 style="text-align: center; font-size: 2.2rem; font-weight: bold; margin-bottom: 50px; color: #1a1a1a;">
                            Nos Services
                        </h2>
                        <div class="row">
                            <div class="col-md-4 mb-4">
                                <div style="background-color: #f8f9fa; padding: 30px; border-radius: 10px; text-align: center; transition: all 0.3s ease; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                                    <i class="fa fa-lock" style="font-size: 3rem; color: #dc3545; margin-bottom: 20px;"/>
                                    <h3 style="font-size: 1.5rem; font-weight: bold; margin-bottom: 15px; color: #1a1a1a;">
                                        Dépannage Serrures
                                    </h3>
                                    <p style="color: #555; line-height: 1.6;">
                                        Intervention rapide pour tous types de serrures défectueuses ou bloquées.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div style="background-color: #f8f9fa; padding: 30px; border-radius: 10px; text-align: center; transition: all 0.3s ease; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                                    <i class="fa fa-key" style="font-size: 3rem; color: #dc3545; margin-bottom: 20px;"/>
                                    <h3 style="font-size: 1.5rem; font-weight: bold; margin-bottom: 15px; color: #1a1a1a;">
                                        Installation Serrures
                                    </h3>
                                    <p style="color: #555; line-height: 1.6;">
                                        Installation de serrures modernes et sécurisées pour votre domicile ou commerce.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div style="background-color: #f8f9fa; padding: 30px; border-radius: 10px; text-align: center; transition: all 0.3s ease; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                                    <i class="fa fa-unlock-alt" style="font-size: 3rem; color: #dc3545; margin-bottom: 20px;"/>
                                    <h3 style="font-size: 1.5rem; font-weight: bold; margin-bottom: 15px; color: #1a1a1a;">
                                        Ouverture Portes
                                    </h3>
                                    <p style="color: #555; line-height: 1.6;">
                                        Ouverture sécurisée de portes sans dégâts - Service d'urgence disponible.
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-4 mb-4">
                                <div style="background-color: #f8f9fa; padding: 30px; border-radius: 10px; text-align: center; transition: all 0.3s ease; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                                    <i class="fa fa-shield" style="font-size: 3rem; color: #dc3545; margin-bottom: 20px;"/>
                                    <h3 style="font-size: 1.5rem; font-weight: bold; margin-bottom: 15px; color: #1a1a1a;">
                                        Conseil Sécurité
                                    </h3>
                                    <p style="color: #555; line-height: 1.6;">
                                        Audit et conseil pour renforcer la sécurité de vos biens.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div style="background-color: #f8f9fa; padding: 30px; border-radius: 10px; text-align: center; transition: all 0.3s ease; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                                    <i class="fa fa-cogs" style="font-size: 3rem; color: #dc3545; margin-bottom: 20px;"/>
                                    <h3 style="font-size: 1.5rem; font-weight: bold; margin-bottom: 15px; color: #1a1a1a;">
                                        Maintenance
                                    </h3>
                                    <p style="color: #555; line-height: 1.6;">
                                        Maintenance régulière pour assurer la longévité de vos serrures.
                                    </p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div style="background-color: #f8f9fa; padding: 30px; border-radius: 10px; text-align: center; transition: all 0.3s ease; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                                    <i class="fa fa-phone" style="font-size: 3rem; color: #dc3545; margin-bottom: 20px;"/>
                                    <h3 style="font-size: 1.5rem; font-weight: bold; margin-bottom: 15px; color: #1a1a1a;">
                                        Support 24h/24
                                    </h3>
                                    <p style="color: #555; line-height: 1.6;">
                                        Urgence serrurerie : intervention rapide, jour et nuit.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- CTA Section -->
                <section class="serrupro-cta" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); color: white; padding: 60px 0; text-align: center;">
                    <div class="container">
                        <h2 style="font-size: 2.2rem; font-weight: bold; margin-bottom: 20px;">
                            Besoin d'une intervention urgente ?
                        </h2>
                        <p style="font-size: 1.2rem; margin-bottom: 30px;">
                            Nos experts sont prêts à vous aider immédiatement.
                        </p>
                        <div>
                            <a href="tel:+33123456789" class="btn btn-light btn-lg" style="padding: 12px 40px; font-weight: bold; color: #dc3545; margin-right: 15px;">
                                <i class="fa fa-phone"/> Appeler maintenant
                            </a>
                            <a href="#contact" class="btn btn-outline-light btn-lg" style="padding: 12px 40px; font-weight: bold;">
                                Demander un devis
                            </a>
                        </div>
                    </div>
                </section>

                <!-- Contact Section -->
                <section id="contact" class="serrupro-contact" style="padding: 60px 0; background-color: #f8f9fa;">
                    <div class="container">
                        <h2 style="text-align: center; font-size: 2.2rem; font-weight: bold; margin-bottom: 50px; color: #1a1a1a;">
                            Nous contacter
                        </h2>
                        <div class="row">
                            <div class="col-md-4 mb-4">
                                <div style="text-align: center;">
                                    <i class="fa fa-map-marker" style="font-size: 2rem; color: #dc3545; margin-bottom: 15px;"/>
                                    <h4 style="font-weight: bold; color: #1a1a1a; margin-bottom: 10px;">Adresse</h4>
                                    <p style="color: #555;">123 Rue de la Sécurité<br/>75000 Paris, France</p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div style="text-align: center;">
                                    <i class="fa fa-phone" style="font-size: 2rem; color: #dc3545; margin-bottom: 15px;"/>
                                    <h4 style="font-weight: bold; color: #1a1a1a; margin-bottom: 10px;">Téléphone</h4>
                                    <p style="color: #555;"><a href="tel:+33123456789" style="color: #dc3545; text-decoration: none;">+33 1 23 45 67 89</a><br/>Urgence 24h/24</p>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div style="text-align: center;">
                                    <i class="fa fa-envelope" style="font-size: 2rem; color: #dc3545; margin-bottom: 15px;"/>
                                    <h4 style="font-weight: bold; color: #1a1a1a; margin-bottom: 10px;">Email</h4>
                                    <p style="color: #555;"><a href="mailto:info@serrupro.fr" style="color: #dc3545; text-decoration: none;">info@serrupro.fr</a></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </template>

        <!-- SerruPro FAQ Page -->
        <template id="faq_page" name="FAQ SerruPro">
            <t t-call="website.layout">
                <section class="serrupro-faq" style="padding: 60px 0; background-color: #ffffff;">
                    <div class="container">
                        <div class="row mb-5">
                            <div class="col-12 text-center">
                                <h1 style="font-size: 2.8rem; font-weight: bold; margin-bottom: 20px;">FAQ SerruPro</h1>
                                <p style="font-size: 1.1rem; color: #555; max-width: 760px; margin: 0 auto;">
                                    Posez votre question et consultez les questions déjà publiées.
                                </p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div style="padding: 30px; border-radius: 12px; background: #f8f9fa; border: 1px solid #e9ecef;">
                                    <h2 style="font-size: 1.85rem; font-weight: bold; margin-bottom: 20px;">Posez une question</h2>
                                    <t t-if="error">
                                        <div style="margin-bottom: 20px; padding: 15px; border-radius: 8px; background: #f8d7da; color: #842029;">
                                            Merci de remplir tous les champs obligatoires.
                                        </div>
                                    </t>
                                    <t t-if="success">
                                        <div style="margin-bottom: 20px; padding: 15px; border-radius: 8px; background: #d1e7dd; color: #0f5132;">
                                            Votre question a bien été envoyée. Elle sera publiée après validation.
                                        </div>
                                    </t>
                                    <form method="post" action="/serrupro/faq/ask">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="mb-3">
                                            <label style="font-weight: 600;">Nom</label>
                                            <input type="text" name="name" class="form-control" required="required" placeholder="Votre nom"/>
                                        </div>
                                        <div class="mb-3">
                                            <label style="font-weight: 600;">Email</label>
                                            <input type="email" name="email" class="form-control" required="required" placeholder="votre@email.fr"/>
                                        </div>
                                        <div class="mb-3">
                                            <label style="font-weight: 600;">Question</label>
                                            <textarea name="question" class="form-control" rows="5" required="required" placeholder="Écrivez votre question ici..."></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-warning btn-lg" style="font-weight: bold;">Envoyer ma question</button>
                                    </form>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div style="padding: 30px; border-radius: 12px; background: #ffffff; border: 1px solid #e9ecef;">
                                    <h2 style="font-size: 1.85rem; font-weight: bold; margin-bottom: 20px;">Questions publiées</h2>
                                    <t t-if="faq_questions">
                                        <div class="accordion" id="faqAccordion">
                                            <t t-foreach="faq_questions" t-as="question" t-key="question.id">
                                                <div class="accordion-item" style="border: none; border-bottom: 1px solid #e9ecef;">
                                                    <h2 class="accordion-header" t-attf-id="heading{{question.id}}">
                                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" t-attf-data-bs-target="#collapse{{question.id}}" aria-expanded="false" t-attf-aria-controls="collapse{{question.id}}">
                                                            <t t-esc="question.name"/>
                                                        </button>
                                                    </h2>
                                                    <div t-attf-id="collapse{{question.id}}" class="accordion-collapse collapse" t-attf-aria-labelledby="heading{{question.id}}" data-bs-parent="#faqAccordion">
                                                        <div class="accordion-body" style="background: #f8f9fa;">
                                                            <t t-esc="question.answer or 'Réponse en cours de rédaction.'"/>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </t>
                                    <t t-if="not faq_questions">
                                        <p style="color: #555;">Aucune question publiée pour le moment. Posez la première question.</p>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </template>

        <!-- Page web qui relie le template a l'URL /homepage -->
        <record id="homepage_page" model="website.page">
            <field name="name">Homepage</field>
            <field name="url">/homepage</field>
            <field name="view_id" ref="homepage"/>
            <field name="is_published">True</field>
        </record>
        <record id="faq_page_website" model="website.page">
            <field name="name">FAQ SerruPro</field>
            <field name="url">/serrupro/faq</field>
            <field name="view_id" ref="faq_page"/>
            <field name="is_published">True</field>
        </record>
    </data>
</odoo>