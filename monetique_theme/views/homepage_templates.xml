<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="homepage" name="Accueil Exocoms Clone">
        <t t-call="website.layout">

            <!-- HERO -->
            <section class="exo-hero">
                <div class="exo-hero-overlay"></div>

                <div class="exo-container">
                    <div class="exo-hero-content">

                        <h1> Votre partenaire technologique <br /> au quotidien </h1>

                        <p>
                            Exocoms Group accompagne les particuliers et entreprises
                            avec des solutions complètes en informatique,
                            télécommunications, sécurité et infrastructures.
                        </p>

                    </div>
                </div>
            </section>

            <!-- SHOP PREVIEW -->
            <section class="exo-shop-home">

                <div class="exo-container">

                    <div class="exo-shop-layout">

                        <!-- SIDEBAR -->
                        <aside class="exo-sidebar">

                            <h2>Catégories</h2>

                            <ul>
                                <li>
                                    <a href="/shop">Tous les produits</a>
                                </li>
                                <li>
                                    <a href="/shop/category/monetique">Monétique</a>
                                </li>
                                <li>
                                    <a href="/shop/category/tpe-fixe">TPE Fixe</a>
                                </li>
                                <li>
                                    <a href="/shop/category/tpe-portable">TPE Portable</a>
                                </li>
                                <li>
                                    <a href="/shop/category/tpe-mobile">TPE Mobile</a>
                                </li>
                                <li>
                                    <a href="/shop/category/pinpad">PIN Pad</a>
                                </li>
                                <li>
                                    <a href="/shop/category/logiciels">Logiciels TPE</a>
                                </li>
                            </ul>

                        </aside>

                        <!-- PRODUITS -->
                        <div class="exo-products">

                            <div class="exo-section-title">
                                <h2>Tous les produits</h2>
                            </div>

                            <div class="exo-products-grid">

                                <t t-foreach="featured_products" t-as="product">

                                    <div class="exo-product-card">

                                        <a t-attf-href="/shop/{{ slug(product) }}">

                                            <div class="exo-product-image">

                                                <img
                                                    t-attf-src="/web/image/product.template/{{ product.id }}/image_512"
                                                    t-att-alt="product.name"
                                                />

                                            </div>

                                            <div class="exo-product-body">

                                                <h3 t-esc="product.name"></h3>

                                                <div class="exo-price">
                                                    <t
                                                        t-esc="'{:.2f}'.format(product.list_price).replace('.', ',')" />
                                                    € </div>

                                            </div>

                                        </a>

                                        <div class="exo-product-actions">
                                            <a
                                                t-attf-href="/shop/cart/update?product_id={{ product.product_variant_ids[0].id }}&amp;add_qty=1"
                                                class="exo-cart-btn"
                                            >
                                                Ajouter au panier
                                            </a>

                                        </div>

                                    </div>

                                </t>

                            </div>

                        </div>

                    </div>

                </div>

            </section>

            <!-- BEST SALES -->
            <section class="exo-carousel-section">

                <div class="exo-container">

                    <h2>Meilleures ventes</h2>

                    <div class="exo-carousel-grid">

                        <t t-foreach="featured_products" t-as="product">

                            <div class="exo-carousel-card">

                                <img
                                    t-attf-src="/web/image/product.template/{{ product.id }}/image_512"
                                    t-att-alt="product.name"
                                />

                                <h3 t-esc="product.name"></h3>

                                <div class="exo-price">
                                    <t t-esc="'{:.2f}'.format(product.list_price).replace('.', ',')" />
                                    € </div>

                            </div>

                        </t>

                    </div>

                </div>

            </section>

            <!-- SERVICES -->
            <section class="exo-services">

                <div class="exo-container">

                    <div class="exo-service-item">
                        <h3>Retours faciles</h3>
                        <p>
                            Retours pendant 30 jours avec remboursement rapide.
                        </p>
                    </div>

                    <div class="exo-service-item">
                        <h3>Expédition</h3>
                        <p>
                            Livraison rapide sur toutes les commandes.
                        </p>
                    </div>

                    <div class="exo-service-item">
                        <h3>Paiement sécurisé</h3>
                        <p>
                            Vos informations sont protégées.
                        </p>
                    </div>

                    <div class="exo-service-item">
                        <h3>Qualité garantie</h3>
                        <p>
                            Produits testés et certifiés.
                        </p>
                    </div>

                </div>

            </section>

        </t>
    </template>

</odoo>