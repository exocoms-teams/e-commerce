<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         HOMEPAGE — monetiques.fr
         Design conforme : bleu #0D47A1, Poppins, layout B2B pro
    ============================================================ -->

    <template id="homepage" name="Accueil Monétiques" page="True">
        <t t-call="website.layout">

            <!-- ── HERO ── -->
            <section class="mq-hero">
                <div class="mq-container">
                    <div class="mq-hero-content">
                        <span class="mq-hero-eyebrow">Solutions de paiement professionnel</span>
                        <h1 class="mq-hero-h1">
                            Solutions de paiement<br/>
                            <span>pour les professionnels</span>
                        </h1>
                        <p class="mq-hero-p">
                            Monétiques accompagne les commerçants avec des solutions
                            de paiement simples, sécurisées et performantes.
                        </p>
                        <div class="mq-hero-btns">
                            <a href="/solutions" class="mq-btn-primary">Découvrir nos solutions</a>
                            <a href="#" class="mq-btn-secondary" data-rappel-trigger="1">
                                Être rappelé
                            </a>
                        </div>
                        <div class="mq-hero-trust">
                            <div class="mq-hero-trust-item">
                                <i class="fa fa-shield"/> Paiement sécurisé
                            </div>
                            <div class="mq-hero-trust-item">
                                <i class="fa fa-certificate"/> Matériel certifié
                            </div>
                            <div class="mq-hero-trust-item">
                                <i class="fa fa-headphones"/> SAV 7j/7
                            </div>
                            <div class="mq-hero-trust-item">
                                <i class="fa fa-tag"/> Tarifs compétitifs
                            </div>
                        </div>
                    </div>

                    <!-- ZONE IMAGE HERO — à remplacer par votre visuel TPE -->
                    <div class="mq-hero-visual">
                        <div class="mq-hero-img-wrap">
                            <!--
                                INSTRUCTION : Remplacez ce bloc par votre image de terminal.
                                Exemple :
                                <img src="/monetique_theme/static/src/img/hero-tpe.png"
                                     alt="Terminal de paiement professionnel"/>
                            -->
                            <div class="mq-hero-img-placeholder">
                                <i class="fa fa-credit-card"/>
                                <span>Votre visuel terminal ici</span>
                            </div>
                        </div>
                        <span class="mq-hero-badge">Certifié PCI-DSS</span>
                    </div>
                </div>
            </section>

            <!-- ── FEATURE BAND ── -->
            <div class="mq-feat-band">
                <div class="mq-container">
                    <div class="mq-feat-item">
                        <div class="mq-feat-icon"><i class="fa fa-wrench"/></div>
                        <div>
                            <p class="mq-feat-title">Solutions adaptées à votre activité</p>
                            <p class="mq-feat-desc">TPE fixe, portable, mobile selon votre métier</p>
                        </div>
                    </div>
                    <div class="mq-feat-item">
                        <div class="mq-feat-icon"><i class="fa fa-cog"/></div>
                        <div>
                            <p class="mq-feat-title">Installation rapide et sans engagement</p>
                            <p class="mq-feat-desc">Mise en service sous 48h, configuration incluse</p>
                        </div>
                    </div>
                    <div class="mq-feat-item">
                        <div class="mq-feat-icon"><i class="fa fa-users"/></div>
                        <div>
                            <p class="mq-feat-title">Accompagnement personnalisé</p>
                            <p class="mq-feat-desc">Un expert dédié à votre écoute 7j/7</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── SOLUTIONS DE PAIEMENT ── -->
            <section class="mq-solutions-section">
                <div class="mq-container">
                    <div class="mq-section-head">
                        <span class="mq-section-tag">Nos solutions</span>
                        <h2 class="mq-section-title">Nos solutions de paiement</h2>
                        <div class="mq-section-underline"/>
                        <p class="mq-section-sub">Des solutions adaptées à chaque besoin</p>
                    </div>
                    <div class="mq-solutions-grid">

                        <!-- Card 1 : Terminaux -->
                        <a href="/solutions#terminaux" class="mq-sol-card">
                            <div class="mq-sol-img">
                                <!--
                                    INSTRUCTION : Remplacez par votre image.
                                    <img src="/monetique_theme/static/src/img/sol-terminaux.jpg"
                                         alt="Terminaux de paiement"/>
                                -->
                                <div class="mq-sol-img-placeholder">
                                    <i class="fa fa-credit-card"/>
                                    <span>Image terminaux</span>
                                </div>
                            </div>
                            <div class="mq-sol-body">
                                <h3 class="mq-sol-title">Terminaux de paiement</h3>
                                <p class="mq-sol-p">
                                    Des terminaux performants et fiables adaptés à tous les commerces.
                                </p>
                                <span class="mq-sol-link">
                                    En savoir plus <i class="fa fa-arrow-right"/>
                                </span>
                            </div>
                        </a>

                        <!-- Card 2 : Mobile -->
                        <a href="/solutions#mobile" class="mq-sol-card">
                            <div class="mq-sol-img">
                                <!--
                                    INSTRUCTION :
                                    <img src="/monetique_theme/static/src/img/sol-mobile.jpg"
                                         alt="Paiement mobile"/>
                                -->
                                <div class="mq-sol-img-placeholder">
                                    <i class="fa fa-mobile"/>
                                    <span>Image mobile</span>
                                </div>
                            </div>
                            <div class="mq-sol-body">
                                <h3 class="mq-sol-title">Paiement mobile</h3>
                                <p class="mq-sol-p">
                                    Acceptez les paiements partout avec nos solutions mobiles.
                                </p>
                                <span class="mq-sol-link">
                                    En savoir plus <i class="fa fa-arrow-right"/>
                                </span>
                            </div>
                        </a>

                        <!-- Card 3 : En ligne -->
                        <a href="/solutions#en-ligne" class="mq-sol-card">
                            <div class="mq-sol-img">
                                <!--
                                    INSTRUCTION :
                                    <img src="/monetique_theme/static/src/img/sol-enligne.jpg"
                                         alt="Paiement en ligne"/>
                                -->
                                <div class="mq-sol-img-placeholder">
                                    <i class="fa fa-shopping-cart"/>
                                    <span>Image e-commerce</span>
                                </div>
                            </div>
                            <div class="mq-sol-body">
                                <h3 class="mq-sol-title">Paiement en ligne</h3>
                                <p class="mq-sol-p">
                                    Solutions e-commerce sécurisées pour vos ventes en ligne.
                                </p>
                                <span class="mq-sol-link">
                                    En savoir plus <i class="fa fa-arrow-right"/>
                                </span>
                            </div>
                        </a>

                        <!-- Card 4 : Support -->
                        <a href="/solutions#support" class="mq-sol-card">
                            <div class="mq-sol-img">
                                <!--
                                    INSTRUCTION :
                                    <img src="/monetique_theme/static/src/img/sol-support.jpg"
                                         alt="Services et support"/>
                                -->
                                <div class="mq-sol-img-placeholder">
                                    <i class="fa fa-headphones"/>
                                    <span>Image support</span>
                                </div>
                            </div>
                            <div class="mq-sol-body">
                                <h3 class="mq-sol-title">Services &amp; support</h3>
                                <p class="mq-sol-p">
                                    Un service client dédié et un accompagnement sur-mesure.
                                </p>
                                <span class="mq-sol-link">
                                    En savoir plus <i class="fa fa-arrow-right"/>
                                </span>
                            </div>
                        </a>

                    </div>
                </div>
            </section>

            <!-- ── PRODUITS MIS EN AVANT (depuis Odoo shop) ── -->
            <t t-if="featured_products">
                <section class="mq-hp-products">
                    <div class="mq-container">
                        <div class="mq-section-head">
                            <span class="mq-section-tag">Catalogue</span>
                            <h2 class="mq-section-title">Nos terminaux de paiement</h2>
                            <div class="mq-section-underline"/>
                            <p class="mq-section-sub">
                                Découvrez notre gamme complète de terminaux
                            </p>
                        </div>
                        <div class="mq-hp-products-grid">
                            <t t-foreach="featured_products" t-as="product">
                                <a t-attf-href="/shop/{{ slug(product) }}"
                                   class="mq-hp-prod-card">
                                    <div class="mq-hp-prod-img">
                                        <t t-if="product.image_128">
                                            <img t-attf-src="/web/image/product.template/{{ product.id }}/image_512"
                                                 t-att-alt="product.name"
                                                 loading="lazy"/>
                                        </t>
                                        <t t-else="">
                                            <div class="mq-hp-prod-img-placeholder">
                                                <i class="fa fa-credit-card"/>
                                                <span>Photo produit</span>
                                            </div>
                                        </t>
                                    </div>
                                    <div class="mq-hp-prod-body">
                                        <h4 class="mq-hp-prod-name" t-esc="product.name"/>
                                        <div class="mq-hp-prod-price">
                                            <t t-esc="'{:.2f}'.format(product.list_price).replace('.', ',')"/> €
                                            <span>HT</span>
                                        </div>
                                    </div>
                                </a>
                            </t>
                        </div>
                        <div class="mq-hp-see-all">
                            <a href="/shop" class="mq-btn-primary">
                                Voir tous les produits <i class="fa fa-arrow-right"/>
                            </a>
                        </div>
                    </div>
                </section>
            </t>

            <!-- ── STATS ── -->
            <section class="mq-stats-section">
                <div class="mq-container">
                    <div class="mq-stats-grid">
                        <div class="mq-stat-card">
                            <span class="mq-stat-number">+10 000</span>
                            <span class="mq-stat-label">Commerçants équipés</span>
                        </div>
                        <div class="mq-stat-card">
                            <span class="mq-stat-number">+15</span>
                            <span class="mq-stat-label">Ans d'expérience</span>
                        </div>
                        <div class="mq-stat-card">
                            <span class="mq-stat-number">98%</span>
                            <span class="mq-stat-label">Clients satisfaits</span>
                        </div>
                        <div class="mq-stat-card">
                            <span class="mq-stat-number">7j/7</span>
                            <span class="mq-stat-label">Support disponible</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ── TRUST LOGOS ── -->
            <section class="mq-trust-section">
                <div class="mq-container">
                    <p class="mq-trust-title">Ils nous font confiance</p>
                    <div class="mq-trust-logos">
                        <!--
                            INSTRUCTION : Remplacez ces blocs par vos logos clients.
                            Exemple :
                            <img src="/monetique_theme/static/src/img/logo-brasserie.png"
                                 alt="Brasserie" style="height:40px"/>
                        -->
                        <div class="mq-trust-logo">BRASSERIE</div>
                        <div class="mq-trust-logo">L'ÉPICERIE</div>
                        <div class="mq-trust-logo">Beauty &amp; Co</div>
                        <div class="mq-trust-logo">LE BISTROT</div>
                        <div class="mq-trust-logo">Urban Food</div>
                        <div class="mq-trust-logo">PHARMACIE</div>
                        <div class="mq-trust-logo">Optique Premium</div>
                    </div>
                </div>
            </section>

            <!-- ── CTA BAND ── -->
            <div class="mq-cta-band">
                <div class="mq-container">
                    <div>
                        <h3>Besoin d'un conseil ?</h3>
                        <p>Nos experts vous accompagnent dans votre projet.</p>
                    </div>
                    <a href="#" class="mq-btn-white" data-rappel-trigger="1">
                        Être rappelé
                    </a>
                </div>
            </div>

        </t>
    </template>

</odoo>
