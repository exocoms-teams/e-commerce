<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="popular_products" name="Popular Products">

        <section class="sn-products">

            <div class="sn-container">

                <div class="sn-section-header">

                    <span class="sn-section-tag">
                        Popular Products
                    </span>

                    <h2 class="sn-section-title">
                        Best Sellers
                    </h2>

                    <p class="sn-section-subtitle">
                        Discover our most popular sneakers selected by our customers.
                    </p>

                </div>

                <div class="sn-products-grid">

                    <!-- Product 1 -->

                    <t t-call="monetique_theme.product_card">
                        <t t-set="product_name" t-value="'Nike Air Max 270'"/>
                        <t t-set="product_brand" t-value="'Nike'"/>
                        <t t-set="product_price" t-value="'179 €'"/>
                        <t t-set="product_old_price" t-value="'219 €'"/>
                        <t t-set="product_badge" t-value="'SALE'"/>
                        <t t-set="product_image" t-value="'/monetique_theme/static/src/img/products/product-1.jpg'"/>
                    </t>

                    <!-- Product 2 -->

                    <t t-call="monetique_theme.product_card">
                        <t t-set="product_name" t-value="'Adidas Ultraboost'"/>
                        <t t-set="product_brand" t-value="'Adidas'"/>
                        <t t-set="product_price" t-value="'199 €'"/>
                        <t t-set="product_old_price" t-value="'239 €'"/>
                        <t t-set="product_badge" t-value="'NEW'"/>
                        <t t-set="product_image" t-value="'/monetique_theme/static/src/img/products/product-2.jpg'"/>
                    </t>

                    <!-- Product 3 -->

                    <t t-call="monetique_theme.product_card">
                        <t t-set="product_name" t-value="'New Balance 550'"/>
                        <t t-set="product_brand" t-value="'New Balance'"/>
                        <t t-set="product_price" t-value="'159 €'"/>
                        <t t-set="product_old_price" t-value="'189 €'"/>
                        <t t-set="product_badge" t-value="'HOT'"/>
                        <t t-set="product_image" t-value="'/monetique_theme/static/src/img/products/product-3.jpg'"/>
                    </t>

                    <!-- Product 4 -->

                    <t t-call="monetique_theme.product_card">
                        <t t-set="product_name" t-value="'Puma RS-X'"/>
                        <t t-set="product_brand" t-value="'Puma'"/>
                        <t t-set="product_price" t-value="'149 €'"/>
                        <t t-set="product_old_price" t-value="'179 €'"/>
                        <t t-set="product_badge" t-value="'SALE'"/>
                        <t t-set="product_image" t-value="'/monetique_theme/static/src/img/products/product-4.jpg'"/>
                    </t>

                </div>

            </div>

        </section>

    </template>

</odoo>