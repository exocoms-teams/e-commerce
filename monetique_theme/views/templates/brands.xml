<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="brands" name="Brands">

        <section class="sn-brands">

            <div class="sn-container">

                <div class="sn-section-header">

                    <span class="sn-section-tag">
                        Our Brands
                    </span>

                    <h2 class="sn-section-title">
                        Top Brands
                    </h2>

                    <p class="sn-section-subtitle">
                        Discover sneakers from the world's most popular brands.
                    </p>

                </div>

                <div class="sn-brands-grid">

                    <a href="/shop" class="sn-brand-card">
                        <img src="/monetique_theme/static/src/img/brands/nike.png" alt="Nike"/>
                    </a>

                    <a href="/shop" class="sn-brand-card">
                        <img src="/monetique_theme/static/src/img/brands/adidas.png" alt="Adidas"/>
                    </a>

                    <a href="/shop" class="sn-brand-card">
                        <img src="/monetique_theme/static/src/img/brands/puma.png" alt="Puma"/>
                    </a>

                    <a href="/shop" class="sn-brand-card">
                        <img src="/monetique_theme/static/src/img/brands/newbalance.png" alt="New Balance"/>
                    </a>

                    <a href="/shop" class="sn-brand-card">
                        <img src="/monetique_theme/static/src/img/brands/converse.png" alt="Converse"/>
                    </a>

                    <a href="/shop" class="sn-brand-card">
                        <img src="/monetique_theme/static/src/img/brands/vans.png" alt="Vans"/>
                    </a>

                </div>

            </div>

        </section>

    </template>

</odoo>