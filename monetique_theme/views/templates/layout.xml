<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="layout" name="monetiques.fr Layout" inherit_id="website.layout" customize_show="False">

        <xpath expr="//head" position="inside">
            <style>
                /* Recherche - masquer icone et barre */
                .o_searchbar_form,
                .o_header_search_btn,
                button[data-bs-target="#o_search_modal"],
                #o_search_modal,
                .o_header_mobile_search { display: none !important; }

                /* Panier */
                .o_wsale_my_cart,
                a[href*="/shop/cart"] { display: none !important; }

                /* Telephone natif */
                .o_header_phone,
                .js_phone,
                a[href^="tel:"].o_phone { display: none !important; }

                /* Contact Us natif Odoo */
                .o_main_navbar a[href="/contactus"],
                .o_main_navbar li:has(> a[href="/contactus"]),
                a.btn[href="/contactus"],
                .o_main_navbar .btn[href="/contactus"] { display: none !important; }

                /* Shop */
                .o_main_navbar a[href="/shop"],
                .o_main_navbar li:has(> a[href="/shop"]) { display: none !important; }

                /* Extra menu + bouton */
                .o_extra_menu_items { display: none !important; }

                /* Sign in : masquer le texte "Sign in" et afficher "Espace Artisan" */
                a.o_sign_in,
                a[href="/web/login"],
                .o_sign_in_sign_up a {
                    background: var(--mn-blue) !important;
                    color: white !important;
                    padding: 7px 16px !important;
                    border-radius: 8px !important;
                    font-weight: 600 !important;
                    font-size: 13px !important;
                    font-family: 'Inter', sans-serif !important;
                    border: none !important;
                    text-decoration: none !important;
                    font-size: 0 !important;
                }
                a.o_sign_in::after,
                a[href="/web/login"]::after,
                .o_sign_in_sign_up a::after {
                    content: 'Espace Artisan';
                    font-size: 13px !important;
                }
                /* ════════════════════════════════════════════
                   NAVBAR — hover + page active colorée
                ════════════════════════════════════════════ */
                
                /* Base nav links */
                .o_main_navbar .nav-link,
                .o_main_navbar .navbar-nav .nav-link {
                    position: relative;
                    font-weight: 500;
                    font-size: 14px;
                    color: #374151 !important;
                    padding: 8px 4px !important;
                    transition: color .2s ease;
                }
                
                /* Ligne animée sous le lien */
                .o_main_navbar .nav-link::after,
                .o_main_navbar .navbar-nav .nav-link::after {
                    content: '';
                    position: absolute;
                    bottom: 0; left: 50%; right: 50%;
                    height: 2px;
                    border-radius: 2px;
                    transition: left .25s ease, right .25s ease, background-color .2s;
                }
                
                /* ── Hover générique : rouge ── */
                .o_main_navbar .nav-link:hover,
                .o_main_navbar .navbar-nav .nav-link:hover {
                    color: #C62828 !important;
                }
                .o_main_navbar .nav-link:hover::after,
                .o_main_navbar .navbar-nav .nav-link:hover::after {
                    left: 0; right: 0;
                    background: #C62828;
                }
                
                /* ── Page Accueil active ── */
                body.o_home_page .o_main_navbar a[href="/"],
                body[data-url="/"] .o_main_navbar a.nav-link[href="/"] {
                    color: #C62828 !important;
                    font-weight: 700;
                }
                body.o_home_page .o_main_navbar a[href="/"]::after,
                body[data-url="/"] .o_main_navbar a.nav-link[href="/"]::after {
                    left: 0; right: 0;
                    background: #C62828;
                }
                
                /* ── Page Assurances active : bleu ── */
                body[data-url^="/assurances"] .o_main_navbar a.nav-link[href="/assurances"],
                body[data-url^="/assurances"] .o_main_navbar a.nav-link[href*="assurances"] {
                    color: #1E40AF !important;
                    font-weight: 700;
                }
                body[data-url^="/assurances"] .o_main_navbar a.nav-link[href="/assurances"]::after,
                body[data-url^="/assurances"] .o_main_navbar a.nav-link[href*="assurances"]::after {
                    left: 0; right: 0;
                    background: #1E40AF;
                }
                body[data-url^="/assurances"] .o_main_navbar a.nav-link[href="/assurances"]:hover,
                body[data-url^="/assurances"] .o_main_navbar a.nav-link[href*="assurances"]:hover {
                    color: #1E3A8A !important;
                }
                
                /* ── Page Urgence active : rouge vif ── */
                body[data-url^="/urgence"] .o_main_navbar a.nav-link[href="/urgence"] {
                    color: #C62828 !important;
                    font-weight: 700;
                }
                body[data-url^="/urgence"] .o_main_navbar a.nav-link[href="/urgence"]::after {
                    left: 0; right: 0;
                    background: #C62828;
                }
                
                /* ── Nos Services active ── */
                body[data-url^="/nos-services"] .o_main_navbar a.nav-link[href="/nos-services"] {
                    color: #C62828 !important;
                    font-weight: 700;
                }
                body[data-url^="/nos-services"] .o_main_navbar a.nav-link[href="/nos-services"]::after {
                    left: 0; right: 0;
                    background: #C62828;
                }
                
                /* ── Demande active ── */
                body[data-url^="/demande-intervention"] .o_main_navbar a.nav-link[href="/demande-intervention"] {
                    color: #C62828 !important;
                    font-weight: 700;
                }
                body[data-url^="/demande-intervention"] .o_main_navbar a.nav-link[href="/demande-intervention"]::after {
                    left: 0; right: 0;
                    background: #C62828;
                }
                
                /* ── Contact active ── */
                body[data-url^="/contact"] .o_main_navbar a.nav-link[href="/contact"] {
                    color: #C62828 !important;
                    font-weight: 700;
                }
                body[data-url^="/contact"] .o_main_navbar a.nav-link[href="/contact"]::after {
                    left: 0; right: 0;
                    background: #C62828;
                }
                
                /* ── Fallback via JS (classe o_current_menu_item ajoutée par Odoo) ── */
                .o_main_navbar .o_current_menu_item > .nav-link,
                .o_main_navbar .nav-item.active > .nav-link {
                    color: #C62828 !important;
                    font-weight: 700;
                }
                .o_main_navbar .o_current_menu_item > .nav-link::after,
                .o_main_navbar .nav-item.active > .nav-link::after {
                    left: 0; right: 0;
                    background: #C62828;
                }
                
                /* Exception Assurances via o_current_menu_item */
                .o_main_navbar .o_current_menu_item > .nav-link[href="/assurances"],
                .o_main_navbar .nav-item.active > .nav-link[href="/assurances"] {
                    color: #1E40AF !important;
                }
                .o_main_navbar .o_current_menu_item > .nav-link[href="/assurances"]::after,
                .o_main_navbar .nav-item.active > .nav-link[href="/assurances"]::after {
                    background: #1E40AF;
                }
            </style>
        </xpath>

        <!-- Footer sinistres -->
        <xpath expr="//footer" position="replace">
            <t t-call="monetique_theme.footer"/>
        </xpath>

    </template>

