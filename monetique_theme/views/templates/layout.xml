<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- Layout principal du thème Sneakers                    -->
    <!-- Remplace le Header et le Footer d'Odoo                -->
    <!-- ===================================================== -->

    <template
        id="layout"
        inherit_id="website.layout"
        name="Sneakers Layout">

        <!-- ================= HEADER ================= -->

        <xpath expr="//header" position="replace">

            <t t-call="monetique_theme.header"/>

        </xpath>

        <!-- ================= FOOTER ================= -->

        <xpath expr="//footer" position="replace">

            <t t-call="monetique_theme.footer"/>

        </xpath>

    </template>

</odoo>