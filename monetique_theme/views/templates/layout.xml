<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="layout" name="monetiques.fr - Layout" inherit_id="website.layout" customize_show="False">
        <xpath expr="//footer" position="replace">
            <t t-call="monetique_theme.footer"/>
        </xpath>
    </template>

    <template id="footer" name="monetiques.fr - Footer">
        <footer class="pc-footer" role="contentinfo">
            <div class="pc-container">
                <div class="pc-footer__grid">
                    <div class="pc-footer__brand">
                        <a href="/" class="pc-footer__logo">
                            <span class="pc-logo__text">monetiques<span class="pc-logo__dot">.fr</span></span>
                        </a>
                        <p class="pc-footer__tagline">Infrastructure de paiement securisee depuis 2005.</p>
                        <div class="pc-footer__certs">
                            <span class="pc-cert-badge">PCI DSS</span>
                            <span class="pc-cert-badge">NF525</span>
                            <span class="pc-cert-badge">ISO 27001</span>
                        </div>
                    </div>
                    <div class="pc-footer__col">
                        <h3 class="pc-footer__heading">Solutions</h3>
                        <ul class="pc-footer__links">
                            <li><a href="/solutions/tpe">Terminaux TPE</a></li>
                            <li><a href="/solutions/encaissement">Encaissement</a></li>
                            <li><a href="/solutions/paiement-omnicanal">Paiement Omnicanal</a></li>
                            <li><a href="/services">Integration SI</a></li>
                        </ul>
                    </div>
                    <div class="pc-footer__col">
                        <h3 class="pc-footer__heading">Services</h3>
                        <ul class="pc-footer__links">
                            <li><a href="/support">Support 7j/7</a></li>
                            <li><a href="/support">Maintenance preventive</a></li>
                            <li><a href="/support">Interventions sur site</a></li>
                        </ul>
                    </div>
                    <div class="pc-footer__col">
                        <h3 class="pc-footer__heading">Entreprise</h3>
                        <ul class="pc-footer__links">
                            <li><a href="/a-propos">A propos</a></li>
                            <li><a href="/contact">Contact</a></li>
                            <li><a href="/recrutement">Recrutement</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="pc-footer__legal">
                <div class="pc-container">
                    <div class="pc-footer__legal-inner">
                        <p>&#169; 2025 monetiques.fr SAS. Tous droits reserves.</p>
                        <nav class="pc-footer__legal-links">
                            <a href="/mentions-legales">Mentions legales</a>
                            <a href="/confidentialite">Confidentialite</a>
                            <a href="/cgv">CGV</a>
                        </nav>
                    </div>
                </div>
            </div>
        </footer>
    </template>

</odoo>
