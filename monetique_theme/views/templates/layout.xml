<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="layout" name="monetiques.fr Layout" inherit_id="website.layout" customize_show="False">
        <xpath expr="//footer" position="replace">
            <t t-call="monetique_theme.footer"/>
        </xpath>
    </template>

    <template id="logo" name="monetiques.fr Logo" inherit_id="website.layout" customize_show="False">
        <xpath expr="//a[hasclass('navbar-brand')]" position="replace">
            <a href="/" class="navbar-brand" style="display:flex;align-items:center;padding:0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 44" fill="none" style="height:34px;width:auto">
                    <rect x="0" y="2" width="40" height="40" rx="10" fill="#1E40AF"/>
                    <text x="20" y="30" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,sans-serif" font-size="22" font-weight="900" fill="white">M</text>
                    <text x="50" y="30" font-family="-apple-system,BlinkMacSystemFont,sans-serif" font-size="19" font-weight="800" fill="#0F172A">monetiques</text>
                    <text x="162" y="30" font-family="-apple-system,BlinkMacSystemFont,sans-serif" font-size="19" font-weight="800" fill="#3B82F6">.fr</text>
                </svg>
            </a>
        </xpath>
    </template>

    <template id="footer" name="monetiques.fr Footer">
        <footer class="mn-footer">
            <div class="mn-footer__top">
                <div class="mn-container">
                    <div class="mn-footer__grid">
                        <div class="mn-footer__brand">
                            <a href="/" class="mn-footer__logo">monetiques<span style="color:#3B82F6">.fr</span></a>
                            <p>Infrastructure de paiement securisee pour les entreprises francaises depuis 2005.</p>
                            <div class="mn-footer__badges">
                                <span class="mn-badge">PCI DSS</span>
                                <span class="mn-badge">NF525</span>
                                <span class="mn-badge">ISO 27001</span>
                            </div>
                        </div>
                        <div class="mn-footer__col">
                            <h4>Solutions</h4>
                            <ul>
                                <li><a href="/shop">Boutique</a></li>
                                <li><a href="/solutions/tpe">Terminaux TPE</a></li>
                                <li><a href="/solutions/encaissement">Encaissement</a></li>
                            </ul>
                        </div>
                        <div class="mn-footer__col">
                            <h4>Services</h4>
                            <ul>
                                <li><a href="/support">Support 7j/7</a></li>
                                <li><a href="/support">Maintenance</a></li>
                            </ul>
                        </div>
                        <div class="mn-footer__col">
                            <h4>Entreprise</h4>
                            <ul>
                                <li><a href="/a-propos">A propos</a></li>
                                <li><a href="/emplois">Emplois</a></li>
                                <li><a href="/contact">Contact</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mn-footer__bottom">
                <div class="mn-container">
                    <p>&#169; 2025 monetiques.fr SAS. Tous droits reserves.</p>
                    <nav>
                        <a href="/mentions-legales">Mentions legales</a>
                        <a href="/confidentialite">Confidentialite</a>
                        <a href="/cgv">CGV</a>
                    </nav>
                </div>
            </div>
        </footer>
    </template>

</odoo>
