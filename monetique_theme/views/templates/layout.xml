<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="layout" name="monetiques.fr Layout" inherit_id="website.layout" customize_show="False">

        <xpath expr="//head" position="inside">
            <style>
                /* Navbar hover + page active */
                .o_main_navbar a.nav-link {
                    position: relative;
                    transition: color .2s;
                }
                .o_main_navbar a.nav-link::after {
                    content: '';
                    position: absolute;
                    bottom: -2px; left: 50%; right: 50%;
                    height: 2px;
                    background: #1E40AF;
                    border-radius: 2px;
                    transition: left .2s, right .2s;
                }
                .o_main_navbar a.nav-link:hover { color: #1E40AF !important; }
                .o_main_navbar a.nav-link:hover::after { left: 0; right: 0; }
                .o_main_navbar a.nav-link.active { color: #1E40AF !important; font-weight: 700 !important; }
                .o_main_navbar a.nav-link.active::after { left: 0 !important; right: 0 !important; }
                .o_main_navbar a.nav-link.active[href*="assurances"],
                .o_main_navbar a.nav-link:hover[href*="assurances"] { color: #C62828 !important; }
                .o_main_navbar a.nav-link.active[href*="assurances"]::after,
                .o_main_navbar a.nav-link:hover[href*="assurances"]::after { background: #C62828 !important; }

                /* Masquer elements inutiles */
                .o_searchbar_form,
                .o_header_search_btn,
                button[data-bs-target="#o_search_modal"],
                .o_wsale_my_cart,
                .o_wsale_my_wish,
                a.o_nav-link_secondary,
                a[href="/contactus"],
                a.btn_cta { display: none !important; }
            </style>
        </xpath>

        <xpath expr="//footer" position="replace">
            <t t-call="monetique_theme.footer"/>
        </xpath>

    </template>

