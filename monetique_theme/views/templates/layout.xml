<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layout" name="monetiques.fr Layout" inherit_id="website.layout" customize_show="False">
        <xpath expr="//footer" position="replace">
            <t t-call="monetique_theme.footer"/>
        </xpath>
        <xpath expr="//nav[hasclass('navbar')]" position="inside">
            <ul class="navbar-nav mn-mega-nav">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="/shop?category=1" data-bs-toggle="dropdown">Monetique</a>
                    <div class="dropdown-menu mn-mega-menu">
                        <div class="mn-mega-menu__grid">
                            <div class="mn-mega-menu__col">
                                <h6>TPE</h6>
                                <a href="/shop?search=TPE+Fixe" class="dropdown-item">TPE Fixe</a>
                                <a href="/shop?search=TPE+Mobile" class="dropdown-item">TPE Mobile</a>
                                <a href="/shop?search=TPE+Portable" class="dropdown-item">TPE Portable</a>
                            </div>
                            <div class="mn-mega-menu__col">
                                <h6>Solutions</h6>
                                <a href="/shop?search=Passerelle" class="dropdown-item">Passerelles</a>
                                <a href="/shop?search=Caisse" class="dropdown-item">Caisse Enregistreuse</a>
                                <a href="/shop?search=Logiciel" class="dropdown-item">Logiciels TPE</a>
                            </div>
                            <div class="mn-mega-menu__col">
                                <h6>Services</h6>
                                <a href="/shop?search=Maintenance" class="dropdown-item">Maintenance</a>
                                <a href="/shop?search=Installation" class="dropdown-item">Installation</a>
                                <a href="/shop?search=Assistance" class="dropdown-item">Assistance</a>
                            </div>
                        </div>
                    </div>
                </li>
            </ul>
        </xpath>
    </template>

    <template id="footer" name="monetiques.fr Footer">
        <footer class="mn-footer">
            <div class="mn-footer__top">
                <div class="mn-container">
                    <div class="mn-footer__grid">
                        <div class="mn-footer__brand">
                            <a href="/" class="mn-footer__logo">monetiques<span style="color:#3B82F6">.fr</span></a>
                            <p>Infrastructure de paiement securisee depuis 2005.</p>
                            <div class="mn-footer__badges">
                                <span class="mn-badge">PCI DSS</span>
                                <span class="mn-badge">NF525</span>
                                <span class="mn-badge">ISO 27001</span>
                            </div>
                        </div>
                        <div class="mn-footer__col">
                            <h4>Solutions</h4>
                            <ul>
                                <li><a href="/shop">Boutique</a></li>
                                <li><a href="/shop?search=TPE">Terminaux TPE</a></li>
                                <li><a href="/shop?search=Caisse">Encaissement</a></li>
                            </ul>
                        </div>
                        <div class="mn-footer__col">
                            <h4>Services</h4>
                            <ul>
                                <li><a href="/support">Support 7j/7</a></li>
                                <li><a href="/support">Maintenance</a></li>
                            </ul>
                        </div>
                        <div class="mn-footer__col">
                            <h4>Entreprise</h4>
                            <ul>
                                <li><a href="/a-propos">A propos</a></li>
                                <li><a href="/emplois">Emplois</a></li>
                                <li><a href="/contact">Contact</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mn-footer__bottom">
                <div class="mn-container">
                    <p>&#169; 2025 monetiques.fr SAS. Tous droits reserves.</p>
                    <nav>
                        <a href="/mentions-legales">Mentions legales</a>
                        <a href="/confidentialite">Confidentialite</a>
                        <a href="/cgv">CGV</a>
                    </nav>
                </div>
            </div>
        </footer>
    </template>
</odoo>
