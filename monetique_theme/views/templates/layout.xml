<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template
        id="layout"
        inherit_id="website.layout"
        name="Exocoms Layout">

        <xpath expr="//header" position="replace">

            <t t-call="monetique_theme.header"/>

        </xpath>

        <xpath expr="//footer" position="replace">

            <t t-call="monetique_theme.footer"/>

        </xpath>

    </template>

</odoo>
