<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="layout" name="monetiques.fr Layout" inherit_id="website.layout" customize_show="False">
    <xpath expr="//footer" position="replace">
      <t t-call="monetique_theme.footer"/>
    </xpath>
  </template>

  <template id="footer" name="monetiques.fr Footer">
    <footer class="mn-footer">
      <div class="mn-footer__top">
        <div class="mn-container">
          <div class="mn-footer__grid">
            <div class="mn-footer__brand">
              <a href="/" class="mn-footer__logo">monetiques<span>.fr</span></a>
              <p>Infrastructure de paiement sécurisée depuis 2005. Nous accompagnons commerçants et entreprises dans leur transition vers le paiement électronique.</p>
              <div class="mn-footer__badges">
                <span class="mn-badge">PCI DSS</span>
                <span class="mn-badge">NF525</span>
                <span class="mn-badge">ISO 27001</span>
              </div>
            </div>
            <div class="mn-footer__col">
              <h4>Solutions</h4>
              <ul>
                <li><a href="/shop">Boutique</a></li>
                <li><a href="/shop">Terminaux TPE</a></li>
                <li><a href="/shop">Accessoires</a></li>
                <li><a href="/shop">Services</a></li>
              </ul>
            </div>
            <div class="mn-footer__col">
              <h4>Services</h4>
              <ul>
                <li><a href="/audit">Audit gratuit</a></li>
                <li><a href="/contactus">Support 7j/7</a></li>
                <li><a href="/contactus">Maintenance</a></li>
                <li><a href="/contactus">Installation</a></li>
              </ul>
            </div>
            <div class="mn-footer__col">
              <h4>Entreprise</h4>
              <ul>
                <li><a href="/contactus">À propos</a></li>
                <li><a href="/contactus">Contact</a></li>
                <li><a href="/contactus">Emplois</a></li>
                <li><a href="/contactus">Actualités</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
      <div class="mn-footer__bottom">
        <div class="mn-container">
          <p>© 2025 monetiques.fr SAS. Tous droits réservés.</p>
          <nav>
            <a href="/contactus">Mentions légales</a>
            <a href="/contactus">Confidentialité</a>
            <a href="/contactus">CGV</a>
          </nav>
        </div>
      </div>
    </footer>
  </template>

</odoo>
