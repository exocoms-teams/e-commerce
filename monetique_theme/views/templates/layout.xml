<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="layout" name="monetiques.fr Layout" inherit_id="website.layout" customize_show="False">
        <!-- Remplacement du Header -->
        <xpath expr="//header" position="replace">
            <header class="mn-header">
                <div class="mn-header-container">
                    <!-- Logo -->
                    <a href="/" class="mn-logo">monetiques<span class="mn-logo-dot">.fr</span></a>
                    
                    <!-- Navigation principale -->
                    <nav class="mn-nav">
                        <a href="/" t-attf-class="mn-nav-link #{'active' if request.httprequest.path == '/' else ''}">Home</a>
                        <a href="/shop" t-attf-class="mn-nav-link #{'active' if request.httprequest.path.startswith('/shop') else ''}">Shop</a>
                        <a href="/services" t-attf-class="mn-nav-link #{'active' if request.httprequest.path == '/services' else ''}">Services</a>
                        <a href="/contactus" t-attf-class="mn-nav-link #{'active' if request.httprequest.path == '/contactus' else ''}">Contact</a>
                    </nav>

                    <!-- Actions à droite (Panier, Connexion / Profil utilisateur) -->
                    <div class="mn-actions">
                        <a href="/shop/cart" class="mn-cart-icon" title="Panier">
                            <i class="fa fa-shopping-cart"></i>
                        </a>

                        <!-- Si l'utilisateur est déconnecté -->
                        <t t-if="request.env.user._is_public()">
                            <a href="/web/login" class="mn-btn-login">Connexion</a>
                        </t>

                        <!-- Si l'utilisateur est connecté -->
                        <t t-else="">
                            <div class="mn-user-dropdown">
                                <a href="/my#" class="mn-user-toggle" title="Mon compte">
                                    <i class="fa fa-user-circle"></i>
                                    <span class="mn-user-name"><t t-esc="request.env.user.name"/></span>
                                    <i class="fa fa-angle-down mn-dropdown-arrow"></i>
                                </a>
                                <div class="mn-dropdown-menu">
                                    <a href="/my/home" class="mn-dropdown-item">
                                        <i class="fa fa-id-card-o"></i> My Account
                                    </a>
                                    <div class="mn-dropdown-divider"></div>
                                    <a href="/web/session/logout" class="mn-dropdown-item mn-logout">
                                        <i class="fa fa-sign-out"></i> Logout
                                    </a>
                                </div>
                            </div>
                        </t>
                        
                        <!-- Bouton Burger Mobile -->
                        <button class="mn-burger-btn" aria-label="Menu mobile" onclick="document.querySelector('.mn-mobile-drawer').classList.toggle('is-open')">
                            <span></span>
                            <span></span>
                            <span></span>
                        </button>
                    </div>
                </div>

                <!-- Tiroir de Navigation Mobile -->
                <div class="mn-mobile-drawer">
                    <div class="mn-mobile-drawer-content">
                        <a href="/" class="mn-mobile-link">Home</a>
                        <a href="/shop" class="mn-mobile-link">Shop</a>
                        <a href="/services" class="mn-mobile-link">Services</a>
                        <a href="/contactus" class="mn-mobile-link">Contact</a>
                        
                        <t t-if="request.env.user._is_public()">
                            <a href="/web/login" class="mn-mobile-link mn-mobile-login">Connexion</a>
                        </t>
                        <t t-else="">
                            <a href="/my/home" class="mn-mobile-link">My Account</a>
                            <a href="/web/session/logout" class="mn-mobile-link mn-mobile-logout">Logout</a>
                        </t>
                    </div>
                </div>
            </header>
        </xpath>

        <!-- Remplacement du Footer Optimisé -->
        <xpath expr="//footer" position="replace">
            <footer class="mn-footer">
                <div class="mn-footer__top">
                    <div class="mn-container">
                        <div class="mn-footer__grid">
                            <!-- Colonne Marque & Confiance -->
                            <div class="mn-footer__brand">
                                <a href="/" class="mn-footer__logo">monetiques<span style="color:#3B82F6">.fr</span></a>
                                <p>Infrastructure de paiement sécurisée depuis 2005.</p>
                                <div class="mn-footer__trust-section">
                                    <h5 class="mn-footer__trust-title">Certifications de sécurité</h5>
                                    <div class="mn-footer__badges">
                                        <span class="mn-badge"><i class="fa fa-shield"></i> PCI DSS</span>
                                        <span class="mn-badge"><i class="fa fa-check-circle"></i> NF525</span>
                                        <span class="mn-badge"><i class="fa fa-lock"></i> ISO 27001</span>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Colonne Solutions -->
                            <div class="mn-footer__col">
                                <h4>Solutions</h4>
                                <ul>
                                    <li><a href="/shop">Boutique</a></li>
                                    <li><a href="/solutions/tpe">Terminaux TPE</a></li>
                                    <li><a href="/solutions/encaissement">Encaissement</a></li>
                                </ul>
                            </div>

                            <!-- Colonne Services -->
                            <div class="mn-footer__col">
                                <h4>Services</h4>
                                <ul>
                                    <li><a href="/services">Nos services</a></li>
                                    <li><a href="/services">Support 7j/7</a></li>
                                    <li><a href="/services">Maintenance</a></li>
                                </ul>
                            </div>

                            <!-- Colonne Entreprise -->
                            <div class="mn-footer__col">
                                <h4>Entreprise</h4>
                                <ul>
                                    <li><a href="/a-propos">À propos</a></li>
                                    <li><a href="/emplois">Emplois</a></li>
                                    <li><a href="/contactus">Contact</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bas du Footer -->
                <div class="mn-footer__bottom">
                    <div class="mn-container">
                        <p>&#169; 2025 monetiques.fr SAS. Tous droits réservés.</p>
                        <nav class="mn-footer__legal-nav">
                            <a href="/mentions-legales">Mentions légales</a>
                            <a href="/confidentialite">Confidentialité</a>
                            <a href="/cgv">CGV</a>
                        </nav>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>

</odoo>
