<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         LAYOUT PRINCIPAL PAYCORE
         Hérite de website.layout et override les blocs clés
         ================================================================ -->

    <template id="layout" name="monetiques.fr - Layout Principal" inherit_id="website.layout">

        <!-- Override head : fonts + meta premium -->
        <xpath expr="//head" position="inside">
            <!-- Fonts premium : Geist (display) + DM Sans (body) -->
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link rel="stylesheet"
                  href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&amp;family=DM+Mono:wght@400;500&amp;display=swap"/>

            <!-- Meta dynamiques -->
            <meta name="description" t-att-content="meta_description or 'monetiques.fr - Infrastructure de paiement moderne'"/>
            <meta property="og:title" t-att-content="og_title or page_title or 'monetiques.fr'"/>
            <meta property="og:description" t-att-content="og_description or meta_description or ''"/>
            <meta property="og:type" content="website"/>
            <meta property="og:image" content="/paycore_website/static/src/img/og-paycore.png"/>
            <meta name="twitter:card" content="summary_large_image"/>
            <meta name="theme-color" content="#0A0F1E"/>

            <!-- Favicon -->
            <link rel="icon" type="image/svg+xml" href="/paycore_website/static/src/img/favicon.svg"/>
            <link rel="apple-touch-icon" href="/paycore_website/static/src/img/apple-touch-icon.png"/>
        </xpath>

        <!-- Override title -->
        <xpath expr="//title" position="replace">
            <title t-esc="page_title or 'monetiques.fr - Infrastructure de Paiement'"/>
        </xpath>

        <!-- Supprimer la navbar Odoo par défaut -->
        <xpath expr="//header" position="replace">
            <t t-call="paycore_website.navbar"/>
        </xpath>

        <!-- Supprimer le footer Odoo par défaut et injecter le nôtre -->
        <xpath expr="//footer" position="replace">
            <t t-call="paycore_website.footer"/>
        </xpath>

    </template>


    <!-- ================================================================
         HEADER STYLE HP - MONETIQUES.FR
         Inspiré hp.com/fr-fr : fond blanc pur, nav horizontale sobre,
         icônes utilitaires à droite, breadcrumb séparé en dessous
         ================================================================ -->

    <template id="navbar" name="monetiques.fr - Header HP Style">
        <header class="pc-header" id="pc-header" role="banner">

            <!-- ═══ BARRE PRINCIPALE ═══ -->
            <div class="pc-header__main">
                <div class="pc-header__inner">

                    <!-- Burger gauche (mobile) + hamburger desktop style HP -->
                    <button class="pc-header__burger" id="pc-burger"
                            aria-label="Menu" aria-expanded="false" aria-controls="pc-mobile-menu">
                        <span></span><span></span><span></span>
                    </button>

                    <!-- Logo rond bleu style HP -->
                    <a href="/" class="pc-header__logo" aria-label="monetiques.fr - Accueil">
                        <div class="pc-header__logo-mark" aria-hidden="true">
                            <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
                                <circle cx="18" cy="18" r="18" fill="#0096D6"/>
                                <!-- Lettre M stylisée -->
                                <path d="M9 26V10l5 8 4-6 4 6 5-8v16" stroke="white" stroke-width="2.2"
                                      stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                            </svg>
                        </div>
                        <span class="pc-header__logo-text">monetiques<span>.fr</span></span>
                    </a>

                    <!-- Navigation principale style HP - liens simples, sobre -->
                    <nav class="pc-header__nav" role="navigation" aria-label="Navigation principale">
                        <ul class="pc-header__menu" role="list">

                            <li class="pc-header__item">
                                <a href="/solutions/tpe" class="pc-header__link">TPE &amp; Terminaux</a>
                            </li>
                            <li class="pc-header__item">
                                <a href="/solutions/encaissement" class="pc-header__link">Encaissement</a>
                            </li>
                            <li class="pc-header__item">
                                <a href="/solutions/paiement-omnicanal" class="pc-header__link">Paiement omnicanal</a>
                            </li>
                            <li class="pc-header__item">
                                <a href="/services" class="pc-header__link">Services</a>
                            </li>
                            <li class="pc-header__item">
                                <a href="/support" class="pc-header__link">Support</a>
                            </li>
                            <li class="pc-header__item">
                                <a href="/a-propos" class="pc-header__link">À propos</a>
                            </li>

                        </ul>
                    </nav>

                    <!-- Icônes utilitaires droite - style HP : recherche, téléphone, compte, devis -->
                    <div class="pc-header__utils">
                        <!-- Recherche -->
                        <button class="pc-header__util-btn" aria-label="Rechercher">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                                <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/>
                                <path d="M13 13l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                        </button>
                        <!-- Téléphone -->
                        <a href="tel:+33XXXXXXXXX" class="pc-header__util-btn" aria-label="Nous appeler">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                                <path d="M3 4.5A1.5 1.5 0 014.5 3h.879a1 1 0 01.95.684l.813 2.437a1 1 0 01-.275 1.06l-.813.676a9 9 0 004.072 4.072l.676-.813a1 1 0 011.06-.275l2.437.813A1 1 0 0115 12.622V13.5A1.5 1.5 0 0113.5 15C7.701 15 3 10.299 3 4.5z" stroke="currentColor" stroke-width="1.5"/>
                            </svg>
                        </a>
                        <!-- Compte client -->
                        <a href="/web#action=login" class="pc-header__util-btn" aria-label="Espace client">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                                <circle cx="10" cy="7" r="3.5" stroke="currentColor" stroke-width="1.5"/>
                                <path d="M3 17c0-3.314 3.134-6 7-6s7 2.686 7 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                        </a>
                        <!-- CTA devis - seul élément coloré, style HP -->
                        <a href="/contact" class="pc-header__cta">Demander un devis</a>
                    </div>

                </div>
            </div>

            <!-- ═══ BREADCRUMB (affiché sur pages internes via t-if) ═══ -->
            <t t-if="breadcrumb_items">
                <div class="pc-header__breadcrumb">
                    <div class="pc-header__inner">
                        <nav aria-label="Fil d'Ariane">
                            <ol class="pc-breadcrumb__list" role="list">
                                <li><a href="/">Page d'accueil</a></li>
                                <t t-foreach="breadcrumb_items" t-as="item">
                                    <li aria-hidden="true">/</li>
                                    <li>
                                        <t t-if="item_last">
                                            <strong t-esc="item.name"/>
                                        </t>
                                        <t t-else="">
                                            <a t-att-href="item.url" t-esc="item.name"/>
                                        </t>
                                    </li>
                                </t>
                            </ol>
                        </nav>
                    </div>
                </div>
            </t>

            <!-- ═══ MENU MOBILE ═══ -->
            <div class="pc-header__mobile" id="pc-mobile-menu" aria-hidden="true" role="dialog" aria-label="Menu">
                <div class="pc-header__mobile-inner">
                    <a href="/solutions/tpe" class="pc-header__mobile-link">TPE &amp; Terminaux</a>
                    <a href="/solutions/encaissement" class="pc-header__mobile-link">Encaissement</a>
                    <a href="/solutions/paiement-omnicanal" class="pc-header__mobile-link">Paiement omnicanal</a>
                    <a href="/services" class="pc-header__mobile-link">Services</a>
                    <a href="/support" class="pc-header__mobile-link">Support</a>
                    <a href="/a-propos" class="pc-header__mobile-link">À propos</a>
                    <div class="pc-header__mobile-sep"></div>
                    <a href="/contact" class="pc-header__mobile-cta">Demander un devis</a>
                </div>
            </div>

        </header>
    </template>


    <!-- ================================================================
         FOOTER ENTERPRISE
         ================================================================ -->

    <template id="footer" name="monetiques.fr - Footer">
        <footer class="pc-footer" role="contentinfo">

            <!-- Bande supérieure : CTA -->
            <div class="pc-footer__cta">
                <div class="pc-container">
                    <div class="pc-footer__cta-inner">
                        <div class="pc-footer__cta-text">
                            <h2 class="pc-footer__cta-title">Prêt à moderniser votre infrastructure de paiement ?</h2>
                            <p>Nos experts vous accompagnent de l'audit à la mise en production.</p>
                        </div>
                        <div class="pc-footer__cta-actions">
                            <a href="/contact" class="pc-btn pc-btn--white">Parler à un expert</a>
                            <a href="tel:+33XXXXXXXXX" class="pc-footer__phone">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                    <path d="M2.5 3A1.5 1.5 0 014 1.5h.382a1 1 0 01.95.684l.688 2.063a1 1 0 01-.275 1.06l-.7.616a8 8 0 003.532 3.532l.617-.7a1 1 0 011.06-.275l2.063.688A1 1 0 0113 9.618V10a1.5 1.5 0 01-1.5 1.5C5.753 11.5 1 6.747 1 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                                </svg>
                                +33 (0)X XX XX XX XX
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Corps du footer -->
            <div class="pc-footer__body">
                <div class="pc-container">
                    <div class="pc-footer__grid">

                        <!-- Colonne marque -->
                        <div class="pc-footer__brand">
                            <a href="/" class="pc-footer__logo" aria-label="monetiques.fr">
                                <svg width="120" height="28" viewBox="0 0 140 32" fill="none">
                                    <rect width="32" height="32" rx="8" fill="#2563EB"/>
                                    <path d="M18 6L10 18H16L14 26L22 14H16L18 6Z" fill="white"/>
                                    <text x="40" y="22" font-family="DM Sans, sans-serif" font-size="16" font-weight="600" fill="white" letter-spacing="-0.3">monetiques.fr</text>
                                </svg>
                            </a>
                            <p class="pc-footer__brand-desc">
                                Infrastructure de paiement sécurisée pour les entreprises françaises. Monétique, TPE, encaissement et support technique depuis 2005.
                            </p>
                            <div class="pc-footer__certifications">
                                <span class="pc-footer__cert">PCI DSS</span>
                                <span class="pc-footer__cert">NF525</span>
                                <span class="pc-footer__cert">ISO 27001</span>
                            </div>
                        </div>

                        <!-- Colonne Solutions -->
                        <div class="pc-footer__col">
                            <h3 class="pc-footer__col-title">Solutions</h3>
                            <ul class="pc-footer__links" role="list">
                                <li><a href="/solutions/tpe">Terminaux TPE</a></li>
                                <li><a href="/solutions/encaissement">Encaissement</a></li>
                                <li><a href="/solutions/paiement-omnicanal">Paiement Omnicanal</a></li>
                                <li><a href="/services">Intégration SI</a></li>
                            </ul>
                        </div>

                        <!-- Colonne Services -->
                        <div class="pc-footer__col">
                            <h3 class="pc-footer__col-title">Services</h3>
                            <ul class="pc-footer__links" role="list">
                                <li><a href="/support">Support 7j/7</a></li>
                                <li><a href="/support#maintenance">Maintenance préventive</a></li>
                                <li><a href="/support#intervention">Interventions sur site</a></li>
                                <li><a href="/support#hotline">Hotline technique</a></li>
                            </ul>
                        </div>

                        <!-- Colonne Entreprise -->
                        <div class="pc-footer__col">
                            <h3 class="pc-footer__col-title">Entreprise</h3>
                            <ul class="pc-footer__links" role="list">
                                <li><a href="/a-propos">À propos</a></li>
                                <li><a href="/a-propos#equipe">Notre équipe</a></li>
                                <li><a href="/contact">Contact</a></li>
                                <li><a href="/recrutement">Recrutement</a></li>
                            </ul>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Bande légale -->
            <div class="pc-footer__legal">
                <div class="pc-container">
                    <div class="pc-footer__legal-inner">
                        <p>© <span id="pc-year">2024</span> monetiques.fr SAS. Tous droits réservés.</p>
                        <nav class="pc-footer__legal-links" aria-label="Liens légaux">
                            <a href="/mentions-legales">Mentions légales</a>
                            <a href="/confidentialite">Confidentialité</a>
                            <a href="/cgv">CGV</a>
                        </nav>
                    </div>
                </div>
            </div>

        </footer>
    </template>

</odoo>
