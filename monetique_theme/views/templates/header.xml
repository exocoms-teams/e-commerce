<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_header" name="Custom Header" inherit_id="website.layout" primary="True">
        <xpath expr="//head" position="inside">
            <!-- Header CSS already loaded via assets -->
        </xpath>
        <!-- Force le logo Monetiques.fr en dur (indépendant du logo uploadé en base via l'éditeur) -->
        <xpath expr="//a[hasclass('navbar-brand')]//img" position="attributes">
            <attribute name="src">/monetique_theme/static/src/img/logo_monetiques.png</attribute>
            <attribute name="alt">Monetiques.fr</attribute>
        </xpath>
    </template>
</odoo>
