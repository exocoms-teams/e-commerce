<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="header" name="Sneakers Header">

        <header class="sn-header">

            <!-- ===================== TOP BAR ===================== -->

            <div class="sn-topbar">

                <div class="container">

                    <!-- Logo -->

                    <a href="/" class="sn-logo">

                        <span>SNEAK</span>HUB

                    </a>

                    <!-- Right Side -->

                    <div class="sn-topbar-right">

                        <!-- Language -->

                        <div class="sn-language">

                            <button class="sn-language-btn">

                                🌐 EN

                                <i class="fa fa-angle-down"/>

                            </button>

                            <ul class="sn-language-dropdown">

                                <li><a href="#">English</a></li>

                                <li><a href="#">العربية</a></li>

                            </ul>

                        </div>

                        <!-- Wishlist -->

                        <a href="#" class="sn-header-icon">

                            <i class="fa fa-heart-o"/>

                        </a>

                        <!-- Cart -->

                        <a href="/shop/cart" class="sn-header-icon">

                            <i class="fa fa-shopping-bag"/>

                            <span class="sn-cart-badge">

                                0

                            </span>

                        </a>

                    </div>

                </div>

            </div>

            <!-- Search -->

            <t t-call="monetique_theme.search_bar"/>

            <!-- Navigation -->

            <nav class="sn-navbar">

                <div class="container">

                    <ul class="sn-menu">

                        <li><a href="/">Home</a></li>

                        <li><a href="/shop">Shop</a></li>

                        <li><a href="#">Brands</a></li>

                        <li><a href="#">New Arrivals</a></li>

                        <li><a href="#">Sale</a></li>

                        <li><a href="/contact">Contact</a></li>

                    </ul>

                </div>

            </nav>

        </header>

    </template>

</odoo>