<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_header" name="Custom Header" inherit_id="website.layout" primary="True">
        <xpath expr="//head" position="inside">
            <!-- Header CSS already loaded via assets -->
        </xpath>
        <!-- Force le logo Monetiques.fr en dur (indépendant du logo uploadé en base via l'éditeur) -->
        <xpath expr="//a[hasclass('navbar-brand')]" position="replace">
            <a data-name="Navbar Logo" href="/" class="navbar-brand logo me-4">
                <img src="/monetique_theme/static/src/img/logo_monetiques.png" class="img img-fluid" alt="Monetiques.fr" loading="lazy"/>
            </a>
        </xpath>
    </template>
</odoo>
