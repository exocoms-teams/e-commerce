<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="header" name="Sneakers Header">

        <header>

            <!-- ================= TOP BAR ================= -->

            <div class="sn-topbar">

                <div class="mn-container">

                    <div class="sn-topbar-left">
                        <span>🚚 Free shipping on orders over $100</span>
                    </div>

                    <div class="sn-topbar-center">
                        <span>🔥 Summer Sale - Up to 50% OFF</span>
                    </div>

                    <div class="sn-topbar-right">

                        <select class="sn-language-switcher">

                            <option value="en">English</option>

                            <option value="ar">العربية</option>

                        </select>

                    </div>

                </div>

            </div>

            <!-- ================= MAIN HEADER ================= -->

            <div class="sn-header">

                <div class="mn-container">

                    <!-- Logo -->

                    <div class="sn-logo">

                        <a href="/">

                            <span class="sn-logo-icon">👟</span>

                            <div>

                                <h2>SNEAKERS</h2>

                                <small>Premium Footwear</small>

                            </div>

                        </a>

                    </div>

                    <!-- Navigation -->

                    <nav class="sn-nav">

                        <ul>

                            <li><a href="/">Home</a></li>

                            <li><a href="/shop">Shop</a></li>

                            <li><a href="#">Men</a></li>

                            <li><a href="#">Women</a></li>

                            <li><a href="#">Sports</a></li>

                            <li><a href="#">New Arrivals</a></li>

                            <li><a href="#">Sale</a></li>

                        </ul>

                    </nav>

                    <!-- Right Side -->

                    <div class="sn-actions">

                        <!-- Search -->

                        <div class="sn-search">

                            <input
                                type="text"
                                placeholder="Search sneakers..."/>

                            <button type="button">

                                <i class="fa fa-search"></i>

                            </button>

                        </div>

                        <!-- Wishlist -->

                        <a href="#" class="sn-icon">

                            <i class="fa fa-heart"></i>

                        </a>

                        <!-- Cart -->

                        <a href="/shop/cart" class="sn-icon">

                            <i class="fa fa-shopping-cart"></i>

                            <span class="sn-cart-count">0</span>

                        </a>

                    </div>

                </div>

            </div>

        </header>

    </template>

</odoo>