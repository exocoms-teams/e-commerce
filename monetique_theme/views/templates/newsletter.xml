<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="newsletter" name="Newsletter">

        <section class="sn-newsletter">

            <div class="sn-container">

                <div class="sn-newsletter-box">

                    <div class="sn-newsletter-content">

                        <span class="sn-section-tag">
                            Newsletter
                        </span>

                        <h2>
                            Stay Updated
                        </h2>

                        <p>
                            Subscribe to receive exclusive offers, new arrivals and sneaker news.
                        </p>

                    </div>

                    <form class="sn-newsletter-form">

                        <input
                            type="email"
                            placeholder="Enter your email address"
                            required="required"/>

                        <button type="submit">

                            Subscribe

                        </button>

                    </form>

                </div>

            </div>

        </section>

    </template>

</odoo>