<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="stats_section" name="monetiques.fr Stats">
        <section class="mn-stats">
            <div class="mn-container">
                <div class="mn-stats__grid">
                    <div class="mn-stat">
                        <span class="mn-stat__number">1 000+</span>
                        <span class="mn-stat__label">Voyageurs satisfaits</span>
                    </div>
                    <div class="mn-stat">
                        <span class="mn-stat__number">50+</span>
                        <span class="mn-stat__label">Destinations</span>
                    </div>
                    <div class="mn-stat">
                        <span class="mn-stat__number">4.8/5</span>
                        <span class="mn-stat__label">Satisfaction client</span>
                    </div>
                    <div class="mn-stat">
                        <span class="mn-stat__number">10 ans</span>
                        <span class="mn-stat__label">Experience</span>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
