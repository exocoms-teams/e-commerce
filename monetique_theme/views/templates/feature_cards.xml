<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="feature_cards" name="Feature Cards">

        <section class="sn-features">

            <div class="sn-container">

                <div class="sn-features-grid">

                    <!-- Livraison -->

                    <div class="sn-feature-card">

                        <div class="sn-feature-icon">
                            <i class="fa fa-truck"/>
                        </div>

                        <h3>Free Shipping</h3>

                        <p>
                            Free delivery on all orders over €100.
                        </p>

                    </div>

                    <!-- Paiement -->

                    <div class="sn-feature-card">

                        <div class="sn-feature-icon">
                            <i class="fa fa-credit-card"/>
                        </div>

                        <h3>Secure Payment</h3>

                        <p>
                            100% secure payments with trusted gateways.
                        </p>

                    </div>

                    <!-- Retour -->

                    <div class="sn-feature-card">

                        <div class="sn-feature-icon">
                            <i class="fa fa-refresh"/>
                        </div>

                        <h3>30 Days Return</h3>

                        <p>
                            Easy returns within 30 days after delivery.
                        </p>

                    </div>

                    <!-- Support -->

                    <div class="sn-feature-card">

                        <div class="sn-feature-icon">
                            <i class="fa fa-headphones"/>
                        </div>

                        <h3>24/7 Support</h3>

                        <p>
                            Our team is available every day to help you.
                        </p>

                    </div>

                </div>

            </div>

        </section>

    </template>

</odoo>