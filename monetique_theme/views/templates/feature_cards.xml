<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- WHY CHOOSE US / FEATURES                                 -->
    <!-- ========================================================= -->

    <template id="feature_cards" name="Sneakers Features">

        <section class="sn-features">

            <div class="mn-container">

                <!-- Section Header -->

                <div class="sn-section-header">

                    <span class="sn-section-subtitle">
                        Why Choose Us
                    </span>

                    <h2>
                        Shopping Made Easy
                    </h2>

                    <p>
                        We provide premium products and exceptional service to
                        make every purchase a great experience.
                    </p>

                </div>

                <!-- Features Grid -->

                <div class="sn-features-grid">

                    <!-- Feature 1 -->

                    <div class="sn-feature-card">

                        <div class="sn-feature-icon">

                            <i class="fa fa-truck"/>

                        </div>

                        <h3>Free Shipping</h3>

                        <p>
                            Enjoy free delivery on all orders above $100.
                        </p>

                    </div>

                    <!-- Feature 2 -->

                    <div class="sn-feature-card">

                        <div class="sn-feature-icon">

                            <i class="fa fa-refresh"/>

                        </div>

                        <h3>Easy Returns</h3>

                        <p>
                            Return your products within 30 days with no hassle.
                        </p>

                    </div>

                    <!-- Feature 3 -->

                    <div class="sn-feature-card">

                        <div class="sn-feature-icon">

                            <i class="fa fa-lock"/>

                        </div>

                        <h3>Secure Payment</h3>

                        <p>
                            Your payments are protected with secure encryption.
                        </p>

                    </div>

                    <!-- Feature 4 -->

                    <div class="sn-feature-card">

                        <div class="sn-feature-icon">

                            <i class="fa fa-headphones"/>

                        </div>

                        <h3>24/7 Support</h3>

                        <p>
                            Our support team is available anytime you need help.
                        </p>

                    </div>

                </div>

            </div>

        </section>

    </template>

</odoo>