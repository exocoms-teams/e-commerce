<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- CATEGORIES SECTION                                        -->
    <!-- ========================================================= -->

    <template id="categories_section" name="Sneakers Categories">

        <section class="sn-categories">

            <div class="mn-container">

                <!-- Section Header -->

                <div class="sn-section-header">

                    <span class="sn-section-subtitle">
                        Shop by Category
                    </span>

                    <h2>
                        Find Your Perfect Pair
                    </h2>

                    <p>
                        Browse our carefully selected collections for every
                        lifestyle and activity.
                    </p>

                </div>

                <!-- Categories Grid -->

                <div class="sn-categories-grid">

                    <!-- Men -->

                    <a href="/shop?category=men" class="sn-category-card">

                        <img
                            src="/monetique_theme/static/src/img/categories/men.jpg"
                            alt="Men Sneakers"/>

                        <div class="sn-category-overlay">

                            <h3>Men</h3>

                            <span>Explore Collection</span>

                        </div>

                    </a>

                    <!-- Women -->

                    <a href="/shop?category=women" class="sn-category-card">

                        <img
                            src="/monetique_theme/static/src/img/categories/women.jpg"
                            alt="Women Sneakers"/>

                        <div class="sn-category-overlay">

                            <h3>Women</h3>

                            <span>Explore Collection</span>

                        </div>

                    </a>

                    <!-- Running -->

                    <a href="/shop?category=running" class="sn-category-card">

                        <img
                            src="/monetique_theme/static/src/img/categories/running.jpg"
                            alt="Running Shoes"/>

                        <div class="sn-category-overlay">

                            <h3>Running</h3>

                            <span>Explore Collection</span>

                        </div>

                    </a>

                    <!-- Basketball -->

                    <a href="/shop?category=basketball" class="sn-category-card">

                        <img
                            src="/monetique_theme/static/src/img/categories/basketball.jpg"
                            alt="Basketball Shoes"/>

                        <div class="sn-category-overlay">

                            <h3>Basketball</h3>

                            <span>Explore Collection</span>

                        </div>

                    </a>

                </div>

            </div>

        </section>

    </template>

</odoo>