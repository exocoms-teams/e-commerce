<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="categories_section" name="Sneakers Categories">

        <section class="sn-categories">

            <div class="sn-container">

                <div class="sn-section-header">

                    <span class="sn-section-tag">
                        Categories
                    </span>

                    <h2 class="sn-section-title">
                        Shop By Category
                    </h2>

                    <p class="sn-section-subtitle">
                        Discover our collections for every style and every occasion.
                    </p>

                </div>

                <div class="sn-categories-grid">

                    <!-- Men -->

                    <a href="/shop" class="sn-category-card">

                        <img
                            src="/monetique_theme/static/src/img/categories/men.jpg"
                            alt="Men"/>

                        <div class="sn-category-overlay"/>

                        <div class="sn-category-content">

                            <h3>Men</h3>

                            <span>Explore Collection</span>

                        </div>

                    </a>

                    <!-- Women -->

                    <a href="/shop" class="sn-category-card">

                        <img
                            src="/monetique_theme/static/src/img/categories/women.jpg"
                            alt="Women"/>

                        <div class="sn-category-overlay"/>

                        <div class="sn-category-content">

                            <h3>Women</h3>

                            <span>Explore Collection</span>

                        </div>

                    </a>

                    <!-- Running -->

                    <a href="/shop" class="sn-category-card">

                        <img
                            src="/monetique_theme/static/src/img/categories/running.jpg"
                            alt="Running"/>

                        <div class="sn-category-overlay"/>

                        <div class="sn-category-content">

                            <h3>Running</h3>

                            <span>Explore Collection</span>

                        </div>

                    </a>

                    <!-- Basketball -->

                    <a href="/shop" class="sn-category-card">

                        <img
                            src="/monetique_theme/static/src/img/categories/basketball.jpg"
                            alt="Basketball"/>

                        <div class="sn-category-overlay"/>

                        <div class="sn-category-content">

                            <h3>Basketball</h3>

                            <span>Explore Collection</span>

                        </div>

                    </a>

                    <!-- Lifestyle -->

                    <a href="/shop" class="sn-category-card">

                        <img
                            src="/monetique_theme/static/src/img/categories/lifestyle.jpg"
                            alt="Lifestyle"/>

                        <div class="sn-category-overlay"/>

                        <div class="sn-category-content">

                            <h3>Lifestyle</h3>

                            <span>Explore Collection</span>

                        </div>

                    </a>

                    <!-- Sale -->

                    <a href="/shop" class="sn-category-card">

                        <img
                            src="/monetique_theme/static/src/img/categories/sale.jpg"
                            alt="Sale"/>

                        <div class="sn-category-overlay"/>

                        <div class="sn-category-content">

                            <h3>Sale</h3>

                            <span>Up To 50% Off</span>

                        </div>

                    </a>

                </div>

            </div>

        </section>

    </template>

</odoo>