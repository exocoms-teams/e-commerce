<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <template id="search_bar" name="Search Bar">

        <section class="sn-search">

            <div class="container">

                <form class="sn-search-form">

                    <select class="sn-category-filter">

                        <option>All Categories</option>

                        <option>Running</option>

                        <option>Basketball</option>

                        <option>Lifestyle</option>

                        <option>Training</option>

                    </select>

                    <input
                        type="search"
                        class="sn-search-input"
                        placeholder="Search your sneakers..."
                    />

                    <button
                        type="submit"
                        class="sn-search-button">

                        <i class="fa fa-search"/>

                    </button>

                </form>

            </div>

        </section>

    </template>

</odoo>