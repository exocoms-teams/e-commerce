<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="hero" name="Homepage Hero">

        <section class="sn-hero">

            <div class="sn-slider">

                <!-- ================= Slide 1 ================= -->

                <div class="sn-slide active">

                    <img
                        class="sn-slide-image"
                        src="/monetique_theme/static/src/img/hero/hero-1.jpg"
                        alt="Sneakers Collection"/>

                    <div class="sn-slide-overlay"/>

                    <div class="container">

                        <div class="sn-slide-content">

                            <span class="sn-badge">
                                NEW COLLECTION
                            </span>

                            <h1>
                                Discover The
                                <span>Future</span>
                                Of Sneakers
                            </h1>

                            <p>
                                Premium sneakers from the world's most iconic
                                brands. Style, comfort and performance in one place.
                            </p>

                            <div class="sn-slide-buttons">

                                <a href="/shop" class="sn-btn-primary">
                                    Shop Now
                                </a>

                                <a href="/shop" class="sn-btn-secondary">
                                    Explore
                                </a>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ================= Slide 2 ================= -->

                <div class="sn-slide">

                    <img
                        class="sn-slide-image"
                        src="/monetique_theme/static/src/img/hero/hero-2.jpg"
                        alt="Nike"/>

                    <div class="sn-slide-overlay"/>

                    <div class="container">

                        <div class="sn-slide-content">

                            <span class="sn-badge">
                                NIKE
                            </span>

                            <h1>
                                Move
                                <span>Without</span>
                                Limits
                            </h1>

                            <p>
                                Discover the latest running and lifestyle
                                sneakers for every day.
                            </p>

                            <div class="sn-slide-buttons">

                                <a href="/shop" class="sn-btn-primary">
                                    Shop Nike
                                </a>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ================= Slide 3 ================= -->

                <div class="sn-slide">

                    <img
                        class="sn-slide-image"
                        src="/monetique_theme/static/src/img/hero/hero-3.jpg"
                        alt="Adidas"/>

                    <div class="sn-slide-overlay"/>

                    <div class="container">

                        <div class="sn-slide-content">

                            <span class="sn-badge">
                                ADIDAS
                            </span>

                            <h1>
                                Designed
                                <span>For</span>
                                Champions
                            </h1>

                            <p>
                                Discover the newest Adidas sneakers with
                                exceptional comfort.
                            </p>

                            <div class="sn-slide-buttons">

                                <a href="/shop" class="sn-btn-primary">
                                    Shop Adidas
                                </a>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ================= Slide 4 ================= -->

                <div class="sn-slide">

                    <img
                        class="sn-slide-image"
                        src="/monetique_theme/static/src/img/hero/hero-4.jpg"
                        alt="Jordan"/>

                    <div class="sn-slide-overlay"/>

                    <div class="container">

                        <div class="sn-slide-content">

                            <span class="sn-badge">
                                JORDAN
                            </span>

                            <h1>
                                Street
                                <span>Style</span>
                                Collection
                            </h1>

                            <p>
                                Discover limited editions and iconic Jordan
                                sneakers.
                            </p>

                            <div class="sn-slide-buttons">

                                <a href="/shop" class="sn-btn-primary">
                                    Discover
                                </a>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ================= Slide 5 ================= -->

                <div class="sn-slide">

                    <img
                        class="sn-slide-image"
                        src="/monetique_theme/static/src/img/hero/hero-5.jpg"
                        alt="Sale"/>

                    <div class="sn-slide-overlay"/>

                    <div class="container">

                        <div class="sn-slide-content">

                            <span class="sn-badge">
                                SALE
                            </span>

                            <h1>
                                Up To
                                <span>50%</span>
                                Off
                            </h1>

                            <p>
                                Don't miss our exclusive offers on selected
                                sneakers.
                            </p>

                            <div class="sn-slide-buttons">

                                <a href="/shop" class="sn-btn-primary">
                                    Shop Sale
                                </a>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ================= Controls ================= -->

                <button class="sn-slider-prev" aria-label="Previous Slide">

                    <i class="fa fa-chevron-left"/>

                </button>

                <button class="sn-slider-next" aria-label="Next Slide">

                    <i class="fa fa-chevron-right"/>

                </button>

                <!-- ================= Indicators ================= -->

                <div class="sn-slider-dots">

                    <span class="active"></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>

                </div>

            </div>

        </section>

    </template>

</odoo>