<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- HERO SECTION                                              -->
    <!-- ========================================================= -->

    <template id="hero" name="Sneakers Hero">

        <section class="sn-hero">

            <div class="sn-hero-slider">

                <!-- ================= Slide 1 ================= -->

                <article class="sn-slide active">

                    <div class="mn-container">

                        <div class="sn-slide-content">

                            <div class="sn-slide-text">

                                <span class="sn-badge">
                                    New Collection 2026
                                </span>

                                <h1>
                                    Discover the Future
                                    <span>of Sneakers</span>
                                </h1>

                                <p>
                                    Discover premium sneakers from the world's
                                    leading brands. Performance, comfort and
                                    modern style in one place.
                                </p>

                                <div class="sn-buttons">

                                    <a href="/shop" class="sn-btn-primary">
                                        Shop Now
                                    </a>

                                    <a href="/shop" class="sn-btn-outline">
                                        Explore Collection
                                    </a>

                                </div>

                            </div>

                            <div class="sn-slide-image">

                                <img
                                    src="/monetique_theme/static/src/img/hero/hero-1.jpg"
                                    alt="Sneakers Hero"/>

                            </div>

                        </div>

                    </div>

                </article>

                <!-- ================= Slide 2 ================= -->

                <article class="sn-slide">

                    <div class="mn-container">

                        <div class="sn-slide-content">

                            <div class="sn-slide-text">

                                <span class="sn-badge">
                                    Limited Edition
                                </span>

                                <h1>
                                    Run Faster
                                    <span>Every Day</span>
                                </h1>

                                <p>
                                    Designed for athletes and everyday comfort.
                                    Lightweight, durable and stylish.
                                </p>

                                <div class="sn-buttons">

                                    <a href="/shop" class="sn-btn-primary">
                                        Shop Running
                                    </a>

                                    <a href="/shop" class="sn-btn-outline">
                                        Learn More
                                    </a>

                                </div>

                            </div>

                            <div class="sn-slide-image">

                                <img
                                    src="/monetique_theme/static/src/img/hero/hero-2.jpg"
                                    alt="Running Shoes"/>

                            </div>

                        </div>

                    </div>

                </article>

                <!-- ================= Slide 3 ================= -->

                <article class="sn-slide">

                    <div class="mn-container">

                        <div class="sn-slide-content">

                            <div class="sn-slide-text">

                                <span class="sn-badge">
                                    Up To 50% OFF
                                </span>

                                <h1>
                                    Summer Sale
                                    <span>Starts Today</span>
                                </h1>

                                <p>
                                    Take advantage of exclusive discounts on
                                    the biggest sneaker brands before stocks
                                    run out.
                                </p>

                                <div class="sn-buttons">

                                    <a href="/shop" class="sn-btn-primary">
                                        Shop Sale
                                    </a>

                                    <a href="/shop" class="sn-btn-outline">
                                        View Offers
                                    </a>

                                </div>

                            </div>

                            <div class="sn-slide-image">

                                <img
                                    src="/monetique_theme/static/src/img/hero/hero-3.jpg"
                                    alt="Sale Sneakers"/>

                            </div>

                        </div>

                    </div>

                </article>

            </div>

            <!-- ================= Navigation ================= -->

            <button class="sn-slider-prev">

                &#10094;

            </button>

            <button class="sn-slider-next">

                &#10095;

            </button>

            <!-- ================= Dots ================= -->

            <div class="sn-slider-dots">

                <span class="active"></span>
                <span></span>
                <span></span>

            </div>

        </section>

    </template>

</odoo>