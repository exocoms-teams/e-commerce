<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_contact" name="monetiques.fr - Contact" inherit_id="website.layout">
        <xpath expr="//div[@id='wrapwrap']" position="replace">
        <div id="wrapwrap" class="pc-site">
            <t t-call="paycore_website.navbar"/>
            <main id="wrap" role="main">

                <section class="pc-page-header">
                    <div class="pc-container">
                        <h1 class="pc-page-header__title">Parlons de votre projet</h1>
                        <p class="pc-page-header__sub">Un expert répond sous 24h ouvrées. Audit initial gratuit et sans engagement.</p>
                    </div>
                </section>

                <section class="pc-section">
                    <div class="pc-container">
                        <div class="pc-contact-grid">

                            <!-- Formulaire -->
                            <div class="pc-contact-form-wrap">
                                <t t-if="request.params.get('sent')">
                                    <div class="pc-alert pc-alert--success" role="alert">
                                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                                            <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5"/>
                                            <path d="M7 10l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        <span>Votre message a bien été envoyé. Nous vous répondons sous 24h.</span>
                                    </div>
                                </t>

                                <form class="pc-form" method="POST" action="/contact/submit" novalidate="novalidate">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <div class="pc-form__row">
                                        <div class="pc-form__group">
                                            <label class="pc-form__label" for="contact-name">Nom complet <span aria-hidden="true">*</span></label>
                                            <input class="pc-form__input" type="text" id="contact-name" name="name" required="required" placeholder="Jean Dupont" autocomplete="name"/>
                                        </div>
                                        <div class="pc-form__group">
                                            <label class="pc-form__label" for="contact-company">Société</label>
                                            <input class="pc-form__input" type="text" id="contact-company" name="company" placeholder="Votre entreprise" autocomplete="organization"/>
                                        </div>
                                    </div>

                                    <div class="pc-form__row">
                                        <div class="pc-form__group">
                                            <label class="pc-form__label" for="contact-email">Email professionnel <span aria-hidden="true">*</span></label>
                                            <input class="pc-form__input" type="email" id="contact-email" name="email" required="required" placeholder="vous@entreprise.fr" autocomplete="email"/>
                                        </div>
                                        <div class="pc-form__group">
                                            <label class="pc-form__label" for="contact-phone">Téléphone</label>
                                            <input class="pc-form__input" type="tel" id="contact-phone" name="phone" placeholder="+33 6 XX XX XX XX" autocomplete="tel"/>
                                        </div>
                                    </div>

                                    <div class="pc-form__group">
                                        <label class="pc-form__label" for="contact-subject">Sujet de votre demande</label>
                                        <select class="pc-form__select" id="contact-subject" name="subject">
                                            <option value="">Sélectionner un sujet</option>
                                            <option value="tpe">Terminaux TPE / Monétique</option>
                                            <option value="encaissement">Solution d'encaissement</option>
                                            <option value="omnicanal">Paiement omnicanal</option>
                                            <option value="support">Support / Maintenance</option>
                                            <option value="audit">Audit infrastructure</option>
                                            <option value="autre">Autre</option>
                                        </select>
                                    </div>

                                    <div class="pc-form__group">
                                        <label class="pc-form__label" for="contact-message">Votre message <span aria-hidden="true">*</span></label>
                                        <textarea class="pc-form__textarea" id="contact-message" name="message" required="required" rows="5" placeholder="Décrivez votre besoin : type de commerce, nombre de caisses, situation actuelle..."/>
                                    </div>

                                    <div class="pc-form__footer">
                                        <p class="pc-form__legal">
                                            Vos données sont traitées selon notre <a href="/confidentialite">politique de confidentialité</a>. Pas de spam.
                                        </p>
                                        <button type="submit" class="pc-btn pc-btn--primary">
                                            Envoyer le message
                                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                                                <path d="M1.5 7h11M9 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </button>
                                    </div>

                                </form>
                            </div>

                            <!-- Infos contact -->
                            <aside class="pc-contact-info" aria-label="Informations de contact">

                                <div class="pc-contact-info__card">
                                    <h3>Coordonnées</h3>
                                    <div class="pc-contact-info__item">
                                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                                            <path d="M2 3A1.5 1.5 0 013.5 1.5h.382a1 1 0 01.95.684l.688 2.063a1 1 0 01-.275 1.06l-.7.616a7 7 0 003.032 3.032l.617-.7a1 1 0 011.06-.275l2.063.688A1 1 0 0112 9.618V10A1.5 1.5 0 0110.5 11.5C5.253 11.5 1 7.247 1 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                                        </svg>
                                        <div>
                                            <strong>Téléphone</strong>
                                            <a href="tel:+33XXXXXXXXX">+33 (0)X XX XX XX XX</a>
                                        </div>
                                    </div>
                                    <div class="pc-contact-info__item">
                                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                                            <rect x="1" y="3" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.4"/>
                                            <path d="M1 6l8 5 8-5" stroke="currentColor" stroke-width="1.4"/>
                                        </svg>
                                        <div>
                                            <strong>Email</strong>
                                            <a href="mailto:contact@monetiques.fr">contact@monetiques.fr</a>
                                        </div>
                                    </div>
                                    <div class="pc-contact-info__item">
                                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                                            <path d="M9 1a6 6 0 016 6c0 4-6 10-6 10S3 11 3 7a6 6 0 016-6z" stroke="currentColor" stroke-width="1.4"/>
                                            <circle cx="9" cy="7" r="2" stroke="currentColor" stroke-width="1.4"/>
                                        </svg>
                                        <div>
                                            <strong>Adresse</strong>
                                            <span>XX rue XXXXXXXX<br/>XXXXX Paris</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="pc-contact-info__card pc-contact-info__card--hours">
                                    <h3>Horaires</h3>
                                    <div class="pc-hours">
                                        <div class="pc-hours__row">
                                            <span>Lun–Ven</span>
                                            <span>8h30 – 18h30</span>
                                        </div>
                                        <div class="pc-hours__row">
                                            <span>Samedi</span>
                                            <span>9h – 13h</span>
                                        </div>
                                        <div class="pc-hours__row pc-hours__row--highlight">
                                            <span>Astreinte technique</span>
                                            <span>7j/7 – 24h/24</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="pc-contact-info__card pc-contact-info__card--sla">
                                    <div class="pc-status-indicator">
                                        <span class="pc-status-dot pc-status-dot--green" aria-hidden="true"></span>
                                        <span>Infrastructure opérationnelle</span>
                                    </div>
                                    <p>Tous les services sont disponibles. Temps de réponse moyen : <strong>2h47</strong></p>
                                </div>

                            </aside>

                        </div>
                    </div>
                </section>

            </main>
            <t t-call="paycore_website.footer"/>
        </div>
        </xpath>
    </template>

</odoo>
