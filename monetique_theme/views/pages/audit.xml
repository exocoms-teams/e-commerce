<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="audit_page" name="monetiques.fr Audit Gratuit">
  <t t-call="website.layout">
    <div id="wrap">

      <section class="mn-page-hero">
        <div class="mn-container">
          <span class="eyebrow">Gratuit et sans engagement</span>
          <h1>Demander un audit monétique</h1>
          <p>Notre expert analyse votre situation et vous propose la solution la mieux adaptée à votre activité et votre volume.</p>
        </div>
      </section>

      <div class="mn-container">
        <div class="mn-audit-layout">

          <div class="mn-form-card">
            <h2>Vos informations</h2>
            <form action="/audit/submit" method="post">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
              <div class="mn-frow">
                <div class="mn-fg">
                  <label for="prenom">Prénom *</label>
                  <input type="text" id="prenom" name="prenom" placeholder="Jean" required="1"/>
                </div>
                <div class="mn-fg">
                  <label for="societe">Société</label>
                  <input type="text" id="societe" name="societe" placeholder="Ma Société SAS"/>
                </div>
              </div>
              <div class="mn-fg">
                <label for="email">Email professionnel *</label>
                <input type="email" id="email" name="email" placeholder="jean@masociete.fr" required="1"/>
              </div>
              <div class="mn-fg">
                <label for="telephone">Téléphone</label>
                <input type="tel" id="telephone" name="telephone" placeholder="+33 6 00 00 00 00"/>
              </div>
              <div class="mn-frow">
                <div class="mn-fg">
                  <label for="activite">Type d'activité</label>
                  <select id="activite" name="activite">
                    <option value="">Choisir...</option>
                    <option value="commerce">Commerce de détail</option>
                    <option value="restauration">Restauration / Hôtellerie</option>
                    <option value="pharmacie">Pharmacie / Santé</option>
                    <option value="services">Services</option>
                    <option value="grande_surface">Grande surface</option>
                    <option value="autre">Autre</option>
                  </select>
                </div>
                <div class="mn-fg">
                  <label for="nb_caisses">Nombre de caisses</label>
                  <select id="nb_caisses" name="nb_caisses">
                    <option value="">Choisir...</option>
                    <option value="1">1 caisse</option>
                    <option value="2-5">2 à 5 caisses</option>
                    <option value="6-20">6 à 20 caisses</option>
                    <option value="20+">Plus de 20 caisses</option>
                  </select>
                </div>
              </div>
              <div class="mn-fg">
                <label for="tpe_actuel">TPE actuel (si renouvellement)</label>
                <input type="text" id="tpe_actuel" name="tpe_actuel" placeholder="Ex: Ingenico iCT220, Verifone VX520..."/>
              </div>
              <div class="mn-fg">
                <label for="volume">Volume mensuel estimé</label>
                <select id="volume" name="volume">
                  <option value="">Choisir...</option>
                  <option value="moins_5k">Moins de 5 000 €</option>
                  <option value="5k_20k">5 000 € – 20 000 €</option>
                  <option value="20k_100k">20 000 € – 100 000 €</option>
                  <option value="100k+">Plus de 100 000 €</option>
                </select>
              </div>
              <div class="mn-fg">
                <label for="message">Votre besoin (optionnel)</label>
                <textarea id="message" name="message" rows="4" placeholder="Décrivez votre projet, vos contraintes, vos questions..."></textarea>
              </div>
              <button type="submit" class="btn btn-red btn-lg" style="width:100%;justify-content:center">
                Envoyer ma demande d'audit →
              </button>
            </form>
          </div>

          <div class="mn-audit-side">
            <div class="mn-acard">
              <div class="mn-acard__ico">⚡</div>
              <h3>Réponse sous 4h</h3>
              <p>Notre équipe vous contacte dans la journée pour un premier échange téléphonique.</p>
            </div>
            <div class="mn-acard">
              <div class="mn-acard__ico">🎯</div>
              <h3>Audit personnalisé</h3>
              <p>Analyse de votre activité, de vos volumes et de vos contraintes techniques pour vous proposer la solution optimale.</p>
            </div>
            <div class="mn-acard">
              <div class="mn-acard__ico">📋</div>
              <h3>Devis détaillé</h3>
              <p>Un devis clair et complet incluant matériel, installation, formation et maintenance.</p>
            </div>
            <div class="mn-assure">
              ✓ Sans engagement · Totalement gratuit
            </div>
          </div>

        </div>
      </div>

    </div>
  </t>
</template>
</odoo>
