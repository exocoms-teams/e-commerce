<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- PAGE TPE -->
    <template id="page_tpe" name="monetiques.fr - TPE" inherit_id="website.layout">
        <xpath expr="//div[@id='wrapwrap']" position="replace">
        <div id="wrapwrap" class="pc-site">
            <t t-call="paycore_website.navbar"/>
            <main id="wrap" role="main">

                <section class="pc-page-header pc-page-header--dark">
                    <div class="pc-container">
                        <div class="pc-breadcrumb">
                            <a href="/">Accueil</a><span>/</span>
                            <a href="/services">Solutions</a><span>/</span>
                            <span aria-current="page">Terminaux TPE</span>
                        </div>
                        <span class="pc-eyebrow">Matériel certifié</span>
                        <h1 class="pc-page-header__title">Terminaux de Paiement Électronique</h1>
                        <p class="pc-page-header__sub">
                            Distribution, installation et maintenance de TPE professionnels.
                            Tous types de connectivité. Toutes les marques du marché.
                        </p>
                    </div>
                </section>

                <section class="pc-section">
                    <div class="pc-container">
                        <div class="pc-section__header pc-section__header--center">
                            <span class="pc-eyebrow">Notre catalogue</span>
                            <h2 class="pc-h2">Terminaux pour chaque usage</h2>
                        </div>
                        <div class="pc-products-grid">

                            <div class="pc-product-card" data-animate="fade-up">
                                <div class="pc-product-card__icon" aria-hidden="true">
                                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                                        <rect x="8" y="10" width="32" height="28" rx="4" stroke="currentColor" stroke-width="2"/>
                                        <path d="M8 18h32" stroke="currentColor" stroke-width="2"/>
                                        <rect x="14" y="24" width="20" height="8" rx="2" fill="currentColor" opacity="0.1"/>
                                        <path d="M20 38h8M24 36v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                    </svg>
                                </div>
                                <h3>TPE Fixe</h3>
                                <p>Idéal pour les points de vente fixes. Connexion IP filaire ou WiFi. Imprimante intégrée haute vitesse.</p>
                                <ul class="pc-product-card__features">
                                    <li>NFC / sans contact</li>
                                    <li>Puce EMV / piste</li>
                                    <li>Écran tactile couleur</li>
                                    <li>Impression ticket rapide</li>
                                </ul>
                            </div>

                            <div class="pc-product-card pc-product-card--featured" data-animate="fade-up" data-delay="80">
                                <div class="pc-product-card__badge">Le plus demandé</div>
                                <div class="pc-product-card__icon" aria-hidden="true">
                                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                                        <rect x="14" y="4" width="20" height="40" rx="5" stroke="currentColor" stroke-width="2"/>
                                        <path d="M14 12h20M14 36h20" stroke="currentColor" stroke-width="2"/>
                                        <circle cx="24" cy="40" r="1.5" fill="currentColor"/>
                                    </svg>
                                </div>
                                <h3>TPE Mobile GPRS/4G</h3>
                                <p>Pour commerçants itinérants, livraisons, marchés. Autonomie jusqu'à 8h. Connectivité 4G intégrée.</p>
                                <ul class="pc-product-card__features">
                                    <li>4G / WiFi / Bluetooth</li>
                                    <li>Batterie longue durée</li>
                                    <li>Résistant aux chocs</li>
                                    <li>Impression intégrée</li>
                                </ul>
                            </div>

                            <div class="pc-product-card" data-animate="fade-up" data-delay="160">
                                <div class="pc-product-card__icon" aria-hidden="true">
                                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                                        <rect x="8" y="6" width="32" height="36" rx="4" stroke="currentColor" stroke-width="2"/>
                                        <rect x="12" y="10" width="24" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/>
                                        <path d="M16 32h4M22 32h4M28 32h4M16 36h4M22 36h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                    </svg>
                                </div>
                                <h3>Terminal Android</h3>
                                <p>Terminaux intelligents sous Android. Possibilité d'installer des apps métier. Écran grande taille.</p>
                                <ul class="pc-product-card__features">
                                    <li>Android 10+</li>
                                    <li>Apps métier custom</li>
                                    <li>Grand écran tactile</li>
                                    <li>Caméra / scanner</li>
                                </ul>
                            </div>

                        </div>

                        <div class="pc-section__footer">
                            <a href="/contact" class="pc-btn pc-btn--primary">
                                Demander un devis TPE
                            </a>
                        </div>
                    </div>
                </section>

                <t t-call="paycore_website.stats_section"/>

            </main>
            <t t-call="paycore_website.footer"/>
        </div>
        </xpath>
    </template>

</odoo>
