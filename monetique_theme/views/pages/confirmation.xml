<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="page_confirmation" name="Sneakers Order Confirmation">

        <t t-call="monetique_theme.layout">

            <!-- CONFIRMATION HEADER -->
            <section class="sn-confirmation-header">

                <div class="mn-container">

                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">
                            Order Confirmation
                        </span>

                        <h2>
                            Thank You For Your Purchase!
                        </h2>

                        <p>
                            Your order has been successfully placed and is now
                            being processed.
                        </p>

                    </div>

                </div>

            </section>

            <!-- CONFIRMATION CONTENT -->
            <section class="sn-confirmation">

                <div class="mn-container">

                    <div class="sn-confirmation-card">

                        <!-- Success Icon -->

                        <div class="sn-confirmation-icon">

                            <i class="fa-solid fa-circle-check"></i>

                        </div>

                        <!-- Success Message -->
                        <h3>Payment Successful</h3>

                        <p>Thank you for shopping with Sneakers.
                            Your order has been confirmed.</p>

                        <!-- Order Number -->
                        <div class="sn-order-number">

                            <span>Order Number</span>

                            <strong>#SN-2026-000245</strong>

                        </div>

                        <!-- ORDER DETAILS -->
                        <div class="sn-order-summary">

                            <h4>Order Summary</h4>

                            <div class="sn-order-item">

                                <span>Nike Air Max 270 x1</span>

                                <strong>$180.00</strong>

                            </div>

                            <div class="sn-order-item">

                                <span>Adidas Ultraboost x2</span>

                                <strong>$440.00</strong>

                            </div>

                            <div class="sn-summary-divider"></div>

                            <div class="sn-order-item">

                                <span>Subtotal</span>

                                <strong>$620.00</strong>

                            </div>

                            <div class="sn-order-item">

                                <span>Shipping</span>

                                <strong>Free</strong>

                            </div>

                            <div class="sn-order-item">

                                <span>Tax</span>

                                <strong>$24.00</strong>

                            </div>

                            <div class="sn-summary-divider"></div>

                            <div class="sn-order-item sn-order-total">

                                <span>Total</span>

                                <strong>$644.00</strong>

                            </div>

                        </div>

                        <div class="sn-confirmation-actions">

                            <a href="/shop"
                               class="sn-primary-btn">

                                Continue Shopping

                            </a>

                            <a href="#"
                               class="sn-secondary-btn">

                                Download Invoice

                            </a>

                        </div>

                    </div>

                </div>

            </section>

        </t>

    </template>

</odoo>