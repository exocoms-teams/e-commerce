<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_services" name="monetiques.fr - Services" inherit_id="website.layout">
        <xpath expr="//div[@id='wrapwrap']" position="replace">
        <div id="wrapwrap" class="pc-site">
            <t t-call="monetique_theme.navbar"/>
            <main id="wrap" role="main">

                <!-- Page header -->
                <section class="pc-page-header">
                    <div class="pc-container">
                        <div class="pc-breadcrumb" aria-label="Fil d'Ariane">
                            <a href="/">Accueil</a>
                            <span aria-hidden="true">/</span>
                            <span aria-current="page">Services</span>
                        </div>
                        <h1 class="pc-page-header__title">Nos services</h1>
                        <p class="pc-page-header__sub">
                            De l'équipement à la maintenance, nous couvrons l'intégralité de votre besoin monétique.
                        </p>
                    </div>
                </section>

                <!-- Services list -->
                <section class="pc-section">
                    <div class="pc-container">
                        <div class="pc-services-list">

                            <div class="pc-service-row" data-animate="fade-up">
                                <div class="pc-service-row__number">01</div>
                                <div class="pc-service-row__content">
                                    <div class="pc-service-row__text">
                                        <h2>Terminaux TPE &amp; Monétique</h2>
                                        <p>Nous distribuons, installons et maintenons l'ensemble des gammes de terminaux de paiement du marché : Ingenico, Verifone, PAX, Castles. TPE fixes filaires, GPRS, WiFi, Bluetooth et Android. Nous assurons la configuration réseau, les clés de chiffrement et la formation de vos équipes.</p>
                                        <a href="/solutions/tpe" class="pc-btn pc-btn--outline pc-btn--sm">Découvrir les TPE</a>
                                    </div>
                                    <div class="pc-service-row__specs">
                                        <div class="pc-spec-item"><span>Marques</span><strong>Ingenico · Verifone · PAX</strong></div>
                                        <div class="pc-spec-item"><span>Délai installation</span><strong>48h à 5 jours ouvrés</strong></div>
                                        <div class="pc-spec-item"><span>Garantie</span><strong>12 à 36 mois</strong></div>
                                    </div>
                                </div>
                            </div>

                            <div class="pc-service-row" data-animate="fade-up">
                                <div class="pc-service-row__number">02</div>
                                <div class="pc-service-row__content">
                                    <div class="pc-service-row__text">
                                        <h2>Solutions d'Encaissement</h2>
                                        <p>Systèmes de caisse complets pour commerces, restaurants, hôtels et retail. Logiciels certifiés NF525, intégration comptabilité, gestion des stocks, ticketing et reporting. Compatible avec votre infrastructure existante.</p>
                                        <a href="/solutions/encaissement" class="pc-btn pc-btn--outline pc-btn--sm">Voir les solutions</a>
                                    </div>
                                    <div class="pc-service-row__specs">
                                        <div class="pc-spec-item"><span>Certification</span><strong>NF525 obligatoire</strong></div>
                                        <div class="pc-spec-item"><span>Secteurs</span><strong>Retail · CHR · Services</strong></div>
                                        <div class="pc-spec-item"><span>Intégrations</span><strong>ERP · Compta · CRM</strong></div>
                                    </div>
                                </div>
                            </div>

                            <div class="pc-service-row" data-animate="fade-up">
                                <div class="pc-service-row__number">03</div>
                                <div class="pc-service-row__content">
                                    <div class="pc-service-row__text">
                                        <h2>Paiement Omnicanal</h2>
                                        <p>Unifiez vos flux de paiement : en point de vente, sur votre site e-commerce, par lien de paiement, sur mobile. Une seule plateforme de réconciliation, des rapports consolidés, une expérience client cohérente.</p>
                                        <a href="/solutions/paiement-omnicanal" class="pc-btn pc-btn--outline pc-btn--sm">Explorer l'omnicanal</a>
                                    </div>
                                    <div class="pc-service-row__specs">
                                        <div class="pc-spec-item"><span>Canaux</span><strong>POS · Web · Mobile · Lien</strong></div>
                                        <div class="pc-spec-item"><span>Moyens de paiement</span><strong>CB · SEPA · Wallet</strong></div>
                                        <div class="pc-spec-item"><span>Réconciliation</span><strong>Temps réel</strong></div>
                                    </div>
                                </div>
                            </div>

                            <div class="pc-service-row" data-animate="fade-up">
                                <div class="pc-service-row__number">04</div>
                                <div class="pc-service-row__content">
                                    <div class="pc-service-row__text">
                                        <h2>Support &amp; Maintenance Technique</h2>
                                        <p>Contrats de maintenance préventive et corrective. Hotline technique dédiée. Interventions sur site avec GTI contractuelle. Techniciens certifiés constructeurs. Pièces détachées en stock en France.</p>
                                        <a href="/support" class="pc-btn pc-btn--outline pc-btn--sm">Nos offres support</a>
                                    </div>
                                    <div class="pc-service-row__specs">
                                        <div class="pc-spec-item"><span>Hotline</span><strong>7j/7 · 24h/24</strong></div>
                                        <div class="pc-spec-item"><span>GTI</span><strong>4h à 48h selon contrat</strong></div>
                                        <div class="pc-spec-item"><span>SLA</span><strong>98,5% garanti</strong></div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </section>

                <t t-call="monetique_theme.engagements_section"/>

            </main>
            <t t-call="monetique_theme.footer"/>
        </div>
        </xpath>
    </template>

</odoo>
