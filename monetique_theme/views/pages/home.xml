<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_home" name="monetiques.fr Accueil">
        <t t-call="website.layout">

            <section class="mn-hero mn-hero--fullbg">
                <div class="mn-carousel mn-carousel--bg">
                    <img src="/travel_agency/static/img/Imageaccueil1.jpg" class="mn-carousel__img mn-carousel__img--1"/>
                    <img src="/travel_agency/static/img/Imageaccueil2.jpg" class="mn-carousel__img mn-carousel__img--2"/>
                    <img src="/travel_agency/static/img/Imageaccueil3.jpg" class="mn-carousel__img mn-carousel__img--3"/>
                    <img src="/travel_agency/static/img/Imageaccueil4.jpg" class="mn-carousel__img mn-carousel__img--4"/>
                </div>
                <div class="mn-hero__overlay"></div>
                <div class="mn-container mn-hero__container--fg">
                    <div class="mn-hero__content">
                        <div class="mn-hero__badge">
                            <span class="mn-dot"></span>
                            Agence de voyage certifiée &#183; Voyages sur mesure
                        </div>
                        <h1 class="mn-hero__title" style="color:white">
                            Partez à la decouverte
                            <span class="mn-hero__accent">du monde</span>
                        </h1>
                        <p class="mn-hero__desc" style="color:rgba(255,255,255,0.85)">Vols, hôtels, circuits et séjours tout compris, n'attendez plus et réservez en quelques clics.</p>
                        <div class="mn-hero__actions">
                            <a href="/contact" class="mn-btn mn-btn--primary mn-btn--lg">Découvrir nos voyages</a>
                            <a href="/shop" class="mn-btn mn-btn--outline mn-btn--lg" style="color:white;border-color:white">Voir nos destinations</a>
                        </div>
                        <div class="mn-hero__trust" style="color:rgba(255,255,255,0.8)">
                            <span>&#10003; Paiement sécurisé</span>
                            <span>&#10003; Assistance 7j/7</span>
                            <span>&#10003; +1000 voyageurs satisfaits</span>
                        </div>
                    </div>
                </div>
            </section>

            <t t-call="monetique_theme.stats_section"/>


            <section class="mn-section mn-products">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Agence de voyage</span>
                        <h2>Nos destinations</h2>
                        <p>Vols, hotels, circuits, reservez votre voyage en quelques clics.</p>
                    </div>
                    <div class="mn-products__grid">
                        <t t-foreach="request.env['product.template'].sudo().search([('prix_par_personne', '>', 0)], limit=6)" t-as="product">
                            <a t-attf-href="/travels/book/#{product.id}" class="mn-product-card">
                                <div class="mn-product-card__img">
                                    <t t-if="product.image_512">
                                        <img t-attf-src="/web/image/product.template/#{product.id}/image_512"
                                            t-att-alt="product.name"
                                            style="width:100%;height:200px;object-fit:cover;border-radius:8px 8px 0 0;"/>
                                    </t>
                                </div>
                                <div class="mn-product-card__body">
                                    <h3 t-esc="product.name"/>
                                    <div class="mn-product-card__footer">
                                        <span class="mn-product-card__price" t-esc="'%.2f € / pers.' % product.prix_par_personne"/>
                                        <span class="mn-btn mn-btn--primary mn-btn--sm">Reserver</span>
                                    </div>
                                </div>
                            </a>
                        </t>
                    </div>
                    <div class="mn-section__footer">
                        <a href="/travels" class="mn-btn mn-btn--outline">Voir tous nos voyages &#8594;</a>
                    </div>
                </div>
            </section>

            <section class="mn-reviews mn-section">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Temoignages</span>
                        <h2>Ce que disent nos clients</h2>
                    </div>
                    <div class="mn-grid mn-grid--3">
                        <article class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Installation rapide, equipe tres reactive. 12 terminaux sans interruption depuis 2 ans.</blockquote>
                            <footer class="mn-review__author"><div class="mn-avatar">ML</div><div><strong>Marie L.</strong><span>Directrice - Restauration, Lyon</span></div></footer>
                        </article>
                        <article class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Support 7j/7 nous a depannes un dimanche en moins de 2h. Indispensable.</blockquote>
                            <footer class="mn-review__author"><div class="mn-avatar">TB</div><div><strong>Thomas B.</strong><span>Gerant - Supermarche, Paris</span></div></footer>
                        </article>
                        <article class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Migration de 45 caisses sans interruption. Serieux et professionnel.</blockquote>
                            <footer class="mn-review__author"><div class="mn-avatar">SM</div><div><strong>Sophie M.</strong><span>DSI - Franchise, Bordeaux</span></div></footer>
                        </article>
                    </div>
                    <div class="mn-reviews__score"><div class="mn-reviews__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><strong>4,8 / 5</strong> &#8212; 312 avis verifies</div>
                </div>
            </section>

            <section class="mn-cta">
                <div class="mn-container">
                    <div class="mn-cta__inner">
                        <h2>Votre infrastructure de paiement commence par une conversation.</h2>
                        <p>Audit gratuit &#183; Devis sous 48h &#183; Sans engagement</p>
                        <div class="mn-cta__actions">
                            <a href="/contact" class="mn-btn mn-btn--white mn-btn--lg">Demander un audit gratuit</a>
                            <a href="/shop" class="mn-btn mn-btn--lg" style="border:2px solid rgba(255,255,255,0.4);color:white">Voir la boutique</a>
                        </div>
                    </div>
                </div>
            </section>

        </t>
    </template>

</odoo>
