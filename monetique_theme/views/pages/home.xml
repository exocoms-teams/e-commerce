<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_home" name="monetiques.fr Accueil">
        <t t-call="website.layout">

            <section class="mn-hero">
                <div class="mn-container">
                    <div class="mn-hero__inner">
                        <div class="mn-hero__content">
                            <div class="mn-hero__badge">
                                <span class="mn-dot"></span>
                                Certifie PCI DSS &#183; Partenaire Banque de France
                            </div>
                            <h1 class="mn-hero__title">
                                L'infrastructure de paiement
                                <span class="mn-hero__accent">qui ne tombe jamais</span>
                            </h1>
                            <p class="mn-hero__desc">Terminaux TPE, logiciels de caisse, paiement omnicanal. Installation, maintenance et support 7j/7.</p>
                            <div class="mn-hero__actions">
                                <a href="/contact" class="mn-btn mn-btn--primary mn-btn--lg">Demander un audit gratuit</a>
                                <a href="/shop" class="mn-btn mn-btn--outline mn-btn--lg">Voir les produits</a>
                            </div>
                            <div class="mn-hero__trust">
                                <span>&#10003; SLA 98.5% garanti</span>
                                <span>&#10003; Support 7j/7</span>
                                <span>&#10003; +3400 TPE actifs</span>
                            </div>
                        </div>
                        <div class="mn-hero__visual">
                            <svg viewBox="0 0 480 360" xmlns="http://www.w3.org/2000/svg" fill="none" style="max-width:100%;height:auto">
                                <defs><filter id="sh"><feDropShadow dx="0" dy="8" stdDeviation="20" flood-color="#0F172A" flood-opacity="0.12"/></filter></defs>
                                <rect x="60" y="20" width="360" height="320" rx="24" fill="white" filter="url(#sh)"/>
                                <rect x="160" y="40" width="160" height="220" rx="16" fill="#1E293B"/>
                                <rect x="172" y="52" width="136" height="132" rx="8" fill="#0F172A"/>
                                <rect x="180" y="60" width="120" height="116" rx="6" fill="#1E40AF" opacity="0.3"/>
                                <text x="240" y="108" text-anchor="middle" font-family="system-ui" font-size="12" fill="white" opacity="0.6">Montant</text>
                                <text x="240" y="132" text-anchor="middle" font-family="system-ui" font-size="28" font-weight="700" fill="white">45,60 &#8364;</text>
                                <path d="M225 152 Q240 145 255 152" stroke="#3B82F6" stroke-width="2" stroke-linecap="round"/>
                                <path d="M220 158 Q240 148 260 158" stroke="#3B82F6" stroke-width="2" stroke-linecap="round"/>
                                <path d="M215 164 Q240 151 265 164" stroke="#3B82F6" stroke-width="2" stroke-linecap="round"/>
                                <rect x="200" y="196" width="80" height="8" rx="4" fill="#374151"/>
                                <rect x="178" y="212" width="28" height="20" rx="5" fill="#374151"/>
                                <rect x="216" y="212" width="28" height="20" rx="5" fill="#374151"/>
                                <rect x="254" y="212" width="28" height="20" rx="5" fill="#10B981"/>
                                <rect x="178" y="240" width="28" height="20" rx="5" fill="#EF4444"/>
                                <rect x="216" y="240" width="28" height="20" rx="5" fill="#374151"/>
                                <rect x="254" y="240" width="28" height="20" rx="5" fill="#374151"/>
                                <rect x="100" y="120" width="54" height="38" rx="6" fill="white" stroke="#E5E7EB" stroke-width="1.5" transform="rotate(-15 127 139)"/>
                                <rect x="108" y="130" width="38" height="5" rx="2" fill="#D1D5DB" transform="rotate(-15 127 133)"/>
                                <circle cx="370" cy="110" r="32" fill="#EFF6FF" stroke="#BFDBFE" stroke-width="1.5"/>
                                <path d="M358 118 Q370 108 382 118" stroke="#3B82F6" stroke-width="2.5" stroke-linecap="round"/>
                                <path d="M354 113 Q370 100 386 113" stroke="#3B82F6" stroke-width="2.5" stroke-linecap="round"/>
                                <path d="M350 108 Q370 92 390 108" stroke="#3B82F6" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
                                <circle cx="370" cy="122" r="3" fill="#3B82F6"/>
                                <rect x="155" y="275" width="170" height="36" rx="18" fill="#F0FDF4" stroke="#BBF7D0" stroke-width="1.5"/>
                                <circle cx="178" cy="293" r="5" fill="#10B981"/>
                                <text x="192" y="297" font-family="system-ui" font-size="12" font-weight="600" fill="#15803D">Paiement accepte</text>
                                <rect x="220" y="254" width="40" height="8" rx="4" fill="#374151"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </section>

            <t t-call="monetique_theme.stats_section"/>

            <section class="mn-section mn-products">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Nos produits</span>
                        <h2>Nos solutions les plus demandees</h2>
                        <p>Equipements certifies, prets a deployer. Livraison et installation incluses.</p>
                    </div>
                    <div class="mn-products__grid">
                        <t t-set="products" t-value="website.sale_product_domain()"/>
                        <t t-foreach="request.env['product.template'].search([], limit=8)" t-as="product">
                            <a t-attf-href="/shop/#{product.id}" class="mn-product-card">
                                <div class="mn-product-card__img">
                                    <t t-if="product.image_512">
                                        <img t-attf-src="/web/image/product.template/#{product.id}/image_512" t-att-alt="product.name" style="width:100%;height:200px;object-fit:cover;border-radius:8px 8px 0 0;"/>
                                    </t>
                                    <t t-else="">
                                        <div class="mn-product-card__no-img"><svg width="48" height="48" viewBox="0 0 48 48" fill="none"><rect x="6" y="10" width="36" height="26" rx="4" stroke="#94A3B8" stroke-width="2"/><path d="M6 18h36" stroke="#94A3B8" stroke-width="2"/><rect x="14" y="22" width="20" height="8" rx="2" fill="#94A3B8" opacity="0.3"/></svg></div>
                                    </t>
                                </div>
                                <div class="mn-product-card__body">
                                    <h3 t-esc="product.name"/>
                                    <div class="mn-product-card__footer">
                                        <span class="mn-product-card__price" t-esc="'%.2f € HT' % product.list_price"/>
                                        <span class="mn-btn mn-btn--primary mn-btn--sm">Voir</span>
                                    </div>
                                </div>
                            </a>
                        </t>
                        
                    </div>
                    <div class="mn-section__footer">
                        <a href="/shop" class="mn-btn mn-btn--outline">Voir tous nos produits &#8594;</a>
                    </div>
                </div>
            </section>

            <section class="mn-reviews mn-section">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Temoignages</span>
                        <h2>Ce que disent nos clients</h2>
                    </div>
                    <div class="mn-grid mn-grid--3">
                        <article class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Installation rapide, equipe tres reactive. 12 terminaux sans interruption depuis 2 ans.</blockquote>
                            <footer class="mn-review__author"><div class="mn-avatar">ML</div><div><strong>Marie L.</strong><span>Directrice - Restauration, Lyon</span></div></footer>
                        </article>
                        <article class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Support 7j/7 nous a depannes un dimanche en moins de 2h. Indispensable.</blockquote>
                            <footer class="mn-review__author"><div class="mn-avatar">TB</div><div><strong>Thomas B.</strong><span>Gerant - Supermarche, Paris</span></div></footer>
                        </article>
                        <article class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Migration de 45 caisses sans interruption. Serieux et professionnel.</blockquote>
                            <footer class="mn-review__author"><div class="mn-avatar">SM</div><div><strong>Sophie M.</strong><span>DSI - Franchise, Bordeaux</span></div></footer>
                        </article>
                    </div>
                    <div class="mn-reviews__score"><div class="mn-reviews__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><strong>4,8 / 5</strong> &#8212; 312 avis verifies</div>
                </div>
            </section>

            <section class="mn-cta">
                <div class="mn-container">
                    <div class="mn-cta__inner">
                        <h2>Votre infrastructure de paiement commence par une conversation.</h2>
                        <p>Audit gratuit &#183; Devis sous 48h &#183; Sans engagement</p>
                        <div class="mn-cta__actions">
                            <a href="/contact" class="mn-btn mn-btn--white mn-btn--lg">Demander un audit gratuit</a>
                            <a href="/shop" class="mn-btn mn-btn--lg" style="border:2px solid rgba(255,255,255,0.4);color:white">Voir la boutique</a>
                        </div>
                    </div>
                </div>
            </section>

        </t>
    </template>

</odoo>
