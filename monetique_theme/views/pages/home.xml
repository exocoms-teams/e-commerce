<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="page_home" name="monetiques.fr Accueil">
  <t t-call="website.layout">
    <div id="wrap">

      <!-- ═══ HERO ══════════════════════════════════════════════ -->
      <section class="mn-hero">
        <div class="mn-container">
          <div class="mn-hero__inner">

            <div class="anim-left">
              <div class="mn-hero__badge">
                <span class="mn-hero__badge-dot"></span>
                Certifié PCI DSS · Partenaire Banque de France
              </div>
              <h1>
                Encaissez partout<br/>
                avec votre <span class="accent">TPE.</span>
              </h1>
              <p class="mn-hero__sub">
                Terminaux de paiement professionnels pour commerçants, hôtels et grandes surfaces. Livrés, installés et maintenus partout en France.
              </p>
              <div class="mn-hero__actions">
                <a href="/audit" class="btn btn-blue btn-lg">Demander un audit gratuit</a>
                <a href="/shop" class="btn btn-outline btn-lg">Voir nos produits</a>
              </div>
              <div class="mn-hero__trust">
                <span class="mn-hero__trust-item">SLA 98,5% garanti</span>
                <span class="mn-hero__trust-item">Support 7j/7</span>
                <span class="mn-hero__trust-item">+3 400 TPE actifs</span>
                <span class="mn-hero__trust-item">Installation incluse</span>
              </div>
            </div>

            <div class="mn-hero__right anim-right">
              <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=900&amp;q=85&amp;auto=format&amp;fit=crop"
                   alt="Terminal de paiement professionnel" loading="eager"/>
              <div class="mn-hero__pill">
                <div class="mn-hero__pill-icon">💳</div>
                <div>
                  <strong>Paiement accepté</strong>
                  <span>45,00 € · NFC sans contact</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- ═══ STATS ═════════════════════════════════════════════ -->
      <div class="mn-stats">
        <div class="mn-container">
          <div class="mn-stats__grid">
            <div class="mn-stat anim-up d1">
              <span class="mn-stat__num">3 400+</span>
              <span class="mn-stat__lbl">TPE actifs en France</span>
            </div>
            <div class="mn-stat anim-up d2">
              <span class="mn-stat__num">1 400+</span>
              <span class="mn-stat__lbl">Clients satisfaits</span>
            </div>
            <div class="mn-stat anim-up d3">
              <span class="mn-stat__num">98,5%</span>
              <span class="mn-stat__lbl">SLA garanti contractuellement</span>
            </div>
            <div class="mn-stat anim-up d4">
              <span class="mn-stat__num">20 ans</span>
              <span class="mn-stat__lbl">D'expertise en monétique</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ PRODUITS ══════════════════════════════════════════ -->
      <section class="mn-section">
        <div class="mn-container">
          <div class="section-head anim-up">
            <span class="tag">Nos produits</span>
            <h2>Nos solutions les plus demandées</h2>
            <p>Équipements certifiés, prêts à déployer. Livraison et installation incluses partout en France.</p>
          </div>
          <div class="mn-products__grid">
            <div class="mn-pcard anim-up d1">
              <div class="mn-pcard__img">
                <img src="https://images.unsplash.com/photo-1622782914767-404fb9ab3f57?w=600&amp;q=80&amp;auto=format&amp;fit=crop" alt="TPE Fixe Ingenico" loading="lazy"/>
              </div>
              <div class="mn-pcard__body">
                <div class="mn-pcard__cat">TPE Fixe</div>
                <div class="mn-pcard__name">TPE Ingenico TETRA Desk 5000 Fixe</div>
                <div class="mn-pcard__foot">
                  <span class="mn-pcard__price">215,00<span class="mn-pcard__price-ht"> € HT</span></span>
                  <a href="/shop" class="btn btn-blue btn-sm">Voir</a>
                </div>
              </div>
            </div>
            <div class="mn-pcard anim-up d2">
              <div class="mn-pcard__img">
                <img src="https://images.unsplash.com/photo-1563013544-824ae1b704d3?w=600&amp;q=80&amp;auto=format&amp;fit=crop" alt="TPE Portable" loading="lazy"/>
              </div>
              <div class="mn-pcard__body">
                <div class="mn-pcard__cat">TPE Portable</div>
                <div class="mn-pcard__name">TPE Ingenico TETRA Move 5000 Portable 4G WiFi</div>
                <div class="mn-pcard__foot">
                  <span class="mn-pcard__price">490,00<span class="mn-pcard__price-ht"> € HT</span></span>
                  <a href="/shop" class="btn btn-blue btn-sm">Voir</a>
                </div>
              </div>
            </div>
            <div class="mn-pcard anim-up d3">
              <div class="mn-pcard__img">
                <img src="https://images.unsplash.com/photo-1556742393-d75f468bfcb0?w=600&amp;q=80&amp;auto=format&amp;fit=crop" alt="Terminal paiement sans contact" loading="lazy"/>
              </div>
              <div class="mn-pcard__body">
                <div class="mn-pcard__cat">Pinpad</div>
                <div class="mn-pcard__name">Pinpad Ingenico TETRA Lane 3000</div>
                <div class="mn-pcard__foot">
                  <span class="mn-pcard__price">590,00<span class="mn-pcard__price-ht"> € HT</span></span>
                  <a href="/shop" class="btn btn-blue btn-sm">Voir</a>
                </div>
              </div>
            </div>
            <div class="mn-pcard anim-up d4">
              <div class="mn-pcard__img">
                <img src="https://images.unsplash.com/photo-1612831455359-970e23a1e4e9?w=600&amp;q=80&amp;auto=format&amp;fit=crop" alt="Scanner chèques" loading="lazy"/>
              </div>
              <div class="mn-pcard__body">
                <div class="mn-pcard__cat">Scanner</div>
                <div class="mn-pcard__name">Scanner Panini Vision VX50 — 1 Poche</div>
                <div class="mn-pcard__foot">
                  <span class="mn-pcard__price">1 200,00<span class="mn-pcard__price-ht"> € HT</span></span>
                  <a href="/shop" class="btn btn-blue btn-sm">Voir</a>
                </div>
              </div>
            </div>
          </div>
          <div style="text-align:center;margin-top:48px">
            <a href="/shop" class="btn btn-outline btn-lg">Voir tous nos produits →</a>
          </div>
        </div>
      </section>

      <!-- ═══ FEATURES ══════════════════════════════════════════ -->
      <section class="mn-section mn-section-gray">
        <div class="mn-container">
          <div class="section-head anim-up">
            <span class="tag">Pourquoi nous choisir</span>
            <h2>Une expertise métier depuis 20 ans</h2>
            <p>Nous accompagnons commerçants, hôtels, pharmacies et grandes surfaces dans toute la France.</p>
          </div>
          <div class="mn-feats__grid">
            <div class="mn-feat anim-up d1">
              <div class="mn-feat__icon">🔒</div>
              <h3>Sécurité PCI DSS niveau 1</h3>
              <p>Tous nos terminaux sont certifiés. Vos transactions sont chiffrées de bout en bout, conformes aux normes bancaires européennes.</p>
            </div>
            <div class="mn-feat anim-up d2">
              <div class="mn-feat__icon">⚡</div>
              <h3>Déploiement en 48h</h3>
              <p>Livraison express, installation sur site et formation de votre équipe incluses. Opérationnel en moins de 48 heures.</p>
            </div>
            <div class="mn-feat anim-up d3">
              <div class="mn-feat__icon">📞</div>
              <h3>Support 7j/7</h3>
              <p>Une équipe technique dédiée disponible 7 jours sur 7. SLA de 98,5% garanti contractuellement avec intervention sous 4h.</p>
            </div>
            <div class="mn-feat anim-up d1">
              <div class="mn-feat__icon">🔧</div>
              <h3>Maintenance préventive</h3>
              <p>Contrats de maintenance préventive et curative. Vos équipements sont vérifiés et mis à jour régulièrement.</p>
            </div>
            <div class="mn-feat anim-up d2">
              <div class="mn-feat__icon">💳</div>
              <h3>Tous moyens de paiement</h3>
              <p>CB, Visa, Mastercard, American Express, NFC sans contact, Apple Pay, Google Pay, chèques — tout est accepté.</p>
            </div>
            <div class="mn-feat anim-up d3">
              <div class="mn-feat__icon">📊</div>
              <h3>Reporting en temps réel</h3>
              <p>Dashboard de suivi des transactions, remontées comptables automatiques, rapprochement bancaire simplifié.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ CAS D'USAGE ════════════════════════════════════════ -->
      <section class="mn-section">
        <div class="mn-container">
          <div class="section-head anim-up">
            <span class="tag">Cas d'usage</span>
            <h2>Une solution pour chaque commerce</h2>
            <p>De la boulangerie à l'hôtel 5 étoiles, nous avons la solution adaptée à votre activité.</p>
          </div>
          <div class="mn-usages__grid">
            <div class="mn-usage anim-up d1">
              <img src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=700&amp;q=80&amp;auto=format&amp;fit=crop" alt="Restaurants et bars" loading="lazy"/>
              <div class="mn-usage__overlay"></div>
              <div class="mn-usage__text">
                <h3>Restaurants &amp; Bars</h3>
                <p>Encaissez en salle, au comptoir ou en terrasse. Fini les files d'attente.</p>
              </div>
            </div>
            <div class="mn-usage anim-up d2">
              <img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=700&amp;q=80&amp;auto=format&amp;fit=crop" alt="Pharmacies et santé" loading="lazy"/>
              <div class="mn-usage__overlay"></div>
              <div class="mn-usage__text">
                <h3>Pharmacies &amp; Santé</h3>
                <p>Conformité totale, tiers payant facilité, terminaux robustes pour un usage intensif.</p>
              </div>
            </div>
            <div class="mn-usage anim-up d3">
              <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?w=700&amp;q=80&amp;auto=format&amp;fit=crop" alt="Hôtels et tourisme" loading="lazy"/>
              <div class="mn-usage__overlay"></div>
              <div class="mn-usage__text">
                <h3>Hôtels &amp; Tourisme</h3>
                <p>Check-in fluide, paiement à distance, reporting centralisé pour votre établissement.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ TÉMOIGNAGES ════════════════════════════════════════ -->
      <section class="mn-section mn-section-gray">
        <div class="mn-container">
          <div class="section-head anim-up">
            <span class="tag">Témoignages clients</span>
            <h2>Ils nous font confiance</h2>
            <p>Plus de 1 400 entreprises utilisent nos solutions de paiement au quotidien.</p>
          </div>
          <div class="mn-reviews__grid">
            <div class="mn-review anim-up d1">
              <div class="mn-review__stars">★★★★★</div>
              <blockquote>Déployé 30 TPE en une semaine pour notre réseau de pharmacies. Zéro panne, zéro stress. Un partenaire de confiance.</blockquote>
              <div class="mn-review__who">
                <div class="mn-avatar">NK</div>
                <div>
                  <strong>Nadia K.</strong>
                  <span>Responsable IT — Groupe Pharmavie, Lille</span>
                </div>
              </div>
            </div>
            <div class="mn-review anim-up d2">
              <div class="mn-review__stars">★★★★★</div>
              <blockquote>Notre hôtel utilise leurs terminaux depuis 3 saisons. La remontée des paiements en temps réel a complètement changé notre gestion.</blockquote>
              <div class="mn-review__who">
                <div class="mn-avatar">AC</div>
                <div>
                  <strong>Alexandre C.</strong>
                  <span>Directeur — Hôtel Le Belmont, Nice</span>
                </div>
              </div>
            </div>
            <div class="mn-review anim-up d3">
              <div class="mn-review__stars">★★★★★</div>
              <blockquote>L'onboarding était impeccable. Mon équipe formée en 2h chrono. Excellent rapport qualité/prix, je recommande sans hésiter.</blockquote>
              <div class="mn-review__who">
                <div class="mn-avatar">RL</div>
                <div>
                  <strong>Rachid L.</strong>
                  <span>Gérant — Boulangerie Artisane, Toulouse</span>
                </div>
              </div>
            </div>
          </div>
          <div class="mn-reviews__score anim-up">
            <span class="mn-reviews__score-stars">★★★★★</span>
            4,9 / 5 — 487 avis vérifiés
          </div>
        </div>
      </section>

      <!-- ═══ CTA ════════════════════════════════════════════════ -->
      <section class="mn-cta">
        <div class="mn-container">
          <div class="mn-cta__inner anim-up">
            <h2>Votre infrastructure de paiement<br/>commence par une conversation.</h2>
            <p>Audit gratuit · Devis sous 48h · Sans engagement · Installation incluse</p>
            <div class="mn-cta__actions">
              <a href="/audit" class="btn btn-blue btn-lg">Demander un audit gratuit</a>
              <a href="/shop" class="btn btn-ghost-w btn-lg">Voir la boutique</a>
            </div>
          </div>
        </div>
      </section>

    </div>
  </t>
</template>
</odoo>
