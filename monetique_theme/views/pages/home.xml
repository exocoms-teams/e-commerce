<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_home" name="monetiques.fr - Accueil">
        <t t-call="monetique_theme.layout">

            <t t-call="monetique_theme.trust_badge"/>
            <t t-call="monetique_theme.stats_section"/>

            <section class="pc-section pc-services-home" aria-label="Nos solutions">
                <div class="pc-container">
                    <div class="pc-section__header">
                        <span class="pc-eyebrow">Nos solutions</span>
                        <h2 class="pc-h2">Tout ce dont vous avez besoin pour encaisser sereinement</h2>
                        <p class="pc-lead">De l equipement physique a l integration logicielle, nous couvrons votre infrastructure de paiement.</p>
                    </div>
                    <div class="pc-services-home__grid">
                        <a href="/solutions/tpe" class="pc-card pc-card--service-lg">
                            <div class="pc-card__tag">Materiel</div>
                            <h3>Terminaux TPE</h3>
                            <p>Fixes, mobiles, Android. Installation et formation inclus.</p>
                            <span class="pc-card__arrow">&#8594;</span>
                        </a>
                        <a href="/solutions/encaissement" class="pc-card pc-card--service-lg">
                            <div class="pc-card__tag">Logiciel</div>
                            <h3>Encaissement</h3>
                            <p>Solutions certifiees NF525. Reporting temps reel.</p>
                            <span class="pc-card__arrow">&#8594;</span>
                        </a>
                        <a href="/solutions/paiement-omnicanal" class="pc-card pc-card--service-lg pc-card--featured">
                            <div class="pc-card__tag pc-card__tag--blue">Nouveau</div>
                            <h3>Paiement Omnicanal</h3>
                            <p>Magasin, web et mobile. Une seule plateforme.</p>
                            <span class="pc-card__arrow">&#8594;</span>
                        </a>
                        <a href="/support" class="pc-card pc-card--service-lg">
                            <div class="pc-card__tag">Service</div>
                            <h3>Support Technique</h3>
                            <p>Hotline dediee 7j/7. SLA garanti 98,5%.</p>
                            <span class="pc-card__arrow">&#8594;</span>
                        </a>
                    </div>
                </div>
            </section>

            <t t-call="monetique_theme.partners_section"/>
            <t t-call="monetique_theme.engagements_section"/>

            <section class="pc-reviews" aria-label="Temoignages clients">
                <div class="pc-container">
                    <div class="pc-section-header">
                        <span class="pc-eyebrow">Temoignages</span>
                        <h2 class="pc-h2">Ce que disent nos clients</h2>
                        <p class="pc-lead">Plus de 1 400 professionnels nous font confiance.</p>
                    </div>
                    <div class="pc-reviews__grid">
                        <article class="pc-review-card">
                            <div class="pc-review-card__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote class="pc-review-card__text">Installation rapide, equipe tres reactive. 12 terminaux sans interruption depuis 2 ans.</blockquote>
                            <footer class="pc-review-card__author">
                                <div class="pc-review-card__avatar">ML</div>
                                <div><strong>Marie L.</strong><span>Directrice - Restauration, Lyon</span></div>
                            </footer>
                        </article>
                        <article class="pc-review-card">
                            <div class="pc-review-card__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote class="pc-review-card__text">Support 7j/7 nous a depannes un dimanche en moins de 2h. Indispensable.</blockquote>
                            <footer class="pc-review-card__author">
                                <div class="pc-review-card__avatar">TB</div>
                                <div><strong>Thomas B.</strong><span>Gerant - Supermarche, Paris</span></div>
                            </footer>
                        </article>
                        <article class="pc-review-card">
                            <div class="pc-review-card__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote class="pc-review-card__text">Migration de 45 caisses sans interruption. Serieux et professionnel.</blockquote>
                            <footer class="pc-review-card__author">
                                <div class="pc-review-card__avatar">SM</div>
                                <div><strong>Sophie M.</strong><span>DSI - Franchise, Bordeaux</span></div>
                            </footer>
                        </article>
                    </div>
                    <div class="pc-reviews__score">
                        <div class="pc-reviews__score-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <div class="pc-reviews__score-text"><strong>4,8 / 5</strong> - 312 avis verifies</div>
                    </div>
                </div>
            </section>

            <section class="pc-cta-final">
                <div class="pc-container">
                    <div class="pc-cta-final__inner">
                        <div class="pc-cta-final__bg" aria-hidden="true"></div>
                        <h2 class="pc-cta-final__title">Votre infrastructure de paiement commence par une conversation.</h2>
                        <p class="pc-cta-final__sub">Audit gratuit - Devis sous 48h - Sans engagement</p>
                        <div class="pc-cta-final__actions">
                            <a href="/contact" class="pc-btn pc-btn--white pc-btn--lg">Demander un audit gratuit</a>
                        </div>
                    </div>
                </div>
            </section>

        </t>
    </template>

    <record id="website_page_home" model="website.page">
        <field name="name">Accueil</field>
        <field name="url">/</field>
        <field name="view_id" ref="monetique_theme.page_home"/>
        <field name="website_published">True</field>
        <field name="is_homepage">True</field>
    </record>

</odoo>
