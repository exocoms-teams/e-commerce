<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_home" name="monetiques.fr Accueil">
        <t t-call="website.layout">

            <section class="mn-hero">
                <div class="mn-container">
                    <div class="mn-hero__inner">
                        <div class="mn-hero__content">
                            <div class="mn-hero__badge">
                                <span class="mn-dot"></span>
                                Certifie PCI DSS &#183; Partenaire Banque de France
                            </div>
                            <h1 class="mn-hero__title">
                                L'infrastructure de paiement
                                <span class="mn-hero__accent">qui ne tombe jamais</span>
                            </h1>
                            <p class="mn-hero__desc">
                                Terminaux TPE, logiciels de caisse, paiement omnicanal.
                                Installation, maintenance et support 7j/7.
                            </p>
                            <div class="mn-hero__actions">
                                <a href="/contact" class="mn-btn mn-btn--primary mn-btn--lg">Demander un audit gratuit</a>
                                <a href="/shop" class="mn-btn mn-btn--outline mn-btn--lg">Voir nos produits</a>
                            </div>
                            <div class="mn-hero__trust">
                                <span>&#10003; SLA 98.5% garanti</span>
                                <span>&#10003; Support 7j/7</span>
                                <span>&#10003; +3400 TPE actifs</span>
                            </div>
                        </div>
                        <div class="mn-hero__visual">
                            <div class="mn-mockup">
                                <div class="mn-mockup__header">
                                    <span class="mn-mockup__dot"></span>
                                    <span class="mn-mockup__dot"></span>
                                    <span class="mn-mockup__dot"></span>
                                    <span class="mn-mockup__title">Dashboard Paiement</span>
                                </div>
                                <div class="mn-mockup__body">
                                    <div class="mn-mockup__stat">
                                        <span class="mn-mockup__label">Disponibilite</span>
                                        <span class="mn-mockup__value mn-mockup__value--green">99.8%</span>
                                    </div>
                                    <div class="mn-mockup__stat">
                                        <span class="mn-mockup__label">Transactions / jour</span>
                                        <span class="mn-mockup__value">28 940</span>
                                    </div>
                                    <div class="mn-mockup__stat">
                                        <span class="mn-mockup__label">TPE actifs</span>
                                        <span class="mn-mockup__value">3 412</span>
                                    </div>
                                    <div class="mn-mockup__bar-wrap">
                                        <div class="mn-mockup__bar" style="width:99%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <t t-call="monetique_theme.stats_section"/>

            <section class="mn-section mn-solutions">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Nos solutions</span>
                        <h2>Tout ce dont vous avez besoin pour encaisser sereinement</h2>
                    </div>
                    <div class="mn-grid mn-grid--4">
                        <a href="/solutions/tpe" class="mn-card mn-card--solution">
                            <h3>Terminaux TPE</h3>
                            <p>Fixes, mobiles, Android. Installation et formation inclus.</p>
                            <span class="mn-card__arrow">&#8594;</span>
                        </a>
                        <a href="/solutions/encaissement" class="mn-card mn-card--solution">
                            <h3>Encaissement</h3>
                            <p>Logiciels certifies NF525. Reporting temps reel.</p>
                            <span class="mn-card__arrow">&#8594;</span>
                        </a>
                        <a href="/solutions/paiement-omnicanal" class="mn-card mn-card--solution mn-card--featured">
                            <h3>Paiement Omnicanal</h3>
                            <p>Magasin, web et mobile. Une seule plateforme.</p>
                            <span class="mn-card__arrow">&#8594;</span>
                        </a>
                        <a href="/support" class="mn-card mn-card--solution">
                            <h3>Support 7j/7</h3>
                            <p>Hotline dediee, interventions sur site. SLA 98.5%.</p>
                            <span class="mn-card__arrow">&#8594;</span>
                        </a>
                    </div>
                    <div class="mn-section__footer">
                        <a href="/shop" class="mn-btn mn-btn--outline">Voir tous nos produits &#8594;</a>
                    </div>
                </div>
            </section>

            <section class="mn-section mn-reviews">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Temoignages</span>
                        <h2>Ce que disent nos clients</h2>
                    </div>
                    <div class="mn-grid mn-grid--3">
                        <article class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Installation rapide, equipe tres reactive. 12 terminaux sans interruption depuis 2 ans.</blockquote>
                            <footer class="mn-review__author">
                                <div class="mn-avatar">ML</div>
                                <div><strong>Marie L.</strong><span>Directrice - Restauration, Lyon</span></div>
                            </footer>
                        </article>
                        <article class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Support 7j/7 nous a depannes un dimanche en moins de 2h. Indispensable.</blockquote>
                            <footer class="mn-review__author">
                                <div class="mn-avatar">TB</div>
                                <div><strong>Thomas B.</strong><span>Gerant - Supermarche, Paris</span></div>
                            </footer>
                        </article>
                        <article class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Migration de 45 caisses sans interruption. Serieux et professionnel.</blockquote>
                            <footer class="mn-review__author">
                                <div class="mn-avatar">SM</div>
                                <div><strong>Sophie M.</strong><span>DSI - Franchise, Bordeaux</span></div>
                            </footer>
                        </article>
                    </div>
                </div>
            </section>

            <section class="mn-cta">
                <div class="mn-container">
                    <div class="mn-cta__inner">
                        <h2>Votre infrastructure de paiement commence par une conversation.</h2>
                        <p>Audit gratuit &#183; Devis sous 48h &#183; Sans engagement</p>
                        <div class="mn-cta__actions">
                            <a href="/contact" class="mn-btn mn-btn--white mn-btn--lg">Demander un audit gratuit</a>
                        </div>
                    </div>
                </div>
            </section>

        </t>
    </template>

</odoo>
