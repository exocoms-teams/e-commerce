<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_home" name="monetiques.fr - Accueil" inherit_id="monetique_theme.layout">
        <xpath expr="//main[@id='wrap']" position="replace">

        <main id="wrap" role="main">

            <section class="pc-hero" aria-label="Introduction">
                <div class="pc-hero__grid" aria-hidden="true"></div>
                <div class="pc-hero__orb pc-hero__orb--1" aria-hidden="true"></div>
                <div class="pc-hero__orb pc-hero__orb--2" aria-hidden="true"></div>
                <div class="pc-container">
                    <div class="pc-hero__inner">
                        <div class="pc-hero__content" data-animate="hero">
                            <div class="pc-hero__announce">
                                <span class="pc-hero__announce-dot" aria-hidden="true"></span>
                                <span>Certifie PCI DSS - Partenaire agree Banque de France</span>
                            </div>
                            <h1 class="pc-hero__title">
                                L infrastructure de paiement<br/>
                                <span class="pc-hero__title-accent">qui ne tombe jamais</span>
                            </h1>
                            <p class="pc-hero__lead">
                                Terminaux TPE, logiciels de caisse, paiement omnicanal.
                                Installation, maintenance et support 7j/7 pour les commercants francais.
                            </p>
                            <div class="pc-hero__actions">
                                <a href="/contact" class="pc-btn pc-btn--primary pc-btn--lg">Demander un audit gratuit</a>
                                <a href="/solutions/tpe" class="pc-btn pc-btn--ghost pc-btn--lg">Decouvrir nos solutions</a>
                            </div>
                            <div class="pc-hero__trust">
                                <span class="pc-hero__trust-item">SLA 98,5% garanti</span>
                                <span class="pc-hero__trust-sep">.</span>
                                <span class="pc-hero__trust-item">+3 400 TPE actifs</span>
                                <span class="pc-hero__trust-sep">.</span>
                                <span class="pc-hero__trust-item">Support 7j/7</span>
                            </div>
                        </div>
                        <div class="pc-hero__visual" aria-hidden="true">
                            <div class="pc-terminal-mockup">
                                <div class="pc-terminal-mockup__screen">
                                    <div class="pc-terminal-mockup__header">
                                        <span class="pc-terminal-mockup__dot"></span>
                                        <span class="pc-terminal-mockup__dot"></span>
                                        <span class="pc-terminal-mockup__dot"></span>
                                        <span class="pc-terminal-mockup__title">Dashboard Paiement</span>
                                    </div>
                                    <div class="pc-terminal-mockup__display">
                                        <div class="pc-terminal-mockup__stat">
                                            <span class="pc-terminal-mockup__label">Disponibilite</span>
                                            <span class="pc-terminal-mockup__value">99.8%</span>
                                        </div>
                                        <div class="pc-terminal-mockup__stat">
                                            <span class="pc-terminal-mockup__label">Transactions / jour</span>
                                            <span class="pc-terminal-mockup__value">28 940</span>
                                        </div>
                                        <div class="pc-terminal-mockup__bar-wrap">
                                            <div class="pc-terminal-mockup__bar" style="width:99%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <t t-call="monetique_theme.trust_badge"/>
            <t t-call="monetique_theme.stats_section"/>

            <section class="pc-section pc-services-home" aria-label="Nos solutions">
                <div class="pc-container">
                    <div class="pc-section__header">
                        <span class="pc-eyebrow">Nos solutions</span>
                        <h2 class="pc-h2">Tout ce dont vous avez besoin pour encaisser sereinement</h2>
                        <p class="pc-lead">De l equipement physique a l integration logicielle, nous couvrons l integralite de votre infrastructure de paiement.</p>
                    </div>
                    <div class="pc-services-home__grid">
                        <a href="/solutions/tpe" class="pc-card pc-card--service-lg" data-animate="fade-up">
                            <div class="pc-card__tag">Materiel</div>
                            <h3>Terminaux TPE</h3>
                            <p>Fixes, mobiles, Android. Installation, parametrage et formation inclus. Maintenance garantie.</p>
                            <span class="pc-card__arrow">&#8594;</span>
                        </a>
                        <a href="/solutions/encaissement" class="pc-card pc-card--service-lg" data-animate="fade-up" data-delay="80">
                            <div class="pc-card__tag">Logiciel</div>
                            <h3>Encaissement</h3>
                            <p>Solutions de caisse connectees, certifiees NF525. Gestion des tickets, inventaire, reporting temps reel.</p>
                            <span class="pc-card__arrow">&#8594;</span>
                        </a>
                        <a href="/solutions/paiement-omnicanal" class="pc-card pc-card--service-lg pc-card--featured" data-animate="fade-up" data-delay="160">
                            <div class="pc-card__tag pc-card__tag--blue">Nouveau</div>
                            <h3>Paiement Omnicanal</h3>
                            <p>Unifiez paiement en magasin, en ligne et sur mobile. Une seule plateforme, une seule reconciliation.</p>
                            <span class="pc-card__arrow">&#8594;</span>
                        </a>
                        <a href="/support" class="pc-card pc-card--service-lg" data-animate="fade-up" data-delay="240">
                            <div class="pc-card__tag">Service</div>
                            <h3>Support Technique</h3>
                            <p>Hotline dediee, interventions sur site, maintenance preventive. SLA contractuel garanti 98,5%.</p>
                            <span class="pc-card__arrow">&#8594;</span>
                        </a>
                    </div>
                    <div class="pc-section__footer">
                        <a href="/services" class="pc-btn pc-btn--outline">Tous nos services</a>
                    </div>
                </div>
            </section>

            <t t-call="monetique_theme.partners_section"/>
            <t t-call="monetique_theme.engagements_section"/>

            <section class="pc-reviews" aria-label="Temoignages clients">
                <div class="pc-container">
                    <div class="pc-section-header" data-animate="fade-up">
                        <span class="pc-eyebrow">Temoignages</span>
                        <h2 class="pc-h2">Ce que disent nos clients</h2>
                        <p class="pc-lead">Plus de 1 400 professionnels nous font confiance au quotidien.</p>
                    </div>
                    <div class="pc-reviews__grid">
                        <article class="pc-review-card" data-animate="fade-up">
                            <div class="pc-review-card__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote class="pc-review-card__text">Installation rapide, equipe tres reactive. Nos 12 terminaux fonctionnent parfaitement depuis 2 ans sans aucune interruption.</blockquote>
                            <footer class="pc-review-card__author">
                                <div class="pc-review-card__avatar">ML</div>
                                <div><strong>Marie L.</strong><span>Directrice - Chaine restauration, Lyon</span></div>
                            </footer>
                        </article>
                        <article class="pc-review-card" data-animate="fade-up" data-delay="100">
                            <div class="pc-review-card__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote class="pc-review-card__text">Le support 7j/7 nous a depannes un dimanche soir en moins de 2 heures. Indispensable pour ne pas arreter l encaissement.</blockquote>
                            <footer class="pc-review-card__author">
                                <div class="pc-review-card__avatar">TB</div>
                                <div><strong>Thomas B.</strong><span>Gerant - Supermarche independant, Paris</span></div>
                            </footer>
                        </article>
                        <article class="pc-review-card" data-animate="fade-up" data-delay="200">
                            <div class="pc-review-card__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote class="pc-review-card__text">Migration de 45 caisses vers leur solution omnicanal sans aucune interruption. Serieux, professionnel, toujours disponible.</blockquote>
                            <footer class="pc-review-card__author">
                                <div class="pc-review-card__avatar">SM</div>
                                <div><strong>Sophie M.</strong><span>DSI - Franchise nationale, Bordeaux</span></div>
                            </footer>
                        </article>
                        <article class="pc-review-card" data-animate="fade-up" data-delay="300">
                            <div class="pc-review-card__stars">&#9733;&#9733;&#9733;&#9733;&#9734;</div>
                            <blockquote class="pc-review-card__text">Tres bon rapport qualite/prix. Le tableau de bord en temps reel est un vrai plus.</blockquote>
                            <footer class="pc-review-card__author">
                                <div class="pc-review-card__avatar">PD</div>
                                <div><strong>Pierre D.</strong><span>Responsable IT - GSS Distribution, Nantes</span></div>
                            </footer>
                        </article>
                        <article class="pc-review-card" data-animate="fade-up" data-delay="400">
                            <div class="pc-review-card__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote class="pc-review-card__text">Nous avons deploye leur solution dans 23 points de vente en 3 semaines. La gestion centralisee est exactement ce qu il nous fallait.</blockquote>
                            <footer class="pc-review-card__author">
                                <div class="pc-review-card__avatar">AC</div>
                                <div><strong>Audrey C.</strong><span>Directrice Operations - Reseau franchise, Toulouse</span></div>
                            </footer>
                        </article>
                        <article class="pc-review-card" data-animate="fade-up" data-delay="500">
                            <div class="pc-review-card__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote class="pc-review-card__text">Integration avec notre ERP Odoo sans probleme. Les rapports sont clairs et exportables directement.</blockquote>
                            <footer class="pc-review-card__author">
                                <div class="pc-review-card__avatar">RK</div>
                                <div><strong>Romain K.</strong><span>CFO - Startup retail, Paris</span></div>
                            </footer>
                        </article>
                    </div>
                    <div class="pc-reviews__score" data-animate="fade-up">
                        <div class="pc-reviews__score-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <div class="pc-reviews__score-text"><strong>4,8 / 5</strong> - base sur 312 avis verifies</div>
                    </div>
                </div>
            </section>

            <section class="pc-cta-final" aria-label="Appel a l action">
                <div class="pc-container">
                    <div class="pc-cta-final__inner">
                        <div class="pc-cta-final__bg" aria-hidden="true"></div>
                        <h2 class="pc-cta-final__title">Votre infrastructure de paiement<br/>commence par une conversation.</h2>
                        <p class="pc-cta-final__sub">Audit gratuit - Devis sous 48h - Sans engagement</p>
                        <div class="pc-cta-final__actions">
                            <a href="/contact" class="pc-btn pc-btn--white pc-btn--lg">Demander un audit gratuit</a>
                            <a href="tel:+33XXXXXXXXX" class="pc-cta-final__phone">Ou appelez le +33 (0)X XX XX XX XX</a>
                        </div>
                    </div>
                </div>
            </section>

        </main>

        </xpath>
    </template>

</odoo>
