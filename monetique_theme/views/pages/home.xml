            <!-- CSS navbar active + hover -->
            <style>
                /* Hover navbar */
                .o_main_navbar .nav-link { transition: color .2s; position: relative; }
                .o_main_navbar .nav-link::after {
                    content: '';
                    position: absolute;
                    bottom: -2px; left: 50%; right: 50%;
                    height: 2px;
                    background: #C62828;
                    transition: left .2s, right .2s;
                    border-radius: 2px;
                }
                .o_main_navbar .nav-link:hover { color: #C62828 !important; }
                .o_main_navbar .nav-link:hover::after { left: 0; right: 0; }
                .o_main_navbar .nav-link.active,
                .o_main_navbar .nav-link[aria-current="page"] {
                    color: #C62828 !important;
                    font-weight: 600;
                }
                .o_main_navbar .nav-link.active::after,
                .o_main_navbar .nav-link[aria-current="page"]::after { left: 0; right: 0; }

                /* Animation illustration hero */
                @keyframes heroFloat    { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
                @keyframes heroPulse    { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .7; transform: scale(.95); } }
                @keyframes heroSpin     { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
                @keyframes heroBlink    { 0%,100% { opacity: 1; } 40%,60% { opacity: 0; } }
                @keyframes heroSlideIn  { from { opacity: 0; transform: translateX(40px); } to { opacity: 1; transform: translateX(0); } }
                @keyframes heroBounce   { 0%,100% { transform: translateY(0) scale(1); } 30% { transform: translateY(-6px) scale(1.05); } 60% { transform: translateY(2px) scale(.98); } }
                @keyframes heroRipple   { 0% { transform: scale(.8); opacity: .6; } 100% { transform: scale(2.2); opacity: 0; } }
                @keyframes heroCount    { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

                .hero-illustration { animation: heroSlideIn .8s ease .2s both; }
                .hero-building     { animation: heroFloat 4s ease-in-out infinite; }
                .hero-badge        { animation: heroBounce 3s ease-in-out infinite; }
                .hero-ring1        { animation: heroRipple 2.5s ease-out infinite; }
                .hero-ring2        { animation: heroRipple 2.5s ease-out .8s infinite; }
                .hero-dot-blink    { animation: heroBlink 1.5s step-start infinite; }
                .hero-gear         { animation: heroSpin 8s linear infinite; transform-origin: center; }
                .hero-stat         { animation: heroCount .6s ease both; }
                .hero-stat:nth-child(2) { animation-delay: .2s; }
                .hero-stat:nth-child(3) { animation-delay: .4s; }
            </style>

