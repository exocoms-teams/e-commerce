<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_home" name="monetiques.fr Accueil">
        <t t-call="website.layout">

            <!-- Hero Section -->
            <section class="mn-hero">
                <div class="mn-hero__bg-grid"></div>
                <div class="mn-hero__glow mn-hero__glow--1"></div>
                <div class="mn-hero__glow mn-hero__glow--2"></div>

                <div class="mn-container">
                    <div class="mn-hero__inner">
                        <!-- Content Left -->
                        <div class="mn-hero__content">
                            <div class="mn-hero__badge">
                                <span class="mn-dot"></span>
                                <span class="mn-badge-text">Certifié PCI DSS &#183; Partenaire Banque de France</span>
                            </div>
                            <h1 class="mn-hero__title">
                                L'infrastructure de paiement
                                <span class="mn-hero__accent">qui ne tombe jamais</span>
                            </h1>
                            <p class="mn-hero__desc">
                                Terminaux TPE, logiciels de caisse, paiement omnicanal. Installation, maintenance et support 7j/7.
                            </p>
                            <div class="mn-hero__actions">
                                <a href="/contactus" class="mn-btn mn-btn--primary mn-btn--lg">
                                    <span>Demander un audit gratuit</span>
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                </a>
                                <a href="/shop" class="mn-btn mn-btn--outline mn-btn--lg">Voir nos produits</a>
                            </div>
                            <div class="mn-hero__trust">
                                <span><i class="mn-icon-check">✓</i> SLA 99.9% garanti</span>
                                <span><i class="mn-icon-check">✓</i> Support 7j/7</span>
                                <span><i class="mn-icon-check">✓</i> +3 400 TPE actifs</span>
                            </div>
                        </div>

                        <!-- Visual Right -->
                        <div class="mn-hero__visual">
                            <div class="mn-visual-card">
                                <svg viewBox="0 0 480 360" xmlns="http://www.w3.org/2000/svg" fill="none" class="mn-visual-svg">
                                    <defs>
                                        <filter id="sh-main" x="-20%" y="-20%" width="140%" height="140%">
                                            <feDropShadow dx="0" dy="16" stdDeviation="24" flood-color="#020617" flood-opacity="0.25"/>
                                        </filter>
                                        <filter id="sh-card" x="-20%" y="-20%" width="140%" height="140%">
                                            <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#1E40AF" flood-opacity="0.3"/>
                                        </filter>
                                        <linearGradient id="grad-card" x1="0%" y1="0%" x2="100%" y2="100%">
                                            <stop offset="0%" stop-color="#2563EB"/>
                                            <stop offset="100%" stop-color="#1D4ED8"/>
                                        </linearGradient>
                                        <linearGradient id="grad-screen" x1="0%" y1="0%" x2="0%" y2="100%">
                                            <stop offset="0%" stop-color="#0F172A"/>
                                            <stop offset="100%" stop-color="#1E293B"/>
                                        </linearGradient>
                                    </defs>

                                    <!-- Main Container Card -->
                                    <rect x="50" y="20" width="380" height="320" rx="28" fill="#FFFFFF" filter="url(#sh-main)"/>
                                    
                                    <!-- Floating Credit Card -->
                                    <g class="mn-anim-float-slow">
                                        <rect x="70" y="70" width="160" height="100" rx="12" fill="url(#grad-card)" filter="url(#sh-card)"/>
                                        <rect x="88" y="90" width="28" height="20" rx="4" fill="#FCE7F3" opacity="0.8"/>
                                        <circle cx="205" cy="145" r="10" fill="#EF4444" opacity="0.8"/>
                                        <circle cx="193" cy="145" r="10" fill="#F59E0B" opacity="0.8"/>
                                        <line x1="88" y1="148" x2="140" y2="148" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity="0.6"/>
                                    </g>

                                    <!-- TPE Terminal -->
                                    <rect x="230" y="45" width="160" height="250" rx="20" fill="#0F172A"/>
                                    <rect x="242" y="57" width="136" height="135" rx="12" fill="url(#grad-screen)"/>
                                    
                                    <!-- Screen Content -->
                                    <text x="310" y="95" text-anchor="middle" font-family="'Inter', sans-serif" font-size="11" fill="#94A3B8" font-weight="500">Montant à payer</text>
                                    <text x="310" y="128" text-anchor="middle" font-family="'Inter', sans-serif" font-size="28" font-weight="800" fill="#FFFFFF">45,60 €</text>

                                    <!-- NFC Signal Waves -->
                                    <g class="mn-anim-pulse-waves">
                                        <path d="M295 150 Q310 142 325 150" stroke="#60A5FA" stroke-width="2.5" stroke-linecap="round"/>
                                        <path d="M290 156 Q310 145 330 156" stroke="#3B82F6" stroke-width="2.5" stroke-linecap="round"/>
                                    </g>

                                    <!-- Keypad Buttons -->
                                    <rect x="250" y="204" width="34" height="20" rx="6" fill="#1E293B"/>
                                    <rect x="293" y="204" width="34" height="20" rx="6" fill="#1E293B"/>
                                    <rect x="336" y="204" width="34" height="20" rx="6" fill="#10B981"/>
                                    
                                    <rect x="250" y="230" width="34" height="20" rx="6" fill="#EF4444"/>
                                    <rect x="293" y="230" width="34" height="20" rx="6" fill="#1E293B"/>
                                    <rect x="336" y="230" width="34" height="20" rx="6" fill="#1E293B"/>

                                    <!-- Accepted Status Badge -->
                                    <g class="mn-anim-float">
                                        <rect x="110" y="260" width="180" height="42" rx="21" fill="#F0FDF4" stroke="#86EFAC" stroke-width="1.5"/>
                                        <circle cx="134" cy="281" r="6" fill="#10B981" class="mn-anim-glow-dot"/>
                                        <text x="150" y="285" font-family="'Inter', sans-serif" font-size="13" font-weight="700" fill="#166534">Paiement accepté</text>
                                    </g>
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <t t-call="monetique_theme.stats_section"/>

            <!-- Services overview -->
            <section class="mn-home-services">
                <div class="mn-container mn-home-services__inner">
                    <div>
                        <span class="mn-eyebrow">Un accompagnement complet</span>
                        <h2>Bien plus que des terminaux de paiement.</h2>
                        <p>Nous vous accompagnons de l'audit &#224; la maintenance, avec une offre pens&#233;e pour votre commerce.</p>
                    </div>
                    <a href="/services" class="mn-btn mn-btn--white mn-home-services__button">
                        D&#233;couvrir nos services
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </section>

            <!-- Products Section Liquid Glass -->
            <section class="mn-section mn-products">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Nos produits</span>
                        <h2>Nos solutions les plus demandées</h2>
                        <p>Équipements certifiés, prêts à déployer. Livraison et installation incluses.</p>
                    </div>
                    <div class="mn-products__grid">
                        <t t-set="products" t-value="website.sale_product_domain()"/>
                        <t t-foreach="request.env['product.template'].search([], limit=8)" t-as="product">
                            <a t-attf-href="/shop/#{product.id}" class="mn-product-card">
                                <div class="mn-product-card__img">
                                    <t t-if="product.image_512">
                                        <img t-attf-src="/web/image/product.template/#{product.id}/image_512" t-att-alt="product.name" class="mn-product-img"/>
                                    </t>
                                    <t t-else="">
                                        <div class="mn-product-card__no-img">
                                            <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><rect x="6" y="10" width="36" height="26" rx="4" stroke="#94A3B8" stroke-width="2"/><path d="M6 18h36" stroke="#94A3B8" stroke-width="2"/><rect x="14" y="22" width="20" height="8" rx="2" fill="#94A3B8" opacity="0.3"/></svg>
                                        </div>
                                    </t>
                                </div>
                                <div class="mn-product-card__body">
                                    <h3 t-esc="product.name"/>
                                    <div class="mn-product-card__footer">
                                        <span class="mn-product-card__price" t-esc="'%.2f € HT' % product.list_price"/>
                                        <span class="mn-btn mn-btn--glass mn-btn--sm">Voir</span>
                                    </div>
                                </div>
                            </a>
                        </t>
                    </div>
                    <div class="mn-section__footer">
                        <a href="/shop" class="mn-btn mn-btn--glass-pill">
                            <span>Voir tous nos produits</span>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                    </div>
                </div>
            </section>

            <!-- Testimonials Section Liquid Glass -->
            <section class="mn-reviews mn-section">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Témoignages</span>
                        <h2>Ce que disent nos clients</h2>
                    </div>
                    <div class="mn-grid mn-grid--3">
                        <article class="mn-review">
                            <div class="mn-review__header">
                                <div class="mn-review__stars">★★★★★</div>
                                <span class="mn-review__badge">Vérifié</span>
                            </div>
                            <blockquote>« Installation rapide, équipe très réactive. 12 terminaux sans interruption depuis 2 ans. »</blockquote>
                            <footer class="mn-review__author">
                                <div class="mn-avatar">ML</div>
                                <div class="mn-author-info">
                                    <strong>Marie L.</strong>
                                    <span>Directrice - Restauration, Lyon</span>
                                </div>
                            </footer>
                        </article>
                        <article class="mn-review">
                            <div class="mn-review__header">
                                <div class="mn-review__stars">★★★★★</div>
                                <span class="mn-review__badge">Vérifié</span>
                            </div>
                            <blockquote>« Support 7j/7 nous a dépannés un dimanche en moins de 2h. Indispensable. »</blockquote>
                            <footer class="mn-review__author">
                                <div class="mn-avatar">TB</div>
                                <div class="mn-author-info">
                                    <strong>Thomas B.</strong>
                                    <span>Gérant - Supermarché, Paris</span>
                                </div>
                            </footer>
                        </article>
                        <article class="mn-review">
                            <div class="mn-review__header">
                                <div class="mn-review__stars">★★★★★</div>
                                <span class="mn-review__badge">Vérifié</span>
                            </div>
                            <blockquote>« Migration de 45 caisses sans interruption. Sérieux et professionnel. »</blockquote>
                            <footer class="mn-review__author">
                                <div class="mn-avatar">SM</div>
                                <div class="mn-author-info">
                                    <strong>Sophie M.</strong>
                                    <span>DSI - Franchise, Bordeaux</span>
                                </div>
                            </footer>
                        </article>
                    </div>
                    <div class="mn-reviews__score">
                        <div class="mn-score-card">
                            <div class="mn-reviews__stars">★★★★★</div>
                            <div class="mn-score-text"><strong>4,8 / 5</strong> &#8212; 312 avis vérifiés</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Call to Action Section -->
            <section class="mn-cta">
                <div class="mn-cta__glow"></div>
                <div class="mn-container">
                    <div class="mn-cta__inner">
                        <h2>Votre infrastructure de paiement commence par une conversation.</h2>
                        <p>Audit gratuit &#183; Devis sous 48h &#183; Sans engagement</p>
                        <div class="mn-cta__actions">
                            <a href="/contactus" class="mn-btn mn-btn--white mn-btn--lg">Demander un audit gratuit</a>
                            <a href="/shop" class="mn-btn mn-btn--glass-light mn-btn--lg">Voir la boutique</a>
                        </div>
                    </div>
                </div>
            </section>

        </t>
    </template>

</odoo>
