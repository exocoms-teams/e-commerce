<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="home" name="Accueil" inherit_id="website.homepage" primary="True">
        <xpath expr="//t[@t-call='website.layout']" position="replace">
            <t t-call="monetique_theme.custom_layout">

                <t t-set="head">
                    <title>Accueil | Monetique — Terminaux de paiement &amp; Solutions monétiques</title>
                    <meta name="description" content="Monetique, votre spécialiste en terminaux de paiement TPE, bornes libre-service, solutions monétiques certifiées PCI-DSS. Livraison 48h, support 24h/7j."/>
                </t>

                <t t-call="monetique_theme.hero_section"/>
                <div class="oe_structure oe_empty" id="oe_structure_home_after_hero"/>
                <t t-call="monetique_theme.dashboard_menu"/>
                <div class="oe_structure oe_empty" id="oe_structure_home_middle"/>
                <t t-call="monetique_theme.home_sections"/>
                <t t-call="monetique_theme.features_section"/>
                <div class="oe_structure oe_empty" id="oe_structure_home_bottom"/>
                <t t-call="monetique_theme.custom_footer"/>

            </t>
        </xpath>
    </template>

</odoo>
