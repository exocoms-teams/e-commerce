<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="page_home" name="monetiques.fr Accueil">
  <t t-call="website.layout">
    <div id="wrap">

      <!-- HERO -->
      <section class="mn-hero">
        <div class="mn-container">
          <div class="mn-hero__inner">
            <div class="mn-hero__left">
              <div class="mn-hero__badge mn-anim-left mn-anim-d1">
                <span class="mn-hero__badge-dot"></span>
                Certifié PCI DSS · Partenaire Banque de France
              </div>
              <h1 class="mn-hero__title mn-anim-left mn-anim-d2">
                Encaissez simplement,
                <span class="mn-hero__title-accent">partout.</span>
              </h1>
              <p class="mn-hero__desc mn-anim-left mn-anim-d3">
                Des solutions de paiement adaptées à votre activité — TPE fixe, mobile, sans contact. Déployées en 48h, maintenues avec un SLA garanti.
              </p>
              <div class="mn-hero__actions mn-anim-left mn-anim-d4">
                <a href="/audit" class="mn-btn mn-btn--primary mn-btn--lg">Demander un audit gratuit</a>
                <a href="/shop" class="mn-btn mn-btn--outline mn-btn--lg">Voir nos produits</a>
              </div>
              <div class="mn-hero__trust mn-anim-up" style="animation-delay:.5s;opacity:0">
                <span class="mn-hero__trust-item">SLA 98,5% garanti</span>
                <span class="mn-hero__trust-item">Support 7j/7</span>
                <span class="mn-hero__trust-item">+3 400 TPE actifs</span>
                <span class="mn-hero__trust-item">Installation incluse</span>
              </div>
            </div>
            <div class="mn-hero__right">
              <div class="mn-hero__card">
                <div class="mn-hero__card-label">Terminal recommandé</div>
                <div class="mn-hero__card-img">
                  <img src="/monetique_theme/static/src/img/tpe_move5000_4g.png" alt="Ingenico TETRA Move 5000"/>
                </div>
                <div class="mn-hero__card-title">Ingenico TETRA Move 5000</div>
                <div class="mn-hero__card-ref">Réf. MOVE/5000 · Stock disponible</div>
                <div class="mn-hero__card-specs">
                  <div class="mn-hero__card-spec">
                    <div class="mn-hero__card-spec-val">4G / WiFi</div>
                    <div class="mn-hero__card-spec-lbl">Connectivité</div>
                  </div>
                  <div class="mn-hero__card-spec">
                    <div class="mn-hero__card-spec-val">NFC + puce</div>
                    <div class="mn-hero__card-spec-lbl">Paiement</div>
                  </div>
                  <div class="mn-hero__card-spec">
                    <div class="mn-hero__card-spec-val">48h</div>
                    <div class="mn-hero__card-spec-lbl">Livraison</div>
                  </div>
                  <div class="mn-hero__card-spec">
                    <div class="mn-hero__card-spec-val">36 mois</div>
                    <div class="mn-hero__card-spec-lbl">Garantie</div>
                  </div>
                </div>
                <div class="mn-hero__card-badges">
                  <span class="mn-badge">PCI DSS</span>
                  <span class="mn-badge">NF525</span>
                  <span class="mn-badge">ISO 27001</span>
                  <span class="mn-badge">CB / Visa / MC</span>
                </div>
              </div>
              <div class="mn-hero__stats">
                <div class="mn-hero__stat">
                  <span class="mn-hero__stat-num">3 400+</span>
                  <span class="mn-hero__stat-lbl">TPE actifs</span>
                </div>
                <div class="mn-hero__stat">
                  <span class="mn-hero__stat-num">1 400+</span>
                  <span class="mn-hero__stat-lbl">Clients</span>
                </div>
                <div class="mn-hero__stat">
                  <span class="mn-hero__stat-num">98,5%</span>
                  <span class="mn-hero__stat-lbl">SLA garanti</span>
                </div>
                <div class="mn-hero__stat">
                  <span class="mn-hero__stat-num">20 ans</span>
                  <span class="mn-hero__stat-lbl">Expérience</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- PRODUITS -->
      <section class="mn-section">
        <div class="mn-container">
          <div class="mn-section__header">
            <span class="mn-eyebrow">Nos produits</span>
            <h2>Nos solutions les plus demandées</h2>
            <p>Equipements certifiés, prêts à déployer. Livraison et installation incluses.</p>
          </div>
          <div class="mn-products__grid">
            <div class="mn-product-card">
              <div class="mn-product-card__img">
                <img src="/monetique_theme/static/src/img/tpe_move5000_4g.png" alt="TPE Ingenico TETRA Desk 5000 Fixe"/>
              </div>
              <div class="mn-product-card__body">
                <div class="mn-product-card__name">TPE Ingenico TETRA Desk 5000 Fixe</div>
                <div class="mn-product-card__footer">
                  <span class="mn-product-card__price">215,00<span class="mn-product-card__price-ht"> € HT</span></span>
                  <a href="/shop" class="mn-btn mn-btn--primary mn-btn--sm">Voir</a>
                </div>
              </div>
            </div>
            <div class="mn-product-card">
              <div class="mn-product-card__img">
                <img src="/monetique_theme/static/src/img/tpe_move5000_4g.png" alt="TPE Ingenico TETRA Move 5000 Portable Wifi"/>
              </div>
              <div class="mn-product-card__body">
                <div class="mn-product-card__name">TPE Ingenico TETRA Move 5000 Portable Wifi</div>
                <div class="mn-product-card__footer">
                  <span class="mn-product-card__price">380,00<span class="mn-product-card__price-ht"> € HT</span></span>
                  <a href="/shop" class="mn-btn mn-btn--primary mn-btn--sm">Voir</a>
                </div>
              </div>
            </div>
            <div class="mn-product-card">
              <div class="mn-product-card__img">
                <img src="/monetique_theme/static/src/img/tpe_move5000_4g.png" alt="TPE Ingenico TETRA Move 5000 4G"/>
              </div>
              <div class="mn-product-card__body">
                <div class="mn-product-card__name">TPE Ingenico TETRA Move 5000 Portable 4G Bluetooth Wifi</div>
                <div class="mn-product-card__footer">
                  <span class="mn-product-card__price">490,00<span class="mn-product-card__price-ht"> € HT</span></span>
                  <a href="/shop" class="mn-btn mn-btn--primary mn-btn--sm">Voir</a>
                </div>
              </div>
            </div>
            <div class="mn-product-card">
              <div class="mn-product-card__img">
                <img src="/monetique_theme/static/src/img/tpe_move5000_4g.png" alt="Pinpad Ingenico TETRA Lane 3000"/>
              </div>
              <div class="mn-product-card__body">
                <div class="mn-product-card__name">Pinpad Ingenico TETRA Lane 3000</div>
                <div class="mn-product-card__footer">
                  <span class="mn-product-card__price">590,00<span class="mn-product-card__price-ht"> € HT</span></span>
                  <a href="/shop" class="mn-btn mn-btn--primary mn-btn--sm">Voir</a>
                </div>
              </div>
            </div>
          </div>
          <div style="text-align:center;margin-top:36px">
            <a href="/shop" class="mn-btn mn-btn--outline">Voir tous nos produits →</a>
          </div>
        </div>
      </section>

      <!-- FEATURES -->
      <section class="mn-section mn-section--gray">
        <div class="mn-container">
          <div class="mn-section__header">
            <span class="mn-eyebrow">Pourquoi nous choisir</span>
            <h2>Une expertise métier depuis 20 ans</h2>
            <p>Nous accompagnons commerçants, hôtels et grandes surfaces dans leur infrastructure de paiement.</p>
          </div>
          <div class="mn-features__grid">
            <div class="mn-feature">
              <div class="mn-feature__icon">🔒</div>
              <h3>Sécurité PCI DSS</h3>
              <p>Tous nos terminaux sont certifiés PCI DSS niveau 1. Vos transactions sont chiffrées de bout en bout.</p>
            </div>
            <div class="mn-feature">
              <div class="mn-feature__icon">🚀</div>
              <h3>Déploiement 48h</h3>
              <p>Livraison express, installation et formation incluses. Opérationnel en moins de 48 heures.</p>
            </div>
            <div class="mn-feature">
              <div class="mn-feature__icon">📞</div>
              <h3>Support 7j/7</h3>
              <p>Une équipe technique disponible 7 jours sur 7 pour vous accompagner en cas de besoin.</p>
            </div>
            <div class="mn-feature">
              <div class="mn-feature__icon">⚙️</div>
              <h3>Maintenance incluse</h3>
              <p>Contrats de maintenance préventive et curative. SLA de 98,5% garanti contractuellement.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- TEMOIGNAGES -->
      <section class="mn-section">
        <div class="mn-container">
          <div class="mn-section__header">
            <span class="mn-eyebrow">Témoignages</span>
            <h2>Ce que disent nos clients</h2>
            <p>Plus de 1 400 entreprises nous font confiance pour leur infrastructure de paiement.</p>
          </div>
          <div class="mn-reviews__grid">
            <div class="mn-review">
              <div class="mn-review__stars">★★★★★</div>
              <blockquote>Déployé 30 TPE en une semaine pour notre réseau de pharmacies. Zéro panne, zéro stress. Un partenaire de confiance.</blockquote>
              <div class="mn-review__author">
                <div class="mn-avatar">NK</div>
                <div>
                  <strong>Nadia K.</strong>
                  <span>Responsable IT — Groupe Pharmavie, Lille</span>
                </div>
              </div>
            </div>
            <div class="mn-review">
              <div class="mn-review__stars">★★★★★</div>
              <blockquote>Notre hôtel utilise leurs terminaux depuis 3 saisons. La remontée des paiements en temps réel a changé notre gestion.</blockquote>
              <div class="mn-review__author">
                <div class="mn-avatar">AC</div>
                <div>
                  <strong>Alexandre C.</strong>
                  <span>Directeur — Hôtel Le Belmont, Nice</span>
                </div>
              </div>
            </div>
            <div class="mn-review">
              <div class="mn-review__stars">★★★★★</div>
              <blockquote>J'avais des doutes au départ mais l'onboarding était impeccable. Mon équipe a été formée en 2h chrono.</blockquote>
              <div class="mn-review__author">
                <div class="mn-avatar">RL</div>
                <div>
                  <strong>Rachid L.</strong>
                  <span>Gérant — Boulangerie Artisane, Toulouse</span>
                </div>
              </div>
            </div>
          </div>
          <div class="mn-reviews__score">
            <span class="mn-reviews__stars-lg">★★★★★</span>
            4,9 / 5 — 487 avis vérifiés
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="mn-cta">
        <div class="mn-container">
          <div class="mn-cta__inner">
            <h2>Votre infrastructure de paiement commence par une conversation.</h2>
            <p>Audit gratuit · Devis sous 48h · Sans engagement</p>
            <div class="mn-cta__actions">
              <a href="/audit" class="mn-btn mn-btn--primary mn-btn--lg">Demander un audit gratuit</a>
              <a href="/shop" class="mn-btn mn-btn--outline-white mn-btn--lg">Voir la boutique</a>
            </div>
          </div>
        </div>
      </section>

    </div>
  </t>
</template>

</odoo>
