<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_home" name="monetiques.fr - Accueil" inherit_id="website.homepage">
        <xpath expr="." position="replace">

            <t t-call="monetique_theme.trust_badge"/>
            <t t-call="monetique_theme.stats_section"/>

            <section class="pc-section pc-services-home" aria-label="Nos solutions">
                <div class="pc-container">
                    <div class="pc-section__header">
                        <span class="pc-eyebrow">Nos solutions</span>
                        <h2 class="pc-h2">Tout ce dont vous avez besoin pour encaisser sereinement</h2>
                    </div>
                    <div class="pc-services-home__grid">
                        <a href="/solutions/tpe" class="pc-card pc-card--service-lg">
                            <div class="pc-card__tag">Materiel</div>
                            <h3>Terminaux TPE</h3>
                            <p>Fixes, mobiles, Android. Installation et formation inclus.</p>
                            <span class="pc-card__arrow">&#8594;</span>
                        </a>
                        <a href="/solutions/encaissement" class="pc-card pc-card--service-lg">
                            <div class="pc-card__tag">Logiciel</div>
                            <h3>Encaissement</h3>
                            <p>Solutions certifiees NF525. Reporting temps reel.</p>
                            <span class="pc-card__arrow">&#8594;</span>
                        </a>
                        <a href="/solutions/paiement-omnicanal" class="pc-card pc-card--service-lg pc-card--featured">
                            <div class="pc-card__tag pc-card__tag--blue">Nouveau</div>
                            <h3>Paiement Omnicanal</h3>
                            <p>Magasin, web et mobile. Une seule plateforme.</p>
                            <span class="pc-card__arrow">&#8594;</span>
                        </a>
                        <a href="/support" class="pc-card pc-card--service-lg">
                            <div class="pc-card__tag">Service</div>
                            <h3>Support Technique</h3>
                            <p>Hotline dediee 7j/7. SLA garanti 98,5%.</p>
                            <span class="pc-card__arrow">&#8594;</span>
                        </a>
                    </div>
                </div>
            </section>

            <t t-call="monetique_theme.partners_section"/>
            <t t-call="monetique_theme.engagements_section"/>

            <section class="pc-cta-final" aria-label="Appel a l action">
                <div class="pc-container">
                    <div class="pc-cta-final__inner">
                        <div class="pc-cta-final__bg" aria-hidden="true"></div>
                        <h2 class="pc-cta-final__title">Votre infrastructure de paiement commence par une conversation.</h2>
                        <p class="pc-cta-final__sub">Audit gratuit - Devis sous 48h - Sans engagement</p>
                        <div class="pc-cta-final__actions">
                            <a href="/contact" class="pc-btn pc-btn--white pc-btn--lg">Demander un audit gratuit</a>
                        </div>
                    </div>
                </div>
            </section>

        </xpath>
    </template>

</odoo>
