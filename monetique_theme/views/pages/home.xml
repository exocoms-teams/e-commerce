<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page_home" name="monetiques.fr — Accueil">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'home'"/>

            <!-- HERO -->
            <section class="mn-hero">
                <div class="mn-container">
                    <div class="mn-hero__inner">
                        <div class="mn-hero__content">
                            <div class="mn-hero__badge">
                                <span class="mn-dot"></span> Certifie PCI DSS · NF525 · ISO 27001
                            </div>
                            <h1 class="mn-hero__title">
                                Encaissez simplement,
                                <span class="mn-hero__accent">partout et en toute securite</span>
                            </h1>
                            <p class="mn-hero__desc">
                                Des solutions de paiement adaptees a votre activite : TPE, paiement mobile et e-commerce.
                            </p>
                            <div class="mn-hero__actions">
                                <a href="/shop" class="mn-btn mn-btn--primary mn-btn--lg">Voir nos solutions</a>
                                <a href="/contact" class="mn-btn mn-btn--outline mn-btn--lg">Demander un devis</a>
                            </div>
                            <div class="mn-hero__trust">
                                <span>&#10003; Installation sous 48h</span>
                                <span>&#10003; Support 7j/7</span>
                                <span>&#10003; Sans engagement</span>
                            </div>
                        </div>
                        <div class="mn-hero__visual">
                            <svg viewBox="0 0 320 380" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:320px">
                                <rect x="60" y="20" width="200" height="340" rx="18" fill="#1E40AF" opacity="0.08"/>
                                <rect x="70" y="30" width="180" height="320" rx="14" fill="white" stroke="#E5E7EB" stroke-width="1"/>
                                <rect x="70" y="30" width="180" height="60" rx="14" fill="#1E40AF"/>
                                <rect x="70" y="74" width="180" height="16" fill="#1E40AF"/>
                                <text x="160" y="58" text-anchor="middle" font-family="Arial" font-size="11" font-weight="700" fill="white">monetiques.fr</text>
                                <rect x="90" y="108" width="140" height="52" rx="8" fill="#F0F4FF" stroke="#DBEAFE" stroke-width="1"/>
                                <text x="160" y="128" text-anchor="middle" font-family="Arial" font-size="9" fill="#6B7280">Montant</text>
                                <text x="160" y="148" text-anchor="middle" font-family="Arial" font-size="20" font-weight="800" fill="#1E40AF">42,50 EUR</text>
                                <rect x="90" y="174" width="140" height="36" rx="8" fill="#10B981"/>
                                <text x="160" y="197" text-anchor="middle" font-family="Arial" font-size="12" font-weight="700" fill="white">PAYER MAINTENANT</text>
                                <rect x="90" y="222" width="65" height="40" rx="6" fill="#F9FAFB" stroke="#E5E7EB" stroke-width="1"/>
                                <text x="122" y="238" text-anchor="middle" font-family="Arial" font-size="7" fill="#9CA3AF">CARTE</text>
                                <rect x="100" y="244" width="45" height="8" rx="2" fill="#D1D5DB"/>
                                <rect x="165" y="222" width="65" height="40" rx="6" fill="#F9FAFB" stroke="#E5E7EB" stroke-width="1"/>
                                <text x="197" y="238" text-anchor="middle" font-family="Arial" font-size="7" fill="#9CA3AF">SANS CONTACT</text>
                                <circle cx="197" cy="252" r="8" fill="none" stroke="#1E40AF" stroke-width="1.5"/>
                                <circle cx="197" cy="252" r="4" fill="#1E40AF"/>
                                <rect x="90" y="278" width="140" height="1" fill="#F3F4F6"/>
                                <text x="160" y="304" text-anchor="middle" font-family="Arial" font-size="8" fill="#9CA3AF">Paiement securise SSL</text>
                                <rect x="126" y="314" width="68" height="22" rx="4" fill="#F3F4F6"/>
                                <text x="160" y="329" text-anchor="middle" font-family="Arial" font-size="8" fill="#6B7280">&#128274; Crypte 256-bit</text>
                            </svg>
                        </div>
                    </div>
                </div>
            </section>

            <!-- STATS -->
            <t t-call="monetique_theme.stats_section"/>

            <!-- PRODUITS -->
            <section class="mn-section" style="background:#F9FAFB">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Nos produits</span>
                        <h2>Solutions de paiement professionnelles</h2>
                        <p>Du terminal fixe au paiement mobile, equipez votre commerce avec les meilleures technologies.</p>
                    </div>
                    <div class="mn-products__grid">
                        <div class="mn-product-card">
                            <div class="mn-product-card__img">
                                <div class="mn-product-card__no-img">
                                    <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <rect x="12" y="8" width="40" height="48" rx="6" fill="#DBEAFE" stroke="#93C5FD" stroke-width="1.5"/>
                                        <rect x="18" y="14" width="28" height="18" rx="3" fill="#1E40AF"/>
                                        <rect x="18" y="38" width="8" height="6" rx="1" fill="#93C5FD"/>
                                        <rect x="28" y="38" width="8" height="6" rx="1" fill="#93C5FD"/>
                                        <rect x="38" y="38" width="8" height="6" rx="1" fill="#93C5FD"/>
                                        <rect x="18" y="46" width="8" height="6" rx="1" fill="#93C5FD"/>
                                        <rect x="28" y="46" width="8" height="6" rx="1" fill="#3B82F6"/>
                                        <rect x="38" y="46" width="8" height="6" rx="1" fill="#93C5FD"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="mn-product-card__body">
                                <h3>Terminal TPE Fixe</h3>
                                <p class="mn-product-card__desc">Ideal pour les commerces de proximite. Rapide, fiable, compatible CB et sans contact.</p>
                                <div class="mn-product-card__footer">
                                    <span class="mn-product-card__price">A partir de 19€/mois</span>
                                    <a href="/shop" class="mn-btn mn-btn--primary mn-btn--sm">Voir</a>
                                </div>
                            </div>
                        </div>
                        <div class="mn-product-card">
                            <div class="mn-product-card__img">
                                <div class="mn-product-card__no-img">
                                    <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <rect x="20" y="4" width="24" height="44" rx="5" fill="#DBEAFE" stroke="#93C5FD" stroke-width="1.5"/>
                                        <rect x="24" y="10" width="16" height="24" rx="2" fill="#1E40AF"/>
                                        <circle cx="32" cy="42" r="3" fill="#93C5FD"/>
                                        <path d="M10 52 Q32 44 54 52" stroke="#3B82F6" stroke-width="1.5" fill="none" stroke-dasharray="3,2"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="mn-product-card__body">
                                <h3>Terminal Mobile 4G</h3>
                                <p class="mn-product-card__desc">Encaissez ou vous voulez : livraison, marches, evenements. Autonomie 8h.</p>
                                <div class="mn-product-card__footer">
                                    <span class="mn-product-card__price">A partir de 29€/mois</span>
                                    <a href="/shop" class="mn-btn mn-btn--primary mn-btn--sm">Voir</a>
                                </div>
                            </div>
                        </div>
                        <div class="mn-product-card">
                            <div class="mn-product-card__img">
                                <div class="mn-product-card__no-img">
                                    <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <rect x="8" y="16" width="48" height="32" rx="6" fill="#DBEAFE" stroke="#93C5FD" stroke-width="1.5"/>
                                        <rect x="14" y="22" width="36" height="20" rx="3" fill="#1E40AF"/>
                                        <rect x="18" y="26" width="20" height="3" rx="1" fill="white" opacity="0.6"/>
                                        <rect x="18" y="31" width="14" height="3" rx="1" fill="white" opacity="0.4"/>
                                        <rect x="36" y="26" width="10" height="10" rx="2" fill="#10B981"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="mn-product-card__body">
                                <h3>Logiciel de Caisse</h3>
                                <p class="mn-product-card__desc">Caisse enregistreuse NF525 avec gestion des stocks, tickets et rapports journaliers.</p>
                                <div class="mn-product-card__footer">
                                    <span class="mn-product-card__price">A partir de 39€/mois</span>
                                    <a href="/shop" class="mn-btn mn-btn--primary mn-btn--sm">Voir</a>
                                </div>
                            </div>
                        </div>
                        <div class="mn-product-card">
                            <div class="mn-product-card__img">
                                <div class="mn-product-card__no-img">
                                    <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <circle cx="32" cy="28" r="18" fill="#DBEAFE" stroke="#93C5FD" stroke-width="1.5"/>
                                        <path d="M24 28 L30 34 L42 22" stroke="#1E40AF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                                        <path d="M20 46 Q32 52 44 46" stroke="#3B82F6" stroke-width="1.5" fill="none"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="mn-product-card__body">
                                <h3>Contrat de Maintenance</h3>
                                <p class="mn-product-card__desc">Intervention sous 4h, remplacement materiel, hotline dediee 7j/7 et mises a jour incluses.</p>
                                <div class="mn-product-card__footer">
                                    <span class="mn-product-card__price">Sur devis</span>
                                    <a href="/contact" class="mn-btn mn-btn--primary mn-btn--sm">Contact</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mn-section__footer">
                        <a href="/shop" class="mn-btn mn-btn--outline mn-btn--lg">Voir toute la boutique</a>
                    </div>
                </div>
            </section>

            <!-- AVIS -->
            <section class="mn-section">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Temoignages</span>
                        <h2>Ils nous font confiance</h2>
                        <p>Plus de 3 400 commercants equipes en France.</p>
                    </div>
                    <div class="mn-grid mn-grid--3">
                        <div class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Installation impeccable, le technicien est arrive le lendemain. Le TPE fonctionne parfaitement, je recommande sans hesiter.</blockquote>
                            <div class="mn-review__author">
                                <div class="mn-avatar">JM</div>
                                <div>
                                    <strong>Jean-Marc Dubois</strong>
                                    <span>Boulangerie Dubois, Lyon</span>
                                </div>
                            </div>
                        </div>
                        <div class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Le terminal mobile 4G est parfait pour nos livraisons. Nos clients paient directement a la porte, sans friction.</blockquote>
                            <div class="mn-review__author">
                                <div class="mn-avatar">SF</div>
                                <div>
                                    <strong>Sophie Faure</strong>
                                    <span>Traiteur Sophie, Bordeaux</span>
                                </div>
                            </div>
                        </div>
                        <div class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Support tres reactif, probleme resolu en moins d'une heure par telephone. Service client exemplaire.</blockquote>
                            <div class="mn-review__author">
                                <div class="mn-avatar">KN</div>
                                <div>
                                    <strong>Karim Nasri</strong>
                                    <span>Epicerie Fine, Paris 11e</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mn-reviews__score">
                        <span class="mn-reviews__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                        4.9/5 base sur 847 avis verifies
                    </div>
                </div>
            </section>

            <!-- CTA -->
            <section class="mn-cta">
                <div class="mn-container">
                    <div class="mn-cta__inner">
                        <h2>Pret a moderniser votre encaissement ?</h2>
                        <p>Un conseiller vous rappelle sous 2h pour etudier votre projet.</p>
                        <div class="mn-cta__actions">
                            <a href="/contact" class="mn-btn mn-btn--white mn-btn--lg">Etre rappele gratuitement</a>
                            <a href="/shop" class="mn-btn mn-btn--lg" style="color:white;border-color:rgba(255,255,255,0.4)">Voir nos offres</a>
                        </div>
                    </div>
                </div>
            </section>

        </t>
    </template>
</odoo>
