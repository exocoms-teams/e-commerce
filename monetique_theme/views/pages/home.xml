<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_home" name="monetiques.fr Accueil">
        <t t-call="website.layout">

            <section class="mn-hero mn-hero--fullbg">
                <div class="mn-carousel mn-carousel--bg">
                    <img src="/travel_agency/static/img/Imageaccueil1.jpg" class="mn-carousel__img mn-carousel__img--1"/>
                    <img src="/travel_agency/static/img/Imageaccueil2.jpg" class="mn-carousel__img mn-carousel__img--2"/>
                    <img src="/travel_agency/static/img/Imageaccueil3.jpg" class="mn-carousel__img mn-carousel__img--3"/>
                    <img src="/travel_agency/static/img/Imageaccueil4.jpg" class="mn-carousel__img mn-carousel__img--4"/>
                </div>
                <div class="mn-hero__overlay"></div>
                <div class="mn-container mn-hero__container--fg">
                    <div class="mn-hero__content">
                        <div class="mn-hero__badge">
                            <span class="mn-dot"></span>
                            Agence de voyage certifiée &#183; Voyages sur mesure
                        </div>
                        <h1 class="mn-hero__title" style="color:white">
                            Partez à la decouverte
                            <span class="mn-hero__accent">du monde</span>
                        </h1>
                        <p class="mn-hero__desc" style="color:rgba(255,255,255,0.85)">Vols, hôtels, circuits et séjours tout compris, n'attendez plus et réservez en quelques clics.</p>
                        <div class="mn-search">
                            <ul class="mn-search__tabs" role="tablist">
                                <li class="mn-search__tab active" data-target="search-voyages">
                                    <i class="fa fa-suitcase me-1"/>Voyages
                                </li>
                                <li class="mn-search__tab" data-target="search-hotels">
                                    <i class="fa fa-bed me-1"/>Hôtels
                                </li>
                                <li class="mn-search__tab" data-target="search-vols">
                                    <i class="fa fa-plane me-1"/>Vols
                                </li>
                                <li class="mn-search__tab" data-target="search-trains">
                                    <i class="fa fa-train me-1"/>Trains
                                </li>
                                <li class="mn-search__tab" data-target="search-voitures">
                                    <i class="fa fa-car me-1"/>Location de voiture
                                </li>
                                <li class="mn-search__tab" data-target="search-guides">
                                    <i class="fa fa-map-signs me-1"/>Guides touristiques
                                </li>
                                <li class="mn-search__tab" data-target="search-locations">
                                    <i class="fa fa-home me-1"/>Maisons de location
                                </li>
                                <li class="mn-search__tab" data-target="search-groupes">
                                    <i class="fa fa-users me-1"/>Groupes de sorties et de loisirs
                                </li>
                            </ul>

                            <form action="/travels" method="get" class="mn-search-bar" id="search-voyages">
                                <div class="mn-search-bar__field">
                                    <label>Destination</label>
                                    <input type="text" name="destination" placeholder="Où allez-vous ?"/>
                                </div>
                                <div class="mn-search-bar__field">
                                    <label>Type de voyage</label>
                                    <select name="type_voyage">
                                        <option value="">Tous</option>
                                        <option value="sejour">Séjour</option>
                                        <option value="circuit">Circuit touristique</option>
                                        <option value="aller_retour">Aller-retour</option>
                                        <option value="aller_simple">Aller simple</option>
                                    </select>
                                </div>
                                <div class="mn-search-bar__field">
                                    <label>Budget max</label>
                                    <input type="number" name="prix_max" placeholder="€ / personne" min="0"/>
                                </div>
                                <button type="submit" class="mn-btn mn-btn--primary mn-search-bar__submit">
                                    <i class="fa fa-search me-2"/>Rechercher
                                </button>
                            </form>

                            <form action="/hotels" method="get" class="mn-search-bar" id="search-hotels" style="display:none">
                                <div class="mn-search-bar__field">
                                    <label>Destination</label>
                                    <input type="text" name="destination" placeholder="Ville ou pays"/>
                                </div>
                                <div class="mn-search-bar__field">
                                    <label>Étoiles min.</label>
                                    <select name="etoiles">
                                        <option value="">Toutes</option>
                                        <option value="3">3 étoiles et +</option>
                                        <option value="4">4 étoiles et +</option>
                                        <option value="5">5 étoiles</option>
                                    </select>
                                </div>
                                <button type="submit" class="mn-btn mn-btn--primary mn-search-bar__submit">
                                    <i class="fa fa-search me-2"/>Rechercher
                                </button>
                            </form>

                            <form action="/vols" method="get" class="mn-search-bar" id="search-vols" style="display:none">
                                <div class="mn-search-bar__field">
                                    <label>Destination</label>
                                    <input type="text" name="destination" placeholder="Ville ou pays d'arrivée"/>
                                </div>
                                <div class="mn-search-bar__field">
                                    <label>Classe</label>
                                    <select name="classe">
                                        <option value="">Toutes</option>
                                        <option value="economique">Économique</option>
                                        <option value="affaires">Affaires</option>
                                        <option value="premiere">Première classe</option>
                                    </select>
                                </div>
                                <button type="submit" class="mn-btn mn-btn--primary mn-search-bar__submit">
                                    <i class="fa fa-search me-2"/>Rechercher
                                </button>
                            </form>

                            <form action="/trains" method="get" class="mn-search-bar" id="search-trains" style="display:none">
                                <div class="mn-search-bar__field">
                                    <label>Destination</label>
                                    <input type="text" name="destination" placeholder="Ville ou pays d'arrivée"/>
                                </div>
                                <div class="mn-search-bar__field">
                                    <label>Classe</label>
                                    <select name="classe">
                                        <option value="">Toutes</option>
                                        <option value="seconde">Seconde classe</option>
                                        <option value="premiere">Première classe</option>
                                    </select>
                                </div>
                                <button type="submit" class="mn-btn mn-btn--primary mn-search-bar__submit">
                                    <i class="fa fa-search me-2"/>Rechercher
                                </button>
                            </form>

                            <form action="/voitures" method="get" class="mn-search-bar" id="search-voitures" style="display:none">
                                <div class="mn-search-bar__field">
                                    <label>Destination</label>
                                    <input type="text" name="destination" placeholder="Ville ou pays"/>
                                </div>
                                <div class="mn-search-bar__field">
                                    <label>Catégorie</label>
                                    <select name="categorie">
                                        <option value="">Toutes</option>
                                        <option value="economique">Économique</option>
                                        <option value="compacte">Compacte</option>
                                        <option value="berline">Berline</option>
                                        <option value="suv">SUV</option>
                                        <option value="luxe">Luxe</option>
                                        <option value="utilitaire">Utilitaire</option>
                                    </select>
                                </div>
                                <button type="submit" class="mn-btn mn-btn--primary mn-search-bar__submit">
                                    <i class="fa fa-search me-2"/>Rechercher
                                </button>
                            </form>

                            <form action="/guides" method="get" class="mn-search-bar" id="search-guides" style="display:none">
                                <div class="mn-search-bar__field">
                                    <label>Destination</label>
                                    <input type="text" name="destination" placeholder="Ville ou pays"/>
                                </div>
                                <div class="mn-search-bar__field">
                                    <label>Langue du guide</label>
                                    <select name="langue">
                                        <option value="">Toutes</option>
                                        <option value="francais">Français</option>
                                        <option value="anglais">Anglais</option>
                                        <option value="espagnol">Espagnol</option>
                                        <option value="allemand">Allemand</option>
                                        <option value="italien">Italien</option>
                                    </select>
                                </div>
                                <button type="submit" class="mn-btn mn-btn--primary mn-search-bar__submit">
                                    <i class="fa fa-search me-2"/>Rechercher
                                </button>
                            </form>

                            <form action="/locations" method="get" class="mn-search-bar" id="search-locations" style="display:none">
                                <div class="mn-search-bar__field">
                                    <label>Destination</label>
                                    <input type="text" name="destination" placeholder="Ville ou pays"/>
                                </div>
                                <div class="mn-search-bar__field">
                                    <label>Type de logement</label>
                                    <select name="type_logement">
                                        <option value="">Tous</option>
                                        <option value="maison">Maison</option>
                                        <option value="appartement">Appartement</option>
                                        <option value="villa">Villa</option>
                                        <option value="chalet">Chalet</option>
                                        <option value="studio">Studio</option>
                                    </select>
                                </div>
                                <div class="mn-search-bar__field">
                                    <label>Budget max / nuit</label>
                                    <input type="number" name="prix_max" placeholder="€ / nuit" min="0"/>
                                </div>
                                <button type="submit" class="mn-btn mn-btn--primary mn-search-bar__submit">
                                    <i class="fa fa-search me-2"/>Rechercher
                                </button>
                            </form>

                            <form action="/groupes" method="get" class="mn-search-bar" id="search-groupes" style="display:none">
                                <div class="mn-search-bar__field">
                                    <label>Destination</label>
                                    <input type="text" name="destination" placeholder="Ville ou pays"/>
                                </div>
                                <div class="mn-search-bar__field">
                                    <label>Type d'activité</label>
                                    <select name="type_activite">
                                        <option value="">Toutes</option>
                                        <option value="decouverte">Découverte culturelle</option>
                                        <option value="nature">Randonnée nature</option>
                                        <option value="gastronomie">Gastronomie</option>
                                        <option value="sport">Activités sportives</option>
                                        <option value="bien_etre">Bien-être / Détente</option>
                                        <option value="sorties">Sorties nocturnes</option>
                                    </select>
                                </div>
                                <button type="submit" class="mn-btn mn-btn--primary mn-search-bar__submit">
                                    <i class="fa fa-search me-2"/>Rechercher
                                </button>
                            </form>

                            <script>
                                document.querySelectorAll('.mn-search__tab').forEach(function (tab) {
                                    tab.addEventListener('click', function () {
                                        if (tab.dataset.target === 'search-voitures') {
                                            window.location.href = '/voitures';
                                            return;
                                        }
                                        document.querySelectorAll('.mn-search__tab').forEach(function (t) { t.classList.remove('active'); });
                                        document.querySelectorAll('.mn-search-bar').forEach(function (f) { f.style.display = 'none'; });
                                        tab.classList.add('active');
                                        document.getElementById(tab.dataset.target).style.display = 'flex';
                                    });
                                });
                            </script>
                        </div>

                        <div class="mn-hero__actions">
                            <a href="/travels" class="mn-btn mn-btn--primary mn-btn--lg">Découvrir nos voyages</a>
                            <a href="/travels" class="mn-btn mn-btn--outline mn-btn--lg" style="color:white;border-color:white">Voir nos destinations</a>
                            <a href="/recommandation" class="btn btn-outline-light btn-lg">
                                <i class="fa fa-magic me-2"/>Je ne sais pas où partir, aidez-moi
                            </a>
                        </div>
                        <div class="mn-hero__trust" style="color:rgba(255,255,255,0.8)">
                            <span>&#10003; Paiement sécurisé</span>
                            <span>&#10003; Assistance 7j/7</span>
                            <span>&#10003; +1000 voyageurs satisfaits</span>
                        </div>
                    </div>
                </div>
            </section>

            <t t-call="monetique_theme.stats_section"/>

            <section class="mn-section">
                <div class="mn-container">
                    <div class="row align-items-center g-5 mb-5">
                        <div class="col-md-6">
                            <h2 class="mb-3">Une agence à votre écoute</h2>
                            <p class="lead">
                                Vous en avez marre des agences qui ne répondent pas à vos mails ou vos appels ? Ne cherchez pas plus loin, avec Exocoms Travel, nous vous répondons en moins de 15 minutes par mail. Des conseillers dédiés et à votre écoute assurent un suivi personnalisé de votre dossier.
                            </p>
                        </div>
                        <div class="col-md-6">
                            <img src="/travel_agency/static/img/conseiller.jpg" class="img-fluid rounded"/>
                        </div>
                    </div>

                    <div class="row align-items-center g-5 mb-5">
                        <div class="col-md-6 order-md-2">
                            <h2 class="mb-3">Voyager en toute confiance</h2>
                            <p class="lead">
                                Dans notre agence, vous payez en toute sécurité et vous êtes assistés avant, pendant et même après le séjour.
                            </p>
                        </div>
                        <div class="col-md-6 order-md-1">
                            <img src="/travel_agency/static/img/Voyagezentouteconfiance.jpg" class="img-fluid rounded"/>
                        </div>
                    </div>

                    <div class="row align-items-center g-5 mb-5">
                        <div class="col-md-6">
                            <h2 class="mb-3">Des séjours pensés pour vous</h2>
                            <p class="lead">
                                Pas d'idées de voyage ? Faites un tour sur notre site pour partir à l'aventure, et surtout pour tous les budgets. Des voyages sur mesure et une sélection rigoureuse de partenaires de qualité. Faites vos valises et let's go !
                            </p>
                        </div>
                        <div class="col-md-6">
                            <img src="/travel_agency/static/img/sejourpensepourvous.jpg" class="img-fluid rounded"/>
                        </div>
                    </div>

                    <div class="row align-items-center g-5 mb-5">
                        <div class="col-md-6 order-md-2">
                            <h2 class="mb-3">Tout en un seul endroit</h2>
                            <p class="lead">
                                Réservez vol + hôtel + voiture en quelques clics. Plus besoin d'une organisation d'enfer ni de paniquer à l'idée de tout gérer, Exocoms Travel le fait pour vous !
                            </p>
                        </div>
                        <div class="col-md-6 order-md-1">
                            <img src="/travel_agency/static/img/tten1seulendroit.jpg" class="img-fluid rounded"/>
                        </div>
                    </div>

                    <div class="row align-items-center g-5 mb-5">
                        <div class="col-md-6">
                            <h2 class="mb-3">Notre engagement qualité</h2>
                            <p class="lead">
                                Plus de 10 ans d'expérience, des avis et une excellente satisfaction client. Vous rendre heureux, notre mission.
                            </p>
                        </div>
                        <div class="col-md-6">
                            <img src="/travel_agency/static/img/imagefinalengagements.jpg" class="img-fluid rounded"/>
                        </div>
                    </div>
                </div>
            </section>

            <section class="mn-section mn-products">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Nos voyages</span>
                        <h2>Nos destinations les plus populaires</h2>
                        <p>Découvrez nos meilleures destinations et réservez en quelques clics.</p>
                    </div>
                    <div class="mn-products__grid">
                        <t t-foreach="request.env['product.template'].sudo().search([('prix_par_personne', '>', 0)], limit=8)" t-as="product">
                            <a t-attf-href="/travels/book/#{product.id}" class="mn-product-card">
                                <div class="mn-product-card__img">
                                    <t t-if="product.image_512">
                                        <img t-attf-src="/web/image/product.template/#{product.id}/image_512"
                                            t-att-alt="product.name"
                                            style="width:100%;height:200px;object-fit:cover;border-radius:8px 8px 0 0;"/>
                                    </t>
                                </div>
                                <div class="mn-product-card__body">
                                    <h3 t-esc="product.name"/>
                                    <div class="mn-product-card__footer">
                                        <span class="mn-product-card__price" t-esc="'%.2f € / pers.' % product.prix_par_personne"/>
                                        <span class="mn-btn mn-btn--primary mn-btn--sm">Reserver</span>
                                    </div>
                                </div>
                            </a>
                        </t>
                    </div>
                    <div class="mn-section__footer">
                        <a href="/travels" class="mn-btn mn-btn--outline">Voir tous nos voyages &#8594;</a>
                    </div>
                </div>
            </section>

            <section class="mn-section mn-products">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Hebergement</span>
                        <h2>Nos hôtels les mieux notés</h2>
                        <p>Des établissements sélectionnés pour leur confort et leur service.</p>
                    </div>
                    <div class="mn-products__grid">
                        <t t-foreach="request.env['travel.hotel'].sudo().search([('disponible', '=', True)], order='etoiles desc', limit=8)" t-as="hotel">
                            <a t-attf-href="/hotels/#{hotel.id}" class="mn-product-card">
                                <div class="mn-product-card__img">
                                    <t t-if="hotel.image_1920">
                                        <img t-attf-src="/web/image/travel.hotel/#{hotel.id}/image_1920"
                                            t-att-alt="hotel.name"
                                            style="width:100%;height:200px;object-fit:cover;border-radius:8px 8px 0 0;"/>
                                    </t>
                                </div>
                                <div class="mn-product-card__body">
                                    <h3 t-esc="hotel.name"/>
                                    <p t-esc="hotel.ville"/>
                                    <div class="mn-product-card__footer">
                                        <span class="mn-product-card__price" t-esc="'%s étoiles' % hotel.etoiles"/>
                                        <span class="mn-btn mn-btn--primary mn-btn--sm">Voir l'hôtel</span>
                                    </div>
                                </div>
                            </a>
                        </t>
                    </div>
                    <div class="mn-section__footer">
                        <a href="/hotels" class="mn-btn mn-btn--outline">Voir tous nos hôtels &#8594;</a>
                    </div>
                </div>
            </section>

            <section class="mn-section mn-products">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Transport</span>
                        <h2>Nos trajets en train les plus rapides</h2>
                        <p>Voyagez vite et confortablement vers votre destination.</p>
                    </div>
                    <div class="mn-products__grid">
                        <t t-foreach="request.env['travel.train'].sudo().search([('disponible', '=', True)], order='duree_heures asc', limit=8)" t-as="train">
                            <a t-attf-href="/trains/#{train.id}" class="mn-product-card">
                                <div class="mn-product-card__img">
                                    <t t-if="train.image_1920">
                                        <img t-attf-src="/web/image/travel.train/#{train.id}/image_1920"
                                            t-att-alt="train.name"
                                            style="width:100%;height:200px;object-fit:cover;border-radius:8px 8px 0 0;"/>
                                    </t>
                                </div>
                                <div class="mn-product-card__body">
                                    <h3 t-esc="train.name"/>
                                    <p><span t-esc="train.ville_depart"/> &#8594; <span t-esc="train.ville_arrivee"/></p>
                                    <div class="mn-product-card__footer">
                                        <span class="mn-product-card__price" t-esc="'%.1f h - %.2f €' % (train.duree_heures, train.prix)"/>
                                        <span class="mn-btn mn-btn--primary mn-btn--sm">Voir le trajet</span>
                                    </div>
                                </div>
                            </a>
                        </t>
                    </div>
                    <div class="mn-section__footer">
                        <a href="/trains" class="mn-btn mn-btn--outline">Voir tous nos trains &#8594;</a>
                    </div>
                </div>
            </section>

            <section class="mn-section mn-products">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Mobilite</span>
                        <h2>Nos voitures les plus demandées</h2>
                        <p>Louez le véhicule idéal pour explorer votre destination.</p>
                    </div>
                    <div class="mn-products__grid">
                        <t t-foreach="request.env['travel.car'].sudo().search([('disponible', '=', True)], limit=8)" t-as="car">
                            <a t-attf-href="/voitures/#{car.id}" class="mn-product-card">
                                <div class="mn-product-card__img">
                                    <t t-if="car.image_1920">
                                        <img t-attf-src="/web/image/travel.car/#{car.id}/image_1920"
                                            t-att-alt="car.name"
                                            style="width:100%;height:200px;object-fit:cover;border-radius:8px 8px 0 0;"/>
                                    </t>
                                </div>
                                <div class="mn-product-card__body">
                                    <h3 t-esc="car.name"/>
                                    <p><span t-esc="car.marque"/> <span t-esc="car.modele"/></p>
                                    <div class="mn-product-card__footer">
                                        <span class="mn-product-card__price" t-esc="'%.2f € / jour' % car.prix_par_jour"/>
                                        <span class="mn-btn mn-btn--primary mn-btn--sm">Voir l'offre</span>
                                    </div>
                                </div>
                            </a>
                        </t>
                    </div>
                    <div class="mn-section__footer">
                        <a href="/voitures" class="mn-btn mn-btn--outline">Voir toutes nos voitures &#8594;</a>
                    </div>
                </div>
            </section>

            <section class="mn-reviews mn-section">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Temoignages</span>
                        <h2>Ce que disent nos clients</h2>
                    </div>
                    <div class="mn-grid mn-grid--3">
                        <article class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Superbe séjour à Monaco, une équipe à l'écoute de ses clients. Je recommande!</blockquote>
                            <footer class="mn-review__author"><div class="mn-avatar">ML</div><div><strong>Marie L.</strong><span>Directrice - Restauration, Lyon</span></div></footer>
                        </article>
                        <article class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Support 7j/7 nous a réglé un souci de vol un dimanche en moins de 2h. Indispensable.</blockquote>
                            <footer class="mn-review__author"><div class="mn-avatar">TB</div><div><strong>Thomas B.</strong><span>Gérant - Supermarché, Paris</span></div></footer>
                        </article>
                        <article class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Je réserve mes vacances avec cette agence depuis maintenant 3 ans et cela a complètement changé mon organisation habituellement stressante, foncez!</blockquote>
                            <footer class="mn-review__author"><div class="mn-avatar">SM</div><div><strong>Sophie M.</strong><span>DSI - Franchise, Bordeaux</span></div></footer>
                        </article>
                    </div>
                    <div class="mn-reviews__score"><div class="mn-reviews__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div><strong>4,8 / 5</strong> &#8212; 312 avis verifies</div>
                </div>
            </section>

            <section class="mn-cta">
                <div class="mn-container">
                    <div class="mn-cta__inner">
                        <h2>Votre prochain voyage commence par une conversation.</h2>
                        <p>Devis gratuit &#183; Réponse sous 48h &#183; Sans engagement</p>
                        <div class="mn-cta__actions">
                            <a href="/travels" class="mn-btn mn-btn--white mn-btn--lg">Découvrir nos voyages</a>
                            <a href="/contact" class="mn-btn mn-btn--lg" style="border:2px solid rgba(255,255,255,0.4);color:white">Nous contacter</a>
                        </div>
                    </div>
                </div>
            </section>

        </t>
    </template>

</odoo>