<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_home" name="Sinistre Services — Accueil">
        <t t-call="website.layout">

            <!-- HERO -->
            <section class="mn-hero">
                <div class="mn-container">
                    <div class="mn-hero__inner">
                        <div class="mn-hero__content">
                            <div class="mn-hero__badge">
                                <span class="mn-dot"></span>
                                Plateforme agreee assurances · Artisans certifies
                            </div>
                            <h1 class="mn-hero__title">
                                Intervention rapide,
                                <span class="mn-hero__accent">pour vos sinistres</span>
                            </h1>
                            <p class="mn-hero__desc">Serruriers, plombiers, menuisiers disponibles <strong>24h/24 — 7j/7</strong> partout en France. Intervention en moins de 2h, devis gratuit.</p>
                            <div class="mn-hero__actions">
                                <a href="/demande-intervention" class="mn-btn mn-btn--primary mn-btn--lg">
                                    <i class="fa fa-wrench" aria-hidden="true"/> Demander une intervention
                                </a>
                                <a href="tel:+33100000000" class="mn-btn mn-btn--outline mn-btn--lg">
                                    <i class="fa fa-phone" aria-hidden="true"/> 01 XX XX XX XX
                                </a>
                            </div>
                            <div class="mn-hero__trust">
                                <span>&#10003; Intervention en 2h</span>
                                <span>&#10003; Devis gratuit</span>
                                <span>&#10003; Artisans certifies</span>
                                <span>&#10003; 24h/24 7j/7</span>
                            </div>
                        </div>
                        <!-- Formulaire demande rapide -->
                        <div class="mn-hero__visual" style="filter:none;">
                            <div style="background:white;border-radius:20px;padding:32px;box-shadow:0 12px 48px rgba(0,0,0,.12);border:1px solid rgba(198,40,40,.1);">
                                <h3 style="font-size:20px;font-weight:700;color:#0F172A;margin-bottom:4px;font-family:'Inter',sans-serif;">Demande rapide</h3>
                                <p style="font-size:13px;color:#6B7280;margin-bottom:24px;">Reponse sous 15 minutes</p>
                                <form method="POST" action="/demande-intervention">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div style="margin-bottom:14px;">
                                        <label style="display:block;font-size:11px;font-weight:600;color:#374151;margin-bottom:5px;text-transform:uppercase;letter-spacing:.5px;">Type d'intervention</label>
                                        <select name="type_intervention" style="width:100%;padding:11px 14px;border:1.5px solid #E5E7EB;border-radius:10px;font-size:14px;color:#111827;background:white;box-sizing:border-box;font-family:'Inter',sans-serif;">
                                            <option value="serrurerie">Serrurerie</option>
                                            <option value="plomberie">Plomberie</option>
                                            <option value="menuiserie_ext">Menuiserie</option>
                                            <option value="vitrerie">Vitrerie</option>
                                            <option value="electricite">Electricite</option>
                                            <option value="autre">Autre</option>
                                        </select>
                                    </div>
                                    <div style="margin-bottom:14px;">
                                        <label style="display:block;font-size:11px;font-weight:600;color:#374151;margin-bottom:5px;text-transform:uppercase;letter-spacing:.5px;">Telephone</label>
                                        <input type="tel" name="telephone" placeholder="06 XX XX XX XX" style="width:100%;padding:11px 14px;border:1.5px solid #E5E7EB;border-radius:10px;font-size:14px;box-sizing:border-box;font-family:'Inter',sans-serif;"/>
                                    </div>
                                    <div style="margin-bottom:20px;">
                                        <label style="display:block;font-size:11px;font-weight:600;color:#374151;margin-bottom:5px;text-transform:uppercase;letter-spacing:.5px;">Code postal</label>
                                        <input type="text" name="code_postal" placeholder="75001" style="width:100%;padding:11px 14px;border:1.5px solid #E5E7EB;border-radius:10px;font-size:14px;box-sizing:border-box;font-family:'Inter',sans-serif;"/>
                                    </div>
                                    <button type="submit" class="mn-btn mn-btn--primary" style="width:100%;justify-content:center;padding:14px;font-size:15px;">
                                        Trouver un artisan
                                    </button>
                                    <p style="text-align:center;font-size:11px;color:#9CA3AF;margin-top:10px;">Sans engagement · Devis gratuit</p>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- STATS -->
            <t t-call="monetique_theme.stats_section"/>

            <!-- SERVICES -->
            <section class="mn-section mn-section--gray">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Nos interventions</span>
                        <h2>Tous types de sinistres pris en charge</h2>
                        <p>Artisans qualifies disponibles 24h/24 — Intervention garantie en moins de 2h</p>
                    </div>
                    <div class="mn-grid mn-grid--3">
                        <a href="/demande-intervention" class="mn-card--solution">
                            <div class="mn-card__icon"><i class="fa fa-lock" aria-hidden="true"/></div>
                            <h3>Serrurerie</h3>
                            <p>Porte claquee, serrure forcee, cylindre a remplacer. Intervention sous 45 minutes.</p>
                            <span class="mn-card__arrow">&#8594;</span>
                        </a>
                        <a href="/demande-intervention" class="mn-card--solution">
                            <div class="mn-card__icon"><i class="fa fa-tint" aria-hidden="true"/></div>
                            <h3>Plomberie</h3>
                            <p>Fuite d'eau, degat des eaux, canalisation bouchee. Plombiers disponibles 24h/24.</p>
                            <span class="mn-card__arrow">&#8594;</span>
                        </a>
                        <a href="/demande-intervention" class="mn-card--solution">
                            <div class="mn-card__icon"><i class="fa fa-home" aria-hidden="true"/></div>
                            <h3>Menuiserie</h3>
                            <p>Porte fracturee, fenetre endommagee, volet casse. Reparation urgente ou remplacement.</p>
                            <span class="mn-card__arrow">&#8594;</span>
                        </a>
                        <a href="/demande-intervention" class="mn-card--solution">
                            <div class="mn-card__icon"><i class="fa fa-th-large" aria-hidden="true"/></div>
                            <h3>Vitrerie</h3>
                            <p>Bris de glace, fenetre cassee, double vitrage. Bache provisoire dans l'heure.</p>
                            <span class="mn-card__arrow">&#8594;</span>
                        </a>
                        <a href="/demande-intervention" class="mn-card--solution">
                            <div class="mn-card__icon"><i class="fa fa-bolt" aria-hidden="true"/></div>
                            <h3>Electricite</h3>
                            <p>Panne electrique, disjoncteur, court-circuit. Electriciens Qualifelec disponibles.</p>
                            <span class="mn-card__arrow">&#8594;</span>
                        </a>
                        <a href="/urgence" class="mn-card--solution mn-card--featured">
                            <div class="mn-card__icon"><i class="fa fa-exclamation-triangle" aria-hidden="true"/></div>
                            <h3>Urgence 24h/24</h3>
                            <p>Toute intervention urgente, nuit et weekend. Un artisan chez vous en moins de 2h garantis.</p>
                            <span class="mn-card__arrow">&#8594;</span>
                        </a>
                    </div>
                    <div class="mn-section__footer">
                        <a href="/nos-services" class="mn-btn mn-btn--outline">Voir tous nos services &#8594;</a>
                    </div>
                </div>
            </section>

            <!-- TEMOIGNAGES -->
            <section class="mn-reviews mn-section">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">Temoignages</span>
                        <h2>Ce que disent nos clients</h2>
                    </div>
                    <div class="mn-grid mn-grid--3">
                        <article class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Serrurier arrive en 40 minutes, porte ouverte sans degat. Professionnel et efficace.</blockquote>
                            <footer class="mn-review__author">
                                <div class="mn-avatar">ML</div>
                                <div><strong>Marie L.</strong><span>Particulier, Paris 15e</span></div>
                            </footer>
                        </article>
                        <article class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Fuite d'eau un dimanche soir, plombier sur place en 1h30. Merci pour la rapidite !</blockquote>
                            <footer class="mn-review__author">
                                <div class="mn-avatar">TB</div>
                                <div><strong>Thomas B.</strong><span>Particulier, Lyon</span></div>
                            </footer>
                        </article>
                        <article class="mn-review">
                            <div class="mn-review__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                            <blockquote>Prise en charge directe par notre assurance. Intervention rapide et devis conforme.</blockquote>
                            <footer class="mn-review__author">
                                <div class="mn-avatar">SM</div>
                                <div><strong>Sophie M.</strong><span>Gestionnaire sinistres, AXA</span></div>
                            </footer>
                        </article>
                    </div>
                    <div class="mn-reviews__score">
                        <div class="mn-reviews__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                        <strong>4,8 / 5</strong> &#8212; 1 247 avis verifies
                    </div>
                </div>
            </section>

            <!-- CTA URGENCE -->
            <section class="mn-cta">
                <div class="mn-container">
                    <div class="mn-cta__inner">
                        <h2>Urgence sinistre ? Appelez maintenant.</h2>
                        <p>Intervention sous 2h · Devis gratuit · Artisans certifies · Sans engagement</p>
                        <div class="mn-cta__actions">
                            <a href="tel:+33100000000" class="mn-btn mn-btn--white mn-btn--lg">
                                <i class="fa fa-phone" aria-hidden="true"/> 01 XX XX XX XX
                            </a>
                            <a href="/demande-intervention" class="mn-btn mn-btn--lg" style="border:2px solid rgba(255,255,255,0.4);color:white">
                                <i class="fa fa-wrench" aria-hidden="true"/> Formulaire en ligne
                            </a>
                        </div>
                    </div>
                </div>
            </section>

        </t>
    </template>

</odoo>
