<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- CART PAGE                                                 -->
    <!-- ========================================================= -->

    <template id="page_cart" name="Sneakers Cart">

        <t t-call="monetique_theme.layout">

            <!-- ========================================================= -->
            <!-- CART HEADER                                               -->
            <!-- ========================================================= -->

            <section class="sn-cart-header">

                <div class="mn-container">

                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">
                            Shopping Cart
                        </span>

                        <h2>
                            Review Your Cart
                        </h2>

                        <p>
                            Check your selected sneakers before proceeding
                            to checkout.
                        </p>

                    </div>

                </div>

            </section>

            <!-- ========================================================= -->
            <!-- CART CONTENT                                              -->
            <!-- ========================================================= -->

            <section class="sn-cart">

                <div class="mn-container">

                    <!-- Le contenu sera ajouté à l'étape suivante -->
                    <section class="sn-cart">

                        <div class="mn-container">

                            <div class="sn-cart-layout">

                                <!-- ========================================================= -->
                                <!-- CART ITEMS                                                -->
                                <!-- ========================================================= -->

                                <div class="sn-cart-items">

                                    <!-- Les cartes produits seront ajoutées ici -->
                                    <div class="sn-cart-items">

                                    <!-- ========================================================= -->
                                    <!-- CART ITEM -->
                                    <!-- ========================================================= -->

                                    <article class="sn-cart-item">

                                        <!-- Product Image -->

                                        <div class="sn-cart-image">

                                            <img src="/monetique_theme/static/src/img/products/product-1.jpg"
                                                alt="Nike Air Max"/>

                                        </div>

                                        <!-- Product Information -->

                                        <div class="sn-cart-info">

                                            <span class="sn-cart-category">
                                                Running Shoes
                                            </span>

                                            <h3>
                                                Nike Air Max 270
                                            </h3>

                                            <div class="sn-cart-attributes">

                                                <span>Size : 42</span>

                                                <span>Color : Black</span>

                                            </div>

                                            <div class="sn-cart-price">

                                                $180.00

                                            </div>

                                        </div>

                                        <!-- Quantity -->

                                        <div class="sn-cart-quantity">

                                            <button class="sn-qty-btn">

                                                −

                                            </button>

                                            <input
                                                type="number"
                                                value="1"
                                                min="1"/>

                                            <button class="sn-qty-btn">

                                                +

                                            </button>

                                        </div>

                                        <!-- Total -->

                                        <div class="sn-cart-total">

                                            $180.00

                                        </div>

                                        <!-- Remove -->

                                        <button class="sn-cart-remove">

                                            <i class="fa fa-trash"></i>

                                        </button>

                                    </article>

                                    <!-- ========================================================= -->
                                    <!-- CART ITEM -->
                                    <!-- ========================================================= -->

                                    <article class="sn-cart-item">

                                        <!-- Product Image -->

                                        <div class="sn-cart-image">

                                            <img src="/monetique_theme/static/src/img/products/product-2.jpg"
                                                alt="Adidas Ultraboost"/>

                                        </div>

                                        <!-- Product Information -->

                                        <div class="sn-cart-info">

                                            <span class="sn-cart-category">
                                                Lifestyle
                                            </span>

                                            <h3>
                                                Adidas Ultraboost
                                            </h3>

                                            <div class="sn-cart-attributes">

                                                <span>Size : 41</span>

                                                <span>Color : White</span>

                                            </div>

                                            <div class="sn-cart-price">

                                                $220.00

                                            </div>

                                        </div>

                                        <!-- Quantity -->

                                        <div class="sn-cart-quantity">

                                            <button class="sn-qty-btn">

                                                −

                                            </button>

                                            <input
                                                type="number"
                                                value="2"
                                                min="1"/>

                                            <button class="sn-qty-btn">

                                                +

                                            </button>

                                        </div>

                                        <!-- Total -->

                                        <div class="sn-cart-total">

                                            $440.00

                                        </div>

                                        <!-- Remove -->

                                        <button class="sn-cart-remove">

                                            <i class="fa fa-trash"></i>

                                        </button>

                                    </article>

                                </div>

                                </div>

                                <!-- ========================================================= -->
                                <!-- ORDER SUMMARY                                             -->
                                <!-- ========================================================= -->

                                <aside class="sn-cart-summary">

                                    <!-- Le résumé sera ajouté ensuite -->
                                    <aside class="sn-cart-summary">

                                        <!-- ========================================================= -->
                                        <!-- SUMMARY CARD -->
                                        <!-- ========================================================= -->

                                        <div class="sn-summary-card">

                                            <h3>
                                                Order Summary
                                            </h3>

                                            <div class="sn-summary-row">

                                                <span>Subtotal</span>

                                                <span>$620.00</span>

                                            </div>

                                            <div class="sn-summary-row">

                                                <span>Shipping</span>

                                                <span>Free</span>

                                            </div>

                                            <div class="sn-summary-row">

                                                <span>Estimated Tax</span>

                                                <span>$24.00</span>

                                            </div>

                                            <div class="sn-summary-divider"></div>

                                            <div class="sn-summary-row sn-summary-total">

                                                <span>Total</span>

                                                <span>$644.00</span>

                                            </div>

                                            <button class="sn-checkout-btn">

                                                Proceed to Checkout

                                            </button>

                                            <a href="/shop" class="sn-continue-shopping">

                                                ← Continue Shopping

                                            </a>

                                        </div>

                                        <!-- ========================================================= -->
                                        <!-- PROMO CODE -->
                                        <!-- ========================================================= -->

                                        <div class="sn-promo-card">

                                            <h4>
                                                Promo Code
                                            </h4>

                                            <div class="sn-promo-form">

                                                <input
                                                    type="text"
                                                    placeholder="Enter promo code"/>

                                                <button>

                                                    Apply

                                                </button>

                                            </div>

                                        </div>

                                    </aside>

                                </aside>

                            </div>

                        </div>

                    </section>

                </div>

            </section>

        </t>

    </template>

</odoo>