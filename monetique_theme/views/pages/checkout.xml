<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="page_checkout" name="Sneakers Checkout">

        <t t-call="monetique_theme.layout">
            <!-- CHECKOUT HEADER -->

            <section class="sn-checkout-header">

                <div class="mn-container">

                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">
                            Checkout
                        </span>

                        <h2>
                            Complete Your Order
                        </h2>

                        <p>
                            Enter your shipping information and review your
                            order before confirming your purchase.
                        </p>

                    </div>

                </div>

            </section>

            <!-- CHECKOUT PROGRESS  -->
            <section class="sn-checkout-progress">

                <div class="mn-container">

                    <div class="sn-progress-container">

                        <div class="sn-progress-line"></div>

                        <div class="sn-progress-step completed">

                            <div class="sn-step-circle">
                                <i class="fa fa-check"></i>
                            </div>

                            <span>Cart</span>

                        </div>

                        <div class="sn-progress-step active">

                            <div class="sn-step-circle">
                                2
                            </div>

                            <span>Address</span>

                        </div>

                        <div class="sn-progress-step">

                            <div class="sn-step-circle">
                                3
                            </div>

                            <span>Shipping</span>

                        </div>

                        <div class="sn-progress-step">

                            <div class="sn-step-circle">
                                4
                            </div>

                            <span>Payment</span>

                        </div>

                    </div>

                </div>

            </section>

            <!-- CHECKOUT CONTENT -->
            <section class="sn-checkout">

                <div class="mn-container">

                    <div class="sn-checkout-layout">

                        <div class="sn-checkout-form">

                            <div class="sn-checkout-form">

                                <div class="sn-checkout-card">

                                    <h3>Billing Address</h3>

                                    <div class="sn-form-grid">

                                        <div class="sn-form-group">
                                            <label>First Name</label>
                                            <input type="text" placeholder="John"/>
                                        </div>

                                        <div class="sn-form-group">
                                            <label>Last Name</label>
                                            <input type="text" placeholder="Doe"/>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label>Email Address</label>
                                            <input type="email" placeholder="john@example.com"/>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label>Phone Number</label>
                                            <input type="tel" placeholder="+212 6 00 00 00 00"/>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label>Street Address</label>
                                            <input type="text" placeholder="123 Main Street"/>
                                        </div>

                                        <div class="sn-form-group">
                                            <label>City</label>
                                            <input type="text" placeholder="Casablanca"/>
                                        </div>

                                        <div class="sn-form-group">
                                            <label>Postal Code</label>
                                            <input type="text" placeholder="20000"/>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label>Country</label>
                                            <select>
                                                <option>Morocco</option>
                                                <option>France</option>
                                                <option>Spain</option>
                                            </select>
                                        </div>

                                    </div>

                                </div>

                                <!-- SHIPPING METHOD -->
                                <div class="sn-checkout-card">

                                    <h3>Shipping Method</h3>

                                    <label class="sn-radio-card">

                                        <input type="radio" name="shipping" checked="checked"/>

                                        <div>
                                            <strong>Standard Delivery</strong>
                                            <p>3-5 business days</p>
                                        </div>

                                        <span>Free</span>

                                    </label>

                                    <label class="sn-radio-card">

                                        <input type="radio" name="shipping"/>

                                        <div>
                                            <strong>Express Delivery</strong>
                                            <p>24-48 hours</p>
                                        </div>

                                        <span>$15.00</span>

                                    </label>

                                </div>

                                <!-- PAYMENT METHOD -->
                                <div class="sn-checkout-card">

                                    <h3>Payment Method</h3>

                                    <label class="sn-radio-card">

                                        <input type="radio" name="payment" checked="checked"/>

                                        <div>
                                            <strong>Credit / Debit Card</strong>
                                            <p>Visa, Mastercard, American Express</p>
                                        </div>

                                    </label>

                                    <label class="sn-radio-card">

                                        <input type="radio" name="payment"/>

                                        <div>
                                            <strong>PayPal</strong>
                                            <p>Pay securely with your PayPal account</p>
                                        </div>

                                    </label>

                                    <label class="sn-radio-card">

                                        <input type="radio" name="payment"/>

                                        <div>
                                            <strong>Cash on Delivery</strong>
                                            <p>Pay when your order arrives</p>
                                        </div>

                                    </label>

                                </div>

                            </div>

                        </div>

                       <aside class="sn-checkout-summary">
                            <div class="sn-summary-card">

                                <h3>
                                    Order Summary
                                </h3>

                                <!-- Product -->

                                <div class="sn-summary-product">

                                    <img src="/sneakers/static/src/img/products/product-1.jpg"
                                        alt="Nike Air Max"/>

                                    <div>

                                        <h4>Nike Air Max 270</h4>

                                        <span>Qty : 1</span>

                                    </div>

                                    <strong>$180.00</strong>

                                </div>

                                <div class="sn-summary-product">

                                    <img src="/sneakers/static/src/img/products/product-2.jpg"
                                        alt="Adidas Ultraboost"/>

                                    <div>

                                        <h4>Adidas Ultraboost</h4>

                                        <span>Qty : 2</span>

                                    </div>

                                    <strong>$440.00</strong>

                                </div>

                                <!-- Totals -->

                                <div class="sn-summary-divider"></div>

                                <div class="sn-summary-row">

                                    <span>Subtotal</span>

                                    <span>$620.00</span>

                                </div>

                                <div class="sn-summary-row">

                                    <span>Shipping</span>

                                    <span>Free</span>

                                </div>

                                <div class="sn-summary-row">

                                    <span>Estimated Tax</span>

                                    <span>$24.00</span>

                                </div>

                                <div class="sn-summary-divider"></div>

                                <div class="sn-summary-row sn-summary-total">

                                    <span>Total</span>

                                    <span>$644.00</span>

                                </div>

                                <!-- Promo Code -->

                                <div class="sn-promo-form">

                                    <input
                                        type="text"
                                        placeholder="Promo Code"/>

                                    <button>

                                        Apply

                                    </button>

                                </div>

                                <!-- Place Order -->

                                <button class="sn-place-order-btn">

                                    Place Order

                                </button>

                                <!-- Back -->

                                <a href="/cart" class="sn-back-cart">

                                    ← Back to Cart

                                </a>

                            </div>

                        </aside>

                    </div>

                </div>

            </section>

        </t>

    </template>

</odoo>