<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- PAGE ENCAISSEMENT -->
    <template id="page_encaissement" name="monetiques.fr - Encaissement" inherit_id="website.layout">
        <xpath expr="//div[@id='wrapwrap']" position="replace">
        <div id="wrapwrap" class="pc-site">
            <t t-call="paycore_website.navbar"/>
            <main id="wrap" role="main">
                <section class="pc-page-header">
                    <div class="pc-container">
                        <div class="pc-breadcrumb"><a href="/">Accueil</a><span>/</span><span aria-current="page">Encaissement</span></div>
                        <h1 class="pc-page-header__title">Solutions d'Encaissement</h1>
                        <p class="pc-page-header__sub">Caisses connectées, logiciels NF525 certifiés, intégration comptabilité. Pour commerces, restaurants et retail.</p>
                    </div>
                </section>
                <section class="pc-section">
                    <div class="pc-container">
                        <div class="pc-section__header pc-section__header--center">
                            <h2 class="pc-h2">Encaissez, gérez, analysez</h2>
                            <p class="pc-lead">Une solution complète du ticket de caisse au bilan comptable.</p>
                        </div>
                        <div class="pc-features-grid">
                            <div class="pc-feature" data-animate="fade-up">
                                <div class="pc-feature__icon" aria-hidden="true">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="2" y="5" width="20" height="14" rx="3" stroke="currentColor" stroke-width="1.5"/><path d="M2 10h20" stroke="currentColor" stroke-width="1.5"/><path d="M6 14h4M16 14h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                                </div>
                                <h3>Logiciel NF525</h3>
                                <p>Certification obligatoire depuis 2018. Inaltérabilité, sécurisation, conservation et archivage des données de paiement.</p>
                            </div>
                            <div class="pc-feature" data-animate="fade-up" data-delay="80">
                                <div class="pc-feature__icon" aria-hidden="true">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M3 3h18v4H3zM3 10h18v4H3zM3 17h18v4H3z" stroke="currentColor" stroke-width="1.5" rx="1"/></svg>
                                </div>
                                <h3>Gestion des stocks</h3>
                                <p>Inventaire en temps réel, alertes de réapprovisionnement, gestion multi-dépôt, traçabilité totale.</p>
                            </div>
                            <div class="pc-feature" data-animate="fade-up" data-delay="160">
                                <div class="pc-feature__icon" aria-hidden="true">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 20V10M6 20V14M18 20V6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                                </div>
                                <h3>Reporting avancé</h3>
                                <p>Tableaux de bord temps réel, CA par vendeur, par catégorie, par heure. Export comptabilité automatisé.</p>
                            </div>
                            <div class="pc-feature" data-animate="fade-up" data-delay="240">
                                <div class="pc-feature__icon" aria-hidden="true">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M8 2H4a2 2 0 00-2 2v4M8 22H4a2 2 0 01-2-2v-4M16 2h4a2 2 0 012 2v4M16 22h4a2 2 0 002-2v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                                </div>
                                <h3>Intégrations ERP</h3>
                                <p>Connecteurs natifs Odoo, Sage, Cegid, QuickBooks. API REST disponible pour intégrations custom.</p>
                            </div>
                        </div>
                        <div class="pc-section__footer">
                            <a href="/contact" class="pc-btn pc-btn--primary">Demander une démo</a>
                        </div>
                    </div>
                </section>
                <t t-call="paycore_website.engagements_section"/>
            </main>
            <t t-call="paycore_website.footer"/>
        </div>
        </xpath>
    </template>

</odoo>
