<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- NEWSLETTER                                                -->
    <!-- ========================================================= -->

    <template id="newsletter" name="Sneakers Newsletter">

        <section class="sn-newsletter">

            <div class="mn-container">

                <div class="sn-newsletter-content">

                    <!-- Left -->

                    <div class="sn-newsletter-text">

                        <span class="sn-section-subtitle">
                            Newsletter
                        </span>

                        <h2>
                            Stay Updated With Our Latest Offers
                        </h2>

                        <p>
                            Subscribe to receive exclusive promotions,
                            new arrivals and limited edition sneaker releases.
                        </p>

                    </div>

                    <!-- Right -->

                    <div class="sn-newsletter-form">

                        <form action="#" method="post">

                            <input
                                type="email"
                                placeholder="Enter your email address"
                                required="required"/>

                            <button type="submit">

                                Subscribe

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </section>

    </template>

</odoo>