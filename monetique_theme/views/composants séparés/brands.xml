<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- BRANDS SECTION                                            -->
    <!-- ========================================================= -->

    <template id="brands" name="Sneakers Brands">

        <section class="sn-brands">

            <div class="mn-container">

                <!-- Section Header -->

                <div class="sn-section-header">

                    <span class="sn-section-subtitle">
                        Trusted Brands
                    </span>

                    <h2>
                        Our Top Brands
                    </h2>

                    <p>
                        We collaborate with the world's leading sneaker brands
                        to provide authentic and premium-quality products.
                    </p>

                </div>

                <!-- Brands Grid -->

                <div class="sn-brands-grid">

                    <a href="#" class="sn-brand-card">
                        <img src="/monetique_theme/static/src/img/brands/nike.png"
                             alt="Nike"/>
                    </a>

                    <a href="#" class="sn-brand-card">
                        <img src="/monetique_theme/static/src/img/brands/adidas.png"
                             alt="Adidas"/>
                    </a>

                    <a href="#" class="sn-brand-card">
                        <img src="/monetique_theme/static/src/img/brands/puma.png"
                             alt="Puma"/>
                    </a>

                    <a href="#" class="sn-brand-card">
                        <img src="/monetique_theme/static/src/img/brands/newbalance.png"
                             alt="New Balance"/>
                    </a>

                    <a href="#" class="sn-brand-card">
                        <img src="/monetique_theme/static/src/img/brands/asics.png"
                             alt="Asics"/>
                    </a>

                    <a href="#" class="sn-brand-card">
                        <img src="/monetique_theme/static/src/img/brands/converse.png"
                             alt="Converse"/>
                    </a>

                </div>

            </div>

        </section>

    </template>

</odoo>