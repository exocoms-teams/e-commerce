<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- POPULAR PRODUCTS                                          -->
    <!-- ========================================================= -->

    <template id="popular_products" name="Sneakers Popular Products">

        <section class="sn-popular-products">

            <div class="mn-container">

                <!-- Section Header -->

                <div class="sn-section-header">

                    <span class="sn-section-subtitle">
                        Best Sellers
                    </span>

                    <h2>
                        Popular Products
                    </h2>

                    <p>
                        Discover our customers' favorite sneakers combining
                        comfort, performance and style.
                    </p>

                </div>

                <!-- Products Grid -->

                <div class="sn-products-grid">

                    <!-- Product 1 -->
                    <t t-call="monetique_theme.product_card">
                        <t t-set="product_name" t-value="'Nike Air Max 270'"/>
                        <t t-set="product_price" t-value="'$189.00'"/>
                        <t t-set="product_old_price" t-value="'$229.00'"/>
                        <t t-set="product_image" t-value="'/monetique_theme/static/src/img/products/product-1.jpg'"/>
                        <t t-set="product_badge" t-value="'NEW'"/>
                    </t>

                    <!-- Product 2 -->
                    <t t-call="monetique_theme.product_card">
                        <t t-set="product_name" t-value="'Adidas Ultraboost'"/>
                        <t t-set="product_price" t-value="'$175.00'"/>
                        <t t-set="product_old_price" t-value="'$210.00'"/>
                        <t t-set="product_image" t-value="'/monetique_theme/static/src/img/products/product-2.jpg'"/>
                        <t t-set="product_badge" t-value="'HOT'"/>
                    </t>

                    <!-- Product 3 -->
                    <t t-call="monetique_theme.product_card">
                        <t t-set="product_name" t-value="'Puma RS-X'"/>
                        <t t-set="product_price" t-value="'$145.00'"/>
                        <t t-set="product_old_price" t-value="'$180.00'"/>
                        <t t-set="product_image" t-value="'/monetique_theme/static/src/img/products/product-3.jpg'"/>
                        <t t-set="product_badge" t-value="'SALE'"/>
                    </t>

                    <!-- Product 4 -->
                    <t t-call="monetique_theme.product_card">
                        <t t-set="product_name" t-value="'New Balance 550'"/>
                        <t t-set="product_price" t-value="'$165.00'"/>
                        <t t-set="product_old_price" t-value="'$195.00'"/>
                        <t t-set="product_image" t-value="'/monetique_theme/static/src/img/products/product-4.jpg'"/>
                        <t t-set="product_badge" t-value="'NEW'"/>
                    </t>

                    <!-- Product 5 -->
                    <t t-call="monetique_theme.product_card">
                        <t t-set="product_name" t-value="'Nike Dunk Low'"/>
                        <t t-set="product_price" t-value="'$155.00'"/>
                        <t t-set="product_old_price" t-value="'$190.00'"/>
                        <t t-set="product_image" t-value="'/monetique_theme/static/src/img/products/product-5.jpg'"/>
                        <t t-set="product_badge" t-value="'BEST'"/>
                    </t>

                    <!-- Product 6 -->
                    <t t-call="monetique_theme.product_card">
                        <t t-set="product_name" t-value="'Jordan One High'"/>
                        <t t-set="product_price" t-value="'$249.00'"/>
                        <t t-set="product_old_price" t-value="'$299.00'"/>
                        <t t-set="product_image" t-value="'/monetique_theme/static/src/img/products/product-6.jpg'"/>
                        <t t-set="product_badge" t-value="'LIMITED'"/>
                    </t>

                    <!-- Product 7 -->
                    <t t-call="monetique_theme.product_card">
                        <t t-set="product_name" t-value="'Converse Chuck 70'"/>
                        <t t-set="product_price" t-value="'$119.00'"/>
                        <t t-set="product_old_price" t-value="'$149.00'"/>
                        <t t-set="product_image" t-value="'/monetique_theme/static/src/img/products/product-7.jpg'"/>
                        <t t-set="product_badge" t-value="'SALE'"/>
                    </t>

                    <!-- Product 8 -->
                    <t t-call="monetique_theme.product_card">
                        <t t-set="product_name" t-value="'Asics Gel Kayano'"/>
                        <t t-set="product_price" t-value="'$199.00'"/>
                        <t t-set="product_old_price" t-value="'$235.00'"/>
                        <t t-set="product_image" t-value="'/monetique_theme/static/src/img/products/product-8.jpg'"/>
                        <t t-set="product_badge" t-value="'NEW'"/>
                    </t>

                </div>

                <!-- Button -->

                <div class="sn-products-button">

                    <a href="/shop" class="sn-btn-primary">

                        View All Products

                    </a>

                </div>

            </div>

        </section>

    </template>

</odoo>