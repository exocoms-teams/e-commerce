                                    <div>
                                        <span class="mq-from">À partir de</span>
                                        <span class="mq-amount">19 € <small>/ mois</small></span>
                                    </div>
                                    <a href="#contact" class="mq-btn-primary sm">Devis</a>
                                </div>
                            </div>
                        </div>
                        <div class="mq-prod-card">
                            <div class="mq-prod-img-zone">
                                <img src="/monetique_theme/static/src/img/hero_tpe.png" alt="Borne MQ-Kiosk" class="mq-prod-img"/>
                            </div>
                            <div class="mq-prod-body">
                                <div class="mq-prod-ref">Réf. MQ-Kiosk</div>
