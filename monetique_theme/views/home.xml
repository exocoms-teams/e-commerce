<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page_home" name="Monetique - Accueil">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'home'"/>

            <!-- ═══════════════════════════════════════════ -->
            <!--  NAVBAR                                      -->
            <!-- ═══════════════════════════════════════════ -->
            <div id="mq-navbar">
                <div class="mq-container mq-nav-inner">
                    <a href="/" class="mq-logo">
                        <span class="mq-logo-icon">◈</span>
                        <span class="mq-logo-text">e<strong>Monétique</strong></span>
                    </a>
                    <nav class="mq-nav-links">
                        <a href="#solutions">Solutions</a>
                        <a href="#produits">Produits</a>
                        <a href="#avantages">Avantages</a>
                        <a href="#temoignages">Avis</a>
                        <a href="#contact">Contact</a>
                    </nav>
                    <a href="#contact" class="mq-btn-nav">Demander un devis</a>
                </div>
            </div>

            <!-- ═══════════════════════════════════════════ -->
            <!--  HERO                                        -->
            <!-- ═══════════════════════════════════════════ -->
            <section id="mq-hero">
                <div class="mq-hero-bg">
                    <div class="mq-hero-circle c1"></div>
                    <div class="mq-hero-circle c2"></div>
                    <div class="mq-hero-grid"></div>
                </div>
                <div class="mq-container mq-hero-inner">
                    <div class="mq-hero-content">
                        <div class="mq-badge">✦ Solutions de paiement nouvelle génération</div>
                        <h1>Encaissez <em>partout</em>,<br/>payez <em>sans friction</em></h1>
                        <p class="mq-hero-sub">Des terminaux de paiement intelligents et des solutions monétiques sur-mesure pour les commerçants, PME et grandes enseignes. Fiables, certifiés, instantanés.</p>
                        <div class="mq-hero-actions">
                            <a href="#contact" class="mq-btn-primary">Démarrer maintenant →</a>
                            <a href="#solutions" class="mq-btn-ghost">Voir nos solutions</a>
                        </div>
                        <div class="mq-hero-stats">
                            <div class="mq-stat">
                                <span class="mq-stat-num">+12 000</span>
                                <span class="mq-stat-label">Terminaux déployés</span>
                            </div>
                            <div class="mq-stat-sep"></div>
                            <div class="mq-stat">
                                <span class="mq-stat-num">99,9%</span>
                                <span class="mq-stat-label">Disponibilité</span>
                            </div>
                            <div class="mq-stat-sep"></div>
                            <div class="mq-stat">
                                <span class="mq-stat-num">&lt; 2s</span>
                                <span class="mq-stat-label">Temps de transaction</span>
                            </div>
                        </div>
                    </div>
                    <div class="mq-hero-visual">
                        <div class="mq-tpe-card">
                            <div class="mq-tpe-screen">
                                <div class="mq-tpe-amount">47,50 €</div>
                                <div class="mq-tpe-status">Paiement approuvé ✓</div>
                            </div>
                            <div class="mq-tpe-body">
                                <div class="mq-tpe-chip">
                                    <div class="chip-line"></div>
                                    <div class="chip-line"></div>
                                    <div class="chip-line"></div>
                                </div>
                                <div class="mq-tpe-nfc">((·))</div>
                            </div>
                            <div class="mq-tpe-glow"></div>
                        </div>
                        <div class="mq-float-badge b1">NFC &amp; Sans contact</div>
                        <div class="mq-float-badge b2">Certifié PCI-DSS</div>
                        <div class="mq-float-badge b3">4G + WiFi</div>
                    </div>
                </div>
            </section>

            <!-- ═══════════════════════════════════════════ -->
            <!--  LOGOS / CONFIANCE                           -->
            <!-- ═══════════════════════════════════════════ -->
            <section id="mq-trust">
                <div class="mq-container">
                    <p class="mq-trust-label">Ils nous font confiance</p>
                    <div class="mq-trust-logos">
                        <span class="mq-trust-item">Carrefour</span>
                        <span class="mq-trust-dot">·</span>
                        <span class="mq-trust-item">SNCF</span>
                        <span class="mq-trust-dot">·</span>
                        <span class="mq-trust-item">Décathlon</span>
                        <span class="mq-trust-dot">·</span>
                        <span class="mq-trust-item">Accor</span>
                        <span class="mq-trust-dot">·</span>
                        <span class="mq-trust-item">Total Énergies</span>
                        <span class="mq-trust-dot">·</span>
                        <span class="mq-trust-item">Orange</span>
                    </div>
                </div>
            </section>

            <!-- ═══════════════════════════════════════════ -->
            <!--  SOLUTIONS                                   -->
            <!-- ═══════════════════════════════════════════ -->
            <section id="solutions" class="mq-section">
                <div class="mq-container">
                    <div class="mq-section-header">
                        <div class="mq-section-tag">Solutions</div>
                        <h2>Tout ce dont vous avez besoin<br/>pour encaisser efficacement</h2>
                        <p>Une gamme complète de solutions monétiques adaptées à chaque secteur d'activité.</p>
                    </div>
                    <div class="mq-solutions-grid">
                        <div class="mq-solution-card featured">
                            <div class="mq-sol-icon">⬡</div>
                            <h3>TPE Comptoir</h3>
                            <p>Terminal fixe haute performance pour points de vente physiques. Écran tactile, impression rapide, multi-devises.</p>
                            <ul class="mq-sol-list">
                                <li>Connexion Ethernet &amp; WiFi</li>
                                <li>Impression thermique intégrée</li>
                                <li>Support CB, Visa, Mastercard, Apple Pay, Google Pay</li>
                            </ul>
                            <a href="#contact" class="mq-sol-link">En savoir plus →</a>
                        </div>
                        <div class="mq-solution-card">
                            <div class="mq-sol-icon">◎</div>
                            <h3>TPE Mobile</h3>
                            <p>Encaissez n'importe où. Terminal portable avec batterie longue durée et connectivité 4G.</p>
                            <ul class="mq-sol-list">
                                <li>Autonomie 12h</li>
                                <li>4G / WiFi / Bluetooth</li>
                                <li>Paiement sans contact NFC</li>
                            </ul>
                            <a href="#contact" class="mq-sol-link">En savoir plus →</a>
                        </div>
                        <div class="mq-solution-card">
                            <div class="mq-sol-icon">▣</div>
                            <h3>Paiement en ligne</h3>
                            <p>Passerelle de paiement sécurisée pour votre e-commerce. Intégration API simple et rapide.</p>
                            <ul class="mq-sol-list">
                                <li>Intégration WooCommerce / Shopify</li>
                                <li>3D Secure v2</li>
                                <li>Tableau de bord temps réel</li>
                            </ul>
                            <a href="#contact" class="mq-sol-link">En savoir plus →</a>
                        </div>
                        <div class="mq-solution-card">
                            <div class="mq-sol-icon">◈</div>
                            <h3>Solution sur-mesure</h3>
                            <p>Architecture monétique complète pour grandes enseignes et réseaux multi-sites.</p>
                            <ul class="mq-sol-list">
                                <li>Déploiement massif clé en main</li>
                                <li>Supervision centralisée</li>
                                <li>SLA 99,9% garanti</li>
                            </ul>
                            <a href="#contact" class="mq-sol-link">En savoir plus →</a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══════════════════════════════════════════ -->
            <!--  PRODUITS                                    -->
            <!-- ═══════════════════════════════════════════ -->
            <section id="produits" class="mq-section mq-section-alt">
                <div class="mq-container">
                    <div class="mq-section-header">
                        <div class="mq-section-tag">Produits</div>
                        <h2>Nos terminaux phares</h2>
                        <p>Des équipements certifiés, robustes et performants pour tous vos besoins.</p>
                    </div>
                    <div class="mq-products-grid">
                        <div class="mq-product-card">
                            <div class="mq-product-badge">Bestseller</div>
                            <div class="mq-product-visual">
                                <div class="mq-product-tpe t1">
                                    <div class="pt-screen"></div>
                                    <div class="pt-body"></div>
                                    <div class="pt-base"></div>
                                </div>
                            </div>
                            <div class="mq-product-info">
                                <span class="mq-product-ref">MQ-3000 Pro</span>
                                <h3>Terminal Comptoir Tactile</h3>
                                <p>Écran 5,5" tactile, imprimante intégrée, NFC, dual SIM 4G</p>
                                <div class="mq-product-price">
                                    <span class="price-from">À partir de</span>
                                    <span class="price-amount">29€<small>/mois</small></span>
                                </div>
                                <a href="#contact" class="mq-btn-primary">Demander un devis</a>
                            </div>
                        </div>
                        <div class="mq-product-card">
                            <div class="mq-product-badge new">Nouveau</div>
                            <div class="mq-product-visual">
                                <div class="mq-product-tpe t2">
                                    <div class="pt-screen"></div>
                                    <div class="pt-body"></div>
                                </div>
                            </div>
                            <div class="mq-product-info">
                                <span class="mq-product-ref">MQ-Go</span>
                                <h3>Terminal Mobile 4G</h3>
                                <p>Ultra compact, batterie 12h, NFC, Android embarqué</p>
                                <div class="mq-product-price">
                                    <span class="price-from">À partir de</span>
                                    <span class="price-amount">19€<small>/mois</small></span>
                                </div>
                                <a href="#contact" class="mq-btn-primary">Demander un devis</a>
                            </div>
                        </div>
                        <div class="mq-product-card">
                            <div class="mq-product-visual">
                                <div class="mq-product-tpe t3">
                                    <div class="pt-screen wide"></div>
                                    <div class="pt-body flat"></div>
                                </div>
                            </div>
                            <div class="mq-product-info">
                                <span class="mq-product-ref">MQ-Kiosk</span>
                                <h3>Borne de Paiement</h3>
                                <p>Borne libre-service, grand écran tactile, billets et cartes</p>
                                <div class="mq-product-price">
                                    <span class="price-from">Sur devis</span>
                                    <span class="price-amount">—</span>
                                </div>
                                <a href="#contact" class="mq-btn-primary">Nous contacter</a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══════════════════════════════════════════ -->
            <!--  AVANTAGES                                   -->
            <!-- ═══════════════════════════════════════════ -->
            <section id="avantages" class="mq-section">
                <div class="mq-container">
                    <div class="mq-advantages-layout">
                        <div class="mq-advantages-left">
                            <div class="mq-section-tag">Pourquoi nous</div>
                            <h2>La monétique réinventée pour les pros</h2>
                            <p>Nous combinons la robustesse des infrastructures bancaires avec la simplicité d'une solution moderne.</p>
                            <a href="#contact" class="mq-btn-primary" style="margin-top:2rem;display:inline-block;">Parler à un expert →</a>
                        </div>
                        <div class="mq-advantages-right">
                            <div class="mq-adv-item">
                                <div class="mq-adv-icon">⚡</div>
                                <div>
                                    <h4>Transactions ultra-rapides</h4>
                                    <p>Moins de 2 secondes par transaction. Zéro attente pour vos clients.</p>
                                </div>
                            </div>
                            <div class="mq-adv-item">
                                <div class="mq-adv-icon">🔒</div>
                                <div>
                                    <h4>Sécurité maximale</h4>
                                    <p>Certification PCI-DSS niveau 1, chiffrement de bout en bout, tokenisation.</p>
                                </div>
                            </div>
                            <div class="mq-adv-item">
                                <div class="mq-adv-icon">📊</div>
                                <div>
                                    <h4>Reporting en temps réel</h4>
                                    <p>Dashboard unifié, exports comptables, alertes personnalisées.</p>
                                </div>
                            </div>
                            <div class="mq-adv-item">
                                <div class="mq-adv-icon">🛠</div>
                                <div>
                                    <h4>Support 24/7</h4>
                                    <p>Hotline dédiée, intervention sur site sous 4h, maintenance préventive.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══════════════════════════════════════════ -->
            <!--  TEMOIGNAGES                                 -->
            <!-- ═══════════════════════════════════════════ -->
            <section id="temoignages" class="mq-section mq-section-dark">
                <div class="mq-container">
                    <div class="mq-section-header light">
                        <div class="mq-section-tag">Témoignages</div>
                        <h2>Ce que disent nos clients</h2>
                    </div>
                    <div class="mq-reviews-grid">
                        <div class="mq-review-card">
                            <div class="mq-review-stars">★★★★★</div>
                            <p>"Depuis l'installation des TPE Mobile, nos livreurs encaissent directement à la livraison. Le taux d'impayés a chuté de 80%. Service impeccable."</p>
                            <div class="mq-review-author">
                                <div class="mq-review-avatar">ML</div>
                                <div>
                                    <strong>Marc L.</strong>
                                    <span>Directeur Logistique, Express Pro</span>
                                </div>
                            </div>
                        </div>
                        <div class="mq-review-card">
                            <div class="mq-review-stars">★★★★★</div>
                            <p>"Mise en place en 48h sur nos 12 points de vente. L'interface du dashboard est vraiment intuitive. On voit toutes nos transactions en temps réel."</p>
                            <div class="mq-review-author">
                                <div class="mq-review-avatar">SC</div>
                                <div>
                                    <strong>Sophie C.</strong>
                                    <span>Responsable Caisse, Groupe Beauté+</span>
                                </div>
                            </div>
                        </div>
                        <div class="mq-review-card">
                            <div class="mq-review-stars">★★★★★</div>
                            <p>"Le support technique est exceptionnel. Un problème à 22h un dimanche, résolu en 20 minutes par téléphone. On ne change pas de prestataire !"</p>
                            <div class="mq-review-author">
                                <div class="mq-review-avatar">TP</div>
                                <div>
                                    <strong>Thomas P.</strong>
                                    <span>Gérant, Restaurants Les Saveurs</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══════════════════════════════════════════ -->
            <!--  CONTACT                                     -->
            <!-- ═══════════════════════════════════════════ -->
            <section id="contact" class="mq-section">
                <div class="mq-container">
                    <div class="mq-contact-layout">
                        <div class="mq-contact-left">
                            <div class="mq-section-tag">Contact</div>
                            <h2>Parlons de votre projet</h2>
                            <p>Un expert vous répond sous 24h pour étudier vos besoins et vous proposer la solution idéale.</p>
                            <div class="mq-contact-infos">
                                <div class="mq-contact-item">
                                    <span class="mq-ci-icon">📞</span>
                                    <span>+33 1 XX XX XX XX</span>
                                </div>
                                <div class="mq-contact-item">
                                    <span class="mq-ci-icon">✉</span>
                                    <span>contact@e-monetique.fr</span>
                                </div>
                                <div class="mq-contact-item">
                                    <span class="mq-ci-icon">📍</span>
                                    <span>Paris, France</span>
                                </div>
                            </div>
                        </div>
                        <div class="mq-contact-right">
                            <div class="mq-contact-form">
                                <div class="mq-form-row">
                                    <div class="mq-form-group">
                                        <label>Prénom &amp; Nom</label>
                                        <input type="text" placeholder="Jean Dupont" class="mq-input"/>
                                    </div>
                                    <div class="mq-form-group">
                                        <label>Entreprise</label>
                                        <input type="text" placeholder="Ma Société SAS" class="mq-input"/>
                                    </div>
                                </div>
                                <div class="mq-form-group">
                                    <label>Email professionnel</label>
                                    <input type="email" placeholder="jean@masociete.fr" class="mq-input"/>
                                </div>
                                <div class="mq-form-group">
                                    <label>Votre besoin</label>
                                    <select class="mq-input">
                                        <option>TPE Comptoir</option>
                                        <option>TPE Mobile</option>
                                        <option>Paiement en ligne</option>
                                        <option>Solution sur-mesure</option>
                                    </select>
                                </div>
                                <div class="mq-form-group">
                                    <label>Message</label>
                                    <textarea placeholder="Décrivez votre projet..." class="mq-input mq-textarea" rows="4"></textarea>
                                </div>
                                <button type="button" class="mq-btn-primary full">Envoyer ma demande →</button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ═══════════════════════════════════════════ -->
            <!--  FOOTER                                      -->
            <!-- ═══════════════════════════════════════════ -->
            <footer id="mq-footer">
                <div class="mq-container">
                    <div class="mq-footer-top">
                        <div class="mq-footer-brand">
                            <a href="/" class="mq-logo">
                                <span class="mq-logo-icon">◈</span>
                                <span class="mq-logo-text">e<strong>Monétique</strong></span>
                            </a>
                            <p>Solutions monétiques professionnelles pour commerçants et entreprises en France.</p>
                        </div>
                        <div class="mq-footer-col">
                            <h5>Solutions</h5>
                            <a href="#solutions">TPE Comptoir</a>
                            <a href="#solutions">TPE Mobile</a>
                            <a href="#solutions">Paiement en ligne</a>
                            <a href="#solutions">Sur-mesure</a>
                        </div>
                        <div class="mq-footer-col">
                            <h5>Entreprise</h5>
                            <a href="#">À propos</a>
                            <a href="#">Nos certifications</a>
                            <a href="#">Partenaires</a>
                            <a href="#">Recrutement</a>
                        </div>
                        <div class="mq-footer-col">
                            <h5>Support</h5>
                            <a href="#">Documentation</a>
                            <a href="#">Hotline 24/7</a>
                            <a href="#">FAQ</a>
                            <a href="#contact">Contact</a>
                        </div>
                    </div>
                    <div class="mq-footer-bottom">
                        <span>© 2025 eMonétique · Tous droits réservés</span>
                        <div class="mq-footer-legal">
                            <a href="#">Mentions légales</a>
                            <a href="#">CGV</a>
                            <a href="#">Politique de confidentialité</a>
                        </div>
                    </div>
                </div>
            </footer>

        </t>
    </template>
</odoo>
