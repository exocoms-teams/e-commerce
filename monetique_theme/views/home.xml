                            <div class="mq-footer-certs"><span>PCI-DSS</span><span>EMV</span><span>NF525</span></div>
                        </div>
                        <div class="mq-footer-col">
                            <h5>Solutions</h5>
                            <a href="#solutions">TPE Comptoir</a>
                            <a href="#solutions">TPE Mobile 4G</a>
                            <a href="#solutions">Paiement en ligne</a>
