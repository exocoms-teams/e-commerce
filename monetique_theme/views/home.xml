                        <div class="mq-hero-btns">
                            <a href="#produits" class="mq-btn-primary">Découvrir nos produits</a>
                            <a href="#contact" class="mq-btn-outline-dark">Demander un devis</a>
                        </div>
                        <div class="mq-hero-badges">
                            <div class="mq-hbadge">
                                <span class="mq-hbadge-icon">🛡️</span>
                                <div>
                                    <strong>Sécurisé</strong>
                                    <span>Certifié PCI-DSS niveau 1</span>
                                </div>
                            </div>
                            <div class="mq-hbadge">
                                <span class="mq-hbadge-icon">⚡</span>
                                <div>
                                    <strong>Rapide</strong>
                                    <span>Transactions en moins de 2 secondes</span>
                                </div>
                            </div>
                            <div class="mq-hbadge">
                                <span class="mq-hbadge-icon">🎧</span>
                                <div>
                                    <strong>Disponible</strong>
                                    <span>Support technique 24h/7j</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mq-hero-right">
                        <div class="mq-hero-dots"></div>
                        <img src="/monetique_theme/static/src/img/hero_tpe.png" alt="Terminal de paiement Monétique" class="mq-hero-tpe"/>
                    </div>
                </div>
            </section>

            <!-- ══ PRODUITS ══ -->
            <section id="produits" class="mq-section mq-section-light">
                <div class="mq-container">
                    <div class="mq-section-head">
                        <div class="mq-tag">NOS PRODUITS</div>
                        <h2>Des terminaux adaptés à chaque besoin</h2>
                    </div>
                    <div class="mq-prod-grid">
                        <!-- MQ-3000 PRO -->
                        <div class="mq-prod-card">
                            <div class="mq-prod-img-zone">
                                <span class="mq-badge mq-badge-blue">BEST-SELLER</span>
                                <img src="/monetique_theme/static/src/img/hero_tpe.png" alt="MQ-3000 PRO" class="mq-prod-img"/>
                            </div>
                            <div class="mq-prod-body">
                                <div class="mq-prod-specs">
                                    <span>📱 Écran 5,5" IPS</span>
                                    <span>📶 Connexion 4G / WiFi</span>
                                    <span>🔋 Batterie 12H</span>
                                </div>
                                <h3>MQ-3000 PRO</h3>
                                <p>Terminal Comptoir Tactile</p>
                                <a href="#contact" class="mq-prod-link">En savoir plus →</a>
                            </div>
                        </div>
                        <!-- MQ-GO -->
                        <div class="mq-prod-card">
                            <div class="mq-prod-img-zone">
                                <span class="mq-badge mq-badge-green">NOUVEAU</span>
                                <img src="/monetique_theme/static/src/img/hero_tpe.png" alt="MQ-GO" class="mq-prod-img"/>
                            </div>
                            <div class="mq-prod-body">
                                <div class="mq-prod-specs">
                                    <span>📱 Écran 3,5"</span>
                                    <span>📶 4G / WiFi / BT</span>
                                    <span>🔋 Batterie 12H</span>
                                </div>
                                <h3>MQ-GO</h3>
                                <p>Terminal Mobile 4G</p>
                                <a href="#contact" class="mq-prod-link">En savoir plus →</a>
                            </div>
                        </div>
                        <!-- MQ-KIOSK -->
                        <div class="mq-prod-card">
                            <div class="mq-prod-img-zone">
                                <img src="/monetique_theme/static/src/img/hero_tpe.png" alt="MQ-KIOSK" class="mq-prod-img"/>
                            </div>
                            <div class="mq-prod-body">
                                <div class="mq-prod-specs">
                                    <span>🖥️ Écran 15"</span>
                                    <span>📶 Ethernet / 4G</span>
                                    <span>🖨️ Imprimante Intégrée</span>
                                </div>
                                <h3>MQ-KIOSK</h3>
                                <p>Borne de Paiement</p>
                                <a href="#contact" class="mq-prod-link">En savoir plus →</a>
                            </div>
                        </div>
                    </div>
                </div>
