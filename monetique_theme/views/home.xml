            <!-- ══ STATS ══ -->
            <section id="mq-stats">
                <div class="mq-container mq-stats-row">
                    <div class="mq-stat">
                        <span class="mq-stat-ico">🚀</span>
                        <strong>+12 000</strong>
                        <span>Terminaux déployés</span>
                    </div>
                    <div class="mq-stat-sep"></div>
                    <div class="mq-stat">
                        <span class="mq-stat-ico">🛡️</span>
                        <strong>99,9%</strong>
                        <span>Disponibilité garantie</span>
                    </div>
                    <div class="mq-stat-sep"></div>
                    <div class="mq-stat">
                        <span class="mq-stat-ico">👥</span>
                        <strong>500+</strong>
                        <span>Clients actifs</span>
                    </div>
                    <div class="mq-stat-sep"></div>
                    <div class="mq-stat">
                        <span class="mq-stat-ico">🎧</span>
                        <strong>24h/7j</strong>
                        <span>Support technique</span>
                    </div>
                    <div class="mq-stat-sep"></div>
                    <div class="mq-stat">
                        <span class="mq-stat-ico">⚡</span>
                        <strong>&lt; 2s</strong>
                        <span>Temps de transaction</span>
                    </div>
                </div>
            </section>

            <!-- ══ CLIENTS ══ -->
            <section id="mq-clients">
                <div class="mq-container">
                    <div class="mq-clients-tag">ILS NOUS FONT CONFIANCE</div>
                    <div class="mq-clients-logos">
                        <span class="mq-logo-carrefour">Carrefour 🔵</span>
                        <span class="mq-logo-sncf">SNCF</span>
                        <span class="mq-logo-deca">DECATHLON</span>
                        <span class="mq-logo-accor">ACCOR</span>
                        <span class="mq-logo-total">TotalÉnergies</span>
                        <span class="mq-logo-orange">orange</span>
                        <span class="mq-logo-sodexo">sodexo</span>
                    </div>
                </div>
