    <!-- Le header natif d Odoo est remplace par la topbar EXOCOMS,
         la sidebar est injectee avant #wrapwrap. -->
    <template id="layout" inherit_id="website.layout" name="EXOCOMS - Layout">
        <xpath expr="//header" position="replace">
            <t t-call="theme_exocoms.topbar"/>
        </xpath>
        <xpath expr="//div[@id=&apos;wrapwrap&apos;]" position="before">
            <t t-call="theme_exocoms.sidebar"/>
        </xpath>
        <xpath expr="//footer" position="replace">
            <t t-call="theme_exocoms.footer_exo"/>
        </xpath>
    </template>

</odoo>
