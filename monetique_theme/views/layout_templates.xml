<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         EXOCOMS STYLE LAYOUT
    ============================================================ -->

    <template id="layout_exocoms" inherit_id="website.layout">

        <!-- HEADER -->
        <xpath expr="//header" position="replace">

            <header class="exo-header">

                <div class="exo-header-container">

                    <!-- LOGO -->
                    <a href="/" class="exo-logo">
                        <img
                            src="/monetique_theme/static/src/img/logo.png"
                            alt="Exocoms"
                        />
                    </a>

                    <!-- NAVIGATION -->
                    <nav class="exo-nav">

                        <ul class="exo-menu">

                            <li>
                                <a href="/">Accueil</a>
                            </li>

                            <li class="exo-dropdown">

                                <a href="#">
                                    Informatique
                                    <i class="fa fa-chevron-down"></i>
                                </a>

                                <div class="exo-dropdown-menu">

                                    <a href="/shop/category/informatique">
                                        Services IT
                                    </a>

                                    <a href="/shop/category/maintenance">
                                        Maintenance
                                    </a>

                                    <a href="/shop/category/reseau">
                                        Réseaux
                                    </a>

                                </div>

                            </li>

                            <li class="exo-dropdown">

                                <a href="#">
                                    Monétique
                                    <i class="fa fa-chevron-down"></i>
                                </a>

                                <div class="exo-dropdown-menu">

                                    <a href="/shop/category/monetique">
                                        Tous les TPE
                                    </a>

                                    <a href="/shop/category/tpe-fixe">
                                        TPE Fixe
                                    </a>

                                    <a href="/shop/category/tpe-portable">
                                        TPE Portable
                                    </a>

                                    <a href="/shop/category/tpe-mobile">
                                        TPE Mobile
                                    </a>

                                </div>

                            </li>

                            <li class="exo-dropdown">

                                <a href="#">
                                    Télécom
                                    <i class="fa fa-chevron-down"></i>
                                </a>

                                <div class="exo-dropdown-menu">

                                    <a href="/shop/category/telecom">
                                        Téléphonie
                                    </a>

                                    <a href="/shop/category/fibre">
                                        Fibre
                                    </a>

                                </div>

                            </li>

                            <li>
                                <a href="/jobs">
                                    Emplois
                                </a>
                            </li>

                            <li>
                                <a href="/about">
                                    Nos métiers
                                </a>
                            </li>

                        </ul>

                    </nav>

                    <!-- ACTIONS -->
                    <div class="exo-actions">

                        <!-- CART -->
                        <a href="/shop/cart" class="exo-action-btn">
                            <i class="fa fa-shopping-cart"></i>
                        </a>

                        <!-- WISHLIST -->
                        <a href="/shop/wishlist" class="exo-action-btn">
                            <i class="fa fa-heart"></i>
                        </a>

                        <!-- SEARCH -->
                        <a href="/shop" class="exo-action-btn">
                            <i class="fa fa-search"></i>
                        </a>

                        <!-- ACCOUNT -->
                        <t t-if="request.env.user._is_public()">

                            <a href="/web/login" class="exo-account">
                                Connexion
                            </a>

                        </t>

                        <t t-else="">

                            <a href="/my/home" class="exo-account">

                                <t t-esc="request.env.user.name"/>

                                <i class="fa fa-chevron-down"></i>

                            </a>

                        </t>

                    </div>

                </div>

            </header>

        </xpath>

        <!-- FOOTER -->
        <xpath expr="//footer" position="replace">

            <footer class="exo-footer">

                <!-- SERVICES -->
                <section class="exo-footer-services">

                    <div class="exo-container">

                        <div class="exo-service">

                            <div class="exo-service-icon">
                                <i class="fa fa-dropbox"></i>
                            </div>

                            <div>
                                <h3>Retours faciles</h3>

                                <p>
                                    Retours pendant 30 jours avec remboursement rapide.
                                </p>
                            </div>

                        </div>

                        <div class="exo-service">

                            <div class="exo-service-icon">
                                <i class="fa fa-truck"></i>
                            </div>

                            <div>
                                <h3>Expédition</h3>

                                <p>
                                    Livraison rapide sur toutes les commandes.
                                </p>
                            </div>

                        </div>

                        <div class="exo-service">

                            <div class="exo-service-icon">
                                <i class="fa fa-lock"></i>
                            </div>

                            <div>
                                <h3>Paiement sécurisé</h3>

                                <p>
                                    Vos informations sont protégées.
                                </p>
                            </div>

                        </div>

                        <div class="exo-service">

                            <div class="exo-service-icon">
                                <i class="fa fa-certificate"></i>
                            </div>

                            <div>
                                <h3>Qualité garantie</h3>

                                <p>
                                    Produits testés et certifiés.
                                </p>
                            </div>

                        </div>

                    </div>

                </section>

                <!-- MAIN FOOTER -->
                <section class="exo-footer-main">

                    <div class="exo-container">

                        <!-- ABOUT -->
                        <div class="exo-footer-col">

                            <h2>À propos de nous</h2>

                            <p>
                                Nous sommes une équipe spécialisée dans les
                                solutions technologiques et monétiques.
                            </p>

                            <p>
                                Nos produits sont conçus pour les PME et
                                les entreprises modernes.
                            </p>

                        </div>

                        <!-- LINKS -->
                        <div class="exo-footer-col">

                            <h2>Liens utiles</h2>

                            <ul>

                                <li>
                                    <a href="/">
                                        Page d'accueil
                                    </a>
                                </li>

                                <li>
                                    <a href="/about">
                                        À propos
                                    </a>
                                </li>

                                <li>
                                    <a href="/shop">
                                        Produits
                                    </a>
                                </li>

                                <li>
                                    <a href="/contact">
                                        Contact
                                    </a>
                                </li>

                            </ul>

                        </div>

                        <!-- CONTACT -->
                        <div class="exo-footer-col">

                            <h2>Rejoignez-nous</h2>

                            <ul>

                                <li>
                                    <i class="fa fa-comment"></i>
                                    Contactez-nous
                                </li>

                                <li>
                                    <i class="fa fa-envelope"></i>
                                    contact@exocoms.fr
                                </li>

                                <li>
                                    <i class="fa fa-phone"></i>
                                    +33 01 84 79 37 55
                                </li>

                            </ul>

                        </div>

                    </div>

                </section>

            </footer>

        </xpath>

    </template>

</odoo>