<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         SHOP — Intégration website_sale
         On n'écrase rien : uniquement un header de page
         et un breadcrumb ajoutés en before.
    ============================================================ -->

    <!-- Header sur la page boutique /shop -->
    <template id="shop_header" name="Shop Header"
              inherit_id="website_sale.products">
        <xpath expr="//div[@id='wrap']" position="before">
            <div class="mq-shop-header">
                <div class="mq-container">
                    <div class="mq-shop-breadcrumb">
                        <a href="/">Accueil</a> ›
                        <span>Boutique</span>
                    </div>
                    <h1 class="mq-shop-title">Nos terminaux de paiement</h1>
                    <p class="mq-shop-sub">
                        Découvrez notre gamme complète de terminaux
                    </p>
                </div>
            </div>
        </xpath>
    </template>

