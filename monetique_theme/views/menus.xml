<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Menu principal website -->
        <record id="menu_solutions" model="website.menu">
            <field name="name">Solutions</field>
            <field name="url">/services</field>
            <field name="sequence">10</field>
        </record>

        <record id="menu_tpe" model="website.menu">
            <field name="name">Terminaux TPE</field>
            <field name="url">/solutions/tpe</field>
            <field name="parent_id" ref="menu_solutions"/>
            <field name="sequence">10</field>
        </record>

        <record id="menu_encaissement" model="website.menu">
            <field name="name">Encaissement</field>
            <field name="url">/solutions/encaissement</field>
            <field name="parent_id" ref="menu_solutions"/>
            <field name="sequence">20</field>
        </record>

        <record id="menu_omnicanal" model="website.menu">
            <field name="name">Paiement Omnicanal</field>
            <field name="url">/solutions/paiement-omnicanal</field>
            <field name="parent_id" ref="menu_solutions"/>
            <field name="sequence">30</field>
        </record>

        <record id="menu_support" model="website.menu">
            <field name="name">Support</field>
            <field name="url">/support</field>
            <field name="sequence">20</field>
        </record>

        <record id="menu_about" model="website.menu">
            <field name="name">À propos</field>
            <field name="url">/a-propos</field>
            <field name="sequence">30</field>
        </record>

        <record id="menu_contact" model="website.menu">
            <field name="name">Contact</field>
            <field name="url">/contact</field>
            <field name="sequence">40</field>
        </record>
    </data>
</odoo>
