<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         PAGE SOLUTIONS
    ============================================================ -->

    <record id="page_solutions_view" model="ir.ui.view">
        <field name="name">monetique.page.solutions</field>
        <field name="type">qweb</field>
        <field name="key">monetique_theme.page_solutions</field>

        <field name="arch" type="xml">
            <t t-name="monetique_theme.page_solutions">

                <t t-call="website.layout">

                    <div class="mq-page-hero">
                        <div class="mq-container">
                            <div class="mq-breadcrumb">
                                <a href="/">Accueil</a> &gt; Solutions
                            </div>

                            <h1 class="mq-page-title">
                                Nos solutions de paiement
                            </h1>

                            <p class="mq-page-subtitle">
                                Des solutions innovantes pour répondre à tous vos besoins
                            </p>
                        </div>
                    </div>

                    <section class="mq-solutions-section">
                        <div class="mq-container">

                            <div class="mq-solutions-grid">

                                <a href="/shop" class="mq-sol-card" id="terminaux-fixes">

                                    <div class="mq-sol-img">

                                        <div class="mq-sol-img-placeholder">
                                            <i class="fa fa-credit-card"></i>
                                            <span>Image terminaux</span>
                                        </div>

                                    </div>

                                    <div class="mq-sol-body">

                                        <h3 class="mq-sol-title">
                                            Terminaux de paiement
                                        </h3>

                                        <p class="mq-sol-p">
                                            Des terminaux performants et fiables adaptés à tous les commerces.
                                        </p>

                                        <span class="mq-sol-link">
                                            En savoir plus
                                            <i class="fa fa-arrow-right"></i>
                                        </span>

                                    </div>

                                </a>

                                <a href="/shop" class="mq-sol-card" id="mobile">

                                    <div class="mq-sol-img">

                                        <div class="mq-sol-img-placeholder">
                                            <i class="fa fa-mobile"></i>
                                            <span>Image mobile</span>
                                        </div>

                                    </div>

                                    <div class="mq-sol-body">

                                        <h3 class="mq-sol-title">
                                            Paiement mobile
                                        </h3>

                                        <p class="mq-sol-p">
                                            Acceptez les paiements partout avec nos solutions mobiles.
                                        </p>

                                        <span class="mq-sol-link">
                                            En savoir plus
                                            <i class="fa fa-arrow-right"></i>
                                        </span>

                                    </div>

                                </a>

                                <a href="/shop" class="mq-sol-card" id="en-ligne">

                                    <div class="mq-sol-img">

                                        <div class="mq-sol-img-placeholder">
                                            <i class="fa fa-shopping-cart"></i>
                                            <span>Image en ligne</span>
                                        </div>

                                    </div>

                                    <div class="mq-sol-body">

                                        <h3 class="mq-sol-title">
                                            Paiement en ligne
                                        </h3>

                                        <p class="mq-sol-p">
                                            Solutions e-commerce sécurisées pour vos ventes en ligne.
                                        </p>

                                        <span class="mq-sol-link">
                                            En savoir plus
                                            <i class="fa fa-arrow-right"></i>
                                        </span>

                                    </div>

                                </a>

                                <a href="/contact" class="mq-sol-card" id="support">

                                    <div class="mq-sol-img">

                                        <div class="mq-sol-img-placeholder">
                                            <i class="fa fa-headphones"></i>
                                            <span>Image support</span>
                                        </div>

                                    </div>

                                    <div class="mq-sol-body">

                                        <h3 class="mq-sol-title">
                                            Services &amp; support
                                        </h3>

                                        <p class="mq-sol-p">
                                            Un service client dédié et un accompagnement sur-mesure.
                                        </p>

                                        <span class="mq-sol-link">
                                            En savoir plus
                                            <i class="fa fa-arrow-right"></i>
                                        </span>

                                    </div>

                                </a>

                            </div>

                        </div>
                    </section>

                    <div class="mq-cta-band">

                        <div class="mq-container">

                            <div>
                                <h3>Besoin d'un conseil ?</h3>

                                <p>
                                    Nos experts vous accompagnent dans votre projet.
                                </p>
                            </div>

                            <a
                                href="#"
                                class="mq-btn-white"
                                data-rappel-trigger="1"
                            >
                                Être rappelé
                            </a>

                        </div>

                    </div>

                </t>

            </t>
        </field>
    </record>



    <!-- ============================================================
         PAGE A PROPOS
    ============================================================ -->

    <record id="page_a_propos_view" model="ir.ui.view">
        <field name="name">monetique.page.a.propos</field>
        <field name="type">qweb</field>
        <field name="key">monetique_theme.page_a_propos</field>

        <field name="arch" type="xml">
            <t t-name="monetique_theme.page_a_propos">

                <t t-call="website.layout">

                    <div class="mq-page-hero">

                        <div class="mq-container">

                            <div class="mq-breadcrumb">
                                <a href="/">Accueil</a> &gt; À propos
                            </div>

                            <h1 class="mq-page-title">
                                À propos de Monétiques
                            </h1>

                            <p class="mq-page-subtitle">
                                Depuis plus de 15 ans, Monétiques accompagne les professionnels
                            </p>

                        </div>

                    </div>

                    <section class="mq-about-body">

                        <div class="mq-container">

                            <div class="mq-about-grid">

                                <div class="mq-about-text" id="mission">

                                    <h2>Notre mission</h2>

                                    <p>
                                        Simplifier les paiements pour permettre aux commerçants
                                        de se concentrer sur ce qui compte vraiment : leur activité.
                                    </p>

                                    <p>
                                        Monétiques est un acteur français spécialisé dans
                                        les solutions de paiement pour les professionnels.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </section>

                </t>

            </t>
        </field>
    </record>



    <!-- ============================================================
         PAGE CONTACT
    ============================================================ -->

    <record id="page_contact_view" model="ir.ui.view">
        <field name="name">monetique.page.contact</field>
        <field name="type">qweb</field>
        <field name="key">monetique_theme.page_contact</field>

        <field name="arch" type="xml">
            <t t-name="monetique_theme.page_contact">

                <t t-call="website.layout">

                    <div class="mq-page-hero">

                        <div class="mq-container">

                            <div class="mq-breadcrumb">
                                <a href="/">Accueil</a> &gt; Contact
                            </div>

                            <h1 class="mq-page-title">
                                Contactez-nous
                            </h1>

                            <p class="mq-page-subtitle">
                                Notre équipe vous répond rapidement
                            </p>

                        </div>

                    </div>

                    <section class="mq-contact-body">

                        <div class="mq-container">

                            <div class="mq-contact-grid">

                                <div class="mq-form-card">

                                    <h2>
                                        Envoyez-nous un message
                                    </h2>

                                    <form method="POST" action="/contact/send">

                                        <input
                                            type="hidden"
                                            name="csrf_token"
                                            t-att-value="request.csrf_token()"
                                        />

                                        <div class="mq-form-group">

                                            <label>Nom</label>

                                            <input
                                                type="text"
                                                name="name"
                                                placeholder="Votre nom complet"
                                            />

                                        </div>

                                        <div class="mq-form-group">

                                            <label>Email</label>

                                            <input
                                                type="email"
                                                name="email"
                                                placeholder="votre@email.fr"
                                            />

                                        </div>

                                        <div class="mq-form-group">

                                            <label>Message</label>

                                            <textarea
                                                name="message"
                                                rows="6"
                                                placeholder="Décrivez votre besoin…"
                                            ></textarea>

                                        </div>

                                        <button
                                            type="submit"
                                            class="mq-btn-primary"
                                        >
                                            <i class="fa fa-paper-plane"></i>
                                            Envoyer
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </section>

                </t>

            </t>
        </field>
    </record>



    <!-- ============================================================
         PAGE CONTACT SUCCESS
    ============================================================ -->

    <record id="page_contact_success_view" model="ir.ui.view">
        <field name="name">monetique.page.contact.success</field>
        <field name="type">qweb</field>
        <field name="key">monetique_theme.page_contact_success</field>

        <field name="arch" type="xml">
            <t t-name="monetique_theme.page_contact_success">

                <t t-call="website.layout">

                    <section class="mq-success-section">

                        <div class="mq-container">

                            <div class="mq-success-icon">
                                <i class="fa fa-check"></i>
                            </div>

                            <h1>
                                Message envoyé !
                            </h1>

                            <p>
                                Merci pour votre message.
                                Notre équipe vous répond sous 24h ouvrées.
                            </p>

                            <div
                                style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap"
                            >

                                <a href="/" class="mq-btn-primary">
                                    Retour à l'accueil
                                </a>

                                <a href="/shop" class="mq-btn-secondary">
                                    Voir la boutique
                                </a>

                            </div>

                        </div>

                    </section>

                </t>

            </t>
        </field>
    </record>

</odoo>