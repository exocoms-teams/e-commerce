<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="home_sections" name="Home Sections">
        <section class="exo-home-categories">
            <div class="exo-home-container">

                <div class="exo-section-title">
                    <h2>Nos univers</h2>
                    <p>Découvrez nos catégories de solutions monétiques professionnelles</p>
                </div>

                <div class="exo-categories-grid">

                    <a href="/shop/category/terminaux-tpe" class="exo-category-card large">
                        <img src="/monetique_theme/static/src/img/terminal.jpg" alt="Terminaux TPE" />
                        <div class="exo-category-overlay"></div>
                        <div class="exo-category-content">
                            <h3>Terminaux TPE</h3>
                            <p>Terminaux de paiement fixes, portables et mobiles.</p>
                        </div>
                    </a>

                    <a href="/shop/category/bornes-libre-service" class="exo-category-card">
                        <img src="/monetique_theme/static/src/img/hero_tpe.png" alt="Bornes libre-service" />
                        <div class="exo-category-overlay"></div>
                        <div class="exo-category-content">
                            <h3>Bornes Libre-Service</h3>
                            <p>Kiosques et bornes de paiement autonomes.</p>
                        </div>
                    </a>

                    <a href="/shop/category/paiement-en-ligne" class="exo-category-card">
                        <img src="/monetique_theme/static/src/img/bg_finance.png" alt="Paiement en ligne" />
                        <div class="exo-category-overlay"></div>
                        <div class="exo-category-content">
                            <h3>Paiement en Ligne</h3>
                            <p>Solutions e-commerce et passerelles de paiement.</p>
                        </div>
                    </a>

                    <a href="/shop/category/accessoires" class="exo-category-card wide">
                        <img src="/monetique_theme/static/src/img/cb.jpg" alt="Accessoires monétique" />
                        <div class="exo-category-overlay"></div>
                        <div class="exo-category-content">
                            <h3>Accessoires &amp; Services</h3>
                            <p>Consommables, maintenance et accompagnement sur mesure.</p>
                        </div>
                    </a>

                </div>

                <div class="exo-categories-btn">
                    <a href="/shop" class="exo-all-categories-btn">
                        <i class="fa fa-th-large"></i>
                        Voir toutes les catégories
                    </a>
                </div>

            </div>
        </section>
    </template>

</odoo>
