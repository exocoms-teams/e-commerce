<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Catégorie racine de la boutique monétique. -->
        <record id="product_public_category_monetique" model="product.public.category">
            <field name="name">Monétique</field>
            <field name="sequence">10</field>
        </record>

        <record id="product_public_category_payment_terminals" model="product.public.category">
            <field name="name">Terminaux de paiement (TPE)</field>
            <field name="parent_id" ref="product_public_category_monetique"/>
            <field name="sequence">10</field>
        </record>
        <record id="product_public_category_fixed_tpe" model="product.public.category">
            <field name="name">TPE fixes</field>
            <field name="parent_id" ref="product_public_category_payment_terminals"/>
            <field name="sequence">10</field>
        </record>
        <record id="product_public_category_mobile_tpe" model="product.public.category">
            <field name="name">TPE mobiles</field>
            <field name="parent_id" ref="product_public_category_payment_terminals"/>
            <field name="sequence">20</field>
        </record>
        <record id="product_public_category_android_tpe" model="product.public.category">
            <field name="name">TPE Android</field>
            <field name="parent_id" ref="product_public_category_payment_terminals"/>
            <field name="sequence">30</field>
        </record>

        <record id="product_public_category_pos_solutions" model="product.public.category">
            <field name="name">Solutions de caisse / POS</field>
            <field name="parent_id" ref="product_public_category_monetique"/>
            <field name="sequence">20</field>
        </record>
        <record id="product_public_category_online_payment_gateways" model="product.public.category">
            <field name="name">Passerelles et paiement en ligne</field>
            <field name="parent_id" ref="product_public_category_monetique"/>
            <field name="sequence">30</field>
        </record>
        <record id="product_public_category_peripherals_accessories" model="product.public.category">
            <field name="name">Périphériques et accessoires</field>
            <field name="parent_id" ref="product_public_category_monetique"/>
            <field name="sequence">40</field>
        </record>
        <record id="product_public_category_software_services" model="product.public.category">
            <field name="name">Logiciels et services</field>
            <field name="parent_id" ref="product_public_category_monetique"/>
            <field name="sequence">50</field>
        </record>
    </data>
</odoo>
