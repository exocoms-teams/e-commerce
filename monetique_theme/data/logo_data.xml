<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fixe le logo officiel Monetiques.fr sur le site, en dur via le module.
         Utilise le meme champ que celui modifie par l'editeur de site (website.logo),
         donc le rendu du header n'a pas besoin d'etre touche. -->
    <record id="website.default_website" model="website">
        <field name="logo" type="base64" file="monetique_theme/static/src/img/logo_monetiques.png"/>
    </record>
</odoo>
