<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Demo catalogue entries.  They are deliberately noupdate so that a
         module upgrade never overwrites changes made by a shop administrator. -->
    <data noupdate="1">
        <record id="product_template_pax_a920_demo" model="product.template">
            <field name="name">Terminal TPE PAX A920</field>
            <field name="default_code">DEMO-PAX-A920</field>
            <field name="list_price">349.00</field>
            <field name="sale_ok">True</field>
            <field name="website_published">True</field>
            <field name="description_sale">Terminal Android mobile 4G/Wi-Fi, écran tactile 5 pouces et imprimante thermique intégrée.</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('monetique_theme.product_public_category_mobile_tpe')])]"/>
            <field name="image_1920" type="base64" file="monetique_theme/static/src/img/demo-pax-a920.ppm"/>
        </record>

        <record id="product_template_ingenico_desk_5000_demo" model="product.template">
            <field name="name">TPE fixe Ingenico Desk 5000</field>
            <field name="default_code">DEMO-DESK-5000</field>
            <field name="list_price">269.00</field>
            <field name="sale_ok">True</field>
            <field name="website_published">True</field>
            <field name="description_sale">Terminal de comptoir fiable avec lecteur sans contact, puce et piste magnétique.</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('monetique_theme.product_public_category_fixed_tpe')])]"/>
            <field name="image_1920" type="base64" file="monetique_theme/static/src/img/demo-desk-5000.ppm"/>
        </record>

        <record id="product_template_pos_15_demo" model="product.template">
            <field name="name">Caisse enregistreuse POS 15 pouces</field>
            <field name="default_code">DEMO-POS-15</field>
            <field name="list_price">899.00</field>
            <field name="sale_ok">True</field>
            <field name="website_published">True</field>
            <field name="description_sale">Pack caisse tactile 15 pouces pour commerces, restauration et points de vente.</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('monetique_theme.product_public_category_pos_solutions')])]"/>
            <field name="image_1920" type="base64" file="monetique_theme/static/src/img/demo-pos-15.ppm"/>
        </record>

        <record id="product_template_ticket_printer_demo" model="product.template">
            <field name="name">Imprimante tickets thermique 80 mm</field>
            <field name="default_code">DEMO-PRINTER-80</field>
            <field name="list_price">129.00</field>
            <field name="sale_ok">True</field>
            <field name="website_published">True</field>
            <field name="description_sale">Imprimante de reçus rapide, compatible avec les systèmes de caisse POS.</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('monetique_theme.product_public_category_peripherals_accessories')])]"/>
            <field name="image_1920" type="base64" file="monetique_theme/static/src/img/demo-ticket-printer.ppm"/>
        </record>
    </data>
</odoo>
