<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Séquence Missions -->
        <record id="seq_sinistre_mission" model="ir.sequence">
            <field name="name">Séquence Mission Sinistre</field>
            <field name="code">sinistre.mission</field>
            <field name="prefix">MSN-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Séquence Devis -->
        <record id="seq_sinistre_devis" model="ir.sequence">
            <field name="name">Séquence Devis Sinistre</field>
            <field name="code">sinistre.devis</field>
            <field name="prefix">DEV-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Séquence Commission -->
        <record id="seq_sinistre_commission" model="ir.sequence">
            <field name="name">Séquence Commission Sinistre</field>
            <field name="code">sinistre.commission</field>
            <field name="prefix">COM-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
