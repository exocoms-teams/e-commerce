<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_debranding_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.debranding.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Debranding" class="oe_form_configuration">
                <header>
                    <button string="Enregistrer" type="object" name="execute"
                            class="btn-primary" data-hotkey="s"/>
                    <button string="Annuler" type="object" name="cancel"
                            class="btn-secondary" data-hotkey="j"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Les patchs de templates sont ré-appliqués à chaque enregistrement.
                        Après l'installation de nouveaux modules, utiliser le bouton
                        <b>Ré-appliquer le debranding</b>.
                    </div>

                    <group string="Société éditée">
                        <field name="company_id" readonly="1"
                               options="{'no_open': True}"/>
                        <div class="text-muted" colspan="2">
                            Changer de société via le sélecteur en haut à droite pour
                            éditer une autre marque. Champs vides = valeurs par défaut
                            de la base.
                        </div>
                    </group>

                    <group>
                        <group string="Identité">
                            <field name="debranding_name"
                                   placeholder="Valeur par défaut de la base"/>
                            <field name="debranding_url" widget="url"
                                   placeholder="Valeur par défaut de la base"/>
                            <field name="debranding_logo" widget="image"
                                   options="{'size': [128, 64]}"/>
                            <field name="debranding_favicon" widget="image"
                                   options="{'size': [64, 64]}"/>
                        </group>
                        <group string="Menu utilisateur">
                            <field name="debranding_documentation_url" widget="url"/>
                            <field name="debranding_support_url" widget="url"/>
                            <field name="debranding_logo_url"
                                   placeholder="/web/image/res.company/&lt;id&gt;/logo"/>
                            <field name="debranding_theme_color" widget="color"/>
                        </group>
                    </group>

                    <group string="Valeurs par défaut de la base">
                        <field name="debranding_multi_company"/>
                        <field name="debranding_default_name"/>
                        <field name="debranding_default_url" widget="url"/>
                        <field name="debranding_default_logo_url"/>
                        <field name="debranding_web_app_name"/>
                    </group>

                    <group string="Avancé">
                        <field name="debranding_hide_version"/>
                        <field name="debranding_excluded_modules"/>
                    </group>

                    <div class="mt-3">
                        <button string="Ré-appliquer le debranding" type="object"
                                name="action_debranding_rescan" class="btn-secondary"
                                icon="fa-refresh"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_debranding_config_settings" model="ir.actions.act_window">
        <field name="name">Debranding</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_debranding_config_settings"/>
        <field name="context">{'module': 'exocoms_debranding'}</field>
    </record>

    <menuitem id="menu_debranding_config"
              name="Debranding"
              parent="base.menu_custom"
              action="action_debranding_config_settings"
              groups="base.group_system"
              sequence="90"/>

</odoo>
