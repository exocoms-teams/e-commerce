<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vues autonomes : aucune surcharge de vue standard, donc aucun risque
         de rupture lors d'une montée de version d'Odoo. -->

    <record id="view_company_list_branding" model="ir.ui.view">
        <field name="name">res.company.list.branding</field>
        <field name="model">res.company</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Marque blanche" create="false" delete="false">
                <field name="name"/>
                <field name="debrand_mode"/>
                <field name="debrand_brand_name"/>
                <field name="debrand_brand_url" optional="show"/>
                <field name="debrand_backend" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_company_form_branding" model="ir.ui.view">
        <field name="name">res.company.form.branding</field>
        <field name="model">res.company</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Marque blanche" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Société"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Comportement">
                            <field name="debrand_mode" widget="radio"/>
                            <field name="debrand_backend"/>
                        </group>
                        <group string="Aperçu" invisible="debrand_mode != 'replace'">
                            <div colspan="2" class="text-muted">
                                Le bloc « Powered by Odoo » du portail, des e-mails
                                et des rapports PDF est remplacé par votre accroche,
                                votre logo et votre lien — en conservant la position
                                et le style d'origine.
                            </div>
                        </group>
                    </group>
                    <group string="Votre marque" invisible="debrand_mode != 'replace'">
                        <group>
                            <field name="debrand_promo_text"
                                   placeholder="Propulsé par"/>
                            <field name="debrand_brand_name"
                                   placeholder="EXOCOMS Group"/>
                            <field name="debrand_brand_url" widget="url"
                                   placeholder="https://exocoms.fr"/>
                        </group>
                        <group>
                            <field name="debrand_show_logo"/>
                            <field name="debrand_logo" widget="image"
                                   class="oe_avatar"
                                   invisible="not debrand_show_logo"/>
                            <field name="debrand_logo_height"
                                   invisible="not debrand_show_logo"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_company_branding" model="ir.actions.act_window">
        <field name="name">Marque blanche</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configurez votre marque</p>
            <p>Choisissez la société, puis définissez le texte, le logo et le lien
               qui remplaceront les mentions Odoo.</p>
        </field>
    </record>

    <record id="action_company_branding_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_company_list_branding"/>
        <field name="act_window_id" ref="action_company_branding"/>
    </record>

    <record id="action_company_branding_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_company_form_branding"/>
        <field name="act_window_id" ref="action_company_branding"/>
    </record>

    <menuitem id="menu_company_branding"
              name="Marque blanche"
              parent="base.menu_custom"
              action="action_company_branding"
              groups="base.group_system"
              sequence="90"/>

</odoo>
