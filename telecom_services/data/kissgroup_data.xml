<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Base URL de l'API KISSGROUP (la clé API reste un secret à saisir
             dans les paramètres système : telecom_services.kissgroup_api_key) -->
        <record id="kissgroup_base_url_param" model="ir.config_parameter">
            <field name="key">telecom_services.kissgroup_base_url</field>
            <field name="value">https://api.kissgroup.io</field>
        </record>

        <!-- URL du portail de commande KISSGROUP vers lequel pointe le bouton
             "Commander" sur /telecom. À remplacer par la vraie URL du portail. -->
        <record id="kissgroup_order_url_param" model="ir.config_parameter">
            <field name="key">telecom_services.kissgroup_order_url</field>
            <field name="value">https://my.kissgroup.io</field>
        </record>

    </data>
</odoo>
