<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Base URL de l'API (la clé API est à saisir manuellement dans les
             paramètres système, clé: telecom_services.kissgroup_api_key) -->
        <record id="kissgroup_base_url_param" model="ir.config_parameter">
            <field name="key">telecom_services.kissgroup_base_url</field>
            <field name="value">https://api.kissgroup.io</field>
        </record>

        <!-- Synchronisation quotidienne des forfaits mobiles KISSGROUP -->
        <record id="cron_sync_kissgroup_mobile" model="ir.cron">
            <field name="name">Télécom : Synchroniser les forfaits mobiles KISSGROUP</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_kissgroup_mobile_plans()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.datetime.now() + datetime.timedelta(minutes=10)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
