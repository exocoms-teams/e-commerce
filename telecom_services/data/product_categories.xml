<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        noupdate="1" : le métier peut modifier labels/séquences sans écrasement au -u.
        Pour forcer un rechargement : supprimer le record en base puis relancer -i.
    -->
    <data noupdate="1">

        <record id="cat_telecom_root" model="product.public.category">
            <field name="name">Télécom</field>
            <field name="sequence">10</field>
        </record>

        <record id="cat_voix" model="product.public.category">
            <field name="name">Voix</field>
            <field name="parent_id" ref="cat_telecom_root"/>
            <field name="sequence">1</field>
        </record>

        <record id="cat_intelligence" model="product.public.category">
            <field name="name">Intelligence</field>
            <field name="parent_id" ref="cat_telecom_root"/>
            <field name="sequence">2</field>
        </record>

        <record id="cat_teams" model="product.public.category">
            <field name="name">Teams</field>
            <field name="parent_id" ref="cat_telecom_root"/>
            <field name="sequence">3</field>
        </record>

        <record id="cat_agents_ia" model="product.public.category">
            <field name="name">Agents IA</field>
            <field name="parent_id" ref="cat_telecom_root"/>
            <field name="sequence">4</field>
        </record>

        <record id="cat_connectivite" model="product.public.category">
            <field name="name">Connectivité &amp; Réseaux</field>
            <field name="parent_id" ref="cat_telecom_root"/>
            <field name="sequence">5</field>
        </record>

        <record id="cat_cloud" model="product.public.category">
            <field name="name">Cloud &amp; Hébergement</field>
            <field name="parent_id" ref="cat_telecom_root"/>
            <field name="sequence">6</field>
        </record>

        <record id="cat_cybersecurite" model="product.public.category">
            <field name="name">Cybersécurité</field>
            <field name="parent_id" ref="cat_telecom_root"/>
            <field name="sequence">7</field>
        </record>

    </data>
</odoo>
