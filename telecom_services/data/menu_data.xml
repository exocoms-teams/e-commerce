<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- website_id / parent_id / sequence sont positionnés par le post_init_hook -->
        <record id="menu_telecom" model="website.menu">
            <field name="name">Télécom</field>
            <field name="url">#</field>
            <field name="is_mega_menu" eval="True"/>
            <field name="mega_menu_classes">o_mega_menu_telecom</field>
            <field name="mega_menu_content"><![CDATA[
<div class="container py-3">
  <div class="row align-items-center justify-content-center g-4 text-center">
    <div class="col-lg-8">
      <p class="fw-bold mb-1">Solutions Télécom pour les professionnels</p>
      <p class="mb-0">Voix, mobilité, intelligence conversationnelle,
      connectivité et cybersécurité.</p>
    </div>
    <div class="col-lg-auto">
      <a href="/telecom" class="btn btn-primary">Voir le catalogue</a>
    </div>
  </div>
</div>
]]></field>
        </record>
    </data>
</odoo>
