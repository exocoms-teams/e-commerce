<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        PAS de noupdate : versioned.
        website_id, parent_id et sequence sont assignés par le post_init/migrate_hook.

        Compatibilité Odoo 19 :
        on évite ici les champs de mega-menu non garantis sur website.menu
        pour ne pas bloquer l'installation du module.
    -->
    <data>

        <record id="menu_telecom" model="website.menu">
            <field name="name">Télécom</field>
            <field name="url">/telecom</field>
        </record>

    </data>
</odoo>
