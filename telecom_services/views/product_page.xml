<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Affiche la description du service entre le prix et le bouton "Ajouter au panier" -->
    <template id="product_telecom_description"
              inherit_id="website_sale.product"
              name="Télécom — Description sous le prix">
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_price')]" position="after">
            <p t-if="product.description_sale"
               class="text-muted o_wsale_product_details_content_section mb-4"
               style="white-space: pre-line;"
               t-out="product.description_sale"/>
        </xpath>
    </template>

</odoo>
