<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="telecom_page" name="Télécom — Catalogue">
        <t t-call="website.layout">
            <t t-set="title">Télécom — Services professionnels</t>

            <div class="oe_structure" id="oe_structure_telecom_top"/>

            <section class="pt-5 pb-4 text-center bg-light">
                <div class="container">
                    <h1 class="display-5 fw-bold mb-2">
                        <t t-esc="page_title"/>
                    </h1>
                    <p class="lead text-muted">
                        <t t-esc="page_subtitle"/>
                    </p>
                </div>
            </section>

            <div class="container py-5">
                <t t-foreach="universes" t-as="universe">
                    <section t-att-id="'cat-' + universe['id']" class="mb-5">
                        <h2 class="h4 fw-bold mb-4 pb-2 border-bottom">
                            <t t-esc="universe['category']"/>
                        </h2>
                        <div class="row g-4">
                            <t t-foreach="universe['products']" t-as="product">
                                <t t-set="product_url" t-value="product.get('url', '#')"/>
                                <div class="col-6 col-md-4 col-lg-3">
                                    <a t-att-href="product_url"
                                       class="text-decoration-none text-reset d-block h-100">
                                        <div class="card h-100 shadow-sm border-0 telecom-card">
                                            <div class="bg-light d-flex align-items-center justify-content-center"
                                                 style="height: 180px;">
                                                <i class="fa fa-cube fa-3x text-muted"/>
                                            </div>
                                            <div class="card-body d-flex flex-column">
                                                <h3 class="card-title h6 fw-semibold mb-2">
                                                    <t t-esc="product['name']"/>
                                                </h3>
                                                <p class="card-text text-muted small flex-grow-1"
                                                   t-if="product.get('description')">
                                                    <t t-esc="product['description']"/>
                                                </p>
                                                <p class="fw-bold mb-0 mt-2"
                                                   t-if="product.get('price')">
                                                    <t t-esc="'%.2f €/mois HT' % product['price']"/>
                                                </p>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </t>
                        </div>
                    </section>
                </t>

                <t t-if="not universes">
                    <div class="alert alert-info text-center my-5">
                        Aucun service disponible pour le moment.
                    </div>
                </t>
            </div>

            <div class="oe_structure" id="oe_structure_telecom_bottom"/>
        </t>
    </template>
</odoo>
