<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="telecom_page" name="Télécom — Catalogue">
        <t t-call="website.layout">
            <t t-set="title">Télécom — Services professionnels</t>

            <div class="oe_structure" id="oe_structure_telecom_top"/>

            <section class="pt-5 pb-4 text-center bg-light">
                <div class="container">
                    <h1 class="display-5 fw-bold mb-2" t-esc="_('Solutions Télécom')"/>
                    <p class="lead text-muted" t-esc="_('Voix, mobilité, intelligence conversationnelle, connectivité et cybersécurité pour les professionnels.')"/>
                </div>
            </section>

            <div class="container py-5">
                <t t-foreach="universes" t-as="universe">
                    <section class="mb-5">
                        <h2 class="h4 fw-bold mb-4 pb-2 border-bottom">
                            <t t-esc="universe['category'].name"/>
                        </h2>
                        <div class="row g-4">
                            <t t-foreach="universe['products']" t-as="product">
                                <div class="col-6 col-md-4 col-lg-3">
                                    <div class="card h-100 shadow-sm border-0">
                                        <a t-att-href="product.website_url" class="d-block overflow-hidden">
                                            <div class="bg-light d-flex align-items-center justify-content-center"
                                                 style="height: 180px;">
                                                <img t-att-src="'/web/image/product.template/%s/image_512' % product.id"
                                                     t-att-alt="product.name"
                                                     loading="lazy"
                                                     class="img-fluid p-3"
                                                     style="max-height: 160px; object-fit: contain;"/>
                                            </div>
                                        </a>
                                        <div class="card-body d-flex flex-column">
                                            <h3 class="card-title h6 fw-semibold mb-2">
                                                <a t-att-href="product.website_url"
                                                   class="text-dark text-decoration-none">
                                                    <t t-esc="product.name"/>
                                                </a>
                                            </h3>
                                            <p class="card-text text-muted small flex-grow-1"
                                               t-if="product.description_sale">
                                                <t t-esc="product.description_sale"/>
                                            </p>
                                        </div>
                                        <div class="card-footer bg-transparent border-0 pb-3 px-3">
                                            <a t-att-href="product.website_url"
                                               class="btn btn-primary btn-sm w-100"
                                               t-esc="_('Voir le service')"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </section>
                </t>

                <t t-if="not universes">
                    <div class="alert alert-info text-center my-5"
                         t-esc="_('Aucun service disponible pour le moment.')"/>
                </t>
            </div>

            <div class="oe_structure" id="oe_structure_telecom_bottom"/>
        </t>
    </template>
</odoo>
