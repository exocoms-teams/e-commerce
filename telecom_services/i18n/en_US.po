# ---------------------------------------------------------------------------
# Product descriptions — product.template,description_sale
# ---------------------------------------------------------------------------

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_dstny_ucaas
msgid "Plateforme UCaaS nouvelle génération. Convergence exclusive fixe-mobile-Teams-CRM. Sans engagement, déploiement en 24h."
msgstr "Next-gen UCaaS platform. Native fixed-mobile-Teams-CRM convergence. No commitment, deployed in 24h."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_telephonie_voip
msgid "Communiquez en illimité via Internet. Flexibilité, nouvelles fonctionnalités et coûts réduits par rapport au RTC traditionnel."
msgstr "Communicate without limits via the Internet. Flexibility, new features and lower costs compared to traditional PSTN."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_mobile
msgid "Forfaits mobiles pro avec gestion centralisée MDM. Smartphones reconditionnés disponibles via Dstny x Back Market Pro."
msgstr "Pro mobile plans with centralized MDM management. Refurbished smartphones available via Dstny x Back Market Pro."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_convergence_fixe_mobile
msgid "Numéro fixe et mobile sur une seule carte SIM. Profitez des fonctionnalités d'entreprise en mobilité via le réseau GSM."
msgstr "Fixed and mobile number on a single SIM card. Enjoy enterprise telephony features on the go via the GSM network."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_dstny_call_intelligence
msgid "Analysez et valorisez vos échanges téléphoniques. Tableaux de bord en temps réel, KPIs et rapports détaillés sur vos communications."
msgstr "Analyze and leverage your phone conversations. Real-time dashboards, KPIs and detailed reports on your communications."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_dstny_crm_intelligence
msgid "Remontée automatique des fiches CRM à chaque appel. Identifiez vos interlocuteurs avant même de décrocher et enrichissez vos données."
msgstr "Automatic CRM contact pop-up on every call. Identify your contacts before picking up and keep your data up to date."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_dstny_call2teams
msgid "Passez tous vos appels, même externes, directement depuis l'onglet Appels de Microsoft Teams avec votre numéro d'entreprise."
msgstr "Make all your calls, even external ones, directly from Microsoft Teams' Calls tab with your company number."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_dstny_digital_assistants
msgid "Agent vocal IA disponible 24h/24, 7j/7. Répond, oriente les appels et planifie des rendez-vous automatiquement. Multilingue, intégré à votre CRM."
msgstr "AI voice agent available 24/7. Answers, routes calls and schedules appointments automatically. Multilingual, integrated with your CRM."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_acces_internet
msgid "Offres Très Haut Débit FTTH/FTTE/FTTO multi-opérateurs. Débit jusqu'à 10 Gbps, GTR incluse et option Backup 4G."
msgstr "Multi-operator Very High-Speed FTTH/FTTE/FTTO offers. Up to 10 Gbps, SLA included and optional 4G Backup."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_reseau_prive_entreprise
msgid "Architecture MPLS/VPN sécurisée et maîtrisée de bout en bout. SLA, supervision 24/7 et interlocuteur unique multi-opérateurs."
msgstr "Secure MPLS/VPN architecture, controlled end-to-end. SLA, 24/7 monitoring and a single point of contact across multiple operators."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_sd_wan
msgid "Optimisez vos liens WAN et performances applicatives. Déploiement Zero-Touch, sécurité intégrée nouvelle génération."
msgstr "Optimize your WAN links and application performance. Zero-Touch deployment, next-generation integrated security."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_infrastructure_cloud_iaas
msgid "Cloud privé, public ou hybride certifié ISO 27001. Haute disponibilité garantie, datacenters français, accompagnement expert de bout en bout."
msgstr "Private, public or hybrid cloud, ISO 27001 certified. Guaranteed high availability, French datacenters, expert support end-to-end."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_hebergement
msgid "Hébergement réglementaire pour protéger vos données sensibles et répondre aux exigences légales spécifiques de votre secteur."
msgstr "Regulatory hosting to protect your sensitive data and meet the specific legal requirements of your industry."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_sauvegarde_donnees
msgid "Sauvegarde certifiée ISO 27001 & HDS. Stockage chiffré en datacenter français, supervision 24/7 et extension cloud évolutive."
msgstr "ISO 27001 & HDS certified backup. Encrypted storage in French datacenters, 24/7 monitoring and scalable cloud extension."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_plan_reprise_activite
msgid "Redémarrez votre SI après sinistre grâce au PRA cloud. Conforme ISO 27001 & HDS, mis en place par des experts certifiés."
msgstr "Restart your IT systems after a disaster with a cloud BCP. ISO 27001 & HDS compliant, implemented by certified experts."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_detection_anticipation
msgid "Détection proactive des menaces cyber, surveillance 24/7 Cloud & OnPrem. Solution SaaS Made in France labellisée France Cybersecurity."
msgstr "Proactive cyber threat detection, 24/7 Cloud & OnPrem monitoring. SaaS solution Made in France, France Cybersecurity certified."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_gestion_identites
msgid "Contrôlez les accès à privilège, tracez chaque action admin et dynamisez vos authentifications avec le MFA. Solution SaaS Made in France."
msgstr "Control privileged access, trace every admin action and strengthen your authentications with MFA. SaaS solution Made in France."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_protection_messagerie
msgid "Bloquez les emails malveillants avant réception. Détection IA, remédiation en temps réel, déploiement en moins de 24h sans impact utilisateur."
msgstr "Block malicious emails before they reach your teams. AI detection, real-time remediation, deployed in under 24h with no user impact."

#. module: telecom_services
#: model:product.template,description_sale:telecom_services.product_diagnostic_securite
msgid "Évaluez votre niveau de protection, identifiez les priorités et obtenez un plan d'action clair. Réalisé par des experts, sans intervention technique."
msgstr "Assess your security level, identify priorities and get a clear action plan. Conducted by experts, no technical intervention required."
