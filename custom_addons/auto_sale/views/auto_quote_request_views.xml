<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auto_quote_request_tree" model="ir.ui.view">
        <field name="name">auto.quote.request.tree</field>
        <field name="model">auto.quote.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="assigned_user_id"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_auto_quote_request_form" model="ir.ui.view">
        <field name="name">auto.quote.request.form</field>
        <field name="model">auto.quote.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_qualified" type="object" string="Qualifier" invisible="state != 'new'"/>
                    <button name="action_set_quoted" type="object" string="Marquer devis envoyé" invisible="state not in ('new','qualified')"/>
                    <button name="action_set_won" type="object" string="Marquer gagné" class="btn-primary" invisible="state == 'won'"/>
                    <button name="action_set_lost" type="object" string="Marquer perdu" invisible="state == 'lost'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,qualified,quoted,won,lost"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_lead" type="object" class="oe_stat_button" icon="fa-briefcase">
                            <span>Créer une opportunité CRM</span>
                        </button>
                        <button name="action_create_sale_order" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <span>Créer un bon de commande</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="vehicle_id"/>
                            <field name="assigned_user_id"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="preferred_contact"/>
                            <field name="budget"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                    </group>
                    <group>
                        <field name="lead_id" readonly="1"/>
                        <field name="sale_order_id" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_auto_quote_request_search" model="ir.ui.view">
        <field name="name">auto.quote.request.search</field>
        <field name="model">auto.quote.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="assigned_user_id"/>
                <filter name="new" string="Nouvelle" domain="[('state', '=', 'new')]"/>
                <filter name="qualified" string="Qualifiée" domain="[('state', '=', 'qualified')]"/>
                <filter name="quoted" string="Devis envoyé" domain="[('state', '=', 'quoted')]"/>
                <group>
                    <filter name="group_by_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="group_by_advisor" string="Conseiller" context="{'group_by': 'assigned_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_auto_quote_request" model="ir.actions.act_window">
        <field name="name">Demandes de devis</field>
        <field name="res_model">auto.quote.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_auto_quote_request" name="Demandes de devis" parent="auto_base.menu_auto_catalog" action="action_auto_quote_request" sequence="30"/>
</odoo>
