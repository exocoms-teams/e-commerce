<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_quote_request_received" model="mail.template">
        <field name="name">Confirmation de demande de devis véhicule</field>
        <field name="model_id" ref="model_auto_quote_request"/>
        <field name="subject">Nous avons reçu votre demande de devis: ${object.vehicle_id.display_name}</field>
        <field name="email_from">${(user.email_formatted or 'noreply@example.com')|safe}</field>
        <field name="email_to">${object.email|safe}</field>
        <field name="body_html" type="html">
            <div>
                <p>Bonjour ${object.partner_id.name},</p>
                <p>Merci pour votre intérêt pour <strong>${object.vehicle_id.display_name}</strong>.</p>
                <p>La référence de votre demande de devis est <strong>${object.name}</strong>. Notre équipe commerciale vous contactera rapidement.</p>
                <p>Cordialement,<br/>L'équipe commerciale EXOCOMS Voitures</p>
            </div>
        </field>
    </record>
</odoo>
