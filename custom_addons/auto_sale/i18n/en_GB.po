#. module: auto_sale
#, python-brace-format
msgid ""
"<div>\n"
"                <p>Bonjour ${object.partner_id.name},</p>\n"
"                <p>Merci pour votre intérêt pour <strong>${object.vehicle_id.display_name}</strong>.</p>\n"
"                <p>La référence de votre demande de devis est <strong>${object.name}</strong>. Notre équipe "
"commerciale vous contactera rapidement.</p>\n"
"                <p>Cordialement,<br/>L'équipe commerciale EXOCOMS Voitures</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                <p>Hello ${object.partner_id.name},</p>\n"
"                <p>Thank you for your interest in <strong>${object.vehicle_id.display_name}</strong>.</p>\n"
"                <p>Your quote request reference is <strong>${object.name}</strong>. Our sales team will contact you "
"shortly.</p>\n"
"                <p>Kind regards,<br/>The EXOCOMS Vehicles sales team</p>\n"
"            </div>\n"
"        "

