        </t>
    </template>


<template id="financing_thanks_page" name="Confirmation de financement vÃ©hicule">
        <t t-call="website.layout">
            <div class="oe_structure oe_empty auto-editor-zone auto-editor-zone-top" id="auto_financing_thanks_page_editor_top"/>
            <section class="py-5 auto-form-shell">
