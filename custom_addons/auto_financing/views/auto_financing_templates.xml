<template id="my_financing_requests_page" name="Mes demandes de financement">
        <t t-call="website.layout">
            <div class="oe_structure oe_empty auto-editor-zone auto-editor-zone-top" id="auto_my_financing_requests_page_editor_top"/>
            <section class="py-5 auto-form-shell">
                <div class="container">
                    <h1 class="h3 mb-4">Mes demandes de financement</h1>
                    <div class="table-responsive auto-table-panel">
                        <table class="table table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th>VÃ©hicule</th>
                                    <th>Montant</th>
                                    <th>DurÃ©e</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="records">
                                    <t t-foreach="records" t-as="rec">
                                        <tr>
                                            <td t-out="rec.vehicle_id.display_name"/>
                                            <td>
                                                <span t-field="rec.requested_amount" t-options='{"widget": "monetary", "display_currency": rec.currency_id}'/>
                                            </td>
                                            <td><t t-out="rec.duration_months"/> mois</td>
                                            <td t-out="rec.state_label"/>
                                        </tr>
                                    </t>
                                </t>
                                <t t-if="not records">
                                    <tr>
                                        <td colspan="4">Aucune demande de financement pour le moment.</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
            <div class="oe_structure oe_empty auto-editor-zone auto-editor-zone-bottom" id="auto_my_financing_requests_page_editor_bottom"/>
        </t>
    </template>
</odoo>
