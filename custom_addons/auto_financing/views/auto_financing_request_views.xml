<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auto_financing_request_tree" model="ir.ui.view">
        <field name="name">auto.financing.request.tree</field>
        <field name="model">auto.financing.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="requested_amount"/>
                <field name="duration_months"/>
                <field name="monthly_income"/>
                <field name="assigned_user_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_auto_financing_request_form" model="ir.ui.view">
        <field name="name">auto.financing.request.form</field>
        <field name="model">auto.financing.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_under_review" type="object" string="Under Review" invisible="state != 'new'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state == 'approved'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state == 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,under_review,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="vehicle_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="requested_amount"/>
                            <field name="duration_months"/>
                            <field name="monthly_income"/>
                            <field name="down_payment"/>
                            <field name="assigned_user_id"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_auto_financing_request" model="ir.actions.act_window">
        <field name="name">Financing Requests</field>
        <field name="res_model">auto.financing.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_auto_financing_request" name="Financing Requests" parent="auto_base.menu_auto_catalog" action="action_auto_financing_request" sequence="70"/>
</odoo>
