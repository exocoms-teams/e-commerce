<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="menu_auto_home" model="website.menu">
            <field name="name">Accueil Auto</field>
            <field name="url">/cars/home</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">45</field>
        </record>

        <record id="menu_auto_catalog" model="website.menu">
            <field name="name">Catalogue</field>
            <field name="url">/cars</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">46</field>
        </record>

        <record id="menu_auto_brands" model="website.menu">
            <field name="name">Marques</field>
            <field name="url">/brands</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">47</field>
        </record>

        <record id="menu_auto_favorites" model="website.menu">
            <field name="name">Favoris</field>
            <field name="url">/my/favorites</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">48</field>
        </record>
    </data>

    <template id="home_page" name="Automotive Home">
        <t t-call="website.layout">
            <section class="auto-home-hero position-relative overflow-hidden">
                <div id="autoHeroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="7000">
                    <div class="carousel-inner">
                        <t t-if="hero_vehicles">
                            <t t-foreach="hero_vehicles" t-as="hero_vehicle">
                                <div t-attf-class="carousel-item auto-hero-slide #{'active' if hero_vehicle_index == 0 else ''}">
                                    <div class="auto-hero-slide-media">
                                        <img t-if="hero_vehicle.main_image" t-att-src="image_data_uri(hero_vehicle.main_image)" t-att-alt="hero_vehicle.display_name" class="auto-hero-image"/>
                                        <div t-if="not hero_vehicle.main_image" class="auto-hero-slide-fallback">
                                            <span t-esc="hero_vehicle.display_name"/>
                                        </div>
                                        <div class="auto-hero-overlay"/>
                                    </div>
                                    <div class="container auto-hero-content">
                                        <div class="auto-hero-content-box">
                                            <div class="auto-hero-branding">
                                                <img src="/auto_website/static/src/img/exocoms-logo.png" alt="EXOCOMS Group" class="auto-hero-exocoms-logo"/>
                                                <span class="auto-hero-kicker">EXOCOMS Mobility</span>
                                            </div>
                                            <h1 class="auto-hero-title">Trouvez la voiture de vos reves.</h1>
                                            <p class="auto-hero-subtitle">
                                                <strong t-esc="hero_vehicle.display_name"/> a partir de
                                                <span t-field="hero_vehicle.list_price" t-options='{"widget": "monetary", "display_currency": hero_vehicle.currency_id}'/>.
                                                L'excellence automobile asiatique, accompagnee par EXOCOMS.
                                            </p>
                                            <div class="d-flex flex-wrap gap-2">
                                                <a class="btn auto-btn-primary btn-lg" href="/cars">Catalogue</a>
                                                <a class="btn auto-btn-glass btn-lg" t-att-href="hero_vehicle.website_url">Voir ce modele</a>
                                            </div>
                                            <div class="auto-hero-mini-specs mt-4">
                                                <span t-if="hero_vehicle.range_km"><strong t-esc="hero_vehicle.range_km"/> km d'autonomie</span>
                                                <span t-if="hero_vehicle.power_kw"><strong t-esc="hero_vehicle.power_kw"/> kW</span>
                                                <span t-if="hero_vehicle.battery_capacity"><strong t-esc="hero_vehicle.battery_capacity"/> kWh</span>
                                                <span t-if="hero_vehicle.motorization_id" t-esc="hero_vehicle.motorization_id.name"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </t>
                        <t t-if="not hero_vehicles">
                            <div class="carousel-item active auto-hero-slide">
                                <div class="auto-hero-slide-media">
                                    <div class="auto-hero-slide-fallback">
                                        <span>Catalogue automobile premium</span>
                                    </div>
                                    <div class="auto-hero-overlay"/>
                                </div>
                                <div class="container auto-hero-content">
                                    <div class="auto-hero-content-box">
                                        <div class="auto-hero-branding">
                                            <img src="/auto_website/static/src/img/exocoms-logo.png" alt="EXOCOMS Group" class="auto-hero-exocoms-logo"/>
                                            <span class="auto-hero-kicker">EXOCOMS Mobility</span>
                                        </div>
                                        <h1 class="auto-hero-title">Le catalogue premium des voitures chinoises.</h1>
                                        <p class="auto-hero-subtitle">Vehicules verifies, prix transparents, accompagnement complet de la selection a la livraison.</p>
                                        <a class="btn auto-btn-primary btn-lg" href="/cars">Ouvrir le catalogue</a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#autoHeroCarousel" data-bs-slide="prev" aria-label="Precedent">
                        <span class="carousel-control-prev-icon" aria-hidden="true"/>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#autoHeroCarousel" data-bs-slide="next" aria-label="Suivant">
                        <span class="carousel-control-next-icon" aria-hidden="true"/>
                    </button>
                    <t t-if="hero_vehicles and len(hero_vehicles) &gt; 1">
                        <div class="carousel-indicators auto-hero-indicators">
                            <t t-foreach="hero_vehicles" t-as="hero_vehicle">
                                <button type="button" data-bs-target="#autoHeroCarousel" t-attf-data-bs-slide-to="#{hero_vehicle_index}" t-attf-class="#{'active' if hero_vehicle_index == 0 else ''}" t-att-aria-current="hero_vehicle_index == 0 and 'true' or None" t-att-aria-label="'Slide %s' % (hero_vehicle_index + 1)"/>
                            </t>
                        </div>
                    </t>
                </div>

                <div class="container">
                    <div class="auto-hero-stats">
                        <div class="auto-stat-card">
                            <span class="auto-stat-value" t-esc="vehicle_total"/>
                            <span class="auto-stat-label">Vehicules publies</span>
                        </div>
                        <div class="auto-stat-card">
                            <span class="auto-stat-value" t-esc="available_count"/>
                            <span class="auto-stat-label">Disponibles immediatement</span>
                        </div>
                        <div class="auto-stat-card">
                            <span class="auto-stat-value" t-esc="len(brands)"/>
                            <span class="auto-stat-label">Marques partenaires</span>
                        </div>
                        <div class="auto-stat-card" t-if="starting_vehicle">
                            <span class="auto-stat-value">
                                <span t-field="starting_vehicle.list_price" t-options='{"widget": "monetary", "display_currency": starting_vehicle.currency_id}'/>
                            </span>
                            <span class="auto-stat-label">Prix de depart</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="py-5 bg-white auto-brand-band">
                <div class="container">
                    <div class="d-flex justify-content-between align-items-end mb-3 flex-wrap gap-2">
                        <div>
                            <h2 class="auto-section-title mb-1">Marques partenaires</h2>
                            <p class="text-muted mb-0">Defilement continu des constructeurs disponibles sur la plateforme.</p>
                        </div>
                        <a href="/brands" class="btn btn-outline-dark btn-sm">Tout voir</a>
                    </div>
                </div>
                <div class="auto-brand-marquee" aria-label="Marques partenaires">
                    <div class="auto-brand-track">
                        <t t-foreach="brands" t-as="brand">
                            <a t-att-href="'/brands/%s' % brand.id" class="auto-brand-chip text-decoration-none" t-att-title="brand.name">
                                <div class="auto-brand-chip-logo">
                                    <img t-if="brand.logo" t-att-src="image_data_uri(brand.logo)" t-att-alt="brand.name" class="auto-brand-logo"/>
                                    <span t-if="not brand.logo" class="auto-brand-fallback" t-esc="brand.name"/>
                                </div>
                                <span class="auto-brand-chip-name" t-esc="brand.name"/>
                            </a>
                        </t>
                        <t t-foreach="brands" t-as="brand_clone">
                            <a t-att-href="'/brands/%s' % brand_clone.id" class="auto-brand-chip text-decoration-none" t-att-title="brand_clone.name">
                                <div class="auto-brand-chip-logo">
                                    <img t-if="brand_clone.logo" t-att-src="image_data_uri(brand_clone.logo)" t-att-alt="brand_clone.name" class="auto-brand-logo"/>
                                    <span t-if="not brand_clone.logo" class="auto-brand-fallback" t-esc="brand_clone.name"/>
                                </div>
                                <span class="auto-brand-chip-name" t-esc="brand_clone.name"/>
                            </a>
                        </t>
                    </div>
                </div>
            </section>

            <section class="pb-5 bg-white">
                <div class="container">
                    <div class="auto-solution-tabs">
                        <ul class="nav nav-tabs auto-tabs" role="tablist">
                            <t t-foreach="categories" t-as="category">
                                <li class="nav-item" role="presentation" t-if="category_index &lt; 4">
                                    <button t-attf-class="nav-link #{'active' if category_index == 0 else ''}" data-bs-toggle="tab" t-att-data-bs-target="'#auto_cat_%s' % category.id" type="button" role="tab" t-esc="category.name"/>
                                </li>
                            </t>
                        </ul>
                        <div class="tab-content auto-tabs-content">
                            <t t-foreach="categories" t-as="category">
                                <t t-if="category_index &lt; 4">
                                    <div t-attf-class="tab-pane fade #{'show active' if category_index == 0 else ''}" t-att-id="'auto_cat_%s' % category.id" role="tabpanel">
                                        <h3 class="h4 mb-3"><t t-esc="category.name"/>: trouvez le modele adapte</h3>
                                        <p class="text-muted mb-4">
                                            Selection de vehicules <t t-esc="category.name.lower()"/> avec equipements connectes, garanties constructeur
                                            et accompagnement complet: devis, essai, reservation et financement.
                                        </p>
                                        <div class="d-flex flex-wrap align-items-center gap-3">
                                            <span class="badge rounded-pill text-bg-light border px-3 py-2">
                                                <strong t-esc="category_count_map.get(category.id, 0)"/> modeles publies
                                            </span>
                                            <a class="btn auto-btn-primary" t-att-href="'/cars?category=%s' % category.id">Explorer la categorie</a>
                                        </div>
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                </div>
            </section>

            <section class="py-5 auto-featured-shell">
                <div class="container">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <div>
                            <h2 class="auto-section-title mb-1">Modeles vedettes</h2>
                            <p class="text-muted mb-0">Des prix reels, des fiches claires, des decisions plus rapides.</p>
                        </div>
                        <a href="/cars" class="btn btn-outline-dark">Ouvrir le catalogue complet</a>
                    </div>
                    <div class="row g-4">
                        <t t-foreach="featured_vehicles" t-as="vehicle">
                            <div class="col-12 col-md-6 col-xl-3">
                                <t t-call="auto_website.vehicle_card_fragment"/>
                            </div>
                        </t>
                    </div>
                </div>
            </section>

            <section class="py-5 bg-white">
                <div class="container">
                    <div class="row g-4 align-items-center">
                        <div class="col-lg-6">
                            <h2 class="auto-section-title auto-story-title">Acceder aux voitures de demain</h2>
                            <p class="auto-story-text">
                                Les constructeurs asiatiques transforment la mobilite grace a des plateformes 100% electriques,
                                des systemes d'aide a la conduite avances et des couts d'utilisation maitrises.
                                Notre plateforme centralise l'offre, les disponibilites et les parcours clients pour convertir plus vite.
                            </p>
                            <div class="d-flex flex-wrap gap-2 mb-4">
                                <a href="/cars" class="btn auto-btn-primary btn-lg">Acceder au catalogue</a>
                                <a href="/cars?sort=price_asc" class="btn btn-outline-dark btn-lg">Voir les meilleurs prix</a>
                            </div>
                            <div class="auto-exocoms-inline-contact">
                                <div class="auto-inline-item">EXOCOMS Group</div>
                                <div class="auto-inline-item">58 rue de Monceau - 75008 Paris</div>
                                <a class="auto-inline-item auto-inline-link" href="tel:+33184793755">+33 (0)1 84 79 37 55</a>
                                <a class="auto-inline-item auto-inline-link" href="mailto:contact@exocoms.fr">contact@exocoms.fr</a>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="auto-story-visual">
                                <div class="auto-story-card">
                                    <img src="/auto_website/static/src/img/exocoms-logo.png" alt="EXOCOMS Group" class="auto-story-exocoms-logo"/>
                                    <h3 class="h5 mb-2">Une expertise tech au service de votre mobilite</h3>
                                    <p class="mb-3">"EXOCOMS accompagne les entreprises avec des services fiables, innovants et adaptes a chaque besoin."</p>
                                    <div class="small text-muted mb-2">Source: exocoms.fr</div>
                                    <a class="auto-inline-link" href="https://www.facebook.com/profile.php?id=61582991085037" target="_blank" rel="noopener noreferrer">Facebook officiel</a>
                                </div>
                                <div class="auto-story-mini-image" t-if="latest_vehicles and latest_vehicles[0].main_image">
                                    <img t-att-src="image_data_uri(latest_vehicles[0].main_image)" t-att-alt="latest_vehicles[0].display_name"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="catalog_page" name="Vehicle Catalog">
        <t t-call="website.layout">
            <section class="py-4 auto-catalog-header">
                <div class="container">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h1 class="h2 mb-1">Catalogue des vehicules</h1>
                            <p class="text-muted mb-0">Filtrez par marque, motorisation, disponibilite, annee et budget.</p>
                        </div>
                        <a href="/cars/home" class="btn btn-outline-dark">Retour accueil</a>
                    </div>
                </div>
            </section>

            <section class="pb-5">
                <div class="container">
                    <form method="get" action="/cars" class="auto-filter-bar mb-4">
                        <div class="row g-2">
                            <div class="col-12 col-md-6 col-lg-2">
                                <input class="form-control" name="search" type="text" placeholder="Rechercher un modele" t-att-value="query.get('search', '')"/>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <select class="form-select" name="brand">
                                    <option value="">Marque</option>
                                    <t t-foreach="brands" t-as="brand">
                                        <option t-att-value="brand.id" t-att-selected="str(brand.id) == query.get('brand', '') and 'selected' or None"><t t-esc="brand.name"/></option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <select class="form-select" name="category">
                                    <option value="">Categorie</option>
                                    <t t-foreach="categories" t-as="category">
                                        <option t-att-value="category.id" t-att-selected="str(category.id) == query.get('category', '') and 'selected' or None"><t t-esc="category.name"/></option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <select class="form-select" name="motorization">
                                    <option value="">Motorisation</option>
                                    <t t-foreach="motorizations" t-as="motorization">
                                        <option t-att-value="motorization.id" t-att-selected="str(motorization.id) == query.get('motorization', '') and 'selected' or None"><t t-esc="motorization.name"/></option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <select class="form-select" name="availability">
                                    <option value="">Disponibilite</option>
                                    <t t-foreach="availability_values" t-as="availability_val">
                                        <option t-att-value="availability_val[0]" t-att-selected="availability_val[0] == query.get('availability', '') and 'selected' or None"><t t-esc="availability_val[1]"/></option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-6 col-md-3 col-lg-1">
                                <input class="form-control" name="price_min" type="number" min="0" placeholder="Prix min" t-att-value="query.get('price_min', '')"/>
                            </div>
                            <div class="col-6 col-md-3 col-lg-1">
                                <input class="form-control" name="price_max" type="number" min="0" placeholder="Prix max" t-att-value="query.get('price_max', '')"/>
                            </div>
                            <div class="col-6 col-md-3 col-lg-1">
                                <input class="form-control" name="year_min" type="number" min="1990" placeholder="Annee min" t-att-value="query.get('year_min', '')"/>
                            </div>
                            <div class="col-6 col-md-3 col-lg-1">
                                <input class="form-control" name="year_max" type="number" min="1990" placeholder="Annee max" t-att-value="query.get('year_max', '')"/>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2">
                                <select class="form-select" name="sort">
                                    <option value="newest" t-att-selected="sort_key == 'newest' and 'selected' or None">Plus recents</option>
                                    <option value="price_asc" t-att-selected="sort_key == 'price_asc' and 'selected' or None">Prix croissant</option>
                                    <option value="price_desc" t-att-selected="sort_key == 'price_desc' and 'selected' or None">Prix decroissant</option>
                                    <option value="range_desc" t-att-selected="sort_key == 'range_desc' and 'selected' or None">Autonomie</option>
                                    <option value="year_desc" t-att-selected="sort_key == 'year_desc' and 'selected' or None">Annee modele</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-3 col-lg-2 d-flex gap-2">
                                <button class="btn auto-btn-primary flex-grow-1" type="submit">Appliquer</button>
                                <a href="/cars" class="btn btn-outline-secondary">Reset</a>
                            </div>
                        </div>
                    </form>

                    <div class="row g-4">
                        <t t-if="vehicles">
                            <t t-foreach="vehicles" t-as="vehicle">
                                <div class="col-12 col-md-6 col-lg-4">
                                    <t t-call="auto_website.vehicle_card_fragment"/>
                                </div>
                            </t>
                        </t>
                        <t t-if="not vehicles">
                            <div class="col-12">
                                <div class="alert alert-info mb-0">Aucun vehicule ne correspond a vos filtres.</div>
                            </div>
                        </t>
                    </div>

                    <div class="pt-4 d-flex justify-content-center">
                        <t t-call="website.pager"/>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="vehicle_card_fragment" name="Vehicle Card Fragment">
        <article class="auto-vehicle-card h-100">
            <a t-att-href="vehicle.website_url" class="auto-vehicle-media d-block">
                <img t-if="vehicle.main_image" t-att-src="image_data_uri(vehicle.main_image)" t-att-alt="vehicle.display_name"/>
                <div t-if="not vehicle.main_image" class="auto-vehicle-media-placeholder">Image du vehicule indisponible</div>
            </a>
            <div class="auto-vehicle-body">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                        <div class="text-muted small" t-esc="vehicle.brand_id.name"/>
                        <h3 class="h5 mb-1">
                            <a t-att-href="vehicle.website_url" class="text-decoration-none text-dark" t-esc="vehicle.display_name"/>
                        </h3>
                    </div>
                    <span class="badge text-bg-secondary" t-esc="dict(vehicle.AVAILABILITY_SELECTION).get(vehicle.availability)"/>
                </div>
                <div class="auto-vehicle-meta mt-2">
                    <span><strong t-esc="vehicle.year"/></span>
                    <span t-if="vehicle.range_km"><strong t-esc="vehicle.range_km"/> km</span>
                    <span t-if="vehicle.motorization_id" t-esc="vehicle.motorization_id.name"/>
                </div>
                <div class="mt-3 mb-3 auto-price">
                    <span t-field="vehicle.list_price" t-options='{"widget": "monetary", "display_currency": vehicle.currency_id}'/>
                </div>
                <div class="d-grid gap-2">
                    <a t-att-href="vehicle.website_url" class="btn btn-outline-dark">Voir les details</a>
                    <form t-if="vehicle.availability == 'available'" action="/shop/cart/update" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="product_id" t-att-value="vehicle.product_template_id.product_variant_id.id"/>
                        <input type="hidden" name="add_qty" value="1"/>
                        <button type="submit" class="btn auto-btn-primary w-100">Ajouter au panier</button>
                    </form>
                    <a t-att-href="'/cars/compare/add/%s' % vehicle.id" class="btn btn-outline-secondary" data-auto-compare-link="1" t-att-data-auto-compare-label="vehicle.name">Comparer</a>
                </div>
            </div>
        </article>
    </template>

    <template id="vehicle_detail_page" name="Vehicle Detail">
        <t t-call="website.layout">
            <section class="py-4 auto-detail-page">
                <div class="container">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-3">
                            <li class="breadcrumb-item"><a href="/cars">Catalogue</a></li>
                            <li class="breadcrumb-item"><a t-att-href="'/brands/%s' % vehicle.brand_id.id"><t t-esc="vehicle.brand_id.name"/></a></li>
                            <li class="breadcrumb-item active" aria-current="page"><t t-esc="vehicle.name"/></li>
                        </ol>
                    </nav>

                    <div class="row g-4">
                        <div class="col-lg-7">
                            <div class="auto-detail-media mb-3">
                                <img t-if="vehicle.main_image" t-att-src="image_data_uri(vehicle.main_image)" t-att-alt="vehicle.display_name" class="img-fluid w-100"/>
                                <div t-if="not vehicle.main_image" class="auto-vehicle-media-placeholder">Image indisponible</div>
                            </div>
                            <div class="row g-2">
                                <t t-foreach="vehicle.image_ids" t-as="gallery_image">
                                    <div class="col-4 col-md-3">
                                        <img t-att-src="image_data_uri(gallery_image.image_1920)" t-att-alt="gallery_image.alt_text or vehicle.display_name" class="img-fluid rounded"/>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <div class="auto-detail-panel">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <p class="mb-1 text-muted" t-esc="vehicle.brand_id.name"/>
                                        <h1 class="h3 mb-2" t-esc="vehicle.display_name"/>
                                    </div>
                                    <span class="badge text-bg-secondary" t-esc="dict(vehicle.AVAILABILITY_SELECTION).get(vehicle.availability)"/>
                                </div>

                                <div class="auto-price mb-2">
                                    <span t-field="vehicle.list_price" t-options='{"widget": "monetary", "display_currency": vehicle.currency_id}'/>
                                </div>
                                <p class="text-muted" t-esc="vehicle.short_description"/>

                                <ul class="list-unstyled auto-feature-list mb-4">
                                    <li t-if="vehicle.motorization_id"><strong>Motorisation:</strong> <span t-esc="vehicle.motorization_id.name"/></li>
                                    <li t-if="vehicle.range_km"><strong>Autonomie:</strong> <span t-esc="vehicle.range_km"/> km</li>
                                    <li t-if="vehicle.power_kw"><strong>Puissance:</strong> <span t-esc="vehicle.power_kw"/> kW</li>
                                    <li t-if="vehicle.battery_capacity"><strong>Batterie:</strong> <span t-esc="vehicle.battery_capacity"/> kWh</li>
                                    <li><strong>Annee modele:</strong> <span t-esc="vehicle.year"/></li>
                                </ul>

                                <div class="d-grid gap-2">
                                    <form t-if="vehicle.availability == 'available'" action="/shop/cart/update" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="product_id" t-att-value="vehicle.product_template_id.product_variant_id.id"/>
                                        <input type="hidden" name="add_qty" value="1"/>
                                        <button class="btn auto-btn-primary btn-lg w-100" type="submit">Ajouter au panier</button>
                                    </form>
                                    <a t-att-href="'/cars/%s/quote' % vehicle.id" class="btn btn-outline-dark btn-lg">Demander un devis</a>
                                    <a t-att-href="'/cars/%s/book' % vehicle.id" class="btn btn-outline-dark btn-lg">Reserver ce vehicule</a>
                                    <a t-att-href="'/cars/%s/test-drive' % vehicle.id" class="btn btn-outline-dark btn-lg">Planifier un essai</a>
                                    <a t-att-href="'/cars/%s/financing' % vehicle.id" class="btn btn-outline-dark btn-lg">Demander un financement</a>
                                    <a t-att-href="'/cars/compare/add/%s' % vehicle.id" class="btn btn-outline-dark btn-lg" data-auto-compare-link="1" t-att-data-auto-compare-label="vehicle.name">Ajouter au comparateur</a>
                                    <form t-if="request.env.user._is_public() == False" t-att-action="'/cars/favorite/%s' % vehicle.id" method="post">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button class="btn btn-link p-0 auto-favorite-btn" type="submit">
                                            <t t-if="is_favorite">Retirer des favoris</t>
                                            <t t-if="not is_favorite">Ajouter aux favoris</t>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="pb-5">
                <div class="container">
                    <div class="row g-4">
                        <div class="col-lg-8">
                            <h2 class="h4">Specifications</h2>
                            <div class="table-responsive">
                                <table class="table table-striped align-middle">
                                    <thead>
                                        <tr>
                                            <th>Section</th>
                                            <th>Specification</th>
                                            <th>Valeur</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="vehicle.specification_ids">
                                            <t t-foreach="vehicle.specification_ids.sorted(key=lambda l: (l.sequence, l.id))" t-as="spec">
                                                <tr>
                                                    <td t-esc="dict(spec.SECTION_SELECTION).get(spec.section)"/>
                                                    <td t-esc="spec.name"/>
                                                    <td><span t-esc="spec.value"/><span t-if="spec.unit"> <t t-esc="spec.unit"/></span></td>
                                                </tr>
                                            </t>
                                        </t>
                                        <t t-if="not vehicle.specification_ids">
                                            <tr>
                                                <td colspan="3">Specifications detaillees en cours de publication.</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div class="auto-description" t-if="vehicle.description" t-raw="vehicle.description"/>
                        </div>

                        <div class="col-lg-4">
                            <h2 class="h5">Options</h2>
                            <div class="d-flex flex-wrap gap-2 mb-4">
                                <t t-foreach="vehicle.option_ids" t-as="option">
                                    <span class="badge text-bg-light border" t-esc="option.name"/>
                                </t>
                            </div>

                            <h2 class="h5">Avis clients</h2>
                            <div class="auto-review-list">
                                <t t-if="reviews">
                                    <t t-foreach="reviews" t-as="review">
                                        <article class="auto-review-item mb-3">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <strong t-esc="review.title or review.partner_id.name"/>
                                                <small><t t-esc="review.rating"/>/5</small>
                                            </div>
                                            <p class="mb-0" t-esc="review.comment"/>
                                        </article>
                                    </t>
                                </t>
                                <t t-if="not reviews">
                                    <p class="text-muted">Aucun avis publie pour le moment.</p>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="pb-5" t-if="related_vehicles">
                <div class="container">
                    <h2 class="h4 mb-4">Modeles similaires</h2>
                    <div class="row g-4">
                        <t t-foreach="related_vehicles" t-as="vehicle">
                            <div class="col-12 col-md-6 col-lg-4">
                                <t t-call="auto_website.vehicle_card_fragment"/>
                            </div>
                        </t>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="brand_list_page" name="Brand List">
        <t t-call="website.layout">
            <section class="py-5">
                <div class="container">
                    <h1 class="h2 mb-4">Toutes les marques</h1>
                    <div class="row g-3">
                        <t t-foreach="brands" t-as="brand">
                            <div class="col-6 col-md-4 col-lg-3">
                                <a t-att-href="'/brands/%s' % brand.id" class="auto-brand-card d-block text-decoration-none">
                                    <div class="auto-brand-logo-wrap">
                                        <img t-if="brand.logo" t-att-src="image_data_uri(brand.logo)" t-att-alt="brand.name" class="auto-brand-logo"/>
                                        <span t-if="not brand.logo" class="auto-brand-fallback" t-esc="brand.name"/>
                                    </div>
                                    <div class="mt-2 fw-semibold text-dark" t-esc="brand.name"/>
                                </a>
                            </div>
                        </t>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="brand_detail_page" name="Brand Detail">
        <t t-call="website.layout">
            <section class="py-5">
                <div class="container">
                    <div class="row g-4 align-items-start">
                        <div class="col-md-3">
                            <img t-if="brand.logo" t-att-src="image_data_uri(brand.logo)" t-att-alt="brand.name" class="img-fluid rounded border"/>
                        </div>
                        <div class="col-md-9">
                            <h1 class="h2 mb-2" t-esc="brand.name"/>
                            <div t-if="brand.description" t-raw="brand.description"/>
                            <a href="/cars" class="btn btn-outline-secondary mt-3">Retour catalogue</a>
                        </div>
                    </div>
                </div>
            </section>

            <section class="pb-5">
                <div class="container">
                    <h2 class="h4 mb-4">Modeles de la marque</h2>
                    <div class="row g-4">
                        <t t-if="vehicles">
                            <t t-foreach="vehicles" t-as="vehicle">
                                <div class="col-12 col-md-6 col-lg-4">
                                    <t t-call="auto_website.vehicle_card_fragment"/>
                                </div>
                            </t>
                        </t>
                        <t t-if="not vehicles">
                            <div class="col-12">
                                <p class="text-muted mb-0">Aucun modele publie pour cette marque.</p>
                            </div>
                        </t>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="my_favorites_page" name="My Favorite Vehicles">
        <t t-call="website.layout">
            <section class="py-5">
                <div class="container">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h1 class="h3 mb-0">Mes vehicules favoris</h1>
                        <a href="/cars" class="btn btn-outline-secondary">Explorer le catalogue</a>
                    </div>
                    <div class="row g-4">
                        <t t-if="vehicles">
                            <t t-foreach="vehicles" t-as="vehicle">
                                <div class="col-12 col-md-6 col-lg-4">
                                    <t t-call="auto_website.vehicle_card_fragment"/>
                                </div>
                            </t>
                        </t>
                        <t t-if="not vehicles">
                            <div class="col-12">
                                <div class="alert alert-info mb-0">Aucun favori pour le moment.</div>
                            </div>
                        </t>
                    </div>
                </div>
            </section>
        </t>
    </template>
</odoo>
