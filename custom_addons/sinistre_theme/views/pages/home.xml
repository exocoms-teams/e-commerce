<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_home" name="Sinistre Services — Accueil">
        <t t-call="website.layout">

            <!-- ── HERO ── -->
            <section class="ss-hero">
                <div class="ss-container">
                    <div class="ss-hero__inner">

                        <!-- Contenu gauche -->
                        <div class="ss-hero__content">
                            <div class="ss-hero__badge">
                                <span class="ss-dot"/>
                                Plateforme agreee assurances · Artisans certifies
                            </div>
                            <h1 class="ss-hero__title">
                                Intervention rapide
                                <span class="ss-hero__accent">pour vos sinistres</span>
                            </h1>
                            <p class="ss-hero__desc">
                                Serruriers, plombiers, menuisiers disponibles
                                <strong>24h/24 — 7j/7</strong> partout en France.
                                Intervention en moins de 2h, devis gratuit.
                            </p>
                            <div class="ss-hero__actions">
                                <a href="/demande-intervention" class="ss-btn ss-btn--primary ss-btn--lg">
                                    <i class="fa fa-wrench" aria-hidden="true"/> Demander une intervention
                                </a>
                                <a href="tel:+33100000000" class="ss-btn ss-btn--outline ss-btn--lg">
                                    <i class="fa fa-phone" aria-hidden="true"/> 01 XX XX XX XX
                                </a>
                            </div>
                            <div class="ss-hero__trust">
                                <span>&#10003; Intervention en 2h</span>
                                <span>&#10003; Devis gratuit</span>
                                <span>&#10003; Artisans certifies</span>
                                <span>&#10003; 24h/24 7j/7</span>
                            </div>
                        </div>

                        <!-- Formulaire demande rapide (droite) -->
                        <div class="ss-hero__form">
                            <h3>Demande rapide</h3>
                            <p>Reponse sous 15 minutes</p>
                            <form method="POST" action="/demande-intervention">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="ss-form-group">
                                    <label class="ss-form-label">Type d'intervention</label>
                                    <select name="type_intervention" class="ss-form-control">
                                        <option value="serrurerie">Serrurerie</option>
                                        <option value="plomberie">Plomberie</option>
                                        <option value="menuiserie_ext">Menuiserie</option>
                                        <option value="vitrerie">Vitrerie</option>
                                        <option value="electricite">Electricite</option>
                                        <option value="autre">Autre</option>
                                    </select>
                                </div>
                                <div class="ss-form-group">
                                    <label class="ss-form-label">Telephone</label>
                                    <input type="tel" name="telephone" placeholder="06 XX XX XX XX" class="ss-form-control"/>
                                </div>
                                <div class="ss-form-group" style="margin-bottom:20px;">
                                    <label class="ss-form-label">Code postal</label>
                                    <input type="text" name="code_postal" placeholder="75001" class="ss-form-control"/>
                                </div>
                                <button type="submit" class="ss-btn ss-btn--primary" style="width:100%;justify-content:center;padding:14px;font-size:15px;">
                                    Trouver un artisan
                                </button>
                                <p style="text-align:center;font-size:11px;color:#9CA3AF;margin-top:10px;">Sans engagement · Devis gratuit</p>
                            </form>
                        </div>

                    </div>
                </div>
            </section>

            <!-- ── STATS ── -->
            <t t-call="sinistre_theme.stats_section"/>

            <!-- ── SERVICES ── -->
            <section class="ss-section ss-section--gray">
                <div class="ss-container">
                    <div class="ss-section__header">
                        <span class="ss-eyebrow">Nos interventions</span>
                        <h2>Tous types de sinistres pris en charge</h2>
                        <p>Artisans qualifies disponibles 24h/24 — Intervention garantie en moins de 2h</p>
                    </div>
                    <div class="ss-grid ss-grid--3">
                        <a href="/demande-intervention" class="ss-card">
                            <div class="ss-card__icon"><i class="fa fa-lock" aria-hidden="true"/></div>
                            <h3>Serrurerie</h3>
                            <p>Porte claquee, serrure forcee, cylindre a remplacer. Intervention sous 45 minutes.</p>
                            <span class="ss-card__arrow">&#8594;</span>
                        </a>
                        <a href="/demande-intervention" class="ss-card">
                            <div class="ss-card__icon"><i class="fa fa-tint" aria-hidden="true"/></div>
                            <h3>Plomberie</h3>
                            <p>Fuite d'eau, degat des eaux, canalisation bouchee. Plombiers disponibles 24h/24.</p>
                            <span class="ss-card__arrow">&#8594;</span>
                        </a>
                        <a href="/demande-intervention" class="ss-card">
                            <div class="ss-card__icon"><i class="fa fa-home" aria-hidden="true"/></div>
                            <h3>Menuiserie</h3>
                            <p>Porte fracturee, fenetre endommagee, volet casse. Reparation urgente ou remplacement.</p>
                            <span class="ss-card__arrow">&#8594;</span>
                        </a>
                        <a href="/demande-intervention" class="ss-card">
                            <div class="ss-card__icon"><i class="fa fa-th-large" aria-hidden="true"/></div>
                            <h3>Vitrerie</h3>
                            <p>Bris de glace, fenetre cassee, double vitrage. Bache provisoire dans l'heure.</p>
                            <span class="ss-card__arrow">&#8594;</span>
                        </a>
                        <a href="/demande-intervention" class="ss-card">
                            <div class="ss-card__icon"><i class="fa fa-bolt" aria-hidden="true"/></div>
                            <h3>Electricite</h3>
                            <p>Panne electrique, disjoncteur, court-circuit. Electriciens Qualifelec disponibles.</p>
                            <span class="ss-card__arrow">&#8594;</span>
                        </a>
                        <a href="/urgence" class="ss-card ss-card--featured">
                            <div class="ss-card__icon"><i class="fa fa-exclamation-triangle" aria-hidden="true"/></div>
                            <h3>Urgence 24h/24</h3>
                            <p>Toute intervention urgente, nuit et weekend. Un artisan chez vous en moins de 2h garantis.</p>
                            <span class="ss-card__arrow">&#8594;</span>
                        </a>
                    </div>
                    <div class="ss-section__footer">
                        <a href="/nos-services" class="ss-btn ss-btn--outline">Voir tous nos services &#8594;</a>
                    </div>
                </div>
            </section>

            <!-- ── COMMENT CA MARCHE ── -->
            <section class="ss-section">
                <div class="ss-container">
                    <div class="ss-section__header">
                        <span class="ss-eyebrow">Simple et rapide</span>
                        <h2>Comment ca marche ?</h2>
                        <p>3 etapes pour resoudre votre sinistre rapidement</p>
                    </div>
                    <div class="ss-steps">
                        <div class="ss-step">
                            <div class="ss-step__num ss-step__num--blue">1</div>
                            <h3>Decrivez votre probleme</h3>
                            <p>En ligne ou par telephone, decrivez votre sinistre en 2 minutes. Disponible 24h/24.</p>
                        </div>
                        <div class="ss-step">
                            <div class="ss-step__num ss-step__num--blue">2</div>
                            <h3>Recevez un devis gratuit</h3>
                            <p>Fourchette tarifaire fixe, sans frais caches. Reservez en ligne, payez apres l'intervention.</p>
                        </div>
                        <div class="ss-step">
                            <div class="ss-step__num ss-step__num--red">3</div>
                            <h3>Un artisan intervient</h3>
                            <p>Artisan certifie chez vous en moins de 2h. Photos avant/apres garanties pour votre assurance.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ── GARANTIES ── -->
            <section class="ss-section ss-section--gray">
                <div class="ss-container">
                    <div class="ss-section__header">
                        <span class="ss-eyebrow">Nos engagements</span>
                        <h2>Pourquoi nous choisir ?</h2>
                    </div>
                    <div class="ss-grid ss-grid--4">
                        <div class="ss-garantie">
                            <div class="ss-garantie__icon"><i class="fa fa-shield" aria-hidden="true"/></div>
                            <h4>Artisans certifies</h4>
                            <p>Tous nos artisans signent une charte qualite et sont verifies avant toute intervention.</p>
                        </div>
                        <div class="ss-garantie">
                            <div class="ss-garantie__icon"><i class="fa fa-money" aria-hidden="true"/></div>
                            <h4>Prix transparents</h4>
                            <p>Devis gratuit, fourchette tarifaire fixe. Aucun frais cache, paiement apres intervention.</p>
                        </div>
                        <div class="ss-garantie">
                            <div class="ss-garantie__icon"><i class="fa fa-clock-o" aria-hidden="true"/></div>
                            <h4>Disponible 24h/24</h4>
                            <p>Urgence ou rendez-vous planifie, nous sommes disponibles 7j/7 partout en France.</p>
                        </div>
                        <div class="ss-garantie">
                            <div class="ss-garantie__icon"><i class="fa fa-building" aria-hidden="true"/></div>
                            <h4>Agree assurances</h4>
                            <p>Plateforme de gestion des sinistres pour les compagnies d'assurance. API dediee.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ── CTA URGENCE ── -->
            <section class="ss-cta">
                <div class="ss-container">
                    <div class="ss-cta__inner">
                        <i class="fa fa-exclamation-triangle" style="font-size:44px;margin-bottom:20px;display:block;opacity:.9;" aria-hidden="true"/>
                        <h2>Urgence sinistre ?</h2>
                        <p>Appelez-nous maintenant — un artisan chez vous en moins de 2h</p>
                        <a href="tel:+33100000000" class="ss-cta__tel">01 XX XX XX XX</a>
                        <div class="ss-cta__actions">
                            <a href="tel:+33100000000" class="ss-btn ss-btn--white ss-btn--lg">
                                <i class="fa fa-phone" aria-hidden="true"/> Appeler maintenant
                            </a>
                            <a href="/demande-intervention" class="ss-btn ss-btn--ghost ss-btn--lg">
                                <i class="fa fa-wrench" aria-hidden="true"/> Formulaire en ligne
                            </a>
                        </div>
                        <p style="margin-top:16px;font-size:13px;opacity:.7;">Disponible 24h/24 — 7j/7 — Prix d'un appel local</p>
                    </div>
                </div>
            </section>

            <!-- Modal rappel -->
            <t t-call="sinistre_theme.modal_rappel"/>

        </t>
    </template>

</odoo>
