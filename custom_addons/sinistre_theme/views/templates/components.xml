<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="stats_section" name="Sinistre Services — Stats">
        <section class="ss-stats">
            <div class="ss-container">
                <div class="ss-stats__grid">
                    <div class="ss-stat">
                        <span class="ss-stat__number">+15 000</span>
                        <span class="ss-stat__label">Demandes par mois</span>
                    </div>
                    <div class="ss-stat">
                        <span class="ss-stat__number">+1 700</span>
                        <span class="ss-stat__label">Artisans certifies</span>
                    </div>
                    <div class="ss-stat">
                        <span class="ss-stat__number">2h</span>
                        <span class="ss-stat__label">Delai moyen</span>
                    </div>
                    <div class="ss-stat">
                        <span class="ss-stat__number">98%</span>
                        <span class="ss-stat__label">Clients satisfaits</span>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="modal_rappel" name="Sinistre Services — Modal Rappel">
        <div id="ssRappelModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.5);align-items:center;justify-content:center;">
            <div style="background:white;border-radius:20px;padding:40px;width:100%;max-width:440px;position:relative;box-shadow:0 20px 60px rgba(0,0,0,0.25);margin:20px;">
                <button onclick="document.getElementById('ssRappelModal').style.display='none'" style="position:absolute;top:16px;right:16px;background:none;border:none;font-size:22px;cursor:pointer;color:#9CA3AF;line-height:1;">&#215;</button>
                <h2 style="font-size:20px;font-weight:700;color:#0F172A;margin-bottom:6px;font-family:'Inter',sans-serif;">Etre rappele rapidement</h2>
                <p style="font-size:13px;color:#6B7280;margin-bottom:24px;">Un conseiller vous rappelle sous 15 minutes.</p>
                <form method="POST" action="/rappel">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div style="margin-bottom:14px;">
                        <label style="display:block;font-size:11px;font-weight:600;color:#374151;margin-bottom:5px;text-transform:uppercase;letter-spacing:.5px;">Nom</label>
                        <input type="text" name="name" placeholder="Votre nom" style="width:100%;padding:11px 14px;border:1.5px solid #E5E7EB;border-radius:10px;font-size:14px;font-family:'Inter',sans-serif;box-sizing:border-box;"/>
                    </div>
                    <div style="margin-bottom:24px;">
                        <label style="display:block;font-size:11px;font-weight:600;color:#374151;margin-bottom:5px;text-transform:uppercase;letter-spacing:.5px;">Telephone *</label>
                        <input type="tel" name="phone" required="required" placeholder="01 XX XX XX XX" style="width:100%;padding:11px 14px;border:1.5px solid #E5E7EB;border-radius:10px;font-size:14px;font-family:'Inter',sans-serif;box-sizing:border-box;"/>
                    </div>
                    <button type="submit" class="ss-btn ss-btn--primary" style="width:100%;justify-content:center;padding:14px;">
                        <i class="fa fa-phone" aria-hidden="true"/> Me faire rappeler
                    </button>
                </form>
            </div>
        </div>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                document.querySelectorAll('[data-rappel]').forEach(function(el) {
                    el.addEventListener('click', function(e) {
                        e.preventDefault();
                        document.getElementById('ssRappelModal').style.display = 'flex';
                    });
                });
                var modal = document.getElementById('ssRappelModal');
                if (modal) modal.addEventListener('click', function(e) {
                    if (e.target === this) this.style.display = 'none';
                });
            });
        </script>
    </template>

</odoo>
