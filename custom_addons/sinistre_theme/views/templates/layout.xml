<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="layout" name="Sinistre Services Layout" inherit_id="website.layout" customize_show="False">

        <!-- Injecter le CSS directement dans le head -->
        <xpath expr="//head" position="inside">
            <link rel="stylesheet" type="text/css" href="/sinistre_theme/static/src/css/main.css"/>
        </xpath>

        <!-- Topbar urgence -->
        <xpath expr="//header" position="before">
            <div class="ss-topbar">
                <div class="ss-container">
                    <div class="ss-topbar-left">
                        <div class="ss-topbar-item">
                            <i class="fa fa-phone" aria-hidden="true"/>
                            <a href="tel:+33100000000">01 XX XX XX XX — Urgence 24/7</a>
                        </div>
                        <div class="ss-topbar-item">
                            <i class="fa fa-envelope" aria-hidden="true"/>
                            <a href="mailto:contact@sinistre-services.fr">contact@sinistre-services.fr</a>
                        </div>
                    </div>
                    <a href="/urgence" class="ss-topbar-cta">
                        <i class="fa fa-exclamation-triangle" aria-hidden="true"/> Urgence 24h/24
                    </a>
                </div>
            </div>
        </xpath>

    </template>

</odoo>
