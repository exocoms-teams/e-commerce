<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="layout" name="Sinistre Services Layout" inherit_id="website.layout" customize_show="False">
        <xpath expr="//footer" position="replace">
            <t t-call="sinistre_theme.footer"/>
        </xpath>

    </template>

    <template id="footer" name="Sinistre Services Footer">
        <footer class="ss-footer">
            <div class="ss-footer__top">
                <div class="ss-container">
                    <div class="ss-footer__grid">
                        <div class="ss-footer__brand">
                            <a href="/" class="ss-footer__logo">monetiques<span style="color:#3B82F6">.fr</span></a>
                            <p>Infrastructure de paiement securisee depuis 2005.</p>
                            <div class="ss-footer__badges">
                                <span class="ss-badge">PCI DSS</span>
                                <span class="ss-badge">NF525</span>
                                <span class="ss-badge">ISO 27001</span>
                            </div>
                        </div>
                        <div class="ss-footer__col">
                            <h4>Solutions</h4>
                            <ul>
                                <li><a href="/shop">Boutique</a></li>
                                <li><a href="/solutions/tpe">Terminaux TPE</a></li>
                                <li><a href="/solutions/encaissement">Encaissement</a></li>
                            </ul>
                        </div>
                        <div class="ss-footer__col">
                            <h4>Services</h4>
                            <ul>
                                <li><a href="/support">Support 7j/7</a></li>
                                <li><a href="/support">Maintenance</a></li>
                            </ul>
                        </div>
                        <div class="ss-footer__col">
                            <h4>Entreprise</h4>
                            <ul>
                                <li><a href="/a-propos">A propos</a></li>
                                <li><a href="/emplois">Emplois</a></li>
                                <li><a href="/contact">Contact</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="ss-footer__bottom">
                <div class="ss-container">
                    <p>&#169; 2025 monetiques.fr SAS. Tous droits reserves.</p>
                    <nav>
                        <a href="/mentions-legales">Mentions legales</a>
                        <a href="/confidentialite">Confidentialite</a>
                        <a href="/cgv">CGV</a>
                    </nav>
                </div>
            </div>
        </footer>
    </template>

</odoo>
