<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="auto_review_portal_rule" model="ir.rule">
        <field name="name">Review: portal own record only</field>
        <field name="model_id" ref="model_auto_review"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
