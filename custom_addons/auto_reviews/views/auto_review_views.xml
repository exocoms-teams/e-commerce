<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auto_review_tree" model="ir.ui.view">
        <field name="name">auto.review.tree</field>
        <field name="model">auto.review</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="title"/>
                <field name="rating"/>
                <field name="state"/>
                <field name="approved_by"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_auto_review_form" model="ir.ui.view">
        <field name="name">auto.review.form</field>
        <field name="model">auto.review</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state == 'approved'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state == 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="vehicle_id"/>
                            <field name="rating"/>
                            <field name="title"/>
                        </group>
                        <group>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                        </group>
                    </group>
                    <field name="comment"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_auto_review_search" model="ir.ui.view">
        <field name="name">auto.review.search</field>
        <field name="model">auto.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="state"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_auto_review" model="ir.actions.act_window">
        <field name="name">Reviews</field>
        <field name="res_model">auto.review</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_auto_review" name="Reviews" parent="auto_base.menu_auto_catalog" action="action_auto_review" sequence="60"/>
</odoo>
