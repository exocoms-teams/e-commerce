<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         PAGE NOS SERVICES
    ============================================================ -->
    <template id="ss_page_services" name="Nos Services" page="True">
        <t t-call="website.layout">
            <div class="ss-page-hero">
                <div class="ss-container">
                    <div class="ss-breadcrumb">
                        <a href="/">Accueil</a> › Nos Services
                    </div>
                    <h1 class="ss-page-title">Nos Services d'Intervention</h1>
                    <p class="ss-page-subtitle">Artisans qualifiés disponibles 24h/24 — Intervention en 2h</p>
                </div>
            </div>

            <section style="padding:72px 0; background:var(--ss-gray-pale)">
                <div class="ss-container">

                    <!-- Serrurerie -->
                    <div id="serrurerie" class="ss-service-detail" style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;margin-bottom:80px">
                        <div>
                            <span class="ss-section-tag">Serrurerie</span>
                            <h2 class="ss-section-title">🔐 Interventions Serrurerie</h2>
                            <div class="ss-section-underline" style="margin:0 0 20px"/>
                            <p style="font-size:15px;color:var(--ss-gray);margin-bottom:20px;line-height:1.75">
                                Nos serruriers interviennent pour toute urgence : porte claquée, serrure forcée
                                suite à effraction, cylindre à changer, installation de serrure 3 points.
                            </p>
                            <ul style="color:var(--ss-gray);font-size:14px;line-height:2;padding-left:20px">
                                <li>Ouverture de porte sans dégâts</li>
                                <li>Remplacement de cylindre et serrure</li>
                                <li>Blindage de porte</li>
                                <li>Sécurisation après effraction</li>
                                <li>Serrure connectée / multipoints</li>
                            </ul>
                            <div style="margin-top:28px;display:flex;gap:12px">
                                <a href="/demande-intervention?type=serrurerie" class="ss-btn-primary">
                                    <i class="fa fa-wrench"/> Demander une intervention
                                </a>
                                <a href="/urgence" class="ss-btn-secondary">
                                    <i class="fa fa-phone"/> Urgence
                                </a>
                            </div>
                        </div>
                        <div class="ss-img-placeholder" style="min-height:280px">
                            <i class="fa fa-key"/>
                            <span>Photo intervention serrurerie</span>
                        </div>
                    </div>

                    <!-- Plomberie -->
                    <div id="plomberie" class="ss-service-detail" style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;margin-bottom:80px">
                        <div class="ss-img-placeholder" style="min-height:280px;order:0">
                            <i class="fa fa-tint"/>
                            <span>Photo intervention plomberie</span>
                        </div>
                        <div>
                            <span class="ss-section-tag">Plomberie</span>
                            <h2 class="ss-section-title">🔧 Interventions Plomberie</h2>
                            <div class="ss-section-underline" style="margin:0 0 20px"/>
                            <p style="font-size:15px;color:var(--ss-gray);margin-bottom:20px;line-height:1.75">
                                Fuite d'eau, dégât des eaux, canalisation bouchée — nos plombiers
                                diagnostiquent et réparent rapidement pour limiter les dommages.
                            </p>
                            <ul style="color:var(--ss-gray);font-size:14px;line-height:2;padding-left:20px">
                                <li>Fuite sous évier, robinetterie</li>
                                <li>Canalisation bouchée</li>
                                <li>Dégât des eaux — pompage</li>
                                <li>Chauffe-eau, ballon d'eau chaude</li>
                                <li>Recherche de fuite non destructive</li>
                            </ul>
                            <div style="margin-top:28px">
                                <a href="/demande-intervention?type=plomberie" class="ss-btn-primary">
                                    <i class="fa fa-wrench"/> Demander une intervention
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Menuiserie -->
                    <div id="menuiserie" class="ss-service-detail" style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;margin-bottom:80px">
                        <div>
                            <span class="ss-section-tag">Menuiserie</span>
                            <h2 class="ss-section-title">🚪 Menuiserie Intérieure &amp; Extérieure</h2>
                            <div class="ss-section-underline" style="margin:0 0 20px"/>
                            <p style="font-size:15px;color:var(--ss-gray);margin-bottom:20px;line-height:1.75">
                                Porte fracturée, fenêtre endommagée, volet cassé.
                                Réparation d'urgence ou remplacement par nos menuisiers qualifiés.
                            </p>
                            <ul style="color:var(--ss-gray);font-size:14px;line-height:2;padding-left:20px">
                                <li>Porte d'entrée fracturée — sécurisation immédiate</li>
                                <li>Fenêtre et double-vitrage</li>
                                <li>Volet roulant, store</li>
                                <li>Bois, PVC, aluminium</li>
                            </ul>
                            <div style="margin-top:28px">
                                <a href="/demande-intervention?type=menuiserie_ext" class="ss-btn-primary">
                                    <i class="fa fa-wrench"/> Demander une intervention
                                </a>
                            </div>
                        </div>
                        <div class="ss-img-placeholder" style="min-height:280px">
                            <i class="fa fa-cube"/>
                            <span>Photo intervention menuiserie</span>
                        </div>
                    </div>

                    <!-- Vitrerie + Électricité côte à côte -->
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
                        <div id="vitrerie" class="ss-service-card" style="text-decoration:none;display:flex;flex-direction:column">
                            <div class="ss-service-icon"><i class="fa fa-th-large"/></div>
                            <h3 class="ss-service-title">🪟 Vitrerie</h3>
                            <p class="ss-service-p">
                                Bris de glace, fenêtre cassée, double vitrage — pose et remplacement rapides.
                                Bâche provisoire disponible dans l'heure.
                            </p>
                            <a href="/demande-intervention?type=vitrerie" class="ss-btn-primary" style="margin-top:auto">
                                Demander
                            </a>
                        </div>
                        <div id="electricite" class="ss-service-card" style="text-decoration:none;display:flex;flex-direction:column">
                            <div class="ss-service-icon"><i class="fa fa-bolt"/></div>
                            <h3 class="ss-service-title">⚡ Électricité</h3>
                            <p class="ss-service-p">
                                Panne électrique, disjoncteur, court-circuit, installation.
                                Électriciens Qualifelec disponibles immédiatement.
                            </p>
                            <a href="/demande-intervention?type=electricite" class="ss-btn-primary" style="margin-top:auto">
                                Demander
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <div class="ss-cta-band">
                <div class="ss-container">
                    <div>
                        <h3>Vous êtes une assurance ?</h3>
                        <p>Intégrez notre API pour envoyer vos ordres de mission automatiquement.</p>
                    </div>
                    <a href="/contact" class="ss-btn-white">Nous contacter</a>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================
         PAGE URGENCE
    ============================================================ -->
    <template id="ss_page_urgence" name="Urgence 24/7" page="True">
        <t t-call="website.layout">

            <div class="ss-urgence-hero">
                <div class="ss-container" style="text-align:center;position:relative;z-index:1">
                    <div class="ss-urgence-disponibilite">
                        <span class="ss-urgence-dot"/>
                        Intervenants disponibles maintenant
                    </div>
                    <h1 class="ss-page-title" style="color:white;font-size:36px">
                        Urgence Sinistre — Appelez maintenant
                    </h1>
                    <a href="tel:+33100000000" class="ss-urgence-hero-tel">01 XX XX XX XX</a>
                    <p class="ss-urgence-hero-sub">
                        Disponible 24h/24, 7j/7, 365 jours/an — Intervention sous 2h
                    </p>
                    <div style="margin-top:32px;display:flex;gap:16px;justify-content:center;flex-wrap:wrap">
                        <a href="/demande-intervention?urgence=tres_urgente" class="ss-btn-white">
                            <i class="fa fa-wrench"/> Formulaire d'urgence
                        </a>
                        <a href="#" class="ss-btn-primary"
                           style="background:rgba(255,255,255,0.15); border:2px solid rgba(255,255,255,0.4);"
                           data-rappel-trigger="1">
                            <i class="fa fa-phone"/> Rappel immédiat
                        </a>
                    </div>
                </div>
            </div>

            <section style="padding:64px 0;background:var(--ss-gray-pale)">
                <div class="ss-container">
                    <div class="ss-section-head">
                        <span class="ss-section-tag">En cas d'urgence</span>
                        <h2 class="ss-section-title">Que faire avant notre arrivée ?</h2>
                        <div class="ss-section-underline"/>
                    </div>
                    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
                        <div style="background:white;border-radius:12px;padding:28px;border:1px solid var(--ss-gray-border)">
                            <div style="font-size:32px;margin-bottom:16px">🔐</div>
                            <h4 style="font-family:var(--font-head);font-size:16px;font-weight:700;margin-bottom:10px">Effraction / Serrure</h4>
                            <ul style="color:var(--ss-gray);font-size:13px;line-height:1.8;padding-left:18px">
                                <li>Déposez une main courante à la police</li>
                                <li>Ne touchez pas à la zone effrée</li>
                                <li>Prenez des photos pour l'assurance</li>
                                <li>Attendez notre intervenant pour sécuriser</li>
                            </ul>
                        </div>
                        <div style="background:white;border-radius:12px;padding:28px;border:1px solid var(--ss-gray-border)">
                            <div style="font-size:32px;margin-bottom:16px">🔧</div>
                            <h4 style="font-family:var(--font-head);font-size:16px;font-weight:700;margin-bottom:10px">Fuite / Dégât des eaux</h4>
                            <ul style="color:var(--ss-gray);font-size:13px;line-height:1.8;padding-left:18px">
                                <li>Coupez l'eau au robinet général</li>
                                <li>Coupez le disjoncteur électrique</li>
                                <li>Éloignez vos affaires de l'eau</li>
                                <li>Photographiez les dégâts</li>
                            </ul>
                        </div>
                        <div style="background:white;border-radius:12px;padding:28px;border:1px solid var(--ss-gray-border)">
                            <div style="font-size:32px;margin-bottom:16px">⚡</div>
                            <h4 style="font-family:var(--font-head);font-size:16px;font-weight:700;margin-bottom:10px">Panne Électrique</h4>
                            <ul style="color:var(--ss-gray);font-size:13px;line-height:1.8;padding-left:18px">
                                <li>Vérifiez le disjoncteur général</li>
                                <li>Débranchez les appareils sensibles</li>
                                <li>N'intervenez jamais sur les fils</li>
                                <li>Contactez-nous pour un électricien</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>

            <div class="ss-cta-band">
                <div class="ss-container">
                    <div>
                        <h3>Votre situation est urgente ?</h3>
                        <p>N'attendez pas, appelez-nous ou remplissez le formulaire d'urgence.</p>
                    </div>
                    <a href="/demande-intervention?urgence=tres_urgente" class="ss-btn-white">
                        <i class="fa fa-exclamation"/> Formulaire d'urgence
                    </a>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================
         PAGE DEMANDE D'INTERVENTION (formulaire)
    ============================================================ -->
    <template id="ss_page_demande" name="Demande d'Intervention" page="True">
        <t t-call="website.layout">
            <div class="ss-page-hero">
                <div class="ss-container">
                    <div class="ss-breadcrumb"><a href="/">Accueil</a> › Demande d'intervention</div>
                    <h1 class="ss-page-title">Demande d'Intervention</h1>
                    <p class="ss-page-subtitle">
                        Particulier, entreprise ou assuré — remplissez ce formulaire, nous intervenons sous 2h
                    </p>
                </div>
            </div>

            <section class="ss-demande-body">
                <div class="ss-container">

                    <!-- Succès -->
                    <t t-if="success">
                        <div style="max-width:640px;margin:0 auto;background:var(--ss-green-pale);border:1px solid #A5D6A7;border-radius:12px;padding:32px;text-align:center">
                            <div style="font-size:48px;margin-bottom:16px">✅</div>
                            <h2 style="font-family:var(--font-head);font-size:22px;font-weight:700;color:var(--ss-green);margin-bottom:8px">
                                Demande enregistrée !
                            </h2>
                            <p style="color:var(--ss-gray);margin-bottom:20px">
                                Votre demande a bien été reçue. Un conseiller vous contacte dans les 30 minutes.
                            </p>
                            <t t-if="reference">
                                <p style="font-family:var(--font-head);font-size:13px;color:var(--ss-gray-mid)">
                                    Référence dossier :
                                    <strong style="color:var(--ss-blue)"><t t-esc="reference"/></strong>
                                </p>
                                <a t-if="token" t-attf-href="/suivi/#{token}" class="ss-btn-primary" style="margin-top:16px;display:inline-flex">
                                    <i class="fa fa-search"/> Suivre mon dossier
                                </a>
                            </t>
                        </div>
                    </t>

                    <!-- Erreur -->
                    <t t-if="error">
                        <div class="ss-form-alert ss-form-alert-error" style="max-width:640px;margin:0 auto 24px">
                            Veuillez remplir tous les champs obligatoires.
                        </div>
                    </t>

                    <!-- Formulaire -->
                    <t t-if="not success">
                        <div class="ss-demande-grid">
                            <!-- FORMULAIRE PRINCIPAL -->
                            <div class="ss-form-card">
                                <h2>Décrivez votre sinistre</h2>
                                <p class="ss-form-sub">
                                    Remplissez ce formulaire, un conseiller vous rappelle sous 30 minutes.
                                </p>
                                <form method="POST" action="/demande-intervention/send">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>

                                    <!-- Type de demandeur -->
                                    <div class="ss-form-group">
                                        <label>Vous êtes <span class="required">*</span></label>
                                        <select name="source" required="required">
                                            <option value="particulier"
                                                    t-att-selected="'selected' if (form_data.get('source','') == 'particulier' or not form_data.get('source')) else None">
                                                Particulier
                                            </option>
                                            <option value="entreprise"
                                                    t-att-selected="'selected' if form_data.get('source','') == 'entreprise' else None">
                                                Entreprise / Professionnel
                                            </option>
                                        </select>
                                    </div>

                                    <!-- Identité -->
                                    <div class="ss-form-row-2">
                                        <div class="ss-form-group">
                                            <label>Prénom</label>
                                            <input type="text" name="prenom" placeholder="Votre prénom"
                                                   t-att-value="form_data.get('prenom','') if form_data else ''"/>
                                        </div>
                                        <div class="ss-form-group">
                                            <label>Nom <span class="required">*</span></label>
                                            <input type="text" name="nom" required="required" placeholder="Votre nom"
                                                   t-att-value="form_data.get('nom','') if form_data else ''"/>
                                        </div>
                                    </div>

                                    <div class="ss-form-row-2">
                                        <div class="ss-form-group">
                                            <label>Email <span class="required">*</span></label>
                                            <input type="email" name="email" required="required"
                                                   placeholder="votre@email.fr"
                                                   t-att-value="form_data.get('email','') if form_data else ''"/>
                                        </div>
                                        <div class="ss-form-group">
                                            <label>Téléphone <span class="required">*</span></label>
                                            <input type="tel" name="telephone" required="required"
                                                   placeholder="01 XX XX XX XX"
                                                   t-att-value="form_data.get('telephone','') if form_data else ''"/>
                                        </div>
                                    </div>

                                    <!-- Type d'intervention -->
                                    <div class="ss-form-group">
                                        <label>Type d'intervention <span class="required">*</span></label>
                                        <select name="type_intervention" required="required">
                                            <option value="">-- Sélectionnez --</option>
                                            <option value="serrurerie">🔐 Serrurerie</option>
                                            <option value="plomberie">🔧 Plomberie</option>
                                            <option value="menuiserie_int">🚪 Menuiserie Intérieure</option>
                                            <option value="menuiserie_ext">🚪 Menuiserie Extérieure</option>
                                            <option value="vitrerie">🪟 Vitrerie</option>
                                            <option value="electricite">⚡ Électricité</option>
                                            <option value="autre">🔨 Autre</option>
                                        </select>
                                    </div>

                                    <!-- Urgence -->
                                    <div class="ss-form-group">
                                        <label>Niveau d'urgence</label>
                                        <input type="hidden" name="urgence" value="normale"/>
                                        <div class="ss-urgence-check">
                                            <div class="ss-urgence-check-item selected" data-value="normale"
                                                 onclick="this.closest('.ss-urgence-check').querySelectorAll('.ss-urgence-check-item').forEach(i=>i.classList.remove('selected')); this.classList.add('selected'); this.closest('form').querySelector('[name=urgence]').value=this.dataset.value">
                                                <span class="ss-urgence-check-icon">🟢</span>
                                                <span class="ss-urgence-check-label">Normale — sous 48h</span>
                                            </div>
                                            <div class="ss-urgence-check-item" data-value="urgente"
                                                 onclick="this.closest('.ss-urgence-check').querySelectorAll('.ss-urgence-check-item').forEach(i=>i.classList.remove('selected')); this.classList.add('selected'); this.closest('form').querySelector('[name=urgence]').value=this.dataset.value">
                                                <span class="ss-urgence-check-icon">🟠</span>
                                                <span class="ss-urgence-check-label">Urgente — aujourd'hui</span>
                                            </div>
                                            <div class="ss-urgence-check-item urgent" data-value="tres_urgente"
                                                 onclick="this.closest('.ss-urgence-check').querySelectorAll('.ss-urgence-check-item').forEach(i=>i.classList.remove('selected')); this.classList.add('selected'); this.closest('form').querySelector('[name=urgence]').value=this.dataset.value">
                                                <span class="ss-urgence-check-icon">🔴</span>
                                                <span class="ss-urgence-check-label">Très urgente — moins de 2h</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Adresse -->
                                    <div class="ss-form-group">
                                        <label>Adresse d'intervention <span class="required">*</span></label>
                                        <input type="text" name="adresse" required="required"
                                               placeholder="Adresse complète avec code postal"
                                               t-att-value="form_data.get('adresse','') if form_data else ''"/>
                                    </div>

                                    <!-- Description -->
                                    <div class="ss-form-group">
                                        <label>Description du sinistre <span class="required">*</span></label>
                                        <textarea name="description" required="required" rows="5"
                                                  placeholder="Décrivez votre problème en détail : que s'est-il passé, depuis quand, accès possible ?">
                                            <t t-esc="form_data.get('description','') if form_data else ''"/>
                                        </textarea>
                                    </div>

                                    <div class="ss-form-group">
                                        <label>Commentaire (optionnel)</label>
                                        <textarea name="commentaire" rows="2"
                                                  placeholder="Informations complémentaires, horaires d'accès…">
                                            <t t-esc="form_data.get('commentaire','') if form_data else ''"/>
                                        </textarea>
                                    </div>

                                    <div class="ss-form-submit">
                                        <button type="submit" class="ss-btn-primary" style="width:100%;justify-content:center">
                                            <i class="fa fa-paper-plane"/> Envoyer ma demande
                                        </button>
                                        <p style="font-size:12px;color:var(--ss-gray-mid);text-align:center;margin-top:12px">
                                            En soumettant ce formulaire, vous acceptez notre
                                            <a href="/page/confidentialite">politique de confidentialité</a>.
                                        </p>
                                    </div>
                                </form>
                            </div>

                            <!-- SIDEBAR INFO -->
                            <div class="ss-contact-sidebar">
                                <div class="ss-contact-info-card">
                                    <h3>Urgence ?</h3>
                                    <div style="text-align:center;padding:16px 0">
                                        <a href="tel:+33100000000"
                                           style="font-family:var(--font-head);font-size:24px;font-weight:800;color:var(--ss-red);display:block;margin-bottom:6px">
                                            01 XX XX XX XX
                                        </a>
                                        <p style="font-size:12px;color:var(--ss-gray-mid)">
                                            Disponible 24h/24, 7j/7
                                        </p>
                                    </div>
                                    <a href="#" class="ss-btn-primary" style="width:100%;justify-content:center" data-rappel-trigger="1">
                                        <i class="fa fa-phone"/> Être rappelé
                                    </a>
                                </div>

                                <div class="ss-contact-info-card">
                                    <h3>Vous avez une assurance ?</h3>
                                    <p style="font-size:13px;color:var(--ss-gray);margin-bottom:14px">
                                        Contactez d'abord votre assurance — elle peut nous mandater
                                        directement et prendre en charge une partie du coût.
                                    </p>
                                    <div class="ss-trust-row">
                                        <div class="ss-trust-item"><i class="fa fa-check"/> AXA partenaire</div>
                                        <div class="ss-trust-item"><i class="fa fa-check"/> MAIF partenaire</div>
                                        <div class="ss-trust-item"><i class="fa fa-check"/> Allianz partenaire</div>
                                    </div>
                                </div>

                                <div class="ss-contact-info-card">
                                    <h3>Délais d'intervention</h3>
                                    <div class="ss-horaires">
                                        <div class="ss-horaire-row">
                                            <span class="ss-horaire-day">🔴 Très urgent</span>
                                            <span class="ss-horaire-time">Moins de 2h</span>
                                        </div>
                                        <div class="ss-horaire-row">
                                            <span class="ss-horaire-day">🟠 Urgent</span>
                                            <span class="ss-horaire-time">Aujourd'hui</span>
                                        </div>
                                        <div class="ss-horaire-row">
                                            <span class="ss-horaire-day">🟢 Normal</span>
                                            <span class="ss-horaire-time">Sous 48h</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </section>
        </t>
    </template>

    <!-- ============================================================
         PAGE CONTACT
    ============================================================ -->
    <template id="ss_page_contact" name="Contact" page="True">
        <t t-call="website.layout">
            <div class="ss-page-hero">
                <div class="ss-container">
                    <div class="ss-breadcrumb"><a href="/">Accueil</a> › Contact</div>
                    <h1 class="ss-page-title">Contactez-nous</h1>
                    <p class="ss-page-subtitle">Notre équipe vous répond sous 24h ouvrées</p>
                </div>
            </div>

            <section class="ss-contact-body">
                <div class="ss-container">
                    <t t-if="success">
                        <div style="max-width:560px;margin:0 auto;background:var(--ss-green-pale);border:1px solid #A5D6A7;border-radius:12px;padding:32px;text-align:center">
                            <div style="font-size:40px;margin-bottom:12px">✅</div>
                            <h3 style="font-family:var(--font-head);color:var(--ss-green);margin-bottom:8px">Message envoyé !</h3>
                            <p style="color:var(--ss-gray)">Merci, nous vous répondrons très prochainement.</p>
                        </div>
                    </t>
                    <t t-if="error">
                        <div class="ss-form-alert ss-form-alert-error" style="margin-bottom:24px">
                            Veuillez remplir tous les champs obligatoires (nom, email, message).
                        </div>
                    </t>
                    <t t-if="not success">
                        <div class="ss-contact-grid">
                            <div class="ss-form-card">
                                <h2>Envoyez-nous un message</h2>
                                <p class="ss-form-sub">Réponse sous 24h ouvrées.</p>
                                <form method="POST" action="/contact/send">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <div class="ss-form-row-2">
                                        <div class="ss-form-group">
                                            <label>Nom <span class="required">*</span></label>
                                            <input type="text" name="name" required="required"
                                                   placeholder="Votre nom complet"
                                                   t-att-value="form_data.get('name','') if form_data else ''"/>
                                        </div>
                                        <div class="ss-form-group">
                                            <label>Email <span class="required">*</span></label>
                                            <input type="email" name="email" required="required"
                                                   placeholder="votre@email.fr"
                                                   t-att-value="form_data.get('email','') if form_data else ''"/>
                                        </div>
                                    </div>
                                    <div class="ss-form-row-2">
                                        <div class="ss-form-group">
                                            <label>Téléphone</label>
                                            <input type="tel" name="phone" placeholder="01 XX XX XX XX"
                                                   t-att-value="form_data.get('phone','') if form_data else ''"/>
                                        </div>
                                        <div class="ss-form-group">
                                            <label>Sujet</label>
                                            <input type="text" name="sujet" placeholder="Sujet de votre message"
                                                   t-att-value="form_data.get('sujet','') if form_data else ''"/>
                                        </div>
                                    </div>
                                    <div class="ss-form-group">
                                        <label>Message <span class="required">*</span></label>
                                        <textarea name="message" required="required" rows="6"
                                                  placeholder="Votre message…">
                                            <t t-esc="form_data.get('message','') if form_data else ''"/>
                                        </textarea>
                                    </div>
                                    <div class="ss-form-submit">
                                        <button type="submit" class="ss-btn-primary">
                                            <i class="fa fa-paper-plane"/> Envoyer
                                        </button>
                                    </div>
                                </form>
                            </div>
                            <div class="ss-contact-sidebar">
                                <div class="ss-contact-info-card">
                                    <h3>Nos coordonnées</h3>
                                    <div class="ss-contact-detail">
                                        <div class="ss-contact-detail-icon"><i class="fa fa-phone"/></div>
                                        <div>
                                            <span class="ss-contact-detail-label">Urgences 24/7</span>
                                            <a href="tel:+33100000000" class="ss-contact-detail-val">01 XX XX XX XX</a>
                                        </div>
                                    </div>
                                    <div class="ss-contact-detail">
                                        <div class="ss-contact-detail-icon"><i class="fa fa-envelope"/></div>
                                        <div>
                                            <span class="ss-contact-detail-label">Email</span>
                                            <a href="mailto:contact@sinistre-services.fr" class="ss-contact-detail-val">
                                                contact@sinistre-services.fr
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="ss-rappel-card" style="background:var(--ss-blue-pale);border:1px solid #BBDEFB;border-radius:12px;padding:24px;text-align:center">
                                    <h4 style="font-family:var(--font-head);font-size:15px;font-weight:700;color:var(--ss-blue);margin-bottom:8px">
                                        Préférez-vous être rappelé ?
                                    </h4>
                                    <p style="font-size:13px;color:var(--ss-gray);margin-bottom:16px">
                                        Laissez votre numéro, nous vous appelons sous 15 minutes.
                                    </p>
                                    <a href="#" class="ss-btn-primary" data-rappel-trigger="1"
                                       style="width:100%;justify-content:center">
                                        <i class="fa fa-phone"/> Être rappelé
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </section>
        </t>
    </template>

    <!-- ============================================================
         PAGE SUIVI DOSSIER (token public)
    ============================================================ -->
    <template id="ss_page_suivi" name="Suivi Dossier" page="True">
        <t t-call="website.layout">
            <div class="ss-page-hero">
                <div class="ss-container">
                    <div class="ss-breadcrumb"><a href="/">Accueil</a> › Suivi de dossier</div>
                    <h1 class="ss-page-title">Suivi de votre dossier</h1>
                </div>
            </div>

            <section class="ss-suivi-body">
                <div class="ss-container">
                    <div class="ss-suivi-card">
                        <p class="ss-suivi-ref">Référence dossier</p>
                        <p class="ss-suivi-num"><t t-esc="mission.reference"/></p>

                        <!-- État -->
                        <t t-set="state_map" t-value="{
                            'nouveau': ('⏳', 'nouveau', 'En attente de prise en charge'),
                            'assigne': ('👷', 'en_cours', 'Intervenant assigné'),
                            'rdv_planifie': ('📅', 'en_cours', 'RDV planifié'),
                            'en_cours': ('🔧', 'en_cours', 'Intervention en cours'),
                            'devis_envoye': ('📄', 'en_cours', 'Devis envoyé — en attente accord'),
                            'devis_accepte': ('✅', 'en_cours', 'Devis accepté — travaux en cours'),
                            'devis_refuse': ('❌', 'default', 'Devis refusé'),
                            'travaux_en_cours': ('⚙️', 'en_cours', 'Travaux en cours'),
                            'termine': ('✅', 'termine', 'Mission terminée'),
                            'facture': ('🧾', 'termine', 'Facturé'),
                            'clos': ('🎉', 'termine', 'Dossier clôturé'),
                            'annule': ('🚫', 'default', 'Annulé'),
                        }"/>
                        <t t-set="state_info" t-value="state_map.get(mission.state, ('❓', 'default', mission.state))"/>
                        <div t-attf-class="ss-suivi-state #{state_info[1]}">
                            <span><t t-esc="state_info[0]"/> <t t-esc="state_info[2]"/></span>
                        </div>

                        <!-- Détails -->
                        <div class="ss-suivi-details">
                            <div class="ss-suivi-detail-item">
                                <p class="ss-suivi-detail-label">Type d'intervention</p>
                                <p class="ss-suivi-detail-val"><t t-esc="mission.type_intervention"/></p>
                            </div>
                            <div class="ss-suivi-detail-item">
                                <p class="ss-suivi-detail-label">Niveau d'urgence</p>
                                <p class="ss-suivi-detail-val"><t t-esc="mission.urgence"/></p>
                            </div>
                            <div class="ss-suivi-detail-item">
                                <p class="ss-suivi-detail-label">Adresse</p>
                                <p class="ss-suivi-detail-val"><t t-esc="mission.adresse_intervention"/></p>
                            </div>
                            <t t-if="mission.intervenant_id">
                                <div class="ss-suivi-detail-item">
                                    <p class="ss-suivi-detail-label">Intervenant</p>
                                    <p class="ss-suivi-detail-val"><t t-esc="mission.intervenant_id.name"/></p>
                                </div>
                            </t>
                            <t t-if="mission.date_rdv">
                                <div class="ss-suivi-detail-item">
                                    <p class="ss-suivi-detail-label">Date RDV</p>
                                    <p class="ss-suivi-detail-val"><t t-esc="mission.date_rdv"/></p>
                                </div>
                            </t>
                            <t t-if="mission.montant_devis and mission.montant_devis > 0">
                                <div class="ss-suivi-detail-item">
                                    <p class="ss-suivi-detail-label">Montant devis</p>
                                    <p class="ss-suivi-detail-val">
                                        <t t-esc="'{:.2f}'.format(mission.montant_devis).replace('.', ',')"/> €
                                    </p>
                                </div>
                                <div class="ss-suivi-detail-item">
                                    <p class="ss-suivi-detail-label">Reste à charge</p>
                                    <p class="ss-suivi-detail-val" style="color:var(--ss-blue);font-weight:700">
                                        <t t-esc="'{:.2f}'.format(mission.reste_a_charge).replace('.', ',')"/> €
                                    </p>
                                </div>
                            </t>
                        </div>

                        <div style="margin-top:32px;padding-top:24px;border-top:1px solid var(--ss-gray-border)">
                            <p style="font-size:13px;color:var(--ss-gray-mid);margin-bottom:16px">
                                Une question sur votre dossier ?
                            </p>
                            <div style="display:flex;gap:12px;flex-wrap:wrap">
                                <a href="tel:+33100000000" class="ss-btn-primary">
                                    <i class="fa fa-phone"/> Nous appeler
                                </a>
                                <a href="/contact" class="ss-btn-secondary">
                                    <i class="fa fa-envelope"/> Nous écrire
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <!-- ============================================================
         PAGE 404 CUSTOM
    ============================================================ -->
    <template id="ss_page_404" name="Page introuvable" page="True">
        <t t-call="website.layout">
            <section style="padding:100px 0;text-align:center;background:var(--ss-gray-pale);min-height:60vh;display:flex;align-items:center">
                <div class="ss-container">
                    <div style="font-size:80px;margin-bottom:24px">🔍</div>
                    <h1 style="font-family:var(--font-head);font-size:32px;font-weight:800;color:var(--ss-dark);margin-bottom:12px">
                        Dossier introuvable
                    </h1>
                    <p t-if="message" style="font-size:16px;color:var(--ss-gray);margin-bottom:32px">
                        <t t-esc="message"/>
                    </p>
                    <p t-else="" style="font-size:16px;color:var(--ss-gray);margin-bottom:32px">
                        La page que vous recherchez n'existe pas ou le lien est expiré.
                    </p>
                    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap">
                        <a href="/" class="ss-btn-primary">Retour à l'accueil</a>
                        <a href="/contact" class="ss-btn-secondary">Nous contacter</a>
                    </div>
                </div>
            </section>
        </t>
    </template>

</odoo>
