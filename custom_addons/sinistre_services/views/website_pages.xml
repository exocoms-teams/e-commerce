<template id="page_contact" name="Sinistre Services — Contact">
    <t t-call="website.layout">

        <div class="mn-page-hero">
            <div class="mn-container">
                <p style="font-size:12px;color:rgba(255,255,255,.6);margin-bottom:12px;"><a href="/" style="color:rgba(255,255,255,.6);">Accueil</a> › Contact</p>
                <h1>Contactez-nous</h1>
                <p>Notre equipe vous repond sous 24h ouvrees</p>
            </div>
        </div>

        <!-- ZONE INTERMÉDIAIRE COMPLÈTEMENT LIBÉRÉE -->
        <div id="sinistre_services.oe_structure_page_contact_content" class="oe_structure oe_empty"/>

        <div id="sinistre_services.oe_structure_page_contact" class="oe_structure oe_empty"/>

