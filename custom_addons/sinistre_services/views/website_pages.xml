<template id="page_nos_services" name="Sinistre Services — Nos Services">
    <t t-call="website.layout">
        <div id="wrap">
            <div class="mn-page-hero">
                <div class="mn-container">
                    <p style="font-size:13px;margin-bottom:14px;position:relative;z-index:1;">
                        <a href="/" style="color:rgba(255,255,255,.7);">Accueil</a>
                        <span style="color:rgba(255,255,255,.4);"> › </span>
                        <span style="color:white;">Nos Services</span>
                    </p>
                    <h1>Nos Services d'Intervention</h1>
                    <p>Artisans qualifiés disponibles 24h/24 — Intervention garantie en moins de 2h</p>
                </div>
            </div>

            <div id="oe_structure_ss_services_top" class="oe_structure oe_empty"/>

            <div id="oe_structure_ss_services_content" class="oe_structure">
                <section class="s_text_block mn-section mn-section--gray">
                    <div class="mn-container">

                        <!-- SERRURERIE -->
                        <div id="serrurerie" class="mn-service-row">
                            <div class="mn-service-row__content">
                                <span class="mn-eyebrow">Serrurerie</span>
                                <h2>Ouverture de porte et serrurerie</h2>
                                <p>Porte claquée, serrure forcée suite à effraction, cylindre à changer. Nos serruriers interviennent sans destruction dans 95&#160;% des cas.</p>
                                <ul class="mn-service-list">
                                    <li><i class="fa fa-check" aria-hidden="true"/>Ouverture de porte sans destruction</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Remplacement de cylindre et serrure</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Blindage et sécurisation après effraction</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Reproduction de clés sur place</li>
                                </ul>
                                <div class="mn-service-actions">
                                    <a href="/demande-intervention?type=serrurerie" class="mn-btn mn-btn--primary">Intervention urgente</a>
                                    <a href="tel:+33100000000" class="mn-btn mn-btn--outline">01 XX XX XX XX</a>
                                </div>
                            </div>
                            <div class="mn-service-row__visual mn-service-row__visual--red">
                                <img src="/monetique_theme/static/src/img/serrure.jpg" alt="Serrurerie — ouverture de porte" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"/>
                                <div class="mn-service-visual-fallback" style="display:none;"><i class="fa fa-lock" aria-hidden="true"/></div>
                            </div>
                        </div>

                        <!-- PLOMBERIE -->
                        <div id="plomberie" class="mn-service-row mn-service-row--reverse">
                            <div class="mn-service-row__content">
                                <span class="mn-eyebrow">Plomberie</span>
                                <h2>Fuite d'eau et dégât des eaux</h2>
                                <p>Canalisation bouchée, fuite sur évier ou chauffe-eau, dégât des eaux urgent. Nos plombiers interviennent 24h/24 pour limiter les dommages et sécuriser votre logement.</p>
                                <ul class="mn-service-list">
                                    <li><i class="fa fa-check" aria-hidden="true"/>Recherche et réparation de fuite</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Dégât des eaux — mise en sécurité</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Débouchage canalisation</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Remplacement robinetterie et joints</li>
                                </ul>
                                <div class="mn-service-actions">
                                    <a href="/demande-intervention?type=plomberie" class="mn-btn mn-btn--primary">Intervention urgente</a>
                                </div>
                            </div>
                            <div class="mn-service-row__visual mn-service-row__visual--blue">
                                <img src="/sinistre_services/static/src/img/plumberphoto.png" alt="Plomberie — fuite d'eau" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"/>
                                <div class="mn-service-visual-fallback" style="display:none;"><i class="fa fa-tint" aria-hidden="true"/></div>
                            </div>
                        </div>

                        <!-- CHAUFFAGISTE -->
                        <div id="chauffagiste" class="mn-service-row mn-service-row--reverse">
                            <div class="mn-service-row__content">
                                <span class="mn-eyebrow">Chauffagiste</span>
                                <h2>Chauffage et chaudière</h2>
                                <p>Panne de chaudière gaz ou fioul, entretien, radiateur en défaut. Intervention rapide pour rétablir le chauffage et l'eau chaude.</p>
                                <ul class="mn-service-list">
                                    <li><i class="fa fa-check" aria-hidden="true"/>Dépannage chaudière gaz et fioul</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Entretien annuel chaudière</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Radiateur et circulateur</li>
                                </ul>
                                <div class="mn-service-actions">
                                    <a href="/demande-intervention?type=chauffagiste" class="mn-btn mn-btn--primary">Intervention urgente</a>
                                </div>
                            </div>
                            <div class="mn-service-row__visual mn-service-row__visual--orange">
                                <img src="/sinistre_services/static/src/img/chaudiere.jpg" alt="Chauffagiste — chaudière" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"/>
                                <div class="mn-service-visual-fallback" style="display:none;"><i class="fa fa-fire" aria-hidden="true"/></div>
                            </div>
                        </div>

                        <!-- ASSAINISSEMENT -->
                        <div id="assainissement" class="mn-service-row">
                            <div class="mn-service-row__content">
                                <span class="mn-eyebrow">Assainissement</span>
                                <h2>Débouchage et vidange</h2>
                                <p>Canalisation bouchée, fosse septique, bac à graisse. Nos équipes interviennent avec matériel haute pression et camion aspirateur.</p>
                                <ul class="mn-service-list">
                                    <li><i class="fa fa-check" aria-hidden="true"/>Débouchage canalisation</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Vidange fosse 3000 L</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Curage et bac à graisse</li>
                                </ul>
                                <div class="mn-service-actions">
                                    <a href="/demande-intervention?type=assainissement" class="mn-btn mn-btn--primary">Intervention urgente</a>
                                </div>
                            </div>
                            <div class="mn-service-row__visual mn-service-row__visual--blue">
                                <img src="/sinistre_services/static/src/img/canalisation.webp" alt="Assainissement — débouchage" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"/>
                                <div class="mn-service-visual-fallback" style="display:none;"><i class="fa fa-tint" aria-hidden="true"/></div>
                            </div>
                        </div>

                        <!-- MENUISERIE -->
                        <div id="menuiserie" class="mn-service-row">
                            <div class="mn-service-row__content">
                                <span class="mn-eyebrow">Menuiserie</span>
                                <h2>Portes, fenêtres et volets</h2>
                                <p>Porte fracturée, fenêtre endommagée, volet cassé suite à une tempête ou une effraction. Sécurisation immédiate puis remplacement ou réparation durable.</p>
                                <ul class="mn-service-list">
                                    <li><i class="fa fa-check" aria-hidden="true"/>Sécurisation provisoire de porte et fenêtre</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Remplacement huisserie et dormant</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Réparation volet roulant et battant</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Menuiserie intérieure et extérieure</li>
                                </ul>
                                <div class="mn-service-actions">
                                    <a href="/demande-intervention?type=menuiserie_int" class="mn-btn mn-btn--primary">Intervention urgente</a>
                                </div>
                            </div>
                            <div class="mn-service-row__visual mn-service-row__visual--green">
                                <img src="/sinistre_services/static/src/img/doorfix.jpg" alt="Menuiserie — portes et fenêtres" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"/>
                                <div class="mn-service-visual-fallback" style="display:none;"><i class="fa fa-home" aria-hidden="true"/></div>
                            </div>
                        </div>

                        <!-- VITRERIE -->
                        <div id="vitrerie" class="mn-service-row mn-service-row--reverse">
                            <div class="mn-service-row__content">
                                <span class="mn-eyebrow">Vitrerie</span>
                                <h2>Bris de glace et vitrage</h2>
                                <p>Fenêtre cassée, vitrine brisée, double vitrage endommagé. Pose de bâche provisoire dans l'heure, puis remplacement du vitrage aux normes en vigueur.</p>
                                <ul class="mn-service-list">
                                    <li><i class="fa fa-check" aria-hidden="true"/>Mise en sécurité — bâche provisoire</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Remplacement simple et double vitrage</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Vitrines commerciales et baies vitrées</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Intervention rapide 7j/7</li>
                                </ul>
                                <div class="mn-service-actions">
                                    <a href="/demande-intervention?type=vitrerie" class="mn-btn mn-btn--primary">Intervention urgente</a>
                                </div>
                            </div>
                            <div class="mn-service-row__visual mn-service-row__visual--cyan">
                                <img src="/sinistre_services/static/src/img/glazierr.jpg" alt="Vitrerie — bris de glace" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"/>
                                <div class="mn-service-visual-fallback" style="display:none;"><i class="fa fa-th-large" aria-hidden="true"/></div>
                            </div>
                        </div>

                        <!-- ÉLECTRICITÉ -->
                        <div id="electricite" class="mn-service-row">
                            <div class="mn-service-row__content">
                                <span class="mn-eyebrow">Électricité</span>
                                <h2>Panne électrique et mise en sécurité</h2>
                                <p>Disjoncteur qui saute, panne totale, court-circuit ou prise endommagée. Électriciens Qualifelec certifiés pour diagnostiquer et rétablir votre installation en toute sécurité.</p>
                                <ul class="mn-service-list">
                                    <li><i class="fa fa-check" aria-hidden="true"/>Diagnostic et remise en service</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Mise en sécurité après sinistre</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Remplacement tableau et disjoncteur</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Artisans Qualifelec certifiés</li>
                                </ul>
                                <div class="mn-service-actions">
                                    <a href="/demande-intervention?type=electricite" class="mn-btn mn-btn--primary">Intervention urgente</a>
                                </div>
                            </div>
                            <div class="mn-service-row__visual mn-service-row__visual--yellow">
                                <img src="/sinistre_services/static/src/img/elec.jpg" alt="Électricité — panne électrique" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"/>
                                <div class="mn-service-visual-fallback" style="display:none;"><i class="fa fa-bolt" aria-hidden="true"/></div>
                            </div>
                        </div>

                        <!-- NUISIBLES -->
                        <div id="nuisibles" class="mn-service-row mn-service-row--reverse">
                            <div class="mn-service-row__content">
                                <span class="mn-eyebrow">Nuisibles</span>
                                <h2>Dératisation et désinsectisation</h2>
                                <p>Souris, rats, punaises de lit, cafards. Traitement professionnel conforme aux normes sanitaires.</p>
                                <ul class="mn-service-list">
                                    <li><i class="fa fa-check" aria-hidden="true"/>Dératisation</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Punaises de lit</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Traitement cafards et insectes</li>
                                </ul>
                                <div class="mn-service-actions">
                                    <a href="/demande-intervention?type=nuisibles" class="mn-btn mn-btn--primary">Intervention urgente</a>
                                </div>
                            </div>
                            <div class="mn-service-row__visual mn-service-row__visual--green">
                                <img src="/sinistre_services/static/src/img/pest.jpg" alt="Dératisation et désinsectisation" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"/>
                                <div class="mn-service-visual-fallback" style="display:none;"><i class="fa fa-bug" aria-hidden="true"/></div>
                            </div>
                        </div>

                        <!-- TRAVAUX -->
                        <div id="travaux" class="mn-service-row">
                            <div class="mn-service-row__content">
                                <span class="mn-eyebrow">Travaux &amp; Bricolage</span>
                                <h2>Petits travaux et montage</h2>
                                <p>Peinture, rénovation légère, montage de meubles, divers bricolage par des artisans polyvalents.</p>
                                <ul class="mn-service-list">
                                    <li><i class="fa fa-check" aria-hidden="true"/>Peinture et finitions</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Montage et assemblage</li>
                                    <li><i class="fa fa-check" aria-hidden="true"/>Petites rénovations</li>
                                </ul>
                                <div class="mn-service-actions">
                                    <a href="/demande-intervention?type=travaux" class="mn-btn mn-btn--primary">Demander un devis</a>
                                </div>
                            </div>
                            <div class="mn-service-row__visual mn-service-row__visual--orange">
                                <img src="/sinistre_services/static/src/img/paint.jpg" alt="Petits travaux et montage" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"/>
                                <div class="mn-service-visual-fallback" style="display:none;"><i class="fa fa-wrench" aria-hidden="true"/></div>
                            </div>
                        </div>

                        <!-- URGENCE 24/7 CTA -->
                        <div id="urgence" class="mn-service-cta">
                            <div class="mn-service-cta__icon"><i class="fa fa-exclamation-triangle" aria-hidden="true"/></div>
                            <div class="mn-service-cta__body">
                                <h3>Urgence 24h/24 — 7j/7</h3>
                                <p>Toute intervention urgente, de nuit, le week-end ou les jours fériés. Un artisan certifié chez vous en moins de 2&#160;heures, partout en France métropolitaine.</p>
                            </div>
                            <div class="mn-service-cta__actions">
                                <a href="tel:+33100000000" class="mn-btn mn-btn--white mn-btn--lg">
                                    <i class="fa fa-phone" aria-hidden="true"/> 01 XX XX XX XX
                                </a>
                                <a href="/demande-intervention" class="mn-btn mn-btn--lg" style="border:2px solid rgba(255,255,255,.5);color:white;background:transparent;">
                                    Formulaire en ligne
                                </a>
                            </div>
                        </div>

                    </div>
                </section>
            </div>

            <div id="oe_structure_ss_services_bottom" class="oe_structure oe_empty"/>
        </div>
    </t>
</template>