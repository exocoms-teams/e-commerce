<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ════════════════════════════════════════════════════════════
     PAGE NOS SERVICES
════════════════════════════════════════════════════════════ -->
<template id="page_nos_services" name="Sinistre Services — Nos Services">
    <t t-call="website.layout">

        <div class="mn-page-hero">
            <div class="mn-container">
                <p style="font-size:12px;margin-bottom:12px;">
                    <a href="/">Accueil</a> › Nos Services
                </p>
                <h1>Nos Services d'Intervention</h1>
                <p>Artisans qualifies disponibles 24h/24 — Intervention garantie en moins de 2h</p>
            </div>
        </div>

        <!-- ZONE DE DÉPÔT EN HAUT DE PAGE -->
        <div id="sinistre_services.oe_structure_services_top" class="oe_structure oe_empty"/>

        <div id="sinistre_services.oe_structure_services_content" class="oe_structure">
            <section class="s_text_block mn-section mn-section--gray">
                <div class="mn-container">

                    <!-- SERRURERIE -->
                    <div id="serrurerie" style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;margin-bottom:72px;padding-bottom:72px;border-bottom:1px solid #E5E7EB;">
                        <div>
                            <span class="mn-eyebrow">Serrurerie</span>
                            <h2 style="font-size:30px;font-weight:800;color:#0F172A;margin:12px 0 16px;">Ouverture de porte et serrurerie</h2>
                            <p style="font-size:15px;color:#6B7280;line-height:1.7;margin-bottom:20px;">Porte claquee, serrure forcee suite a effraction, cylindre a changer. Nos serruriers interviennent sans destruction dans 95% des cas.</p>
                            <ul style="margin-bottom:28px;display:flex;flex-direction:column;gap:8px;list-style:none;padding:0;">
                                <li style="display:flex;align-items:center;gap:8px;font-size:14px;color:#374151;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Ouverture de porte sans destruction</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:14px;color:#374151;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Remplacement de cylindre et serrure</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:14px;color:#374151;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Serrure multipoints et connectee</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:14px;color:#374151;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Securisation apres effraction</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:14px;color:#374151;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Blindage de porte</li>
                            </ul>
                            <div style="display:flex;gap:12px;flex-wrap:wrap;">
                                <a href="/demande-intervention?type=serrurerie&amp;urgence=tres_urgente" class="mn-btn mn-btn--primary"><i class="fa fa-wrench" aria-hidden="true"/> Intervention urgente</a>
                                <a href="/demande-intervention?type=serrurerie" class="mn-btn mn-btn--outline">Devis gratuit</a>
                            </div>
                        </div>
                        <div style="background:linear-gradient(135deg,#FFEBEE,#FFCDD2);border-radius:20px;min-height:280px;display:flex;align-items:center;justify-content:center;">
                              <img src="monetique_theme/static/src/img/serrure.jpg" alt="Illustration cadenas" style="width:100%;height:100%;min-height:280px;display:block;object-fit:cover;" />
                        </div>
                    </div>

                    <!-- PLOMBERIE -->
                    <div id="plomberie" style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;margin-bottom:72px;padding-bottom:72px;border-bottom:1px solid #E5E7EB;">
                        <div style="background:linear-gradient(135deg,#EFF6FF,#DBEAFE);border-radius:20px;min-height:280px;display:flex;align-items:center;justify-content:center;">
                            <img src="monetique_theme/static/src/img/plomberie.jpeg" alt="Illustration eau" style="width:100%;height:100%;min-height:280px;display:block;object-fit:cover;" />
                        </div>
                        <div>
                            <span class="mn-eyebrow">Plomberie</span>
                            <h2 style="font-size:30px;font-weight:800;color:#0F172A;margin:12px 0 16px;">Plomberie et degat des eaux</h2>
                            <p style="font-size:15px;color:#6B7280;line-height:1.7;margin-bottom:20px;">Fuite d'eau, degat des eaux, canalisation bouchee. Nos plombiers diagnostiquent et reparent pour limiter les dommages.</p>
                            <ul style="margin-bottom:28px;display:flex;flex-direction:column;gap:8px;list-style:none;padding:0;">
                                <li style="display:flex;align-items:center;gap:8px;font-size:14px;color:#374151;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Fuite sous evier, robinetterie</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:14px;color:#374151;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Degat des eaux — pompage</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:14px;color:#374151;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Chauffe-eau, ballon d'eau chaude</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:14px;color:#374151;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Recherche de fuite non destructive</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:14px;color:#374151;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Rapport pour declaration assurance</li>
                            </ul>
                            <a href="/demande-intervention?type=plomberie" class="mn-btn mn-btn--primary"><i class="fa fa-wrench" aria-hidden="true"/> Demander une intervention</a>
                        </div>
                    </div>

                    <!-- MENUISERIE -->
                    <div id="menuiserie" style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;margin-bottom:72px;padding-bottom:72px;border-bottom:1px solid #E5E7EB;">
                        <div>
                            <span class="mn-eyebrow">Menuiserie</span>
                            <h2 style="font-size:30px;font-weight:800;color:#0F172A;margin:12px 0 16px;">Menuiserie interieure et exterieure</h2>
                            <p style="font-size:15px;color:#6B7280;line-height:1.7;margin-bottom:20px;">Porte fracturee, fenetre endommagee, volet casse. Securisation immediate puis remplacement par nos menuisiers qualifies.</p>
                            <ul style="margin-bottom:28px;display:flex;flex-direction:column;gap:8px;list-style:none;padding:0;">
                                <li style="display:flex;align-items:center;gap:8px;font-size:14px;color:#374151;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Porte d'entree fracturee</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:14px;color:#374151;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Fenetre et double vitrage</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:14px;color:#374151;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Volet roulant, store</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:14px;color:#374151;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Bois, PVC, aluminium</li>
                            </ul>
                            <a href="/demande-intervention?type=menuiserie_ext" class="mn-btn mn-btn--primary"><i class="fa fa-wrench" aria-hidden="true"/> Demander une intervention</a>
                        </div>
                        <div style="background:linear-gradient(135deg,#F0FDF4,#DCFCE7);border-radius:20px;min-height:280px;display:flex;align-items:center;justify-content:center;">
                            <img src="monetique_theme/static/src/img/menuserie.jpg" alt="Illustration maison" style="width:100%;height:100%;min-height:280px;display:block;object-fit:cover;" />
                        </div>
                    </div>

                </div>
            </section>

            <!-- CTA SECTION -->
            <section class="s_call_to_action mn-cta">
                <div class="mn-container">
                    <div class="mn-cta__inner">
                        <h2>Vous etes une assurance ?</h2>
                        <p>Integrez notre API pour envoyer vos ordres de mission automatiquement.</p>
                        <div class="mn-cta__actions">
                            <a href="/assurances" class="mn-btn mn-btn--white mn-btn--lg">Decouvrir notre offre</a>
                            <a href="/contact" class="mn-btn mn-btn--lg" style="border:2px solid rgba(255,255,255,.4);color:white;">Nous contacter</a>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- ZONE DE DÉPÔT EN BAS DE PAGE -->
        <div id="sinistre_services.oe_structure_page_nos_services" class="oe_structure oe_empty"/>

    </t>
</template>

<!-- ════════════════════════════════════════════════════════════
     PAGE URGENCE
════════════════════════════════════════════════════════════ -->
<template id="page_urgence" name="Sinistre Services — Urgence">
    <t t-call="website.layout">

        <div id="sinistre_services.oe_structure_page_urgence_hero" class="oe_structure">
            <section class="s_text_block" style="background:linear-gradient(135deg,#B71C1C 0%,#C62828 100%);padding:80px 0;text-align:center;color:white;position:relative;overflow:hidden;">
                <div class="mn-container" style="position:relative;z-index:1;">
                    <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.15);padding:6px 16px;border-radius:99px;font-size:13px;font-weight:600;margin-bottom:20px;">
                        <span style="width:8px;height:8px;background:#4ADE80;border-radius:50%;display:inline-block;"/>
                        Intervenants disponibles maintenant
                    </div>
                    <h1 style="font-size:48px;font-weight:800;letter-spacing:-.025em;margin-bottom:16px;">Urgence Sinistre</h1>
                    <p style="font-size:18px;opacity:.85;margin-bottom:32px;">Appelez maintenant — un artisan chez vous en moins de 2h</p>
                    <a href="tel:+33100000000" style="display:inline-block;font-size:42px;font-weight:900;color:white;letter-spacing:-.03em;margin-bottom:32px;text-decoration:none;">01 XX XX XX XX</a>
                    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
                        <a href="/demande-intervention?urgence=tres_urgente" class="mn-btn mn-btn--white mn-btn--lg"><i class="fa fa-wrench" aria-hidden="true"/> Formulaire d'urgence</a>
                        <a href="#" class="mn-btn mn-btn--lg" style="background:rgba(255,255,255,.15);color:white;border:2px solid rgba(255,255,255,.4);" data-rappel="1"><i class="fa fa-phone" aria-hidden="true"/> Etre rappele</a>
                    </div>
                </div>
            </section>
        </div>

        <div id="sinistre_services.oe_structure_page_urgence_dropzone" class="oe_structure oe_empty"/>

        <div id="sinistre_services.oe_structure_page_urgence_content" class="oe_structure">
            <section class="s_three_columns mn-section mn-section--gray">
                <div class="mn-container">
                    <div class="mn-section__header">
                        <span class="mn-eyebrow">En cas d'urgence</span>
                        <h2>Que faire avant notre arrivee ?</h2>
                    </div>
                    <div class="mn-grid mn-grid--3">
                        <div style="background:white;border-radius:14px;padding:28px;border:1px solid #E5E7EB;">
                            <div style="font-size:36px;margin-bottom:16px;">&#128272;</div>
                            <h4 style="font-size:16px;font-weight:700;color:#0F172A;margin-bottom:10px;">Effraction / Serrure</h4>
                            <ul style="display:flex;flex-direction:column;gap:6px;list-style:none;padding:0;">
                                <li style="display:flex;align-items:center;gap:8px;font-size:13px;color:#6B7280;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Deposez une main courante a la police</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:13px;color:#6B7280;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Ne touchez pas a la zone</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:13px;color:#6B7280;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Photographiez les degats</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:13px;color:#6B7280;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Attendez notre intervenant</li>
                            </ul>
                        </div>
                        <div style="background:white;border-radius:14px;padding:28px;border:1px solid #E5E7EB;">
                            <div style="font-size:36px;margin-bottom:16px;">&#128295;</div>
                            <h4 style="font-size:16px;font-weight:700;color:#0F172A;margin-bottom:10px;">Fuite / Degat des eaux</h4>
                            <ul style="display:flex;flex-direction:column;gap:6px;list-style:none;padding:0;">
                                <li style="display:flex;align-items:center;gap:8px;font-size:13px;color:#6B7280;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Coupez l'eau au general</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:13px;color:#6B7280;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Coupez le disjoncteur</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:13px;color:#6B7280;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Eloignez vos affaires</li>
                                <li style="display:flex;align-items:center;gap:8px;font-size:13px;color:#6B7280;"><i class="fa fa-check" style="color:#C62828;" aria-hidden="true"/>Photographiez les degats</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div id="sinistre_services.oe_structure_page_urgence" class="oe_structure oe_empty"/>

    </t>
</template>

<!-- ════════════════════════════════════════════════════════════
