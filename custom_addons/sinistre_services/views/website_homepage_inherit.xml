<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ════════════════════════════════════════════════════════════
     SECTION PRIX FIXES — HOME (page_home du thème)
     Injectée en bas de la section "Nos interventions", sans
     modification du module monetique_theme.
     Style aligné sur section_prix_sinistre.html (classes ss-prix).
════════════════════════════════════════════════════════════ -->
<template id="ss_home_prix_section" inherit_id="monetique_theme.page_home">
    <xpath expr="//div[@id='oe_structure_home_after_services']" position="before">
        <section id="prix" class="mn-section ss-prix" data-snippet="s_prix" data-name="Prix fixes">
            <div class="mn-container">
                <div class="mn-section__header">
                    <span class="mn-eyebrow">Tarifs transparents</span>
                    <h2>Des prix fixes pour + de 400 interventions</h2>
                    <p>Grille tarifaire par métier — devis gratuit au 09 70 70 07 37</p>
                </div>

                <div class="ss-prix__grid">

                    <div class="ss-prix__service-card">
                        <div class="ss-prix__service-name"><span class="ss-prix__service-icon"><i class="fa fa-lock" aria-hidden="true"/></span> Serrurerie</div>
                        <ul class="ss-prix__list">
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Ouverture porte simple claquée</span><span class="ss-prix__price">110 € - 135 €</span></li>
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Clé cassée dans la serrure</span><span class="ss-prix__price">À partir de 120 €</span></li>
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Dégrippage de serrure</span><span class="ss-prix__price">100 € - 180 €</span></li>
                        </ul>
                        <div class="ss-prix__link"><a href="/prix/serrurerie">Voir tous les prix <span class="arrow">&#8594;</span></a></div>
                    </div>

                    <div class="ss-prix__service-card">
                        <div class="ss-prix__service-name"><span class="ss-prix__service-icon"><i class="fa fa-tint" aria-hidden="true"/></span> Plomberie</div>
                        <ul class="ss-prix__list">
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Débouchage de canalisation</span><span class="ss-prix__price">290 € - 390 €</span></li>
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Fuite d'eau</span><span class="ss-prix__price">149 € - 199 €</span></li>
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Débouchage de WC</span><span class="ss-prix__price">130 € - 200 €</span></li>
                        </ul>
                        <div class="ss-prix__link"><a href="/prix/plomberie">Voir tous les prix <span class="arrow">&#8594;</span></a></div>
                    </div>

                    <div class="ss-prix__service-card">
                        <div class="ss-prix__service-name"><span class="ss-prix__service-icon"><i class="fa fa-fire" aria-hidden="true"/></span> Chauffage</div>
                        <ul class="ss-prix__list">
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Réparation de chaudière</span><span class="ss-prix__price">150 € - 350 €</span></li>
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Réparation du chauffage</span><span class="ss-prix__price">200 € - 300 €</span></li>
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Entretien de chaudière</span><span class="ss-prix__price">90 € - 250 €</span></li>
                        </ul>
                        <div class="ss-prix__link"><a href="/prix/chauffage">Voir tous les prix <span class="arrow">&#8594;</span></a></div>
                    </div>

                    <div class="ss-prix__service-card">
                        <div class="ss-prix__service-name"><span class="ss-prix__service-icon"><i class="fa fa-bolt" aria-hidden="true"/></span> Électricité</div>
                        <ul class="ss-prix__list">
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Recherche de panne électrique</span><span class="ss-prix__price">110 € - 135 € TTC</span></li>
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Réparation tableau électrique</span><span class="ss-prix__price">150 € - 250 € TTC</span></li>
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Réparation de prises électriques</span><span class="ss-prix__price">110 € - 150 € TTC</span></li>
                        </ul>
                        <div class="ss-prix__link"><a href="/prix/electricite">Voir tous les prix <span class="arrow">&#8594;</span></a></div>
                    </div>

                    <div class="ss-prix__service-card">
                        <div class="ss-prix__service-name"><span class="ss-prix__service-icon"><i class="fa fa-recycle" aria-hidden="true"/></span> Assainissement</div>
                        <ul class="ss-prix__list">
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Vidange de fosse septique</span><span class="ss-prix__price">250 € - 500 € TTC</span></li>
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Entretien canalisation</span><span class="ss-prix__price">250 € - 400 € TTC</span></li>
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Pompage bac à graisse</span><span class="ss-prix__price">250 € - 500 € TTC</span></li>
                        </ul>
                        <div class="ss-prix__link"><a href="/prix/assainissement">Voir tous les prix <span class="arrow">&#8594;</span></a></div>
                    </div>

                    <div class="ss-prix__service-card">
                        <div class="ss-prix__service-name"><span class="ss-prix__service-icon"><i class="fa fa-th-large" aria-hidden="true"/></span> Vitrerie Miroiterie</div>
                        <ul class="ss-prix__list">
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Changement de vitre cassée (double vitrage)</span><span class="ss-prix__price">250 € - 500 € TTC</span></li>
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Installation d'une crémone de fenêtre</span><span class="ss-prix__price">150 € - 250 € TTC</span></li>
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Réparation de fenêtre</span><span class="ss-prix__price">120 € - 210 €</span></li>
                        </ul>
                        <div class="ss-prix__link"><a href="/prix/vitrerie">Voir tous les prix <span class="arrow">&#8594;</span></a></div>
                    </div>

                    <div class="ss-prix__service-card">
                        <div class="ss-prix__service-name"><span class="ss-prix__service-icon"><i class="fa fa-bug" aria-hidden="true"/></span> Traitement des nuisibles</div>
                        <ul class="ss-prix__list">
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Désinsectisation punaises de lit</span><span class="ss-prix__price">200 € - 400 €</span></li>
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Dératisation (souris, rats)</span><span class="ss-prix__price">200 € - 600 € TTC</span></li>
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Désinsectisation de blattes</span><span class="ss-prix__price">200 € - 600 € TTC</span></li>
                        </ul>
                        <div class="ss-prix__link"><a href="/prix/nuisibles">Voir tous les prix <span class="arrow">&#8594;</span></a></div>
                    </div>

                    <div class="ss-prix__service-card">
                        <div class="ss-prix__service-name"><span class="ss-prix__service-icon"><i class="fa fa-wrench" aria-hidden="true"/></span> Travaux et bricolage</div>
                        <ul class="ss-prix__list">
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Démontage d'un lit</span><span class="ss-prix__price">50 € - 300 € TTC</span></li>
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Peinture de plafond (classique)</span><span class="ss-prix__price">20 € - 30 € / m²</span></li>
                            <li class="ss-prix__item"><span class="ss-prix__item-name">Pose de carrelage</span><span class="ss-prix__price">30 € - 50 € / m²</span></li>
                        </ul>
                        <div class="ss-prix__link"><a href="/prix/travaux">Voir tous les prix <span class="arrow">&#8594;</span></a></div>
                    </div>

                </div>

                <div class="ss-prix__cta">
                    <a href="tel:+330970700737" class="mn-btn mn-btn--primary mn-btn--lg"><i class="fa fa-phone" aria-hidden="true"/> 09 70 70 07 37 — Devis gratuit</a>
                </div>
            </div>
        </section>
    </xpath>
</template>

</odoo>
