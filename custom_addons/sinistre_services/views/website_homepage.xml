<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <record id="ss_homepage" model="ir.ui.view">
        <field name="name">Sinistre Services — Accueil</field>
        <field name="type">qweb</field>
        <field name="key">sinistre_services.ss_homepage</field>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <t t-name="sinistre_services.ss_homepage">
                <t t-call="website.layout">

                    <!-- 1. ZONE ÉDITABLE TOPBAR -->
                    <div id="sinistre_services.oe_structure_home_topbar" class="oe_structure">
                        <!-- ── TOPBAR URGENCE ── -->
                        <section class="s_text_block o_colored_level" data-name="Topbar Urgence" style="background:#C62828;color:white;padding:8px 24px;">
                            <div style="display:flex;align-items:center;justify-content:space-between;font-size:13px;font-family:'Inter',sans-serif;">
                                <div style="display:flex;align-items:center;gap:24px;">
                                    <span><i class="fa fa-phone" style="margin-right:6px;" aria-hidden="true"/><a href="tel:+33100000000" style="color:white;text-decoration:none;font-weight:600;">01 XX XX XX XX</a> — Urgence 24/7</span>
                                    <span class="d-none d-md-inline"><i class="fa fa-envelope" style="margin-right:6px;" aria-hidden="true"/><a href="mailto:contact@sinistre-services.fr" style="color:white;text-decoration:none;">contact@sinistre-services.fr</a></span>
                                </div>
                                <a href="/urgence" style="background:rgba(0,0,0,0.25);color:white;text-decoration:none;padding:4px 14px;border-radius:99px;font-size:12px;font-weight:700;">
                                    <i class="fa fa-exclamation-triangle" style="margin-right:4px;" aria-hidden="true"/>Urgence 24h/24
                                </a>
                            </div>
                        </section>
                    </div>

                    <!-- 2. ZONE HERO ISOLÉE (Empêche le blocage des autres catégories) -->
                    <div id="sinistre_services.oe_structure_home_hero" class="oe_structure">
                        <!-- ── HERO ── -->
                        <section class="s_text_image mn-hero o_colored_level" data-name="Hero Accueil" style="padding:80px 0 60px;background:linear-gradient(135deg,#EFF6FF 0%,#F0F4FF 40%,#F8FAFF 100%);position:relative;overflow:hidden;">
                            <div class="mn-container">
                                <div style="display:grid;grid-template-columns:1fr 420px;gap:60px;align-items:center;">
                                    <div>
                                        <div class="mn-hero__badge">
                                            <span class="mn-dot"/>
                                            Plateforme agreee assurances · Artisans certifies
                                        </div>
                                        <h1 class="mn-hero__title">
                                            Intervention rapide
                                            <span class="mn-hero__accent" style="background:linear-gradient(135deg,#C62828 0%,#E53935 60%,#EF5350 100%);-webkit-background-clip:text;background-clip:text;">pour vos sinistres</span>
                                        </h1>
                                        <p class="mn-hero__desc">
                                            Serruriers, plombiers, menuisiers disponibles <strong>24h/24 — 7j/7</strong> partout en France. Intervention en moins de 2h, devis gratuit.
                                        </p>
                                        <div class="mn-hero__actions">
                                            <a href="/demande-intervention" class="mn-btn mn-btn--primary mn-btn--lg" style="background:#C62828;border-color:#C62828;">
                                                <i class="fa fa-wrench" aria-hidden="true"/> Demander une intervention
                                            </a>
                                            <a href="tel:+33100000000" class="mn-btn mn-btn--outline mn-btn--lg">
                                                <i class="fa fa-phone" aria-hidden="true"/> 01 XX XX XX XX
                                            </a>
                                        </div>
                                        <div class="mn-hero__trust">
                                            <span>&#10003; Intervention en 2h</span>
                                            <span>&#10003; Devis gratuit</span>
                                            <span>&#10003; Artisans certifies</span>
                                            <span>&#10003; 24h/24 7j/7</span>
                                        </div>
                                    </div>

                                    <!-- Formulaire demande rapide converti au standard Odoo Form-Builder -->
                                    <div style="background:white;border-radius:20px;padding:32px;box-shadow:0 12px 48px rgba(0,0,0,0.12);border:1px solid rgba(198,40,40,0.1);">
                                        <h3 style="font-size:20px;font-weight:700;color:#0F172A;margin-bottom:4px;font-family:'Inter',sans-serif;">Demande rapide</h3>
                                        <p style="font-size:13px;color:#6B7280;margin-bottom:24px;">Reponse sous 15 minutes</p>
                                        
                                        <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="crm.lead">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <div style="margin-bottom:14px;">
                                                <label style="display:block;font-size:11px;font-weight:600;color:#374151;margin-bottom:5px;text-transform:uppercase;letter-spacing:.5px;">Type d'intervention</label>
                                                <select name="name" style="width:100%;padding:11px 14px;border:1.5px solid #E5E7EB;border-radius:10px;font-size:14px;color:#111827;background:white;box-sizing:border-box;font-family:'Inter',sans-serif;">
                                                    <option value="Serrurerie">Serrurerie</option>
                                                    <option value="Plomberie">Plomberie</option>
                                                    <option value="Menuiserie">Menuiserie</option>
                                                    <option value="Vitrerie">Vitrerie</option>
                                                    <option value="Electricite">Electricite</option>
                                                    <option value="Autre">Autre</option>
                                                </select>
                                            </div>
                                            <div style="margin-bottom:14px;">
                                                <label style="display:block;font-size:11px;font-weight:600;color:#374151;margin-bottom:5px;text-transform:uppercase;letter-spacing:.5px;">Telephone</label>
                                                <input type="tel" name="phone" required="true" placeholder="06 XX XX XX XX" style="width:100%;padding:11px 14px;border:1.5px solid #E5E7EB;border-radius:10px;font-size:14px;box-sizing:border-box;font-family:'Inter',sans-serif;"/>
                                            </div>
                                            <div style="margin-bottom:20px;">
                                                <label style="display:block;font-size:11px;font-weight:600;color:#374151;margin-bottom:5px;text-transform:uppercase;letter-spacing:.5px;">Code postal</label>
                                                <input type="text" name="street2" placeholder="75001" style="width:100%;padding:11px 14px;border:1.5px solid #E5E7EB;border-radius:10px;font-size:14px;box-sizing:border-box;font-family:'Inter',sans-serif;"/>
                                            </div>
                                            <button type="submit" class="mn-btn mn-btn--primary" style="width:100%;justify-content:center;background:#C62828;border-color:#C62828;padding:14px;font-size:15px;border:none;color:white;font-weight:600;border-radius:10px;">
                                                Trouver un artisan
                                            </button>
                                            <p style="text-align:center;font-size:11px;color:#9CA3AF;margin-top:10px;">Sans engagement · Devis gratuit</p>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>

                    <!-- POINT DE DÉPÔT CRUCIAL 1 (Débloque Catalog, Appointments, etc.) -->
                    <div id="sinistre_services.oe_structure_home_dropzone_1" class="oe_structure oe_empty"/>

                    <!-- 3. ZONE STATS ISOLÉE -->
                    <div id="sinistre_services.oe_structure_home_stats" class="oe_structure">
                        <!-- ── STATS ── -->
                        <section class="s_numbers mn-stats o_colored_level" data-name="Statistiques">
                            <div class="mn-container">
                                <div class="mn-stats__grid">
                                    <div class="mn-stat">
                                        <span class="mn-stat__number">+15 000</span>
                                        <span class="mn-stat__label">Demandes par mois</span>
                                    </div>
                                    <div class="mn-stat">
                                        <span class="mn-stat__number">+1 700</span>
                                        <span class="mn-stat__label">Artisans certifies</span>
                                    </div>
                                    <div class="mn-stat">
                                        <span class="mn-stat__number">2h</span>
                                        <span class="mn-stat__label">Delai moyen</span>
                                    </div>
                                    <div class="mn-stat">
                                        <span class="mn-stat__number">98%</span>
                                        <span class="mn-stat__label">Clients satisfaits</span>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>

                    <!-- POINT DE DÉPÔT CRUCIAL 2 -->
                    <div id="sinistre_services.oe_structure_home_dropzone_2" class="oe_structure oe_empty"/>

                    <!-- 4. ZONE SERVICES ISOLÉE -->
                    <div id="sinistre_services.oe_structure_home_services" class="oe_structure">
                        <!-- ── SERVICES ── -->
                        <section class="s_three_columns mn-section o_colored_level" data-name="Services" style="background:#F9FAFB;">
                            <div class="mn-container">
                                <div class="mn-section__header">
                                    <span class="mn-eyebrow">Nos interventions</span>
                                    <h2>Tous types de sinistres pris en charge</h2>
                                    <p>Artisans qualifies disponibles 24h/24 — Intervention en moins de 2h</p>
                                </div>
                                <div class="mn-grid mn-grid--3">
                                    <a href="/demande-intervention" class="mn-card--solution o_colored_level" data-name="Carte Serrurerie">
                                        <div class="mn-card__icon">
                                            <i class="fa fa-lock" style="font-size:22px;" aria-hidden="true"/>
                                        </div>
                                        <h3>Serrurerie</h3>
                                        <p>Porte claquee, serrure forcee, cylindre a remplacer. Intervention sous 45 minutes.</p>
                                        <span class="mn-card__arrow">&#8594;</span>
                                    </a>
                                    <a href="/demande-intervention" class="mn-card--solution o_colored_level" data-name="Carte Plomberie">
                                        <div class="mn-card__icon">
                                            <i class="fa fa-tint" style="font-size:22px;" aria-hidden="true"/>
                                        </div>
                                        <h3>Plomberie</h3>
                                        <p>Fuite d'eau, degat des eaux, canalisation bouchee. Plombiers disponibles 24h/24.</p>
                                        <span class="mn-card__arrow">&#8594;</span>
                                    </a>
                                    <a href="/demande-intervention" class="mn-card--solution o_colored_level" data-name="Carte Menuiserie">
                                        <div class="mn-card__icon">
                                            <i class="fa fa-home" style="font-size:22px;" aria-hidden="true"/>
                                        </div>
                                        <h3>Menuiserie</h3>
                                        <p>Porte fracturee, fenetre endommagee, volet casse. Reparation urgente ou remplacement.</p>
                                        <span class="mn-card__arrow">&#8594;</span>
                                    </a>
                                    <a href="/demande-intervention" class="mn-card--solution o_colored_level" data-name="Carte Vitrerie">
                                        <div class="mn-card__icon">
                                            <i class="fa fa-th-large" style="font-size:22px;" aria-hidden="true"/>
                                        </div>
                                        <h3>Vitrerie</h3>
                                        <p>Bris de glace, fenetre cassee, double vitrage. Bache provisoire disponible dans l'heure.</p>
                                        <span class="mn-card__arrow">&#8594;</span>
                                    </a>
                                    <a href="/demande-intervention" class="mn-card--solution o_colored_level" data-name="Carte Electricite">
                                        <div class="mn-card__icon">
                                            <i class="fa fa-bolt" style="font-size:22px;" aria-hidden="true"/>
                                        </div>
                                        <h3>Electricite</h3>
                                        <p>Panne electrique, disjoncteur, court-circuit. Electriciens Qualifelec disponibles.</p>
                                        <span class="mn-card__arrow">&#8594;</span>
                                    </a>
                                    <a href="/demande-intervention" class="mn-card--solution mn-card--featured o_colored_level" data-name="Carte Urgence Service">
                                        <div class="mn-card__icon" style="background:linear-gradient(135deg,#FFEBEE,#FFCDD2);color:#C62828;">
                                            <i class="fa fa-exclamation-triangle" style="font-size:22px;" aria-hidden="true"/>
                                        </div>
                                        <h3>Urgence 24h/24</h3>
                                        <p>Toute intervention urgente, nuit et weekend. Un artisan chez vous en moins de 2h garantis.</p>
                                        <span class="mn-card__arrow" style="color:#C62828;">&#8594;</span>
                                    </a>
                                </div>
                            </div>
                        </section>
                    </div>

                    <!-- 4bis. ZONE PRIX FIXES ISOLÉE (en bas de "Nos interventions") -->
                    <div id="sinistre_services.oe_structure_home_prix" class="oe_structure">
                        <!-- ── PRIX FIXES ── -->
                        <section id="prix" class="s_text_block mn-section mn-price o_colored_level" data-name="Prix fixes">
                            <div class="mn-container">
                                <div class="mn-section__header">
                                    <span class="mn-eyebrow">Tarifs transparents</span>
                                    <h2>Des prix fixes pour + de 400 interventions</h2>
                                    <p>Grille tarifaire par metier — devis gratuit au 09 70 70 07 37</p>
                                </div>
                                <div class="mn-price-grid">
                                    <t t-foreach="prix_metiers" t-as="m">
                                        <t t-call="sinistre_services.ss_prix_card"/>
                                    </t>
                                </div>
                                <div class="mn-price-cta">
                                    <a href="tel:+330970700737" class="mn-btn mn-btn--outline mn-btn--lg">
                                        <i class="fa fa-phone" aria-hidden="true"/> 09 70 70 07 37
                                    </a>
                                </div>
                            </div>
                        </section>
                    </div>

                    <!-- 5. ZONE PROCESSUS ISOLÉE -->
                    <div id="sinistre_services.oe_structure_home_process" class="oe_structure">
                        <!-- ── COMMENT CA MARCHE ── -->
                        <section class="s_text_block mn-section o_colored_level" data-name="Comment ca marche">
                            <div class="mn-container">
                                <div class="mn-section__header">
                                    <span class="mn-eyebrow">Simple et rapide</span>
                                    <h2>Comment ca marche ?</h2>
                                    <p>3 etapes pour resoudre votre sinistre rapidement</p>
                                </div>
                                <div class="mn-grid mn-grid--3">
                                    <section class="o_colored_level" data-name="Etape 1 Accueil" style="text-align:center;padding:20px;">
                                        <div style="width:72px;height:72px;background:linear-gradient(135deg,#1E3A8A,#1E40AF);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-size:28px;font-weight:800;color:white;font-family:'Inter',sans-serif;box-shadow:0 8px 32px rgba(30,64,175,0.25);">1</div>
                                        <h3 style="font-size:18px;font-weight:700;color:#0F172A;margin-bottom:10px;">Decrivez votre probleme</h3>
                                        <p style="color:#6B7280;font-size:15px;line-height:1.7;">En ligne ou par telephone, decrivez votre sinistre en 2 minutes. Disponible 24h/24.</p>
                                    </section>
                                    <section class="o_colored_level" data-name="Etape 2 Accueil" style="text-align:center;padding:20px;">
                                        <div style="width:72px;height:72px;background:linear-gradient(135deg,#1E3A8A,#1E40AF);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-size:28px;font-weight:800;color:white;font-family:'Inter',sans-serif;box-shadow:0 8px 32px rgba(30,64,175,0.25);">2</div>
                                        <h3 style="font-size:18px;font-weight:700;color:#0F172A;margin-bottom:10px;">Recevez un devis gratuit</h3>
                                        <p style="color:#6B7280;font-size:15px;line-height:1.7;">Fourchette tarifaire fixe, sans frais caches. Reservez en ligne, payez apres l'intervention.</p>
                                    </section>
                                    <section class="o_colored_level" data-name="Etape 3 Accueil" style="text-align:center;padding:20px;">
                                        <div style="width:72px;height:72px;background:linear-gradient(135deg,#B71C1C,#C62828);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;font-size:28px;font-weight:800;color:white;font-family:'Inter',sans-serif;box-shadow:0 8px 32px rgba(198,40,40,0.25);">3</div>
                                        <h3 style="font-size:18px;font-weight:700;color:#0F172A;margin-bottom:10px;">Un artisan intervient</h3>
                                        <p style="color:#6B7280;font-size:15px;line-height:1.7;">Artisan certifie chez vous en moins de 2h. Photos avant/apres garanties pour votre assurance.</p>
                                    </section>
                                </div>
                            </div>
                        </section>
                    </div>

                    <!-- 6. ZONE CTA ISOLÉE -->
                    <div id="sinistre_services.oe_structure_home_cta" class="oe_structure">
                        <!-- ── CTA URGENCE ── -->
                        <section class="s_call_to_action mn-cta o_colored_level" data-name="CTA Urgence Accueil" style="background:linear-gradient(135deg,#B71C1C 0%,#C62828 50%,#D32F2F 100%);">
                            <div class="mn-container">
                                <div class="mn-cta__inner">
                                    <h2>Urgence sinistre ?</h2>
                                    <p>Appelez-nous maintenant — un artisan chez vous en moins de 2h</p>
                                    <div class="mn-cta__actions">
                                        <a href="tel:+33100000000" class="mn-btn mn-btn--white mn-btn--lg">
                                            <i class="fa fa-phone" aria-hidden="true"/> 01 XX XX XX XX
                                        </a>
                                        <a href="/demande-intervention" class="mn-btn mn-btn--lg" style="background:rgba(255,255,255,0.15);color:white;border-color:rgba(255,255,255,0.4);">
                                            <i class="fa fa-wrench" aria-hidden="true"/> Formulaire en ligne
                                        </a>
                                    </div>
                                    <p style="margin-top:16px;font-size:13px;opacity:.7;">Disponible 24h/24 — 7j/7 — Prix d'un appel local</p>
                                </div>
                            </div>
                        </section>
                    </div>

                    <!-- Point de dépôt terminal libre -->
                    <div id="sinistre_services.oe_structure_homepage_bottom" class="oe_structure oe_empty"/>

                </t>
            </t>
        </field>
    </record>

    <record id="ss_homepage_page" model="website.page">
        <field name="name">Sinistre Services — Accueil</field>
        <field name="url">/</field>
        <field name="view_id" ref="ss_homepage"/>
        <field name="website_published">True</field>
    </record>

</data>
</odoo>