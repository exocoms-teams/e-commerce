<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_sinistre_user" model="res.groups">
            <field name="name">Sinistre / Utilisateur</field>
        </record>

        <record id="group_sinistre_gestionnaire" model="res.groups">
            <field name="name">Sinistre / Gestionnaire</field>
            <field name="implied_ids" eval="[(4, ref('group_sinistre_user'))]"/>
        </record>

        <record id="group_sinistre_admin" model="res.groups">
            <field name="name">Sinistre / Administrateur</field>
            <field name="implied_ids" eval="[(4, ref('group_sinistre_gestionnaire'))]"/>
        </record>

        <record id="group_sinistre_intervenant" model="res.groups">
            <field name="name">Sinistre / Intervenant</field>
        </record>

    </data>
</odoo>
