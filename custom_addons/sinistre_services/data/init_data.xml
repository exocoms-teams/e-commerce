<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Groupe admin pour l'utilisateur Administrator ── -->
        <record id="admin_sinistre_group" model="res.users">
            <field name="id">2</field>
        </record>

        <!-- ── Séquence missions ── -->
        <record id="seq_sinistre_mission" model="ir.sequence">
            <field name="name">Séquence Mission Sinistre</field>
            <field name="code">sinistre.mission</field>
            <field name="prefix">MSN-%(year)s-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    </data>
</odoo>
