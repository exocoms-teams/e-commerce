                                    <span class="mq-sol-link">En savoir plus <i
                                            class="fa fa-arrow-right"></i></span>
                                </div>
                            </a>
                            <a href="/shop" class="mq-sol-card" id="mobile">
                                <div class="mq-sol-img">
                                    <!-- INSTRUCTION : <img
                                    src="/monetique_theme/static/src/img/sol-mobile.jpg"
                                    alt="Mobile"/> -->
                                    <div class="mq-sol-img-placeholder">
                                        <i class="fa fa-mobile"></i>
                                        <span>Image mobile</span>
                                    </div>
                                </div>
                                <div class="mq-sol-body">
                                    <h3 class="mq-sol-title">Paiement mobile</h3>
                                    <p class="mq-sol-p">Acceptez les paiements partout avec nos
                                        solutions mobiles.</p>
                                    <span class="mq-sol-link">En savoir plus <i
                                            class="fa fa-arrow-right"></i></span>
                                </div>
                            </a>
                            <a href="/shop" class="mq-sol-card" id="en-ligne">
                                <div class="mq-sol-img">
                                    <!-- INSTRUCTION : <img
                                    src="/monetique_theme/static/src/img/sol-enligne.jpg" alt="En
                                    ligne"/> -->
                                    <div class="mq-sol-img-placeholder">
                                        <i class="fa fa-shopping-cart"></i>
                                        <span>Image en ligne</span>
                                    </div>
                                </div>
                                <div class="mq-sol-body">
                                    <h3 class="mq-sol-title">Paiement en ligne</h3>
                                    <p class="mq-sol-p">Solutions e-commerce sécurisées pour vos
                                        ventes en ligne.</p>
                                    <span class="mq-sol-link">En savoir plus <i
                                            class="fa fa-arrow-right"></i></span>
                                </div>
                            </a>
                            <a href="/contact" class="mq-sol-card" id="support">
                                <div class="mq-sol-img">
                                    <!-- INSTRUCTION : <img
                                    src="/monetique_theme/static/src/img/sol-support.jpg"
                                    alt="Support"/> -->
                                    <div class="mq-sol-img-placeholder">
                                        <i class="fa fa-headphones"></i>
                                        <span>Image support</span>
                                    </div>
                                </div>
                                <div class="mq-sol-body">
                                    <h3 class="mq-sol-title">Services &amp; support</h3>
                                    <p class="mq-sol-p">Un service client dédié et un accompagnement
                                        sur-mesure.</p>
                                    <span class="mq-sol-link">En savoir plus <i
                                            class="fa fa-arrow-right" /></span>
                                </div>
                            </a>
                        </div>
                    </div>
                </section>

                <div class="mq-cta-band">
                    <div class="mq-container">
                        <div>
                            <h3>Besoin d'un conseil ?</h3>
                            <p>Nos experts vous accompagnent dans votre projet.</p>
                        </div>
                        <a href="#" class="mq-btn-white" data-rappel-trigger="1">Être rappelé</a>
                    </div>
                </div>
            </t>
        </template>

        <!-- ============================================================
         PAGE À PROPOS
    ============================================================ -->

        <template id="page_a_propos" name="À propos" page="True">
            <t t-call="website.layout">
                <div class="mq-page-hero">
                    <div class="mq-container">
                        <div class="mq-breadcrumb"><a href="/">Accueil</a> &gt; À propos</div>
                        <h1 class="mq-page-title">À propos de Monétiques</h1>
                        <p class="mq-page-subtitle">Depuis plus de 15 ans, Monétiques accompagne les
                            professionnels</p>
                    </div>
                </div>

                <section class="mq-about-body">
                    <div class="mq-container">
                        <div class="mq-about-grid">
                            <div class="mq-about-text" id="mission">
                                <h2>Notre mission</h2>
                                <p>
                                    Simplifier les paiements pour permettre aux commerçants de se
                                    concentrer
                                    sur ce qui compte vraiment : leur activité.
                                </p>
                                <p>
                                    Monétiques est un acteur français spécialisé dans les solutions
                                    de paiement
                                    pour les professionnels. Nous proposons une gamme complète de
                                    terminaux de
                                    paiement, de solutions mobiles et de services en ligne adaptés à
                                    tous les
                                    secteurs d'activité.
                                </p>
                                <p>
                                    Fort de plus de 15 années d'expérience dans le secteur
                                    monétique, notre
                                    équipe d'experts vous accompagne à chaque étape : conseil,
                                    installation,
                                    configuration et support technique 7j/7.
                                </p>
                            </div>

                            <div class="mq-about-visual">
                                <!--
                                INSTRUCTION : Remplacez par votre photo d'équipe ou de bureau.
                                <img src="/monetique_theme/static/src/img/about-team.jpg" alt="Notre équipe"
                                     style="width:100%;border-radius:12px"/>
                            -->
                                <div class="mq-about-img-placeholder">
                                    <i class="fa fa-building"></i>
                                    <span>Photo équipe / bureau</span>
                                </div>

                                <div class="mq-about-kf-card">
                                    <p class="mq-about-kf-title">Chiffres clés</p>
                                    <div class="mq-kf-grid">
                                        <div class="mq-kf-item">
                                            <span class="mq-kf-number">+10 000</span>
                                            <span class="mq-kf-label">Commerçants équipés</span>
                                        </div>
                                        <div class="mq-kf-item">
                                            <span class="mq-kf-number">+15</span>
                                            <span class="mq-kf-label">Ans d'expérience</span>
                                        </div>
                                        <div class="mq-kf-item">
                                            <span class="mq-kf-number">98%</span>
                                            <span class="mq-kf-label">Clients satisfaits</span>
                                        </div>
                                        <div class="mq-kf-item">
                                            <span class="mq-kf-number">7j/7</span>
                                            <span class="mq-kf-label">Support disponible</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="mq-garanties-section">
                    <div class="mq-container">
                        <div class="mq-section-head">
                            <span class="mq-section-tag">Nos engagements</span>
                            <h2 class="mq-section-title">Pourquoi choisir Monétiques ?</h2>
                            <div class="mq-section-underline"></div>
                        </div>
                        <div class="mq-garanties-grid">
                            <div class="mq-garantie-card">
                                <div class="mq-garantie-icon">
                                    <i class="fa fa-certificate"></i>
                                </div>
                                <h4 class="mq-garantie-title">Expertise reconnue</h4>
                                <p class="mq-garantie-p">15 ans de savoir-faire dans les solutions
                                    de paiement pour professionnels.</p>
                            </div>
                            <div class="mq-garantie-card">
                                <div class="mq-garantie-icon">
                                    <i class="fa fa-shield"></i>
                                </div>
                                <h4 class="mq-garantie-title">Sécurité maximale</h4>
                                <p class="mq-garantie-p">Tous nos terminaux sont certifiés PCI-DSS
                                    et conformes aux normes en vigueur.</p>
                            </div>
                            <div class="mq-garantie-card">
                                <div class="mq-garantie-icon">
                                    <i class="fa fa-truck"></i>
                                </div>
                                <h4 class="mq-garantie-title">Livraison rapide</h4>
                                <p class="mq-garantie-p">Expédition sous 24h, livraison et
                                    installation en 48h partout en France.</p>
                            </div>
                            <div class="mq-garantie-card">
                                <div class="mq-garantie-icon">
                                    <i class="fa fa-headphones"></i>
                                </div>
                                <h4 class="mq-garantie-title">SAV professionnel</h4>
                                <p class="mq-garantie-p">Une équipe technique disponible 7j/7 pour
                                    vous accompagner après l'achat.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="mq-cta-band">
                    <div class="mq-container">
                        <div>
                            <h3>Vous avez un projet ?</h3>
                            <p>Contactez notre équipe pour un devis personnalisé.</p>
                        </div>
                        <a href="/contact" class="mq-btn-white">Nous contacter</a>
                    </div>
                </div>
            </t>
        </template>

        <!-- ============================================================
         PAGE CONTACT
    ============================================================ -->

        <template id="page_contact" name="Contact" page="True">
            <t t-call="website.layout">
                <div class="mq-page-hero">
                    <div class="mq-container">
                        <div class="mq-breadcrumb"><a href="/">Accueil</a> &gt; Contact</div>
                        <h1 class="mq-page-title">Contactez-nous</h1>
                        <p class="mq-page-subtitle">Notre équipe vous répond rapidement</p>
                    </div>
                </div>

                <section class="mq-contact-body">
                    <div class="mq-container">
                        <t t-if="error">
                            <div class="mq-form-alert mq-form-alert-error"
                                style="margin-bottom:24px">
                                Veuillez remplir tous les champs obligatoires (nom, email, message).
                            </div>
                        </t>

                        <div class="mq-contact-grid">
                            <!-- FORMULAIRE -->
                            <div class="mq-form-card">
                                <h2>Envoyez-nous un message</h2>
                                <p class="mq-form-sub">
                                    Remplissez le formulaire, nous vous répondons sous 24h ouvrées.
                                </p>
                                <form method="POST" action="/contact/send">
                                    <input type="hidden" name="csrf_token"
                                        t-att-value="request.csrf_token()" />

                                    <div class="mq-form-row-2">
                                        <div class="mq-form-group">
                                            <label>Nom <span class="required">*</span></label>
                                            <input type="text" name="name" required="required"
                                                placeholder="Votre nom complet"
                                                t-att-value="form_data.get('name','') if form_data else ''" />
                                        </div>
                                        <div class="mq-form-group">
                                            <label>Email <span class="required">*</span></label>
                                            <input type="email" name="email" required="required"
                                                placeholder="votre@email.fr"
                                                t-att-value="form_data.get('email','') if form_data else ''" />
                                        </div>
                                    </div>

                                    <div class="mq-form-row-2">
                                        <div class="mq-form-group">
                                            <label>Téléphone</label>
                                            <input type="tel" name="phone"
                                                placeholder="01 84 80 02 22"
                                                t-att-value="form_data.get('phone','') if form_data else ''" />
                                        </div>
                                        <div class="mq-form-group">
                                            <label>Sujet</label>
                                            <input type="text" name="sujet"
                                                placeholder="Demande d'information…"
                                                t-att-value="form_data.get('sujet','') if form_data else ''" />
                                        </div>
                                    </div>

                                    <div class="mq-form-group">
                                        <label>Message <span class="required">*</span></label>
                                        <textarea name="message" required="required" rows="6"
                                            placeholder="Décrivez votre besoin…">
                                            <t
                                                t-esc="form_data.get('message','') if form_data else ''"></t>
                                        </textarea>
                                    </div>

                                    <div class="mq-form-submit">
                                        <button type="submit" class="mq-btn-primary">
                                            <i class="fa fa-paper-plane"></i> Envoyer </button>
                                    </div>
                                </form>
                            </div>

                            <!-- SIDEBAR INFOS -->
                            <div class="mq-contact-sidebar">
                                <div class="mq-contact-info-card">
                                    <h3>Nos coordonnées</h3>
                                    <div class="mq-contact-detail">
                                        <div class="mq-contact-detail-icon">
                                            <i class="fa fa-phone"></i>
                                        </div>
                                        <div>
                                            <span class="mq-contact-detail-label">Téléphone</span>
                                            <a href="tel:+33184800222" class="mq-contact-detail-val">
                                                01 84 80 02 22
                                            </a>
                                        </div>
                                    </div>
                                    <div class="mq-contact-detail">
                                        <div class="mq-contact-detail-icon">
                                            <i class="fa fa-envelope"></i>
                                        </div>
                                        <div>
                                            <span class="mq-contact-detail-label">Email</span>
                                            <a href="mailto:contact@monetiques.fr"
                                                class="mq-contact-detail-val">
                                                contact@monetiques.fr
                                            </a>
                                        </div>
                                    </div>
                                    <div class="mq-contact-detail">
                                        <div class="mq-contact-detail-icon">
                                            <i class="fa fa-map-marker"></i>
                                        </div>
                                        <div>
                                            <span class="mq-contact-detail-label">Notre bureau</span>
                                            <span class="mq-contact-detail-val"> 12 rue de la Paix<br />75002
                                                Paris </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="mq-contact-info-card">
                                    <h3>Horaires d'assistance</h3>
                                    <div class="mq-horaires">
                                        <div class="mq-horaire-row">
                                            <span class="mq-horaire-day">Lun – Ven</span>
                                            <span class="mq-horaire-time">9h – 18h</span>
                                        </div>
                                        <div class="mq-horaire-row">
                                            <span class="mq-horaire-day">Samedi</span>
                                            <span class="mq-horaire-time">9h – 12h</span>
                                        </div>
                                        <div class="mq-horaire-row">
                                            <span class="mq-horaire-day">Dimanche</span>
                                            <span class="mq-horaire-time">Fermé</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="mq-rappel-card">
                                    <h3>Préférez-vous être rappelé ?</h3>
                                    <p>Laissez votre numéro, nous vous appelons sous 1h ouvrée.</p>
                                    <div class="mq-rappel-input-row">
                                        <input type="tel" placeholder="Votre numéro…" />
                                        <button class="mq-btn-primary" data-rappel-trigger="1"
                                            style="padding:10px 16px;white-space:nowrap">
                                            OK
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </template>

        <!-- ============================================================
         PAGE CONTACT SUCCESS
    ============================================================ -->

        <template id="page_contact_success" name="Contact envoyé" page="True">
            <t t-call="website.layout">
                <section class="mq-success-section">
                    <div class="mq-container">
                        <div class="mq-success-icon">
                            <i class="fa fa-check"></i>
                        </div>
                        <h1
                            style="font-family:'Poppins',sans-serif;font-size:32px;font-weight:700;color:#1A1A2E;margin-bottom:12px">
                            Message envoyé !
                        </h1>
                        <p style="font-size:16px;color:#888;max-width:480px;margin:0 auto 32px">
                            Merci pour votre message. Notre équipe vous répond sous 24h ouvrées.
                        </p>
                        <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
                            <a href="/" class="mq-btn-primary">Retour à l'accueil</a>
                            <a href="/shop" class="mq-btn-secondary">Voir la boutique</a>
                        </div>
                    </div>
                </section>
            </t>
        </template>
</odoo>