<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="auto_booking_portal_rule" model="ir.rule">
        <field name="name">Bookings: portal own records only</field>
        <field name="model_id" ref="model_auto_booking"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="auto_test_drive_portal_rule" model="ir.rule">
        <field name="name">Test drives: portal own records only</field>
        <field name="model_id" ref="model_auto_test_drive"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
