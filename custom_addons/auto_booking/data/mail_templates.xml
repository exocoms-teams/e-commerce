<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_booking_received" model="mail.template">
        <field name="name">Confirmation de réservation véhicule</field>
        <field name="model_id" ref="model_auto_booking"/>
        <field name="subject">Demande de réservation reçue: ${object.vehicle_id.display_name}</field>
        <field name="email_from">${(user.email_formatted or 'noreply@example.com')|safe}</field>
        <field name="email_to">${object.email|safe}</field>
        <field name="body_html" type="html">
            <div>
                <p>Bonjour ${object.partner_id.name},</p>
                <p>Votre demande de réservation a bien été reçue pour <strong>${object.vehicle_id.display_name}</strong>.</p>
                <p>Date demandée: <strong>${object.requested_datetime}</strong></p>
                <p>Référence: <strong>${object.name}</strong></p>
            </div>
        </field>
    </record>

    <record id="mail_template_test_drive_received" model="mail.template">
        <field name="name">Confirmation de demande d'essai</field>
        <field name="model_id" ref="model_auto_test_drive"/>
        <field name="subject">Demande d'essai reçue: ${object.vehicle_id.display_name}</field>
        <field name="email_from">${(user.email_formatted or 'noreply@example.com')|safe}</field>
        <field name="email_to">${object.email|safe}</field>
        <field name="body_html" type="html">
            <div>
                <p>Bonjour ${object.partner_id.name},</p>
                <p>Votre demande d'essai a bien été reçue pour <strong>${object.vehicle_id.display_name}</strong>.</p>
                <p>Date demandée: <strong>${object.requested_datetime}</strong></p>
                <p>Référence: <strong>${object.name}</strong></p>
            </div>
        </field>
    </record>
</odoo>
