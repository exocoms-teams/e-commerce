<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_auto_booking" model="ir.sequence">
        <field name="name">Vehicle Booking</field>
        <field name="code">auto.booking</field>
        <field name="prefix">BOOK/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_auto_test_drive" model="ir.sequence">
        <field name="name">Test Drive Request</field>
        <field name="code">auto.test.drive</field>
        <field name="prefix">TEST/%(year)s/</field>
        <field name="padding">4</field>
    </record>
</odoo>
