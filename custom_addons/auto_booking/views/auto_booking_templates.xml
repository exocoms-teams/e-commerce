<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="booking_form_page" name="Vehicle Reservation Form">
        <t t-call="website.layout">
            <section class="py-5 auto-form-shell">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <h1 class="h3 mb-3">Reserver ce vehicule</h1>
                            <p class="text-muted">Vehicule: <strong t-esc="vehicle.display_name"/></p>
                            <div t-if="error" class="alert alert-danger" t-esc="error"/>
                            <form method="post" t-att-action="'/cars/%s/book' % vehicle.id" class="card auto-form-card p-4 border-0 shadow-sm">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Nom complet</label>
                                        <input class="form-control" type="text" name="name" required="required" t-att-value="post.get('name', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Email</label>
                                        <input class="form-control" type="email" name="email" required="required" t-att-value="post.get('email', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Telephone</label>
                                        <input class="form-control" type="text" name="phone" t-att-value="post.get('phone', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Choisir un creneau disponible</label>
                                        <select class="form-select" name="slot_id">
                                            <option value="">Aucun creneau selectionne</option>
                                            <t t-foreach="slots" t-as="slot">
                                                <option t-att-value="slot.id"><t t-esc="slot.name"/></option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Ou demander une autre date/heure</label>
                                        <input class="form-control" type="datetime-local" name="requested_datetime" t-att-value="post.get('requested_datetime', '')"/>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Note complementaire</label>
                                        <textarea name="note" class="form-control" rows="4"><t t-esc="post.get('note', '')"/></textarea>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 mt-4">
                                    <button class="btn auto-btn-primary" type="submit">Envoyer la reservation</button>
                                    <a t-att-href="vehicle.website_url" class="btn btn-outline-secondary">Retour fiche vehicule</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="booking_thanks_page" name="Vehicle Reservation Thanks">
        <t t-call="website.layout">
            <section class="py-5 auto-form-shell">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="card auto-form-card border-0 shadow-sm p-4">
                                <h1 class="h3">Reservation envoyee</h1>
                                <p class="mb-2">Vehicule: <strong t-esc="vehicle.display_name"/></p>
                                <p t-if="booking">Reference: <strong t-esc="booking.name"/></p>
                                <p class="text-muted">Notre equipe valide le creneau et vous contacte rapidement.</p>
                                <div class="d-flex gap-2 mt-3">
                                    <a href="/my/bookings" class="btn auto-btn-primary">Mes reservations</a>
                                    <a href="/cars" class="btn btn-outline-secondary">Continuer le catalogue</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="test_drive_form_page" name="Vehicle Test Drive Form">
        <t t-call="website.layout">
            <section class="py-5 auto-form-shell">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <h1 class="h3 mb-3">Demander un essai</h1>
                            <p class="text-muted">Vehicule: <strong t-esc="vehicle.display_name"/></p>
                            <div t-if="error" class="alert alert-danger" t-esc="error"/>
                            <form method="post" t-att-action="'/cars/%s/test-drive' % vehicle.id" class="card auto-form-card p-4 border-0 shadow-sm">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Nom complet</label>
                                        <input class="form-control" type="text" name="name" required="required" t-att-value="post.get('name', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Email</label>
                                        <input class="form-control" type="email" name="email" required="required" t-att-value="post.get('email', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Telephone</label>
                                        <input class="form-control" type="text" name="phone" t-att-value="post.get('phone', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Lieu</label>
                                        <input class="form-control" type="text" name="location" t-att-value="post.get('location', 'Main showroom')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Choisir un creneau disponible</label>
                                        <select class="form-select" name="slot_id">
                                            <option value="">Aucun creneau selectionne</option>
                                            <t t-foreach="slots" t-as="slot">
                                                <option t-att-value="slot.id"><t t-esc="slot.name"/></option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Ou demander une autre date/heure</label>
                                        <input class="form-control" type="datetime-local" name="requested_datetime" t-att-value="post.get('requested_datetime', '')"/>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Commentaire</label>
                                        <textarea name="comment" class="form-control" rows="4"><t t-esc="post.get('comment', '')"/></textarea>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 mt-4">
                                    <button class="btn auto-btn-primary" type="submit">Envoyer la demande d'essai</button>
                                    <a t-att-href="vehicle.website_url" class="btn btn-outline-secondary">Retour fiche vehicule</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="test_drive_thanks_page" name="Vehicle Test Drive Thanks">
        <t t-call="website.layout">
            <section class="py-5 auto-form-shell">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="card auto-form-card border-0 shadow-sm p-4">
                                <h1 class="h3">Demande d'essai envoyee</h1>
                                <p class="mb-2">Vehicule: <strong t-esc="vehicle.display_name"/></p>
                                <p t-if="test_drive">Reference: <strong t-esc="test_drive.name"/></p>
                                <p class="text-muted">Notre equipe confirme rapidement la date, le lieu et le conseiller.</p>
                                <div class="d-flex gap-2 mt-3">
                                    <a href="/my/test-drives" class="btn auto-btn-primary">Mes essais</a>
                                    <a href="/cars" class="btn btn-outline-secondary">Continuer le catalogue</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="my_bookings_page" name="My Bookings">
        <t t-call="website.layout">
            <section class="py-5 auto-form-shell">
                <div class="container">
                    <h1 class="h3 mb-4">Mes reservations</h1>
                    <div class="table-responsive auto-table-panel">
                        <table class="table table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Vehicule</th>
                                    <th>Date/heure demandee</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="bookings">
                                    <t t-foreach="bookings" t-as="booking">
                                        <tr>
                                            <td t-esc="booking.name"/>
                                            <td t-esc="booking.vehicle_id.display_name"/>
                                            <td t-esc="booking.requested_datetime"/>
                                            <td t-esc="dict(booking.STATE_SELECTION).get(booking.state)"/>
                                        </tr>
                                    </t>
                                </t>
                                <t t-if="not bookings">
                                    <tr>
                                        <td colspan="4">Aucune reservation pour le moment.</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="my_test_drives_page" name="My Test Drives">
        <t t-call="website.layout">
            <section class="py-5 auto-form-shell">
                <div class="container">
                    <h1 class="h3 mb-4">Mes essais</h1>
                    <div class="table-responsive auto-table-panel">
                        <table class="table table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Vehicule</th>
                                    <th>Date/heure demandee</th>
                                    <th>Lieu</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="test_drives">
                                    <t t-foreach="test_drives" t-as="test_drive">
                                        <tr>
                                            <td t-esc="test_drive.name"/>
                                            <td t-esc="test_drive.vehicle_id.display_name"/>
                                            <td t-esc="test_drive.requested_datetime"/>
                                            <td t-esc="test_drive.location"/>
                                            <td t-esc="dict(test_drive.STATE_SELECTION).get(test_drive.state)"/>
                                        </tr>
                                    </t>
                                </t>
                                <t t-if="not test_drives">
                                    <tr>
                                        <td colspan="5">Aucune demande d'essai pour le moment.</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </t>
    </template>
</odoo>
