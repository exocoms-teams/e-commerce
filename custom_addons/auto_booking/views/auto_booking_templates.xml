<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="booking_form_page" name="Formulaire de réservation véhicule">
        <t t-call="website.layout">
            <section class="py-5 auto-form-shell">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <h1 class="h3 mb-3">Réserver ce véhicule</h1>
                            <p class="text-muted">Véhicule: <strong t-out="vehicle.display_name"/></p>
                            <div t-if="error" class="alert alert-danger" t-out="error"/>
                            <form method="post" t-att-action="'/cars/%s/book' % vehicle.id" class="card auto-form-card p-4 border-0 shadow-sm">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Nom complet</label>
                                        <input class="form-control" type="text" name="name" required="required" t-att-value="post.get('name', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Email</label>
                                        <input class="form-control" type="email" name="email" required="required" t-att-value="post.get('email', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Téléphone</label>
                                        <input class="form-control" type="text" name="phone" t-att-value="post.get('phone', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Choisir un créneau disponible</label>
                                        <select class="form-select" name="slot_id">
                                            <option value="">Aucun créneau sélectionné</option>
                                            <t t-foreach="slots" t-as="slot">
                                                <option t-att-value="slot.id"><t t-out="slot.name"/></option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Ou demander une autre date/heure</label>
                                        <input class="form-control" type="datetime-local" name="requested_datetime" t-att-value="post.get('requested_datetime', '')"/>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Note complémentaire</label>
                                        <textarea name="note" class="form-control" rows="4"><t t-out="post.get('note', '')"/></textarea>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 mt-4">
                                    <button class="btn auto-btn-primary" type="submit">Envoyer la réservation</button>
                                    <a t-att-href="vehicle.website_url" class="btn btn-outline-secondary">Retour fiche véhicule</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="booking_thanks_page" name="Confirmation de réservation véhicule">
        <t t-call="website.layout">
            <section class="py-5 auto-form-shell">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="card auto-form-card border-0 shadow-sm p-4">
                                <h1 class="h3">Réservation envoyée</h1>
                                <p class="mb-2">Véhicule: <strong t-out="vehicle.display_name"/></p>
                                <p t-if="booking">Référence: <strong t-out="booking.name"/></p>
                                <p class="text-muted">Notre équipe valide le créneau et vous contacte rapidement.</p>
                                <div class="d-flex gap-2 mt-3">
                                    <a href="/my/bookings" class="btn auto-btn-primary">Mes réservations</a>
                                    <a href="/cars" class="btn btn-outline-secondary">Continuer le catalogue</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="test_drive_form_page" name="Formulaire d'essai véhicule">
        <t t-call="website.layout">
            <section class="py-5 auto-form-shell">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <h1 class="h3 mb-3">Demander un essai</h1>
                            <p class="text-muted">Véhicule: <strong t-out="vehicle.display_name"/></p>
                            <div t-if="error" class="alert alert-danger" t-out="error"/>
                            <form method="post" t-att-action="'/cars/%s/test-drive' % vehicle.id" class="card auto-form-card p-4 border-0 shadow-sm">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Nom complet</label>
                                        <input class="form-control" type="text" name="name" required="required" t-att-value="post.get('name', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Email</label>
                                        <input class="form-control" type="email" name="email" required="required" t-att-value="post.get('email', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Téléphone</label>
                                        <input class="form-control" type="text" name="phone" t-att-value="post.get('phone', '')"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Lieu</label>
                                        <input class="form-control" type="text" name="location" t-att-value="post.get('location', default_location)"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Choisir un créneau disponible</label>
                                        <select class="form-select" name="slot_id">
                                            <option value="">Aucun créneau sélectionné</option>
                                            <t t-foreach="slots" t-as="slot">
                                                <option t-att-value="slot.id"><t t-out="slot.name"/></option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Ou demander une autre date/heure</label>
                                        <input class="form-control" type="datetime-local" name="requested_datetime" t-att-value="post.get('requested_datetime', '')"/>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Commentaire</label>
                                        <textarea name="comment" class="form-control" rows="4"><t t-out="post.get('comment', '')"/></textarea>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 mt-4">
                                    <button class="btn auto-btn-primary" type="submit">Envoyer la demande d'essai</button>
                                    <a t-att-href="vehicle.website_url" class="btn btn-outline-secondary">Retour fiche véhicule</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="test_drive_thanks_page" name="Confirmation d'essai véhicule">
        <t t-call="website.layout">
            <section class="py-5 auto-form-shell">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="card auto-form-card border-0 shadow-sm p-4">
                                <h1 class="h3">Demande d'essai envoyée</h1>
                                <p class="mb-2">Véhicule: <strong t-out="vehicle.display_name"/></p>
                                <p t-if="test_drive">Référence: <strong t-out="test_drive.name"/></p>
                                <p class="text-muted">Notre équipe confirme rapidement la date, le lieu et le conseiller.</p>
                                <div class="d-flex gap-2 mt-3">
                                    <a href="/my/test-drives" class="btn auto-btn-primary">Mes essais</a>
                                    <a href="/cars" class="btn btn-outline-secondary">Continuer le catalogue</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="my_bookings_page" name="Mes réservations">
        <t t-call="website.layout">
            <section class="py-5 auto-form-shell">
                <div class="container">
                    <h1 class="h3 mb-4">Mes réservations</h1>
                    <div class="table-responsive auto-table-panel">
                        <table class="table table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Véhicule</th>
                                    <th>Date/heure demandée</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="bookings">
                                    <t t-foreach="bookings" t-as="booking">
                                        <tr>
                                            <td t-out="booking.name"/>
                                            <td t-out="booking.vehicle_id.display_name"/>
                                            <td t-out="booking.requested_datetime"/>
                                            <td t-out="booking.state_label"/>
                                        </tr>
                                    </t>
                                </t>
                                <t t-if="not bookings">
                                    <tr>
                                        <td colspan="4">Aucune réservation pour le moment.</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="my_test_drives_page" name="Mes essais">
        <t t-call="website.layout">
            <section class="py-5 auto-form-shell">
                <div class="container">
                    <h1 class="h3 mb-4">Mes essais</h1>
                    <div class="table-responsive auto-table-panel">
                        <table class="table table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Véhicule</th>
                                    <th>Date/heure demandée</th>
                                    <th>Lieu</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="test_drives">
                                    <t t-foreach="test_drives" t-as="test_drive">
                                        <tr>
                                            <td t-out="test_drive.name"/>
                                            <td t-out="test_drive.vehicle_id.display_name"/>
                                            <td t-out="test_drive.requested_datetime"/>
                                            <td t-out="test_drive.location"/>
                                            <td t-out="test_drive.state_label"/>
                                        </tr>
                                    </t>
                                </t>
                                <t t-if="not test_drives">
                                    <tr>
                                        <td colspan="5">Aucune demande d'essai pour le moment.</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </t>
    </template>
</odoo>
