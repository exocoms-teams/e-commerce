<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_auto_admin" model="res.groups">
        <field name="name">Administrateur automobile</field>
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="group_auto_sales_advisor" model="res.groups">
        <field name="name">Conseiller commercial automobile</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_auto_content_manager" model="res.groups">
        <field name="name">Gestionnaire de contenu automobile</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <function model="res.users" name="_auto_base_assign_admin_group"/>
</odoo>
