<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auto_brand_kanban" model="ir.ui.view">
        <field name="name">auto.brand.kanban</field>
        <field name="model">auto.brand</field>
        <field name="arch" type="xml">
            <kanban class="auto-brand-kanban" sample="1">
                <field name="logo"/>
                <field name="name"/>
                <field name="code"/>
                <field name="vehicle_count"/>
                <field name="website_published"/>
                <templates>
                    <t t-name="card">
                        <main class="auto-brand-kanban-card">
                            <div class="auto-brand-kanban-logo">
                                <field name="logo" widget="image" alt="Logo marque" options="{'img_class': 'auto-brand-kanban-img'}"/>
                            </div>
                            <div class="auto-brand-kanban-body">
                                <strong class="auto-brand-kanban-title"><field name="name"/></strong>
                                <div class="text-muted small" t-if="record.code.raw_value"><field name="code"/></div>
                                <div class="d-flex gap-2 mt-2">
                                    <span class="badge text-bg-light border"><field name="vehicle_count"/> vehicules</span>
                                    <span class="badge text-bg-primary" t-if="record.website_published.raw_value">Publiee</span>
                                    <span class="badge text-bg-secondary" t-if="!record.website_published.raw_value">Non publiee</span>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_auto_brand_tree" model="ir.ui.view">
        <field name="name">auto.brand.tree</field>
        <field name="model">auto.brand</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="vehicle_count"/>
                <field name="website_published"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_auto_brand_form" model="ir.ui.view">
        <field name="name">auto.brand.form</field>
        <field name="model">auto.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_vehicles" type="object" class="oe_stat_button" icon="fa-car">
                            <field name="vehicle_count" widget="statinfo" string="Véhicules"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="website_published"/>
                        </group>
                        <group>
                            <field name="logo" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Véhicules">
                            <field name="vehicle_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="availability"/>
                                    <field name="list_price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_auto_brand_search" model="ir.ui.view">
        <field name="name">auto.brand.search</field>
        <field name="model">auto.brand</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="published" string="Publié" domain="[('website_published', '=', True)]"/>
                <filter name="active" string="Actif" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_auto_brand" model="ir.actions.act_window">
        <field name="name">Marques</field>
        <field name="res_model">auto.brand</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_auto_brand" name="Marques" parent="auto_base.menu_auto_catalog" action="action_auto_brand" sequence="10"/>
</odoo>
