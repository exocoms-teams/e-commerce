<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auto_vehicle_tree" model="ir.ui.view">
        <field name="name">auto.vehicle.tree</field>
        <field name="model">auto.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="featured"/>
                <field name="name"/>
                <field name="brand_id"/>
                <field name="category_id"/>
                <field name="motorization_id"/>
                <field name="year"/>
                <field name="availability"/>
                <field name="list_price"/>
                <field name="website_published"/>
            </list>
        </field>
    </record>

    <record id="view_auto_vehicle_form" model="ir.ui.view">
        <field name="name">auto.vehicle.form</field>
        <field name="model">auto.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_available" type="object" string="Set Available" class="btn-primary" invisible="availability == 'available'"/>
                    <button name="action_set_reserved" type="object" string="Set Reserved" invisible="availability == 'reserved'"/>
                    <button name="action_set_sold" type="object" string="Set Sold" invisible="availability == 'sold'"/>
                    <button name="action_set_coming_soon" type="object" string="Set Coming Soon" invisible="availability == 'coming_soon'"/>
                    <field name="availability" widget="statusbar" statusbar_visible="available,reserved,sold,coming_soon"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_product" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <span>Product</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="brand_id"/>
                            <field name="product_template_id" options="{'no_create_edit': True}"/>
                            <field name="category_id"/>
                            <field name="motorization_id"/>
                            <field name="featured"/>
                            <field name="website_published"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="main_image" widget="image" readonly="1"/>
                            <field name="list_price"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="year"/>
                            <field name="availability"/>
                            <field name="stock_qty"/>
                            <field name="favorite_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Highlights">
                            <group>
                                <group>
                                    <field name="short_description"/>
                                    <field name="description"/>
                                </group>
                                <group>
                                    <field name="seats"/>
                                    <field name="mileage_km"/>
                                    <field name="range_km"/>
                                    <field name="consumption"/>
                                    <field name="power_kw"/>
                                    <field name="battery_capacity"/>
                                    <field name="charging_time"/>
                                    <field name="warranty_years"/>
                                </group>
                            </group>
                        </page>
                        <page string="Colors &amp; Options">
                            <group>
                                <field name="color_ids" widget="many2many_tags"/>
                                <field name="option_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Gallery">
                            <field name="image_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="is_cover"/>
                                    <field name="alt_text"/>
                                    <field name="image_1920" widget="image"/>
                                </list>
                            </field>
                        </page>
                        <page string="Specifications">
                            <field name="specification_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="section"/>
                                    <field name="name"/>
                                    <field name="value"/>
                                    <field name="unit"/>
                                </list>
                            </field>
                        </page>
                        <page string="SEO">
                            <group>
                                <field name="seo_title"/>
                                <field name="seo_description"/>
                                <field name="website_url" readonly="1"/>
                                <field name="compare_enabled"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_auto_vehicle_search" model="ir.ui.view">
        <field name="name">auto.vehicle.search</field>
        <field name="model">auto.vehicle</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="brand_id"/>
                <field name="category_id"/>
                <field name="motorization_id"/>
                <field name="availability"/>
                <filter name="available" string="Available" domain="[('availability', '=', 'available')]"/>
                <filter name="featured" string="Featured" domain="[('featured', '=', True)]"/>
                <filter name="published" string="Published" domain="[('website_published', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_brand" string="Brand" context="{'group_by': 'brand_id'}"/>
                    <filter name="group_by_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_by_motorization" string="Motorization" context="{'group_by': 'motorization_id'}"/>
                    <filter name="group_by_availability" string="Availability" context="{'group_by': 'availability'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_auto_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">auto.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_auto_vehicle" name="Vehicles" parent="auto_base.menu_auto_catalog" action="action_auto_vehicle" sequence="20"/>
</odoo>
