<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auto_motorization_tree" model="ir.ui.view">
        <field name="name">auto.motorization.tree</field>
        <field name="model">auto.motorization</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_electrified"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_auto_motorization_form" model="ir.ui.view">
        <field name="name">auto.motorization.form</field>
        <field name="model">auto.motorization</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="is_electrified"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_auto_motorization" model="ir.actions.act_window">
        <field name="name">Motorisations</field>
        <field name="res_model">auto.motorization</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_auto_motorization" name="Motorisations" parent="auto_base.menu_auto_configuration" action="action_auto_motorization" sequence="20"/>
</odoo>
