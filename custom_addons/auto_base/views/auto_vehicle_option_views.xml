<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auto_vehicle_option_tree" model="ir.ui.view">
        <field name="name">auto.vehicle.option.tree</field>
        <field name="model">auto.vehicle.option</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="option_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_auto_vehicle_option_form" model="ir.ui.view">
        <field name="name">auto.vehicle.option.form</field>
        <field name="model">auto.vehicle.option</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="option_type"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_auto_vehicle_option" model="ir.actions.act_window">
        <field name="name">Vehicle Options</field>
        <field name="res_model">auto.vehicle.option</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_auto_vehicle_option" name="Vehicle Options" parent="auto_base.menu_auto_configuration" action="action_auto_vehicle_option" sequence="40"/>
</odoo>
