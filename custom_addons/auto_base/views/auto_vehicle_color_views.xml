<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auto_vehicle_color_tree" model="ir.ui.view">
        <field name="name">auto.vehicle.color.tree</field>
        <field name="model">auto.vehicle.color</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="hex_code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_auto_vehicle_color_form" model="ir.ui.view">
        <field name="name">auto.vehicle.color.form</field>
        <field name="model">auto.vehicle.color</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="hex_code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_auto_vehicle_color" model="ir.actions.act_window">
        <field name="name">Couleurs de véhicules</field>
        <field name="res_model">auto.vehicle.color</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_auto_vehicle_color" name="Couleurs de véhicules" parent="auto_base.menu_auto_configuration" action="action_auto_vehicle_color" sequence="30"/>
</odoo>
