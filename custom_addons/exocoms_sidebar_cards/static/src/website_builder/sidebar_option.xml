<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="exocoms_sidebar_cards.SidebarOption">

        <!-- Produits par page -->
        <BuilderRow label.translate="Produits par page">
            <BuilderButtonGroup>
                <BuilderButton action="'exocomsPpg'" actionParam="'24'">24</BuilderButton>
                <BuilderButton action="'exocomsPpg'" actionParam="'48'">48</BuilderButton>
                <BuilderButton action="'exocomsPpg'" actionParam="'72'">72</BuilderButton>
            </BuilderButtonGroup>
        </BuilderRow>

        <!-- Filtre Marques : affiché / masqué -->
        <BuilderRow label.translate="Filtre Marques">
            <BuilderButtonGroup>
                <BuilderButton classAction="''" title.translate="Afficher le filtre par marques">
                    Affiché
                </BuilderButton>
                <BuilderButton classAction="'o_exo_no_brands'" title.translate="Masquer le filtre par marques">
                    Masqué
                </BuilderButton>
            </BuilderButtonGroup>
        </BuilderRow>

        <!-- Comparaison de produits : activée / désactivée -->
        <BuilderRow label.translate="Comparaison de produits">
            <BuilderButtonGroup>
                <BuilderButton classAction="''" title.translate="Activer la comparaison de produits">
                    Activée
                </BuilderButton>
                <BuilderButton classAction="'o_exo_compare_off'" title.translate="Désactiver la comparaison de produits">
                    Désactivée
                </BuilderButton>
            </BuilderButtonGroup>
        </BuilderRow>

    </t>

</templates>
