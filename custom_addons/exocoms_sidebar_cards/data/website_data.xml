<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Crée la page boutique avec le snippet sidebar -->
    <record id="exocoms_sidebar_website_page" model="website.page">
        <field name="name">Boutique</field>
        <field name="url">/boutique</field>
        <field name="is_published" eval="True"/>
        <field name="view_id" ref="exocoms_sidebar_cards.exocoms_sidebar_page"/>
    </record>

    <!-- La boutique reste une page distincte : l'accueil du site est /. -->
    <record id="website.default_website" model="website">
        <field name="homepage_url">/</field>
    </record>
</odoo>
