<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_transaction_form" model="ir.ui.view">
        <field name="name">travel.payment.transaction.form</field>
        <field name="model">travel.payment.transaction</field>
        <field name="arch" type="xml">
            <form string="Payment Transaction">
                <header>
                    <button name="action_pending" string="Send Payment"
                            type="object" invisible="state != 'draft'"
                            class="btn-primary"/>
                    <button name="action_done" string="Confirm Payment"
                            type="object" invisible="state != 'pending'"
                            class="btn-primary"/>
                    <button name="action_failed" string="Mark Failed"
                            type="object" invisible="state not in ('pending',)"
                            class="btn-danger"/>
                    <button name="action_cancel" string="Cancel"
                            type="object" invisible="state in ('done', 'cancelled')"
                            class="btn-secondary"/>
                    <button name="action_reset" string="Reset"
                            type="object" invisible="state != 'cancelled'"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Transaction">
                            <field name="reservation_id"/>
                            <field name="provider_id"/>
                            <field name="currency"/>
                            <field name="date_transaction"/>
                        </group>
                        <group string="Amounts">
                            <field name="amount"/>
                            <field name="commission"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_payment_transaction_list" model="ir.ui.view">
        <field name="name">travel.payment.transaction.list</field>
        <field name="model">travel.payment.transaction</field>
        <field name="arch" type="xml">
            <list string="Transactions">
                <field name="name"/>
                <field name="reservation_id"/>
                <field name="provider_id"/>
                <field name="amount"/>
                <field name="commission"/>
                <field name="currency"/>
                <field name="state"/>
                <field name="date_transaction"/>
            </list>
        </field>
    </record>

    <record id="action_payment_transaction" model="ir.actions.act_window">
        <field name="name">Payment Transactions</field>
        <field name="res_model">travel.payment.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_travel_payment_transaction" name="Transactions"
              parent="menu_travel_root"
              action="action_payment_transaction"
              sequence="30"/>
</odoo>