<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <record id="travel_leisure_list_view" model="ir.ui.view">
        <field name="name">travel.leisure.list</field>
        <field name="model">travel.leisure</field>
        <field name="arch" type="xml">
            <list string="Loisirs &amp; Sorties">
                <field name="name"/>
                <field name="categorie"/>
                <field name="ville"/>
                <field name="pays"/>
                <field name="duree_heures"/>
                <field name="prix_par_personne"/>
                <field name="niveau"/>
                <field name="disponible"/>
            </list>
        </field>
    </record>

    <record id="travel_leisure_form_view" model="ir.ui.view">
        <field name="name">travel.leisure.form</field>
        <field name="model">travel.leisure</field>
        <field name="arch" type="xml">
            <form string="Activité / Loisir">
                <sheet>
                    <field name="image_1920" widget="image"
                           class="oe_avatar" options="{'size': [128, 128]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nom de l'activité"/></h1>
                    </div>
                    <group>
                        <group string="Informations">
                            <field name="categorie"/>
                            <field name="pays"/>
                            <field name="ville"/>
                            <field name="niveau"/>
                        </group>
                        <group string="Groupe &amp; Tarif">
                            <field name="duree_heures"/>
                            <field name="nb_personnes_min"/>
                            <field name="nb_personnes_max"/>
                            <field name="prix_par_personne"/>
                            <field name="disponible"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Points forts">
                            <field name="points_forts"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="travel_leisure_action" model="ir.actions.act_window">
        <field name="name">Loisirs &amp; Sorties</field>
        <field name="res_model">travel.leisure</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_travel_leisure"
              name="Loisirs &amp; Sorties"
              parent="menu_travel_root"
              action="travel_leisure_action"
              sequence="60"/>

</data>
</odoo>
