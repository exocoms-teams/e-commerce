<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_travel_payment_provider_form" model="ir.ui.view">
        <field name="name">travel.payment.provider.form</field>
        <field name="model">travel.payment.provider</field>
        <field name="arch" type="xml">
            <form string="Payment Provider">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="commission_rate"/>
                        <field name="api_url"/>
                        <field name="api_key"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_travel_payment_provider_list" model="ir.ui.view">
        <field name="name">travel.payment.provider.list</field>
        <field name="model">travel.payment.provider</field>
        <field name="arch" type="xml">
            <list string="Payment Providers">
                <field name="name"/>
                <field name="commission_rate"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_travel_payment_provider" model="ir.actions.act_window">
        <field name="name">Payment Providers</field>
        <field name="res_model">travel.payment.provider</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_travel_payment" name="Payment Providers"
              parent="menu_travel_root"
              action="action_travel_payment_provider"
              sequence="20"/>
</odoo>