<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="website_menu_about" model="website.menu">
        <field name="name">À propos</field>
        <field name="url">/a-propos</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">15</field>
    </record>

    <record id="website.menu_contactus" model="website.menu">
        <field name="name">Contact</field>
        <field name="sequence">16</field>
    </record>

    <record id="website.menu_home" model="website.menu">
        <field name="name">Accueil</field>
    </record>

    <record id="website_menu_login" model="website.menu">
        <field name="name">Connexion / S'inscrire</field>
        <field name="url">/web/login</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">90</field>
    </record>

    <template id="about_page" name="À propos">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <h1 class="mb-4">Qui sommes-nous ?</h1>
                <p class="lead">
                    Notre agence accompagne les voyageurs depuis plus de 10 ans dans
                    l'organisation de séjours, circuits et voyages sur mesure.
                </p>
                <p>
                    Vols, hôtels, circuits touristiques et packages tout compris :
                    nous sélectionnons nos partenaires pour vous garantir des séjours
                    de qualité au meilleur prix, avec une assistance disponible 7j/7.
                </p>
                <div class="row mt-4">
                    <div class="col-md-4 mb-3">
                        <h5><i class="fa fa-shield-alt me-2"/>Paiement sécurisé</h5>
                        <p>Vos transactions sont protégées de bout en bout.</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <h5><i class="fa fa-headset me-2"/>Assistance 7j/7</h5>
                        <p>Une équipe disponible avant, pendant et après votre voyage.</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <h5><i class="fa fa-star me-2"/>+1000 voyageurs satisfaits</h5>
                        <p>Des séjours pensés pour vous, du premier au dernier jour.</p>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
