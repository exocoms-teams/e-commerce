<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product form view with travel-specific fields -->
    <record id="view_travel_product_form" model="ir.ui.view">
        <field name="name">product.template.travel.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- 1. Ajouter la checkbox "Produit Voyage" dans l'onglet Informations générales -->
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex align-items-center">
                    <field name="is_travel_product" class="me-1"/>
                    <label for="is_travel_product" string="Produit Voyage"/>
                </span>
            </xpath>

            <!-- 2. Onglet Travel — visible uniquement si is_travel_product = True -->
            <xpath expr="//notebook" position="inside">
                <page string="Travel" name="travel"
                      invisible="not is_travel_product">
                    <group string="Travel Type">
                        <field name="type_voyage"/>
                        <field name="categorie_voyage"/>
                        <field name="classe_voyage"/>
                    </group>
                    <group string="Destination">
                        <field name="pays_depart"/>
                        <field name="ville_depart"/>
                        <field name="pays_destination"/>
                        <field name="ville_destination"/>
                    </group>
                    <group string="Details">
                        <field name="duree_jours"/>
                        <field name="nombre_personnes_max"/>
                        <field name="prix_par_personne"/>
                        <field name="etoiles"/>
                        <field name="disponible"/>
                    </group>
                    <group string="Localisation (carte)">
                        <field name="latitude"/>
                        <field name="longitude"/>
                    </group>
                </page>

                <!-- 3. Onglet Contenu page détail — même condition -->
                <page string="Contenu page détail" name="travel_content"
                      invisible="not is_travel_product">
                    <group string="Les plus">
                        <field name="points_forts" nolabel="1" placeholder="Un avantage par ligne"/>
                    </group>
                    <group string="Situation">
                        <field name="description_situation" nolabel="1"/>
                    </group>
                    <group string="L'hôtel">
                        <field name="description_hotel" nolabel="1"/>
                    </group>
                    <group string="Logement">
                        <field name="description_logement" nolabel="1"/>
                    </group>
                    <group string="Animations">
                        <field name="description_animations" nolabel="1"/>
                    </group>
                    <group string="Restauration">
                        <field name="description_restauration" nolabel="1"/>
                    </group>
                    <group string="Excursions">
                        <field name="description_excursions" nolabel="1"/>
                    </group>
                    <group string="Formalités">
                        <field name="description_formalites" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
