<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="travel_list_page" name="Liste des voyages">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">

                <h1 class="mb-4">
                    <i class="fa fa-plane me-2"/>
                    Nos Voyages
                </h1>

                <div class="row">

                    <div class="col-md-3 mb-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title mb-3">Filtrer</h5>
                                <form action="/travels" method="GET">
                                    <div class="mb-3">
                                        <label class="form-label">Destination</label>
                                        <input type="text" name="destination" class="form-control"
                                            placeholder="Ville ou pays"
                                            t-att-value="filters.get('destination', '')"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Type de voyage</label>
                                        <select name="type_voyage" class="form-select">
                                            <option value="">Tous</option>
                                            <option value="aller_simple"
                                                t-att-selected="filters.get('type_voyage') == 'aller_simple' or None">Aller simple</option>
                                            <option value="aller_retour"
                                                t-att-selected="filters.get('type_voyage') == 'aller_retour' or None">Aller-retour</option>
                                            <option value="circuit"
                                                t-att-selected="filters.get('type_voyage') == 'circuit' or None">Circuit touristique</option>
                                            <option value="sejour"
                                                t-att-selected="filters.get('type_voyage') == 'sejour' or None">Séjour</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Étoiles minimum</label>
                                        <select name="etoiles" class="form-select">
                                            <option value="">Toutes</option>
                                            <option value="1" t-att-selected="filters.get('etoiles') == '1' or None">1 étoile et +</option>
                                            <option value="2" t-att-selected="filters.get('etoiles') == '2' or None">2 étoiles et +</option>
                                            <option value="3" t-att-selected="filters.get('etoiles') == '3' or None">3 étoiles et +</option>
                                            <option value="4" t-att-selected="filters.get('etoiles') == '4' or None">4 étoiles et +</option>
                                            <option value="5" t-att-selected="filters.get('etoiles') == '5' or None">5 étoiles</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Prix max (€)</label>
                                        <input type="number" name="prix_max" class="form-control"
                                            min="0" t-att-value="filters.get('prix_max', '')"/>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fa fa-filter me-2"/>
                                        Filtrer
                                    </button>
                                    <a href="/travels" class="btn btn-link w-100 mt-2">
                                        Réinitialiser
                                    </a>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-9">
                    <div class="row">

                    <t t-foreach="products" t-as="product">
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm">

                                <t t-if="product.image_1920">
                                    <img t-attf-src="/web/image/product.template/#{product.id}/image_1920"
                                        class="card-img-top"
                                        style="height:200px; object-fit:cover;"/>
                                </t>

                                <div class="card-body">
                                    <h5 class="card-title">
                                        <t t-esc="product.name"/>
                                    </h5>
                                    <p class="text-muted">
                                        <i class="fa fa-tag me-1"/>
                                        <strong>
                                            <t t-esc="product.prix_par_personne"/> € / personne
                                        </strong>
                                    </p>
                                </div>

                                <div class="card-footer">
                                    <a t-attf-href="/travels/#{product.id}"
                                        class="btn btn-primary w-100">
                                        <i class="fa fa-info-circle me-2"/>
                                        Afficher les détails
                                    </a>
                                </div>

                            </div>
                        </div>
                    </t>

                    <t t-if="not products">
                        <div class="col-12">
                            <div class="alert alert-info">
                                Aucun voyage disponible pour le moment.
                            </div>
                        </div>
                    </t>

                    </div>
                    </div>

                </div>
            </div>
        </t>
    </template>

    <template id="travel_detail_page" name="Détail du voyage">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row">
                    <div class="col-md-6 mb-4">
                        <t t-if="product.image_1920">
                            <img t-attf-src="/web/image/product.template/#{product.id}/image_1920"
                                class="img-fluid rounded shadow-sm"/>
                        </t>
                    </div>
                    <div class="col-md-6">
                        <h1 class="mb-3"><t t-esc="product.name"/></h1>

                        <p class="fs-4 text-primary">
                            <strong><t t-esc="product.prix_par_personne"/> € / personne</strong>
                        </p>

                        <t t-if="product.description_sale">
                            <p><t t-esc="product.description_sale"/></p>
                        </t>

                        <ul class="list-group list-group-flush mb-4">
                            <li class="list-group-item">
                                <i class="fa fa-map-marker-alt me-2"/>
                                <strong>Départ :</strong>
                                <t t-esc="product.ville_depart"/> (<t t-esc="product.pays_depart"/>)
                            </li>
                            <li class="list-group-item">
                                <i class="fa fa-map-marker-alt me-2"/>
                                <strong>Destination :</strong>
                                <t t-esc="product.ville_destination"/> (<t t-esc="product.pays_destination"/>)
                            </li>
                            <li class="list-group-item">
                                <i class="fa fa-clock me-2"/>
                                <strong>Durée :</strong>
                                <t t-esc="product.duree_jours"/> jour(s)
                            </li>
                            <li class="list-group-item">
                                <i class="fa fa-route me-2"/>
                                <strong>Type de voyage :</strong>
                                <t t-esc="product.type_voyage"/>
                            </li>
                            <li class="list-group-item">
                                <i class="fa fa-suitcase me-2"/>
                                <strong>Catégorie :</strong>
                                <t t-esc="product.categorie_voyage"/>
                            </li>
                            <li class="list-group-item">
                                <i class="fa fa-chair me-2"/>
                                <strong>Classe :</strong>
                                <t t-esc="product.classe_voyage"/>
                            </li>
                            <li class="list-group-item" t-if="product.nombre_personnes_max">
                                <i class="fa fa-users me-2"/>
                                <strong>Capacité maximale :</strong>
                                <t t-esc="product.nombre_personnes_max"/> personnes
                            </li>
                        </ul>

                        <a t-attf-href="/travels/book/#{product.id}" class="btn btn-primary btn-lg">
                            <i class="fa fa-calendar me-2"/>
                            Réserver ce voyage
                        </a>
                        <a href="/travels" class="btn btn-outline-secondary btn-lg ms-2">
                            Retour à la liste
                        </a>
                    </div>
                </div>

                <ul class="nav nav-tabs mt-5" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" data-bs-toggle="tab" href="#tab-presentation">Présentation</a>
                    </li>
                    <li class="nav-item" t-if="product.description_logement">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-logement">Logement</a>
                    </li>
                    <li class="nav-item" t-if="product.description_animations">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-animations">Animations</a>
                    </li>
                    <li class="nav-item" t-if="product.description_restauration">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-restauration">Restauration</a>
                    </li>
                    <li class="nav-item" t-if="product.description_excursions">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-excursions">Excursions</a>
                    </li>
                    <li class="nav-item" t-if="product.description_formalites">
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-formalites">Formalités</a>
                    </li>
                </ul>

                <div class="tab-content border border-top-0 p-4">
                    <div class="tab-pane fade show active" id="tab-presentation">

                        <t t-if="product.description_situation">
                            <div class="row align-items-center mb-4">
                                <div class="col-md-8">
                                    <h3>Situation</h3>
                                    <div t-field="product.description_situation"/>
                                </div>
                                <div class="col-md-4" t-if="product.latitude and product.longitude">
                                    <div id="travel-map" style="height:250px;" t-attf-data-lat="#{product.latitude}" t-attf-data-lng="#{product.longitude}"/>
                                </div>
                            </div>
                        </t>

                        <t t-if="product.description_hotel">
                            <h3>L'hôtel</h3>
                            <div t-field="product.description_hotel" class="mb-4"/>
                        </t>

                        <t t-if="product.points_forts">
                            <h3>Les plus</h3>
                            <ul class="mb-4">
                                <t t-foreach="product.points_forts.splitlines()" t-as="ligne">
                                    <li t-if="ligne.strip()" t-esc="ligne"/>
                                </t>
                            </ul>
                        </t>
                    </div>

                    <div class="tab-pane fade" id="tab-logement" t-if="product.description_logement">
                        <h3>Logement</h3>
                        <div t-field="product.description_logement"/>
                    </div>

                    <div class="tab-pane fade" id="tab-animations" t-if="product.description_animations">
                        <h3>Animations</h3>
                        <div t-field="product.description_animations"/>
                    </div>

                    <div class="tab-pane fade" id="tab-restauration" t-if="product.description_restauration">
                        <h3>Restauration</h3>
                        <div t-field="product.description_restauration"/>
                    </div>

                    <div class="tab-pane fade" id="tab-excursions" t-if="product.description_excursions">
                        <h3>Excursions</h3>
                        <div t-field="product.description_excursions"/>
                    </div>

                    <div class="tab-pane fade" id="tab-formalites" t-if="product.description_formalites">
                        <h3>Formalités</h3>
                        <div t-field="product.description_formalites"/>
                    </div>
                </div>

                <t t-if="product.latitude and product.longitude">
                    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
                    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            var el = document.getElementById('travel-map');
                            if (!el || typeof L === 'undefined') return;
                            var lat = parseFloat(el.dataset.lat);
                            var lng = parseFloat(el.dataset.lng);
                            var map = L.map(el).setView([lat, lng], 10);
                            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
                            L.marker([lat, lng]).addTo(map);
                        });
                    </script>
                </t>

            </div>
        </t>
    </template>

    <template id="travel_booking_page" name="Formulaire de réservation">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row justify-content-center">
                    <div class="col-lg-8">

                        <h1 class="mb-4">
                            <i class="fa fa-calendar me-2"/>
                            Réserver — <t t-esc="product.name"/>
                        </h1>

                        <div t-if="error" class="alert alert-danger">
                            <t t-esc="error"/>
                        </div>

                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <t t-if="product.image_1920">
                                            <img t-attf-src="/web/image/product.template/#{product.id}/image_1920"
                                                class="img-fluid rounded"/>
                                        </t>
                                    </div>
                                    <div class="col-md-8">
                                        <h4><t t-esc="product.name"/></h4>
                                        <p>
                                            <strong>Prix par personne :</strong>
                                            <t t-esc="product.prix_par_personne"/> €
                                        </p>
                                        <t t-if="product.description_sale">
                                            <p><t t-esc="product.description_sale"/></p>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-body">
                                <form action="/travels/book/submit" method="POST">

                                    <input type="hidden" name="csrf_token"
                                        t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="product_id"
                                        t-att-value="product.id"/>

                                    <h5 class="mb-3">Vos informations</h5>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label"><strong>Prénom *</strong></label>
                                            <input type="text" name="client_firstname"
                                                class="form-control" required="1"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label"><strong>Nom *</strong></label>
                                            <input type="text" name="client_lastname"
                                                class="form-control" required="1"/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label"><strong>Email *</strong></label>
                                            <input type="email" name="client_email"
                                                class="form-control" required="1"/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label"><strong>Téléphone</strong></label>
                                            <input type="tel" name="client_phone"
                                                class="form-control"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label"><strong>Pays</strong></label>
                                            <input type="text" name="client_country"
                                                class="form-control"/>
                                        </div>
                                    </div>

                                    <h5 class="mb-3 mt-4">Dates du voyage</h5>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label"><strong>Date de départ *</strong></label>
                                            <input type="date" name="date_depart"
                                                class="form-control" required="1"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label"><strong>Date de retour *</strong></label>
                                            <input type="date" name="date_retour"
                                                class="form-control" required="1"/>
                                        </div>
                                    </div>

                                    <h5 class="mb-3 mt-4">Voyageurs</h5>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label"><strong>Adultes *</strong></label>
                                            <input type="number" id="nb_adultes" name="nb_adultes"
                                                class="form-control" value="1" min="1" required="1"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label"><strong>Enfants</strong></label>
                                            <input type="number" id="nb_enfants" name="nb_enfants"
                                                class="form-control" value="0" min="0"/>
                                        </div>
                                    </div>

                                    <h5 class="mb-3 mt-4">Détails des voyageurs</h5>
                                    <input type="hidden" id="passenger_count" name="passenger_count" value="0"/>
                                    <div id="passengers-container"/>

                                    <div class="mb-4">
                                        <label class="form-label"><strong>Notes / Demandes spéciales</strong></label>
                                        <textarea name="notes" class="form-control" rows="3"/>
                                    </div>
                                     
                                    <h5 class="mb-3 mt-4">Mode de paiement</h5>
                                    <div class="mb-4">
                                        <label class="form-label"><strong>Prestataire de paiement *</strong></label>
                                        <select name="payment_provider_id" class="form-select" required="1">
                                            <option value="">-- Choisir --</option>
                                            <t t-foreach="providers" t-as="provider">
                                                <option t-att-value="provider.id"><t t-esc="provider.name"/></option>
                                            </t>
                                        </select>
                                    </div>


                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-primary btn-lg">
                                            <i class="fa fa-check me-2"/>
                                            Confirmer la réservation
                                        </button>
                                    </div>

                                </form>

                                <script>
                                <![CDATA[
                                    function renderPassengers() {
                                        var adultes = parseInt(document.getElementById('nb_adultes').value) || 0;
                                        var enfants = parseInt(document.getElementById('nb_enfants').value) || 0;
                                        var container = document.getElementById('passengers-container');
                                        container.innerHTML = '';
                                        var idx = 0;
                                        for (var i = 1; i <= adultes; i++) {
                                            container.appendChild(passengerBlock(idx, 'Adulte ' + i, 'adulte'));
                                            idx++;
                                        }
                                        for (var i = 1; i <= enfants; i++) {
                                            container.appendChild(passengerBlock(idx, 'Enfant ' + i, 'enfant'));
                                            idx++;
                                        }
                                        document.getElementById('passenger_count').value = idx;
                                    }
                                    function passengerBlock(idx, label, type) {
                                        var div = document.createElement('div');
                                        div.className = 'row mb-2 align-items-center';
                                        div.innerHTML =
                                            '<div class="col-12 fw-bold mb-1">' + label + '</div>' +
                                            '<div class="col-md-4 mb-2"><input type="text" class="form-control" placeholder="Prénom" name="passenger_prenom_' + idx + '" required="required"/></div>' +
                                            '<div class="col-md-4 mb-2"><input type="text" class="form-control" placeholder="Nom" name="passenger_nom_' + idx + '" required="required"/></div>' +
                                            '<div class="col-md-4 mb-2"><input type="date" class="form-control" name="passenger_dob_' + idx + '" required="required"/></div>' +
                                            '<input type="hidden" name="passenger_type_' + idx + '" value="' + type + '"/>';
                                        return div;
                                    }
                                    document.getElementById('nb_adultes').addEventListener('input', renderPassengers);
                                    document.getElementById('nb_enfants').addEventListener('input', renderPassengers);
                                    renderPassengers();
                                ]]>
                                </script>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="travel_confirm_page" name="Confirmation réservation">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row justify-content-center">
                    <div class="col-lg-6 text-center">

                        <i class="fa fa-check-circle fa-5x text-success mb-4"/>
                        <h1>Réservation enregistrée !</h1>

                        <p class="lead">
                            Merci <strong><t t-esc="reservation.client_name"/></strong> !
                            Votre demande a bien été enregistrée.
                            Nous vous contacterons à l'adresse
                            <strong><t t-esc="reservation.client_email"/></strong>.
                        </p>

                        <div class="card mt-4 text-start">
                            <div class="card-body">
                                <p><strong>Référence :</strong> <t t-esc="reservation.name"/></p>
                                <p><strong>Voyage :</strong> <t t-esc="reservation.product_id.name"/></p>
                                <p><strong>Départ :</strong> <t t-esc="reservation.date_depart"/></p>
                                <p><strong>Retour :</strong> <t t-esc="reservation.date_retour"/></p>
                                <p><strong>Voyageurs :</strong> <t t-esc="reservation.nb_voyageurs"/></p>
                                <p><strong>Prix total :</strong> <t t-esc="reservation.prix_total"/> €</p>
                            </div>
                        </div>

                        <a t-attf-href="/paiement?amount=#{reservation.prix_total}&amp;reservation_id=#{reservation.id}" class="btn btn-success btn-lg mt-4 me-2">
                            <i class="fa fa-credit-card me-2"/>
                            Proceder au paiement
                        </a>
                        <a href="/travels" class="btn btn-primary mt-4">
                            Voir d'autres voyages
                        </a>

                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>