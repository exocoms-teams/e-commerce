<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════
         TEMPLATE 1 : TABLEAU DE BORD VENDEUR
         URL : /vendor/dashboard
         Variables Python disponibles : vendor, products, orders_count
         ═══════════════════════════════════════════════════════ -->
    <template id="vendor_dashboard"
              name="Portail Vendeur - Tableau de bord">
        <t t-call="website.layout">
            <!-- Variables de la page (titre, meta) -->
            <t t-set="pageName" t-value="'Tableau de bord vendeur'"/>

            <div class="mn-vendor-portal">

                <!-- En-tete du portail -->
                <div class="mn-vendor-header">
                    <div class="mn-container">
                        <div class="mn-vendor-header__inner">
                            <div class="mn-vendor-header__info">
                                <!-- Logo du vendeur -->
                                <t t-if="vendor.logo">
                                    <img t-attf-src="/web/image/marketplace.vendor/#{vendor.id}/logo"
                                         class="mn-vendor-avatar"
                                         t-att-alt="vendor.name"/>
                                </t>
                                <t t-else="">
                                    <div class="mn-vendor-avatar mn-vendor-avatar--placeholder">
                                        <span t-esc="vendor.name[0].upper()"/>
                                    </div>
                                </t>
                                <div>
                                    <h1 class="mn-vendor-header__name"
                                        t-esc="vendor.name"/>
                                    <p class="mn-vendor-header__email"
                                       t-esc="vendor.email or ''"/>
                                </div>
                            </div>
                            <!-- Navigation du portail -->
                            <nav class="mn-vendor-nav">
                                <a href="/vendor/dashboard"
                                   class="mn-vendor-nav__link mn-vendor-nav__link--active">
                                    Tableau de bord
                                </a>
                                <a href="/vendor/products"
                                   class="mn-vendor-nav__link">
                                    Mes produits
                                </a>
                                <a href="/vendor/orders"
                                   class="mn-vendor-nav__link">
                                    Mes commandes
                                </a>
                            </nav>
                        </div>
                    </div>
                </div>

                <!-- Corps du tableau de bord -->
                <div class="mn-vendor-body">
                    <div class="mn-container">

                        <!-- Cartes de statistiques -->
                        <div class="mn-vendor-stats">
                            <div class="mn-vendor-stat">
                                <span class="mn-vendor-stat__number"
                                      t-esc="vendor.product_count"/>
                                <span class="mn-vendor-stat__label">Produits actifs</span>
                            </div>
                            <div class="mn-vendor-stat">
                                <span class="mn-vendor-stat__number"
                                      t-esc="orders_count"/>
                                <span class="mn-vendor-stat__label">Commandes ce mois</span>
                            </div>
                            <div class="mn-vendor-stat">
                                <span class="mn-vendor-stat__number"
                                      t-esc="len(vendor.website_ids)"/>
                                <span class="mn-vendor-stat__label">Sites actifs</span>
                            </div>
                        </div>

                        <!-- Liste des produits -->
                        <div class="mn-vendor-section">
                            <div class="mn-vendor-section__header">
                                <h2>Mes produits</h2>
                            </div>

                            <!-- Cas : aucun produit -->
                            <t t-if="not products">
                                <div class="mn-vendor-empty">
                                    <p>Vous n'avez pas encore de produits.</p>
                                    <p>Contactez l'administrateur pour en ajouter.</p>
                                </div>
                            </t>

                            <!-- Cas : des produits existent -->
                            <t t-else="">
                                <div class="mn-vendor-products">
                                    <t t-foreach="products" t-as="product">
                                        <div class="mn-vendor-product-card">
                                            <!-- Image du produit -->
                                            <div class="mn-vendor-product-card__img">
                                                <t t-if="product.image_512">
                                                    <img t-attf-src="/web/image/product.template/#{product.id}/image_512"
                                                         t-att-alt="product.name"/>
                                                </t>
                                            </div>
                                            <!-- Infos produit -->
                                            <div class="mn-vendor-product-card__body">
                                                <h3 t-esc="product.name"/>
                                                <p class="mn-vendor-product-card__price">
                                                    <t t-esc="'%.2f EUR HT' % product.list_price"/>
                                                </p>
                                                <!-- Badge publie/non publie -->
                                                <span t-if="product.website_published"
                                                      class="mn-vendor-badge mn-vendor-badge--green">
                                                    Publie
                                                </span>
                                                <span t-else=""
                                                      class="mn-vendor-badge mn-vendor-badge--gray">
                                                    Non publie
                                                </span>
                                            </div>
                                            <!-- Actions -->
                                            <div class="mn-vendor-product-card__actions">
                                                <a t-attf-href="/vendor/product/#{product.id}/edit"
                                                   class="mn-btn mn-btn--outline mn-btn--sm">
                                                    Modifier
                                                </a>
                                                <a t-attf-href="/shop/product/#{product.id}"
                                                   class="mn-btn mn-btn--sm"
                                                   target="_blank">
                                                    Voir en boutique
                                                </a>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>


    <!-- ═══════════════════════════════════════════════════════
         TEMPLATE 2 : FORMULAIRE D'EDITION D'UN PRODUIT
         URL : /vendor/product/<id>/edit
         Variables Python disponibles : vendor, product, error, success
         ═══════════════════════════════════════════════════════ -->
    <template id="vendor_product_edit"
              name="Portail Vendeur - Edition produit">
        <t t-call="website.layout">
            <div class="mn-vendor-portal">

                <!-- En-tete reutilise (meme navigation) -->
                <div class="mn-vendor-header">
                    <div class="mn-container">
                        <div class="mn-vendor-header__inner">
                            <div class="mn-vendor-header__info">
                                <h1 class="mn-vendor-header__name"
                                    t-esc="vendor.name"/>
                            </div>
                            <nav class="mn-vendor-nav">
                                <a href="/vendor/dashboard"
                                   class="mn-vendor-nav__link">
                                    Tableau de bord
                                </a>
                                <a href="/vendor/products"
                                   class="mn-vendor-nav__link mn-vendor-nav__link--active">
                                    Mes produits
                                </a>
                            </nav>
                        </div>
                    </div>
                </div>

                <!-- Formulaire d'edition -->
                <div class="mn-vendor-body">
                    <div class="mn-container">
                        <div class="mn-vendor-form-wrapper">

                            <!-- Messages d'erreur / succes -->
                            <t t-if="error">
                                <div class="mn-vendor-alert mn-vendor-alert--error">
                                    <t t-esc="error"/>
                                </div>
                            </t>
                            <t t-if="success">
                                <div class="mn-vendor-alert mn-vendor-alert--success">
                                    Produit mis a jour avec succes.
                                </div>
                            </t>

                            <h2>Modifier : <t t-esc="product.name"/></h2>

                            <!-- Formulaire HTML POST -->
                            <form method="POST"
                                  t-attf-action="/vendor/product/#{product.id}/edit"
                                  class="mn-vendor-form">
                                <!-- Token CSRF Odoo (obligatoire pour les POST) -->
                                <input type="hidden"
                                       name="csrf_token"
                                       t-att-value="request.csrf_token()"/>

                                <!-- Champ : Prix HT -->
                                <div class="mn-vendor-form__group">
                                    <label for="list_price">Prix HT (EUR)</label>
                                    <input type="number"
                                           name="list_price"
                                           id="list_price"
                                           step="0.01"
                                           min="0"
                                           t-att-value="product.list_price"
                                           class="mn-vendor-form__input"
                                           required="required"/>
                                </div>

                                <!-- Champ : Description de vente -->
                                <div class="mn-vendor-form__group">
                                    <label for="description_sale">
                                        Description commerciale
                                    </label>
                                    <textarea name="description_sale"
                                              id="description_sale"
                                              rows="5"
                                              class="mn-vendor-form__textarea">
                                        <t t-esc="product.description_sale or ''"/>
                                    </textarea>
                                </div>

                                <!-- Boutons -->
                                <div class="mn-vendor-form__actions">
                                    <button type="submit"
                                            class="mn-btn mn-btn--primary">
                                        Enregistrer les modifications
                                    </button>
                                    <a href="/vendor/dashboard"
                                       class="mn-btn mn-btn--outline">
                                        Annuler
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>


    <!-- ═══════════════════════════════════════════════════════
         TEMPLATE 3 : PAGE COMMANDES DU VENDEUR
         URL : /vendor/orders
         Variables Python disponibles : vendor, orders
         ═══════════════════════════════════════════════════════ -->
    <template id="vendor_orders"
              name="Portail Vendeur - Commandes">
        <t t-call="website.layout">
            <div class="mn-vendor-portal">
                <div class="mn-vendor-header">
                    <div class="mn-container">
                        <h1>Commandes recentes</h1>
                    </div>
                </div>
                <div class="mn-vendor-body">
                    <div class="mn-container">
                        <t t-if="not orders">
                            <p>Aucune commande pour le moment.</p>
                        </t>
                        <t t-else="">
                            <table class="mn-vendor-table">
                                <thead>
                                    <tr>
                                        <th>Commande</th>
                                        <th>Date</th>
                                        <th>Produit</th>
                                        <th>Quantite</th>
                                        <th>Montant HT</th>
                                        <th>Etat</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="orders" t-as="line">
                                        <tr>
                                            <td t-esc="line.order_id.name"/>
                                            <td t-esc="line.order_id.date_order.strftime('%d/%m/%Y')"/>
                                            <td t-esc="line.product_id.name"/>
                                            <td t-esc="int(line.product_uom_qty)"/>
                                            <td>
                                                <t t-esc="'%.2f EUR' % line.price_subtotal"/>
                                            </td>
                                            <td t-esc="line.order_id.state"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>


    <!-- ═══════════════════════════════════════════════════════
         EXTENSION : ajout du lien Portail Vendeur dans le menu
         utilisateur du site (widget portal Odoo)
         ═══════════════════════════════════════════════════════ -->
    <template id="portal_my_home_marketplace"
              name="Portail Vendeur - Lien menu utilisateur"
              inherit_id="portal.portal_my_home"
              priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <!-- Affiche le lien seulement si l'utilisateur est un vendeur -->
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Mon espace vendeur</t>
                <t t-set="url">/vendor/dashboard</t>
                <t t-set="placeholder_count">0</t>
            </t>
        </xpath>
    </template>

</odoo>
