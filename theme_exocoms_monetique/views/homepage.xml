<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="monetiques_homepage" inherit_id="website.homepage" name="Homepage Monetiques.fr">
            <!-- On remplace le div oe_empty de la page d'accueil par défaut par nos snippets pour que le site ne soit pas vide -->
            <xpath expr="//div[@id='wrap']" position="replace">
                <div id="wrap" class="oe_structure">
                    <t t-call="theme_exocoms_monetique.s_hero_monetiques"/>
                    <t t-call="theme_exocoms_monetique.s_pourquoi_monetiques"/>
                    <t t-call="theme_exocoms_monetique.s_services_monetiques"/>
                    <t t-call="theme_exocoms_monetique.s_trust_security"/>
                    <t t-call="theme_exocoms_monetique.s_bestsellers_monetiques"/>
                    <t t-call="theme_exocoms_monetique.s_reviews_monetiques"/>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
