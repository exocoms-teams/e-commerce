<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Header Customization -->
        <template id="header_monetiques" inherit_id="website.layout" name="Header Monetiques.fr">
            <xpath expr="//header" position="replace">
                <header class="o_header_standard sticky-top bg-white shadow-sm" id="header_monetiques">
                    <nav class="navbar navbar-expand-lg navbar-light">
                        <div class="container">
                            <!-- Logo -->
                            <a href="/" class="navbar-brand logo">
                                <span class="fw-bold text-primary">Monetiques.fr</span>
                            </a>
                            
                            <!-- Mobile Toggle -->
                            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#top_menu_collapse" aria-controls="top_menu_collapse" aria-expanded="false" aria-label="Toggle navigation">
                                <span class="navbar-toggler-icon"></span>
                            </button>

                            <!-- Navigation Links -->
                            <div class="collapse navbar-collapse" id="top_menu_collapse">
                                <ul class="navbar-nav ms-auto mb-2 mb-lg-0" id="top_menu">
                                    <li class="nav-item"><a href="/" class="nav-link">Accueil</a></li>
                                    <li class="nav-item"><a href="/shop" class="nav-link">Boutique</a></li>
                                    <li class="nav-item"><a href="/contrat" class="nav-link">Contrats</a></li>
                                    <li class="nav-item"><a href="/services" class="nav-link">Services</a></li>
                                </ul>
                                
                                <!-- Search & Cart -->
                                <div class="d-flex ms-lg-3 align-items-center">
                                    <a href="/shop/cart" class="btn btn-outline-secondary btn-sm me-2 position-relative">
                                        <i class="fa fa-shopping-cart"></i>
                                        <sup class="my_cart_quantity badge bg-primary rounded-pill d-none" data-oe-model="ir.ui.view" data-oe-id="website_sale.header_cart_link">0</sup>
                                    </a>
                                    <a href="/contactus" class="btn btn-primary btn-sm">Contact</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </header>
            </xpath>
        </template>

        <!-- Footer Customization -->
        <template id="footer_monetiques" inherit_id="website.layout" name="Footer Monetiques.fr">
            <xpath expr="//footer" position="replace">
                <footer class="bg-dark text-white pt-5 pb-3">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-4 mb-4">
                                <h5 class="fw-bold text-primary mb-3">Monetiques.fr</h5>
                                <p class="text-muted">La référence B2B des solutions monétiques. TPE, maintenance, contrats.</p>
                                <div class="social-links mt-3">
                                    <a href="#" class="text-white me-2"><i class="fa fa-linkedin"></i></a>
                                    <a href="#" class="text-white me-2"><i class="fa fa-twitter"></i></a>
                                </div>
                            </div>
                            <div class="col-lg-2 col-6 mb-4">
                                <h6 class="text-uppercase mb-3">Produits</h6>
                                <ul class="list-unstyled">
                                    <li><a href="/shop/category/tpe-fixes" class="text-muted text-decoration-none">TPE Fixes</a></li>
                                    <li><a href="/shop/category/tpe-mobiles" class="text-muted text-decoration-none">TPE Mobiles</a></li>
                                    <li><a href="/shop/category/accessoires" class="text-muted text-decoration-none">Accessoires</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-2 col-6 mb-4">
                                <h6 class="text-uppercase mb-3">Services</h6>
                                <ul class="list-unstyled">
                                    <li><a href="/contrat" class="text-muted text-decoration-none">Contrat Monétique</a></li>
                                    <li><a href="/services" class="text-muted text-decoration-none">Maintenance</a></li>
                                    <li><a href="/faq" class="text-muted text-decoration-none">FAQ</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-4 mb-4">
                                <h6 class="text-uppercase mb-3">Paiement Sécurisé</h6>
                                <p class="text-muted mb-2">Accepté : CB, Visa, Mastercard, Mandat Administratif (Chorus Pro).</p>
                                <!-- Trust badges here -->
                            </div>
                        </div>
                        <hr class="border-secondary mt-4 mb-4"/>
                        <div class="row align-items-center">
                            <div class="col-md-6 text-center text-md-start">
                                <p class="mb-0 text-muted small">&amp;copy; 2026 EXOCOMS Group - Monetiques.fr. Tous droits réservés.</p>
                            </div>
                            <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                                <a href="/cgv" class="text-muted small me-3 text-decoration-none">CGV</a>
                                <a href="/mentions-legales" class="text-muted small text-decoration-none">Mentions Légales</a>
                            </div>
                        </div>
                    </div>
                </footer>
            </xpath>
        </template>
    </data>
</odoo>
