<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Registering Snippets into the Website Builder Blocks -->
        <template id="snippets" inherit_id="website.snippets" name="Monetiques Snippets">
            <xpath expr="//div[@id='snippet_structure']" position="inside">
                <div class="o_panel_header">
                    <i class="fa fa-credit-card"/> Monetiques.fr
                </div>
                <div class="o_panel_body">
                    <t t-snippet="theme_exocoms_monetique.s_hero_monetiques" t-thumbnail="/theme_exocoms_monetique/static/src/img/s_hero_thumb.png"/>
                    <t t-snippet="theme_exocoms_monetique.s_pourquoi_monetiques" t-thumbnail="/theme_exocoms_monetique/static/src/img/s_pourquoi_thumb.png"/>
                    <t t-snippet="theme_exocoms_monetique.s_services_monetiques" t-thumbnail="/theme_exocoms_monetique/static/src/img/s_services_thumb.png"/>
                    <t t-snippet="theme_exocoms_monetique.s_bestsellers_monetiques" t-thumbnail="/theme_exocoms_monetique/static/src/img/s_bestsellers_thumb.png"/>
                    <t t-snippet="theme_exocoms_monetique.s_reviews_monetiques" t-thumbnail="/theme_exocoms_monetique/static/src/img/s_reviews_thumb.png"/>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
