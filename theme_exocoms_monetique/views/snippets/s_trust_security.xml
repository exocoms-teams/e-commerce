<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="s_trust_security" name="Trust et Sécurité">
            <section class="s_trust_security pt64 pb64 bg-dark text-white" data-snippet="s_trust_security" data-name="Sécurité">
                <div class="container">
                    <div class="text-center mb-5">
                        <h2 class="fw-bold gradient-text-primary">Sécurité de Niveau Bancaire</h2>
                        <p class="text-light opacity-75">Vos transactions et vos données sont protégées par les plus hauts standards de l'industrie.</p>
                    </div>
                    <div class="row g-4 justify-content-center">
                        <div class="col-md-3">
                            <div class="glass-card text-center p-4 rounded-4 h-100">
                                <i class="fa fa-lock fa-3x text-info mb-3 glow-icon"></i>
                                <h6 class="fw-bold mb-2">Chiffrement AES-256</h6>
                                <p class="small text-light opacity-75 mb-0">Toutes vos données sont chiffrées de bout en bout pour une confidentialité totale.</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="glass-card text-center p-4 rounded-4 h-100">
                                <i class="fa fa-shield fa-3x text-info mb-3 glow-icon"></i>
                                <h6 class="fw-bold mb-2">Conformité PCI-DSS v6</h6>
                                <p class="small text-light opacity-75 mb-0">Notre infrastructure et nos terminaux répondent aux exigences mondiales de sécurité.</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="glass-card text-center p-4 rounded-4 h-100">
                                <i class="fa fa-bank fa-3x text-info mb-3 glow-icon"></i>
                                <h6 class="fw-bold mb-2">Paiements B2B Sécurisés</h6>
                                <p class="small text-light opacity-75 mb-0">Mandat administratif, Chorus Pro, et 3D Secure 2.0 pris en charge nativement.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </template>
    </data>
