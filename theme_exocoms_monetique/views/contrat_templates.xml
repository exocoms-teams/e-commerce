<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="contrat_page_template" name="Contrat Monétique - Monetiques.fr">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    
                    <!-- Notification Success -->
                    <t t-if="callback_success">
                        <div class="alert alert-success alert-dismissible fade show text-center mb-0" role="alert">
                            <strong>Merci !</strong> Votre demande de rappel a bien été prise en compte. Un conseiller EXOCOMS vous contactera sous peu.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    </t>

                    <!-- Hero Section -->
                    <section class="py-5 bg-white border-bottom">
                        <div class="container">
                            <div class="row align-items-center">
                                <div class="col-lg-6">
                                    <span class="badge bg-cyan text-white mb-3">CONTRATS D'ACQUISITION</span>
                                    <h1 class="display-4 fw-bold text-dark mb-3">Optimisez votre contrat monétique</h1>
                                    <p class="lead text-muted mb-4">
                                        Économisez sur vos commissions bancaires et profitez d'une passerelle monétique moderne, sécurisée et sans frais cachés.
                                    </p>
                                    <a href="#callback-section" class="btn btn-primary rounded-pill px-4 py-2">Être rappelé par un expert</a>
                                </div>
                                <div class="col-lg-6 text-center mt-4 mt-lg-0">
                                    <div class="p-4 bg-light rounded-4 shadow-sm">
                                        <h3 class="fw-bold mb-3">Simulez vos gains</h3>
                                        <p class="text-muted">Nos clients économisent en moyenne <strong>22%</strong> sur leurs frais d'encaissement annuels.</p>
                                        <hr class="my-4"/>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span>Taux moyen constaté</span>
                                            <span class="text-danger fw-bold">1.2% + 0.10€</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mb-4">
                                            <span>Taux Monetiques.fr</span>
                                            <span class="text-success fw-bold">0.6% (Fixe)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Pourquoi / Avantages -->
                    <section class="py-5 bg-light">
                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 class="fw-bold">Pourquoi souscrire chez nous ?</h2>
                                <p class="text-muted">Des avantages clairs pour booster vos ventes en point de vente.</p>
                            </div>
                            <div class="row g-4">
                                <div class="col-md-4">
                                    <div class="card h-100 border-0 shadow-sm p-4 rounded-3 bg-white">
                                        <div class="text-primary mb-3">
                                            <i class="fa fa-percent fa-2x"></i>
                                        </div>
                                        <h5 class="fw-bold">Commissions réduites</h5>
                                        <p class="text-muted small">Des taux négociés ultra-compétitifs sur toutes les cartes bancaires nationales et internationales.</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card h-100 border-0 shadow-sm p-4 rounded-3 bg-white">
                                        <div class="text-primary mb-3">
                                            <i class="fa fa-refresh fa-2x"></i>
                                        </div>
                                        <h5 class="fw-bold">Sans engagement</h5>
                                        <p class="text-muted small">Liberté totale. Vous restez chez nous pour la qualité du service, pas pour un contrat contraignant.</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card h-100 border-0 shadow-sm p-4 rounded-3 bg-white">
                                        <div class="text-primary mb-3">
                                            <i class="fa fa-tachometer fa-2x"></i>
                                        </div>
                                        <h5 class="fw-bold">Télécollecte ultra-rapide</h5>
                                        <p class="text-muted small">Vos fonds crédités sur votre compte bancaire à J+1 pour optimiser votre trésorerie.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Comparateur de Contrats -->
                    <section class="py-5 bg-white">
                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 class="fw-bold">Comparez les offres</h2>
                                <p class="text-muted">Transparence totale, aucun frais caché.</p>
                            </div>
                            <div class="table-responsive rounded-3 shadow-sm border">
                                <table class="table table-hover mb-0 bg-white align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="py-3">Fonctionnalité</th>
                                            <th class="py-3 text-center">Banque Classique</th>
                                            <th class="py-3 text-center text-primary fw-bold">Monetiques.fr (EXOCOMS)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="py-3">Frais d'installation</td>
                                            <td class="text-center">Jusqu'à 150€</td>
                                            <td class="text-center text-success fw-bold">Gratuit</td>
                                        </tr>
                                        <tr>
                                            <td class="py-3">Commission par transaction</td>
                                            <td class="text-center">Variable (souvent 1% + frais fixes)</td>
                                            <td class="text-center text-success fw-bold">Dès 0.5% sans frais fixe</td>
                                        </tr>
                                        <tr>
                                            <td class="py-3">Engagement</td>
                                            <td class="text-center">12 à 24 mois</td>
                                            <td class="text-center text-success fw-bold">Sans engagement</td>
                                        </tr>
                                        <tr>
                                            <td class="py-3">Passerelle monétique IP/GPRS</td>
                                            <td class="text-center">Payante (10-15€/mois)</td>
                                            <td class="text-center text-success fw-bold">Inclus</td>
                                        </tr>
                                        <tr>
                                            <td class="py-3">Support client</td>
                                            <td class="text-center">Lundi au Vendredi (heures de bureau)</td>
                                            <td class="text-center text-success fw-bold">7j/7 - Prioritaire B2B</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>

                    <!-- Callback Section -->
                    <section id="callback-section" class="py-5 bg-light border-top">
                        <div class="container">
                            <div class="row justify-content-center">
                                <div class="col-lg-8 col-xl-7">
                                    <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 bg-white">
                                        <div class="text-center mb-4">
                                            <h3 class="fw-bold">Demander à être rappelé gratuitement</h3>
                                            <p class="text-muted">Un conseiller fait le point sur vos besoins sous 2 heures ouvrées.</p>
                                        </div>
                                        <form action="/contrat/callback" method="POST" class="row g-3">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <div class="col-md-6">
                                                <label for="name" class="form-label small fw-bold text-muted">Nom &amp; Prénom</label>
                                                <input type="text" class="form-control rounded-3" id="name" name="name" required="required" placeholder="Jean Dupont"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="company" class="form-label small fw-bold text-muted">Nom de l'entreprise</label>
                                                <input type="text" class="form-control rounded-3" id="company" name="company" required="required" placeholder="Boulangerie du Coin"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="phone" class="form-label small fw-bold text-muted">Téléphone</label>
                                                <input type="tel" class="form-control rounded-3" id="phone" name="phone" required="required" placeholder="06 12 34 56 78"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="email" class="form-label small fw-bold text-muted">Email professionnel</label>
                                                <input type="email" class="form-control rounded-3" id="email" name="email" required="required" placeholder="contact@boulangerie.fr"/>
                                            </div>
                                            <div class="col-12">
                                                <label for="contract_type" class="form-label small fw-bold text-muted">Type de contrat ciblé</label>
                                                <select class="form-select rounded-3" id="contract_type" name="contract_type">
                                                    <option value="TPE Fixe IP">TPE Fixe IP / Ethernet</option>
                                                    <option value="TPE Mobile 3G/4G">TPE Mobile 3G/4G</option>
                                                    <option value="Solution Multi-Vendeurs">Solution Multi-Vendeurs</option>
                                                    <option value="Secteur Public (Mandat)">Secteur Public (Mandat)</option>
                                                </select>
                                            </div>
                                            <div class="col-12 text-center mt-4">
                                                <button type="submit" class="btn btn-primary rounded-pill w-100 py-3 fw-bold">Valider la demande de rappel</button>
                                                <p class="text-muted small mt-2 mb-0">En validant ce formulaire, vous acceptez d'être recontacté(e) par EXOCOMS.</p>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- FAQ -->
                    <section class="py-5 bg-white border-top">
                        <div class="container">
                            <div class="text-center mb-5">
                                <h2 class="fw-bold">Foire aux questions</h2>
                                <p class="text-muted">Tout ce qu'il faut savoir sur nos contrats de flux monétiques.</p>
                            </div>
                            <div class="row justify-content-center">
                                <div class="col-lg-8">
                                    <div class="accordion border-0" id="accordionFaq">
                                        <div class="accordion-item border-bottom mb-3 pb-3">
                                            <h2 class="accordion-header" id="headingOne">
                                                <button class="accordion-button collapsed fw-bold bg-white shadow-none text-dark border-0 px-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                                                    Puis-je conserver ma banque actuelle ?
                                                </button>
                                            </h2>
                                            <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionFaq">
                                                <div class="accordion-body px-0 text-muted">
                                                    Oui. Nos contrats d'acquisition s'interfacent avec n'importe quel compte bancaire professionnel français. Les fonds collectés sont automatiquement transférés sur votre compte existant.
                                                </div>
                                            </div>
                                        </div>
                                        <div class="accordion-item border-bottom mb-3 pb-3">
                                            <h2 class="accordion-header" id="headingTwo">
                                                <button class="accordion-button collapsed fw-bold bg-white shadow-none text-dark border-0 px-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                                    Combien de temps prend l'activation du contrat ?
                                                </button>
                                            </h2>
                                            <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionFaq">
                                                <div class="accordion-body px-0 text-muted">
                                                    Une fois la demande de rappel effectuée et vos pièces justificatives reçues, la création de votre carte de domiciliation bancaire et la configuration de votre TPE prennent moins de 48 heures.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                </div>
            </t>
        </template>
    </data>
</odoo>
