<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Categories -->
        <record id="cat_tpe_mobiles" model="product.public.category">
            <field name="name">TPE Mobiles</field>
            <field name="sequence">1</field>
        </record>
        <record id="cat_tpe_fixes" model="product.public.category">
            <field name="name">TPE Fixes</field>
            <field name="sequence">2</field>
        </record>
        <record id="cat_accessoires" model="product.public.category">
            <field name="name">Accessoires &amp; Consommables</field>
            <field name="sequence">3</field>
        </record>

        <!-- Product 1: Pax A920 Pro -->
        <record id="product_pax_a920_pro" model="product.template">
            <field name="name">Pax A920 Pro (Android)</field>
            <field name="list_price">399.00</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('cat_tpe_mobiles')])]"/>
            <field name="website_published">True</field>
            <field name="description_sale">Le terminal Android haut de gamme par excellence. Écran tactile 5.5", double caméra, connectivité 4G/Wifi/Bluetooth. Conforme PCI-PTS v6.</field>
            <field name="type">consu</field>
        </record>

        <!-- Product 2: Verifone V240m -->
        <record id="product_verifone_v240m" model="product.template">
            <field name="name">Verifone V240m (3G/Wifi)</field>
            <field name="list_price">299.00</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('cat_tpe_mobiles')])]"/>
            <field name="website_published">True</field>
            <field name="description_sale">Idéal pour les livraisons et les marchés. Compact, robuste et équipé du paiement sans contact ultra-rapide.</field>
            <field name="type">consu</field>
        </record>

        <!-- Product 3: Ingenico Lane/5000 -->
        <record id="product_ingenico_lane5000" model="product.template">
            <field name="name">Ingenico Lane/5000 (Fixe)</field>
            <field name="list_price">349.00</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('cat_tpe_fixes')])]"/>
            <field name="website_published">True</field>
            <field name="description_sale">Le terminal de comptoir idéal pour la grande distribution et les commerces à fort trafic. Écran tactile et signature électronique.</field>
            <field name="type">consu</field>
        </record>

        <!-- Product 4: Rouleaux thermiques -->
        <record id="product_rouleaux_thermiques" model="product.template">
            <field name="name">Lot de 20 Rouleaux Thermiques TPE</field>
            <field name="list_price">19.90</field>
            <field name="public_categ_ids" eval="[(6, 0, [ref('cat_accessoires')])]"/>
            <field name="website_published">True</field>
            <field name="description_sale">Rouleaux de papier thermique de haute qualité 57x40x12mm. Sans bisphénol A. Compatible tous TPE.</field>
            <field name="type">consu</field>
        </record>
    </data>
</odoo>
