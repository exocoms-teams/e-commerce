<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Page-->


    <!-- Product Card -->
    
    <template id="my_products" inherit_id="website_sale.products">

        <xpath expr="//t[@t-call='website_sale.products_item']"
            position="replace">

            <t t-call="custom_supplements.products_item"/>

        </xpath>

    </template>

    <template id="products_item">

        <div class="card border-0 rounded-4 overflow-hidden h-100 shadow-sm">

            <!-- Image -->
            <a t-att-href="product.website_url"
            class="d-flex align-items-center justify-content-center bg-light ratio ratio-1x1">

                <img
                    t-att-src="image_url"
                    class="img-fluid object-fit-contain p-4"
                    t-att-alt="product.name"/>
            </a>

            <!-- Footer -->
            <div class="card-body p-3">

                <div class="d-flex justify-content-between align-items-end">

                    <div class="flex-grow-1 me-3">

                        <h5 class="card-title mb-1 fw-medium">
                            <t t-esc="product.name"/>
                        </h5>

                        <div class="text-muted">
                            From :
                            <span class="text-decoration-line-through">
                                $79.00
                            </span>
                        </div>

                    </div>

                    <button class="btn btn-dark rounded-3">
                        <i class="fa fa-shopping-cart"/>
                    </button>

                </div>

            </div>

        </div>

    </template>

</odoo>
