<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_header_supplements" inherit_id="website.layout"
        name="Supplements Header" active="True">

        <xpath expr="//header//nav" position="replace">

            <t t-call="website.navbar">
                <t t-set="_navbar_classes" t-valuef="shadow-sm bg-white"/>

                <div class="container">

                    <!-- Logo -->
                    <t t-call="website.placeholder_header_brand"/>

                    <!-- Menu -->
                    <t t-call="website.navbar_nav"
                    _nav_class="me-auto">

                        <t t-foreach="website.menu_id.child_id"
                        t-as="submenu">

                            <t t-call="website.submenu"
                            item_class="nav-item"
                            link_class="nav-link"/>

                        </t>

                    </t>

                    <!-- Right side -->
                    <ul class="navbar-nav ms-auto align-items-center">

                        <t t-call="website.placeholder_header_search_box"/>

                        <t t-call="website.placeholder_header_language_selector"/>

                        <t t-call="portal.placeholder_user_sign_in"/>

                        <t t-call="portal.user_dropdown"/>

                        <!-- website_sale placeholder -->
                        <t t-call="website_sale.header_cart_link"/>

                    </ul>

                </div>

            </t>

        </xpath>

    </template>


    <template id="custom_footer" inherit_id="website.layout" priority="1000">
        <xpath expr="//footer" position="replace">
            <footer>
                <h1>FOOTER HERE</h1>
            </footer>
        </xpath>
    </template>



</odoo>