<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_header" inherit_id="website.layout" priority="1000">

        <xpath expr="//header" position="replace">

            <header id="top" class="o_affix_enabled o_header_fixed">
                <!-- Navbar Desktop -->
                <nav class="cs-header d-none d-lg-block navbar navbar-expand-lg">
                    <div class="container">
                        <t t-call="website.placeholder_header_brand"/>
                        <ul class="navbar-nav me-auto">
                                <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                    <t t-call="website.submenu">
                                        <t t-set="is_mobile" t-value="False"/>
                                        <t t-set="is_vertical_nav" t-value="False"/>
                                        <t t-set="offcanvas_is_leftside" t-value="False"/>
                                        <t t-set="item_class" t-value="'nav-item'"/>
                                        <t t-set="link_class" t-value="'nav-link'"/>
                                    </t>
                                </t>
                        </ul>
                        <ul class="navbar-nav align-items-center ms-auto gap-2">
                            <li class="nav-item">
                                <t t-call="website.placeholder_header_search_box"/>
                            </li>
                            <li class="nav-item">
                                <t t-call="website_sale.header_cart_link">
                                    <t t-set="_item_class">nav-item</t>
                                    <t t-set="_link_class">nav-link</t>
                                    <t t-set="_icon_wrap_class">position-relative</t>
                                    <t t-set="_badge_class">position-absolute top-0 start-100 translate-middle</t>
                                    <t t-set="_icon" t-value="True"/>
                                    <t t-set="_text" t-value="False"/>
                                </t>

                            </li>
                            <li class="nav-item">
                                <t t-call="portal.placeholder_user_sign_in"/>
                                <t t-call="portal.user_dropdown" _user_name="True"/>
                            </li>
                        </ul>
                    </div>
                </nav>
                <!-- Navbar Mobile -->
                <nav class="cs-header d-lg-none d-block navbar">
                    <div class="container flex-wrap justify-content-between">
                        <t t-call="website.placeholder_header_brand"/>
                        <ul class="navbar-nav ms-auto">
                            <t t-call="website_sale.header_cart_link">
                                <t t-set="_item_class">nav-item</t>
                                <t t-set="_link_class">nav-link</t>
                                <t t-set="_icon_wrap_class">position-relative</t>
                                <t t-set="_badge_class">position-absolute top-0 start-100 translate-middle</t>
                                <t t-set="_icon" t-value="True"/>
                                <t t-set="_text" t-value="False"/>
                            </t>
                            
                        </ul>
                        <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#mobile_menu"
                            aria-controls="mobile_menu"
                            aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"/>
                        </button>
                        <div class="offcanvas offcanvas-end" id="mobile_menu">
                            <div class="offcanvas-header">
                                <ul class="navbar-nav">
                                    <t t-call="website.placeholder_header_search_box"/>
                                </ul>
                                <button type="button" class="btn-close" data-bs-dismiss="offcanvas"/>
                            </div>
                            <div class="offcanvas-body">
                                <ul class="navbar-nav">
                                    <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                        <t t-call="website.submenu">
                                            <t t-set="is_mobile" t-value="True"/>
                                            <t t-set="is_vertical_nav" t-value="False"/>
                                            <t t-set="offcanvas_is_leftside" t-value="False"/>
                                            <t t-set="item_class" t-value="'nav-item'"/>
                                            <t t-set="link_class" t-value="'nav-link'"/>
                                        </t>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </div>
                </nav>
            </header>

        </xpath>

        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo border text-break" t-ignore="true" t-if="not no_footer" style="--box-border-left-width: 0px; --box-border-right-width: 0px;">
                <section class="s_text_block pt40 pb16" data-snippet="s_text_block" data-name="Container">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-2 pt24 pb24">
                                <h5>Useful Links</h5>
                                <ul class="list-unstyled">
                                    <li><a href="/">Home</a></li>
                                    <li><a href="/aboutus">A Propos</a></li>
                                    <li><a href="/shop">Produits</a></li>
                                    <li><a href="/legals">Mentions Légales</a></li>
                                    <t t-set="configurator_footer_links" t-value="[]"/>
                                    <li t-foreach="configurator_footer_links" t-as="link">
                                        <a t-att-href="link['href']" t-out="link['text']"/>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-lg-5 pt24 pb24">
                                <h5>A Propos</h5>
                                <p>Nous croyons que le bien-être commence de l’intérieur. Notre mission est de vous proposer des compléments alimentaires de qualité, conçus pour accompagner votre santé, votre énergie et votre bien-être au quotidien. 
                                <br/><br/>Des ingrédients soigneusement sélectionnés et des formules fiables pour vous aider à prendre soin de vous, simplement.</p>
                            </div>
                            <div class="col-lg-4 offset-lg-1 pt24 pb24">
                                <h5>Connect with us</h5>
                                <ul class="list-unstyled">
                                    <li><i class="fa fa-comment fa-fw me-2"/><a href="/contactus">Contact us</a></li>
                                    <li><i class="fa fa-envelope fa-fw me-2"/><a href="mailto:info@yourcompany.example.com">info@yourcompany.example.com</a></li>
                                    <li><i class="fa fa-phone fa-fw me-2"/><a href="tel:+1 555-555-5556"><span class="o_force_ltr">+1 555-555-5556</span></a></li>
                                </ul>
                                <div class="s_social_media text-start o_not_editable" data-snippet="s_social_media" data-name="Social Media" contenteditable="false">
                                    <h5 class="s_social_media_title d-none" contenteditable="true">Follow us</h5>
                                    <a href="/website/social/facebook" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                        <i class="fa fa-facebook rounded-circle shadow-sm o_editable_media"/>
                                    </a>
                                    <a href="/website/social/twitter" class="s_social_media_twitter" target="_blank" aria-label="X">
                                        <i class="fa fa-twitter rounded-circle shadow-sm o_editable_media"/>
                                    </a>
                                    <a href="/website/social/linkedin" class="s_social_media_linkedin" target="_blank" aria-label="LinkedIn">
                                        <i class="fa fa-linkedin rounded-circle shadow-sm o_editable_media"/>
                                    </a>
                                    <a href="/" class="text-800" aria-label="Extra page">
                                        <i class="fa fa-home rounded-circle shadow-sm o_editable_media"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>



</odoo>