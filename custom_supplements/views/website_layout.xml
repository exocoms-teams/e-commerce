<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_header" inherit_id="website.layout" priority="1000">

        <xpath expr="//header" position="replace">

            <header id="top">

                <!-- Desktop -->
                <div class="d-none d-lg-block">
                    ...
                </div>

                <!-- Mobile -->
                <div class="d-lg-none">
                    ...
                </div>

            </header>

        </xpath>

</template>


    <template id="custom_footer" inherit_id="website.layout" priority="1000">
        <xpath expr="//footer" position="replace">
            <footer>
                <h1>FOOTER HERE</h1>
            </footer>
        </xpath>
    </template>



</odoo>