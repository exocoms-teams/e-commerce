<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_header" inherit_id="website.layout" name="Compléments — navigation premium" priority="1000">
        <xpath expr="//header" position="replace">
            <header id="top" class="cs-site-header">
                <div class="cs-announcement">Livraison offerte dès 49 € <span>•</span> Formules sélectionnées avec exigence</div>
                <nav class="navbar navbar-expand-lg cs-navbar" aria-label="Navigation principale">
                    <div class="container cs-navbar-inner">
                        <t t-call="website.placeholder_header_brand"/>
                        <button class="navbar-toggler cs-menu-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#cs-mobile-menu" aria-controls="cs-mobile-menu" aria-label="Ouvrir le menu">
                            <i class="fa fa-bars" aria-hidden="true"/>
                        </button>
                        <div class="collapse navbar-collapse d-none d-lg-flex">
                            <ul class="navbar-nav mx-auto cs-main-nav">
                                <li class="nav-item"><a class="nav-link" href="/">Accueil</a></li>
                                <li class="nav-item"><a class="nav-link" href="/shop">Boutique</a></li>
                                <li class="nav-item"><a class="nav-link" href="/shop?order=create_date+desc">Nouveautés</a></li>
                                <li class="nav-item"><a class="nav-link" href="/shop?order=website_sequence">Meilleures ventes</a></li>
                                <li class="nav-item"><a class="nav-link" href="/shop?discounted=1">Promotions</a></li>
                                <li class="nav-item dropdown cs-mega-parent">
                                    <a class="nav-link dropdown-toggle" href="/shop" data-bs-toggle="dropdown" aria-expanded="false">Explorer</a>
                                    <div class="dropdown-menu cs-mega-menu p-4">
                                        <div class="row g-4">
                                            <div class="col-lg-4">
                                                <span class="cs-menu-label">Catégories</span>
                                                <t t-foreach="website.get_supplement_categories()" t-as="category">
                                                    <a class="cs-menu-link" t-att-href="'/shop/category/%s' % slug(category)"><t t-esc="category.name"/></a>
                                                    <t t-foreach="website.get_supplement_category_children(category)" t-as="child">
                                                        <a class="cs-menu-link cs-menu-link-child" t-att-href="'/shop/category/%s' % slug(child)"><t t-esc="child.name"/></a>
                                                    </t>
                                                </t>
                                            </div>
                                            <div class="col-lg-4">
                                                <span class="cs-menu-label">Ingrédients</span>
                                                <t t-foreach="website.get_supplement_attribute_values('ingrédient')" t-as="value">
                                                    <a class="cs-menu-link" t-att-href="'/shop?attrib=%s-%s' % (value.attribute_id.id, value.id)"><t t-esc="value.name"/></a>
                                                </t>
                                                <a class="cs-menu-link cs-menu-link-muted" href="/shop">Voir tous les ingrédients <i class="fa fa-arrow-right ms-1"/></a>
                                            </div>
                                            <div class="col-lg-4">
                                                <span class="cs-menu-label">Marques</span>
                                                <t t-foreach="website.get_supplement_attribute_values('marque')" t-as="value">
                                                    <a class="cs-menu-link" t-att-href="'/shop?attrib=%s-%s' % (value.attribute_id.id, value.id)"><t t-esc="value.name"/></a>
                                                </t>
                                                <a class="cs-menu-link cs-menu-link-muted" href="/shop">Toutes les marques <i class="fa fa-arrow-right ms-1"/></a>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                                <li class="nav-item"><a class="nav-link" href="/blog">Conseils</a></li>
                                <li class="nav-item"><a class="nav-link" href="/aboutus">À propos</a></li>
                            </ul>
                            <ul class="navbar-nav align-items-center cs-action-nav">
                                <li class="nav-item"><t t-call="website.placeholder_header_search_box"/></li>
                                <li class="nav-item"><t t-call="website_sale.header_cart_link"><t t-set="_icon" t-value="True"/><t t-set="_text" t-value="False"/></t></li>
                                <li class="nav-item"><t t-call="portal.placeholder_user_sign_in"/><t t-call="portal.user_dropdown" _user_name="False"/></li>
                            </ul>
                        </div>
                    </div>
                </nav>
                <div class="offcanvas offcanvas-end cs-mobile-menu" tabindex="-1" id="cs-mobile-menu" aria-labelledby="cs-mobile-menu-title">
                    <div class="offcanvas-header"><h2 class="h5 mb-0" id="cs-mobile-menu-title">Explorer</h2><button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"/></div>
                    <div class="offcanvas-body"><a class="cs-mobile-link" href="/">Accueil</a><a class="cs-mobile-link" href="/shop">Boutique</a><a class="cs-mobile-link" href="/shop?order=create_date+desc">Nouveautés</a><a class="cs-mobile-link" href="/shop?order=website_sequence">Meilleures ventes</a><a class="cs-mobile-link" href="/shop?discounted=1">Promotions</a><a class="cs-mobile-link" href="/blog">Conseils</a><a class="cs-mobile-link" href="/aboutus">À propos</a></div>
                </div>
            </header>
        </xpath>
        <xpath expr="//div[@id='footer']" position="replace">
            <footer id="footer" class="cs-footer" t-if="not no_footer">
                <div class="container"><div class="row g-5"><div class="col-lg-5"><t t-call="website.placeholder_footer_logo"/><p class="cs-footer-copy">Des formules ciblées, des ingrédients transparents et une routine bien-être qui vous ressemble.</p></div><div class="col-6 col-lg-2"><span class="cs-menu-label">Boutique</span><a href="/shop">Tous les produits</a><a href="/shop">Nouveautés</a><a href="/contactus">Nous contacter</a></div><div class="col-6 col-lg-2"><span class="cs-menu-label">Aide</span><a href="/faq">FAQ</a><a href="/shipping_delivery">Livraison</a><a href="/privacy">Confidentialité</a></div><div class="col-lg-3"><span class="cs-menu-label">Une question ?</span><a href="mailto:bonjour@complements.example">bonjour@complements.example</a><p class="small mt-3 mb-0">© 2026 Boutique Compléments</p></div></div></div>
            </footer>
        </xpath>
    </template>
</odoo>
