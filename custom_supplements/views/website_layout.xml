<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_navbar" inherit_id="website.navbar">
        <xpath expr="." position="replace">
            <header class="my-header">
                <div class="container">
                    <a href="/" class="navbar-brand">
                        My Logo
                    </a>

                    <nav>
                        <a href="/">Home</a>
                        <a href="/shop">Shop</a>
                        <a href="/contactus">Contact</a>
                    </nav>
                </div>
            </header>
        </xpath>
    </template>

    <template id="product_supplements_info" inherit_id="website.layout" priority="1000">
        <xpath expr="//footer" position="replace">
            <footer>
                <h1>FOOTER HERE</h1>
            </footer>
        </xpath>
    </template>



</odoo>