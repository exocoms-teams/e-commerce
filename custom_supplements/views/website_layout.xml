<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_header" inherit_id="website.layout" name="Vitalo — navigation premium" priority="1000">
        
        <!-- Injection des polices Google Fonts dans le head -->
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;500;600;700;900&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
        </xpath>

        <!-- Remplacement du Header natif -->
        <xpath expr="//header" position="replace">
            <div class="topbar">Livraison offerte dès 49 € · Fabriqué en France</div>
            <header class="vitalo-header">
                <div class="nav-wrap">
                    <a class="brand" href="/">
                        <span class="brand-mark">V</span> Vitalo
                    </a>
                    
                    <nav class="main-nav">
                        <div><a class="nav-link" href="/">Accueil</a></div>
                        
                        <!-- Menu Boutique + Boucle dynamique des catégories Odoo -->
                        <div>
                            <a class="nav-link" href="/shop">Boutique <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></a>
                            <div class="dropdown">
                                <div class="dropdown-col">
                                    <div class="label">Découvrir</div>
                                    <a href="/shop?order=create_date+desc">Nouveautés</a>
                                    <a href="/shop?order=website_sequence">Meilleures Ventes</a>
                                    <a href="/shop?discounted=1">Promotions</a>
                                </div>
                                <div class="dropdown-col">
                                    <div class="label">Catégories</div>
                                    <t t-foreach="website.get_supplement_categories()" t-as="category">
                                        <a t-att-href="'/shop/category/%s' % slug(category)"><t t-esc="category.name"/></a>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- Menu Ingrédients Odoo -->
                        <div>
                            <a class="nav-link" href="#">Ingrédients <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></a>
                            <div class="dropdown">
                                <div class="dropdown-col">
                                    <div class="label">Par ingrédient</div>
                                    <t t-foreach="website.get_supplement_attribute_values('ingrédient')" t-as="value">
                                        <a t-att-href="'/shop?attrib=%s-%s' % (value.attribute_id.id, value.id)"><t t-esc="value.name"/></a>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- Menu Marques Odoo -->
                        <div>
                            <a class="nav-link" href="#">Marques <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></a>
                            <div class="dropdown">
                                <div class="dropdown-col">
                                    <div class="label">Par marque</div>
                                    <t t-foreach="website.get_supplement_attribute_values('marque')" t-as="value">
                                        <a t-att-href="'/shop?attrib=%s-%s' % (value.attribute_id.id, value.id)"><t t-esc="value.name"/></a>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- Menu Conseils -->
                        <div>
                            <a class="nav-link" href="/blog">Conseils <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></a>
                            <div class="dropdown">
                                <div class="dropdown-col">
                                    <div class="label">Ressources</div>
                                    <a href="/blog">Articles</a>
                                    <a href="/faq">FAQ</a>
                                </div>
                            </div>
                        </div>
                        
                        <div><a class="nav-link" href="/aboutus">À propos</a></div>
                    </nav>

                    <!-- Intégration des composants natifs d'Odoo (Recherche, Compte, Panier) -->
                    <div class="nav-icons" style="display:flex; align-items:center; gap:22px;">
                        <t t-call="website.placeholder_header_search_box"/>
                        <t t-call="portal.placeholder_user_sign_in"/>
                        <t t-call="portal.user_dropdown"
                            _user_name="True"
                            _item_class.f="dropdown"
                            _link_class.f="{{_additional_btn_color or 'nav-link'}} border-0"
                            _dropdown_menu_class.f="dropdown-menu-end"
                        />
                        <t t-call="website_sale.header_cart_link">
                            <t t-set="_icon" t-value="True"/>
                            <t t-set="_text" t-value="False"/>
                        </t>
                    </div>
                </div>
            </header>
        </xpath>

        <!-- Remplacement du Footer natif -->
        <xpath expr="//div[@id='footer']" position="replace">
            <footer id="footer" class="vitalo-footer" t-if="not no_footer">
                <div class="footer-wrap">
                    <div class="footer-brand">
                        <h3>Vitalo</h3>
                        <p>Compléments alimentaires formulés en France, dosés à l'efficacité et testés en laboratoire indépendant.</p>
                    </div>
                    <div class="footer-col">
                        <div class="label">Boutique</div>
                        <ul>
                            <li><a href="/shop">Nouveautés</a></li>
                            <li><a href="/shop">Meilleures Ventes</a></li>
                            <li><a href="/shop">Promotions</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <div class="label">Objectifs</div>
                        <ul>
                            <li><a href="/shop">Énergie &amp; Vitalité</a></li>
                            <li><a href="/shop">Sommeil &amp; Stress</a></li>
                            <li><a href="/shop">Sport</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <div class="label">Conseils</div>
                        <ul>
                            <li><a href="/blog">Articles</a></li>
                            <li><a href="/faq">FAQ</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <div class="label">À propos</div>
                        <ul>
                            <li><a href="/aboutus">Notre Histoire</a></li>
                            <li><a href="/contactus">Contact</a></li>
                        </ul>
                    </div>
                </div>
                <div class="footer-bottom">© 2026 Vitalo — Tous droits réservés.</div>
            </footer>
        </xpath>
        
    </template>
</odoo>
