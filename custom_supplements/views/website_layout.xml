<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_header" inherit_id="website.layout" priority="1000">

        <xpath expr="//header" position="replace">

            <header id="top">

                <nav class="d-none d-lg-block navbar navbar-expand-lg">
                    <div class="container">
                        <t t-call="website.placeholder_header_brand"/>
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" href="/">Accueil</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/shop">Boutique</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/contactus">Contactez nous</a>
                            </li>
                        </ul>
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <t t-call="website.placeholder_header_search_box"/>
                            </li>
                            <li class="nav-item">
                                <t t-call="website_sale.header_cart_link"/>
                            </li>
                            <li class="nav-item">
                                <t t-call="portal.placeholder_user_sign_in"/>
                                <t t-call="portal.user_dropdown"/>
                            </li>
                        </ul>
                    </div>
                </nav>

                <nav class="d-lg-none">

                </nav>

            </header>

        </xpath>

</template>


    <template id="custom_footer" inherit_id="website.layout" priority="1000">
        <xpath expr="//footer" position="replace">
            <footer>
                <h1>FOOTER HERE</h1>
            </footer>
        </xpath>
    </template>



</odoo>