<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_header" inherit_id="website.template_header_default">

        <xpath expr="//header//nav" position="replace">
            <nav class="navbar navbar-expand-lg d-none d-lg-block">
                <div class="container">
                    <a href="/">
                        Desktop Header
                    </a>
                    <ul class="nav navbar-nav">
                        <li class="nav-item">
                            <a href="/">Home</a>
                        </li>
                        <li class="nav-item">
                            <a href="/shop">Shop</a>
                        </li>
                        <li class="nav-item">
                            <a href="/contactus">Contact Us</a>
                        </li>
                    </ul>
                    
                </div>
            </nav>
        </xpath>
    </template>    
    <template id="custom_mobile_header" inherit_id="website.template_header_mobile">

        <xpath expr="//header//nav" position="replace">
            <h1>MOBILE HEADER HERE</h1>
        </xpath>
    </template>

    <template id="custom_footer" inherit_id="website.layout" priority="1000">
        <xpath expr="//footer" position="replace">
            <footer>
                <h1>FOOTER HERE</h1>
            </footer>
        </xpath>
    </template>



</odoo>