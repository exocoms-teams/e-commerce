<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         PARTIE 1 : FONCTIONNALITÉS BOUTIQUE ET PRODUITS 
         ===================================================================== -->

    <!-- 1. Informations nutritionnelles -->
    <template id="product_supplements_info" inherit_id="website_sale.product" name="Infos Compléments">
        <xpath expr="//div[@id='product_details']" position="inside">
            <t t-if="product.is_supplement">
                <div class="alert alert-info mt-4" role="alert">
                    <h5 class="mb-2">Informations Nutritionnelles</h5>
                    <ul class="list-unstyled mb-2">
                        <li t-if="product.is_vegan">
                            <i class="fa fa-leaf text-success"/> <strong>100% Vegan</strong>
                        </li>
                        <li t-if="product.allergens">
                            <i class="fa fa-exclamation-triangle text-warning"/> 
                            <strong>Allergènes :</strong> <t t-esc="product.allergens"/>
                        </li>
                    </ul>
                    <div t-if="product.nutritional_info">
                        <t t-out="product.nutritional_info"/>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <!-- 2. Badge Vegan -->
    <template id="products_item_supplements_badge" inherit_id="website_sale.products_item" name="Badge Vegan Shop">
        <xpath expr="//form" position="inside">
            <t t-if="product.is_vegan">
                <span class="badge text-bg-success position-absolute shadow-sm" style="top: 10px; right: 10px; z-index: 10;">
                    <i class="fa fa-leaf"/> Vegan
                </span>
            </t>
        </xpath>
    </template>

    <!-- 3. Bouton Filtre Vegan à l'intérieur de la grille -->
    <template id="filter_vegan_sidebar" inherit_id="website_sale.products" name="Filtre Vegan">
        <xpath expr="//div[@id='products_grid']/*[1]" position="before">
            <div class="mb-4 mt-3">
                <h6 class="mb-2">Régime Spécial</h6>
                <a t-att-href="keep('/shop', vegan='1' if not request.params.get('vegan') else '')"
                   t-attf-class="btn btn-{{ 'success' if request.params.get('vegan') else 'outline-success' }} shadow-sm mb-3">
                    <i class="fa fa-leaf"/> 100% Vegan
                    <i t-if="request.params.get('vegan')" class="fa fa-times ms-2"/>
                </a>
            </div>
        </xpath>
    </template>

    <!-- 4. Alerte Allergènes dynamique dans le résumé du panier -->
    <template id="cart_allergen_alert" inherit_id="website_sale.total" name="Alerte Allergènes Panier">
        <xpath expr="." position="inside">
            <t t-set="has_supplements" t-value="any(line.product_id.is_supplement for line in website_sale_order.website_order_line)"/>
            <div t-if="has_supplements" class="alert alert-warning mt-3 mb-0 text-start shadow-sm" style="font-size: 0.85rem;" role="alert">
                <i class="fa fa-exclamation-triangle me-2"/> 
                <strong>Rappel Santé :</strong> Certains articles de votre commande sont des compléments alimentaires pouvant contenir des allergènes. Vérifiez les étiquettes.
            </div>
        </xpath>
    </template>

    <!-- 5. Nouveaux champs Dosage et Ingrédients -->
    <template id="custom_supplements_product_page" inherit_id="website_sale.product" name="Nutritional Info Supplements">
        <xpath expr="//div[@id='product_details']" position="inside">
            <t t-if="product.is_supplement">
                <div class="alert alert-info mt-4" role="alert">
                    <h5 class="alert-heading"><i class="fa fa-info-circle"/> Posologie et Composition</h5>
                    <hr/>
                    <ul class="list-unstyled mb-0">
                        <li><strong>Dosage recommandé :</strong> <span t-field="product.dosage"/></li>
                        <li><strong>Ingrédients actifs :</strong> <span t-field="product.ingredients"/></li>
                    </ul>
                </div>
            </t>
        </xpath>
    </template>


    <!-- =====================================================================
         PARTIE 2 : PAGE D'ACCUEIL PREMIUM CRÉATIVE
         ===================================================================== -->

    <template id="homepage_hero_split" inherit_id="website.homepage" name="Hero Premium Créatif">
        <xpath expr="//div[@id='wrap']" position="inside">

            <!-- 1. HERO PLEIN ÉCRAN -->
            <section class="cs-hero-media" style="height:100vh; min-height:720px;">
                <video autoplay="autoplay" muted="muted" loop="loop" playsinline="playsinline"
                       poster="/custom_supplements/static/src/img/hero_home_poster.jpg">
                    <source src="/custom_supplements/static/src/videos/hero_home_cinematic_bottle_reveal.mp4" type="video/mp4"/>
                </video>
                <div class="cs-hero-overlay">
                    <img src="https://images.unsplash.com/photo-1713630356122-e2e6626e05db?q=80&amp;w=1932&amp;auto=format&amp;fit=crop" alt="Joggeur à l'aube"/>
                </div>
                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-between p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-start text-white">
                        <span class="cs-eyebrow">Collection 2026</span>
                        <span class="cs-font-body small opacity-75 d-none d-md-block">Défiler pour explorer ↓</span>
                    </div>
                    <div class="text-white">
                        <h1 class="cs-kinetic-title display-1 mb-0">
                            ÉLEVEZ<br/>
                            <span class="cs-outline">VOTRE</span> STANDARD
                        </h1>
                        <div class="d-flex flex-wrap align-items-center gap-4 mt-4">
                            <a href="/shop" class="btn cs-btn-primary btn-lg px-4 py-2">Explorer la collection</a>
                            <span class="cs-font-body opacity-75">Formules cliniquement dosées · Sans additifs</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 2. MARQUEE MARQUES / PRESSE -->
            <section class="py-4 border-bottom">
                <div class="cs-marquee">
                    <div class="cs-marquee-track cs-font-heading text-uppercase text-muted" style="font-size:1.1rem;">
                        <t t-foreach="range(2)" t-as="dup">
                            <span>Optimum Series</span>
                            <span>Black Skull Lab</span>
                            <span>Mountain Ops</span>
                            <span>Core Essentials</span>
                            <span>Novoma Wellness</span>
                            <span>Geared Nutrition</span>
                        </t>
                    </div>
                </div>
            </section>

            <!-- 3. MANIFESTE ÉDITORIAL -->
            <section class="py-5">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2 text-center cs-reveal">
                            <span class="cs-eyebrow d-block mb-3">Notre exigence</span>
                            <p class="cs-font-heading fs-2 mb-0" style="line-height:1.35;">
                                Nous ne croyons pas aux formules génériques. Chaque référence est pensée
                                pour une <span style="color:#10B981;">exigence</span>, un objectif,
                                un corps — jamais l'inverse.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 4. BENTO GRID — CATÉGORIES -->
            <section class="py-5 cs-section-muted">
                <div class="container">
                    <div class="d-flex justify-content-between align-items-end mb-5 cs-reveal">
                        <h2 class="cs-font-heading mb-0">Explorer l'Univers</h2>
                        <a href="/shop" class="text-decoration-none cs-font-body text-dark">Catalogue complet <i class="fa fa-arrow-right ms-1"/></a>
                    </div>
                    
                    <!-- Récupération dynamique des catégories Odoo par leur nom exact -->
                    <t t-set="cat_prot" t-value="request.env['product.public.category'].sudo().search([('name', '=', 'Protéines')], limit=1)"/>
                    <t t-set="cat_pre" t-value="request.env['product.public.category'].sudo().search([('name', '=', 'Pré-entraînement')], limit=1)"/>
                    <t t-set="cat_vit" t-value="request.env['product.public.category'].sudo().search([('name', 'ilike', 'Vitamines')], limit=1)"/>
                    <t t-set="cat_bcaa" t-value="request.env['product.public.category'].sudo().search([('name', 'ilike', 'Acides')], limit=1)"/>
                    <t t-set="cat_recup" t-value="request.env['product.public.category'].sudo().search([('name', 'ilike', 'Récupération')], limit=1)"/>

                    <div class="cs-bento cs-reveal">
                        <!-- 1. Protéines -->
                        <a t-att-href="cat_prot and '/shop/category/%s' % slug(cat_prot) or '/shop'" class="cs-bento-tile cs-bento-lg">
                            <img src="https://images.unsplash.com/photo-1593095948071-474c5cc2989d?q=80&amp;w=800&amp;auto=format&amp;fit=crop" alt="Protéines Pures"/>
                            <div class="cs-bento-caption">
                                <span class="cs-font-heading d-block mb-1">Protéines Pures</span>
                                <span class="cs-font-body fs-6 opacity-75">Isolats &amp; Formules Végétales</span>
                            </div>
                        </a>
                        
                        <!-- 2. Pré-entraînement -->
                        <a t-att-href="cat_pre and '/shop/category/%s' % slug(cat_pre) or '/shop'" class="cs-bento-tile cs-bento-md">
                            <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&amp;w=800&amp;auto=format&amp;fit=crop" alt="Performance"/>
                            <div class="cs-bento-caption">
                                <span class="cs-font-heading">Performance &amp; Pré-Workout</span>
                            </div>
                        </a>
                        
                        <!-- 3. Vitamines & Minéraux -->
                        <a t-att-href="cat_vit and '/shop/category/%s' % slug(cat_vit) or '/shop'" class="cs-bento-tile cs-bento-md">
                            <img src="https://images.unsplash.com/photo-1584017911766-d451b3d0e843?q=80&amp;w=800&amp;auto=format&amp;fit=crop" alt="Vitamines"/>
                            <div class="cs-bento-caption">
                                <span class="cs-font-heading">Vitamines &amp; Santé</span>
                            </div>
                        </a>
                    </div>
                </div>
            </section>

            <!-- 5. SPOTLIGHT TECH : ASSISTANT IA -->
            <section class="py-5">
                <div class="container">
                    <div class="row align-items-center g-5">
                        <div class="col-lg-6 cs-spotlight cs-reveal">
                            <!-- Image d'illustration IA / Data -->
                            <div class="ratio ratio-1x1" style="border-radius:16px; overflow:hidden; background:#F3F4F6; box-shadow: 0 20px 40px rgba(0,0,0,0.08);">
                                <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&amp;w=800&amp;auto=format&amp;fit=crop" alt="Interface IA Médicale" class="w-100 h-100" style="object-fit:cover;"/>
                            </div>
                            
                            <!-- Badges flottants adaptés -->
                            <div class="cs-callout shadow-sm" style="top:14%; left:-8%; background: white; padding: 12px 20px; border-radius: 8px; position: absolute;">
                                <strong class="cs-font-heading d-block" style="color: #10B981;">Technologie RAG</strong>
                                <span class="cs-font-body text-muted small">Recherche de données cliniques</span>
                            </div>
                            <div class="cs-callout shadow-sm" style="bottom:20%; right:-8%; background: white; padding: 12px 20px; border-radius: 8px; position: absolute;">
                                <strong class="cs-font-heading d-block">100% Autonome</strong>
                                <span class="cs-font-body text-muted small">Orchestration multi-conteneurs</span>
                            </div>
                        </div>
                        
                        <!-- Contenu textuel IA -->
                        <div class="col-lg-6 cs-reveal">
                            <span class="cs-eyebrow d-block mb-3 text-uppercase" style="color: #10B981; letter-spacing: 1px; font-size: 0.85rem; font-weight: 600;">Innovation Santé</span>
                            <h2 class="cs-font-heading display-6 mb-4">Un assistant médical intelligent dédié à votre métabolisme.</h2>
                            <p class="cs-font-body text-muted mb-4" style="line-height: 1.7;">
                                Pour aller au-delà des recommandations standards, notre plateforme intègre un moteur d'analyse propulsé par une architecture RAG (Retrieval-Augmented Generation). Il croise vos objectifs physiques avec des littératures scientifiques pointues pour vous guider vers la supplémentation exacte.
                            </p>
                            <ul class="list-unstyled cs-font-body mb-5">
                                <li class="mb-3 d-flex align-items-center">
                                    <i class="fa fa-microchip me-3 fs-5" style="color:#10B981; width: 24px; text-align: center;"/>
                                    <span>Modèles de langage locaux surpuissants (Ollama, Python)</span>
                                </li>
                                <li class="mb-3 d-flex align-items-center">
                                    <i class="fa fa-server me-3 fs-5" style="color:#10B981; width: 24px; text-align: center;"/>
                                    <span>Déploiement Docker sécurisé et isolé</span>
                                </li>
                                <li class="mb-3 d-flex align-items-center">
                                    <i class="fa fa-shield me-3 fs-5" style="color:#10B981; width: 24px; text-align: center;"/>
                                    <span>Confidentialité stricte de vos données de santé</span>
                                </li>
                            </ul>
                            <a href="/contact" class="btn cs-btn-primary btn-lg px-4 py-3 shadow-sm" style="border-radius: 8px;">Consulter l'Assistant</a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 6. GRILLE PRODUITS -->
            <section class="py-5 cs-section-muted">
                <div class="container">
                    <h2 class="cs-font-heading mb-5 cs-reveal">Sélection Premium</h2>
                    <div class="row g-4">
                        <t t-foreach="request.env['product.template'].sudo().search([('is_published','=',True), ('is_supplement','=',True)], limit=4, order='create_date desc')" t-as="product">
                            <div class="col-6 col-md-3 cs-reveal">
                                <div class="cs-card shadow-sm h-100 position-relative">
                                    <t t-if="product.is_vegan">
                                        <span class="badge cs-badge-accent position-absolute m-3"><i class="fa fa-leaf me-1"/>Vegan</span>
                                    </t>
                                    <div style="height:220px; background-color:#fff; border-radius:16px 16px 0 0; overflow:hidden;">
                                        <img t-attf-src="/web/image/product.template/#{product.id}/image_1024" t-attf-alt="#{product.name}" class="w-100 h-100" style="object-fit:contain;"/>
                                    </div>
                                    <div class="p-3">
                                        <div class="cs-font-body small text-muted text-uppercase mb-1" t-if="product.is_supplement">Complément Alimentaire</div>
                                        <h6 class="cs-font-heading mb-2"><t t-esc="product.name"/></h6>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="cs-font-heading" t-esc="product.list_price" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                            <a t-attf-href="/shop/#{slug(product)}" class="btn btn-sm cs-btn-primary rounded-pill px-3">Ajouter</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </section>

            <!-- 7. SECTION PARALLAX -->
            <section class="cs-parallax d-flex align-items-center text-center"
                     style="height:70vh; min-height:480px; background-size:cover; background-image:url('https://images.unsplash.com/photo-1599727277757-3f54e54ea618?q=80&amp;w=1932&amp;auto=format&amp;fit=crop&amp;ixlib=rb-4.1.0&amp;ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');">
                <div class="container cs-reveal">
                    <span class="cs-eyebrow d-block mb-3">Performance Réelle</span>
                    <h2 class="cs-kinetic-title display-3">CONSTRUIT POUR <span class="cs-outline">DURER</span></h2>
                </div>
            </section>

            <!-- 8. BANDE INGRÉDIENTS DE CONFIANCE -->
            <section class="py-5">
                <div class="container">
                    <div class="row text-center g-4">
                        <div class="col-6 col-md-3 cs-reveal">
                            <i class="fa fa-flask fs-3 mb-3 d-block" style="color:#10B981;"/>
                            <span class="cs-font-heading d-block mb-1">Testé en Labo</span>
                            <span class="cs-font-body small text-muted">Pureté vérifiée par tiers</span>
                        </div>
                        <div class="col-6 col-md-3 cs-reveal">
                            <i class="fa fa-leaf fs-3 mb-3 d-block" style="color:#10B981;"/>
                            <span class="cs-font-heading d-block mb-1">Origine Tracée</span>
                            <span class="cs-font-body small text-muted">Ingrédients sourcés et documentés</span>
                        </div>
                        <div class="col-6 col-md-3 cs-reveal">
                            <i class="fa fa-check-circle fs-3 mb-3 d-block" style="color:#10B981;"/>
                            <span class="cs-font-heading d-block mb-1">Dosage Clinique</span>
                            <span class="cs-font-body small text-muted">Concentrations documentées</span>
                        </div>
                        <div class="col-6 col-md-3 cs-reveal">
                            <i class="fa fa-recycle fs-3 mb-3 d-block" style="color:#10B981;"/>
                            <span class="cs-font-heading d-block mb-1">Emballage Responsable</span>
                            <span class="cs-font-body small text-muted">Matériaux recyclables</span>
                        </div>
                    </div>
                </div>
            </section>

        </xpath>
    </template>
</odoo>