<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="products_item_supplements_badge" inherit_id="website_sale.products_item" name="Compléments — badge vegan">
        <xpath expr="//form" position="inside">
            <span t-if="product.is_vegan" class="cs-product-badge" aria-label="Produit vegan"><i class="fa fa-leaf me-1" aria-hidden="true"/>Vegan</span>
        </xpath>
    </template>

    <template id="filter_vegan_sidebar" inherit_id="website_sale.products" name="Compléments — filtres boutique">
        <!-- Modification de l'XPath : Ciblage plus sécurisé de l'enveloppe de la grille pour éviter les plantages si la grille est vide -->
        <xpath expr="//div[hasclass('o_wsale_products_grid_table_wrapper')]" position="before">
            <div class="cs-fjilter-strip mb-3" role="region" aria-label="Filtres complémentaires">
                <a t-att-href="keep('/shop', vegan=('' if supplement_vegan else '1'))" t-attf-class="cs-filter-pill #{'is-active' if supplement_vegan else ''}"><i class="fa fa-leaf me-2" aria-hidden="true"/>100% vegan</a>
                <t t-foreach="allergens" t-as="allergen"><a t-att-href="keep('/shop', allergens_exclude=allergen.id)" class="cs-filter-pill"><i class="fa fa-slash me-1" aria-hidden="true"/>Sans <t t-esc="allergen.name"/></a></t>
            </div>
        </xpath>
    </template>

    <template id="custom_supplements_product_page" inherit_id="website_sale.product" name="Compléments — informations produit">
        <xpath expr="//div[@id='product_details']" position="inside">
            <t t-if="product.is_supplement">
                <section class="cs-product-info" aria-labelledby="cs-product-info-title">
                    <h2 id="cs-product-info-title" class="h4">La formule en détail</h2>
                    <div class="cs-product-facts">
                        <div t-if="product.is_vegan" class="cs-vegan"><i class="fa fa-leaf" aria-hidden="true"/><span>100% vegan</span></div>
                        <div t-if="product.dosage"><i class="fa fa-eyedropper" aria-hidden="true"/><span t-esc="product.dosage"/></div>
                    </div>
                    <hr t-if="product.ingredients" />
                    <div t-if="product.ingredients" class="cs-ingredient-note">
                        <h3 class="h5">Ingrédients actifs</h3>
                        <p class="mb-0" t-esc="product.ingredients"/>
                    </div>
                    <hr t-if="product.allergen_ids" />
                    <div t-if="product.allergen_ids" class="cs-allergen-note">
                        <h3 class="h5">Allergènes</h3>
                        <ul>
                            <t t-foreach="product.allergen_ids" t-as="allergen">
                            <li t-esc="allergen.name" />
                        </t>
                        </ul>
                        
                    </div>
                    <hr t-if="product.nutritional_info" />
                    <div t-if="product.nutritional_info" class="cs-nutrition-note">
                        <h3 class="h5">Valeurs nutritionnelles</h3>
                        <div t-out="product.nutritional_info"/>
                    </div>
                    
                    <!-- Ajout de la zone dynamique modifiable par l'éditeur web, unique à chaque produit -->
                    <div class="oe_structure oe_empty mt-3" t-attf-id="oe_structure_supplement_info_#{product.id}"/>
                </section>
            </t>
        </xpath>
    </template>

    <template id="cart_allergen_alert" inherit_id="website_sale.total" name="Compléments — rappel santé">
        <xpath expr="." position="inside">
            <t t-set="has_supplements" t-value="any(line.product_id.is_supplement for line in website_sale_order.website_order_line)"/>
            <div t-if="has_supplements" class="cs-allergen-alert" role="alert">
                <i class="fa fa-info-circle me-2" aria-hidden="true"/><strong>Rappel santé :</strong> vérifiez toujours l’étiquette et les allergènes avant consommation.
            </div>
        </xpath>
    </template>


    <!-- Custom Filters -->
<template id="custom_filters" inherit_id="website_sale.products">

    <xpath expr="//div[contains(@t-attf-class, 'products_attributes_filters')]"
           position="after">
        <div class="cs-custom_filters accordion accordion-flush">
            <div class="form-check form-switch py-2 border-bottom vegan">
                <input class="form-check-input"
                       type="checkbox"
                       id="filter_vegan"
                       t-att-checked="'checked' if supplement_vegan else None"/>
                <label class="form-check-label" for="filter_vegan">
                    Végan
                </label>
            </div>
                <div class="accordion-item">
                    <div class="accordion-header h6 mb-0">
                        <button
                            class="accordion-button px-0 bg-transparent shadow-none"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#o_wsale_allergens_option_inner"
                            aria-expanded="true"
                            aria-controls="o_wsale_allergens_option_inner">

                            <b>Allergènes à exclures</b>
                        </button>
                    </div>

                    <div
                        id="o_wsale_allergens_option_inner"
                        class="accordion-collapse collapse show">

                        <div class="py-2">
                            <t t-foreach="allergens" t-as="allergen">
                                <div class="form-check py-2 border-bottom">
                                    <input class="form-check-input"
                                        type="checkbox"
                                        name="allergens_exclude"
                                        t-att-value="allergen.id"
                                        t-att-id="'allergen_' + str(allergen.id)"
                                        t-att-checked="allergen.id in allergens_exclude_ids"/>
                                    <label class="form-check-label"
                                        t-att-for="'allergen_' + str(allergen.id)">
                                        <t t-out="allergen.name"/>
                                    </label>
                                </div>
                            </t>

                    </div>
                </div>
            </div>
        </div>
    </xpath>

</template>
</odoo>