    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* =====================================================================
           DESIGN TOKENS & UTILITAIRES DE BASE
           ===================================================================== */
        :root {
            --cs-primary: #000000;
            --cs-secondary: #F3F4F6;
            --cs-accent: #10B981;
            --cs-bg: #FFFFFF;
            --cs-radius: 8px;
        }

        body { 
            background-color: #ffffff; 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; 
            overflow-x: hidden;
        }

        .cs-font-heading { font-weight: 700; letter-spacing: -0.02em; }
        .cs-font-body { font-weight: 300; line-height: 1.7; }
        .cs-badge-accent { background-color: var(--cs-accent) !important; color: #fff; border-radius: var(--cs-radius); }
        .cs-btn-primary { background-color: var(--cs-primary); color: #fff; border-radius: var(--cs-radius); border: none; }
        .cs-btn-primary:hover { background-color: #1a1a1a; color: #fff; }
        .cs-card { border: none; border-radius: calc(var(--cs-radius) * 2); background-color: var(--cs-bg); transition: transform 0.2s ease; }
        .cs-card:hover { transform: translateY(-5px); }
        .cs-section-muted { background-color: var(--cs-secondary); }
        
        /* Médias */
        .cs-hero-media { position: relative; overflow: hidden; background-color: #000; }
        .cs-hero-media video, .cs-hero-media img { width: 100%; height: 100%; object-fit: cover; opacity: 0.8; }
        .cs-hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.7) 100%); pointer-events: none; }

        /* =====================================================================
           CLASSES PREMIUM / CRÉATIVES
           ===================================================================== */
        
        /* Typographie */
        .cs-kinetic-title { font-weight: 900; letter-spacing: -0.04em; line-height: 0.95; }
        .cs-outline { color: transparent; -webkit-text-stroke: 1.5px #ffffff; }
        .cs-eyebrow { text-transform: uppercase; font-weight: 600; letter-spacing: 0.1em; font-size: 0.85rem; color: var(--cs-accent); }
        
        /* Marquee Animation */
        .cs-marquee { overflow: hidden; white-space: nowrap; width: 100%; background: #fff; }
        .cs-marquee-track { display: inline-block; animation: marquee 25s linear infinite; }
        .cs-marquee-track span { margin: 0 2.5rem; }
        @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

        /* Bento Grid */
        .cs-bento { display: grid; gap: 1rem; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(2, 280px); }
        .cs-bento-tile { position: relative; border-radius: calc(var(--cs-radius) * 2); overflow: hidden; display: block; background: #000; }
        .cs-bento-tile img { width: 100%; height: 100%; object-fit: cover; opacity: 0.6; transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease; }
        .cs-bento-tile:hover img { transform: scale(1.05); opacity: 0.8; }
        .cs-bento-caption { position: absolute; bottom: 1.5rem; left: 1.5rem; color: #fff; z-index: 2; font-size: 1.5rem; }
        .cs-bento-lg { grid-column: span 2; grid-row: span 2; }
        .cs-bento-md { grid-column: span 2; grid-row: span 1; }

        /* Spotlight Callouts */
        .cs-spotlight { position: relative; }
        .cs-callout { position: absolute; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); padding: 1.2rem; border-radius: var(--cs-radius); box-shadow: 0 15px 35px rgba(0,0,0,0.1); z-index: 10; min-width: 220px; transition: transform 0.3s ease; }
        .cs-callout:hover { transform: translateY(-5px); }

        /* Parallax */
        .cs-parallax { background-attachment: fixed; background-position: center; background-repeat: no-repeat; background-size: cover; position: relative; }
        .cs-parallax::before { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,0.4); pointer-events: none; }
        .cs-parallax .container { position: relative; z-index: 2; }

        /* Responsive Fixes */
        @media (max-width: 992px) {
            .cs-bento { grid-template-columns: 1fr; grid-template-rows: auto; }
            .cs-bento-lg { grid-column: span 1; grid-row: span 1; height: 350px; }
            .cs-bento-md { grid-column: span 1; grid-row: span 1; height: 250px; }
            .cs-outline { -webkit-text-stroke: 1px #ffffff; }
            .cs-callout { position: relative !important; top: auto !important; left: auto !important; bottom: auto !important; right: auto !important; margin-bottom: 1rem; width: 100%; transform: none !important; }
        }
    </style>
</head>
