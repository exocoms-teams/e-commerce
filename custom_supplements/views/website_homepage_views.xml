<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="homepage_hero_split" inherit_id="website.homepage" name="Compléments — accueil premium">
        <xpath expr="//div[@id='wrap']" position="inside">
            <t t-set="featured_product" t-value="request.env['product.template'].sudo().search([('is_published', '=', True), ('is_supplement', '=', True)], order='website_sequence, create_date desc', limit=1)"/>
            <section class="cs-home-hero">
                <div class="container"><div class="row align-items-center g-5"><div class="col-lg-6"><span class="cs-eyebrow">Compléments essentiels · collection 2026</span><h1>Une meilleure routine commence <em>ici.</em></h1><p class="cs-hero-lead">Des formules lisibles, des dosages utiles et des ingrédients choisis pour accompagner chaque objectif du quotidien.</p><div class="d-flex flex-wrap gap-3"><a href="/shop" class="btn cs-btn-primary btn-lg">Découvrir la boutique <i class="fa fa-arrow-right ms-2" aria-hidden="true"/></a><a href="/aboutus" class="btn cs-btn-quiet btn-lg">Notre démarche</a></div><div class="cs-hero-proof"><span><i class="fa fa-check-circle" aria-hidden="true"/> Formules transparentes</span><span><i class="fa fa-check-circle" aria-hidden="true"/> Livraison offerte dès 49 €</span></div></div><div class="col-lg-5 offset-lg-1"><div class="cs-hero-product"><span class="cs-hero-sticker">Favori de la communauté</span><t t-if="featured_product"><img t-attf-src="/web/image/product.template/#{featured_product.id}/image_1024" t-att-alt="featured_product.name"/></t><div class="cs-hero-product-caption" t-if="featured_product"><span>À découvrir</span><strong t-esc="featured_product.name"/><a t-attf-href="/shop/#{slug(featured_product)}">Voir la formule <i class="fa fa-arrow-right" aria-hidden="true"/></a></div></div></div></div></div>
            </section>
            <section class="cs-trust-band"><div class="container"><div class="row g-4"><div class="col-6 col-lg-3"><i class="fa fa-flask" aria-hidden="true"/><strong>Dosages utiles</strong><span>Pas de promesses vagues</span></div><div class="col-6 col-lg-3"><i class="fa fa-leaf" aria-hidden="true"/><strong>Ingrédients choisis</strong><span>Une composition lisible</span></div><div class="col-6 col-lg-3"><i class="fa fa-shield" aria-hidden="true"/><strong>Qualité suivie</strong><span>De la sélection au lot</span></div><div class="col-6 col-lg-3"><i class="fa fa-heart" aria-hidden="true"/><strong>Routine humaine</strong><span>Simple à intégrer</span></div></div></div></section>
            <section class="cs-home-section"><div class="container"><div class="cs-section-heading"><div><span class="cs-eyebrow">Explorer par besoin</span><h2>Ce qui vous accompagne aujourd’hui</h2></div><a href="/shop">Voir tout <i class="fa fa-arrow-right ms-1" aria-hidden="true"/></a></div><div class="row g-3"><t t-foreach="website.get_supplement_categories()" t-as="category"><div class="col-md-4"><a class="cs-category-card" t-att-href="'/shop/category/%s' % slug(category)"><span class="cs-category-index">0<t t-esc="category_index + 1"/></span><h3 t-esc="category.name"/><span>Explorer la sélection <i class="fa fa-arrow-right" aria-hidden="true"/></span></a></div></t></div></div></section>
            <section class="cs-home-section cs-home-section-soft"><div class="container"><div class="cs-section-heading"><div><span class="cs-eyebrow">Sélection du moment</span><h2>Les essentiels de la boutique</h2></div><a href="/shop">Tout le catalogue <i class="fa fa-arrow-right ms-1" aria-hidden="true"/></a></div><div class="row g-4"><t t-foreach="request.env['product.template'].sudo().search([('is_published', '=', True), ('is_supplement', '=', True)], order='website_sequence, create_date desc', limit=4)" t-as="product"><div class="col-6 col-lg-3"><article class="cs-product-card"><a class="cs-product-image" t-attf-href="/shop/#{slug(product)}"><span t-if="product.is_vegan" class="cs-product-badge">Vegan</span><img t-attf-src="/web/image/product.template/#{product.id}/image_512" t-att-alt="product.name"/></a><div class="cs-product-copy"><span class="cs-product-kind">Complément alimentaire</span><h3><a t-attf-href="/shop/#{slug(product)}" t-esc="product.name"/></h3><div class="d-flex justify-content-between align-items-center"><span class="cs-product-price" t-esc="product.list_price" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/><a class="cs-product-arrow" t-attf-href="/shop/#{slug(product)}" aria-label="Voir le produit"><i class="fa fa-arrow-up-right" aria-hidden="true"/></a></div></div></article></div></t></div></div></section>
            <section class="cs-home-editorial"><div class="container"><div class="row align-items-center"><div class="col-lg-6"><span class="cs-eyebrow">Notre exigence</span><h2>La clarté avant le bruit.</h2></div><div class="col-lg-5 offset-lg-1"><p>Nous croyons qu’une bonne formule n’a pas besoin de cacher sa composition. Chaque référence est pensée pour être comprise, choisie et adoptée avec confiance.</p><a href="/aboutus" class="cs-text-link">En savoir plus <i class="fa fa-arrow-right ms-1" aria-hidden="true"/></a></div></div></div></section>
        </xpath>
    </template>
</odoo>
