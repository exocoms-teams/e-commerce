<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="homepage_hero_split" inherit_id="website.homepage" name="Vitalo — accueil">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap">
                <section class="hero">
                    <div>
                        <div class="badge">✨ Nouvelle gamme Énergie 2026</div>
                        <h1>La nutrition qui<br/><span class="accent">travaille pour vous</span></h1>
                        <p class="lead">Des compléments dosés à l'efficacité, formulés avec des nutritionnistes et fabriqués en France. Choisissez par objectif, pas par hasard.</p>
                        <div class="btn-row">
                            <a class="btn-vitalo btn-primary" href="/shop">Découvrir la boutique ↗</a>
                            <a class="btn-vitalo btn-secondary" href="/shop">Trouver mon objectif</a>
                        </div>
                        <div class="stats-row">
                            <div class="stat"><b>120k+</b><span>clients accompagnés</span></div>
                            <div class="stat"><b>4,8/5</b><span>note moyenne</span></div>
                            <div class="stat"><b>100%</b><span>traçabilité</span></div>
                        </div>
                    </div>
                    <div class="hero-image">
                        <div class="origin-chip">
                            <div class="ico">🌿</div>
                            <div>
                                <b>Origine vérifiée</b>
                                <span>Chaque ingrédient tracé</span>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="feature-strip">
                    <div class="feature-item">
                        <div class="ico">🌱</div>
                        <div><b>Formules propres</b><p>Sans additifs controversés, ni colorants.</p></div>
                    </div>
                    <div class="feature-item">
                        <div class="ico">🛡️</div>
                        <div><b>Testé en labo</b><p>Analyses indépendantes sur chaque lot.</p></div>
                    </div>
                    <div class="feature-item">
                        <div class="ico">🚚</div>
                        <div><b>Expédition 24 h</b><p>Livraison offerte dès 49 € d'achat.</p></div>
                    </div>
                </div>

                <!-- Boucle Dynamique Odoo : Catégories -->
                <section class="section">
                    <div class="eyebrow">Par objectif</div>
                    <h2>Dites-nous ce dont votre corps a besoin</h2>
                    <div class="goal-grid">
                        <t t-foreach="website.get_supplement_categories()" t-as="category">
                            <a class="goal-card" t-att-href="'/shop/category/%s' % slug(category)">
                                <h3 t-esc="category.name"/>
                                <div class="count">Explorer ↗</div>
                            </a>
                        </t>
                    </div>
                </section>

                <!-- Boucle Dynamique Odoo : Produits -->
                <section class="section" style="padding-top:0;">
                    <div class="section-head">
                        <div>
                            <div class="eyebrow">Meilleures ventes</div>
                            <h2>Les incontournables</h2>
                        </div>
                        <a class="see-all" href="/shop">Voir toute la boutique →</a>
                    </div>
                    <div class="product-grid">
                        <t t-foreach="request.env['product.template'].sudo().search([('is_published', '=', True), ('is_supplement', '=', True)], order='website_sequence, create_date desc', limit=4)" t-as="product">
                            <div class="product-card">
                                <a class="product-thumb" t-attf-href="/shop/#{slug(product)}">
                                    <span t-if="product.is_vegan" class="promo-tag">Vegan</span>
                                    <img t-attf-src="/web/image/product.template/#{product.id}/image_512" t-att-alt="product.name"/>
                                </a>
                                <div class="product-info">
                                    <div class="product-cat">Complément</div>
                                    <h4><a t-attf-href="/shop/#{slug(product)}" t-esc="product.name" style="color:inherit; text-decoration:none;"/></h4>
                                    <div class="rating">★ 4.8</div>
                                    <div class="price-row">
                                        <span class="price" t-esc="product.list_price" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                        <a t-attf-href="/shop/#{slug(product)}" class="btn-add" style="text-decoration:none;">Ajouter</a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </section>

                <section class="section" style="padding-top:0;">
                    <div class="story">
                        <div class="story-text">
                            <div class="eyebrow">Notre histoire</div>
                            <h2>La transparence comme seul ingrédient secret</h2>
                            <p>Chaque formule est publiée en clair : dosages, origines, analyses. Pas de mélanges propriétaires, pas de promesses floues.</p>
                            <a class="btn-vitalo btn-primary" style="background:var(--orange);" href="/aboutus">Qualité &amp; Fabrication ↗</a>
                        </div>
                        <div class="story-img"></div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>