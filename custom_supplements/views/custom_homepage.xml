<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Création d'une nouvelle page web -->
    <template id="custom_home_page" name="Accueil Custom Supplements">
        <!-- t-call="website.layout" permet de garder le header (menu) et le footer d'Odoo -->
        <t t-call="website.layout">
            
            <!-- Début de votre propre HTML -->
            <div id="wrap" class="oe_structure oe_empty">
                
                <!-- Exemple d'utilisation de votre CSS et de vos images -->
                <section class="ma-section-hero-personnalisee">
                    <div class="container">
                        <h1>Vos compléments sur mesure</h1>
                        <!-- Pour appeler une image, utilisez le chemin absolu de votre module -->
                        <img src="/custom_supplements/static/src/img/hero_banner.jpg" alt="Bannière" class="img-fluid"/>
                    </div>
                </section>

                <section class="mes-avantages">
                    <!-- Mettez ici tout le code HTML que vous avez préparé -->
                </section>

            </div>
            <!-- Fin de votre HTML -->

        </t>
    </template>

    <!-- Enregistrement de la page pour créer l'URL "/accueil-custom" -->
    <record id="page_custom_home" model="website.page">
        <field name="name">Accueil Custom</field>
        <field name="url">/accueil-custom</field>
        <field name="view_id" ref="custom_home_page"/>
        <field name="is_published">True</field>
    </record>
</odoo>