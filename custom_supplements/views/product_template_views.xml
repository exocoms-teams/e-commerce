<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_supplements" model="ir.ui.view">
        <field name="name">product.template.form.inherit.supplements</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Infos nutritionnelles" name="supplement_nutrition" groups="custom_supplements.group_supplement_manager">
                    <group>
                        <group string="Configuration">
                            <field name="is_supplement" widget="boolean_toggle"/>
                            <field name="is_vegan" widget="boolean_toggle"/>
                        </group>
                        <group string="Posologie et composition">
                            <field name="dosage"/>
                            <field name="allergen_ids" widget="many2many_tags"/>
                            <field name="ingredients"/>
                        </group>
                    </group>
                    <field name="nutritional_info" nolabel="1" placeholder="Valeurs nutritionnelles, tableaux et recommandations..."/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_supplements_products" model="ir.actions.act_window">
        <field name="name">Compléments alimentaires</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_supplement', '=', True)]</field>
        <field name="context">{'default_is_supplement': True}</field>
    </record>

    <menuitem id="menu_supplements_root" name="Compléments" sequence="10" groups="custom_supplements.group_supplement_manager"/>
    <menuitem id="menu_supplements_products" name="Catalogue" parent="menu_supplements_root" action="action_supplements_products" sequence="10"/>
</odoo>
