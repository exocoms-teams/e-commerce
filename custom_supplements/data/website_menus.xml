<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <delete model="website.menu" id="website.menu_home"/>
        <delete model="website.menu" id="website_sale.menu_shop"/>
        <delete model="website.menu" id="website.menu_contactus"/>
    </data>

    <data noupdate="1">
        <record id="menu_home" model="website.menu">
            <field name="name">Accueil</field>
            <field name="url">/</field>
            <field name="page_id" ref="website.homepage_page"/>
            <field name="sequence" type="int">10</field>
        </record>

        <record id="menu_shop" model="website.menu">
            <field name="name">Boutique</field>
            <field name="url"></field>
            <field name="sequence">20</field>
            <field name="website_id" ref="website.default_website" />
        </record>

        <record id="menu_new" model="website.menu">
            <field name="name">Nouveautés</field>
            <field name="url">/shop?order=date_desc</field>
            <field name="parent_id" ref="menu_shop"/>
            <field name="sequence">10</field>
            <field name="website_id" ref="website.default_website" />
        </record>

        <!-- <record id="menu_offer" model="website.menu">
            <field name="name">Promotions</field>
            <field name="url">/shop?sale=1</field>
            <field name="parent_id" ref="menu_shop"/>
            <field name="sequence">20</field>
        </record> -->

        <!-- on applique le parent_id à la volée pour récupérer la rev -->
        <function model="website.menu" name="write">
            <value model="website.menu" eval="[ref('custom_supplements.menu_home'), ref('custom_supplements.menu_shop')]"/>
            <value eval="{
                'parent_id': obj.env['website.menu'].search([('parent_id', '=', False), ('website_id', '!=', False)], limit=1).id,
                'website_id': obj.env['website.menu'].search([('parent_id', '=', False), ('website_id', '!=', False)], limit=1).website_id.id,
            }"/>
        </function>
    </data>
</odoo>