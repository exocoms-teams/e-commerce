            </record>

            <record id="menu_faq" model="website.menu">
                <field name="name">FAQ </field>
                <field name="url">/faq</field>
                <field name="parent_id" ref="menu_advices"/>
                <field name="sequence">20</field>
            </record>

        <record id="menu_about_us" model="website.menu">
            <field name="name">A Propos</field>
            <field name="url"></field>
            <field name="sequence">60</field>
        </record>

            <record id="menu_our_story" model="website.menu">
                <field name="name">Notre Histoire </field>
                <field name="url">/aboutus</field>
                <field name="parent_id" ref="menu_about_us"/>
                <field name="sequence">10</field>
            </record>

            <record id="menu_contact" model="website.menu">
                <field name="name">Contact </field>
                <field name="url">/contact</field>
                <field name="parent_id" ref="menu_about_us"/>
                <field name="sequence">20</field>
            </record>

    </data>
</odoo>