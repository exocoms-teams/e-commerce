<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <delete model="website.menu" id="website.menu_home"/>
        <delete model="website.menu" id="website_sale.menu_shop"/>
        <delete model="website.menu" id="website.menu_contactus"/>
    </data>

    <data noupdate="1">
        <record id="menu_home" model="website.menu">
            <field name="name">Accueil</field>
            <field name="url">/</field>
            <field name="page_id" ref="website.homepage_page"/>
            <field name="sequence" type="int">10</field>
        </record>

        <record id="menu_shop" model="website.menu">
            <field name="name">Boutique</field>
            <field name="url"></field>
            <field name="sequence">20</field>
        </record>

            <record id="menu_new" model="website.menu">
                <field name="name">Nouveautés</field>
                <field name="url">/shop?order=publish_date+desc</field>
                <field name="parent_id" ref="menu_shop"/>
                <field name="sequence">10</field>
            </record>
            
            <record id="menu_best_seller" model="website.menu">
                    <field name="name">Meilleur ventes</field>
                    <field name="url">/shop</field>
                    <field name="parent_id" ref="menu_shop"/>
                    <field name="sequence">20</field>
            </record>

            <record id="menu_offer" model="website.menu">
                <field name="name">Promotions</field>
                <field name="url">/shop?sale=1</field>
                <field name="parent_id" ref="menu_shop"/>
                <field name="sequence">30</field>
            </record>

        <record id="menu_objectives" model="website.menu">
            <field name="name">Objectifs</field>
            <field name="url"></field>
            <field name="sequence">30</field>
        </record>

            <record id="menu_energy" model="website.menu">
                <field name="name">Énergie &amp; Vitalité</field>
                <field name="url">/shop</field>
                <field name="parent_id" ref="menu_objectives"/>
                <field name="sequence">10</field>
            </record>

            <record id="menu_sleep" model="website.menu">
                <field name="name">Sommeil &amp; Stress </field>
                <field name="url">/shop</field>
                <field name="parent_id" ref="menu_objectives"/>
                <field name="sequence">20</field>
            </record>

            <record id="menu_sport" model="website.menu">
                <field name="name">Sport </field>
                <field name="url">/shop</field>
                <field name="parent_id" ref="menu_objectives"/>
                <field name="sequence">30</field>
            </record>

        <record id="menu_ingredients" model="website.menu">
            <field name="name">Ingrédients</field>
            <field name="url"></field>
            <field name="sequence">40</field>
        </record>

            <record id="menu_omega3" model="website.menu">
                <field name="name">Oméga-3</field>
                <field name="url">/shop</field>
                <field name="parent_id" ref="menu_ingredients"/>
                <field name="sequence">10</field>
            </record>

            <record id="menu_vitamine_c" model="website.menu">
                <field name="name">Vitamine C </field>
                <field name="url">/shop</field>
                <field name="parent_id" ref="menu_ingredients"/>
                <field name="sequence">20</field>
            </record>

            <record id="menu_zinc" model="website.menu">
                <field name="name">Zinc </field>
                <field name="url">/shop</field>
                <field name="parent_id" ref="menu_ingredients"/>
                <field name="sequence">30</field>
            </record>

        <record id="menu_marques" model="website.menu">
            <field name="name">Marques</field>
            <field name="url"></field>
            <field name="sequence">30</field>
        </record>

            <record id="menu_brand_temp" model="website.menu">
                <field name="name">...</field>
                <field name="url">/shop</field>
                <field name="parent_id" ref="menu_marques"/>
                <field name="sequence">10</field>
            </record>

        <record id="menu_advices" model="website.menu">
            <field name="name">Conseils</field>
            <field name="url"></field>
            <field name="sequence">60</field>
        </record>

            <record id="menu_blog" model="website.menu">
                <field name="name">Articles </field>
                <field name="url">/blog</field>
