<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <record id="ir_cron_check_supplement_expiry" model="ir.cron">
            <field name="name">Compléments : Vérification des péremptions</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expiring_supplements()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_archive_demo_products" model="ir.cron">
            <field name="name">Purge Demo Data</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">model._purge_demo()</field>

            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>

            <field name="active">True</field>
        </record>
    </data>
</odoo>