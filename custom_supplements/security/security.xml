<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 1. Création d'une catégorie spécifique pour les compléments -->
        <record model="ir.module.category" id="module_category_supplements">
            <field name="name">Boutique Compléments</field>
            <field name="description">Droits d'accès pour les compléments alimentaires.</field>
            <field name="sequence">10</field>
        </record>

        <!-- 2. Création du groupe "Gestionnaire" -->
        <record id="group_supplement_manager" model="res.groups">
            <field name="name">Gestionnaire de la nutrition</field>
            <field name="category_id" ref="module_category_supplements"/>
            <!-- Implique que ce gestionnaire a au moins les droits d'un utilisateur interne standard -->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>