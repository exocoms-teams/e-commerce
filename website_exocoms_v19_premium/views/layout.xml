
<odoo>
    <template id="exo_layout"
              inherit_id="website.layout"
              name="EXOCOMS Sidebar">

        <xpath expr="//body" position="attributes">
            <attribute name="class"
                       add="exo-theme"
                       separator=" "/>
        </xpath>

        <xpath expr="//div[@id='wrapwrap']" position="before">
            <aside class="exo-custom-sidebar">
                <div class="exo-brand">
                    <div class="exo-brand-x">X</div>
                    <div class="exo-brand-name">EXOCOMS</div>
                    <div class="exo-brand-tagline">
                        Connecter. Sécuriser. Développer.
                    </div>
                </div>

                <nav class="exo-side-nav"
                     aria-label="Menu EXOCOMS">

                    <a href="/" class="exo-active">
                        <span>⌂</span> Accueil
                    </a>

                    <details open="open">
                        <summary>
                            <span>▦</span> Nos Solutions
                        </summary>
                        <div class="exo-submenu">
                            <a href="/monetique">Monétique</a>
                            <a href="/informatique">Informatique</a>
                            <a href="/videosurveillance">Vidéosurveillance</a>
                            <a href="/securite">Sécurité</a>
                            <a href="/wifi">WiFi</a>
                        </div>
                    </details>

                    <a href="/secteurs">
                        <span>▦</span> Secteurs d'activité
                    </a>
                    <a href="/aboutus">
                        <span>♙</span> À propos
                    </a>
                    <a href="/support">
                        <span>◉</span> Support
                    </a>
                    <a href="/contactus">
                        <span>✉</span> Contact
                    </a>
                </nav>

                <div class="exo-sidebar-bottom">
                    <div class="exo-help">
                        <div class="exo-help-icon">☎</div>
                        <strong>Besoin d'aide ?</strong>
                        <a href="tel:0184600000">
                            01 84 60 00 00
                        </a>
                        <small>Support 24/7</small>
                    </div>
                </div>
            </aside>
        </xpath>

    </template>
</odoo>
