<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="homepage" inherit_id="website.homepage" name="EXOCOMS Homepage" priority="99">
        <xpath expr="//div[@id='wrap']" position="inside">

            <section class="exo-hero">
                <div class="container">
                    <h1>EXOCOMS</h1>
                    <p>Monétique • Informatique • Télécoms • WiFi • Cybersécurité</p>
                    <a href="/contactus" class="btn btn-primary btn-lg">Demander un devis</a>
                </div>
            </section>

            <section class="container py-5">
                <h2>Nos expertises</h2>
                <div class="row">
                    <div class="col">Monétique</div>
                    <div class="col">IT</div>
                    <div class="col">Télécoms</div>
                    <div class="col">WiFi</div>
                    <div class="col">Cloud</div>
                    <div class="col">Sécurité</div>
                </div>
            </section>

            <section class="container py-5">
                <h2>Partenaires</h2>
                <p>Ingenico · PAX · SUNMI · Bitdefender · Zyxel · Yealink · Cisco · HP · Microsoft</p>
            </section>

        </xpath>
    </template>

</odoo>
