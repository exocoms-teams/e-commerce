<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Theme Toggle -->
        <template id="theme_toggle" name="Theme Toggle">
            <div class="theme-toggle o_theme_toggle_widget">
                <span class="theme-icon">🌙</span>
                <span t-ignore="1">Toggle Theme</span>
            </div>
        </template>

        <!-- Language Selector -->
        <template id="lang_selector" name="Language Selector">
            <select class="lang-selector o_lang_toggle_widget">
                <option value="en_US" t-att-selected="request.env.context.get('lang') == 'en_US'">🇬🇧 English</option>
                <option value="fr_FR" t-att-selected="request.env.context.get('lang') == 'fr_FR'">🇫🇷 Français</option>
            </select>
        </template>

        <!-- Main Download Page -->
        <template id="extension_download_page" name="Extension Download Page">
            <t t-call="website.layout">
                <!-- Add theme toggle and language selector -->
                <t t-raw="0"/>
                
                <t t-set="title">Tracker Extension Download</t>
                
                <div class="container mt-4 mb-4">
                    <!-- Language-specific content -->
                    <t t-if="request.env.context.get('lang') == 'fr_FR'">
                        <t t-set="hero_title">Extension Tracker</t>
                        <t t-set="hero_subtitle">Suivez automatiquement les produits pendant vos achats</t>
                        <t t-set="download_text">Télécharger maintenant</t>
                        <t t-set="features_title">Fonctionnalités</t>
                        <t t-set="installation_title">Instructions d'installation</t>
                        <!-- Add more translations -->
                    </t>
                    <t t-else="">
                        <t t-set="hero_title">Tracker Extension</t>
                        <t t-set="hero_subtitle">Track products automatically while you shop</t>
                        <t t-set="download_text">Download Now</t>
                        <t t-set="features_title">Features</t>
                        <t t-set="installation_title">Installation Instructions</t>
                    </t>

                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <!-- Hero -->
                            <div class="download-hero text-center mb-5">
                                <h1 class="display-4"><t t-esc="hero_title"/></h1>
                                <p class="lead"><t t-esc="hero_subtitle"/></p>
                                <div class="mt-3">
                                    <span class="badge bg-light text-dark">v2.1.0</span>
                                </div>
                            </div>

                            <!-- Download Card -->
                            <div class="card shadow mb-4">
                                <div class="card-body text-center p-5">
                                    <div class="mb-4">
                                        <h4>📥 <t t-esc="download_text"/></h4>
                                        <p class="text-muted">Track products on Amazon, eBay, Etsy, Walmart, and more.</p>
                                    </div>

                                    <a href="/tracker-extension/download" 
                                       class="btn btn-success btn-lg px-5 py-3">
                                        <i class="fa fa-download me-2"></i><t t-esc="download_text"/>
                                    </a>

                                    <div class="mt-3">
                                        <small class="text-muted">Size: ~1.5 MB</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Features -->
                            <div class="card shadow mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><t t-esc="features_title"/></h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <ul class="list-unstyled">
                                                <li>✅ Auto-tracking on all e-commerce sites</li>
                                                <li>✅ Amazon, eBay, Etsy, Walmart support</li>
                                                <li>✅ Trend score calculation</li>
                                            </ul>
                                        </div>
                                        <div class="col-md-6">
                                            <ul class="list-unstyled">
                                                <li>✅ Local data storage (no cloud sync)</li>
                                                <li>✅ Web dashboard integration</li>
                                                <li>✅ CSV export functionality</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Installation -->
                            <div class="card shadow">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><t t-esc="installation_title"/></h5>
                                </div>
                                <div class="card-body">
                                    <ol class="mb-0">
                                        <li class="mb-2">Download the extension zip file</li>
                                        <li class="mb-2">Extract the zip file to a folder</li>
                                        <li class="mb-2">Open Chrome and go to <code>chrome://extensions</code></li>
                                        <li class="mb-2">Enable <strong>Developer mode</strong></li>
                                        <li class="mb-2">Click <strong>"Load unpacked"</strong> and select the extracted folder</li>
                                        <li>Pin the extension to your toolbar</li>
                                    </ol>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>