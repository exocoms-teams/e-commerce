<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="extension_download_page" name="Extension Download Page">
        <t t-call="website.layout">
            <t t-set="title">Tracker Extension Download</t>
            
            <div class="container mt-4 mb-4">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <!-- Hero -->
                        <div class="text-center mb-5">
                            <h1 class="display-4">Tracker Extension</h1>
                            <p class="lead text-muted">Track products automatically while you shop</p>
                            <div class="mt-3">
                                <span class="badge bg-success">v2.1.0</span>
                            </div>
                        </div>

                        <!-- Download Card -->
                        <div class="card shadow mb-4">
                            <div class="card-body text-center p-5">
                                <div class="mb-4">
                                    <h4>📥 Download Extension</h4>
                                    <p class="text-muted">Track products on Amazon, eBay, Etsy, Walmart, and more.</p>
                                </div>

                                <a href="/tracker-extension/download" 
                                   class="btn btn-primary btn-lg px-5 py-3"
                                   download="tracker-extension.zip">
                                    <i class="fa fa-download me-2"></i>Download Now
                                </a>

                                <div class="mt-3">
                                    <small class="text-muted">Size: ~1.5 MB</small>
                                </div>
                            </div>
                        </div>

                        <!-- Features -->
                        <div class="card shadow mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Features</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <ul class="list-unstyled">
                                            <li>✅ Auto-tracking on all e-commerce sites</li>
                                            <li>✅ Amazon, eBay, Etsy, Walmart support</li>
                                            <li>✅ Trend score calculation</li>
                                        </ul>
                                    </div>
                                    <div class="col-md-6">
                                        <ul class="list-unstyled">
                                            <li>✅ Local data storage (no cloud sync)</li>
                                            <li>✅ Web dashboard integration</li>
                                            <li>✅ CSV export functionality</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Installation -->
                        <div class="card shadow">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Installation Instructions</h5>
                            </div>
                            <div class="card-body">
                                <ol class="mb-0">
                                    <li class="mb-2">Download the extension zip file</li>
                                    <li class="mb-2">Extract the zip file to a folder</li>
                                    <li class="mb-2">Open Chrome and go to <code>chrome://extensions</code></li>
                                    <li class="mb-2">Enable <strong>Developer mode</strong></li>
                                    <li class="mb-2">Click <strong>"Load unpacked"</strong> and select the extracted folder</li>
                                    <li>Pin the extension to your toolbar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>