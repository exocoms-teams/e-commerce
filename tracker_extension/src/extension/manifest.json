{
  "manifest_version": 3,
  "name": "Tracker - Product Intelligence",
  "version": "2.1.0",
  "description": "Track products automatically as you scroll - supports Amazon, eBay, Etsy, Walmart, and more.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "notifications",
    "activeTab",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Tracker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html"
}