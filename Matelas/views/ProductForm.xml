<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- Ajoute un onglet "Caractéristiques matelas" sur la fiche produit
         (Ventes > Produits), pour que le maître de stage puisse remplir
         les caractéristiques d'un matelas sans toucher au code. Ces
         valeurs alimentent ensuite la fiche technique imprimable côté
         site public. -->
    <record id="product_template_form_matelas_caracteristiques" model="ir.ui.view">
      <field name="name">product.template.form.matelas.caracteristiques</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="product.product_template_form_view"/>
      <field name="arch" type="xml">
        <xpath expr="//notebook" position="inside">
          <page string="Caractéristiques matelas" name="matelas_caracteristiques">
            <group>
              <group string="Fiche technique">
                <field name="matelas_dimensions"/>
                <field name="matelas_matiere"/>
                <field name="matelas_epaisseur"/>
                <field name="matelas_fermete"/>
                <field name="matelas_garantie"/>
              </group>
            </group>
          </page>
        </xpath>
      </field>
    </record>

  </data>
</odoo>
