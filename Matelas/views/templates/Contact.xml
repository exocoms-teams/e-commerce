<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="contact_page" name="Contact">
    <t t-call="website.layout">
      <t t-set="is_en" t-value="request.env.context.get('lang', '').startswith('en')" />

      <div class="oe_structure oe_empty"
        id="oe_structure_home_1" />

      <!-- HERO -->
      <section class="contact-hero">
        <div class="contact-hero-overlay">
          <div class="container text-center">
            <t t-if="is_en">
              <h1>We're here for you 💬</h1>
              <p class="contact-hero-sub"> A question, some advice, an order?<br /> Our team
                replies within 24h. </p>
            </t>
            <t t-else="">
              <h1>Nous sommes là pour vous 💬</h1>
              <p class="contact-hero-sub"> Une question, un conseil, une commande ?<br /> Notre équipe
                vous répond sous 24h. </p>
            </t>
          </div>
        </div>
      </section>

      <!-- CONTENU PRINCIPAL -->
      <section class="contact-main container">
        <div class="row g-5">

          <!-- GAUCHE : INFOS -->
          <div class="col-lg-5 col-md-5">
            <t t-if="is_en">
              <h2>Let's talk about sleep!</h2>
              <p class="contact-intro">
                Our team is here to help you
                choose your mattress.
              </p>
            </t>
            <t t-else="">
              <h2>Parlons sommeil !</h2>
              <p class="contact-intro">
                Notre équipe est là pour vous accompagner
                dans le choix de votre matelas.
              </p>
            </t>
            <div class="contact-info-card">

              <div class="contact-info-item">
                <div class="contact-info-icon">
                  <i class="bi bi-geo-alt-fill" />
                </div>
                <div>
                  <p class="contact-info-label" t-esc="'Address' if is_en else 'Adresse'" />
                  <a href="https://maps.google.com" target="_blank">
                    123 Rue du Sommeil, Paris
                  </a>
                </div>
              </div>

              <div class="contact-info-item">
                <div class="contact-info-icon">
                  <i class="bi bi-telephone-fill" />
                </div>
                <div>
                  <p class="contact-info-label" t-esc="'Phone' if is_en else 'Téléphone'" />
                  <a href="tel:+33600000000">+33 6 00 00 00 00</a>
                </div>
              </div>

              <div class="contact-info-item">
                <div class="contact-info-icon">
                  <i class="bi bi-envelope-fill" />
                </div>
                <div>
                  <p class="contact-info-label">Email</p>
                  <a href="mailto:contact@matelas.com">
                    contact@matelas.com
                  </a>
                </div>
              </div>

              <div class="contact-info-item">
                <div class="contact-info-icon">
                  <i class="bi bi-clock-fill" />
                </div>
                <div>
                  <p class="contact-info-label" t-esc="'Hours' if is_en else 'Horaires'" />
                  <t t-if="is_en">
                    <p class="contact-info-value"> Mon – Fri: 9am – 6pm<br />Sat: 10am – 4pm </p>
                  </t>
                  <t t-else="">
                    <p class="contact-info-value"> Lun – Ven : 9h – 18h<br />Sam : 10h – 16h </p>
                  </t>
                </div>
              </div>

            </div>
          </div>

          <!-- DROITE : FORMULAIRE -->
          <div class="col-lg-6 col-md-7">
            <div class="contact-form-box">
              <h2 t-esc="'Send us a message' if is_en else 'Envoyez-nous un message'" />

              <div id="contact-success" class="contact-success" style="display:none">
                <i class="bi bi-check-circle-fill" />

                <h3 t-esc="'Thank you for your message!' if is_en else 'Merci pour votre message !'" />

                <p t-esc="'Our team will respond as soon as possible.' if is_en else 'Notre équipe vous répondra dans les plus brefs délais.'" />

              </div>

              <div class="mb-3">
                <label class="contact-label" t-esc="'Last name *' if is_en else 'Nom *'" />
                <input type="text" id="c-nom" class="contact-input"
                  t-att-placeholder="'Your last name' if is_en else 'Votre nom'" />
              </div>

              <div class="mb-3">
                <label class="contact-label" t-esc="'First name *' if is_en else 'Prénom *'" />
                <input type="text" id="c-prenom" class="contact-input"
                  t-att-placeholder="'Your first name' if is_en else 'Votre prénom'" />
              </div>

              <div class="mb-3">
                <label class="contact-label">Email *</label>
                <input type="email" id="c-email" class="contact-input"
                  placeholder="votre@email.com" />
              </div>

              <div class="mb-3">
                <label class="contact-label" t-esc="'Phone' if is_en else 'Téléphone'" />
                <input type="tel" id="c-tel" class="contact-input"
                  placeholder="+33 6 00 00 00 00" />
              </div>

              <div class="mb-3">
                <label class="contact-label" t-esc="'Subject' if is_en else 'Sujet'" />
                <select id="c-sujet" class="contact-input">
                  <t t-if="is_en">
                    <option value="">Choose a subject...</option>
                    <option>Product question</option>
                    <option>Order tracking</option>
                    <option>Return / Refund</option>
                    <option>Personalized advice</option>
                    <option>Other</option>
                  </t>
                  <t t-else="">
                    <option value="">Choisir un sujet...</option>
                    <option>Question sur un produit</option>
                    <option>Suivi de commande</option>
                    <option>Retour / Remboursement</option>
                    <option>Conseil personnalisé</option>
                    <option>Autre</option>
                  </t>
                </select>
              </div>

              <div class="mb-3">
                <label class="contact-label" t-esc="'Message *' if is_en else 'Message *'" />
                <textarea id="c-message" class="contact-input contact-textarea"
                  t-att-placeholder="'Your message...' if is_en else 'Votre message...'" />
              </div>

              <button class="btn-contact-send" id="btn-contact-send">
                <i class="bi bi-send-fill me-2" />
                <t t-esc="' Send my message' if is_en else ' Envoyer mon message'" />
              </button>

            </div>
          </div>

        </div>
      </section>

      <!-- FAQ -->
      <section class="contact-faq-section container">
        <div class="text-center mb-5">
          <p class="section-label">FAQ</p>
          <h2 class="contact-faq-title" t-esc="'Frequently asked questions' if is_en else 'Questions fréquentes'" />
          <p class="contact-faq-subtitle"
            t-esc="'Everything you need to know about our mattresses and services.' if is_en else 'Tout ce que vous devez savoir sur nos matelas et services.'" />
        </div>

        <div class="faq-accordion">

          <div class="faq-item">
            <button class="faq-question">
              <span><i class="bi bi-truck"></i>
                <t t-esc="' What are the delivery times?' if is_en else ' Quels sont les délais de livraison ?'" />
              </span>
              <i class="bi bi-chevron-down faq-chevron" />
            </button>
            <div class="faq-answer">
              <t t-if="is_en">
                <p>We deliver within 3 to 5 business days directly to
                  you, anywhere in mainland France.</p>
              </t>
              <t t-else="">
                <p>Nous livrons en 3 à 5 jours ouvrés directement chez vous,
                  partout en France métropolitaine.</p>
              </t>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question">
              <span>
                <i class="bi bi-bullseye"></i>
                <t t-esc="' Personalized advice?' if is_en else ' Conseil personnalisé ?'" />
              </span>
              <i class="bi bi-chevron-down faq-chevron" />
            </button>
            <div class="faq-answer">
              <p t-esc="'Our experts guide you to choose the mattress that fits your needs.' if is_en else 'Nos experts vous guident pour choisir le matelas adapté à vos besoins.'" />
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question">
              <span><i class="bi bi-shield-check"></i>
                <t t-esc="' What is the warranty on the mattresses?' if is_en else ' Quelle est la garantie sur les matelas ?'" />
              </span>
              <i class="bi bi-chevron-down faq-chevron" />
            </button>
            <div class="faq-answer">
              <t t-if="is_en">
                <p>All our mattresses come with a 5-year parts and
                  labor warranty. In case of a manufacturing defect, we
                  replace your mattress free of charge.</p>
              </t>
              <t t-else="">
                <p>Tous nos matelas sont garantis 5 ans pièces et main
                  d'œuvre. En cas de défaut de fabrication, nous remplaçons
                  votre matelas gratuitement.</p>
              </t>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question">
              <span><i class="bi bi-credit-card"></i>
                <t t-esc="' What payment methods do you accept?' if is_en else ' Quels moyens de paiement acceptez-vous ?'" />
              </span>
              <i class="bi bi-chevron-down faq-chevron" />
            </button>
            <div class="faq-answer">
              <p t-esc="'We accept credit cards (Visa, Mastercard), and PayPal.' if is_en else 'Nous acceptons les cartes bancaires (Visa, Mastercard), PayPal.'" />
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question">
              <span><i class="bi bi-house-heart"></i>
                <t t-esc="' How do I choose the right mattress?' if is_en else ' Comment choisir le bon matelas ?'" />
              </span>
              <i class="bi bi-chevron-down faq-chevron" />
            </button>
            <div class="faq-answer">
              <t t-if="is_en">
                <p>The choice depends on your body shape, sleeping
                  position, and firmness preference. Our team is
                  available to guide you personally — don't hesitate
                  to contact us via this form!</p>
              </t>
              <t t-else="">
                <p>Le choix dépend de votre morphologie, votre position
                  de sommeil et vos préférences de fermeté. Notre équipe
                  est disponible pour vous guider personnellement —
                  n'hésitez pas à nous contacter via ce formulaire !</p>
              </t>
            </div>
          </div>


        </div>
      </section>

      <!-- Newsletter -->
      <section class="newsletter-section">
        <div class="container">
          <div class="newsletter-box">
            <div class="newsletter-text">
              <p class="section-label"><i class="bi bi-envelope-fill"></i>
                <t t-esc="' STAY UPDATED' if is_en else ' RESTEZ INFORMÉ'" />
              </p>
              <h2 t-esc="'Don' + chr(39) + 't miss any exclusive offer!' if is_en else 'Ne ratez aucune offre exclusive !'" />
              <p t-esc="'Sign up and receive our best offers directly in your inbox.' if is_en else 'Inscrivez-vous et recevez nos meilleures offres directement dans votre boîte mail.'" />
            </div>
            <div class="newsletter-form">
              <input type="email" class="newsletter-input"
                t-att-placeholder="'Your email address...' if is_en else 'Votre adresse email...'" />
              <a href="#" class="btn btn-newsletter" t-esc="'Sign up →' if is_en else ('S' + chr(39) + 'inscrire →')" />
            </div>
          </div>
        </div>
      </section>

    </t>
  </template>

</odoo>
