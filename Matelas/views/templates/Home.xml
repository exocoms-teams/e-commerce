<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Header -->

  <template id="home" name="Accueil">

    <t t-call="website.layout">
      <t t-call-assets="web.assets_frontend" t-js="false" />
      <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

      <!-- Hero-carousel -->
      <section class="hero-carousel position-relative">


        <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel"
          data-bs-interval="1500">
          <div class="carousel-inner">

            <div class="carousel-item active">
              <img
                src="https://images.unsplash.com/photo-1560185128-e173042f79dd?q=80;w=1400;auto=format;fit=crop;ixlib=rb-4.1.0;ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                class="d-block w-100 hero-img" alt="Matelas 1" />
            </div>

            <div class="carousel-item">
              <img
                src="https://www.anniversaire-40.com/wp-content/uploads/2025/06/292161-75ea08da-d93b-4055-b19b-23d6aee747f1_1.jpg?w=1400"
                class="d-block w-100 hero-img" alt="Matelas 2" />
            </div>

            <div class="carousel-item">
              <img
                src="https://plus.unsplash.com/premium_photo-1744390860302-1a84d093bf6c?q=80;w=1400;auto=format;fit=crop;ixlib=rb-4.1.0;ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                class="d-block w-100 hero-img" alt="Matelas 3" />
            </div>

          </div>
        </div>


        <div class="hero-overlay">
          <div class="container">
            <p class="label-top">LE SOMMEIL COMME PRIORITÉ</p>
            <h1>Bienvenue chez Matelas</h1>
            <p class="subtitle"> Dormez mieux, vivez mieux.<br /> Des matelas conçus pour votre
              morphologie. </p>
            <div class="hero-buttons">
              <a href="/shop" class="btn btn-primary">Découvrir nos matelas →</a>
              <a href="/contactus" class="btn btn-outline">Nous contacter</a>
            </div>
          </div>
        </div>

      </section>

      <!-- Avantages -->
      <section class="avantages container">
        <div class="row">
          <div class="col-md-4 avantage-card">
            <span class="icon">
              <i class="bi bi-truck"></i>
            </span>
            <h3>Livraison rapide</h3>
            <p>En 3 à 5 jours ouvrés, directement chez vous</p>
          </div>
          <div class="col-md-4 avantage-card">
            <span class="icon">
              <i class="bi bi-bullseye"></i>
            </span>
            <h3>Conseil personnalisé</h3>
            <p>Nos experts vous guident pour choisir le matelas adapté à vos besoins</p>
          </div>
          <div class="col-md-4 avantage-card">
            <span class="icon">
              <i class="bi bi-shield-check"></i>
            </span>
            <h3>Garantie 5 ans</h3>
            <p>Investissez sereinement dans votre sommeil</p>
          </div>
        </div>
      </section>

      <!-- Ticket -->
      <div class="ticker-wrapper">
        <div class="ticker">

          <div class="ticker-item">
            <i class="bi bi-badge-sd"></i>
            <span>Matelas</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-house-heart"></i>
            <span>Canapés convertibles</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-cloud"></i>
            <span>Oreillers</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-layers"></i>
            <span>Couettes &amp; draps</span>
          </div>


          <div class="ticker-item">
            <i class="bi bi-badge-sd"></i>
            <span>Matelas</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-house-heart"></i>
            <span>Canapés convertibles</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-cloud"></i>
            <span>Oreillers</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-layers"></i>
            <span>Couettes &amp; draps</span>
          </div>


          <div class="ticker-item">
            <i class="bi bi-badge-sd"></i>
            <span>Matelas</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-house-heart"></i>
            <span>Canapés convertibles</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-cloud"></i>
            <span>Oreillers</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-layers"></i>
            <span>Couettes &amp; draps</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-badge-sd"></i>
            <span>Matelas</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-house-heart"></i>
            <span>Canapés convertibles</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-cloud"></i>
            <span>Oreillers</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-layers"></i>
            <span>Couettes &amp; draps</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-badge-sd"></i>
            <span>Matelas</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-house-heart"></i>
            <span>Canapés convertibles</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-cloud"></i>
            <span>Oreillers</span>
          </div>

          <div class="ticker-item">
            <i class="bi bi-layers"></i>
            <span>Couettes &amp; draps</span>
          </div>

        </div>
      </div>


      <!-- Best-sellers -->
      <section class="bestsellers container">
        <p class="section-label">SÉLECTION</p>
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h2>Nos best-sellers</h2>
          <a href="/shop" class="voir-tout">Voir tout →</a>
        </div>

        <div class="row bestseller-grid">
          <t t-foreach="products" t-as="product">
            <div class="col-md-4">
              <div class="product-card">
                <a href="/shop">
                  <img class="product-image"
                    t-att-src="'/web/image/product.template/' + str(product.id) + '/image_1920'"
                    alt="Matelas" />
                </a>
                <p class="product-type">MATELAS</p>

                <h4
                  t-esc="product.name" />

                <div class="price-action">
                  <p class="price">
                    <span t-esc="product.list_price" /> € </p>

                  <a href="#" class="btn-add">Ajouter</a>
                </div>
              </div>
            </div>
          </t>
        </div>

      </section>

      <!-- Bannière promo -->
      <section class="promo-banner container">
        <div class="promo-content">
          <p class="section-label">OFFRE LIMITÉE</p>
          <h2>-20 % sur votre première commande</h2>
          <p>Code : <strong>SLEEP20</strong> — valable jusqu'au 31 août</p>
        </div>
        <a href="/shop" class="btn btn-dark">En profiter →</a>
      </section>


      <!-- Témoignages -->
      <section class="temoignages container">
        <p class="section-label">TÉMOIGNAGES</p>
        <h2>Ce que nos clients disent de nous</h2>
        <div class="row">
          <div class="col-md-4 temoignage-card">
            <div class="stars">★★★★★</div>
            <p>"Enfin un vrai sommeil réparateur ! Le matelas s'est
            adapté à ma morphologie en quelques nuits seulement."</p>
            <strong>Sophie M.</strong> — il
            y a 3 jours </div>
          <div class="col-md-4 temoignage-card">
            <div class="stars">★★★★★</div>
            <p>"Livraison express, installation facile.
              Qualité premium pour un prix très raisonnable."</p>
            <strong>Thomas L.</strong> — il y a
            1 semaine </div>
          <div class="col-md-4 temoignage-card">
            <div class="stars">★★★★☆</div>
            <p>"Après 2 semaines, je ne peux plus m'en passer."</p>
            <strong>Camille
            D.</strong> — il y a 2 semaines </div>
        </div>
      </section>

      <div class="text-center my-4">
        <a href="/avis" class="btn btn-avis">
          <i class="bi bi-pencil-fill"></i> Écrire un avis</a>
      </div>

      <!-- Newsletter -->
      <section class="newsletter-section">
        <div class="container">
          <div class="newsletter-box">
            <div class="newsletter-text">
              <p class="section-label"><i class="bi bi-envelope-fill"></i> RESTEZ INFORMÉ</p>
              <h2>Ne ratez aucune offre exclusive !</h2>
              <p>Inscrivez-vous et recevez nos meilleures offres directement dans votre boîte mail.</p>
            </div>
            <div class="newsletter-form">
              <input type="email" class="newsletter-input" placeholder="Votre adresse email..." />
              <a href="#" class="btn btn-newsletter">S'inscrire →</a>
            </div>
          </div>
        </div>
      </section>


    </t>
  </template>

</odoo>