<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Header -->

  <template id="home" name="Accueil">

    <t t-call="website.layout">
      <t t-call-assets="web.assets_frontend" t-js="false" />
      <t t-set="is_en" t-value="request.env.context.get('lang', '').startswith('en')" />

      <div class="oe_structure oe_empty"
        id="oe_structure_home_1" />

      <!-- Hero-carousel -->
      <section class="hero-carousel position-relative">


        <div id="heroCarousel" class="carousel carousel-fade slide" data-bs-ride="carousel"
          data-bs-interval="2000">
          <div class="carousel-inner">

            <div class="carousel-item active">
              <img
                src="https://images.unsplash.com/photo-1560185128-e173042f79dd?q=80;w=1400;auto=format;fit=crop;ixlib=rb-4.1.0;ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                class="d-block w-100 hero-img" alt="Matelas 1" />
            </div>

            <div class="carousel-item">
              <img
                src="https://www.anniversaire-40.com/wp-content/uploads/2025/06/292161-75ea08da-d93b-4055-b19b-23d6aee747f1_1.jpg?w=1400"
                class="d-block w-100 hero-img" alt="Matelas 2" />
            </div>

            <div class="carousel-item">
              <img
                src="https://plus.unsplash.com/premium_photo-1744390860302-1a84d093bf6c?q=80;w=1400;auto=format;fit=crop;ixlib=rb-4.1.0;ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                class="d-block w-100 hero-img" alt="Matelas 3" />
            </div>

          </div>
        </div>


        <div class="hero-overlay">
          <div class="container">
            <t t-if="is_en">
              <p class="label-top">SLEEP AS A PRIORITY</p>
              <h1>Welcome to Matelas</h1>
              <p class="subtitle"> Sleep better, live better.<br /> Mattresses designed for your
                body shape. </p>
              <div class="hero-buttons">
                <a href="/shop" class="btn btn-primary">Discover our mattresses →</a>
                <a href="/contact" class="btn btn-outline">Contact us</a>
              </div>
            </t>
            <t t-else="">
              <p class="label-top">LE SOMMEIL COMME PRIORITÉ</p>
              <h1>Bienvenue chez Matelas</h1>
              <p class="subtitle"> Dormez mieux, vivez mieux.<br /> Des matelas conçus pour votre
                morphologie. </p>
              <div class="hero-buttons">
                <a href="/shop" class="btn btn-primary">Découvrir nos matelas →</a>
                <a href="/contact" class="btn btn-outline">Nous contacter</a>
              </div>
            </t>
          </div>
        </div>

      </section>

      <!-- Avantages -->
      <section class="avantages container">
        <div class="row">
          <div class="col-md-4 avantage-card">
            <span class="icon">
              <i class="bi bi-truck"></i>
            </span>
            <h3 t-esc="'Fast delivery' if is_en else 'Livraison rapide'" />
            <p t-esc="'Within 3 to 5 business days, straight to your door' if is_en else 'En 3 à 5 jours ouvrés, directement chez vous'" />
          </div>
          <div class="col-md-4 avantage-card">
            <span class="icon">
              <i class="bi bi-bullseye"></i>
            </span>
            <h3 t-esc="'Personalized advice' if is_en else 'Conseil personnalisé'" />
            <p t-esc="'Our experts guide you to the mattress that fits your needs' if is_en else 'Nos experts vous guident pour choisir le matelas adapté à vos besoins'" />
          </div>
          <div class="col-md-4 avantage-card">
            <span class="icon">
              <i class="bi bi-shield-check"></i>
            </span>
            <h3 t-esc="'5-year warranty' if is_en else 'Garantie 5 ans'" />
            <p t-esc="'Invest with confidence in your sleep' if is_en else 'Investissez sereinement dans votre sommeil'" />
          </div>
        </div>
      </section>

      <!-- Ticket -->
      <t t-set="ticker_items" t-value="[
          ('bi-badge-sd', 'Mattresses' if is_en else 'Matelas'),
          ('bi-house-heart', 'Sofa beds' if is_en else 'Canapés convertibles'),
          ('bi-cloud', 'Pillows' if is_en else 'Oreillers'),
          ('bi-layers', ('Duvets ' + chr(38) + ' sheets') if is_en else ('Couettes ' + chr(38) + ' draps')),
      ]" />
      <div class="ticker-wrapper">
        <div class="ticker">
          <t t-foreach="[1, 2, 3, 4, 5]" t-as="_pass">
            <t t-foreach="ticker_items" t-as="titem">
              <div class="ticker-item">
                <i t-attf-class="bi {{titem[0]}}"></i>
                <span t-esc="titem[1]" />
              </div>
            </t>
          </t>
        </div>
      </div>


      <!-- Nouveautés : produits choisis via le tag "Nouveauté" sur la fiche
           produit (Ventes > Produits > Tags produit) — modifiable par le
           maître de stage sans toucher au code. -->
      <t t-if="nouveautes">
        <section class="bestsellers container">
          <p class="section-label" t-esc="'FRESH ARRIVALS' if is_en else 'FRAÎCHEMENT ARRIVÉ'" />
          <div class="d-flex justify-content-between align-items-center mb-1">
            <h2 t-esc="'Our new arrivals' if is_en else 'Nos nouveautés'" />
            <a href="/shop" class="voir-tout" t-esc="'See all →' if is_en else 'Voir tout →'" />
          </div>
          <p class="section-subtitle"
            t-esc="'Discover the latest products just arrived in store.' if is_en else 'Découvrez nos tout derniers produits arrivés en boutique.'" />

          <div class="auto-scroll-wrapper">
            <div class="auto-scroll-track">
              <t t-foreach="[1, 2]" t-as="_pass">
                <t t-foreach="nouveautes" t-as="product">
                  <div class="bestseller-scroll-item">
                    <div class="product-card position-relative">
                      <span class="badge-nouveaute" t-esc="'New' if is_en else 'Nouveau'" />
                      <a t-att-href="product.website_url">
                        <img class="product-image"
                          t-att-src="'/web/image/product.template/' + str(product.id) + '/image_1920'"
                          alt="Matelas" />
                      </a>
                      <p class="product-type" t-esc="'MATTRESS' if is_en else 'MATELAS'" />

                      <h4
                        t-esc="product.name" />

                      <div class="price-action">
                        <p class="price">
                          <span t-esc="product.list_price" /> € </p>

                        <a href="#" class="btn-add"
                          t-att-data-product-url="product.website_url"
                          t-att-data-product-id="product.product_variant_id.id"
                          t-att-data-template-id="product.id"
                          t-att-data-category-id="product.categ_id.id"
                          t-att-data-product-type="product.type"
                          t-esc="'Add' if is_en else 'Ajouter'" />
                      </div>
                    </div>
                  </div>
                </t>
              </t>
            </div>
          </div>

        </section>
      </t>

      <!-- Best-sellers : rangée qui défile automatiquement -->
      <section class="bestsellers container">
        <p class="section-label" t-esc="'SELECTION' if is_en else 'SÉLECTION'" />
        <div class="d-flex justify-content-between align-items-center mb-1">
          <h2 t-esc="'Our best-sellers' if is_en else 'Nos best-sellers'" />
          <a href="/shop" class="voir-tout" t-esc="'See all →' if is_en else 'Voir tout →'" />
        </div>
        <p class="section-subtitle"
          t-esc="(chr(39).join(['Our customers', ' favorite mattresses, praised for their comfort.'])) if is_en else 'Les matelas préférés de nos clients, plébiscités pour leur confort.'" />

        <div class="auto-scroll-wrapper">
          <div class="auto-scroll-track">
            <t t-foreach="[1, 2]" t-as="_pass">
              <t t-foreach="products" t-as="product">
                <div class="bestseller-scroll-item">
                  <div class="product-card">
                    <a t-att-href="product.website_url">
                      <img class="product-image"
                        t-att-src="'/web/image/product.template/' + str(product.id) + '/image_1920'"
                        alt="Matelas" />
                    </a>
                    <p class="product-type" t-esc="'MATTRESS' if is_en else 'MATELAS'" />

                    <h4
                      t-esc="product.name" />

                    <div class="price-action">
                      <p class="price">
                        <span t-esc="product.list_price" /> € </p>

                      <a href="#" class="btn-add"
                        t-att-data-product-url="product.website_url"
                        t-att-data-product-id="product.product_variant_id.id"
                        t-att-data-template-id="product.id"
                        t-att-data-category-id="product.categ_id.id"
                        t-att-data-product-type="product.type"
                        t-esc="'Add' if is_en else 'Ajouter'" />
                    </div>
                  </div>
                </div>
              </t>
            </t>
          </div>
        </div>

      </section>

      <!-- Vu récemment : rempli automatiquement en JavaScript (stockage
           navigateur) à partir des fiches produit consultées. Caché tant
           qu'il n'y a rien à montrer. -->
      <section class="bestsellers container" id="recently-viewed-section" style="display:none">
        <p class="section-label" t-esc="'HISTORY' if is_en else 'HISTORIQUE'" />
        <div class="d-flex justify-content-between align-items-center mb-1">
          <h2 t-esc="'Recently viewed' if is_en else 'Vu récemment'" />
        </div>
        <p class="section-subtitle"
          t-esc="('Find the products you' + chr(39) + 've recently viewed.') if is_en else 'Retrouvez les produits que vous avez récemment consultés.'" />

        <div class="bestseller-scroll" id="recently-viewed-container"></div>
      </section>

      <!-- Bannière promo -->
      <section class="promo-banner container">
        <div class="promo-content">
          <p class="section-label" t-esc="'LIMITED OFFER' if is_en else 'OFFRE LIMITÉE'" />
          <t t-if="is_en">
            <h2>-20% on your first order</h2>
            <p>Code: <strong>SLEEP20</strong> — valid until August 31</p>
          </t>
          <t t-else="">
            <h2>-20 % sur votre première commande</h2>
            <p>Code : <strong>SLEEP20</strong> — valable jusqu'au 31 août</p>
          </t>
        </div>
        <a href="/shop" class="btn btn-dark" t-esc="'Take advantage →' if is_en else 'En profiter →'" />
      </section>


      <!-- Témoignages -->
      <section class="temoignages container">
        <p class="section-label" t-esc="'TESTIMONIALS' if is_en else 'TÉMOIGNAGES'" />
        <h2 t-esc="'What our customers say about us' if is_en else 'Ce que nos clients disent de nous'" />
        <div class="row">

          <!-- Vrais avis publiés, s'il y en a -->
          <t t-if="temoignages">
            <t t-foreach="temoignages" t-as="temoignage">
              <div class="col-md-4 temoignage-card">
                <div class="stars">
                  <t t-esc="'★' * temoignage.note + '☆' * (5 - temoignage.note)" />
                </div>
                <p>"<t t-esc="temoignage.commentaire" />"</p>
                <strong t-esc="temoignage.name" /> — <t t-esc="temoignage.create_date.strftime('%d/%m/%Y')" />
              </div>
            </t>
          </t>

          <!-- Repli : exemples, tant qu'aucun vrai avis n'est publié -->
          <t t-else="">
            <div class="col-md-4 temoignage-card">
              <div class="stars">★★★★★</div>
              <t t-if="is_en">
                <p>"Finally, truly restorative sleep! The mattress adapted
                to my body shape within just a few nights."</p>
                <strong>Sophie M.</strong> — 3 days ago
              </t>
              <t t-else="">
                <p>"Enfin un vrai sommeil réparateur ! Le matelas s'est
                adapté à ma morphologie en quelques nuits seulement."</p>
                <strong>Sophie M.</strong> — il
                y a 3 jours
              </t>
            </div>
            <div class="col-md-4 temoignage-card">
              <div class="stars">★★★★★</div>
              <t t-if="is_en">
                <p>"Express delivery, easy set-up. Premium quality at a
                  very reasonable price."</p>
                <strong>Thomas L.</strong> — 1 week ago
              </t>
              <t t-else="">
                <p>"Livraison express, installation facile.
                  Qualité premium pour un prix très raisonnable."</p>
                <strong>Thomas L.</strong> — il y a
                1 semaine
              </t>
            </div>
            <div class="col-md-4 temoignage-card">
              <div class="stars">★★★★☆</div>
              <t t-if="is_en">
                <p>"After 2 weeks, I simply can't go without it anymore."</p>
                <strong>Camille D.</strong> — 2 weeks ago
              </t>
              <t t-else="">
                <p>"Après 2 semaines, je ne peux plus m'en passer."</p>
                <strong>Camille
                D.</strong> — il y a 2 semaines
              </t>
            </div>
          </t>

        </div>
      </section>

      <div class="text-center my-4">
        <a href="/avis" class="btn btn-avis">
          <i class="bi bi-pencil-fill"></i>
          <t t-esc="' Write a review' if is_en else ' Écrire un avis'" />
        </a>
      </div>

      <!-- Newsletter -->
      <section class="newsletter-section">
        <div class="container">
          <div class="newsletter-box">
            <div class="newsletter-text">
              <p class="section-label"><i class="bi bi-envelope-fill"></i>
                <t t-esc="' STAY UPDATED' if is_en else ' RESTEZ INFORMÉ'" />
              </p>
              <h2 t-esc="'Don' + chr(39) + 't miss any exclusive offer!' if is_en else 'Ne ratez aucune offre exclusive !'" />
              <p t-esc="'Sign up and receive our best offers directly in your inbox.' if is_en else 'Inscrivez-vous et recevez nos meilleures offres directement dans votre boîte mail.'" />
            </div>
            <div class="newsletter-form">
              <input type="email" class="newsletter-input"
                t-att-data-list-id="request.env.ref('Matelas.newsletter_mailing_list').sudo().id"
                t-att-placeholder="'Your email address...' if is_en else 'Votre adresse email...'" />
              <a href="#" class="btn btn-newsletter" t-esc="'Sign up →' if is_en else ('S' + chr(39) + 'inscrire →')" />
            </div>
          </div>
        </div>
      </section>


    </t>
  </template>

</odoo>
