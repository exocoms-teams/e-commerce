<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- Installe le français -->
    <function model="base.language.install"
              name="lang_install">
      <value eval="['fr_FR']"/>
    </function>

    <!-- Installe l'anglais -->
    <function model="base.language.install"
              name="lang_install">
      <value eval="['en_US']"/>
    </function>

    <!-- Installe l'espagnol -->
    <function model="base.language.install"
              name="lang_install">
      <value eval="['es_ES']"/>
    </function>

  </data>
</odoo>