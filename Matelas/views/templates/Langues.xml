<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- Lie les langues au site web -->
    <record id="website_lang_fr" model="website">
      <field name="language_ids"
             eval="[(4, ref('base.lang_fr'))]"/>
    </record>

    <record id="website_lang_en" model="website">
      <field name="language_ids"
             eval="[(4, ref('base.lang_en'))]"/>
    </record>

    <record id="website_lang_es" model="website">
      <field name="language_ids"
             eval="[(4, ref('base.lang_es'))]"/>
    </record>

  </data>
</odoo>