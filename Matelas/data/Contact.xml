<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <record id="website_contact_custom" model="ir.ui.view">
      <field name="name">Matelas Contact</field>
      <field name="type">qweb</field>
      <field name="key">Matelas.contact_custom</field>
      <field name="inherit_id" ref="website.contactus"/>
      <field name="arch" type="xml">

        <xpath expr="//div[@id='wrap']" position="replace">
          <div id="wrap">

            <!-- HERO -->
            <section class="contact-hero">
              <div class="contact-hero-overlay">
                <div class="container text-center">
                  <h1>Nous sommes là pour vous 💬</h1>
                  <p class="contact-hero-sub">
                    Une question, un conseil, une commande ?<br/>
                    Réponse sous 24h.
                  </p>
                </div>
              </div>
            </section>

            <!-- CONTENU PRINCIPAL -->
            <section class="contact-main container">
              <div class="row g-5">

                <!-- GAUCHE : INFOS -->
                <div class="col-md-5">
                  <h2>Parlons sommeil !</h2>
                  <p class="contact-intro">
                    Notre équipe est là pour vous accompagner
                    dans le choix de votre matelas.
                  </p>
                  <div class="contact-info-card">

                    <div class="contact-info-item">
                      <div class="contact-info-icon">
                        <i class="bi bi-geo-alt-fill"/>
                      </div>
                      <div>
                        <p class="contact-info-label">Adresse</p>
                        <a href="https://maps.google.com" target="_blank">
                          123 Rue du Sommeil, Paris
                        </a>
                      </div>
                    </div>

                    <div class="contact-info-item">
                      <div class="contact-info-icon">
                        <i class="bi bi-telephone-fill"/>
                      </div>
                      <div>
                        <p class="contact-info-label">Téléphone</p>
                        <a href="tel:+33600000000">+33 6 00 00 00 00</a>
                      </div>
                    </div>

                    <div class="contact-info-item">
                      <div class="contact-info-icon">
                        <i class="bi bi-envelope-fill"/>
                      </div>
                      <div>
                        <p class="contact-info-label">Email</p>
                        <a href="mailto:contact@matelas.com">
                          contact@matelas.com
                        </a>
                      </div>
                    </div>

                    <div class="contact-info-item">
                      <div class="contact-info-icon">
                        <i class="bi bi-clock-fill"/>
                      </div>
                      <div>
                        <p class="contact-info-label">Horaires</p>
                        <p class="contact-info-value">
                          Lun – Ven : 9h – 18h<br/>Sam : 10h – 16h
                        </p>
                      </div>
                    </div>

                  </div>
                </div>

                <!-- DROITE : Formulaire natif Odoo -->
                <div class="col-md-7">
                  <div class="contact-form-box">
                    <h2>Envoyez-nous un message</h2>
                   
                    <div class="oe_structure oe_empty"/>
                  </div>
                </div>

              </div>
            </section>

          </div>
        </xpath>

        <xpath expr="//button[@type='submit']" position="replace">
          <button type="submit" class="btn btn-contact-send">
            <i class="bi bi-send-fill me-2"/>
            Envoyer mon message
          </button>
        </xpath>

      </field>
    </record>

  </data>
</odoo>