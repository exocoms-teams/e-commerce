<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- Menu -->
    <record id="menu_avis" model="website.menu">
      <field name="name">Avis</field>
      <field name="url">/avis</field>
      <field name="sequence">30</field>
    </record>

    <!-- Désactive le Contact Us du menu natif -->
    <record id="website.menu_contactus" model="website.menu">
      <field name="active">False</field>
    </record>
  </data>

  <template id="custom_contact_btn" inherit_id="website.layout">
    <xpath expr="//a[contains(@href,'/contactus')]" position="attributes">
      <attribute name="href">/contact</attribute>
    </xpath>
  </template>
</odoo>