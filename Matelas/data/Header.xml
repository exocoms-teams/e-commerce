<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- Menu -->
    <record id="menu_accueil" model="website.menu">
      <field name="name">Accueil</field>
      <field name="url">/</field>
      <field name="sequence">10</field>
    </record>

    <record id="menu_boutique" model="website.menu">
      <field name="name">Boutique</field>
      <field name="url">/shop</field>
      <field name="sequence">20</field>
    </record>


    <!-- Header -->
    <record id="website_header" model="ir.ui.view">
      <field name="name">Matelas Header</field>
      <field name="type">qweb</field>
      <field name="key">Matelas.header_custom</field>
      <field name="inherit_id" ref="website.layout" />
      <field name="arch" type="xml">

        <xpath expr="//header[@id='top']" position="replace">
          <header id="top" class="matelas-header">
            <nav class="navbar navbar-expand-lg container">

              <!-- Logo -->
              <a href="/" class="navbar-brand matelas-logo">
                <i class="bi bi-moon-stars-fill logo-icon" />
                <span class="logo-text">Matelas</span>
              </a>

              <!-- Liens de navigations -->
              <div class="collapse navbar-collapse">
                <ul class="navbar-nav mx-auto">
                  <li class="nav-item">
                    <a href="/" class="nav-link">Accueil</a>
                  </li>
                  <li class="nav-item">
                    <a href="/shop" class="nav-link">Boutique</a>
                  </li>

                  <li class="nav-item">
                    <a href="/avis" class="nav-link">Avis</a>
                  </li>

                  <li class="nav-item">
                    <a href="/contact" class="nav-link">Contact</a>
                  </li>
                </ul>
              </div>

              <!-- icônes -->
              <div class="header-right d-flex align-items-center gap-3">

                <!-- Recherche -->
                <a href="#" class="header-icon"
                  data-bs-toggle="modal"
                  data-bs-target="#searchModal">
                  <i class="bi bi-search" />
                </a>

                <!-- Panier -->
                <a href="/shop/cart" class="header-icon header-cart">
                  <i class="bi bi-bag" />
                  <span class="cart-badge">0</span>
                </a>

                <a href="/shop/wishlist" class="exo-icon-btn" title="Favoris"
                  aria-label="Liste de souhaits">
                  <i class="fa fa-heart" aria-hidden="true" />
                </a>

                <!-- Langue -->
                <div class="dropdown">
                  <a href="#" class="header-icon"
                    data-bs-toggle="dropdown">
                    <i class="bi bi-globe" />
                  </a>
                  <ul class="dropdown-menu dropdown-menu-end account-dropdown">
                    <li>
                      <a class="dropdown-item" href="/website/lang/fr_FR">
                        🇫🇷 Français
                      </a>
                    </li>
                    <li>
                      <a class="dropdown-item" href="/website/lang/en_US">
                        🇬🇧 English
                      </a>
                    </li>
                    <li>
                      <a class="dropdown-item" href="/website/lang/es_ES">
                        🇪🇸 Español
                      </a>
                    </li>
                  </ul>
                </div>

                <!-- Compte -->
                <div class="dropdown">
                  <a href="#" class="header-icon"
                    data-bs-toggle="dropdown">
                    <i class="bi bi-person-circle" />
                  </a>
                  <ul class="dropdown-menu dropdown-menu-end account-dropdown">
                    <li>
                      <a class="dropdown-item" href="/web/login">
                        <i class="bi bi-box-arrow-in-right me-2" /> Se connecter </a>
                    </li>
                    <li>
                      <a class="dropdown-item" href="/my/home">
                        <i class="bi bi-person me-2" /> Mon compte </a>
                    </li>
                    <li>
                      <hr class="dropdown-divider" />
                    </li>
                    <li>
                      <a class="dropdown-item text-danger"
                        href="/web/session/logout">
                        <i class="bi bi-box-arrow-right me-2" /> Se déconnecter </a>
                    </li>
                  </ul>
                </div>

              </div>
            </nav>

            <!-- Modal Recherche -->
            <div class="exo-search-wrapper">
              <button class="exo-icon-btn" id="exo-search-open" type="button" title="Rechercher"
                aria-label="Ouvrir la recherche">
                <i class="fa fa-search" aria-hidden="true" />
              </button>
              <div class="exo-search-overlay" id="exo-search-overlay" role="dialog"
                aria-modal="true" aria-label="Recherche">
                <div class="exo-search-box">
                  <form action="/shop" method="get" class="exo-search-form" role="search">
                    <i class="fa fa-search" aria-hidden="true" />
                    <input type="text" name="search" id="exo-search-input"
                      placeholder="Rechercher un produit..." autocomplete="off"
                      aria-label="Rechercher un produit" />
                    <button type="submit">Rechercher</button>
                  </form>
                  <button type="button" class="exo-search-close" id="exo-search-close"
                    aria-label="Fermer la recherche">
                    <i class="fa fa-times" aria-hidden="true" />
                  </button>
                </div>
              </div>
            </div>

          </header>
        </xpath>

      </field>
    </record>

  </data>
</odoo>