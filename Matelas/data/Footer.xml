<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <record id="website_footer" model="ir.ui.view">
      <field name="name">Matelas Footer</field>
      <field name="type">qweb</field>
      <field name="key">website.footer_custom</field>
      <field name="inherit_id" ref="website.layout"/>
      <field name="arch" type="xml">
        <xpath expr="//div[@id='footer']" position="replace">
          <div id="footer" class="matelas-footer">

            <div class="footer-main container">
              <div class="row py-4">

                <!-- Description -->
                <div class="col-md-3">
                  <p class="footer-logo">🛏️ <strong>Matelas</strong></p>
                  <p class="footer-desc">
                    Nous sommes dédiés à votre sommeil.
                    Notre mission : vous offrir la meilleure
                    expérience d'achat de matelas en ligne.
                  </p>
                </div>

                <!-- Liens utiles -->
                <div class="col-md-3">
                  <p class="footer-title">LIENS UTILES</p>
                  <ul class="footer-links">
                    <li><a href="/">🏠 Accueil</a></li>
                    <li><a href="/shop">🛍️ Boutique</a></li>
                    <li><a href="/avis">⭐ Avis</a></li>
                    <li><a href="/about">ℹ️ À propos</a></li>
                    <li><a href="/contactus">💬 Contact</a></li>
                  </ul>
                </div>

                <!-- Contact -->
                <div class="col-md-3">
                  <p class="footer-title">CONTACT</p>
                  <ul class="footer-links">
                    <li><a href="mailto:contact@matelas.com">
                      @ contact@matelas.com</a></li>
                    <li><a href="tel:+33600000000">
                      📞 +33 (0)6 00 00 00 00</a></li>
                  </ul>
                </div>

                <!-- Réseaux sociaux -->
                <div class="col-md-3">
                  <p class="footer-title">SUIVEZ-NOUS</p>
                  <ul class="footer-links">
                    <li><a href="https://facebook.com" target="_blank">
                      📘 Facebook</a></li>
                    <li><a href="https://instagram.com" target="_blank">
                      📷 Instagram</a></li>
                    <li><a href="https://youtube.com" target="_blank">
                      ▶️ YouTube</a></li>
                  </ul>
                </div>

              </div>
            </div>

            <!-- Copyright -->
            <div class="footer-bottom text-center py-3">
              <p class="mb-0">© 2025 Matelas — Tous droits réservés</p>
            </div>

          </div>
        </xpath>
      </field>
    </record>

  </data>
</odoo>