<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <record id="website_footer" model="ir.ui.view">
      <field name="name">Matelas Footer</field>
      <field name="type">qweb</field>
      <field name="key">website.footer_custom</field>
      <field name="inherit_id" ref="website.layout" />
      <field name="arch" type="xml">
        <xpath expr="//div[@id='footer']" position="replace">
          <div id="footer" class="matelas-footer">

            <div class="footer-main container">
              <div class="row py-4">

                <!-- Description -->
                <div class="col-md-3">
                  <p class="footer-logo">
                    <strong class="footer-title">A PROPOS DE NOUS</strong>
                  </p>
                  <p class="footer-desc">
                    Nous sommes dédiés à votre sommeil.
                    Notre mission : vous offrir la meilleure
                    expérience d'achat de matelas en ligne.
                  </p>
                </div>

                <!-- Liens utiles -->
                <div class="col-md-3">
                  <p class="footer-title">LIENS UTILES</p>
                  <ul class="footer-links">
                    <li>
                      <a href="/"><i class="bi bi-house-door-fill"></i> Accueil</a>
                    </li>
                    <li>
                      <a href="/shop"><i class="bi-shop"></i> Boutique</a>
                    </li>
                    <li>
                      <a href="/avis">
                        <i class="bi-star-fill"></i> Avis </a>
                    </li>
                    <li>
                      <a href="/mentions-legales"><i class="bi-file-text"></i> Mentions légales</a>
                    </li>
                    <li>
                      <a href="/contact"><i class="bi-chat-dots-fill"></i> Contact</a>
                    </li>

                    <li>
                      <a href="/cookie-policy">
                        <i class="bi bi-shield-check" /> Politique de cookies </a>
                    </li>
                  </ul>
                </div>

                <!-- Contact -->
                <div class="col-md-3">
                  <p class="footer-title">CONTACT</p>
                  <ul class="footer-links">
                    <li>
                      <a href="mailto:contact@matelas.com">
                        <i class="bi-envelope-fill"></i> contact@matelas.com</a>
                    </li>
                    <li>
                      <a href="tel:+33600000000">
                        <i class="bi-telephone-fill"></i> +33 (0)6 00 00 00 00</a>
                    </li>
                  </ul>
                </div>

                <!-- Réseaux sociaux -->
                <div class="col-md-3">
                  <p class="footer-title">SUIVEZ-NOUS</p>
                  <ul class="footer-links">
                    <li>
                      <a href="https://facebook.com" target="_blank">
                        <i class="bi-facebook"></i> Facebook</a>
                    </li>
                    <li>
                      <a href="https://instagram.com" target="_blank">
                        <i class="bi-instagram"></i> Instagram</a>
                    </li>
                    <li>
                      <a href="https://youtube.com" target="_blank">
                        <i class="bi-youtube"></i> YouTube</a>
                    </li>
                  </ul>
                </div>

              </div>
            </div>

            <!-- Moyens de paiement -->
            <div class="footer-payment container">
              <span class="footer-payment-label">Moyens de paiement acceptés :</span>
              <div class="footer-payment-icons">

                <svg class="payment-icon" viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
                  <rect width="48" height="32" rx="4" fill="#1A1F71"/>
                  <text x="24" y="21" font-family="Arial, sans-serif" font-size="13" font-weight="bold" fill="#FFFFFF" text-anchor="middle">VISA</text>
                </svg>

                <svg class="payment-icon" viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
                  <rect width="48" height="32" rx="4" fill="#FFFFFF" stroke="#E0E0E0"/>
                  <circle cx="20" cy="16" r="9" fill="#EB001B"/>
                  <circle cx="28" cy="16" r="9" fill="#F79E1B" fill-opacity="0.85"/>
                </svg>

                <svg class="payment-icon" viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
                  <rect width="48" height="32" rx="4" fill="#003087"/>
                  <text x="24" y="20" font-family="Arial, sans-serif" font-size="10.5" font-weight="bold" font-style="italic" fill="#FFFFFF" text-anchor="middle">PayPal</text>
                </svg>

                <svg class="payment-icon" viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id="cbGradientFooter" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#1E3A8A"/>
                      <stop offset="50%" stop-color="#DC2626"/>
                      <stop offset="100%" stop-color="#1E3A8A"/>
                    </linearGradient>
                  </defs>
                  <rect width="48" height="32" rx="4" fill="url(#cbGradientFooter)"/>
                  <text x="24" y="21" font-family="Arial, sans-serif" font-size="13" font-weight="bold" fill="#FFFFFF" text-anchor="middle">CB</text>
                </svg>

              </div>
            </div>

          </div>
        </xpath>
      </field>
    </record>

  </data>
</odoo>