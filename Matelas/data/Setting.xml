<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- Active la bannière cookies -->
    <record id="website.default_website" model="website">
      <field name="cookies_bar">True</field>
      <field name="cookie_bar_text">
        Nous utilisons des cookies pour améliorer votre expérience
        sur notre site de matelas. Vous pouvez accepter tous les
        cookies ou choisir uniquement les essentiels.
      </field>

    </record>

    <!-- Installe les langues -->
    <record id="base.lang_fr" model="res.lang">
      <field name="active">True</field>
    </record>

    <record id="base.lang_en" model="res.lang">
      <field name="active">True</field>
    </record>

    <record id="base.lang_es" model="res.lang">
      <field name="active">True</field>
    </record>

  </data>
</odoo>