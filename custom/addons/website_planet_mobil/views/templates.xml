<odoo>
 
  <template id="planet_mobil_home" inherit_id="website.homepage" name="Planet Mobil Homepage">
    
   
    <xpath expr="//div[@id='wrap']" position="replace">
      <div id="wrap" class="oe_structure">

        <!-- Hero Section -->
        <section class="hero-section text-center position-relative">
          <img src="/website_planet_mobil/static/src/img/hero.jpg" class="hero-bg" alt="Planet Mobil"/>
          <div class="hero-content">
            <h1 class="display-4 fw-bold mb-3">Découvrez l’univers Planet‑Mobil</h1>
            <p class="lead mb-4">Smartphones, accessoires et technologies connectées à portée de main.</p>
            <a href="/shop" class="btn btn-primary btn-lg px-4">Accéder à la boutique</a>
          </div>
        </section>

        <section class="intro py-5 bg-light text-center">
          <div class="container">
            <h2 class="fw-bold mb-3">Une expertise mobile au service de vos besoins</h2>
            <p class="text-muted fs-5">
              Planet‑Mobil propose une large gamme de produits originaux pour les smartphones  : 
              téléphones, accessoires, et objets connectés. 
              Notre priorité est la qualité, la fiabilité et la satisfaction client.
            </p>
          </div>
        </section>

        <section class="py-5">
          <div class="container text-center">
            <h2 class="fw-bold mb-4">Nouveaux produits</h2>
            <t t-call="website_sale.products_list"/>
          </div>
        </section>

        <section class="py-5 bg-light">
          <div class="container text-center">
            <h2 class="fw-bold mb-4">Nos meilleures ventes</h2>
            <t t-call="website_sale.products_list"/>
          </div>
        </section>

        <section class="newsletter text-center text-white py-5">
          <div class="container">
            <h3 class="fw-bold mb-3">Abonnez‑vous à notre newsletter</h3>
            <p class="mb-4">Recevez nos nouveautés et offres exclusives par email.</p>
            <form class="d-flex justify-content-center align-items-center gap-2" method="post" action="#">
              <input type="email" name="email" placeholder="Votre adresse email" required="required"
                     class="form-control w-25 py-2 rounded-3 border-0" />
              <button type="submit" class="btn btn-light btn-lg text-primary fw-bold">S’abonner</button>
            </form>
          </div>
        </section>

        <section class="testimonials py-5 text-center">
          <div class="container">
            <h2 class="fw-bold mb-5">Avis clients</h2>
            <div class="row justify-content-center">
              <div class="col-md-3">
                <blockquote class="fst-italic">“Livraison rapide et service impeccable.”</blockquote>
                <p class="mt-3 fw-semibold">— Karim B.</p>
              </div>
              <div class="col-md-3">
                <blockquote class="fst-italic">“Excellent rapport qualité/prix, je recommande !”</blockquote>
                <p class="mt-3 fw-semibold">— Amina T.</p>
              </div>
              <div class="col-md-3">
                <blockquote class="fst-italic">“Service client à l’écoute et produits conformes.”</blockquote>
                <p class="mt-3 fw-semibold">— Jean‑Luc P.</p>
              </div>
            </div>
          </div>
        </section>

      </div>
    </xpath>
  </template>
</odoo>