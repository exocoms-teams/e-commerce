<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================
         PAGE DE COMPARAISON
    ===================================================== -->
    <template id="product_spec_compare_page" name="Comparer les caractéristiques">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container my-4">
                    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                        <h1 class="mb-0 h4">Comparer les caractéristiques</h1>

                        <div class="o_spec_action_bar" t-if="products">

                            <!-- Imprimer comparatif PDF -->
                            <a t-attf-href="/product-specs/compare/print?product_ids={{ product_ids_str }}"
                               class="btn btn-sm btn-outline-secondary o_spec_screen_only"
                               target="_blank">
                                <i class="fa fa-print me-1" title="Imprimer"></i> Imprimer
                            </a>

                            <!-- Dropdown Partager -->
                            <div class="o_spec_share_wrapper o_spec_screen_only">
                                <button class="btn btn-sm btn-outline-secondary o_spec_share_toggle">
                                    <i class="fa fa-share-alt me-1" title="Partager"></i> Partager
                                    <i class="fa fa-caret-down ms-1" title="Développer"></i>
                                </button>
                                <div class="o_spec_share_menu">
                                    <button class="o_share_item"
                                            data-spec-action="copy-compare"
                                            t-att-data-product-ids="product_ids_str">
                                        <i class="fa fa-link" title="Copier le lien"></i>
                                        <div>
                                            <div class="o_share_lbl">Copier le lien du comparatif</div>
                                            <div class="o_share_sub">URL avec les produits sélectionnés</div>
                                        </div>
                                    </button>
                                    <button class="o_share_item"
                                            data-spec-action="email-compare"
                                            t-att-data-product-ids="product_ids_str">
                                        <i class="fa fa-envelope" title="Email"></i>
                                        <div>
                                            <div class="o_share_lbl">Envoyer par email</div>
                                            <div class="o_share_sub">Lien en corps de message</div>
                                        </div>
                                    </button>
                                    <button class="o_share_item"
                                            data-spec-action="whatsapp-compare"
                                            t-att-data-product-ids="product_ids_str">
                                        <i class="fa fa-whatsapp" style="color:#25D366" title="WhatsApp"></i>
                                        <div>
                                            <div class="o_share_lbl">WhatsApp</div>
                                            <div class="o_share_sub">Partager le lien</div>
                                        </div>
                                    </button>
                                    <button class="o_share_item"
                                            data-spec-action="linkedin-compare"
                                            t-att-data-product-ids="product_ids_str">
                                        <i class="fa fa-linkedin" style="color:#0A66C2" title="LinkedIn"></i>
                                        <div>
                                            <div class="o_share_lbl">LinkedIn</div>
                                            <div class="o_share_sub">Partage professionnel</div>
                                        </div>
                                    </button>
                                    <button class="o_share_item"
                                            data-spec-action="x-compare"
                                            t-att-data-product-ids="product_ids_str">
                                        <i class="fa fa-twitter" style="color:#000000" title="X"></i>
                                        <div>
                                            <div class="o_share_lbl">X</div>
                                            <div class="o_share_sub">Partager le comparatif</div>
                                        </div>
                                    </button>
                                    <div class="dropdown-divider"></div>
                                    <a t-attf-href="/product-specs/compare/print?product_ids={{ product_ids_str }}"
                                       class="o_share_item" target="_blank">
                                        <i class="fa fa-file-pdf-o" title="PDF"></i>
                                        <div>
                                            <div class="o_share_lbl">Télécharger PDF</div>
                                            <div class="o_share_sub">Tableau A4 paysage</div>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div t-if="not products" class="alert alert-info">
                        Sélectionnez au moins un produit ci-dessous pour commencer la comparaison.
                    </div>

                    <div t-if="products" class="table-responsive">
                        <table class="table table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th style="width: 220px;">Caractéristique</th>
                                    <t t-foreach="products" t-as="product">
                                        <th class="text-center align-bottom">
                                            <a t-att-href="product.website_url" class="d-block mb-2">
                                                <img t-attf-src="/web/image/product.template/#{ product.id }/image_256"
                                                     class="img-fluid"
                                                     style="max-height: 110px; object-fit: contain;"
                                                     t-att-alt="product.name"/>
                                            </a>
                                            <div><a t-att-href="product.website_url"><t t-out="product.name"/></a></div>
                                            <div t-if="product.list_price" class="fw-bold">
                                                <span t-field="product.list_price"
                                                      t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                                            </div>
                                            <a class="small text-muted"
                                               t-attf-href="/product-specs/compare?product_ids=#{ remove_ids_map.get(product.id, '') }">
                                                Retirer
                                            </a>
                                        </th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="categories" t-as="spec_category">
                                    <tr class="table-light">
                                        <th t-attf-colspan="#{ 1 + len(products) }">
                                            <t t-out="spec_category.name"/>
                                        </th>
                                    </tr>
                                    <t t-foreach="category_attributes.get(spec_category.id, [])" t-as="spec_attribute">
                                        <tr>
                                            <td><t t-out="spec_attribute.name"/></td>
                                            <t t-foreach="products" t-as="product">
                                                <t t-set="spec_value" t-value="product._get_spec_value(spec_attribute)"/>
                                                <td class="text-center">
                                                    <t t-if="spec_value"><t t-out="spec_value"/></t>
                                                    <t t-else=""><span class="text-muted">—</span></t>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <form method="get" action="/product-specs/compare" class="row g-2 align-items-end mt-3" style="max-width: 600px;">
                        <input type="hidden" name="product_ids" t-att-value="product_ids_str"/>
                        <div class="col-8">
                            <label class="form-label" for="compare_add_product">Ajouter un produit</label>
                            <select id="compare_add_product" name="add" class="form-select">
                                <t t-foreach="available_products" t-as="avail">
                                    <option t-att-value="avail.id"><t t-out="avail.name"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="col-4">
                            <button type="submit" class="btn btn-primary">Ajouter</button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <!-- =====================================================
         BLOC CARACTÉRISTIQUES SUR LA FICHE PRODUIT
         Avec barre d'actions : imprimer + partager
    ===================================================== -->
    <template id="product_spec_table" name="Tableau des caractéristiques produit">
        <div class="o_product_spec_table mt-4" t-if="product.spec_line_ids">

            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                <h5 class="mb-0">Caractéristiques techniques</h5>

                <div class="o_spec_action_bar o_spec_screen_only">

                    <!-- Imprimer la fiche seule -->
                    <a t-attf-href="/report/pdf/product_spec_sheet.report_product_spec_sheet_single/#{ product.id }"
                       class="btn btn-sm btn-outline-secondary"
                       target="_blank"
                       title="Imprimer la fiche technique">
                        <i class="fa fa-print me-1" title="Imprimer"></i> Imprimer
                    </a>

                    <!-- Copier le lien direct -->
                    <button class="btn btn-sm btn-outline-secondary"
                            data-spec-action="copy-link"
                            t-att-data-spec-title="product.name"
                            title="Copier le lien de cette fiche">
                        <i class="fa fa-link me-1" title="Copier le lien"></i> Copier le lien
                    </button>

                    <!-- Dropdown Partager -->
                    <div class="o_spec_share_wrapper">
                        <button class="btn btn-sm btn-outline-secondary o_spec_share_toggle"
                                t-att-data-spec-title="product.name">
                            <i class="fa fa-share-alt me-1" title="Partager"></i> Partager
                            <i class="fa fa-caret-down ms-1" title="Développer"></i>
                        </button>
                        <div class="o_spec_share_menu">
                            <button class="o_share_item"
                                    data-spec-action="email"
                                    t-att-data-spec-title="product.name">
                                <i class="fa fa-envelope" title="Email"></i>
                                <div>
                                    <div class="o_share_lbl">Envoyer par email</div>
                                    <div class="o_share_sub">Lien vers cette fiche</div>
                                </div>
                            </button>
                            <button class="o_share_item"
                                    data-spec-action="whatsapp"
                                    t-att-data-spec-title="product.name">
                                <i class="fa fa-whatsapp" title="WhatsApp"></i>
                                <div>
                                    <div class="o_share_lbl">WhatsApp</div>
                                    <div class="o_share_sub">Partager le lien</div>
                                </div>
                            </button>
                            <button class="o_share_item"
                                    data-spec-action="linkedin">
                                <i class="fa fa-linkedin" style="color:#0A66C2" title="LinkedIn"></i>
                                <div>
                                    <div class="o_share_lbl">LinkedIn</div>
                                    <div class="o_share_sub">Partage professionnel</div>
                                </div>
                            </button>
                            <button class="o_share_item"
                                    data-spec-action="x"
                                    t-att-data-spec-title="product.name">
                                <i class="fa fa-twitter" style="color:#000000" title="X"></i>
                                <div>
                                    <div class="o_share_lbl">X</div>
                                    <div class="o_share_sub">Anciennement Twitter</div>
                                </div>
                            </button>
                            <button class="o_share_item"
                                    data-spec-action="facebook">
                                <i class="fa fa-facebook-official" style="color:#1877F2" title="Facebook"></i>
                                <div>
                                    <div class="o_share_lbl">Facebook</div>
                                    <div class="o_share_sub">Partager la fiche</div>
                                </div>
                            </button>
                            <button class="o_share_item"
                                    data-spec-action="telegram"
                                    t-att-data-spec-title="product.name">
                                <i class="fa fa-telegram" style="color:#26A5E4" title="Telegram"></i>
                                <div>
                                    <div class="o_share_lbl">Telegram</div>
                                    <div class="o_share_sub">Envoyer le lien</div>
                                </div>
                            </button>
                            <button class="o_share_item"
                                    data-spec-action="share"
                                    t-att-data-spec-title="product.name">
                                <i class="fa fa-mobile" title="Autres options"></i>
                                <div>
                                    <div class="o_share_lbl">Autres options</div>
                                    <div class="o_share_sub">AirDrop, SMS, apps…</div>
                                </div>
                            </button>
                            <div class="dropdown-divider"></div>
                            <a t-attf-href="/report/pdf/product_spec_sheet.report_product_spec_sheet_single/#{ product.id }"
                               class="o_share_item" target="_blank">
                                <i class="fa fa-file-pdf-o" title="PDF"></i>
                                <div>
                                    <div class="o_share_lbl">Télécharger PDF</div>
                                    <div class="o_share_sub">Fiche technique complète</div>
                                </div>
                            </a>
                            <a t-attf-href="/product-specs/compare?product_ids=#{ product.id }"
                               class="o_share_item">
                                <i class="fa fa-columns" title="Comparer"></i>
                                <div>
                                    <div class="o_share_lbl">Comparer et partager</div>
                                    <div class="o_share_sub">Ajouter à la comparaison</div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Galerie photos du produit -->
            <t t-set="spec_images" t-value="product.product_template_image_ids"/>
            <div t-if="spec_images" class="row g-2 mb-3">
                <t t-foreach="spec_images[:4]" t-as="spec_img">
                    <div class="col-3">
                        <img t-attf-src="/web/image/product.image/#{ spec_img.id }/image_256"
                             class="img-fluid border rounded"
                             style="height: 90px; width: 100%; object-fit: contain; background: #fff;"
                             t-att-alt="spec_img.name or product.name"/>
                    </div>
                </t>
            </div>

            <!-- Tableau des caractéristiques groupées -->
            <t t-foreach="product._get_spec_categories()" t-as="spec_category">
                <div class="o_product_spec_category mb-3">
                    <p class="text-muted text-uppercase small mb-1">
                        <t t-out="spec_category.name"/>
                    </p>
                    <table class="table table-sm mb-0">
                        <t t-foreach="product._get_spec_lines_by_category(spec_category)" t-as="spec_line">
                            <tr>
                                <td class="text-muted" style="width: 45%;">
                                    <t t-out="spec_line.attribute_id.name"/>
                                </td>
                                <td><t t-out="spec_line.value"/></td>
                            </tr>
                        </t>
                    </table>
                </div>
            </t>
        </div>
    </template>

    <!-- Injection sur la fiche produit e-commerce -->
    <record id="website_sale_product_spec_table_inherit" model="ir.ui.view">
        <field name="name">website_sale.product.spec.table.inherit</field>
        <field name="model">ir.ui.view</field>
        <field name="inherit_id" ref="website_sale.product"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='product_full_description']" position="after">
                <t t-call="product_spec_sheet.product_spec_table"/>
            </xpath>
        </field>
    </record>

</odoo>
