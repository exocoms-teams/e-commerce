<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================
         CYCLE DE VIE — onglet sur la fiche produit
    ===================================================== -->
    <record id="view_product_template_lifecycle_form" model="ir.ui.view">
        <field name="name">product.template.lifecycle.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Bandeau d'alerte en haut de la fiche -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="lifecycle_state not in ('eol_soon', 'eol')">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    <field name="lifecycle_warning" readonly="1"/>
                </div>
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="lifecycle_state != 'obsolete'">
                    <i class="fa fa-ban me-2"/>
                    <field name="lifecycle_warning" readonly="1"/>
                </div>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Cycle de vie" name="lifecycle">
                    <group>
                        <group string="Statut">
                            <field name="lifecycle_state" widget="badge"
                                   decoration-success="lifecycle_state in ('new','active')"
                                   decoration-warning="lifecycle_state == 'eol_soon'"
                                   decoration-danger="lifecycle_state in ('eol','obsolete')"/>
                            <field name="lifecycle_is_sellable" readonly="1"/>
                        </group>
                        <group string="Échéances">
                            <field name="lifecycle_eol_date"/>
                            <field name="lifecycle_support_end"/>
                        </group>
                    </group>
                    <group string="Remplacement"
                           invisible="lifecycle_state in ('new','active')">
                        <field name="lifecycle_replacement_id"
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Note affichée au client">
                        <field name="lifecycle_note"
                               placeholder="Ex : Migration recommandée vers la gamme TETRA suite à l'évolution des normes PCI PTS."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Colonne cycle de vie dans la liste produits -->
    <record id="view_product_template_lifecycle_list" model="ir.ui.view">
        <field name="name">product.template.lifecycle.list</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="lifecycle_state" widget="badge" optional="hide"
                       decoration-success="lifecycle_state in ('new','active')"
                       decoration-warning="lifecycle_state == 'eol_soon'"
                       decoration-danger="lifecycle_state in ('eol','obsolete')"/>
            </field>
        </field>
    </record>

    <!-- =====================================================
         HISTORIQUE — colonnes traçabilité
    ===================================================== -->
    <record id="view_spec_line_history_list" model="ir.ui.view">
        <field name="name">product.template.spec.line.history.list</field>
        <field name="model">product.template.spec.line</field>
        <field name="arch" type="xml">
            <list string="Historique des caractéristiques" create="false">
                <field name="last_change_date" string="Date"/>
                <field name="product_tmpl_id" string="Produit"/>
                <field name="category_id" string="Catégorie"/>
                <field name="attribute_id" string="Caractéristique"/>
                <field name="previous_value" string="Ancienne valeur"/>
                <field name="value" string="Valeur actuelle"/>
                <field name="change_source" widget="badge"
                       decoration-info="change_source == 'fetch'"
                       decoration-warning="change_source == 'cron'"/>
                <field name="last_change_uid" string="Par"/>
            </list>
        </field>
    </record>

    <record id="view_spec_line_history_search" model="ir.ui.view">
        <field name="name">product.template.spec.line.history.search</field>
        <field name="model">product.template.spec.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id"/>
                <field name="attribute_id"/>
                <filter name="f_modified" string="Modifiées"
                        domain="[('previous_value','!=',False)]"/>
                <filter name="f_fetch" string="Issues d'internet"
                        domain="[('change_source','in',['fetch','cron'])]"/>
                <filter name="f_manual" string="Saisie manuelle"
                        domain="[('change_source','=','manual')]"/>
                <separator/>
                <filter name="f_recent" string="7 derniers jours"
                        domain="[('last_change_date','&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="g_product" string="Produit"
                            context="{'group_by': 'product_tmpl_id'}"/>
                    <filter name="g_source" string="Origine"
                            context="{'group_by': 'change_source'}"/>
                    <filter name="g_user" string="Utilisateur"
                            context="{'group_by': 'last_change_uid'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_spec_line_history" model="ir.actions.act_window">
        <field name="name">Historique des caractéristiques</field>
        <field name="res_model">product.template.spec.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_spec_line_history_list"/>
        <field name="search_view_id" ref="view_spec_line_history_search"/>
        <field name="context">{'search_default_f_recent': 1}</field>
    </record>

    <!-- =====================================================
         RÉCUPÉRATION AUTOMATIQUE — journal d'exécution
    ===================================================== -->
    <record id="view_autofetch_run_list" model="ir.ui.view">
        <field name="name">product.spec.autofetch.run.list</field>
        <field name="model">product.spec.autofetch.run</field>
        <field name="arch" type="xml">
            <list create="false"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="product_count" string="Traités"/>
                <field name="success_count" string="Réussites"/>
                <field name="failed_count" string="Échecs"/>
                <field name="lines_created" string="Lignes créées"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="view_autofetch_run_form" model="ir.ui.view">
        <field name="name">product.spec.autofetch.run.form</field>
        <field name="model">product.spec.autofetch.run</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="state" widget="badge"/>
                        </group>
                        <group>
                            <field name="product_count"/>
                            <field name="success_count"/>
                            <field name="failed_count"/>
                            <field name="lines_created"/>
                        </group>
                    </group>
                    <separator string="Journal d'exécution"/>
                    <field name="log" widget="text" readonly="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_autofetch_run" model="ir.actions.act_window">
        <field name="name">Récupérations automatiques</field>
        <field name="res_model">product.spec.autofetch.run</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune récupération automatique n'a encore été lancée.
            </p>
            <p>
                Activez la récupération planifiée dans
                <em>Ventes &gt; Configuration &gt; Paramètres &gt; Caractéristiques produit</em>.
            </p>
        </field>
    </record>

    <!-- =====================================================
         MENUS
    ===================================================== -->
    <menuitem id="menu_spec_line_history"
              name="Historique des modifications"
              parent="menu_product_spec_root"
              action="action_spec_line_history"
              sequence="40"/>

    <menuitem id="menu_autofetch_run"
              name="Récupérations automatiques"
              parent="menu_product_spec_root"
              action="action_autofetch_run"
              sequence="50"/>

</odoo>
