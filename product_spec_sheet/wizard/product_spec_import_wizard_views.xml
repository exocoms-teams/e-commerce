<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_spec_import_wizard_form" model="ir.ui.view">
        <field name="name">product.spec.import.wizard.form</field>
        <field name="model">product.spec.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer des caractéristiques">
                <p>
                    Collez ci-dessous une ligne par caractéristique, au format
                    <strong>Catégorie ; Caractéristique ; Valeur</strong>.
                    Elles seront appliquées à tous les produits sélectionnés.
                </p>
                <group>
                    <field name="product_tmpl_ids" widget="many2many_tags"/>
                </group>
                <field name="data" placeholder="Connectivité ; Réseaux ; Wifi, 4G, Bluetooth, Ethernet
Écran ; Taille ; 5 pouces tactile couleur
Alimentation ; Batterie ; 5000 mAh, 8h d'autonomie"/>
                <group>
                    <field name="create_missing"/>
                    <field name="update_existing"/>
                </group>
                <footer>
                    <button string="Importer" name="action_import" type="object" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_spec_import_wizard" model="ir.actions.act_window">
        <field name="name">Importer des caractéristiques</field>
        <field name="res_model">product.spec.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
