<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Catégories -->
    <record id="spec_category_connectivity" model="product.spec.category">
        <field name="name">Connectivité</field>
        <field name="sequence">10</field>
    </record>
    <record id="spec_category_screen" model="product.spec.category">
        <field name="name">Écran</field>
        <field name="sequence">20</field>
    </record>
    <record id="spec_category_power" model="product.spec.category">
        <field name="name">Alimentation</field>
        <field name="sequence">30</field>
    </record>
    <record id="spec_category_dimensions" model="product.spec.category">
        <field name="name">Dimensions et poids</field>
        <field name="sequence">40</field>
    </record>
    <record id="spec_category_security" model="product.spec.category">
        <field name="name">Sécurité</field>
        <field name="sequence">50</field>
    </record>

    <!-- Caractéristiques : Connectivité -->
    <record id="spec_attribute_networks" model="product.spec.attribute">
        <field name="name">Réseaux</field>
        <field name="category_id" ref="spec_category_connectivity"/>
        <field name="sequence">10</field>
    </record>
    <record id="spec_attribute_card_reader" model="product.spec.attribute">
        <field name="name">Lecteur de carte</field>
        <field name="category_id" ref="spec_category_connectivity"/>
        <field name="sequence">20</field>
    </record>
    <record id="spec_attribute_ports" model="product.spec.attribute">
        <field name="name">Ports</field>
        <field name="category_id" ref="spec_category_connectivity"/>
        <field name="sequence">30</field>
    </record>

    <!-- Caractéristiques : Écran -->
    <record id="spec_attribute_screen_size" model="product.spec.attribute">
        <field name="name">Taille</field>
        <field name="category_id" ref="spec_category_screen"/>
        <field name="sequence">10</field>
    </record>
    <record id="spec_attribute_screen_resolution" model="product.spec.attribute">
        <field name="name">Résolution</field>
        <field name="category_id" ref="spec_category_screen"/>
        <field name="sequence">20</field>
    </record>

    <!-- Caractéristiques : Alimentation -->
    <record id="spec_attribute_battery" model="product.spec.attribute">
        <field name="name">Batterie</field>
        <field name="category_id" ref="spec_category_power"/>
        <field name="sequence">10</field>
    </record>
    <record id="spec_attribute_autonomy" model="product.spec.attribute">
        <field name="name">Autonomie</field>
        <field name="category_id" ref="spec_category_power"/>
        <field name="sequence">20</field>
    </record>

    <!-- Caractéristiques : Dimensions et poids -->
    <record id="spec_attribute_size" model="product.spec.attribute">
        <field name="name">Encombrement</field>
        <field name="category_id" ref="spec_category_dimensions"/>
        <field name="sequence">10</field>
    </record>
    <record id="spec_attribute_weight" model="product.spec.attribute">
        <field name="name">Poids</field>
        <field name="category_id" ref="spec_category_dimensions"/>
        <field name="sequence">20</field>
    </record>

    <!-- Caractéristiques : Sécurité -->
    <record id="spec_attribute_certification" model="product.spec.attribute">
        <field name="name">Certification</field>
        <field name="category_id" ref="spec_category_security"/>
        <field name="sequence">10</field>
    </record>

</odoo>
