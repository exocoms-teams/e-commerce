<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_fetch_missing_specs" model="ir.cron">
            <field name="name">Caractéristiques produit : récupération automatique</field>
            <field name="model_id" ref="model_product_spec_autofetch_run"/>
            <field name="state">code</field>
            <field name="code">model.cron_fetch_missing_specs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:00:00')"/>
        </record>

    </data>
</odoo>
