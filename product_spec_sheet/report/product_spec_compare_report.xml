<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         RAPPORT 2 : COMPARATIF MULTI-PRODUITS
         Accessible via :
           - liste produits backend : sélection > Imprimer > Comparatif
           - site web : /product-specs/compare > bouton Imprimer le comparatif
    ========================================================= -->
    <template id="report_product_spec_compare">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <!-- Mise en page paysage : définie dans l'action rapport -->
                <div class="page">
                    <h2 style="font-size: 16px; margin-bottom: 4px;">Comparatif des caractéristiques techniques</h2>
                    <p style="font-size: 11px; color: #888; margin-bottom: 18px;">
                        <t t-out="len(docs)"/> produit(s) comparé(s) — édité le
                        <t t-out="datetime.datetime.now().strftime('%d/%m/%Y')"/>
                    </p>

                    <t t-set="all_categories" t-value="docs.mapped('spec_line_ids.category_id').sorted(key=lambda c: (c.sequence, c.name or ''))"/>
                    <t t-set="unique_categories" t-value="all_categories"/>

                    <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                        <thead>
                            <tr style="border-bottom: 2px solid #1a1a1a;">
                                <th style="width: 22%; text-align: left; padding: 7px 6px; font-size: 11px; background: #f4f4f4;">Caractéristique</th>
                                <t t-foreach="docs" t-as="product">
                                    <th style="text-align: center; padding: 7px 6px; font-size: 11px; background: #f4f4f4; vertical-align: bottom;">
                                        <div t-if="product.image_1920"
                                             style="height: 70px; margin-bottom: 6px; display: flex; align-items: center; justify-content: center;">
                                            <img t-att-src="image_data_uri(product.image_1920)"
                                                 style="max-width: 100%; max-height: 70px; object-fit: contain;"
                                                 alt="Photo produit"/>
                                        </div>
                                        <t t-out="product.name"/>
                                        <br/>
                                        <span style="font-weight: normal; color: #888; font-size: 10px;">
                                            <t t-if="product.default_code">Réf. <t t-out="product.default_code"/></t>
                                        </span>
                                        <br t-if="product.list_price"/>
                                        <span t-if="product.list_price"
                                              style="font-weight: 600; color: #1a1a1a; font-size: 11px;">
                                            <t t-out="'%.2f' % product.list_price"/> € HT
                                        </span>
                                    </th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="unique_categories" t-as="spec_category">

                                <!-- Ligne titre de catégorie -->
                                <tr style="background: #f8f8f8;">
                                    <td t-attf-colspan="{{ 1 + len(docs) }}"
                                        style="padding: 6px 6px; font-size: 10px; text-transform: uppercase; letter-spacing: 0.07em; color: #666; font-weight: 600; border-bottom: 0.5px solid #e0e0e0;">
                                        <t t-out="spec_category.name"/>
                                    </td>
                                </tr>

                                <!-- Lignes caractéristiques de cette catégorie -->
                                <t t-set="cat_attributes" t-value="docs.mapped('spec_line_ids').filtered(lambda l: l.category_id == spec_category).mapped('attribute_id').sorted(key=lambda a: (a.sequence, a.name or ''))"/>
                                <t t-foreach="cat_attributes" t-as="spec_attribute">
                                    <tr style="border-bottom: 0.5px solid #ebebeb;">
                                        <td style="padding: 6px 6px; color: #444;">
                                            <t t-out="spec_attribute.name"/>
                                        </td>
                                        <t t-foreach="docs" t-as="product">
                                            <t t-set="val" t-value="product._get_spec_value(spec_attribute)"/>
                                            <td style="padding: 6px 6px; text-align: center;">
                                                <t t-if="val">
                                                    <t t-out="val"/>
                                                </t>
                                                <t t-else="">
                                                    <span style="color: #ccc;">—</span>
                                                </t>
                                            </td>
                                        </t>
                                    </tr>
                                </t>

                            </t>
                        </tbody>
                    </table>
                </div>

            </t>
        </t>
    </template>

    <!-- Action rapport comparatif — lié au modèle product.template, orientation paysage -->
    <record id="action_report_product_spec_compare" model="ir.actions.report">
        <field name="name">Comparatif des caractéristiques</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">product_spec_sheet.report_product_spec_compare</field>
        <field name="report_file">product_spec_sheet.report_product_spec_compare</field>
        <field name="print_report_name">'Comparatif caractéristiques - %s produits' % (len(objects))</field>
        <field name="paperformat_id" ref="base.paperformat_a4_landscape"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
