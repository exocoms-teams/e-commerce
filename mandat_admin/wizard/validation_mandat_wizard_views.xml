<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_validation_mandat_wizard_form" model="ir.ui.view">
        <field name="name">validation.mandat.wizard.form</field>
        <field name="model">validation.mandat.wizard</field>
        <field name="arch" type="xml">
            <form string="Validation groupée de mandats">
                <group>
                    <group string="Récapitulatif">
                        <field name="nb_mandats" readonly="1"/>
                        <field name="total_net" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group string="Options">
                        <field name="creer_bordereau"/>
                        <field name="date_bordereau" invisible="not creer_bordereau"/>
                    </group>
                </group>
                <group>
                    <field name="commentaire" placeholder="Commentaire optionnel..."/>
                </group>
                <field name="mandat_ids">
                    <list>
                        <field name="name"/>
                        <field name="creancier_id"/>
                        <field name="objet"/>
                        <field name="montant_net"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="state" widget="badge"/>
                    </list>
                </field>
                <footer>
                    <button name="action_valider" type="object"
                            string="Valider les mandats" class="btn-primary"/>
                    <button special="cancel" string="Annuler"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_validation_mandat_wizard" model="ir.actions.act_window">
        <field name="name">Valider les mandats</field>
        <field name="res_model">validation.mandat.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Bouton d'action contextuelle sur la liste -->
    <record id="action_server_valider_mandats" model="ir.actions.server">
        <field name="name">Valider les mandats sélectionnés</field>
        <field name="model_id" ref="model_mandat_administratif"/>
        <field name="binding_model_id" ref="model_mandat_administratif"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = env['ir.actions.act_window']._for_xml_id('mandat_admin.action_validation_mandat_wizard')
action['context'] = {'active_ids': env.context.get('active_ids', [])}
        </field>
        <field name="groups_id" eval="[(4, ref('group_mandat_ordonnateur'))]"/>
    </record>

</odoo>
