<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_service_fait_wizard_form" model="ir.ui.view">
    <field name="name">service.fait.wizard.form</field>
    <field name="model">service.fait.wizard</field>
    <field name="arch" type="xml">
        <form string="Certification du service fait">
            <div class="alert alert-warning" role="alert">
                ⚠️ La certification du service fait est <strong>obligatoire et irréversible</strong>.
                Elle engage la responsabilité personnelle du certificateur (art. L.2192-4 CCP).
            </div>
            <group col="2">
                <field name="mandat_numero" readonly="1"/>
                <field name="amount_total"  readonly="1" widget="monetary"/>
                <field name="currency_id"   invisible="1"/>
            </group>
            <separator/>
            <group col="2">
                <field name="date_service_fait"/>
                <field name="montant_certifie"/>
                <field name="certificateur_nom"     placeholder="Prénom NOM"/>
                <field name="certificateur_qualite" placeholder="Directeur des Services Techniques"/>
                <field name="nature_reception"/>
                <field name="date_levee_reserves" invisible="nature_reception != 'reserves'"/>
            </group>
            <group invisible="nature_reception == 'conforme'">
                <field name="reserve_service_fait" nolabel="1" colspan="2"
                       placeholder="Décrivez les réserves…"/>
            </group>
            <group string="PV de réception (facultatif)">
                <field name="pv_attachment" widget="binary" filename="pv_filename"/>
                <field name="pv_filename" invisible="1"/>
            </group>
            <footer>
                <button name="action_certifier" string="✅ Certifier le service fait"
                        type="object" class="btn-primary"/>
                <button string="Annuler" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>
</odoo>
