<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_invoice_document_mandat"
              inherit_id="account.report_invoice_document"
              name="Facture — bloc mandat administratif">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div t-if="o.is_mandat_administratif and o.move_type in ('out_invoice', 'out_refund')"
                 name="mandat_administratif_block"
                 class="mt-4 pt-3"
                 style="border-top: 1px solid #dee2e6;">
                <strong>Règlement par mandat administratif — Chorus Pro</strong>
                <p class="mb-1">
                    Facture transmise via le portail Chorus Pro et payable par
                    virement administratif dans le délai global de paiement
                    (art. R. 2192-10 du Code de la commande publique).
                </p>
                <p class="mb-0">
                    <t t-if="o.acheteur_siret">
                        SIRET acheteur : <span t-field="o.acheteur_siret"/> —
                    </t>
                    <t t-if="o.service_chorus">
                        Code service : <span t-field="o.service_chorus"/> —
                    </t>
                    <t t-if="o.numero_engagement">
                        N° d'engagement juridique : <span t-field="o.numero_engagement"/>
                    </t>
                </p>
            </div>
        </xpath>
    </template>

</odoo>
