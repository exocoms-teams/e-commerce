<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue form du provider : rien de spécifique à ajouter -->

    <!-- Bouton sur la transaction pour créer le mandat -->
    <record id="view_payment_transaction_mandat_form" model="ir.ui.view">
        <field name="name">payment.transaction.mandat.form</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.view_payment_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_create_mandat"
                    string="Créer un mandat"
                    type="object"
                    class="btn-primary"
                    invisible="provider_code != 'mandat_administratif' or mandat_id != False"
                />
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Mandat Administratif"
                       invisible="provider_code != 'mandat_administratif'">
                    <field name="mandat_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Champ transaction sur la fiche mandat -->
    <record id="view_mandat_administratif_payment_form" model="ir.ui.view">
        <field name="name">mandat.administratif.payment.form</field>
        <field name="model">mandat.administratif</field>
        <field name="inherit_id" ref="mandat_admin.view_mandat_administratif_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference_creancier']" position="after">
                <field name="transaction_id" readonly="1"
                       invisible="not transaction_id"/>
            </xpath>
        </field>
    </record>
</odoo>
