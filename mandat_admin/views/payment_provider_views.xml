<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_mandat" model="ir.ui.view">
        <field name="name">payment.provider.form.mandat</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.view_payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Mandat Administratif"
                      invisible="code != 'mandat_administratif'">
                    <group>
                        <field name="pending_msg" string="Message affiché au checkout"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
