<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="s_mandat_administratif" name="Mandat administratif">
        <section class="s_mandat_administratif o_colored_level pt48 pb48"
                 data-snippet="s_mandat_administratif"
                 data-name="Mandat administratif">
            <div class="container">

                <!-- En-tête -->
                <div class="row justify-content-center text-center mb-5">
                    <div class="col-lg-9">
                        <span class="s_ma_badge badge rounded-pill text-bg-primary mb-3">
                            Collectivités, administrations &amp; établissements publics
                        </span>
                        <h2>Payez par mandat administratif</h2>
                        <p class="lead mb-0">
                            Vous êtes une entité publique ? Commandez librement :
                            nous acceptons le règlement par mandat administratif
                            et générons les factures électroniques au format
                            <b>Chorus Pro</b>, conformément à la réglementation
                            sur la facturation électronique de l'État.
                        </p>
                    </div>
                </div>

                <!-- Étapes -->
                <div class="row g-4">
                    <div class="col-lg-4 col-md-4">
                        <div class="s_ma_card card h-100 text-center">
                            <div class="card-body">
                                <div class="s_ma_step bg-primary text-white mb-3">
                                    <i class="fa fa-1x fa-file-text-o" role="presentation"/>
                                </div>
                                <h5 class="card-title">1. Commandez &amp; BCA</h5>
                                <p class="card-text mb-0">
                                    Passez commande en ligne en sélectionnant le
                                    paiement par <b>mandat administratif</b>.
                                    Nous générons votre <b>Bon de Commande
                                    Administratif (BCA)</b> conforme GBCP et vous
                                    le transmettons par email.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-4">
                        <div class="s_ma_card card h-100 text-center">
                            <div class="card-body">
                                <div class="s_ma_step bg-primary text-white mb-3">
                                    <i class="fa fa-1x fa-cloud-upload" role="presentation"/>
                                </div>
                                <h5 class="card-title">2. Facture Chorus Pro</h5>
                                <p class="card-text mb-0">
                                    Après certification du service fait, nous
                                    générons la facture électronique au format
                                    <b>UBL 2.1</b>, prête à déposer sur
                                    <b>Chorus Pro</b>, conformément à la
                                    réglementation en vigueur.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-4">
                        <div class="s_ma_card card h-100 text-center">
                            <div class="card-body">
                                <div class="s_ma_step bg-primary text-white mb-3">
                                    <i class="fa fa-1x fa-university" role="presentation"/>
                                </div>
                                <h5 class="card-title">3. Règlement sous 30 jours</h5>
                                <p class="card-text mb-0">
                                    Votre comptable public procède au règlement
                                    par <b>virement administratif</b> dans le
                                    délai global de paiement prévu par le Code
                                    de la commande publique.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Mention réglementaire -->
                <div class="row mt-5">
                    <div class="col text-center">
                        <p class="small text-muted mb-0">
                            Facturation électronique via Chorus Pro conforme à
                            l'ordonnance n° 2014-697 et au décret n° 2016-1478 —
                            délai global de paiement de 30 jours (50 jours pour
                            les établissements publics de santé).
                        </p>
                    </div>
                </div>

            </div>
        </section>
    </template>

</odoo>
