<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="snippets" inherit_id="website.snippets" name="Snippets Mandat administratif">
        <xpath expr="//snippets[@id='snippet_content']" position="inside">
            <t t-snippet="mandat_admin.s_mandat_administratif"
               string="Mandat administratif"
               group="content"
               t-thumbnail="/mandat_admin/static/description/s_mandat_thumbnail.svg">
                <keywords>mandat, administratif, chorus, chorus pro, collectivité, mairie, public, paiement</keywords>
            </t>
        </xpath>
    </template>
</odoo>
