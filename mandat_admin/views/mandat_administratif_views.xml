<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ──────────────────────────────────────────────────────────────
         LISTE
    ─────────────────────────────────────────────────────────────── -->
    <record id="view_mandat_administratif_list" model="ir.ui.view">
        <field name="name">mandat.administratif.list</field>
        <field name="model">mandat.administratif</field>
        <field name="arch" type="xml">
            <list string="Mandats administratifs"
                  decoration-muted="state == 'annule'"
                  decoration-success="state == 'paye'"
                  decoration-warning="state == 'a_valider'"
                  decoration-info="state in ('valide','mandate')">
                <field name="name"/>
                <field name="date_mandat"/>
                <field name="creancier_id"/>
                <field name="objet"/>
                <field name="type_mandat"/>
                <field name="instruction"/>
                <field name="montant_ttc" sum="Total TTC"/>
                <field name="montant_net" sum="Total net"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="bordereau_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paye'"
                       decoration-warning="state == 'a_valider'"
                       decoration-info="state in ('valide','mandate')"
                       decoration-danger="state in ('annule','rejete')"/>
            </list>
        </field>
    </record>

    <!-- ──────────────────────────────────────────────────────────────
         FORMULAIRE
    ─────────────────────────────────────────────────────────────── -->
    <record id="view_mandat_administratif_form" model="ir.ui.view">
        <field name="name">mandat.administratif.form</field>
        <field name="model">mandat.administratif</field>
        <field name="arch" type="xml">
            <form string="Mandat Administratif">
                <header>
                    <button name="action_soumettre_validation"
                            string="Soumettre à validation"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'brouillon'"/>
                    <button name="action_valider"
                            string="Valider (Ordonnancer)"
                            type="object"
                            class="btn-primary"
                            groups="mandat_administratif_fr.group_mandat_ordonnateur"
                            invisible="state != 'a_valider'"/>
                    <button name="action_mandater"
                            string="Mandater"
                            type="object"
                            class="btn-primary"
                            groups="mandat_administratif_fr.group_mandat_ordonnateur"
                            invisible="state != 'valide'"/>
                    <button name="action_marquer_paye"
                            string="Marquer comme payé"
                            type="object"
                            class="btn-success"
                            groups="mandat_administratif_fr.group_mandat_ordonnateur"
                            invisible="state != 'mandate'"/>
                    <button name="action_remettre_brouillon"
                            string="Remettre en brouillon"
                            type="object"
                            invisible="state not in ('a_valider','rejete')"/>
                    <button name="action_annuler"
                            string="Annuler"
                            type="object"
                            class="btn-danger"
                            groups="mandat_administratif_fr.group_mandat_admin"
                            invisible="state in ('paye','annule')"/>
                    <button name="action_imprimer_mandat"
                            string="Imprimer"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'brouillon'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,a_valider,valide,mandate,paye"/>
                </header>

                <sheet>
                    <!-- Bannière annulé / rejeté -->
                    <div class="alert alert-danger" role="alert"
                         invisible="state not in ('annule','rejete')">
                        <strong>
                            <span invisible="state != 'annule'">⚠ Mandat annulé</span>
                            <span invisible="state != 'rejete'">⚠ Mandat rejeté</span>
                        </strong>
                        <span invisible="not motif_rejet"> – <field name="motif_rejet" readonly="1"/></span>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" placeholder="Numéro attribué à la validation"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Identification">
                            <field name="objet" placeholder="Objet du mandat de paiement"/>
                            <field name="type_mandat"/>
                            <field name="instruction"/>
                            <field name="collectivite_id" readonly="1"/>
                        </group>
                        <group string="Dates">
                            <field name="date_mandat"/>
                            <field name="date_piece"/>
                            <field name="date_echeance"/>
                            <field name="date_paiement" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Créancier (Bénéficiaire)">
                            <field name="creancier_id" options="{'no_quick_create': True}"/>
                            <field name="siret_creancier"/>
                            <field name="iban_creancier"/>
                            <field name="reference_creancier"/>
                        </group>
                        <group string="Responsables">
                            <field name="ordonnateur_id"/>
                            <field name="comptable_id"/>
                            <field name="bordereau_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Onglet Montants -->
                        <page string="Montants et TVA" name="montants">
                            <group>
                                <group string="Calcul du mandat">
                                    <field name="montant_ht"/>
                                    <field name="taux_tva"/>
                                    <field name="montant_tva"/>
                                    <field name="montant_ttc"/>
                                    <field name="retenue_garantie"/>
                                    <field name="montant_net" class="oe_subtotal_footer_separator"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                                <group string="Pièce justificative">
                                    <field name="piece_justificative"/>
                                    <field name="numero_piece"/>
                                    <field name="date_piece"/>
                                </group>
                            </group>
                        </page>

                        <!-- Onglet Imputations budgétaires -->
                        <page string="Imputations budgétaires" name="imputations">
                            <group>
                                <group>
                                    <field name="compte_budgetaire" placeholder="ex: 011/6061"/>
                                    <field name="chapitre" placeholder="ex: 011"/>
                                    <field name="article" placeholder="ex: 6061"/>
                                    <field name="rubrique"/>
                                    <field name="fonction"/>
                                </group>
                            </group>
                            <field name="imputation_ids">
                                <list editable="bottom">
                                    <field name="chapitre" required="1"/>
                                    <field name="article" required="1"/>
                                    <field name="rubrique"/>
                                    <field name="libelle"/>
                                    <field name="credit_ouvert"/>
                                    <field name="credit_engage"/>
                                    <field name="credit_disponible" readonly="1"/>
                                    <field name="montant_impute" required="1"/>
                                    <field name="compte_pcg"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>

                        <!-- Onglet Marché public -->
                        <page string="Marché public" name="marche">
                            <group>
                                <field name="marche_public"/>
                                <field name="numero_marche" invisible="not marche_public"/>
                                <field name="lot_marche" invisible="not marche_public"/>
                            </group>
                        </page>

                        <!-- Onglet Notes -->
                        <page string="Notes internes" name="notes">
                            <field name="note_interne" placeholder="Commentaires internes..."/>
                            <field name="motif_rejet"
                                   placeholder="Motif d'annulation ou de rejet..."
                                   invisible="state not in ('annule','rejete')"/>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ──────────────────────────────────────────────────────────────
         RECHERCHE
    ─────────────────────────────────────────────────────────────── -->
    <record id="view_mandat_administratif_search" model="ir.ui.view">
        <field name="name">mandat.administratif.search</field>
        <field name="model">mandat.administratif</field>
        <field name="arch" type="xml">
            <search string="Rechercher un mandat">
                <field name="name" string="Numéro"/>
                <field name="creancier_id"/>
                <field name="objet"/>
                <field name="numero_marche"/>
                <separator/>
                <filter name="brouillon" string="Brouillon" domain="[('state','=','brouillon')]"/>
                <filter name="a_valider" string="À valider" domain="[('state','=','a_valider')]"/>
                <filter name="valide" string="Validés" domain="[('state','=','valide')]"/>
                <filter name="mandate" string="Mandatés" domain="[('state','=','mandate')]"/>
                <filter name="paye" string="Payés" domain="[('state','=','paye')]"/>
                <separator/>
                <filter name="investissement" string="Investissement"
                        domain="[('type_mandat','=','depense_investissement')]"/>
                <filter name="mois_courant" string="Mois en cours"
                        domain="[('date_mandat','&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_creancier" string="Créancier"
                            context="{'group_by': 'creancier_id'}"/>
                    <filter name="group_type" string="Type de mandat"
                            context="{'group_by': 'type_mandat'}"/>
                    <filter name="group_state" string="État"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_mois" string="Mois"
                            context="{'group_by': 'date_mandat:month'}"/>
                    <filter name="group_instruction" string="Instruction"
                            context="{'group_by': 'instruction'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ──────────────────────────────────────────────────────────────
         KANBAN
    ─────────────────────────────────────────────────────────────── -->
    <record id="view_mandat_administratif_kanban" model="ir.ui.view">
        <field name="name">mandat.administratif.kanban</field>
        <field name="model">mandat.administratif</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="creancier_id"/>
                <field name="montant_net"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="date_mandat"/>
                <templates>
                    <t t-name="kanban-card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div><field name="creancier_id"/></div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="objet"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <strong><field name="montant_net" widget="monetary"/></strong>
                                    <span class="text-muted ms-2"><field name="date_mandat"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ──────────────────────────────────────────────────────────────
         ACTION
    ─────────────────────────────────────────────────────────────── -->
    <record id="action_mandat_administratif" model="ir.actions.act_window">
        <field name="name">Mandats administratifs</field>
        <field name="res_model">mandat.administratif</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_mandat_administratif_search"/>
        <field name="context">{'search_default_mois_courant': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun mandat administratif trouvé
            </p>
            <p>
                Cliquez sur <b>Nouveau</b> pour créer votre premier mandat de paiement.
            </p>
        </field>
    </record>

    <!-- Action : mandats à valider -->
    <record id="action_mandats_a_valider" model="ir.actions.act_window">
        <field name="name">Mandats à valider</field>
        <field name="res_model">mandat.administratif</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'a_valider')]</field>
        <field name="context">{'default_state': 'a_valider'}</field>
    </record>

</odoo>
