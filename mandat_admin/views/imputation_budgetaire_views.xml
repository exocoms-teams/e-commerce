<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_imputation_budgetaire_list" model="ir.ui.view">
        <field name="name">imputation.budgetaire.list</field>
        <field name="model">imputation.budgetaire</field>
        <field name="arch" type="xml">
            <list string="Imputations budgétaires">
                <field name="mandat_id"/>
                <field name="chapitre"/>
                <field name="article"/>
                <field name="rubrique"/>
                <field name="libelle"/>
                <field name="credit_ouvert" sum="Total crédits ouverts"/>
                <field name="credit_engage"/>
                <field name="credit_disponible"/>
                <field name="montant_impute" sum="Total imputé"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_imputation_budgetaire" model="ir.actions.act_window">
        <field name="name">Imputations budgétaires</field>
        <field name="res_model">imputation.budgetaire</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
