<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mandat_inline_form_view" model="ir.ui.view">
        <field name="name">Mandat Administratif - Inline Form</field>
        <field name="type">qweb</field>
        <field name="key">mandat_admin.mandat_inline_form</field>
        <field name="arch" type="xml">
            <div id="mandat_administratif_form" class="mt-3">
                <p class="text-muted small mb-3">
                    Renseignez les informations de votre collectivité.
                    Les champs marqués * sont obligatoires.
                </p>
                <form action="/mandat/submit" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">SIRET acheteur public *</label>
                            <input type="text" class="form-control" name="siret" placeholder="14 chiffres" maxlength="14" required="required"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">IBAN *</label>
                            <input type="text" class="form-control" name="iban" placeholder="FR76..." required="required"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ordonnateur *</label>
                            <input type="text" class="form-control" name="ordonnateur" placeholder="Nom et prénom" required="required"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Qualité de l'ordonnateur</label>
                            <input type="text" class="form-control" name="qualite" placeholder="Ex: Maire, DGS..."/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Comptable public assignataire *</label>
                            <input type="text" class="form-control" name="comptable" placeholder="Nom du comptable" required="required"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">N° engagement juridique (EJ)</label>
                            <input type="text" class="form-control" name="ej" placeholder="N° EJ"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Service / Direction</label>
                            <input type="text" class="form-control" name="service" placeholder="Ex: Direction des finances"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Référence bon de commande</label>
                            <input type="text" class="form-control" name="reference" placeholder="Référence interne"/>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mt-3">
                        &#x1F3DB; Confirmer le paiement par Mandat Administratif
                    </button>
                </form>
            </div>
        </field>
    </record>
</odoo>
