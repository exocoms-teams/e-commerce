<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bordereau_mandat_list" model="ir.ui.view">
        <field name="name">bordereau.mandat.list</field>
        <field name="model">bordereau.mandat</field>
        <field name="arch" type="xml">
            <list string="Bordereaux de mandats"
                  decoration-success="state == 'cloture'"
                  decoration-info="state == 'transmis'">
                <field name="name"/>
                <field name="date_bordereau"/>
                <field name="collectivite_id"/>
                <field name="ordonnateur_id"/>
                <field name="nb_mandats"/>
                <field name="total_ttc" sum="Total TTC"/>
                <field name="total_net" sum="Total net"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'cloture'"
                       decoration-info="state == 'transmis'"
                       decoration-warning="state == 'emis'"/>
            </list>
        </field>
    </record>

    <record id="view_bordereau_mandat_form" model="ir.ui.view">
        <field name="name">bordereau.mandat.form</field>
        <field name="model">bordereau.mandat</field>
        <field name="arch" type="xml">
            <form string="Bordereau de Mandats">
                <header>
                    <button name="action_emettre" string="Émettre le bordereau"
                            type="object" class="btn-primary"
                            invisible="state != 'brouillon'"/>
                    <button name="action_transmettre" string="Transmettre au comptable"
                            type="object" class="btn-primary"
                            invisible="state != 'emis'"/>
                    <button name="action_cloturer" string="Clôturer"
                            type="object"
                            invisible="state != 'transmis'"/>
                    <button name="action_imprimer_bordereau" string="Imprimer"
                            type="object" class="btn-secondary"
                            invisible="state == 'brouillon'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,emis,transmis,cloture"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_bordereau"/>
                            <field name="collectivite_id"/>
                            <field name="ordonnateur_id"/>
                        </group>
                        <group>
                            <field name="nb_mandats" readonly="1"/>
                            <field name="total_ttc" readonly="1"/>
                            <field name="total_net" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="mandat_ids">
                        <list>
                            <field name="name"/>
                            <field name="date_mandat"/>
                            <field name="creancier_id"/>
                            <field name="objet"/>
                            <field name="montant_ttc"/>
                            <field name="montant_net"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                    <group>
                        <field name="note" placeholder="Observations..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bordereau_mandat" model="ir.actions.act_window">
        <field name="name">Bordereaux de mandats</field>
        <field name="res_model">bordereau.mandat</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun bordereau</p>
            <p>Créez un bordereau pour regrouper les mandats à transmettre au comptable.</p>
        </field>
    </record>

</odoo>
