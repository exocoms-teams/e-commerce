<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_move_form_ma" model="ir.ui.view">
    <field name="name">account.move.form.mandat</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">

        <xpath expr="//header" position="inside">
            <button name="action_open_chorus_pro"
                    type="object"
                    string="Ouvrir Chorus Pro"
                    invisible="not is_mandat_administratif or move_type not in ('out_invoice', 'out_refund')"/>
            <button name="action_mark_chorus_sent"
                    type="object"
                    string="Déposée sur Chorus Pro"
                    class="btn-secondary"
                    invisible="not is_mandat_administratif or statut_chorus != 'non_envoye' or state != 'posted' or move_type not in ('out_invoice', 'out_refund')"/>
            <button name="action_reset_chorus_sent"
                    type="object"
                    string="Annuler le dépôt Chorus Pro"
                    invisible="not is_mandat_administratif or statut_chorus == 'non_envoye'"/>
        </xpath>

        <xpath expr="//field[@name='invoice_payment_term_id']" position="after">
            <field name="is_mandat_administratif"/>
            <field name="mandat_sale_order_id"   invisible="not is_mandat_administratif"/>
            <field name="mandat_numero"          invisible="not is_mandat_administratif" readonly="1"/>
            <field name="numero_engagement"      invisible="not is_mandat_administratif"/>
            <field name="acheteur_siret"         invisible="not is_mandat_administratif"/>
            <field name="reference_bon_commande" invisible="not is_mandat_administratif"/>
            <field name="ordonnateur"            invisible="not is_mandat_administratif"/>
            <field name="qualite_ordonnateur"    invisible="not is_mandat_administratif"/>
            <field name="comptable_public"       invisible="not is_mandat_administratif"/>
            <field name="service_fait_certifie"  invisible="not is_mandat_administratif"/>
            <field name="date_service_fait"      invisible="not is_mandat_administratif or not service_fait_certifie"/>
            <field name="certificateur_sf"       invisible="not is_mandat_administratif or not service_fait_certifie"/>
            <field name="date_pec"               invisible="not is_mandat_administratif"/>
            <field name="date_mandatement"       invisible="not is_mandat_administratif"/>
            <field name="structure_chorus"       invisible="not is_mandat_administratif"/>
            <field name="service_chorus"         invisible="not is_mandat_administratif"/>
            <field name="statut_chorus"          invisible="not is_mandat_administratif" widget="badge"/>
            <field name="numero_chorus"          invisible="not is_mandat_administratif or statut_chorus == 'non_envoye'"/>
        </xpath>

        <xpath expr="//notebook" position="inside">
        <page string="🏛 Imputation &amp; PJ" name="page_ma_inv" invisible="not is_mandat_administratif">
            <group string="Imputation budgétaire">
                <field name="imputation_ids" nolabel="1" colspan="2">
                    <list editable="bottom">
                        <field name="section"/>
                        <field name="chapitre"/>
                        <field name="article"/>
                        <field name="exercice"/>
                        <field name="montant_mandate"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
            </group>
            <group string="Pièces justificatives">
                <field name="pj_ids" nolabel="1" colspan="2">
                    <list editable="bottom"
                          decoration-success="fournie"
                          decoration-danger="not fournie and obligatoire">
                        <field name="type_pj"/>
                        <field name="libelle"/>
                        <field name="obligatoire" widget="boolean_toggle"/>
                        <field name="fournie"     widget="boolean_toggle"/>
                        <field name="date_reception"/>
                    </list>
                </field>
            </group>
        </page>
        </xpath>
    </field>
</record>

<record id="view_account_invoice_filter_mandat" model="ir.ui.view">
    <field name="name">account.move.select.mandat</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_account_invoice_filter"/>
    <field name="arch" type="xml">
        <xpath expr="//filter[@name='draft']" position="before">
            <filter string="À déposer sur Chorus Pro"
                    name="chorus_to_send"
                    domain="[('is_mandat_administratif', '=', True), ('statut_chorus', '=', 'non_envoye'), ('state', '=', 'posted')]"/>
            <filter string="Déposées sur Chorus Pro"
                    name="chorus_sent"
                    domain="[('statut_chorus', 'not in', ('non_envoye', False))]"/>
            <separator/>
        </xpath>
    </field>
</record>

</odoo>
