<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <report id="action_report_bca"
            model="sale.order"
            string="Bon de Commande Administratif (BCA)"
            report_type="qweb-pdf"
            name="mandat_administratif.report_bca"
            file="mandat_administratif.report_bca"
            print_report_name="'BCA-' + (object.mandat_numero or object.name)"/>

    <report id="action_report_bordereau"
            model="mandat.bordereau"
            string="Bordereau de mandats"
            report_type="qweb-pdf"
            name="mandat_administratif.report_bordereau"
            file="mandat_administratif.report_bordereau"
            print_report_name="object.name or 'Bordereau'"/>
</odoo>
