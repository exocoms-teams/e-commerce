<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_bordereau" model="ir.actions.report">
        <field name="name">Bordereau de mandats</field>
        <field name="model">bordereau.mandat</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mandat_administratif_fr.report_bordereau_template</field>
        <field name="report_file">mandat_administratif_fr.report_bordereau_template</field>
        <field name="print_report_name">'Bordereau_%s' % (object.name,)</field>
        <field name="binding_model_id" ref="model_bordereau_mandat"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_bordereau_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb-3">
                            <div class="col-8">
                                <h4><t t-out="o.collectivite_id.name"/></h4>
                            </div>
                            <div class="col-4 text-end">
                                <h2>BORDEREAU DE MANDATS</h2>
                            </div>
                        </div>
                        <hr/>
                        <div class="row mb-3">
                            <div class="col-4">
                                <strong>N° bordereau :</strong> <t t-out="o.name"/>
                            </div>
                            <div class="col-4">
                                <strong>Date :</strong> <t t-out="o.date_bordereau"/>
                            </div>
                            <div class="col-4">
                                <strong>Ordonnateur :</strong> <t t-out="o.ordonnateur_id.name"/>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered mt-3">
                            <thead class="table-secondary">
                                <tr>
                                    <th>#</th>
                                    <th>N° Mandat</th>
                                    <th>Date</th>
                                    <th>Créancier</th>
                                    <th>Objet</th>
                                    <th class="text-end">Montant TTC</th>
                                    <th class="text-end">Net à payer</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="i" t-value="0"/>
                                <t t-foreach="o.mandat_ids" t-as="m">
                                    <t t-set="i" t-value="i + 1"/>
                                    <tr>
                                        <td><t t-out="i"/></td>
                                        <td><t t-out="m.name"/></td>
                                        <td><t t-out="m.date_mandat"/></td>
                                        <td><t t-out="m.creancier_id.name"/></td>
                                        <td><t t-out="m.objet"/></td>
                                        <td class="text-end"><t t-out="'%.2f €' % m.montant_ttc"/></td>
                                        <td class="text-end"><t t-out="'%.2f €' % m.montant_net"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot class="table-primary">
                                <tr>
                                    <td colspan="5"><strong>TOTAUX (<t t-out="o.nb_mandats"/> mandats)</strong></td>
                                    <td class="text-end"><strong><t t-out="'%.2f €' % o.total_ttc"/></strong></td>
                                    <td class="text-end"><strong><t t-out="'%.2f €' % o.total_net"/></strong></td>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                <p>L'Ordonnateur,</p>
                                <br/><br/><br/>
                                <p><t t-out="o.ordonnateur_id.name"/></p>
                            </div>
                            <div class="col-6 text-center">
                                <p>Le Comptable assignataire,</p>
                                <br/><br/><br/>
                                <p>_______________________</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
