<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_bordereau_form" model="ir.ui.view">
    <field name="name">mandat.bordereau.form</field>
    <field name="model">mandat.bordereau</field>
    <field name="arch" type="xml">
        <form string="Bordereau de mandats">
            <header>
                <button name="action_emettre"     string="Émettre"                  type="object" class="btn-primary"   invisible="state != 'draft'"/>
                <button name="action_signer"      string="Signer"                   type="object" class="btn-primary"   invisible="state != 'emis'"/>
                <button name="action_transmettre" string="Transmettre au comptable" type="object" class="btn-secondary" invisible="state != 'signe'"/>
                <button name="action_acquitter"   string="Acquitter"                type="object" class="btn-success"   invisible="state != 'transmis'"/>
                <button name="action_print"       string="🖨 Imprimer"              type="object" class="btn-secondary"/>
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,emis,signe,transmis,acquitte"/>
            </header>
            <sheet>
                <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                <group col="4">
                    <field name="date_emission"/>
                    <field name="date_debut"/>
                    <field name="date_fin"/>
                    <field name="nombre_mandats" readonly="1"/>
                    <field name="ordonnateur"/>
                    <field name="comptable_public"/>
                    <field name="montant_total" widget="monetary" readonly="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="date_signature"   invisible="state not in ('signe','transmis','acquitte')"/>
                    <field name="date_transmission" invisible="state not in ('transmis','acquitte')"/>
                </group>
                <group string="Mandats inclus">
                    <field name="invoice_ids" nolabel="1" colspan="2">
                        <list>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="invoice_date"/>
                            <field name="mandat_numero"/>
                            <field name="amount_total" widget="monetary"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </group>
                <group string="Observations">
                    <field name="note" nolabel="1" colspan="2"/>
                </group>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>

<record id="view_bordereau_list" model="ir.ui.view">
    <field name="name">mandat.bordereau.list</field>
    <field name="model">mandat.bordereau</field>
    <field name="arch" type="xml">
        <list string="Bordereaux de mandats">
            <field name="name"/>
            <field name="date_emission"/>
            <field name="date_debut"/>
            <field name="date_fin"/>
            <field name="ordonnateur"/>
            <field name="nombre_mandats"/>
            <field name="montant_total" widget="monetary"/>
            <field name="currency_id" column_invisible="1"/>
            <field name="state" widget="badge"
                   decoration-success="state == 'acquitte'"
                   decoration-info="state in ('emis','signe')"
                   decoration-warning="state == 'transmis'"/>
        </list>
    </field>
</record>

<record id="action_mandat_bordereau" model="ir.actions.act_window">
    <field name="name">Bordereaux de mandats</field>
    <field name="res_model">mandat.bordereau</field>
    <field name="view_mode">list,form</field>
</record>

<record id="action_bordereau_wizard" model="ir.actions.act_window">
    <field name="name">Créer un bordereau</field>
    <field name="res_model">bordereau.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>

</odoo>
