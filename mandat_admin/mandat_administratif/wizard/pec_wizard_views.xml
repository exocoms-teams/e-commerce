<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_pec_wizard_form" model="ir.ui.view">
    <field name="name">pec.wizard.form</field>
    <field name="model">pec.wizard</field>
    <field name="arch" type="xml">
        <form string="Prise en charge comptable (PEC)">
            <group col="2">
                <field name="mandat_numero" readonly="1"/>
                <field name="amount_total"  readonly="1" widget="monetary"/>
                <field name="currency_id"   invisible="1"/>
            </group>
            <separator/>
            <group col="2">
                <field name="decision"/>
                <field name="date_pec"/>
                <field name="reference_pec"      placeholder="N° PEC attribué par le comptable"/>
                <field name="comptable_nom"       placeholder="Prénom NOM du comptable"/>
                <field name="date_limite"        invisible="decision != 'suspendue'"/>
            </group>
            <group invisible="decision == 'acceptee'">
                <field name="motif_rejet"      nolabel="1" colspan="2"
                       placeholder="Motif du rejet ou de la suspension"/>
            </group>
            <group invisible="decision != 'suspendue'">
                <field name="pieces_demandees" nolabel="1" colspan="2"
                       placeholder="Liste des pièces complémentaires demandées"/>
            </group>
            <footer>
                <button name="action_valider" string="✅ Valider la PEC"
                        type="object" class="btn-primary"/>
                <button string="Annuler" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>
</odoo>
