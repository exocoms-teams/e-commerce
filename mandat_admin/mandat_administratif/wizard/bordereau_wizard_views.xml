<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_bordereau_wizard_form" model="ir.ui.view">
    <field name="name">bordereau.wizard.form</field>
    <field name="model">bordereau.wizard</field>
    <field name="arch" type="xml">
        <form string="Création d'un bordereau de mandats">
            <group col="2">
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="ordonnateur"/>
                <field name="comptable_public"/>
                <field name="auto_select"/>
            </group>
            <group string="Mandats à inclure">
                <field name="invoice_ids" nolabel="1" colspan="2">
                    <list>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="invoice_date"/>
                        <field name="mandat_numero"/>
                        <field name="amount_total" widget="monetary"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
            </group>
            <group string="Observations">
                <field name="note" nolabel="1" colspan="2"/>
            </group>
            <footer>
                <button name="action_creer" string="✅ Créer le bordereau"
                        type="object" class="btn-primary"/>
                <button string="Annuler" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>
</odoo>
