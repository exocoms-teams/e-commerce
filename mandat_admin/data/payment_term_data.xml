<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_term_mandat_30" model="account.payment.term">
        <field name="name">Mandat administratif — 30 jours</field>
        <field name="note">Délai global de paiement : État, collectivités territoriales et établissements publics administratifs (art. R. 2192-10 du Code de la commande publique).</field>
        <field name="line_ids" eval="[(5, 0, 0), (0, 0, {'value': 'percent', 'value_amount': 100.0, 'nb_days': 30, 'delay_type': 'days_after'})]"/>
    </record>

    <record id="payment_term_mandat_50" model="account.payment.term">
