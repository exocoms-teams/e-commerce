    </record>

    <record id="payment_term_mandat_60" model="account.payment.term">
        <field name="name">Mandat administratif — 60 jours</field>
        <field name="note">Délai global de paiement : entreprises publiques (loi de modernisation de l'économie).</field>
        <field name="line_ids" eval="[(5, 0, 0), (0, 0, {'value': 'percent', 'value_amount': 100.0, 'nb_days': 60, 'delay_type': 'days_after'})]"/>
    </record>

</odoo>
