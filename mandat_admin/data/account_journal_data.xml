<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Journal comptable "Mandat Administratif".
            Type 'general' (opérations diverses) : neutre et compatible avec
            account.move de type 'entry' générée lors d'un paiement manuel.
            On utilise noupdate="1" pour ne pas écraser les personnalisations.
        -->
        <record id="account_journal_mandat_administratif" model="account.journal">
            <field name="name">Mandat Administratif</field>
            <field name="code">MAND</field>
            <field name="type">bank</field>
            <field name="sequence">99</field>
            <!-- Icône distincte dans la liste des journaux -->
            <field name="color">10</field>
            <field name="default_account_id" ref="l10n_fr.1_pcg_512"/>
        </record>
    </data>
</odoo>
