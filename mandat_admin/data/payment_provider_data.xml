<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="payment_provider_mandat_administratif" model="payment.provider">
            <field name="name">Mandat Administratif</field>
            <field name="code">mandat_administratif</field>
            <field name="state">enabled</field>
            <field name="is_published">True</field>
            <field name="pending_msg"><![CDATA[
                <p>Vous avez choisi de payer par <strong>Mandat Administratif</strong>.</p>
                <p>Votre commande sera confirmée et un bon de commande administratif (BCA)
                vous sera transmis. Le paiement interviendra dans un délai de 30 jours
                conformément à l'article L.2192-10 du Code de la commande publique.</p>
                <p>Pour toute question, contactez notre service comptabilité.</p>
            ]]></field>
        </record>

        <record id="payment_method_mandat_administratif" model="payment.method">
            <field name="name">Mandat Administratif</field>
            <field name="code">mandat_administratif</field>
            <field name="provider_ids" eval="[(4, ref('payment_provider_mandat_administratif'))]"/>
        </record>
    </data>
</odoo>
