<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Séquence mandats -->
        <record id="seq_mandat_administratif" model="ir.sequence">
            <field name="name">Mandat Administratif</field>
            <field name="code">mandat.administratif</field>
            <field name="prefix">MAND/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Séquence bordereaux -->
        <record id="seq_bordereau_mandat" model="ir.sequence">
            <field name="name">Bordereau de Mandats</field>
            <field name="code">bordereau.mandat</field>
            <field name="prefix">BORD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Séquence engagements -->
        <record id="seq_engagement_budgetaire" model="ir.sequence">
            <field name="name">Engagement Budgétaire</field>
            <field name="code">engagement.budgetaire</field>
            <field name="prefix">ENG/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
