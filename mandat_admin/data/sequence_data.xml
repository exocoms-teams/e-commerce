<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_mandat_administratif" model="ir.sequence">
        <field name="name">Mandat Administratif</field>
        <field name="code">mandat.administratif</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">True</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_mandat_bordereau" model="ir.sequence">
        <field name="name">Bordereau Mandats</field>
        <field name="code">mandat.bordereau</field>
        <field name="prefix">BORD/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="use_date_range">True</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
