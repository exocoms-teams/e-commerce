<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WIN-83 : vue liste simple, filtrable par statut -->
    <record id="view_tracker_cron_log_list" model="ir.ui.view">
        <field name="name">tracker.cron.log.list</field>
        <field name="model">tracker.cron.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'error'" decoration-success="status == 'success'" create="false" edit="false">
                <field name="execution_date"/>
                <field name="cron_name"/>
                <field name="status"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_tracker_cron_log_search" model="ir.ui.view">
        <field name="name">tracker.cron.log.search</field>
        <field name="model">tracker.cron.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="cron_name"/>
                <filter string="Succès" name="filter_success" domain="[('status', '=', 'success')]"/>
                <filter string="Erreur" name="filter_error" domain="[('status', '=', 'error')]"/>
                <separator/>
                <group>
                    <filter string="Script" name="group_by_cron_name" context="{'group_by': 'cron_name'}"/>
                    <filter string="Statut" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tracker_cron_log" model="ir.actions.act_window">
        <field name="name">Journal des collectes</field>
        <field name="res_model">tracker.cron.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_tracker_cron_log_search"/>
    </record>

    <menuitem id="menu_tracker_cron_log" name="Journal des collectes" parent="menu_trend_root"
              action="action_tracker_cron_log" sequence="30"/>
</odoo>
