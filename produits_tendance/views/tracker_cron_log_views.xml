<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tracker_cron_log_list" model="ir.ui.view">
        <field name="name">tracker.cron.log.list</field>
        <field name="model">tracker.cron.log</field>
        <field name="arch" type="xml">
            <list default_order="execution_date desc, id desc"
                  decoration-danger="status == 'error'"
                  decoration-success="status == 'success'"
                  create="false"
                  edit="false"
                  delete="false">
                <field name="execution_date"/>
                <field name="cron_name"/>
                <field name="status"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_tracker_cron_log_search" model="ir.ui.view">
        <field name="name">tracker.cron.log.search</field>
        <field name="model">tracker.cron.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="cron_name"/>
                <field name="message"/>
                <filter name="errors"
                        string="Errors"
                        domain="[('status', '=', 'error')]"/>
                <filter name="successes"
                        string="Successful executions"
                        domain="[('status', '=', 'success')]"/>
                <separator/>
                <filter name="execution_date"
                        string="Execution date"
                        date="execution_date"/>
                <group>
                    <filter name="group_script"
                            string="Script"
                            context="{'group_by': 'cron_name'}"/>
                    <filter name="group_status"
                            string="Status"
                            context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tracker_cron_log" model="ir.actions.act_window">
        <field name="name">Cron supervision</field>
        <field name="res_model">tracker.cron.log</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_tracker_cron_log_list"/>
        <field name="search_view_id" ref="view_tracker_cron_log_search"/>
        <field name="context">{'search_default_errors': 1}</field>
    </record>

    <menuitem id="menu_tracker_cron_log"
              name="Supervision"
              parent="menu_trend_root"
              action="action_tracker_cron_log"
              groups="base.group_system"
              sequence="30"/>
</odoo>