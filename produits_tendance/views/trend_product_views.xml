<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. VUE LISTE -->
    <record id="view_trend_product_list" model="ir.ui.view">
        <field name="name">trend.product.list</field>
        <field name="model">trend.product</field>
        <field name="arch" type="xml">
            <list default_order="date desc">
                <field name="name"/>
                <field name="category_id"/>
                <field name="sales_count"/>
                <field name="score_site_x"/>
                <field name="country"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <!-- 2. VUE FORMULAIRE -->
    <record id="view_trend_product_form" model="ir.ui.view">
        <field name="name">trend.product.form</field>
        <field name="model">trend.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_ref"/>
                            <field name="category_id"/>
                            <field name="country"/>
                        </group>
                        <group>
                            <field name="sales_count"/>
                            <field name="date"/>
                            <field name="score_site_x"/>
                            <field name="source"/>
                            <!-- Affichage en tant que lien cliquable -->
                            <field name="image_url" widget="url"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 3. VUE KANBAN (regroupée par catégorie) -->
    <record id="view_trend_product_kanban" model="ir.ui.view">
        <field name="name">trend.product.kanban</field>
        <field name="model">trend.product</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="category_id">
                <field name="name"/>
                <field name="category_id"/>
                <field name="sales_count"/>
                <field name="country"/>
                <!-- IL EST OBLIGATOIRE DE DÉCLARER LE CHAMP ICI POUR L'UTILISER DANS LE TEMPLATE -->
                <field name="image_url"/>
                
                <templates>
                    <t t-name="card">
                        <!-- Utilisation de d-flex (Flexbox) pour aligner l'image et le texte côte à côte -->
                        <div class="oe_kanban_card oe_kanban_global_click d-flex align-items-center">
                            
                            <!-- Zone de l'image (s'affiche uniquement si l'URL existe) -->
                            <div class="o_kanban_image me-3" t-if="record.image_url.raw_value">
                                <img t-att-src="record.image_url.raw_value" 
                                     alt="Image du produit" 
                                     style="width: 70px; height: 70px; object-fit: cover; border-radius: 8px;"/>
                            </div>
                            
                            <!-- Zone du texte -->
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title" style="font-size: 14px;">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted mt-1">
                                    <i class="fa fa-shopping-cart"></i> Ventes : <field name="sales_count"/>
                                </div>
                                <div class="text-muted">
                                    <i class="fa fa-globe"></i> Pays : <field name="country"/>
                                </div>
                            </div>
                            
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 4. VUE RECHERCHE -->
    <!-- (inchangée) -->
    <record id="view_trend_product_search" model="ir.ui.view">
        <field name="name">trend.product.search</field>
        <field name="model">trend.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <field name="country"/>
                <group>
                    <filter string="Catégorie" name="group_by_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Pays" name="group_by_country" context="{'group_by': 'country'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 5. L'ACTION -->
    <!-- (inchangée) -->
    <record id="action_trend_product" model="ir.actions.act_window">
        <field name="name">Produits</field>
        <field name="res_model">trend.product</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_trend_product_search"/>
    </record>

    <!-- 6. LE MENU -->
    <!-- (inchangée) -->
    <menuitem id="menu_trend_product" name="Produits" parent="menu_trend_root" action="action_trend_product" sequence="10"/>
</odoo>