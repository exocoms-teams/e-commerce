<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_submit_trend_form" name="Audit de produit">
        <t t-call="website.layout">
            <style>
                @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700&amp;display=swap');
            </style>

            <div id="wrap" class="o_winners_app_layout">
                <t t-call="produits_tendance.template_sidebar"/>

                <div class="container mt-5 mb-5 o_winners_submission_form o_winners_app_layout__content">
                    <div class="text-center mb-5 o_winners_submission_form__header">
                        <h1>Testez le potentiel d'un produit</h1>
                        <p>
                            Vous avez une idée en tête ou par expérience ?
                            Laissez notre algorithme analyser les tendances pour vous.
                        </p>
                    </div>

                    <div
                        t-if="request.params.get('success')"
                        class="o_winners_card o_winners_submission_form__success mt-4"
                        role="alert"
                    >
                        <h4 class="o_winners_submission_form__success_title">
                            Merci pour votre contribution ! 🎉
                        </h4>
                        <p>
                            Votre suggestion a bien été enregistrée.
                            Notre équipe de modération va l'étudier dans les plus brefs délais.
                        </p>
                        <hr/>
                        <p class="mb-0">
                            Vous recevrez un email de notre part dès que votre produit
                            aura été examiné pour vous tenir informé du résultat.
                        </p>
                    </div>

                    <div class="row justify-content-center">
                        <div class="col-md-8">
                            <form
                                action="/submit-trend/process"
                                method="POST"
                                class="o_winners_card o_winners_submission_form__card"
                            >
                                <input
                                    type="hidden"
                                    name="csrf_token"
                                    t-att-value="request.csrf_token()"
                                />

                                <fieldset class="mb-4">
                                    <legend class="form-label fw-bold fs-6">
                                        Dites-nous en plus sur ce produit :
                                    </legend>

                                    <div class="form-check">
                                        <input
                                            class="form-check-input o_winners_submission_form__radio"
                                            type="radio"
                                            name="submission_reason"
                                            id="reason1"
                                            value="intuition"
                                            checked="checked"
                                        />
                                        <label class="form-check-label" for="reason1">
                                            C'est une intuition, j'ai ce produit en tête.
                                        </label>
                                    </div>

                                    <div class="form-check">
                                        <input
                                            class="form-check-input o_winners_submission_form__radio"
                                            type="radio"
                                            name="submission_reason"
                                            id="reason2"
                                            value="experience"
                                        />
                                        <label class="form-check-label" for="reason2">
                                            Par expérience, c'est une niche que je connais bien.
                                        </label>
                                    </div>

                                    <div class="form-check">
                                        <input
                                            class="form-check-input o_winners_submission_form__radio"
                                            type="radio"
                                            name="submission_reason"
                                            id="reason3"
                                            value="spotted"
                                        />
                                        <label class="form-check-label" for="reason3">
                                            Je l'ai vu passer massivement sur les réseaux sociaux.
                                        </label>
                                    </div>
                                </fieldset>

                                <hr/>

                                <div class="mb-3">
                                    <label for="name" class="form-label">
                                        Quel est le nom du produit ?
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input
                                        id="name"
                                        type="text"
                                        class="form-control o_winners_submission_form__input"
                                        name="name"
                                        placeholder="Ex: Correcteur de posture intelligent"
                                        required="required"
                                    />
                                </div>

                                <div class="mb-3">
                                    <label for="link_or_desc" class="form-label">
                                        Lien ou Description du produit
                                        <span class="text-danger">*</span>
                                    </label>
                                    <textarea
                                        id="link_or_desc"
                                        class="form-control o_winners_submission_form__input"
                                        name="link_or_desc"
                                        rows="2"
                                        placeholder="Collez l'URL du produit ou décrivez-le ici..."
                                        required="required"
                                    ></textarea>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="category" class="form-label">
                                            Catégorie cible
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input
                                            id="category"
                                            type="text"
                                            class="form-control o_winners_submission_form__input"
                                            name="category"
                                            placeholder="Ex: Santé &amp; Bien-être"
                                            required="required"
                                        />
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="country" class="form-label">
                                            Pays ciblé (Code à 2 lettres)
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input
                                            id="country"
                                            type="text"
                                            class="form-control o_winners_submission_form__input"
                                            name="country"
                                            placeholder="Ex: FR, US, MA"
                                            required="required"
                                            maxlength="2"
                                        />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="email" class="form-label">
                                        Votre adresse email (pour recevoir l'audit)
                                    </label>
                                    <input
                                        id="email"
                                        type="email"
                                        class="form-control o_winners_submission_form__input"
                                        name="email"
                                        placeholder="exemple@email.com"
                                    />
                                </div>

                                <div class="d-grid mt-4">
                                    <button type="submit" class="o_winners_btn_primary">
                                        Lancer l'audit du produit
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>