<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="template_winners_dashboard" name="Winners Dashboard">
            <t t-call="website.layout">
                <!-- Conteneur principal -->
                <div class="container mt-5 mb-5 o_winners_dashboard_header">
                    <h1 class="mb-5 text-center" style="color: #1B3A6B; font-weight: bold;">
                        Dashboard d'Ingestion Winners
                    </h1>
                    
                    <div class="row">
                        <!-- ========================================== -->
                        <!-- CARTE 1 : CONTRÔLEUR EBAY                  -->
                        <!-- ========================================== -->
                        <div class="col-md-6 mb-4">
                            <div class="card shadow-sm p-4 h-100" style="border-top: 4px solid #1B3A6B;">
                                <h3 class="card-title" style="color: #1B3A6B;">
                                    📡 Détection eBay Live
                                </h3>
                                <p class="text-muted">Recherchez des produits gagnants ("Achat Immédiat", état "Neuf") et importez-les dans la base.</p>
                                
                                <div class="mb-4 mt-4">
                                    <label for="ebay_keyword" class="form-label font-weight-bold">Mot-clé cible</label>
                                    <input type="text" id="ebay_keyword" class="form-control form-control-lg" placeholder="ex: smartwatch, écouteurs..."/>
                                </div>
                                
                                <button id="btn_run_scan" class="btn w-100 text-white btn-lg o_winners_btn_primary" style="background-color: #1B3A6B;">
                                    <i class="fa fa-download"></i> Lancer l'ingestion eBay
                                </button>
                                
                                <div id="ebay_alert" class="alert d-none mt-4" role="alert"></div>
                            </div>
                        </div>

                        <!-- ========================================== -->
                        <!-- CARTE 2 : CONTRÔLEUR META ADS              -->
                        <!-- ========================================== -->
                        <div class="col-md-6 mb-4">
                            <div class="card shadow-sm p-4 h-100" style="border-top: 4px solid #1877F2;">
                                <h3 class="card-title" style="color: #1877F2;">
                                    <i class="fa fa-facebook-square"></i> Détection Meta Ads
                                </h3>
                                <p class="text-muted">Analysez la bibliothèque Meta pour lier des publicités performantes aux produits.</p>
                                
                                <div class="mb-3 mt-4">
                                    <label for="meta_keyword" class="form-label font-weight-bold">Mot-clé libre</label>
                                    <input type="text" id="meta_keyword" class="form-control form-control-lg" placeholder="ex: posture corrector..."/>
                                </div>
                                
                                <button id="btn_run_meta_scan" class="btn w-100 text-white btn-lg mb-3" style="background-color: #1877F2;">
                                    <i class="fa fa-search"></i> Scanner les publicités
                                </button>
                                
                                <div id="meta_alert" class="alert d-none mt-4" role="alert"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>