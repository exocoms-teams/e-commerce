<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         WIN-47 : Module Connexion / Inscription
         Application du style Winners sur les formulaires d'authentification
    ============================================================ -->

    <!-- Surcharge globale du formulaire d'inscription pour ajouter les classes Winners -->
    <template id="auth_signup_signup_winners" inherit_id="auth_signup.signup" name="Winners - Formulaire inscription">
        <!-- On cible le formulaire lui-même au lieu de chercher des classes instables -->
        <xpath expr="//form" position="attributes">
            <attribute name="class" add="o_winners_signup_form" separator=" "/>
        </xpath>
    </template>

    <!-- Surcharge des champs additionnels (mot de passe) -->
    <template id="auth_signup_fields_winners" inherit_id="auth_signup.fields" name="Winners - Champs mot de passe">
        <!-- On ajoute une classe enveloppe globale si besoin -->
        <xpath expr="//div[hasclass('mb-3')]" position="attributes">
            <attribute name="class" add="o_winners_signup_field" separator=" "/>
        </xpath>
    </template>

</odoo>