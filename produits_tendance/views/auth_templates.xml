<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         WIN-47 : Module Connexion / Inscription
         Hérite des templates natifs auth_signup pour appliquer la
         charte graphique Winners (préfixe o_winners_).

         Contrainte CSRF (WIN-47) : vérifiée dans l'arch native de
         auth_signup.signup — le token est déjà écrit en dur
         (<input type="hidden" name="csrf_token" .../>), aucune
         surcharge nécessaire ici.
    ============================================================ -->

    <!-- Champs nom + email (template principal du formulaire) -->
    <template id="auth_signup_signup_winners" inherit_id="auth_signup.signup" name="Winners - Formulaire inscription">

        <xpath expr="//div[hasclass('field-name')]" position="attributes">
            <attribute name="class" add="o_winners_signup_field" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('field-login')]" position="attributes">
            <attribute name="class" add="o_winners_signup_field" separator=" "/>
        </xpath>

    </template>

    <!-- Champs mot de passe (template appelé par le formulaire principal) -->
    <template id="auth_signup_fields_winners" inherit_id="auth_signup.fields" name="Winners - Champs mot de passe">

        <xpath expr="//div[hasclass('field-password')]" position="attributes">
            <attribute name="class" add="o_winners_signup_field" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('field-confirm_password')]" position="attributes">
            <attribute name="class" add="o_winners_signup_field" separator=" "/>
        </xpath>

    </template>

    <!-- ============================================================
         WIN-121 : Pôle Authentification (Connexion, Inscription,
         Boutons Sociaux)

         Restyle complet des pages Connexion (/web/login) et
         Inscription (/web/signup) selon la nouvelle maquette :
         layout 2 colonnes (panneau sombre à gauche / formulaire
         blanc à droite), footer légal commun, boutons de connexion
         sociale non fonctionnels ("Bientôt disponible").

         ⚠️ Contrainte respectée : AUCUNE logique d'authentification
         ni règle de validation n'est modifiée ici. On ne touche qu'à
         la structure HTML/CSS autour des formulaires natifs
         (web.login / auth_signup.signup), qui restent fonctionnellement
         intacts (mêmes champs, mêmes name=, même csrf_token, même
         action de soumission).

         web.login_layout est le template partagé par /web/login,
         /web/signup et /web/reset_password : le surcharger une seule
         fois habille donc les 3 pages en même temps.
    ============================================================ -->

    <template id="web_login_layout_winners" inherit_id="web.login_layout" name="Winners - Layout Authentification (2 colonnes)">

        <!-- Le conteneur Bootstrap devient notre grille 2 colonnes -->
        <xpath expr="//div[hasclass('container') and hasclass('py-5')]" position="attributes">
            <attribute name="id">o_winners_auth_page</attribute>
            <attribute name="class" add="o_winners_auth_page" separator=" "/>
        </xpath>

        <!-- La carte native devient le panneau blanc de droite -->
        <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]" position="attributes">
            <attribute name="t-attf-class">card border-0 mx-auto bg-100 {{login_card_classes}} o_database_list o_winners_auth_card</attribute>
            <attribute name="style">max-width: 480px;</attribute>
        </xpath>

        <!-- Le logo générique Odoo en haut de carte n'a pas sa place
             dans la maquette (le logo Winners vit dans le panneau
             gauche) : on le masque plutôt que de le supprimer, pour
             ne rien casser si un module tiers dépend de ce bloc. -->
        <xpath expr="//div[hasclass('text-center') and hasclass('pb-3') and hasclass('border-bottom') and hasclass('mb-4')]" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>

        <!-- Panneau gauche : accroche produit + bénéfices + partenaires.
             Contenu texte uniquement (pas de logos de marques réels
             reproduits, pour rester neutre côté droits/marques) -->
        <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]" position="before">
            <div class="o_winners_auth_side">
                <div class="o_winners_auth_side_inner">
                    <div class="o_winners_auth_logo">
                        <span class="o_winners_auth_logo_mark">●</span>
                        <span class="o_winners_auth_logo_text">Winners</span>
                    </div>

                    <h1 class="o_winners_auth_title">
                        Découvrez les produits qui vont
                        <span class="o_winners_auth_accent">exploser</span>
                    </h1>
                    <p class="o_winners_auth_subtitle">
                        Accédez à des données fiables, suivez les tendances en temps réel
                        et prenez des décisions gagnantes.
                    </p>

                    <ul class="o_winners_auth_features list-unstyled">
                        <li>
                            <span class="o_winners_auth_feature_icon"><i class="fa fa-line-chart"/></span>
                            <div>
                                <strong>Tendances en temps réel</strong>
                                <span>Analysez des millions de données chaque jour.</span>
                            </div>
                        </li>
                        <li>
                            <span class="o_winners_auth_feature_icon"><i class="fa fa-shield"/></span>
                            <div>
                                <strong>Données fiables</strong>
                                <span>Des sources vérifiées et mises à jour en continu.</span>
                            </div>
                        </li>
                        <li>
                            <span class="o_winners_auth_feature_icon"><i class="fa fa-bolt"/></span>
                            <div>
                                <strong>Décisions gagnantes</strong>
                                <span>Identifiez les opportunités avant tout le monde.</span>
                            </div>
                        </li>
                    </ul>

                    <div class="o_winners_auth_partners">
                        <span class="o_winners_auth_partners_label">
                            Intégrations avec vos plateformes préférées
                        </span>
                        <div class="o_winners_auth_partners_logos">
                            <img class="o_winners_auth_partner_logo" src="/produits_tendance/static/src/img/partners/shopify.svg" alt="Shopify"/>
                            <img class="o_winners_auth_partner_logo" src="/produits_tendance/static/src/img/partners/woocommerce.svg" alt="WooCommerce"/>
                            <img class="o_winners_auth_partner_logo" src="/produits_tendance/static/src/img/partners/amazon.svg" alt="Amazon"/>
                            <img class="o_winners_auth_partner_logo" src="/produits_tendance/static/src/img/partners/tiktok.svg" alt="TikTok"/>
                            <img class="o_winners_auth_partner_logo" src="/produits_tendance/static/src/img/partners/facebook.svg" alt="Facebook"/>
                            <img class="o_winners_auth_partner_logo" src="/produits_tendance/static/src/img/partners/ebay.svg" alt="eBay"/>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>

        <!-- Footer légal commun aux 2 vues, sous les colonnes.
             Réutilise les routes créées en WIN-102. -->
        <xpath expr="//div[hasclass('container') and hasclass('py-5')]" position="after">
            <div class="o_winners_auth_footer text-center small">
                <i class="fa fa-lock me-1" role="presentation"/> Vos données sont sécurisées
                <span class="o_winners_auth_footer_sep">|</span>
                <a href="/confidentialite">Politique de confidentialité</a>
                <span class="o_winners_auth_footer_sep">|</span>
                <a href="/cgu">Conditions d'utilisation</a>
            </div>
        </xpath>

    </template>

    <!-- Page Connexion (/web/login) — titre, icônes, "Se souvenir de moi",
         texte du bouton. -->
    <template id="web_login_winners" inherit_id="web.login" name="Winners - Page Connexion">

        <!-- Titre + sous-titre au-dessus du formulaire -->
        <xpath expr="//form[contains(@t-attf-class, 'oe_login_form')]" position="before">
            <div class="o_winners_auth_welcome">
                <span class="o_winners_auth_welcome_pretitle">Bienvenue !</span>
                <h2 class="o_winners_auth_form_title">Connexion</h2>
                <p class="o_winners_auth_form_subtitle">Connectez-vous à votre compte pour continuer</p>
            </div>
        </xpath>

        <!-- Icône enveloppe dans le champ email (visuel uniquement,
             l'input natif — name/id/required — n'est pas modifié) -->
        <xpath expr="//div[hasclass('field-login')]" position="attributes">
            <attribute name="class" add="o_winners_field_icon" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('field-login')]//input[@name='login']" position="before">
            <i class="fa fa-envelope-o o_winners_field_icon_glyph" role="presentation"/>
        </xpath>

        <!-- Icône cadenas dans le champ mot de passe -->
        <xpath expr="//div[hasclass('o_caps_lock_warning')]//div[hasclass('input-group')]" position="attributes">
            <attribute name="class" add="o_winners_field_icon" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('o_caps_lock_warning')]//input[@name='password']" position="before">
            <i class="fa fa-lock o_winners_field_icon_glyph" role="presentation"/>
        </xpath>

        <!-- "Se souvenir de moi" — case décorative demandée par la
             maquette. Non reliée à une logique de session persistante
             (hors périmètre de ce ticket, cf. contrainte "ne pas
             modifier la logique d'authentification"). -->
        <xpath expr="//div[hasclass('o_caps_lock_warning')]" position="after">
            <div class="form-check o_winners_remember_me">
                <input class="form-check-input" type="checkbox" id="o_winners_remember_me"/>
                <label class="form-check-label" for="o_winners_remember_me">Se souvenir de moi</label>
            </div>
        </xpath>

        <!-- Texte + flèche sur le bouton de soumission -->
        <xpath expr="//div[hasclass('oe_login_buttons')]/button[@type='submit']" position="replace">
            <button type="submit" class="btn btn-primary">
                Se connecter <i class="fa fa-arrow-right ms-1" role="presentation"/>
            </button>
        </xpath>

    </template>

    <!-- Page Inscription (/web/signup) — titre, icônes, texte du bouton -->
    <template id="auth_signup_signup_winners_content" inherit_id="auth_signup.signup" name="Winners - Contenu page Inscription">

        <xpath expr="//form[hasclass('oe_signup_form')]" position="before">
            <div class="o_winners_auth_welcome">
                <span class="o_winners_auth_welcome_pretitle">Bienvenue !</span>
                <h2 class="o_winners_auth_form_title">Créer un compte</h2>
                <p class="o_winners_auth_form_subtitle">Créez votre compte pour commencer</p>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('field-name')]" position="attributes">
            <attribute name="class" add="o_winners_field_icon" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('field-name')]//input[@name='name']" position="before">
            <i class="fa fa-user-o o_winners_field_icon_glyph" role="presentation"/>
        </xpath>

        <xpath expr="//div[hasclass('field-login')]" position="attributes">
            <attribute name="class" add="o_winners_field_icon" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('field-login')]//input[@name='login']" position="before">
            <i class="fa fa-envelope-o o_winners_field_icon_glyph" role="presentation"/>
        </xpath>

        <xpath expr="//div[hasclass('oe_login_buttons')]/button[@type='submit']" position="replace">
            <button type="submit" class="btn btn-primary mb-1">
                Créer un compte <i class="fa fa-arrow-right ms-1" role="presentation"/>
            </button>
        </xpath>

    </template>

    <!-- Liens "Vous n'avez pas de compte ?" / "Vous avez déjà un compte ?"
         en français, cohérent avec le reste de l'interface. -->
    <template id="auth_signup_login_winners" inherit_id="auth_signup.login" name="Winners - Lien inscription (FR)">
        <xpath expr="//div[hasclass('oe_login_buttons')]/a[@t-attf-href]" position="replace">
            <a t-if="signup_enabled" class="btn btn-link btn-sm mt-2" t-attf-href="/web/signup?{{ keep_query() }}">
                Vous n'avez pas de compte ? <strong>Créer un compte</strong>
            </a>
        </xpath>
    </template>

    <template id="auth_signup_signup_winners_login_link" inherit_id="auth_signup.signup" name="Winners - Lien connexion (FR)">
        <xpath expr="//a[@t-attf-href='/web/login?{{ keep_query() }}']" position="replace">
            <a t-attf-href="/web/login?{{ keep_query() }}" class="btn btn-link btn-sm mt-2" role="button">
                Vous avez déjà un compte ? <strong>Se connecter</strong>
            </a>
        </xpath>
    </template>

    <!-- Boutons de connexion sociale — WIN-121 : non fonctionnels,
         affichent un toast "Bientôt disponible" au clic.
         auth_btns est normalement alimenté par les modules OAuth réels
         (google_account, etc.) ; ici on remplace entièrement l'affichage
         par 3 boutons statiques, sans toucher à web.login_oauth pour les
         autres consommateurs éventuels du template natif. -->
    <template id="web_login_oauth_winners" inherit_id="web.login_oauth" name="Winners - Boutons sociaux (non fonctionnels)">
        <xpath expr="//div[hasclass('o_login_auth')]" position="replace">
            <div class="o_winners_auth_social">
                <div class="o_winners_auth_social_sep">
                    <span>ou continuer avec</span>
                </div>
                <button type="button" class="btn o_winners_social_btn" data-provider="google">
                    <i class="fa fa-google" role="presentation"/> Continuer avec Google
                </button>
                <button type="button" class="btn o_winners_social_btn" data-provider="facebook">
                    <i class="fa fa-facebook" role="presentation"/> Continuer avec Facebook
                </button>
                <button type="button" class="btn o_winners_social_btn" data-provider="apple">
                    <i class="fa fa-apple" role="presentation"/> Continuer avec Apple
                </button>
            </div>
        </xpath>
    </template>

</odoo>