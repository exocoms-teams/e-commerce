<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Champs nom + email (template principal du formulaire) -->
    <template id="auth_signup_signup_winners" inherit_id="auth_signup.signup" name="Winners - Formulaire inscription">

        <!-- Ciblage du div conteneur du champ 'Name' via l'input -->
        <xpath expr="//input[@name='name']/parent::div" position="attributes">
            <attribute name="class" add="o_winners_signup_field" separator=" "/>
        </xpath>

        <!-- Ciblage du div conteneur du champ 'Login/Email' via l'input -->
        <xpath expr="//input[@name='login']/parent::div" position="attributes">
            <attribute name="class" add="o_winners_signup_field" separator=" "/>
        </xpath>

    </template>

    <!-- Champs mot de passe (template appelé par le formulaire principal) -->
    <template id="auth_signup_fields_winners" inherit_id="auth_signup.fields" name="Winners - Champs mot de passe">

        <!-- Ciblage du div conteneur du champ 'Password' via l'input -->
        <xpath expr="//input[@name='password']/parent::div" position="attributes">
            <attribute name="class" add="o_winners_signup_field" separator=" "/>
        </xpath>

        <!-- Ciblage du div conteneur du champ 'Confirm Password' via l'input -->
        <xpath expr="//input[@name='confirm_password']/parent::div" position="attributes">
            <attribute name="class" add="o_winners_signup_field" separator=" "/>
        </xpath>

    </template>

</odoo>