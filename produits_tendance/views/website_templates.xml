<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         WIN-45 : Landing Page SaaS - route "/"
         Hérite de la homepage Odoo standard.
    ============================================================ -->
    <template id="homepage" name="Landing Page - Détection Produits Tendance" inherit_id="website.homepage" priority="99">
        <xpath expr="//div[hasclass('oe_structure')]" position="replace">
            <div class="oe_structure" id="oe_structure_produits_tendance_homepage">
                
                <!-- Section Hero (Cover) -->
                <section class="s_cover parallax s_parallax_is_fixed pt96 pb96 o_colored_level" data-scroll-background-ratio="0" data-snippet="s_cover">
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="container">
                        <div class="row s_nb_column_fixed">
                            <div class="col-lg-12 pt16 pb16">
                                <h1 class="text-white">Détectez les produits tendance avant vos concurrents</h1>
                                <p class="lead text-white">
                                    Notre plateforme analyse en continu les signaux e-commerce
                                    (ventes, publicités, réseaux sociaux) pour repérer les
                                    produits gagnants avant tout le monde.
                                </p>
                                <a href="/winners/dashboard" class="btn btn-primary">Découvrir la plateforme</a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- WIN-103 : "Comment ça marche" - 3 étapes juste sous le hero. -->
                <t t-call="produits_tendance.template_how_it_works"/>

            </div>
        </xpath>
    </template>

    <!-- ============================================================
         NOUVEAU HEADER GLOBAL (Design SaaS)
         Surcharge du header natif de Odoo pour imposer la charte
    ============================================================ -->
    <template id="header_winners" inherit_id="website.layout" name="Header Winners">
        <xpath expr="//header" position="replace">
            <!-- sticky-top pour rester visible au scroll, bg-white pour le fond -->
            <header class="o_winners_header sticky-top">
                <nav class="navbar navbar-expand-md">
                    <div class="container-fluid px-md-5">
                        
                        <!-- 1. Logo (Gauche) pointant vers l'accueil -->
                        <a href="/" class="navbar-brand o_winners_header__logo d-flex align-items-center">
                            <img src="/produits_tendance/static/src/img/logo_winners.png" alt="Logo Winners" class="o_winners_header__logo_img me-2"/>
                            <span class="o_winners_header__logo_text">winners</span>
                        </a>

                        <!-- Bouton Hamburger (Responsive Mobile) -->
                        <button class="navbar-toggler o_winners_header__toggler" type="button" data-bs-toggle="collapse" data-bs-target="#winnersMenu" aria-controls="winnersMenu" aria-expanded="false" aria-label="Ouvrir le menu">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <!-- Conteneur Central & Droite -->
                        <div class="collapse navbar-collapse" id="winnersMenu">
                            
                            <!-- 2. Menu Central -->
                            <ul class="navbar-nav mx-auto o_winners_header__nav">
                                <li class="nav-item"><a href="/" class="nav-link o_winners_header__nav_link">Accueil</a></li>
                                <li class="nav-item"><a href="#" class="nav-link o_winners_header__nav_link">Fonctionnalités</a></li>
                                <li class="nav-item"><a href="#" class="nav-link o_winners_header__nav_link">Tarifs</a></li>
                                <li class="nav-item"><a href="/dashboard" class="nav-link o_winners_header__nav_link">Dashboard</a></li>
                                <li class="nav-item"><a href="/submit-trend" class="nav-link o_winners_header__nav_link">Soumettre un produit</a></li>
                            </ul>

                            <!-- 3. CTA (Droite) : Logique de connexion -->
                            <ul class="navbar-nav o_winners_header__auth align-items-center">
                                <t t-if="request.env.user._is_public()">
                                    <!-- Visiteur -->
                                    <li class="nav-item me-3">
                                        <a href="/web/login" class="nav-link o_winners_header__login_text">Se connecter</a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="/web/signup" class="btn o_winners_btn_accent shadow-sm">Essayer gratuitement</a>
                                    </li>
                                </t>
                                <t t-else="">
                                    <!-- Utilisateur connecté -->
                                    <li class="nav-item dropdown">
                                        <a href="#" class="nav-link dropdown-toggle o_winners_header__user d-flex align-items-center" data-bs-toggle="dropdown">
                                            <img t-attf-src="/web/image?model=res.users&amp;field=avatar_128&amp;id=#{request.env.user.id}" 
                                                 class="rounded-circle o_winners_header__avatar me-2" 
                                                 alt="Avatar" style="width:32px; height:32px; object-fit:cover;" />
                                            <span class="o_winners_header__username fw-bold" t-esc="request.env.user.name[:15] + '...' if len(request.env.user.name) &gt; 15 else request.env.user.name"/>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                            <a href="/my/home" class="dropdown-item">Mon compte</a>
                                            <div class="dropdown-divider"></div>
                                            <a href="/web/session/logout?redirect=/" class="dropdown-item text-danger">Se déconnecter</a>
                                        </div>
                                    </li>
                                </t>
                            </ul>

                        </div>
                    </div>
                </nav>
            </header>
        </xpath>
    </template>

    <!-- ============================================================
         NOUVEAU FOOTER GLOBAL (Design SaaS Premium Sombre) - ODOO 19
    ============================================================ -->
    <template id="footer_winners" inherit_id="website.layout" name="Footer Winners">
        <xpath expr="//main" position="after">
            
            <footer class="o_winners_footer">
                <div class="container">
                    
                    <!-- TOP : Newsletter -->
                    <div class="row o_winners_footer__newsletter align-items-center">
                        <div class="col-lg-6 mb-4 mb-lg-0">
                            <h3 class="fw-bold text-white mb-2">Restez à l'affût des tendances</h3>
                            <p class="o_winners_footer__text-muted mb-0">Découvrez nos analyses et de nouveaux produits gagnants, une fois par mois.</p>
                        </div>
                        <div class="col-lg-6">
                            <form action="#" method="post" class="d-flex o_winners_footer__form">
                                <input type="email" class="form-control o_winners_footer__input" placeholder="Votre email" required="required"/>
                                <button type="submit" class="btn o_winners_btn_accent ms-2 px-4 fw-bold">S'abonner</button>
                            </form>
                        </div>
                    </div>

                    <hr class="o_winners_footer__divider"/>

                    <!-- MIDDLE : Liens et informations -->
                    <div class="row o_winners_footer__main">
                        
                        <!-- Colonne 1 : À propos (Logo) -->
                        <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                            <a href="/" class="d-flex align-items-center mb-3 text-decoration-none">
                                <span class="fw-bold text-white h4 mb-0">winners</span>
                            </a>
                            <p class="o_winners_footer__text-muted pe-md-4">
                                La plateforme d'analyse e-commerce pour dénicher les produits gagnants avant la concurrence.
                            </p>
                        </div>

                        <!-- Colonne 2 : Produit -->
                        <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                            <h6 class="o_winners_footer__title">PRODUIT</h6>
                            <ul class="list-unstyled o_winners_footer__list">
                                <li><a href="/dashboard">Dashboard</a></li>
                                <li><a href="/submit-trend">Soumettre un produit</a></li>
                            </ul>
                        </div>

                        <!-- Colonne 3 : Ressources -->
                        <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                            <h6 class="o_winners_footer__title">RESSOURCES</h6>
                            <ul class="list-unstyled o_winners_footer__list">
                                <li><a href="/#comment-ca-marche">Comment ça marche</a></li>
                                <li><a href="/contactus">Contact</a></li>
                                <li><a href="/faq">FAQ</a></li>
                            </ul>
                        </div>

                        <!-- Colonne 4 : Entreprise / Paiement (Inspiré de ton image) -->
                        <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                            <h6 class="o_winners_footer__title">SÉCURITÉ &amp; PAIEMENT</h6>
                            <div class="d-flex gap-2 mt-3 o_winners_footer__badges">
                                <span>VISA</span>
                                <span>MC</span>
                                <span>PAYPAL</span>
                            </div>
                        </div>

                    </div>

                    <hr class="o_winners_footer__divider"/>

                    <!-- BOTTOM : Copyright & Légal (Répartis gauche/droite) -->
                    <div class="row o_winners_footer__bottom align-items-center">
                        <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                            <p class="o_winners_footer__text-muted mb-0">&amp;copy; WinnerByExocom 2026. Tous droits réservés.</p>
                        </div>
                        <div class="col-md-6 text-center text-md-end">
                            <ul class="list-inline o_winners_footer__legal-list mb-0">
                                <li class="list-inline-item"><a href="/mentions-legales">Mentions légales</a></li>
                                <li class="list-inline-item ms-3"><a href="/cgu">CGU</a></li>
                                <li class="list-inline-item ms-3"><a href="/confidentialite">Confidentialité</a></li>
                            </ul>
                        </div>
                    </div>

                </div>
            </footer>

            <!-- Hack CSS pour masquer les footers natifs d'Odoo 19 -->
            <style>
                #bottom, .o_footer { display: none !important; }
            </style>
            
        </xpath>
    </template>
    <!-- ============================================================
         WIN-103 : Sous-template "Comment ça marche" 
    ============================================================ -->
    <template id="template_how_it_works" name="Comment ça marche - 3 étapes">
        <section class="o_winners_how_it_works py-5">
            <div class="container">
                <h2 class="o_winners_how_it_works__title text-center">Comment ça marche</h2>
                <div class="row mt-4">
                    <div class="col-md-4 mb-4">
                        <div class="o_winners_how_it_works__step">
                            <i class="fa fa-search o_winners_how_it_works__icon"/>
                            <h3 class="o_winners_how_it_works__step_title">1. On collecte les données</h3>
                            <p class="o_winners_how_it_works__step_text">
                                Scraping, API officielles et signalements de la communauté, en continu.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="o_winners_how_it_works__step">
                            <i class="fa fa-line-chart o_winners_how_it_works__icon"/>
                            <h3 class="o_winners_how_it_works__step_title">2. On calcule un score de tendance</h3>
                            <p class="o_winners_how_it_works__step_text">
                                Chaque produit est noté selon ses ventes, ses publicités et son engagement social.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="o_winners_how_it_works__step">
                            <i class="fa fa-trophy o_winners_how_it_works__icon"/>
                            <h3 class="o_winners_how_it_works__step_title">3. Vous découvrez les produits gagnants</h3>
                            <p class="o_winners_how_it_works__step_text">
                                Accédez au classement avant que la concurrence ne s'en aperçoive.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <!-- ============================================================
         TICKET 2 : FICHE PRODUIT (ENRICHIE AVEC ONGLETS)
    ============================================================ -->
    <template id="template_product_detail" name="Détail Produit">
        <t t-call="website.layout">
            <div class="container py-5">
                <!-- En-tête du produit -->
                <div class="o_winners_card p-4 mb-4 d-flex align-items-center">
                    <!-- Image et Titre (on suppose que data_product est envoyé par ton API) -->
                    <h1 class="mb-0 text-dark fw-bold" t-esc="product.name if product else 'Nom du produit'"/>
                </div>

                <!-- Navigation interne (Onglets) -->
                <ul class="nav nav-tabs o_winners_tabs mb-4" id="productTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="apercu-tab" data-bs-toggle="tab" data-bs-target="#apercu" type="button" role="tab">Aperçu</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="evolution-tab" data-bs-toggle="tab" data-bs-target="#evolution" type="button" role="tab">Évolution</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="publicites-tab" data-bs-toggle="tab" data-bs-target="#publicites" type="button" role="tab">Publicités</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="plateformes-tab" data-bs-toggle="tab" data-bs-target="#plateformes" type="button" role="tab">Plateformes</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="details-tab" data-bs-toggle="tab" data-bs-target="#details" type="button" role="tab">Données détaillées</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="historique-tab" data-bs-toggle="tab" data-bs-target="#historique" type="button" role="tab">Historique</button>
                    </li>
                </ul>

                <!-- Contenu des onglets -->
                <div class="tab-content" id="productTabsContent">
                    
                    <!-- ONGLET 1 : APERÇU -->
                    <div class="tab-pane fade show active" id="apercu" role="tabpanel">
                        <div class="row">
                            <!-- Bloc Statistiques clés (Textes bruts comme demandé) -->
                            <div class="col-md-6 mb-4">
                                <div class="o_winners_card p-4 h-100">
                                    <h5 class="fw-bold mb-4">Statistiques clés</h5>
                                    <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                                        <span class="text-muted">Mentions</span>
                                        <span class="fw-bold text-muted">Donnée non disponible</span>
                                    </div>
                                    <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                                        <span class="text-muted">Produits vendus</span>
                                        <span class="fw-bold text-muted">Donnée non disponible</span>
                                    </div>
                                    <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                                        <span class="text-muted">Taux de conversion</span>
                                        <span class="fw-bold text-muted">Donnée non disponible</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted">Croissance</span>
                                        <span class="fw-bold text-muted">Donnée non disponible</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Bloc Top Pays (Données réelles) -->
                            <div class="col-md-6 mb-4">
                                <div class="o_winners_card p-4 h-100">
                                    <h5 class="fw-bold mb-4">Top pays</h5>
                                    <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                                        <span class="text-dark" t-esc="product.country if product and product.country else 'Inconnu'"/>
                                        <span class="fw-bold o_winners_text_primary">100%</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Autres onglets vides pour l'instant (à remplir selon l'API) -->
                    <div class="tab-pane fade" id="evolution" role="tabpanel"><div class="o_winners_card p-4">Graphique d'évolution à venir</div></div>
                    <div class="tab-pane fade" id="publicites" role="tabpanel"><div class="o_winners_card p-4">Liste des publicités à venir</div></div>
                    <div class="tab-pane fade" id="plateformes" role="tabpanel"><div class="o_winners_card p-4">Répartition (Donut) à venir</div></div>
                    <div class="tab-pane fade" id="details" role="tabpanel"><div class="o_winners_card p-4">Détails à venir</div></div>
                    <div class="tab-pane fade" id="historique" role="tabpanel"><div class="o_winners_card p-4">Historique à venir</div></div>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================
         TICKET 2 : NOUVELLE PAGE DETAIL PUBLICITE
    ============================================================ -->
    <template id="template_ad_detail" name="Détail Publicité">
        <t t-call="website.layout">
            <div class="container py-5">
                <a t-attf-href="/product/#{product.id}" class="text-muted text-decoration-none mb-3 d-inline-block">
                    &amp;larr; Retour au produit
                </a>
                
                <div class="o_winners_card p-4 mb-4">
                    <h2 class="fw-bold mb-4">Détails de la publicité</h2>
                    
                    <div class="row">
                        <!-- Champs réels -->
                        <div class="col-md-6">
                            <h5 class="fw-bold mb-3 text-primary">Informations réelles</h5>
                            <ul class="list-group list-group-flush mb-4">
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span class="text-muted">Plateforme</span>
                                    <span class="fw-bold" t-esc="ad.social_network"/>
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span class="text-muted">Pays</span>
                                    <span class="fw-bold" t-esc="ad.country"/>
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span class="text-muted">Likes (si rétro-compat.)</span>
                                    <span class="fw-bold" t-esc="ad.likes_count"/>
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span class="text-muted">Référence</span>
                                    <span class="fw-bold text-break" style="max-width: 60%; text-align: right;" t-esc="ad.ad_ref"/>
                                </li>
                            </ul>
                        </div>

                        <!-- Champs non disponibles (Texte Brut) -->
                        <div class="col-md-6">
                            <h5 class="fw-bold mb-3 text-secondary">Performances (Non suivies)</h5>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span class="text-muted">Vues</span>
                                    <span class="fw-bold text-muted">Donnée non disponible</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span class="text-muted">Commentaires</span>
                                    <span class="fw-bold text-muted">Donnée non disponible</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span class="text-muted">Budget estimé</span>
                                    <span class="fw-bold text-muted">Donnée non disponible</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span class="text-muted">Évolution des performances</span>
                                    <span class="fw-bold text-muted">Historique non disponible</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>