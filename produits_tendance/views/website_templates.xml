<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         WIN-45 : Landing Page SaaS - route "/"
         Hérite de la homepage Odoo standard.
    ============================================================ -->
    <template id="homepage" name="Landing Page - Détection Produits Tendance" inherit_id="website.homepage" priority="99">
        <xpath expr="//div[hasclass('oe_structure')]" position="replace">
            <div class="oe_structure" id="oe_structure_produits_tendance_homepage">
                
                <!-- Section Hero (Cover) -->
                <section class="s_cover parallax s_parallax_is_fixed pt96 pb96 o_colored_level" data-scroll-background-ratio="0" data-snippet="s_cover">
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="container">
                        <div class="row s_nb_column_fixed">
                            <div class="col-lg-12 pt16 pb16">
                                <h1 class="text-white">Détectez les produits tendance avant vos concurrents</h1>
                                <p class="lead text-white">
                                    Notre plateforme analyse en continu les signaux e-commerce
                                    (ventes, publicités, réseaux sociaux) pour repérer les
                                    produits gagnants avant tout le monde.
                                </p>
                                <a href="/winners/dashboard" class="btn btn-primary">Découvrir la plateforme</a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- WIN-103 : "Comment ça marche" - 3 étapes juste sous le hero. -->
                <t t-call="produits_tendance.template_how_it_works"/>

            </div>
        </xpath>
    </template>

    <!-- ============================================================
         NOUVEAU HEADER GLOBAL (Design SaaS)
         Surcharge du header natif de Odoo pour imposer la charte
    ============================================================ -->
    <template id="header_winners" inherit_id="website.layout" name="Header Winners">
        <xpath expr="//header" position="replace">
            <!-- sticky-top pour rester visible au scroll, bg-white pour le fond -->
            <header class="o_winners_header sticky-top">
                <nav class="navbar navbar-expand-md">
                    <div class="container-fluid px-md-5">
                        
                        <!-- 1. Logo (Gauche) pointant vers l'accueil -->
                        <a href="/" class="navbar-brand o_winners_header__logo d-flex align-items-center">
                            <img src="/produits_tendance/static/src/img/logo_winners.png" alt="Logo Winners" class="o_winners_header__logo_img me-2"/>
                            <span class="o_winners_header__logo_text">winners</span>
                        </a>

                        <!-- Bouton Hamburger (Responsive Mobile) -->
                        <button class="navbar-toggler o_winners_header__toggler" type="button" data-bs-toggle="collapse" data-bs-target="#winnersMenu" aria-controls="winnersMenu" aria-expanded="false" aria-label="Ouvrir le menu">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <!-- Conteneur Central & Droite -->
                        <div class="collapse navbar-collapse" id="winnersMenu">
                            
                            <!-- 2. Menu Central -->
                            <ul class="navbar-nav mx-auto o_winners_header__nav">
                                <li class="nav-item"><a href="/" class="nav-link o_winners_header__nav_link">Accueil</a></li>
                                <li class="nav-item"><a href="#" class="nav-link o_winners_header__nav_link">Fonctionnalités</a></li>
                                <li class="nav-item"><a href="#" class="nav-link o_winners_header__nav_link">Tarifs</a></li>
                                <li class="nav-item"><a href="/dashboard" class="nav-link o_winners_header__nav_link">Dashboard</a></li>
                                <li class="nav-item"><a href="/submit-trend" class="nav-link o_winners_header__nav_link">Soumettre un produit</a></li>
                            </ul>

                            <!-- 3. CTA (Droite) : Logique de connexion -->
                            <ul class="navbar-nav o_winners_header__auth align-items-center">
                                <t t-if="request.env.user._is_public()">
                                    <!-- Visiteur -->
                                    <li class="nav-item me-3">
                                        <a href="/web/login" class="nav-link o_winners_header__login_text">Se connecter</a>
                                    </li>
                                    <li class="nav-item">
                                        <a href="/web/signup" class="btn o_winners_btn_accent shadow-sm">Essayer gratuitement</a>
                                    </li>
                                </t>
                                <t t-else="">
                                    <!-- Utilisateur connecté -->
                                    <li class="nav-item dropdown">
                                        <a href="#" class="nav-link dropdown-toggle o_winners_header__user d-flex align-items-center" data-bs-toggle="dropdown">
                                            <img t-attf-src="/web/image?model=res.users&amp;field=avatar_128&amp;id=#{request.env.user.id}" 
                                                 class="rounded-circle o_winners_header__avatar me-2" 
                                                 alt="Avatar" style="width:32px; height:32px; object-fit:cover;" />
                                            <span class="o_winners_header__username fw-bold" t-esc="request.env.user.name[:15] + '...' if len(request.env.user.name) &gt; 15 else request.env.user.name"/>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                            <a href="/my/home" class="dropdown-item">Mon compte</a>
                                            <div class="dropdown-divider"></div>
                                            <a href="/web/session/logout?redirect=/" class="dropdown-item text-danger">Se déconnecter</a>
                                        </div>
                                    </li>
                                </t>
                            </ul>

                        </div>
                    </div>
                </nav>
            </header>
        </xpath>
    </template>

    <!-- ============================================================
         NOUVEAU FOOTER GLOBAL (Design SaaS) - FIX ODOO 19
    ============================================================ -->
    <template id="footer_winners" inherit_id="website.layout" name="Footer Winners">
        <!-- On cible la balise <main> qui existe toujours, et on se place juste après -->
        <xpath expr="//main" position="after">
            
            <footer class="o_winners_footer py-5 mt-auto">
                <div class="container">
                    <div class="row o_winners_footer__top mb-4">
                        
                        <!-- Colonne 1 : À propos -->
                        <div class="col-lg-4 col-md-6 mb-4 o_winners_footer__about">
                            <a href="/" class="o_winners_footer__logo d-flex align-items-center mb-3 text-decoration-none">
                                <img src="/produits_tendance/static/src/img/logo_winners.png" alt="Winners Logo" style="height: 32px;" class="me-2"/>
                                <span class="o_winners_footer__logo_text fw-bold">winners</span>
                            </a>
                            <p class="o_winners_footer__desc text-muted">
                                Détectez les produits tendance avant vos concurrents. Winners analyse en continu les signaux e-commerce pour vous donner une longueur d'avance.
                            </p>
                        </div>

                        <!-- Colonne 2 : Produit -->
                        <div class="col-lg-2 col-md-6 mb-4 o_winners_footer__links">
                            <h5 class="fw-bold mb-3">Produit</h5>
                            <ul class="list-unstyled">
                                <li class="mb-2"><a href="/dashboard" class="text-decoration-none text-muted">Dashboard</a></li>
                                <li class="mb-2"><a href="/submit-trend" class="text-decoration-none text-muted">Soumettre un produit</a></li>
                            </ul>
                        </div>

                        <!-- Colonne 3 : Ressources -->
                        <div class="col-lg-3 col-md-6 mb-4 o_winners_footer__links">
                            <h5 class="fw-bold mb-3">Ressources</h5>
                            <ul class="list-unstyled">
                                <li class="mb-2"><a href="/#comment-ca-marche" class="text-decoration-none text-muted">Comment ça marche</a></li>
                                <li class="mb-2"><a href="/contactus" class="text-decoration-none text-muted">Contact</a></li>
                            </ul>
                        </div>

                        <!-- Colonne 4 : Légal -->
                        <div class="col-lg-3 col-md-6 mb-4 o_winners_footer__links">
                            <h5 class="fw-bold mb-3">Légal</h5>
                            <ul class="list-unstyled">
                                <li class="mb-2"><a href="/mentions-legales" class="text-decoration-none text-muted">Mentions légales</a></li>
                                <li class="mb-2"><a href="/confidentialite" class="text-decoration-none text-muted">Confidentialité</a></li>
                                <li class="mb-2"><a href="/cgu" class="text-decoration-none text-muted">CGU</a></li>
                            </ul>
                        </div>

                    </div>
                </div>
                
                <!-- Ligne de Copyright -->
                <div class="o_winners_footer__bottom pt-4 border-top">
                    <div class="container text-center">
                        <p class="text-muted mb-0"><small>&amp;copy; <span t-esc="res_company.name"/> 2026. Tous droits réservés.</small></p>
                    </div>
                </div>
            </footer>

            <!-- Hack CSS pour masquer les footers natifs d'Odoo 19 -->
            <style>
                #bottom, .o_footer { display: none !important; }
            </style>
            
        </xpath>
    </template>
    <!-- ============================================================
         WIN-103 : Sous-template "Comment ça marche" 
    ============================================================ -->
    <template id="template_how_it_works" name="Comment ça marche - 3 étapes">
        <section class="o_winners_how_it_works py-5">
            <div class="container">
                <h2 class="o_winners_how_it_works__title text-center">Comment ça marche</h2>
                <div class="row mt-4">
                    <div class="col-md-4 mb-4">
                        <div class="o_winners_how_it_works__step">
                            <i class="fa fa-search o_winners_how_it_works__icon"/>
                            <h3 class="o_winners_how_it_works__step_title">1. On collecte les données</h3>
                            <p class="o_winners_how_it_works__step_text">
                                Scraping, API officielles et signalements de la communauté, en continu.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="o_winners_how_it_works__step">
                            <i class="fa fa-line-chart o_winners_how_it_works__icon"/>
                            <h3 class="o_winners_how_it_works__step_title">2. On calcule un score de tendance</h3>
                            <p class="o_winners_how_it_works__step_text">
                                Chaque produit est noté selon ses ventes, ses publicités et son engagement social.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="o_winners_how_it_works__step">
                            <i class="fa fa-trophy o_winners_how_it_works__icon"/>
                            <h3 class="o_winners_how_it_works__step_title">3. Vous découvrez les produits gagnants</h3>
                            <p class="o_winners_how_it_works__step_text">
                                Accédez au classement avant que la concurrence ne s'en aperçoive.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>