<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         WIN-45 : Landing Page SaaS - route "/"
         Hérite de la homepage Odoo standard.
    ============================================================ -->

    <template id="winners_homepage" name="Landing Page - Détection Produits Tendance"
              inherit_id="website.homepage" priority="99">

        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty" data-name="Homepage">

                <section class="s_cover parallax s_parallax_is_fixed pt96 pb96 o_colored_level"
                         data-scroll-background-ratio="0" data-snippet="s_cover">
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="container">
                        <div class="row s_nb_column_fixed">
                            <div class="col-lg-12 pt16 pb16">
                                <h1 class="text-white">
                                    Détectez les produits tendance avant vos concurrents
                                </h1>
                                <p class="lead text-white">
                                    Notre plateforme analyse en continu les signaux e-commerce
                                    (ventes, publicités, réseaux sociaux) pour repérer les
                                    produits gagnants avant tout le monde.
                                </p>
                                <a href="/shop" class="btn btn-primary">Découvrir la plateforme</a>
                            </div>
                        </div>
                    </div>
                </section>

                <t t-call="produits_tendance.template_how_it_works"/>

            </div>
        </xpath>

    </template>

    <template id="template_how_it_works" name="Comment ça marche - 3 étapes">
        <section class="o_winners_how_it_works py-5">
            <div class="container">
                <h2 class="o_winners_how_it_works__title text-center">Comment ça marche</h2>
                <div class="row mt-4">
                    <div class="col-md-4 mb-4">
                        <div class="o_winners_how_it_works__step">
                            <i class="fa fa-search o_winners_how_it_works__icon"/>
                            <h3 class="o_winners_how_it_works__step_title">1. On collecte les données</h3>
                            <p class="o_winners_how_it_works__step_text">
                                Scraping, API officielles et signalements de la communauté, en continu.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="o_winners_how_it_works__step">
                            <i class="fa fa-line-chart o_winners_how_it_works__icon"/>
                            <h3 class="o_winners_how_it_works__step_title">2. On calcule un score de tendance</h3>
                            <p class="o_winners_how_it_works__step_text">
                                Chaque produit est noté selon ses ventes, ses publicités et son engagement social.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="o_winners_how_it_works__step">
                            <i class="fa fa-trophy o_winners_how_it_works__icon"/>
                            <h3 class="o_winners_how_it_works__step_title">3. Vous découvrez les produits gagnants</h3>
                            <p class="o_winners_how_it_works__step_text">
                                Accédez au classement avant que la concurrence ne s'en aperçoive.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Footer Winners -->
    <template id="winners_widgets_footer" name="Winners Footer" inherit_id="website.layout" priority="99">
        <!-- Target <main> which is guaranteed to exist in website.layout -->
        <xpath expr="//main" position="after">
            <footer id="bottom" data-anchor="true" class="o_winners_footer" t-if="not no_footer">
                <div class="o_winners_footer_container">
                    <div class="o_winners_footer_row">
                        <!-- À propos -->
                        <div class="o_winners_footer_col o_winners_footer_about">
                            <span class="o_winners_footer_logo">Winners</span>
                            <p class="o_winners_footer_description">Winners vous aide à détecter les produits tendance avant vos concurrents grâce à l'analyse en temps réel des signaux e-commerce.</p>
                        </div>
                        <!-- Produit -->
                        <div class="o_winners_footer_col o_winners_footer_product">
                            <h4 class="o_winners_footer_title">Produit</h4>
                            <ul class="o_winners_footer_list">
                                <li><a href="/dashboard" class="o_winners_footer_link">Dashboard</a></li>
                                <li><a href="/submit-trend" class="o_winners_footer_link">Soumettre un produit</a></li>
                            </ul>
                        </div>
                        <!-- Ressources -->
                        <div class="o_winners_footer_col o_winners_footer_resources">
                            <h4 class="o_winners_footer_title">Ressources</h4>
                            <ul class="o_winners_footer_list">
                                <li><a href="/page/comment-ca-marche" class="o_winners_footer_link">Comment ça marche</a></li>
                                <li><a href="/contact" class="o_winners_footer_link">Contact</a></li>
                            </ul>
                        </div>
                        <!-- Légal -->
                        <div class="o_winners_footer_col o_winners_footer_legal">
                            <h4 class="o_winners_footer_title">Légal</h4>
                            <ul class="o_winners_footer_list">
                                <li><a href="/page/mentions-legales" class="o_winners_footer_link">Mentions légales</a></li>
                                <li><a href="/page/confidentialite" class="o_winners_footer_link">Confidentialité</a></li>
                                <li><a href="/page/cgv" class="o_winners_footer_link">CGU</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="o_winners_footer_bottom">
                        <p class="o_winners_footer_copyright">© <t t-out="time.strftime('%Y')"/> Winners. Tous droits réservés.</p>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>

</odoo>produits_tendance/views/website_templates.xml