<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         WIN-45 : Landing Page SaaS - route "/" (Autonome)
    ============================================================ -->
    <template id="winners_home_page" name="Winners Landing Page">
        <t t-call="website.layout">
            <div id="wrap" class="winners-site-wrapper winners-home-wrapper bg-dark">
                
                <!-- SECTION HERO (Design SaaS Bleu Nuit) -->
                <section class="winners-hero text-center text-white py-5 bg-dark">
                    <div class="container-fluid mt-5 px-md-5" style="max-width: 1400px;">
                        <h1 class="display-3 fw-bold mb-4">
                            Découvrez les produits<br/>qui vont <span class="text-orange">exploser ↗</span>
                        </h1>
                        <p class="lead mb-5 mx-auto text-light" style="max-width: 600px; opacity: 0.85;">
                            Accédez à vos données, suivez les tendances en temps réel et prenez des décisions gagnantes avant vos concurrents.
                        </p>
                        
                        <!-- Boutons d'action conditionnels -->
                        <div class="d-flex justify-content-center gap-3 mb-5">
                            <t t-if="request.env.user._is_public()">
                                <a href="/web/signup" class="btn btn-orange btn-lg fw-bold px-4 rounded-pill shadow">Créer un compte</a>
                                <a href="/web/login" class="btn btn-outline-light btn-lg fw-bold px-4 rounded-pill">Se connecter</a>
                            </t>
                            <t t-else="">
                                <a href="/dashboard" class="btn btn-orange btn-lg fw-bold px-4 rounded-pill shadow">Accéder au Dashboard ↗</a>
                            </t>
                        </div>

                        <!-- Vidéo de démonstration du Dashboard -->
                        <div class="hero-mockup mx-auto position-relative">
                            <video autoplay="autoplay" muted="muted" loop="loop" playsinline="playsinline" class="img-fluid rounded-4 shadow-lg w-100">
                                <source src="/produits_tendance/static/src/img/dashboard_demo.mp4" type="video/mp4"/>
                                Votre navigateur ne supporte pas la lecture de vidéos.
                            </video>
                        </div>
                    </div>
                </section>

                <!-- SECTION INTÉGRATIONS (Logos) -->
                <section class="winners-integrations py-5 bg-white text-center">
                    <div class="container pt-4">
                        <p class="text-muted fw-bold mb-4 text-uppercase small" style="letter-spacing: 1px;">Connecté à vos plateformes préférées</p>
                        <div class="d-flex flex-wrap justify-content-center align-items-center gap-4 gap-md-5 opacity-75">
                            <img src="/produits_tendance/static/src/img/shopify.png" height="30" alt="Shopify"/>
                            <img src="/produits_tendance/static/src/img/woo.png" height="30" alt="WooCommerce"/>
                            <img src="/produits_tendance/static/src/img/amazon.png" height="30" alt="Amazon"/>
                            <img src="/produits_tendance/static/src/img/tiktok.png" height="30" alt="TikTok"/>
                            <img src="/produits_tendance/static/src/img/meta.png" height="30" alt="Facebook"/>
                            <img src="/produits_tendance/static/src/img/ebay.png" height="30" alt="eBay"/>
                        </div>
                    </div>
                </section>

                <!-- WIN-103 : "Comment ça marche" - 3 étapes -->
                <div class="bg-light">
                    <t t-call="produits_tendance.template_how_it_works"/>
                </div>

            </div>
        </t>
    </template>

    <!-- ============================================================
         NOUVEAU HEADER GLOBAL (Design SaaS) - Protégé Multi-site
    ============================================================ -->
    <template id="header_winners" inherit_id="website.layout" name="Header Winners">
        <xpath expr="//header" position="replace">
            <!-- Sécurité Multi-site : s'affiche uniquement sur votre site Winners (Adaptez l'ID si besoin, ex: ID 1) -->
            <t t-if="website and website.name == 'Winners'">
                <header class="o_winners_header sticky-top">
                    <div class="winners-site-wrapper w-100">
                        <nav class="navbar navbar-expand-md">
                            <div class="container-fluid px-md-5">
                                
                                <!-- 1. Logo (Gauche) -->
                                <a href="/" class="navbar-brand o_winners_header__logo d-flex align-items-center">
                                    <img src="/produits_tendance/static/src/img/logo_winners.png" alt="Logo Winners" class="o_winners_header__logo_img me-2" style="height: 40px;"/>
                                    <span class="o_winners_header__logo_text">winners</span>
                                </a>

                                <!-- Bouton Hamburger -->
                                <button class="navbar-toggler o_winners_header__toggler" type="button" data-bs-toggle="collapse" data-bs-target="#winnersMenu" aria-controls="winnersMenu" aria-expanded="false" aria-label="Ouvrir le menu">
                                    <span class="navbar-toggler-icon"></span>
                                </button>

                                <!-- Conteneur Central & Droite -->
                                <div class="collapse navbar-collapse" id="winnersMenu">
                                    
                                    <!-- 2. Menu Central -->
                                    <ul class="navbar-nav mx-auto o_winners_header__nav">
                                        <li class="nav-item"><a href="/" class="nav-link o_winners_header__nav_link">Accueil</a></li>
                                        <li class="nav-item"><a href="#" class="nav-link o_winners_header__nav_link">Fonctionnalités</a></li>
                                        <li class="nav-item"><a href="#" class="nav-link o_winners_header__nav_link">Tarifs</a></li>
                                        <li class="nav-item"><a href="/dashboard" class="nav-link o_winners_header__nav_link">Dashboard</a></li>
                                        <li class="nav-item"><a href="/submit-trend" class="nav-link o_winners_header__nav_link">Soumettre un produit</a></li>
                                    </ul>

                                    <!-- 3. CTA (Droite) -->
                                    <ul class="navbar-nav o_winners_header__auth align-items-center">
                                        <t t-if="request.env.user._is_public()">
                                            <li class="nav-item me-3">
                                                <a href="/web/login" class="nav-link o_winners_header__login_text">Se connecter</a>
                                            </li>
                                            <li class="nav-item">
                                                <a href="/web/signup" class="btn o_winners_btn_accent shadow-sm">Essayer gratuitement</a>
                                            </li>
                                        </t>
                                        <t t-else="">
                                            <li class="nav-item dropdown">
                                                <a href="#" class="nav-link dropdown-toggle o_winners_header__user d-flex align-items-center" data-bs-toggle="dropdown">
                                                    <img t-attf-src="/web/image?model=res.users&amp;field=avatar_128&amp;id=#{request.env.user.id}" 
                                                         class="rounded-circle o_winners_header__avatar me-2" 
                                                         alt="Avatar" style="width:32px; height:32px; object-fit:cover;" />
                                                    <span class="o_winners_header__username fw-bold" t-esc="request.env.user.name[:15] + '...' if len(request.env.user.name) &gt; 15 else request.env.user.name"/>
                                                </a>
                                                <div class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                                    <t t-if="request.env.user.has_group('base.group_user')">
                                                        <a href="/web" class="dropdown-item fw-bold text-primary">⚙️ Backend Odoo</a>
                                                        <div class="dropdown-divider"></div>
                                                    </t>
                                                    <a href="/my/home" class="dropdown-item">Mon compte</a>
                                                    <div class="dropdown-divider"></div>
                                                    <a href="/web/session/logout?redirect=/" class="dropdown-item text-danger">Se déconnecter</a>
                                                </div>
                                            </li>
                                        </t>
                                    </ul>

                                </div>
                            </div>
                        </nav>
                    </div>
                </header>
            </t>
        </xpath>
    </template>

    <!-- ============================================================
         NOUVEAU FOOTER GLOBAL - Protégé Multi-site
    ============================================================ -->
    <template id="footer_winners" inherit_id="website.layout" name="Footer Winners">
        <xpath expr="//main" position="after">
            <t t-if="website and website.name == 'Winners'">
                <footer class="o_winners_footer winners-site-wrapper">
                    <div class="container">
                        
                        <!-- TOP : Newsletter -->
                        <div class="row o_winners_footer__newsletter align-items-center">
                            <div class="col-lg-6 mb-4 mb-lg-0">
                                <h3 class="fw-bold text-white mb-2">Restez à l'affût des tendances</h3>
                                <p class="o_winners_footer__text-muted mb-0">Découvrez nos analyses et de nouveaux produits gagnants, une fois par mois.</p>
                            </div>
                            <div class="col-lg-6">
                                <form action="#" method="post" class="d-flex o_winners_footer__form">
                                    <input type="email" class="form-control o_winners_footer__input" placeholder="Votre email" required="required"/>
                                    <button type="submit" class="btn o_winners_btn_accent ms-2 px-4 fw-bold">S'abonner</button>
                                </form>
                            </div>
                        </div>

                        <hr class="o_winners_footer__divider"/>

                        <!-- MIDDLE : Liens et informations -->
                        <div class="row o_winners_footer__main">
                            <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                                <a href="/" class="d-flex align-items-center mb-3 text-decoration-none">
                                    <span class="fw-bold text-white h4 mb-0">winners</span>
                                </a>
                                <p class="o_winners_footer__text-muted pe-md-4">
                                    La plateforme d'analyse e-commerce pour dénicher les produits gagnants avant la concurrence.
                                </p>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                                <h6 class="o_winners_footer__title">PRODUIT</h6>
                                <ul class="list-unstyled o_winners_footer__list">
                                    <li><a href="/dashboard">Dashboard</a></li>
                                    <li><a href="/submit-trend">Soumettre un produit</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                                <h6 class="o_winners_footer__title">RESSOURCES</h6>
                                <ul class="list-unstyled o_winners_footer__list">
                                    <li><a href="/#comment-ca-marche">Comment ça marche</a></li>
                                    <li><a href="/contactus">Contact</a></li>
                                    <li><a href="/faq">FAQ</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                                <h6 class="o_winners_footer__title">SÉCURITÉ &amp; PAIEMENT</h6>
                                <div class="d-flex gap-2 mt-3 o_winners_footer__badges">
                                    <span>VISA</span>
                                    <span>MC</span>
                                    <span>PAYPAL</span>
                                </div>
                            </div>
                        </div>

                        <hr class="o_winners_footer__divider"/>

                        <!-- BOTTOM -->
                        <div class="row o_winners_footer__bottom align-items-center">
                            <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                                <p class="o_winners_footer__text-muted mb-0">&amp;copy; WinnerByExocom 2026. Tous droits réservés.</p>
                            </div>
                            <div class="col-md-6 text-center text-md-end">
                                <ul class="list-inline o_winners_footer__legal-list mb-0">
                                    <li class="list-inline-item"><a href="/mentions-legales">Mentions légales</a></li>
                                    <li class="list-inline-item ms-3"><a href="/cgu">CGU</a></li>
                                    <li class="list-inline-item ms-3"><a href="/confidentialite">Confidentialité</a></li>
                                </ul>
                            </div>
                        </div>

                    </div>
                </footer>
            </t>
            
            <!-- Masquer le footer natif d'Odoo uniquement sur le site Winners -->
            <style>
                body:has(.winners-site-wrapper) #bottom, 
                body:has(.winners-site-wrapper) .o_footer { display: none !important; }
            </style>
        </xpath>
    </template>

    <!-- ============================================================
         WIN-103 : Sous-template "Comment ça marche" 
    ============================================================ -->
    <template id="template_how_it_works" name="Comment ça marche - 3 étapes">
        <section class="o_winners_how_it_works py-5">
            <div class="container">
                <h2 class="o_winners_how_it_works__title text-center">Comment ça marche</h2>
                <div class="row mt-4">
                    <div class="col-md-4 mb-4">
                        <div class="o_winners_how_it_works__step">
                            <i class="fa fa-search o_winners_how_it_works__icon"/>
                            <h3 class="o_winners_how_it_works__step_title">1. On collecte les données</h3>
                            <p class="o_winners_how_it_works__step_text">
                                Scraping, API officielles et signalements de la communauté, en continu.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="o_winners_how_it_works__step">
                            <i class="fa fa-line-chart o_winners_how_it_works__icon"/>
                            <h3 class="o_winners_how_it_works__step_title">2. On calcule un score de tendance</h3>
                            <p class="o_winners_how_it_works__step_text">
                                Chaque produit est noté selon ses ventes, ses publicités et son engagement social.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="o_winners_how_it_works__step">
                            <i class="fa fa-trophy o_winners_how_it_works__icon"/>
                            <h3 class="o_winners_how_it_works__step_title">3. Vous découvrez les produits gagnants</h3>
                            <p class="o_winners_how_it_works__step_text">
                                Accédez au classement avant que la concurrence ne s'en aperçoive.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>