<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         WIN-45 : Landing Page SaaS - route "/"
         Hérite de la homepage Odoo standard.
         Structure "oe_structure" éditable via le constructeur de
         site natif (blocs Bootstrap 5) : aucun CSS custom ici.
    ============================================================ -->

    <template id="homepage" name="Landing Page - Détection Produits Tendance"
          inherit_id="website.homepage" priority="99">

        <xpath expr="//div[hasclass('oe_structure')]" position="replace">
            <div class="oe_structure" id="oe_structure_produits_tendance_homepage">

                <!-- Section de départ : bloc "Cover" natif Odoo.
                     Editable/remplaçable ensuite depuis le constructeur
                     de site (drag & drop d'autres blocs). -->
                <section class="s_cover parallax s_parallax_is_fixed pt96 pb96 o_colored_level"
                         data-scroll-background-ratio="0" data-snippet="s_cover">
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="container">
                        <div class="row s_nb_column_fixed">
                            <div class="col-lg-12 pt16 pb16">
                                <h1 class="text-white">
                                    Détectez les produits tendance avant vos concurrents
                                </h1>
                                <p class="lead text-white">
                                    Notre plateforme analyse en continu les signaux e-commerce
                                    (ventes, publicités, réseaux sociaux) pour repérer les
                                    produits gagnants avant tout le monde.
                                </p>
                                <a href="/shop" class="btn btn-primary">Découvrir la plateforme</a>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </xpath>

    </template>

</odoo>