<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         WIN-45 / WIN-50 : Dashboard - Classement produits + filtres
         dynamiques (catégorie, pays)

         Respecte la charte graphique Winners :
         - uniquement les variables SCSS de _winners_variables.scss
         - toute classe custom préfixée par o_winners_
         - composants réutilisés : .o_winners_product_card et
           .o_winners_score_badge (déjà définis pour la fiche produit),
           .o_winners_filter_panel (déjà référencé dans la charte, section 5)

         Le rendu initial (sans filtre) est fait côté serveur (QWeb).
         Au changement d'un select du panneau de filtres, le JS
         (dashboard_filters.js) appelle /api/dashboard/filter en AJAX et
         reconstruit uniquement #o_winners_product_grid, sans recharger
         la page.
    ============================================================ -->

    <template id="template_dashboard" name="Dashboard - Classement produits tendance">
        <t t-call="website.layout">
            <div id="wrap" class="o_winners_dashboard">
                <div class="container mt-5 mb-5">

                    <div class="o_winners_dashboard_header mb-4">
                        <h1>Classement des produits tendance</h1>
                        <p class="o_winners_dashboard_header__subtitle">
                            Triés par score de tendance décroissant. Affinez la liste avec les filtres ci-dessous.
                        </p>
                    </div>

                    <!-- Panneau de filtres : catégorie + pays -->
                    <div class="o_winners_filter_panel mb-4" id="o_winners_filter_panel">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-5">
                                <label for="o_winners_filter_category" class="form-label">Catégorie</label>
                                <select id="o_winners_filter_category" class="form-select o_winners_filter_panel__select" name="category_id">
                                    <option value="">Toutes les catégories</option>
                                    <t t-foreach="categories" t-as="cat">
                                        <option t-att-value="cat['id']"><t t-esc="cat['name']"/></option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label for="o_winners_filter_country" class="form-label">Pays</label>
                                <select id="o_winners_filter_country" class="form-select o_winners_filter_panel__select" name="country">
                                    <option value="">Tous les pays</option>
                                    <t t-foreach="countries" t-as="c">
                                        <option t-att-value="c"><t t-esc="c"/></option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="button" id="o_winners_filter_reset" class="btn btn-link o_winners_filter_panel__reset">
                                    Réinitialiser
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Grille de cartes produit : reconstruite en AJAX au changement de filtre -->
                    <div id="o_winners_product_grid" class="row o_winners_product_grid">
                        <t t-call="produits_tendance.template_product_cards">
                            <t t-set="products" t-value="products"/>
                        </t>
                    </div>

                </div>
            </div>
        </t>
    </template>

    <!-- Sous-template réutilisé pour le rendu initial (QWeb) ET comme
         référence de structure pour le rendu JS côté client (voir
         dashboard_filters.js, qui reproduit ce même balisage). -->
    <template id="template_product_cards" name="Grille de cartes produit">
        <t t-if="not products">
            <div class="col-12 o_winners_product_grid__empty">
                Aucun produit ne correspond à ces filtres.
            </div>
        </t>
        <t t-foreach="products" t-as="p">
            <div class="col-md-4 col-sm-6 mb-4">
                <a t-attf-href="/product/#{p['id']}" class="o_winners_product_card">
                    <div class="o_winners_product_card__category" t-if="p['category']">
                        <t t-esc="p['category']"/>
                    </div>
                    <div class="o_winners_product_card__name"><t t-esc="p['name']"/></div>
                    <div class="o_winners_product_card__meta" t-if="p['country']">
                        <t t-esc="p['country']"/>
                    </div>
                    <div class="o_winners_score_badge o_winners_product_card__score">
                        <div class="o_winners_score_badge__label">Score</div>
                        <div class="o_winners_score_badge__value"><t t-esc="'%.1f' % p['score']"/></div>
                    </div>
                </a>
            </div>
        </t>
    </template>
</odoo>