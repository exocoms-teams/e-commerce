<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WIN-66 : plans de facturation récurrente (mensuel/annuel), communs
         aux deux tiers payants (Standard, Pro). -->
    <record id="subscription_plan_monthly" model="sale.subscription.plan">
        <field name="name">Mensuel</field>
        <field name="billing_period_value">1</field>
        <field name="billing_period_unit">month</field>
    </record>

    <record id="subscription_plan_yearly" model="sale.subscription.plan">
        <field name="name">Annuel</field>
        <field name="billing_period_value">1</field>
        <field name="billing_period_unit">year</field>
    </record>
</odoo>
