<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_rejeter_mandat_form" model="ir.ui.view">
        <field name="name">wizard.rejeter.mandat.form</field>
        <field name="model">wizard.rejeter.mandat</field>
        <field name="arch" type="xml">
            <form string="Rejeter le mandat">
                <group>
                    <field name="mandat_id" readonly="1"/>
                    <field name="motif_rejet" required="1" placeholder="Saisissez le motif de rejet détaillé..."/>
                </group>
                <footer>
                    <button name="action_confirmer_rejet" string="Confirmer le rejet"
                            type="object" class="btn-danger"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
