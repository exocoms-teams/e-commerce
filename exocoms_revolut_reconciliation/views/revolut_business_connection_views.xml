<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="revolut_business_connection_view_list" model="ir.ui.view">
        <field name="name">revolut.business.connection.list</field>
        <field name="model">revolut.business.connection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="is_live"/>
                <field name="journal_count"/>
                <field name="refresh_token_expiry"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="revolut_business_connection_view_form" model="ir.ui.view">
        <field name="name">revolut.business.connection.form</field>
        <field name="model">revolut.business.connection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object"
                            string="Tester la connexion" class="btn-primary"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_journals" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <field name="journal_count" widget="statinfo" string="Journaux"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivée" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Revolut Business"/></h1>
                    </div>
                    <group>
                        <group string="Paramètres">
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_live"/>
                        </group>
                        <group string="Jetons">
                            <field name="refresh_token_expiry"/>
                            <field name="access_token_expiry"/>
                        </group>
                    </group>
                    <group string="Certificat API" groups="base.group_system">
                        <field name="client_id"/>
                        <field name="redirect_uri"
                               placeholder="https://exemple.fr/revolut/business/callback"/>
                        <field name="private_key" widget="text"
                               placeholder="-----BEGIN PRIVATE KEY-----&#10;...&#10;-----END PRIVATE KEY-----"/>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                        <p class="mb-1"><strong>Pour autoriser cette connexion :</strong></p>
                        <ol class="mb-0">
                            <li>Déposez la clé publique du certificat dans Revolut Business
                                (<em>Paramètres → APIs → Business API</em>) et recopiez ici le
                                client ID, la clé privée et l'URI de redirection déclarée.</li>
                            <li>Enregistrez cette fiche, puis cliquez sur
                                <em>Enable API access</em> dans Revolut Business.</li>
                            <li>Revolut redirige vers l'URI déclarée avec un code d'autorisation ;
                                Odoo l'échange automatiquement contre un jeton de
                                rafraîchissement.</li>
                        </ol>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'expired'">
                        Le jeton de rafraîchissement a expiré (durée de vie : 90 jours).
                        Relancez <em>Enable API access</em> dans Revolut Business.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_revolut_business_connection" model="ir.actions.act_window">
        <field name="name">Connexions Revolut Business</field>
        <field name="res_model">revolut.business.connection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez une connexion Revolut Business</p>
            <p>Reliez un compte Revolut Business à un journal de banque pour importer
               automatiquement ses transactions.</p>
        </field>
    </record>

    <menuitem id="menu_revolut_business_connection"
              name="Revolut Business"
              parent="account.menu_finance_configuration"
              action="action_revolut_business_connection"
              sequence="90"/>

</odoo>
