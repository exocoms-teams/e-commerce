<odoo>
    <record id="product_template_tire_form" model="ir.ui.view">
        <field name="name">product.template.tire.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook" position="inside">

                <page string="Pneus" invisible="not is_tire">
                    <group>
                        <separator string="Modèle" />
                        <field name="tire_brand" required="tire_field_applicability_map.tire_brand" />
                        <field name="tire_model" required="tire_field_applicability_map.tire_model" />
                        <field name="tire_usage_id"
                            required="tire_field_applicability_map.tire_usage_id" />
                        <separator string="Dimensions" />
                        <field name="tire_width" required="tire_field_applicability_map.tire_width" />
                        <field name="tire_height"
                            required="tire_field_applicability_map.tire_height" />
                        <field name="tire_construction"
                            required="tire_field_applicability_map.tire_construction" />
                        <field name="tire_rim" required="tire_field_applicability_map.tire_rim" />
                        <field name="tire_tread_pattern_id"
                            domain="[('pattern_category', '=', tire_family)]"
                            required="tire_field_applicability_map.tire_tread_pattern_id" />
                        <field name="tire_load_index"
                            invisible="not tire_field_applicability_map.tire_load_index"
                            required="tire_field_applicability_map.tire_load_index" />
                        <field name="tire_speed_index"
                            invisible="not tire_field_applicability_map.tire_speed_index"
                            required="tire_field_applicability_map.tire_speed_index" />
                        <separator string="Spécificités" />
                        <field name="tire_specific_approval"
                            invisible="not tire_field_applicability_map.tire_specific_approval" />
                        <field name="tire_extra_load"
                            invisible="not tire_field_applicability_map.tire_extra_load"
                            required="tire_field_applicability_map.tire_extra_load" />
                        <field name="tire_runflat"
                            invisible="not tire_field_applicability_map.tire_runflat"
                            required="tire_field_applicability_map.tire_runflat" />
                        <field name="tire_seal"
                            invisible="not tire_field_applicability_map.tire_seal"
                            required="tire_field_applicability_map.tire_seal" />
                        <field name="tire_season"
                            invisible="not tire_field_applicability_map.tire_season"
                            required="tire_field_applicability_map.tire_season" />
                        <field name="tire_snow_homologation"
                            invisible="not tire_field_applicability_map.tire_snow_homologation"
                            required="tire_field_applicability_map.tire_snow_homologation" />
                        <field name="tire_new_or_retreaded"
                            invisible="not tire_field_applicability_map.tire_new_or_retreaded"
                            required="tire_field_applicability_map.tire_new_or_retreaded" />
                        <field name="tire_sidewall_lettering"
                            invisible="not tire_field_applicability_map.tire_sidewall_lettering"
                            required="tire_field_applicability_map.tire_sidewall_lettering" />
                        <field name="tire_characteristics" />
                        <separator string="Informations Eprel"
                            invisible="not tire_field_applicability_map.tire_eprel" />
                        <field name="tire_eprel"
                            invisible="not tire_field_applicability_map.tire_eprel"
                            required="tire_field_applicability_map.tire_eprel" />
                        <field name="tire_label_image"
                            invisible="not tire_field_applicability_map.tire_eprel"
                            required="tire_field_applicability_map.tire_label_image" />
                        <field name="tire_fuel_efficiency"
                            invisible="not tire_field_applicability_map.tire_eprel"
                            required="tire_field_applicability_map.tire_fuel_efficiency" />
                        <field name="tire_wet_grip"
                            invisible="not tire_field_applicability_map.tire_eprel"
                            required="tire_field_applicability_map.tire_wet_grip" />
                        <field name="tire_noise_db"
                            invisible="not tire_field_applicability_map.tire_eprel"
                            required="tire_field_applicability_map.tire_noise_db" />
                    </group>
                </page>

            </xpath>

        </field>
    </record>
</odoo>