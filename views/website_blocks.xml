<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Bloc Recherche de pneus -->
    <template id="home_search_block" name="Accueil - Recherche de pneus">

        <section class="tc-home-search">
            <div class="container text-center">

                <h2>Trouvez vos pneus</h2>

                <p>
                    Recherchez rapidement les pneus adaptés à votre véhicule.
                </p>

                <form action="/shop" method="get">

                    <div class="input-group w-100">

                        <input type="text"
                            name="search"
                            class="form-control"
                            placeholder="Marque, dimension, véhicule..." />

                        <button class="btn btn-primary" type="submit">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                fill="currentColor" class="bi bi-arrow-right" viewBox="0 0 16 16">
                                <path fill-rule="evenodd"
                                    d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8" />
                            </svg>
                        </button>

                    </div>

                </form>

            </div>
        </section>

    </template>


    <!-- Bloc Devenir installateur -->
    <template id="home_installer_block" name="Accueil - Devenir installateur">

        <section class="tc-home-installer">
            <div class="container text-center">

                <h2>Vous êtes installateur ?</h2>

                <p>
                    Rejoignez notre réseau d'installateurs partenaires et
                    recevez des demandes de montage des clients du site.
                </p>

                <a href="/installers"
                    class="btn btn-primary btn-lg">
                    Devenir installateur
                </a>

            </div>
        </section>

    </template>

</odoo>