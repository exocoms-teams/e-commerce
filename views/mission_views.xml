<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- FORM VIEW MISSION                                               -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="view_sinistre_mission_form" model="ir.ui.view">
        <field name="name">sinistre.mission.form</field>
        <field name="model">sinistre.mission</field>
        <field name="arch" type="xml">
            <form string="Ordre de Mission">
                <header>
                    <button name="action_assigner" string="Assigner" type="object"
                            class="btn-primary"
                            invisible="state != 'nouveau' or not intervenant_id"/>
                    <button name="action_planifier_rdv" string="Confirmer RDV" type="object"
                            class="btn-primary"
                            invisible="state not in ('assigne',)"/>
                    <button name="action_demarrer" string="Démarrer les travaux" type="object"
                            class="btn-primary"
                            invisible="state not in ('devis_accepte',)"/>
                    <button name="action_terminer" string="Clôturer la mission" type="object"
                            class="btn-success"
                            invisible="state not in ('travaux_en_cours', 'en_cours')"/>
                    <button name="action_creer_facture_assurance" string="Facturer Assurance" type="object"
                            class="btn-secondary"
                            invisible="state != 'termine' or source != 'assurance' or facture_assurance_id"/>
                    <button name="action_creer_facture_client" string="Facturer Reste à Charge" type="object"
                            class="btn-secondary"
                            invisible="state not in ('termine', 'facture') or reste_a_charge &lt;= 0 or facture_client_id"/>
                    <button name="action_annuler" string="Annuler" type="object"
                            invisible="state in ('clos', 'annule', 'facture')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="nouveau,assigne,rdv_planifie,devis_envoye,devis_accepte,travaux_en_cours,termine,facture,clos"/>
                </header>

                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_voir_devis" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="devis_count" widget="statinfo" string="Devis"/>
                        </button>
                        <button name="action_voir_photos" type="object" class="oe_stat_button" icon="fa-camera">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="photos_avant_count"/> / <field name="photos_apres_count"/></span>
                                <span class="o_stat_text">Photos Avant/Après</span>
                            </div>
                        </button>
                        <button name="%(action_sinistre_devis)d" type="action" class="oe_stat_button" icon="fa-euro"
                                invisible="not montant_devis">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="montant_devis" widget="monetary"/></span>
                                <span class="o_stat_text">Devis Accepté</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="reference" readonly="1"/>
                        </h1>
                        <field name="priority" widget="priority"/>
                    </div>

                    <group>
                        <group string="Identification">
                            <field name="source" widget="radio" options="{'horizontal': true}"/>
                            <field name="type_intervention"/>
                            <field name="urgence"/>
                        </group>
                        <group string="Dates">
                            <field name="date_reception"/>
                            <field name="date_rdv" widget="datetime"/>
                            <field name="date_debut_travaux" readonly="1"/>
                            <field name="date_cloture" readonly="1"/>
                        </group>
                    </group>

                    <!-- Bloc Assurance (affiché si source = assurance) -->
                    <group string="Compagnie d'Assurance" invisible="source != 'assurance'" name="assurance_block">
                        <group>
                            <field name="assurance_id"/>
                            <field name="ref_assurance"/>
                            <field name="contrat_assurance"/>
                        </group>
                        <group>
                            <field name="montant_garanti"/>
                            <field name="franchise"/>
                        </group>
                    </group>

                    <!-- Bloc Client -->
                    <group string="Client / Assuré">
                        <group>
                            <field name="client_id"
                                   options="{'quick_create': false}"
                                   context="{'show_email': True}"/>
                            <field name="adresse_intervention"/>
                        </group>
                        <group>
                            <field name="contact_sur_place"/>
                            <field name="tel_sur_place"/>
                        </group>
                    </group>

                    <!-- Bloc Intervenant -->
                    <group string="Intervenant">
                        <field name="intervenant_id" options="{'quick_create': false}"/>
                    </group>

                    <!-- Description -->
                    <notebook>
                        <page string="Description du Sinistre">
                            <field name="description_sinistre" placeholder="Décrivez le sinistre en détail..."/>
                        </page>
                        <page string="Financier">
                            <group>
                                <group string="Montants">
                                    <field name="montant_devis"/>
                                    <field name="montant_garanti" invisible="source != 'assurance'"/>
                                    <field name="franchise" invisible="source != 'assurance'"/>
                                    <field name="reste_a_charge" class="fw-bold"/>
                                    <field name="commission_plateforme"/>
                                </group>
                                <group string="Facturation">
                                    <field name="facture_assurance_id" readonly="1"/>
                                    <field name="facture_client_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Commentaire Interne">
                            <field name="commentaire_interne" placeholder="Notes internes (non visibles du client)..."/>
                        </page>
                        <page string="Informations Techniques">
                            <group>
                                <field name="token_api" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- LIST VIEW                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="view_sinistre_mission_list" model="ir.ui.view">
        <field name="name">sinistre.mission.list</field>
        <field name="model">sinistre.mission</field>
        <field name="arch" type="xml">
            <list string="Missions" decoration-danger="urgence == 'tres_urgente'"
                  decoration-warning="urgence == 'urgente'"
                  decoration-muted="state in ('clos', 'annule')">
                <field name="reference"/>
                <field name="date_reception"/>
                <field name="source" widget="badge"
                       decoration-info="source == 'assurance'"
                       decoration-success="source == 'particulier'"
                       decoration-warning="source == 'entreprise'"/>
                <field name="type_intervention"/>
                <field name="client_id"/>
                <field name="adresse_intervention"/>
                <field name="intervenant_id"/>
                <field name="date_rdv"/>
                <field name="urgence" widget="badge"
                       decoration-danger="urgence == 'tres_urgente'"
                       decoration-warning="urgence == 'urgente'"
                       decoration-success="urgence == 'normale'"/>
                <field name="montant_devis" widget="monetary" optional="show"/>
                <field name="reste_a_charge" widget="monetary" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('termine', 'clos')"
                       decoration-primary="state in ('travaux_en_cours', 'en_cours')"
                       decoration-warning="state in ('devis_envoye', 'rdv_planifie')"
                       decoration-danger="state in ('annule', 'devis_refuse')"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- KANBAN VIEW                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <record id="view_sinistre_mission_kanban" model="ir.ui.view">
        <field name="name">sinistre.mission.kanban</field>
        <field name="model">sinistre.mission</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="reference"/>
                <field name="source"/>
                <field name="type_intervention"/>
                <field name="client_id"/>
                <field name="intervenant_id"/>
                <field name="urgence"/>
                <field name="montant_devis"/>
                <field name="date_rdv"/>
                <field name="state"/>
                <field name="priority"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click #{record.urgence.raw_value == 'tres_urgente' ? 'border-danger' : record.urgence.raw_value == 'urgente' ? 'border-warning' : ''}">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="reference"/>
                                        </strong>
                                        <small class="o_kanban_record_subtitle text-muted">
                                            <field name="type_intervention"/>
                                        </small>
                                    </div>
                                    <field name="priority" widget="priority"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div><i class="fa fa-user"/> <field name="client_id"/></div>
                                    <div t-if="record.intervenant_id.raw_value">
                                        <i class="fa fa-wrench"/> <field name="intervenant_id"/>
                                    </div>
                                    <div t-if="record.date_rdv.raw_value">
                                        <i class="fa fa-calendar"/> <field name="date_rdv"/>
                                    </div>
                                    <div t-if="record.montant_devis.raw_value">
                                        <i class="fa fa-euro"/> <field name="montant_devis" widget="monetary"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="source" widget="badge"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="urgence" widget="badge"
                                               decoration-danger="urgence == 'tres_urgente'"
                                               decoration-warning="urgence == 'urgente'"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_sinistre_mission_search" model="ir.ui.view">
        <field name="name">sinistre.mission.search</field>
        <field name="model">sinistre.mission</field>
        <field name="arch" type="xml">
            <search string="Recherche Missions">
                <field name="reference"/>
                <field name="client_id"/>
                <field name="intervenant_id"/>
                <field name="assurance_id"/>
                <field name="ref_assurance"/>
                <separator/>
                <filter string="Nouvelles" name="nouveau" domain="[('state', '=', 'nouveau')]"/>
                <filter string="En Cours" name="en_cours" domain="[('state', 'in', ('en_cours', 'travaux_en_cours', 'rdv_planifie', 'assigne'))]"/>
                <filter string="Urgentes" name="urgente" domain="[('urgence', 'in', ('urgente', 'tres_urgente'))]"/>
                <filter string="Assurances" name="assurance" domain="[('source', '=', 'assurance')]"/>
                <filter string="Particuliers" name="particulier" domain="[('source', '=', 'particulier')]"/>
                <filter string="Entreprises" name="entreprise" domain="[('source', '=', 'entreprise')]"/>
                <filter string="Terminées" name="termine" domain="[('state', 'in', ('termine', 'facture', 'clos'))]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter string="Statut" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'type_intervention'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                    <filter string="Intervenant" name="group_intervenant" context="{'group_by': 'intervenant_id'}"/>
                    <filter string="Assurance" name="group_assurance" context="{'group_by': 'assurance_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_sinistre_mission" model="ir.actions.act_window">
        <field name="name">Ordres de Mission</field>
        <field name="res_model">sinistre.mission</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_sinistre_mission_search"/>
        <field name="context">{'search_default_en_cours': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune mission pour le moment.
            </p>
            <p>Créez votre première mission ou attendez les ordres des assurances via l'API.</p>
        </field>
    </record>

</odoo>
