<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="request_form" name="Inscription : demande">
        <t t-call="web.login_layout">
            <div class="text-center mb-3">
                <h4 class="mb-1">Créer un compte</h4>
                <p class="text-muted small mb-0">
                    Nous vous enverrons un lien de confirmation.
                </p>
            </div>

            <div t-if="error" class="alert alert-danger" role="alert">
                <t t-out="error">Erreur</t>
            </div>

            <form action="/web/signup" method="post" class="oe_signup_form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <!-- Piège à robots : masqué et retiré de la navigation clavier.
                     Un formulaire rempli automatiquement le renseignera ; un
                     visiteur humain ne le verra jamais. -->
                <div style="position:absolute;left:-9999px;top:-9999px;"
                     aria-hidden="true">
                    <label for="website_url">Ne pas remplir ce champ</label>
                    <input type="text" name="website_url" id="website_url"
                           tabindex="-1" autocomplete="off" value=""/>
                </div>

                <div class="mb-3">
                    <label for="name" class="form-label">Nom</label>
                    <input type="text" name="name" id="name" class="form-control"
                           t-att-value="name or ''" placeholder="Votre nom"
                           required="required" autofocus="autofocus"/>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">Adresse email</label>
                    <input type="email" name="email" id="email" class="form-control"
                           t-att-value="email or ''" placeholder="vous@exemple.fr"
                           required="required" autocomplete="email"/>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Recevoir le lien de confirmation
                </button>
            </form>

            <div class="text-center small mt-3">
                <a href="/web/login">J'ai déjà un compte</a>
            </div>
        </t>
    </template>

    <template id="request_pending" name="Inscription : vérifiez vos emails">
        <t t-call="web.login_layout">
            <div class="text-center mb-3">
                <h4 class="mb-3">Vérifiez votre boîte mail</h4>
            </div>

            <div t-if="error" class="alert alert-warning" role="alert">
                <t t-out="error">Erreur</t>
            </div>
            <div t-if="resent" class="alert alert-success" role="alert">
                Un nouveau lien vient de vous être envoyé.
            </div>

            <p class="text-muted">
                Si une inscription est possible avec cette adresse
                <t t-if="email">(<strong t-out="email">votre adresse</strong>)</t>,
                vous recevrez un email contenant un lien de confirmation.
                Vous choisirez votre mot de passe juste après.
            </p>
            <p class="text-muted small">
                Rien reçu au bout de quelques minutes ? Pensez à regarder dans
                vos courriers indésirables.
            </p>

            <form t-if="email" action="/signup/resend" method="post" class="mt-3">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="email" t-att-value="email"/>
                <button type="submit" class="btn btn-secondary w-100">
                    Renvoyer le lien
                </button>
            </form>

            <div class="text-center small mt-3">
                <a href="/web/login">Retour à la connexion</a>
            </div>
        </t>
    </template>

    <template id="request_confirm_failed" name="Inscription : confirmation impossible">
        <t t-call="web.login_layout">

            <t t-if="state == 'expired'">
                <div class="text-center mb-3">
                    <h4 class="mb-3">Lien expiré</h4>
                </div>
                <p class="text-muted">
                    Ce lien de confirmation n'est plus valable. Déposez une
                    nouvelle demande, cela prend quelques secondes.
                </p>
            </t>

            <t t-else="">
                <div class="text-center mb-3">
                    <h4 class="mb-3">Lien invalide</h4>
                </div>
                <p class="text-muted">
                    Ce lien n'est pas reconnu. Il a peut-être déjà été utilisé —
                    dans ce cas votre compte existe et vous pouvez vous
                    connecter normalement.
                </p>
            </t>

            <a href="/web/signup" class="btn btn-primary w-100">
                Déposer une nouvelle demande
            </a>
            <div class="text-center small mt-3">
                <a href="/web/login">Aller à la connexion</a>
            </div>
        </t>
    </template>

</odoo>
