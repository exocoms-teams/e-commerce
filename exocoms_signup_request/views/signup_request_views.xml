<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_signup_request_list" model="ir.ui.view">
        <field name="name">exocoms.signup.request.list</field>
        <field name="model">exocoms.signup.request</field>
        <field name="arch" type="xml">
            <list string="Demandes d'inscription" create="false"
                  decoration-muted="state in ('expired', 'rejected')"
                  decoration-success="state == 'confirmed'">
                <field name="create_date" string="Déposée le"/>
                <field name="email"/>
                <field name="name"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'rejected'"/>
                <field name="expiry" optional="show"/>
                <field name="email_count" string="Emails" optional="hide"/>
                <field name="partner_id" optional="hide"/>
                <field name="ip_hash" string="Origine" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_signup_request_form" model="ir.ui.view">
        <field name="name">exocoms.signup.request.form</field>
        <field name="model">exocoms.signup.request</field>
        <field name="arch" type="xml">
            <form string="Demande d'inscription" create="false">
                <header>
                    <button name="action_resend" type="object"
                            string="Renvoyer le lien" class="btn-primary"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="email" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Demande">
                            <field name="name"/>
                            <field name="lang"/>
                            <field name="create_date" string="Déposée le"/>
                            <field name="expiry" invisible="state != 'pending'"/>
                            <field name="reject_reason" invisible="state != 'rejected'"/>
                        </group>
                        <group string="Suivi">
                            <field name="sent_date"/>
                            <field name="email_count"/>
                            <field name="confirmed_date" invisible="state != 'confirmed'"/>
                            <field name="partner_id" invisible="state != 'confirmed'"/>
                        </group>
                    </group>
                    <group string="Origine">
                        <field name="website_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Lien en cours" invisible="state != 'pending'">
                        <field name="confirm_url" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_signup_request_search" model="ir.ui.view">
        <field name="name">exocoms.signup.request.search</field>
        <field name="model">exocoms.signup.request</field>
        <field name="arch" type="xml">
            <search string="Demandes d'inscription">
                <field name="email"/>
                <field name="name"/>
                <filter name="filter_pending" string="En attente"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="filter_confirmed" string="Confirmées"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_expired" string="Expirées"
                        domain="[('state', '=', 'expired')]"/>
                <filter name="filter_rejected" string="Refusées"
                        domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="filter_today" string="Aujourd'hui"
                        domain="[('create_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_state" string="État"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Date de dépôt"
                            context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_signup_request" model="ir.actions.act_window">
        <field name="name">Demandes d'inscription</field>
        <field name="res_model">exocoms.signup.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_signup_request_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune demande d'inscription</p>
            <p>
                Les demandes déposées depuis le formulaire public apparaissent
                ici. Aucun compte ni contact n'est créé tant que l'adresse email
                n'a pas été confirmée.
            </p>
        </field>
    </record>

    <menuitem id="menu_signup_request"
              name="Demandes d'inscription"
              parent="base.menu_users"
              action="action_signup_request"
              sequence="60"
              groups="base.group_system"/>

</odoo>
