<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.exocoms.signup.request</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Inscription portail (EXOCOMS)"
                       name="exocoms_signup_request_block">

                    <setting string="Refuser les adresses jetables"
                             help="Rejette les demandes provenant des domaines marqués « Refusé ».">
                        <field name="exocoms_block_disposable"/>
                    </setting>

                    <setting string="Vérifier le domaine (DNS)"
                             help="Contrôle que le domaine peut recevoir du courrier. Ignoré si dnspython n'est pas installé.">
                        <field name="exocoms_check_mx"/>
                    </setting>

                    <setting string="Limiter aux domaines autorisés"
                             help="N'accepte que les domaines marqués « Autorisé ».">
                        <field name="exocoms_restrict_allowed"/>
                    </setting>

                    <setting string="Validité du lien de confirmation"
                             help="Durée pendant laquelle le lien reçu reste utilisable.">
                        <field name="exocoms_token_ttl_hours" class="o_light_label"/> heures
                    </setting>

                    <setting string="Délai entre deux envois"
                             help="Protection contre les demandes de renvoi répétées.">
                        <field name="exocoms_resend_interval" class="o_light_label"/> secondes
                    </setting>

                    <setting string="Nombre maximum d'emails"
                             help="Plafond par demande. 0 pour illimité.">
                        <field name="exocoms_max_resend" class="o_light_label"/>
                    </setting>

                    <setting string="Demandes maximum par origine"
                             help="Limite les dépôts successifs depuis une même connexion. 0 désactive le plafonnement.">
                        <field name="exocoms_max_per_ip" class="o_light_label"/>
                        par
                        <field name="exocoms_ip_window_minutes" class="o_light_label"/> minutes
                    </setting>

                    <setting string="Conservation des demandes expirées"
                             help="Suppression automatique. 0 conserve indéfiniment.">
                        <field name="exocoms_keep_expired_days" class="o_light_label"/> jours
                    </setting>

                    <setting string="Conservation des demandes confirmées"
                             help="Seule la trace de la demande est supprimée : le compte créé n'est jamais concerné.">
                        <field name="exocoms_keep_confirmed_days" class="o_light_label"/> jours
                    </setting>

                    <setting string="Conservation des demandes refusées"
                             help="Suppression automatique. 0 conserve indéfiniment.">
                        <field name="exocoms_keep_rejected_days" class="o_light_label"/> jours
                    </setting>

                </block>
            </xpath>
        </field>
    </record>

</odoo>
