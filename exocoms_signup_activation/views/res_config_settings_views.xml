<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_activation" model="ir.ui.view">
        <field name="name">res.config.settings.form.exocoms.activation</field>
        <field name="model">res.config.settings</field>
        <!-- On remet la vue parente d'origine demandée par Eric -->
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- XPath universel : s'accroche au premier bloc de paramètres disponible -->
            <xpath expr="//app[@name='base_setup']" position="inside">
                <block title="Activation des comptes portail (EXOCOMS)"
                       name="exocoms_signup_activation_block">
                    <setting string="Validité du lien d'activation"
                             help="Durée au-delà de laquelle le lien reçu par email n'est plus valable.">
                        <div class="content-group mt-2">
                            <field name="exocoms_activation_ttl_hours" class="o_light_label"
                                   style="width: 80px;"/>
                            <span class="ms-2">heure(s)</span>
                        </div>
                    </setting>
                    <setting string="Purge des inscriptions non activées"
                             help="Suppression automatique des comptes jamais activés. 0 = désactivé.">
                        <div class="content-group mt-2">
                            <field name="exocoms_activation_purge_days" class="o_light_label"
                                   style="width: 80px;"/>
                            <span class="ms-2">jour(s)</span>
                        </div>
                    </setting>
                    <setting string="Délai minimum entre deux envois"
                             help="Protection contre les demandes de renvoi répétées.">
                        <div class="content-group mt-2">
                            <field name="exocoms_activation_resend_interval" class="o_light_label"
                                   style="width: 80px;"/>
                            <span class="ms-2">seconde(s)</span>
                        </div>
                    </setting>
                    <setting string="Nombre maximum d'emails d'activation"
                             help="Nombre d'envois autorisés pour une même inscription. 0 = illimité.">
                        <div class="content-group mt-2">
                            <field name="exocoms_activation_max_resend" class="o_light_label"
                                   style="width: 80px;"/>
                        </div>
                    </setting>
                    <setting string="Signaler « compte non activé » à la connexion"
                             help="Décochez pour ne jamais confirmer l'existence d'une adresse email.">
                        <field name="exocoms_activation_reveal_pending"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>