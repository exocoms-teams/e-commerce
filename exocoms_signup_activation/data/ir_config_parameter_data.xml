<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="param_token_ttl_hours" model="ir.config_parameter">
            <field name="key">exocoms_signup_activation.token_ttl_hours</field>
            <field name="value">24</field>
        </record>

        <record id="param_purge_days" model="ir.config_parameter">
            <field name="key">exocoms_signup_activation.purge_days</field>
            <field name="value">7</field>
        </record>

        <record id="param_resend_interval" model="ir.config_parameter">
            <field name="key">exocoms_signup_activation.resend_interval</field>
            <field name="value">120</field>
        </record>

        <record id="param_max_resend" model="ir.config_parameter">
            <field name="key">exocoms_signup_activation.max_resend</field>
            <field name="value">5</field>
        </record>

        <record id="param_reveal_pending" model="ir.config_parameter">
            <field name="key">exocoms_signup_activation.reveal_pending</field>
            <field name="value">True</field>
        </record>

    </data>
</odoo>
