<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_signup_activation" model="mail.template">
            <field name="name">Portail : activation du compte</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Activez votre compte {{ object.company_id.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email_formatted or object.login }}</field>
            <field name="lang">{{ object.lang }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="margin:0px;padding:0px;font-size:14px;font-family:Arial,Helvetica,sans-serif;color:#454748;">
    <t t-set="activation_url" t-value="object.get_base_url() + '/signup/activate/' + (object.exocoms_activation_token or '')"/>
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color:#f5f6f7;padding:24px 0;">
        <tr>
            <td align="center">
                <table border="0" cellpadding="0" cellspacing="0" width="600" style="background-color:#ffffff;border-radius:6px;border:1px solid #e5e7e9;">
                    <tr>
                        <td style="padding:28px 32px 12px 32px;border-bottom:1px solid #eef0f2;">
                            <span style="font-size:20px;font-weight:600;color:#1f2937;" t-out="object.company_id.name or ''">EXOCOMS</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:28px 32px 8px 32px;">
                            <p style="margin:0 0 16px 0;">Bonjour <t t-out="object.name or ''">Client</t>,</p>
                            <p style="margin:0 0 16px 0;">
                                Vous venez de créer un compte sur
                                <t t-out="object.company_id.name or ''">notre site</t>.
                                Pour des raisons de sécurité, il ne reste qu'une étape :
                                confirmer votre adresse email.
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding:8px 32px 24px 32px;">
                            <a t-att-href="activation_url"
                               style="display:inline-block;padding:12px 28px;background-color:#714B67;color:#ffffff;text-decoration:none;border-radius:4px;font-weight:600;">
                                Activer mon compte
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:0 32px 24px 32px;">
                            <p style="margin:0 0 12px 0;font-size:13px;color:#6b7280;">
                                Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur :
                            </p>
                            <p style="margin:0 0 20px 0;font-size:13px;word-break:break-all;">
                                <a t-att-href="activation_url" style="color:#714B67;" t-out="activation_url">lien</a>
                            </p>
                            <p style="margin:0 0 8px 0;font-size:13px;color:#6b7280;">
                                Votre identifiant de connexion : <strong t-out="object.login or ''">email</strong>
                            </p>
                            <p style="margin:0;font-size:13px;color:#6b7280;">
                                Ce lien est valable
                                <t t-out="object._exocoms_get_int_param('token_ttl_hours')">24</t> heures.
                                Si vous n'êtes pas à l'origine de cette demande, ignorez simplement cet email :
                                aucun compte ne sera activé.
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:16px 32px;background-color:#fafafa;border-top:1px solid #eef0f2;border-radius:0 0 6px 6px;">
                            <p style="margin:0;font-size:12px;color:#9ca3af;">
                                <t t-out="object.company_id.name or ''">EXOCOMS</t>
                                <t t-if="object.company_id.phone"> — <t t-out="object.company_id.phone"/></t>
                                <t t-if="object.company_id.email"> — <t t-out="object.company_id.email"/></t>
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</div>
            </field>
        </record>

    </data>
</odoo>
