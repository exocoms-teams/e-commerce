<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="s_bluespa_hero" name="BlueSpa - Hero">
        <section class="s_bluespa_hero o_colored_level pt0 pb0"
                 data-snippet="s_bluespa_hero"
                 data-name="BlueSpa - Bannière hero">
            <div class="s_bluespa_hero_bg d-flex align-items-center justify-content-center text-center">
                <div class="s_bluespa_hero_overlay"/>
                <div class="container position-relative py-5">
                    <h1 class="s_bluespa_hero_logo mb-3">
                        <span class="s_bluespa_hero_logo_dark">Blue</span><span class="s_bluespa_hero_logo_light">Spa</span>
                    </h1>
                    <h2 class="s_bluespa_hero_tagline mb-4">Votre espace bien-être, livré chez vous</h2>
                    <hr class="s_bluespa_hero_divider mx-auto"/>
                    <p class="s_bluespa_hero_subtext mb-1">Découvrez notre sélection de spas haut de gamme.</p>
                    <p class="s_bluespa_hero_subtext mb-4">Livraison, installation et maintenance assurées par nos experts.</p>
                    <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
                        <a href="/shop" class="btn s_bluespa_btn_primary px-4 py-2">Découvrir nos Spas</a>
                        <a href="/contactus" class="btn s_bluespa_btn_outline px-4 py-2">Nous Contacter</a>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Popup promotionnel affiché à l'arrivée sur l'accueil, sur le modèle du snippet natif s_popup -->
    <template id="s_bluespa_promo_popup" name="BlueSpa - Popup promo">
        <section class="s_popup o_no_autoplay o_snippet_invisible s_bluespa_promo_popup"
                  data-vcss="001" data-snippet="s_popup" data-name="Popup"
                  data-invisible="1">
            <div class="modal s_popup_middle" tabindex="-1" role="dialog"
                 data-show-after="2000" data-display="afterDelay" data-consists-only-once="true"
                 data-focus="false" data-backdrop="true">
                <div class="modal-dialog d-flex">
                    <div class="modal-content oe_structure">
                        <button type="button" class="btn-close position-absolute top-0 end-0 p-3"
                                data-bs-dismiss="modal" aria-label="Close"/>
                        <section class="s_text_block pt24 pb24 text-center">
                            <div class="container">
                                <h3 class="mb-2">-10% sur votre première commande</h3>
                                <p class="text-muted mb-0">Profitez-en dès aujourd'hui sur tout le catalogue BlueSpa.</p>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
