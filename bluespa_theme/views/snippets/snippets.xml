<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="snippets" inherit_id="website.snippets" name="Snippets BlueSpa">
        <xpath expr="//snippets[@id='snippet_content']" position="inside">
            <t t-snippet="bluespa_theme.s_bluespa_hero"
               string="BlueSpa - Bannière hero"
               group="content"
               t-thumbnail="/bluespa_theme/static/description/s_bluespa_hero_thumbnail.svg">
                <keywords>bluespa, spa, hero, bannière, accueil</keywords>
            </t>
            <t t-snippet="bluespa_theme.s_bluespa_why_us"
               string="BlueSpa - Pourquoi nous choisir"
               group="content"
               t-thumbnail="/bluespa_theme/static/description/s_bluespa_why_us_thumbnail.svg">
                <keywords>bluespa, spa, avantages, livraison, garantie</keywords>
            </t>
            <t t-snippet="bluespa_theme.s_bluespa_catalog"
               string="BlueSpa - Catalogue populaire"
               group="content"
               t-thumbnail="/bluespa_theme/static/description/s_bluespa_catalog_thumbnail.svg">
                <keywords>bluespa, spa, catalogue, produits, populaires</keywords>
            </t>
            <t t-snippet="bluespa_theme.s_bluespa_reviews"
               string="BlueSpa - Avis clients"
               group="content"
               t-thumbnail="/bluespa_theme/static/description/s_bluespa_reviews_thumbnail.svg">
                <keywords>bluespa, avis, clients, google, témoignages</keywords>
            </t>
        </xpath>
    </template>
</odoo>
