<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Le site original intégrait un widget tiers ("Free Google Reviews Widget").
        Ce snippet reproduit le même rendu visuel en local, sans dépendance externe.
        Seul l'avis de "D Sébastien" est le texte réel capturé dans la démo vidéo du
        25/06/2026 ; les autres sont des textes provisoires À REMPLACER par les vrais
        avis Google de l'entreprise avant mise en ligne.
    -->
    <template id="s_bluespa_reviews" name="BlueSpa - Avis clients">
        <section class="s_bluespa_reviews o_colored_level pt48 pb48"
                 data-snippet="s_bluespa_reviews"
                 data-name="BlueSpa - Avis clients">
            <div class="container">
                <h2 class="text-center mb-4">Ce que nos clients disent de nous</h2>

                <div class="s_bluespa_reviews_badge d-flex align-items-center justify-content-center gap-3 mx-auto mb-4">
                    <span class="s_bluespa_reviews_google_logo">Google</span>
                    <span class="s_bluespa_reviews_score">4,8</span>
                    <span class="s_bluespa_reviews_stars">
                        <i class="fa fa-star" role="presentation"/><i class="fa fa-star" role="presentation"/><i class="fa fa-star" role="presentation"/><i class="fa fa-star" role="presentation"/><i class="fa fa-star" role="presentation"/>
                    </span>
                    <span class="s_bluespa_reviews_count text-muted">(19)</span>
                </div>

                <div id="s_bluespa_reviews_carousel" class="carousel slide s_bluespa_reviews_carousel" data-bs-ride="false">
                    <div class="carousel-inner">

                        <div class="carousel-item active">
                            <div class="s_bluespa_review_card mx-auto">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="s_bluespa_review_avatar">D</span>
                                    <div class="ms-3">
                                        <div class="s_bluespa_review_name">D Sébastien <i class="fa fa-check-circle text-primary" role="presentation"/></div>
                                        <div class="s_bluespa_review_date text-muted">il y a 8 mois</div>
                                    </div>
                                </div>
                                <div class="s_bluespa_review_stars mb-2">
                                    <i class="fa fa-star" role="presentation"/><i class="fa fa-star" role="presentation"/><i class="fa fa-star" role="presentation"/><i class="fa fa-star" role="presentation"/><i class="fa fa-star" role="presentation"/>
                                </div>
                                <p class="s_bluespa_review_text mb-0">
                                    Bonjour à tous. Avant tout, un grand MERCI à Pacôme et Rachel pour leur
                                    disponibilité et les réponses apportées avant notre achat. Il n'est pas
                                    toujours évident de faire un tel achat sur internet mais ici vous êtes
                                    certain d'avoir des échanges avec un très bon service client.
                                </p>
                            </div>
                        </div>

                        <div class="carousel-item">
                            <div class="s_bluespa_review_card mx-auto">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="s_bluespa_review_avatar">S</span>
                                    <div class="ms-3">
                                        <div class="s_bluespa_review_name">Severine Cayen <i class="fa fa-check-circle text-primary" role="presentation"/></div>
                                        <div class="s_bluespa_review_date text-muted">il y a 7 mois</div>
                                    </div>
                                </div>
                                <div class="s_bluespa_review_stars mb-2">
                                    <i class="fa fa-star" role="presentation"/><i class="fa fa-star" role="presentation"/><i class="fa fa-star" role="presentation"/><i class="fa fa-star" role="presentation"/><i class="fa fa-star" role="presentation"/>
                                </div>
                                <p class="s_bluespa_review_text mb-0">
                                    [Texte à remplacer par le vrai avis Google] Installation rapide et
                                    équipe très professionnelle du début à la fin de la commande.
                                </p>
                            </div>
                        </div>

                        <div class="carousel-item">
                            <div class="s_bluespa_review_card mx-auto">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="s_bluespa_review_avatar">M</span>
                                    <div class="ms-3">
                                        <div class="s_bluespa_review_name">M. Laurent <i class="fa fa-check-circle text-primary" role="presentation"/></div>
                                        <div class="s_bluespa_review_date text-muted">il y a 5 mois</div>
                                    </div>
                                </div>
                                <div class="s_bluespa_review_stars mb-2">
                                    <i class="fa fa-star" role="presentation"/><i class="fa fa-star" role="presentation"/><i class="fa fa-star" role="presentation"/><i class="fa fa-star" role="presentation"/><i class="fa fa-star" role="presentation"/>
                                </div>
                                <p class="s_bluespa_review_text mb-0">
                                    [Texte à remplacer par le vrai avis Google] Le spa correspond exactement
                                    à la description, le SAV a répondu présent quand j'ai eu une question.
                                </p>
                            </div>
                        </div>

                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#s_bluespa_reviews_carousel" data-bs-slide="prev">
                        <i class="fa fa-chevron-left" role="presentation"/>
                        <span class="visually-hidden">Précédent</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#s_bluespa_reviews_carousel" data-bs-slide="next">
                        <i class="fa fa-chevron-right" role="presentation"/>
                        <span class="visually-hidden">Suivant</span>
                    </button>
                    <div class="carousel-indicators position-relative mt-3">
                        <button type="button" data-bs-target="#s_bluespa_reviews_carousel" data-bs-slide-to="0" class="active"/>
                        <button type="button" data-bs-target="#s_bluespa_reviews_carousel" data-bs-slide-to="1"/>
                        <button type="button" data-bs-target="#s_bluespa_reviews_carousel" data-bs-slide-to="2"/>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
