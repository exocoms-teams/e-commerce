<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        La page /contactus livrée par le module website est une page générique
        vide (formulaire de contact standard). On lui ajoute le bandeau photo
        avec titre observé sur la démo du 25/06/2026, en l'insérant juste avant
        #wrap plutôt qu'à l'intérieur : on ne dépend pas de la structure interne
        (inconnue à l'avance) du contenu par défaut de cette page.
    -->
    <template id="contactus_banner" inherit_id="website.contactus" name="BlueSpa - Bannière Contactez-nous">
        <xpath expr="//div[@id='wrap']" position="before">
            <section class="s_bluespa_contact_banner d-flex align-items-center justify-content-center text-center">
                <div class="container position-relative py-5">
                    <h1 class="s_bluespa_contact_title mb-3">Contactez-nous</h1>
                    <p class="s_bluespa_contact_subtext mb-0">
                        Une question, un projet d'installation ? Notre équipe vous répond sous 24h.
                    </p>
                </div>
            </section>
        </xpath>
    </template>

</odoo>
