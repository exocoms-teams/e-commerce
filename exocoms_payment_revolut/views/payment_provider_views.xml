<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Revolut Business Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <field name="revolut_secret_key"
                       invisible="code != 'revolut'"
                       required="code == 'revolut' and is_live"
                       widget="password"/>
                <field name="revolut_public_key" invisible="code != 'revolut'"/>
                <field name="revolut_webhook_id"
                       invisible="code != 'revolut' or not revolut_webhook_id"
                       readonly="1"/>
                <field name="revolut_webhook_secret"
                       invisible="code != 'revolut'"
                       widget="password"/>
                <div colspan="2" invisible="code != 'revolut'">
                    <button name="action_revolut_create_webhook" type="object"
                            string="Créer le webhook Revolut"
                            class="btn-link" icon="fa-cloud-upload"
                            invisible="revolut_webhook_id"/>
                    <button name="action_revolut_delete_webhook" type="object"
                            string="Supprimer le webhook Revolut"
                            class="btn-link text-danger" icon="fa-trash"
                            invisible="not revolut_webhook_id"/>
                </div>
            </group>
        </field>
    </record>

</odoo>
