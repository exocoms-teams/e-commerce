<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_revolut" model="payment.provider">
        <field name="name">Revolut Business</field>
        <field name="code">revolut</field>
        <field name="image_128" type="bytes" file="exocoms_payment_revolut/static/description/icon.png"/>
        <field name="redirect_form_view_id" ref="payment.generic_redirect_form"/>
        <field name="payment_method_ids"
               eval="[Command.set([
                         ref('payment.payment_method_card'),
                         ref('payment.payment_method_revolut_pay'),
                         ref('payment.payment_method_sepa_direct_debit'),
                     ])]"
        />
    </record>

</odoo>
