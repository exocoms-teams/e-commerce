<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_quotations" inherit_id="sale.portal_my_quotations">
        <xpath expr="//thead/tr/th[1]" position="replace">
            <th>Quotation</th>
        </xpath>
    </template>

    <template id="portal_my_orders" inherit_id="sale.portal_my_orders">
        <xpath expr="//thead/tr/th[1]/span[1]" position="replace">
            <span class="d-none d-md-inline">Sales Order</span>
        </xpath>
    </template>
</odoo>
