<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- Logo Matelas : appliqué à la société (utilisé dans le back-office,
         les rapports PDF, etc.) et au site web (logo affiché dans le
         header/navbar), pour que la marque apparaisse partout sans avoir
         à le re-uploader manuellement à chaque nouvelle base. -->
    <record id="base.main_company" model="res.company">
      <field name="logo" type="base64" file="matelas/static/src/img/logo.jpg"/>
    </record>

  </data>
</odoo>
