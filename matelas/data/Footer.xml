<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <record id="website_footer" model="ir.ui.view">
      <field name="name">Matelas Footer</field>
      <field name="type">qweb</field>
      <field name="key">website.footer_custom</field>
      <field name="inherit_id" ref="website.layout" />
      <field name="arch" type="xml">
        <xpath expr="//div[@id='footer']" position="replace">
          <div id="footer" class="matelas-footer">
            <t t-set="is_en" t-value="request.env.context.get('lang', '').startswith('en')" />

            <div class="footer-main container">
              <div class="row py-4">

                <!-- Description -->
                <div class="col-md-3">
                  <p class="footer-logo">
                    <strong class="footer-title" t-esc="'ABOUT US' if is_en else 'A PROPOS DE NOUS'" />
                  </p>
                  <t t-if="is_en">
                    <p class="footer-desc">
                      We are dedicated to your sleep.
                      Our mission: to offer you the best
                      online mattress shopping experience.
                    </p>
                  </t>
                  <t t-else="">
                    <p class="footer-desc">
                      Nous sommes dédiés à votre sommeil.
                      Notre mission : vous offrir la meilleure
                      expérience d'achat de matelas en ligne.
                    </p>
                  </t>
                </div>

                <!-- Liens utiles -->
                <div class="col-md-3">
                  <p class="footer-title" t-esc="'USEFUL LINKS' if is_en else 'LIENS UTILES'" />
                  <ul class="footer-links">
                    <li>
                      <a href="/">
                        <i class="bi bi-house-door-fill"></i>
                        <t t-esc="' Home' if is_en else ' Accueil'" />
                      </a>
                    </li>
                    <li>
                      <a href="/shop">
                        <i class="bi-shop"></i>
                        <t t-esc="' Shop' if is_en else ' Boutique'" />
                      </a>
                    </li>
                    <li>
                      <a href="/avis">
                        <i class="bi-star-fill"></i>
                        <t t-esc="' Reviews' if is_en else ' Avis'" />
                      </a>
                    </li>
                    <li>
                      <a href="/mentions-legales">
                        <i class="bi-file-text"></i>
                        <t t-esc="' Legal notice' if is_en else ' Mentions légales'" />
                      </a>
                    </li>
                    <li>
                      <a href="/contact">
                        <i class="bi-chat-dots-fill"></i>
                        <t t-esc="' Contact' if is_en else ' Contact'" />
                      </a>
                    </li>

                    <li>
                      <a href="/cookie-policy">
                        <i class="bi bi-shield-check" />
                        <t t-esc="' Cookie policy' if is_en else ' Politique de cookies'" />
                      </a>
                    </li>
                  </ul>
                </div>

                <!-- Réseaux sociaux -->
                <div class="col-md-3">
                  <p class="footer-title" t-esc="'FOLLOW US' if is_en else 'SUIVEZ-NOUS'" />
                  <ul class="footer-links">
                    <li>
                      <a href="https://facebook.com" target="_blank">
                        <i class="bi-facebook"></i> Facebook</a>
                    </li>
                    <li>
                      <a href="https://instagram.com" target="_blank">
                        <i class="bi-instagram"></i> Instagram</a>
                    </li>
                    <li>
                      <a href="https://youtube.com" target="_blank">
                        <i class="bi-youtube"></i> YouTube</a>
                    </li>
                  </ul>
                </div>

              </div>
            </div>

            <!-- Contact -->
            <div class="col-md-3">
              <p class="footer-title">CONTACT</p>
              <ul class="footer-links">
                <li>
                  <a href="mailto:contact@matelas.com">
                    <i class="bi-envelope-fill"></i> contact@matelas.com</a>
                </li>
                <li>
                  <a href="tel:+33600000000">
                    <i class="bi-telephone-fill"></i> +33 (0)6 00 00 00 00</a>
                </li>
              </ul>
            </div>


            <!-- Moyens de paiement -->
            <div class="footer-payment container">
              <span class="footer-payment-label"
                t-esc="'Accepted payment methods:' if is_en else 'Moyens de paiement acceptés :'" />
              <div class="footer-payment-icons">

                <svg class="payment-icon" viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
                  <rect width="48" height="32" rx="4" fill="#1A1F71" />
                  <text x="24" y="21" font-family="Arial, sans-serif" font-size="13"
                    font-weight="bold" fill="#FFFFFF" text-anchor="middle">VISA</text>
                </svg>

                <svg class="payment-icon" viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
                  <rect width="48" height="32" rx="4" fill="#FFFFFF" stroke="#E0E0E0" />
                  <circle cx="20" cy="16" r="9" fill="#EB001B" />
                  <circle cx="28" cy="16" r="9" fill="#F79E1B" fill-opacity="0.85" />
                </svg>

                <svg class="payment-icon" viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
                  <rect width="48" height="32" rx="4" fill="#003087" />
                  <text x="24" y="20" font-family="Arial, sans-serif" font-size="10.5"
                    font-weight="bold" font-style="italic" fill="#FFFFFF" text-anchor="middle">
                    PayPal</text>
                </svg>

                <svg class="payment-icon" viewBox="0 0 48 32" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id="cbGradientFooter" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#1E3A8A" />
                      <stop offset="50%" stop-color="#DC2626" />
                      <stop offset="100%" stop-color="#1E3A8A" />
                    </linearGradient>
                  </defs>
                  <rect width="48" height="32" rx="4" fill="url(#cbGradientFooter)" />
                  <text x="24" y="21" font-family="Arial, sans-serif" font-size="13"
                    font-weight="bold" fill="#FFFFFF" text-anchor="middle">CB</text>
                </svg>

              </div>
            </div>

          </div>
        </xpath>
      </field>
    </record>

  </data>
</odoo>