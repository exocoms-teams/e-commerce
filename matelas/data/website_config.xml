<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">


    <!-- Configuration centralisée du site Matelas -->
    <record id="website.default_website" model="website">
      <field name="name">Matelas</field>
      <field name="logo" type="base64"
         file="matelas/static/src/img/logo.jpg"/>
      <field name="channel_id" ref="livechat_channel_matelas"/>
      <field name="cookies_bar" eval="True"/>
      <field name="language_ids"
         eval="[(4, ref('base.lang_en'))]"/>
    </record>

  </data>
</odoo>
