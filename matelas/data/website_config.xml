<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Écriture centralisée de la configuration du site web -->
  <data noupdate="1">

    <record id="website.default_website" model="website">
      <field name="name">Matelas</field>
      <field name="logo" type="base64" file="matelas/static/src/img/logo.jpg"/>
      <field name="language_ids" eval="[(4, ref('base.lang_en'))]"/>
      <field name="channel_id" ref="livechat_channel_matelas"/>
      <field name="cookies_bar">True</field>
    </record>

  </data>

</odoo>
