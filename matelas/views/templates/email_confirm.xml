<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="email_confirm_success" name="Email confirmé">
    <t t-call="website.layout">

      <div class="o_page_content">

        <section class="ml-hero">
          <div class="ml-hero-overlay">
            <div class="container text-center">
              <h1>✅ Adresse email confirmée</h1>
              <p>Votre compte est maintenant actif</p>
            </div>
          </div>
        </section>

        <section class="ml-content container">
          <div class="ml-box text-center">
            <p>
              Merci, votre adresse email a bien été confirmée.
              Vous pouvez maintenant vous connecter avec votre email
              et le mot de passe choisi à l'inscription.
            </p>
            <a href="/web/login" class="btn btn-primary">Se connecter →</a>
          </div>
        </section>

      </div>

    </t>
  </template>

  <template id="email_confirm_invalid" name="Lien de confirmation invalide">
    <t t-call="website.layout">

      <div class="o_page_content">

        <section class="ml-hero">
          <div class="ml-hero-overlay">
            <div class="container text-center">
              <h1>Lien de confirmation invalide</h1>
              <p>Ce lien a déjà été utilisé ou n'est plus valable</p>
            </div>
          </div>
        </section>

        <section class="ml-content container">
          <div class="ml-box text-center">
            <p>
              Ce lien de confirmation n'est plus valable — soit il a déjà
              été utilisé, soit il est incorrect. Si vous n'arrivez pas à
              activer votre compte, contactez-nous.
            </p>
            <a href="/contact" class="btn btn-primary">Nous contacter →</a>
          </div>
        </section>

      </div>

    </t>
  </template>

</odoo>
