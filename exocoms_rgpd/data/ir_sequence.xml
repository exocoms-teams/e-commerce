<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_rgpd_treatment" model="ir.sequence">
            <field name="name">RGPD - Traitement</field>
            <field name="code">exocoms.rgpd.treatment</field>
            <field name="prefix">TRT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_rgpd_request" model="ir.sequence">
            <field name="name">RGPD - Demande de droits</field>
            <field name="code">exocoms.rgpd.request</field>
            <field name="prefix">RGPD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_rgpd_breach" model="ir.sequence">
            <field name="name">RGPD - Violation de données</field>
            <field name="code">exocoms.rgpd.breach</field>
            <field name="prefix">VIOL/%(year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
