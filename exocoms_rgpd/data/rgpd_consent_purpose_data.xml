<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="purpose_cookies_essential" model="exocoms.rgpd.consent.purpose">
            <field name="name">Cookies strictement nécessaires</field>
            <field name="code">cookies_essential</field>
            <field name="category">cookies</field>
            <field name="sequence">1</field>
            <field name="essential" eval="True"/>
            <field name="default_granted" eval="True"/>
            <field name="validity_months">0</field>
            <field name="consent_text">Ces cookies sont indispensables au fonctionnement du site (session, panier, sécurité). Ils sont exemptés de consentement.</field>
            <field name="description" type="html">
                <p>Nécessaires à la fourniture du service demandé. Ils ne peuvent pas être désactivés.</p>
            </field>
        </record>

        <record id="purpose_cookies_analytics" model="exocoms.rgpd.consent.purpose">
            <field name="name">Mesure d'audience</field>
            <field name="code">cookies_analytics</field>
            <field name="category">cookies</field>
            <field name="sequence">10</field>
            <field name="validity_months">13</field>
            <field name="consent_text">J'accepte le dépôt de cookies de mesure d'audience permettant d'analyser la fréquentation du site.</field>
            <field name="description" type="html">
                <p>Statistiques de fréquentation et d'utilisation du site. Durée de conservation recommandée par la CNIL : 13 mois.</p>
            </field>
        </record>

        <record id="purpose_cookies_marketing" model="exocoms.rgpd.consent.purpose">
            <field name="name">Cookies publicitaires et de personnalisation</field>
            <field name="code">cookies_marketing</field>
            <field name="category">cookies</field>
            <field name="sequence">20</field>
            <field name="validity_months">13</field>
            <field name="consent_text">J'accepte le dépôt de cookies publicitaires permettant de personnaliser les contenus et les annonces.</field>
        </record>

        <record id="purpose_newsletter" model="exocoms.rgpd.consent.purpose">
            <field name="name">Newsletter</field>
            <field name="code">newsletter</field>
            <field name="category">marketing</field>
            <field name="sequence">30</field>
            <field name="validity_months">36</field>
            <field name="consent_text">J'accepte de recevoir la lettre d'information par e-mail et je peux me désinscrire à tout moment.</field>
        </record>

        <record id="purpose_prospection" model="exocoms.rgpd.consent.purpose">
            <field name="name">Prospection commerciale</field>
            <field name="code">prospection</field>
            <field name="category">marketing</field>
            <field name="sequence">40</field>
            <field name="validity_months">36</field>
            <field name="consent_text">J'accepte d'être contacté par e-mail, téléphone ou SMS au sujet des offres commerciales.</field>
        </record>

        <record id="purpose_profiling" model="exocoms.rgpd.consent.purpose">
            <field name="name">Profilage et recommandations</field>
            <field name="code">profiling</field>
            <field name="category">profiling</field>
            <field name="sequence">50</field>
            <field name="validity_months">24</field>
            <field name="consent_text">J'accepte l'analyse de mon historique afin de recevoir des recommandations personnalisées.</field>
        </record>

    </data>
</odoo>
