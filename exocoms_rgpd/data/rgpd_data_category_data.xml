<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="data_cat_identity" model="exocoms.rgpd.data.category">
            <field name="name">Données d'identité</field>
            <field name="code">identity</field>
            <field name="sequence">10</field>
            <field name="description">Nom, prénom, civilité, date de naissance, photographie.</field>
        </record>

        <record id="data_cat_contact" model="exocoms.rgpd.data.category">
            <field name="name">Coordonnées</field>
            <field name="code">contact</field>
            <field name="sequence">20</field>
            <field name="description">Adresse postale, e-mail, téléphone fixe et mobile.</field>
        </record>

        <record id="data_cat_professional" model="exocoms.rgpd.data.category">
            <field name="name">Vie professionnelle</field>
            <field name="code">professional</field>
            <field name="sequence">30</field>
            <field name="description">Fonction, employeur, service, historique de carrière.</field>
        </record>

        <record id="data_cat_economic" model="exocoms.rgpd.data.category">
            <field name="name">Données économiques et financières</field>
            <field name="code">economic</field>
            <field name="sequence">40</field>
            <field name="description">Coordonnées bancaires, historique de facturation, encours, solvabilité.</field>
        </record>

        <record id="data_cat_connection" model="exocoms.rgpd.data.category">
            <field name="name">Données de connexion</field>
            <field name="code">connection</field>
            <field name="sequence">50</field>
            <field name="description">Adresse IP, journaux de connexion, identifiants techniques, cookies.</field>
        </record>

        <record id="data_cat_behavior" model="exocoms.rgpd.data.category">
            <field name="name">Données de navigation et d'usage</field>
            <field name="code">behavior</field>
            <field name="sequence">60</field>
            <field name="description">Pages consultées, historique d'achat, ouverture des e-mails, préférences.</field>
        </record>

        <record id="data_cat_contract" model="exocoms.rgpd.data.category">
            <field name="name">Données contractuelles</field>
            <field name="code">contract</field>
            <field name="sequence">70</field>
            <field name="description">Devis, commandes, contrats, interventions, tickets de support.</field>
        </record>

        <record id="data_cat_health" model="exocoms.rgpd.data.category">
            <field name="name">Données de santé</field>
            <field name="code">health</field>
            <field name="sequence">100</field>
            <field name="sensitive" eval="True"/>
            <field name="color">1</field>
            <field name="description">Article 9 du RGPD : arrêts de travail, restrictions médicales, handicap.</field>
        </record>

        <record id="data_cat_biometric" model="exocoms.rgpd.data.category">
            <field name="name">Données biométriques</field>
            <field name="code">biometric</field>
            <field name="sequence">110</field>
            <field name="sensitive" eval="True"/>
            <field name="color">1</field>
            <field name="description">Article 9 du RGPD : empreintes, reconnaissance faciale.</field>
        </record>

        <record id="data_cat_offence" model="exocoms.rgpd.data.category">
            <field name="name">Infractions et condamnations</field>
            <field name="code">offence</field>
            <field name="sequence">120</field>
            <field name="sensitive" eval="True"/>
            <field name="color">1</field>
            <field name="description">Article 10 du RGPD : traitement soumis à des conditions strictes.</field>
        </record>

        <!-- Personnes concernées -->
        <record id="subject_cat_customer" model="exocoms.rgpd.subject.category">
            <field name="name">Clients</field>
            <field name="sequence">10</field>
        </record>
        <record id="subject_cat_prospect" model="exocoms.rgpd.subject.category">
            <field name="name">Prospects</field>
            <field name="sequence">20</field>
        </record>
        <record id="subject_cat_supplier" model="exocoms.rgpd.subject.category">
            <field name="name">Fournisseurs et partenaires</field>
            <field name="sequence">30</field>
        </record>
        <record id="subject_cat_employee" model="exocoms.rgpd.subject.category">
            <field name="name">Salariés</field>
            <field name="sequence">40</field>
        </record>
        <record id="subject_cat_candidate" model="exocoms.rgpd.subject.category">
            <field name="name">Candidats</field>
            <field name="sequence">50</field>
        </record>
        <record id="subject_cat_visitor" model="exocoms.rgpd.subject.category">
            <field name="name">Visiteurs du site web</field>
            <field name="sequence">60</field>
        </record>
        <record id="subject_cat_minor" model="exocoms.rgpd.subject.category">
            <field name="name">Mineurs</field>
            <field name="sequence">70</field>
            <field name="minor" eval="True"/>
        </record>

    </data>
</odoo>
