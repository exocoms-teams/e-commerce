    <record id="action_rgpd_treatment" model="ir.actions.act_window">
        <field name="name">Registre des traitements</field>
        <field name="res_model">exocoms.rgpd.treatment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_rgpd_treatment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre premier traitement</p>
            <p>L'article 30 du RGPD impose de tenir un registre des activités de
               traitement. Chaque fiche documente la finalité, la base légale, les
               données, les destinataires et la durée de conservation.</p>
        </field>
    </record>

</odoo>
