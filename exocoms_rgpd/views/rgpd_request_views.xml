    <record id="action_rgpd_request" model="ir.actions.act_window">
        <field name="name">Demandes de droits</field>
        <field name="res_model">exocoms.rgpd.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_rgpd_request_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune demande en cours</p>
            <p>Les demandes déposées depuis le portail client ou le formulaire public
               arrivent automatiquement ici, avec le calcul du délai légal d'un mois.</p>
        </field>
    </record>

    <record id="action_rgpd_request_late" model="ir.actions.act_window">
        <field name="name">Demandes en retard</field>
        <field name="res_model">exocoms.rgpd.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_late', '=', True)]</field>
    </record>

</odoo>
