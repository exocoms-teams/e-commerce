<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Registre des traitements (art. 30) -->
    <record id="action_report_rgpd_register" model="ir.actions.report">
        <field name="name">Registre des traitements</field>
        <field name="model">exocoms.rgpd.treatment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">exocoms_rgpd.report_rgpd_register</field>
        <field name="report_file">exocoms_rgpd.report_rgpd_register</field>
        <field name="print_report_name">'Registre des traitements - %s' % (object.reference or object.name)</field>
        <field name="binding_model_id" ref="model_exocoms_rgpd_treatment"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Registre consolidé : un seul document pour l'ensemble des traitements -->
    <record id="action_report_rgpd_register_full" model="ir.actions.report">
        <field name="name">Registre consolidé (art. 30)</field>
        <field name="model">exocoms.rgpd.treatment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">exocoms_rgpd.report_rgpd_register_full</field>
        <field name="report_file">exocoms_rgpd.report_rgpd_register_full</field>
        <field name="print_report_name">'Registre des traitements'</field>
        <field name="binding_model_id" ref="model_exocoms_rgpd_treatment"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Fiche de suivi d'une demande de droits -->
    <record id="action_report_rgpd_request" model="ir.actions.report">
        <field name="name">Fiche de demande RGPD</field>
        <field name="model">exocoms.rgpd.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">exocoms_rgpd.report_rgpd_request</field>
        <field name="report_file">exocoms_rgpd.report_rgpd_request</field>
        <field name="print_report_name">'Demande RGPD - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_exocoms_rgpd_request"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Export des données personnelles à partir d'une demande -->
    <record id="action_report_rgpd_data_export" model="ir.actions.report">
        <field name="name">Export des données personnelles</field>
        <field name="model">exocoms.rgpd.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">exocoms_rgpd.report_rgpd_data_export</field>
        <field name="report_file">exocoms_rgpd.report_rgpd_data_export</field>
        <field name="print_report_name">'Donnees personnelles - %s' % (object.name)</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Export des données personnelles à partir d'un contact -->
    <record id="action_report_rgpd_partner_export" model="ir.actions.report">
        <field name="name">Données personnelles détenues</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">exocoms_rgpd.report_rgpd_partner_export</field>
        <field name="report_file">exocoms_rgpd.report_rgpd_partner_export</field>
        <field name="print_report_name">'Donnees personnelles - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

</odoo>
