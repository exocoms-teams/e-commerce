<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_purge_unconfirmed_signups" model="ir.cron">
            <field name="name">Purge des inscriptions (À la demande)</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_unconfirmed_signups()</field>
            <!-- L'intervalle par défaut importe peu car le Python va le forcer avec 'nextcall' -->
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <!-- IMPORTANT : Désactivé par défaut ! -->
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>