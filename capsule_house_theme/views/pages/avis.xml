<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Rendue par CapsuleHouseWebsite.avis_page() (controllers/main.py)
        sur la route '/avis'. Scopée à notre site via
        _scope_layout_views() (external id capsule_house_theme.avis_page).
    -->
    <template id="avis_page" name="Capsule House - Avis clients">
        <t t-call="website.layout">
            <t t-set="title">Avis clients | Capsule House</t>
            <div id="wrap" class="ch-avis-page oe_structure">
                <t t-call="capsule_house_theme.avis_hero"/>
                <t t-call="capsule_house_theme.avis_content"/>
            </div>
        </t>
    </template>
</odoo>
