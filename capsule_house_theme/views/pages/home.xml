<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Rendue par CapsuleHouseWebsite.homepage() (controllers/main.py) sur
        la route '/'. Scopée à notre site via _scope_layout_views()
        (external id capsule_house_theme.page_home).
    -->
    <template id="page_home" name="Capsule House - Accueil">
        <t t-call="website.layout">
            <t t-set="title">Capsule House — Maisons modulaires</t>
            <!--
                class="oe_structure" : marque cette zone comme un conteneur de
                blocs natif Odoo. Sans elle, le panneau "Blocks" du website
                builder ne propose pas d'insérer/réorganiser des sections ici
                par glisser-déposer. Les data-oe-* qui permettent la sauvegarde
                inline (Save natif) sont injectés automatiquement par Odoo au
                rendu (ir.qweb) pour toute vue réelle comme celle-ci — inutile
                et risqué de les écrire à la main dans le XML source.
            -->
            <div id="wrap" class="ch-home oe_structure">
                <t t-call="capsule_house_theme.partial_hero"/>
                <t t-call="capsule_house_theme.partial_featured_products"/>
            </div>
        </t>
    </template>
</odoo>
