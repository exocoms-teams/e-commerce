<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Rendue par CapsuleHouseWebsite.homepage() (controllers/main.py) sur
        la route '/'. Scopée à notre site via _scope_layout_views()
        (external id capsule_house_theme.page_home).

        CORRECTIF (v19.0.1.0.48, voir README "Blocs non éditables comme
        sur exocoms_theme") : ce template enveloppait auparavant TOUT le
        contenu (hero + produits vedettes) dans un unique
        <div id="wrap" class="oe_structure">. Deux problèmes : (1)
        website.layout pose déjà nativement un #wrap — on créait donc un
        second id="wrap" dupliqué et invalide en HTML ; (2) oe_structure
        marque toute la zone comme un conteneur de blocs éditable au sens
        du Website Builder natif, ce qui exposait le hero et les produits
        vedettes au glisser-déposer/édition inline — CE N'EST PAS ainsi
        qu'exocoms_theme (module de référence) fonctionne : son
        views/pages/home.xml (confirmé par lecture directe du code)
        t-call ses sections directement, SANS les envelopper dans
        oe_structure, et insère seulement des <div class="oe_structure
        oe_empty"> séparées et réellement vides entre les sections comme
        points d'insertion pour le Website Builder. On reproduit ici
        exactement le même principe : le hero et les produits vedettes ne
        sont plus dans un oe_structure, seuls les 2 placeholders vides
        ci-dessous le sont.
    -->
    <template id="page_home" name="Capsule House - Accueil">
        <t t-call="website.layout">
            <t t-set="title">Capsule House — Maisons modulaires</t>
            <t t-set="head">
                <!-- SEO page-spécifique (v19.0.1.0.63), voir layout.xml pour
                     le bloc global. Texte repris du sous-titre du hero. -->
                <meta name="description" content="Capsule House — Maisons modulaires design. Comparez nos modèles, configurez le vôtre et commandez en ligne. Livraison, installation et garantie 10 ans incluses."/>
                <link rel="canonical" href="https://capsule-house.fr/"/>
                <meta property="og:title" content="Capsule House — Maisons modulaires design"/>
                <meta property="og:description" content="Comparez nos modèles, configurez le vôtre et commandez en ligne. Livraison, installation et garantie 10 ans incluses."/>
                <meta property="og:url" content="https://capsule-house.fr/"/>
            </t>
            <t t-call="capsule_house_theme.partial_hero"/>
            <div class="oe_structure oe_empty" id="oe_structure_ch_home_after_hero"/>
            <!-- Section gammes (v19.0.1.0.72) — voir home_gammes.xml.
                 Le "quoi" (nos gammes de produits) avant le "pourquoi"
                 (section usages juste après).

                 CORRECTIF (v19.0.1.0.89, RÉVERTI en .91) : une tentative
                 avait mis ici un <div class="oe_structure"> englobant le
                 <t t-call="..."/> depuis CETTE vue (page_home), alors
                 que le <section> réellement édité vit dans une AUTRE vue
                 (partial_home_gammes/partial_home_usages, déjà scopée
                 séparément via SCOPED_VIEW_XML_IDS). Résultat : plus
                 aucun bloc sélectionnable du tout (ni la section, ni son
                 contenu) — l'oe_structure et le contenu qu'il est censé
                 rendre éditable doivent vivre dans LA MÊME vue, jamais
                 reliés par un t-call vers une vue tierce. L'oe_structure
                 est donc redescendu À L'INTÉRIEUR de home_gammes.xml/
                 home_usages.xml, autour de leur propre <section> racine
                 — exactement le même schéma que les pages Aide/
                 Entreprise/légales (oe_structure et <section> dans le
                 même fichier), déjà confirmé fonctionnel. -->
            <t t-call="capsule_house_theme.partial_home_gammes"/>
            <!-- Section usages (v19.0.1.0.71) — voir home_usages.xml. -->
            <t t-call="capsule_house_theme.partial_home_usages"/>
            <t t-call="capsule_house_theme.partial_featured_products"/>
            <!-- Blocs avis clients + moyens de paiement (v19.0.1.0.100)
                 — demande client explicite : "je veux ces deux blocs à
                 la fin de ma pages aceuil". Voir home_testimonials.xml
                 (jusqu'à 3 VRAIS avis publiés) et
                 home_payment_methods.xml (SEULS les payment.provider
                 réellement 'enabled') — les deux restent masqués
                 (d-none) tant qu'aucune donnée réelle n'existe, jamais
                 de contenu fabriqué (principe déjà en place partout
                 ailleurs sur ce module). -->
            <t t-call="capsule_house_theme.partial_home_testimonials"/>
            <t t-call="capsule_house_theme.partial_home_payment_methods"/>
            <div class="oe_structure oe_empty" id="oe_structure_ch_home_bottom"/>
        </t>
    </template>
</odoo>
