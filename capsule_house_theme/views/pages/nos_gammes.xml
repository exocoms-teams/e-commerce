<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Créées en v19.0.1.0.71, à la demande explicite du client — voir
        __init__.py (GAMMES_DATA) pour l'historique complet de la
        décision (Studio/Duo/Panorama deviennent des formats de la gamme
        "Capsule" plutôt que des catégories de premier niveau, 4 gammes
        supplémentaires Cabine/Dôme/Modulaire/Pliable annoncées par le
        client mais sans données réelles pour l'instant).

        Contenu STRICTEMENT informatif (demande client : "à titre
        d'information de ce qui sera disponible"), jamais un catalogue
        transactionnel : aucun bouton d'achat, aucun prix engageant.

        CORRECTIF (v19.0.1.0.73) : l'index /nos-gammes (bandeau +
        filmstrip pleine page) a été RETIRÉ — demande client explicite
        après avoir vu le fil d'ariane en production ("on doit plus
        avoir Home/Our ranges/Capsule mais plutôt Home/Capsule, la page
        Our ranges ne doit plus s'afficher"). Le filmstrip équivalent
        vit déjà sur l'accueil (voir home_gammes.xml, v19.0.1.0.72) —
        cette page index était devenue un doublon pur. La route
        `/nos-gammes` (controllers/main.py) redirige désormais vers
        l'accueil plutôt que de rendre une page. Seule reste
        page_nos_gammes_detail (route /nos-gammes/<slug>), avec un fil
        d'ariane raccourci qui va directement de l'accueil au nom de la
        gamme (plus de maillon "Nos gammes" intermédiaire).

        Rendu par CapsuleHouseWebsite.nos_gammes_detail()
        (controllers/main.py). Scopée à notre site via
        _scope_layout_views() (external id
        capsule_house_theme.page_nos_gammes_detail).
    -->
    <template id="page_nos_gammes_detail" name="Capsule House - Gamme (détail)">
        <t t-call="website.layout">
            <t t-set="title" t-esc="gamme['name'] + ' | Capsule House'"/>
            <t t-set="head">
                <meta t-attf-name="description" t-attf-content="Découvrez la gamme #{ gamme['name'] } de Capsule House — à titre informatif."/>
                <meta t-attf-property="og:title" t-attf-content="#{ gamme['name'] } | Capsule House"/>
            </t>

            <div class="ch-aide-breadcrumb" t-if="request.env.lang == 'fr_FR'">
                <a href="/">Accueil</a><span class="sep">/</span>
                <span t-esc="gamme['name']"/>
            </div>
            <div class="ch-aide-breadcrumb" t-if="request.env.lang != 'fr_FR'">
                <a href="/">Home</a><span class="sep">/</span>
                <span t-esc="gamme['name']"/>
            </div>

            <section class="ch-gammes-hero">
                <div class="container">
                    <div class="ch-gamme-detail-head">
                        <div>
                            <h1 class="ch-aide-title" t-esc="gamme['name']"/>
                            <p class="ch-aide-subtitle" t-if="request.env.lang == 'fr_FR'" t-esc="gamme['tagline_fr']"/>
                            <p class="ch-aide-subtitle" t-if="request.env.lang != 'fr_FR'" t-esc="gamme['tagline_en']"/>
                        </div>
                        <span t-if="gamme['status'] == 'disponible' and request.env.lang == 'fr_FR'" class="ch-gamme-badge ch-gamme-badge-ok">Détails disponibles</span>
                        <span t-if="gamme['status'] == 'disponible' and request.env.lang != 'fr_FR'" class="ch-gamme-badge ch-gamme-badge-ok">Details available</span>
                        <span t-if="gamme['status'] != 'disponible' and request.env.lang == 'fr_FR'" class="ch-gamme-badge ch-gamme-badge-tbd">À confirmer</span>
                        <span t-if="gamme['status'] != 'disponible' and request.env.lang != 'fr_FR'" class="ch-gamme-badge ch-gamme-badge-tbd">To be confirmed</span>
                    </div>
                </div>
            </section>

            <section class="ch-gammes-content">
                <div class="container">

                    <!-- Bandeau "valeurs indicatives" retiré en v19.0.1.0.79
                         — demande client : "pas besoin d'indiquer cela sur
                         la page". Le flag gamme['indicative'] (GAMMES_DATA,
                         __init__.py) reste en base pour usage interne/futur,
                         simplement plus affiché ici. -->

                    <div t-if="not gamme.get('performances') and not gamme['formats'] and not gamme['specs_ext'] and not gamme['specs_int'] and not gamme['equipements_fr'] and not gamme['options_fr']" class="ch-models-empty">
                        <t t-if="request.env.lang == 'fr_FR'">Les informations de cette gamme seront bientôt disponibles.</t>
                        <t t-if="request.env.lang != 'fr_FR'">Information for this range will be available soon.</t>
                    </div>

                    <div t-if="gamme.get('performances')" style="text-align:center;margin-bottom:32px;">
                        <span class="ch-models-badge" t-if="request.env.lang == 'fr_FR'">Performances</span>
                        <span class="ch-models-badge" t-if="request.env.lang != 'fr_FR'">Performance</span>
                        <h2 class="ch-gamme-perf-title" t-if="request.env.lang == 'fr_FR'">Une <t t-esc="gamme['name'].lower()"/> pensée pour le confort absolu</h2>
                        <h2 class="ch-gamme-perf-title" t-if="request.env.lang != 'fr_FR'">A <t t-esc="gamme['name'].lower()"/> designed for absolute comfort</h2>
                        <div class="ch-gamme-perf-grid">
                            <div t-foreach="gamme['performances']" t-as="perf" class="ch-gamme-perf-card">
                                <i t-attf-class="fa #{ perf['icon'] } ch-gamme-perf-icon"/>
                                <div class="ch-gamme-perf-name" t-if="request.env.lang == 'fr_FR'" t-esc="perf['title_fr']"/>
                                <div class="ch-gamme-perf-name" t-if="request.env.lang != 'fr_FR'" t-esc="perf['title_en']"/>
                                <div class="ch-gamme-perf-desc" t-if="request.env.lang == 'fr_FR'" t-esc="perf['desc_fr']"/>
                                <div class="ch-gamme-perf-desc" t-if="request.env.lang != 'fr_FR'" t-esc="perf['desc_en']"/>
                            </div>
                        </div>
                    </div>

                    <div t-if="gamme['formats']" class="ch-gamme-section">
                        <h2 class="ch-gamme-section-title" t-if="request.env.lang == 'fr_FR'">Formats</h2>
                        <h2 class="ch-gamme-section-title" t-if="request.env.lang != 'fr_FR'">Formats</h2>
                        <div class="ch-gamme-formats-grid">
                            <div t-foreach="gamme['formats']" t-as="fmt" class="ch-gamme-format-card">
                                <div class="ch-gamme-format-name" t-esc="fmt['name']"/>
                                <div class="ch-gamme-format-surface" t-if="request.env.lang == 'fr_FR'" t-esc="fmt['surface_fr']"/>
                                <div class="ch-gamme-format-surface" t-if="request.env.lang != 'fr_FR'" t-esc="fmt['surface_en']"/>
                                <div class="ch-gamme-format-note" t-if="request.env.lang == 'fr_FR'" t-esc="fmt['note_fr']"/>
                                <div class="ch-gamme-format-note" t-if="request.env.lang != 'fr_FR'" t-esc="fmt['note_en']"/>
                            </div>
                        </div>
                    </div>

                    <div t-if="gamme['specs_ext'] or gamme['specs_int']" class="ch-gamme-section">
                        <h2 class="ch-gamme-section-title" t-if="request.env.lang == 'fr_FR'">Spécifications techniques</h2>
                        <h2 class="ch-gamme-section-title" t-if="request.env.lang != 'fr_FR'">Technical specifications</h2>
                        <div class="ch-gamme-specs-grid">
                            <div t-if="gamme['specs_ext']">
                                <div class="ch-gamme-specs-col-title" t-if="request.env.lang == 'fr_FR'">Extérieur</div>
                                <div class="ch-gamme-specs-col-title" t-if="request.env.lang != 'fr_FR'">Exterior</div>
                                <table class="ch-gamme-specs-table">
                                    <tr t-foreach="gamme['specs_ext']" t-as="row">
                                        <td class="ch-gamme-specs-label" t-if="request.env.lang == 'fr_FR'" t-esc="row['label_fr']"/>
                                        <td class="ch-gamme-specs-label" t-if="request.env.lang != 'fr_FR'" t-esc="row['label_en']"/>
                                        <td class="ch-gamme-specs-value" t-if="request.env.lang == 'fr_FR'" t-esc="row['value_fr']"/>
                                        <td class="ch-gamme-specs-value" t-if="request.env.lang != 'fr_FR'" t-esc="row['value_en']"/>
                                    </tr>
                                </table>
                            </div>
                            <div t-if="gamme['specs_int']">
                                <div class="ch-gamme-specs-col-title" t-if="request.env.lang == 'fr_FR'">Intérieur</div>
                                <div class="ch-gamme-specs-col-title" t-if="request.env.lang != 'fr_FR'">Interior</div>
                                <table class="ch-gamme-specs-table">
                                    <tr t-foreach="gamme['specs_int']" t-as="row">
                                        <td class="ch-gamme-specs-label" t-if="request.env.lang == 'fr_FR'" t-esc="row['label_fr']"/>
                                        <td class="ch-gamme-specs-label" t-if="request.env.lang != 'fr_FR'" t-esc="row['label_en']"/>
                                        <td class="ch-gamme-specs-value" t-if="request.env.lang == 'fr_FR'" t-esc="row['value_fr']"/>
                                        <td class="ch-gamme-specs-value" t-if="request.env.lang != 'fr_FR'" t-esc="row['value_en']"/>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div t-if="gamme['equipements_fr']" class="ch-gamme-section">
                        <h2 class="ch-gamme-section-title" t-if="request.env.lang == 'fr_FR'">Équipements inclus</h2>
                        <h2 class="ch-gamme-section-title" t-if="request.env.lang != 'fr_FR'">Included equipment</h2>
                        <div class="ch-gamme-equip-grid" t-if="request.env.lang == 'fr_FR'">
                            <div t-foreach="gamme['equipements_fr']" t-as="item" class="ch-gamme-equip-item">
                                <i class="fa fa-check-circle"/><t t-esc="item"/>
                            </div>
                        </div>
                        <div class="ch-gamme-equip-grid" t-if="request.env.lang != 'fr_FR'">
                            <div t-foreach="gamme['equipements_en']" t-as="item" class="ch-gamme-equip-item">
                                <i class="fa fa-check-circle"/><t t-esc="item"/>
                            </div>
                        </div>
                    </div>

                    <div t-if="gamme['options_fr']" class="ch-gamme-section">
                        <h2 class="ch-gamme-section-title" t-if="request.env.lang == 'fr_FR'">Options</h2>
                        <h2 class="ch-gamme-section-title" t-if="request.env.lang != 'fr_FR'">Options</h2>
                        <div class="ch-gamme-options-row" t-if="request.env.lang == 'fr_FR'">
                            <span t-foreach="gamme['options_fr']" t-as="opt" class="ch-gamme-option-pill" t-esc="opt"/>
                        </div>
                        <div class="ch-gamme-options-row" t-if="request.env.lang != 'fr_FR'">
                            <span t-foreach="gamme['options_en']" t-as="opt" class="ch-gamme-option-pill" t-esc="opt"/>
                        </div>
                    </div>

                </div>
            </section>

            <div class="oe_structure oe_empty" id="oe_structure_nos_gammes_detail_bottom"/>
        </t>
    </template>
</odoo>
