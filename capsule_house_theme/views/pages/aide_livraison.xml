<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Rendue par CapsuleHouseWebsite.aide_livraison() (controllers/main.py)
        sur la route '/livraison'. Scopée à notre site via
        _scope_layout_views() (external id capsule_house_theme.aide_livraison_page).
        Contenu (étapes, délais, frais) repris de la maquette fournie par
        le client — à confirmer/ajuster avec lui si les vrais délais
        d'atelier diffèrent, ce n'est pas une donnée vérifiée par ce module.

        Structure alignée sur exocoms_theme en v19.0.1.0.48 (voir README
        "Blocs non éditables comme sur exocoms_theme") : plus de
        <div id="wrap" class="oe_structure"> autour du contenu réel —
        seul un placeholder réellement vide en bas de page sert de point
        d'insertion pour le Website Builder.
    -->
    <template id="aide_livraison_page" name="Capsule House - Aide - Livraison">
        <t t-call="website.layout">
            <t t-set="title" t-if="request.env.lang == 'fr_FR'">Livraison &amp; installation | Capsule House</t>
            <t t-set="title" t-if="request.env.lang != 'fr_FR'">Delivery &amp; installation | Capsule House</t>
            <t t-set="head">
                <!-- SEO page-spécifique (v19.0.1.0.63), voir layout.xml. -->
                <meta name="description" content="Livraison et installation de votre pod Capsule House : étapes, délais moyens (6 semaines en France métropolitaine) et frais de transport."/>
                <link rel="canonical" href="https://capsule-house.fr/livraison"/>
                <meta property="og:title" content="Livraison &amp; installation | Capsule House"/>
                <meta property="og:url" content="https://capsule-house.fr/livraison"/>
            </t>
            <div class="ch-aide-breadcrumb" t-if="request.env.lang == 'fr_FR'">
                <a href="/">Accueil</a>
                <span class="sep">/</span>
                <span>Aide</span>
            </div>
            <div class="ch-aide-breadcrumb" t-if="request.env.lang != 'fr_FR'">
                <a href="/">Home</a>
                <span class="sep">/</span>
                <span>Help</span>
            </div>
            <div class="ch-aide-layout">
                <t t-call="capsule_house_theme.aide_sidebar"/>
                <t t-call="capsule_house_theme.aide_livraison_section"/>
            </div>
            <div class="oe_structure oe_empty" id="oe_structure_ch_aide_livraison_bottom"/>
        </t>
    </template>
</odoo>
