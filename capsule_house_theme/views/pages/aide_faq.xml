<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Rendue par CapsuleHouseWebsite.aide_faq() sur la route '/faq'.
        Scopée à notre site via _scope_layout_views() (external id
        capsule_house_theme.aide_faq_page). Accordéon = même markup
        Bootstrap que le snippet Accordéon natif du Website Builder
        (accordion / accordion-item / accordion-button / accordion-
        collapse / accordion-body) : le JS de dépliage est déjà chargé
        globalement par Odoo, pas de JS custom nécessaire ici. Contenu
        des questions/réponses repris de la maquette fournie par le
        client — à confirmer/ajuster si les vraies conditions diffèrent
        (financement, etc.).

        Réponse "permis de construire" (chFaq1/chFaq1en), historique en
        deux temps :
        - v19.0.1.0.69 : la version d'origine affirmait "Nous vous
          accompagnons dans les démarches", un engagement de service
          que le client a d'abord dit ne pas pouvoir confirmer ("j'en
          sais rien en fait"). Remplacée par une réponse purement
          informative (seuils réels + renvoi vers la mairie du client),
          sans promesse de service.
        - v19.0.1.0.70 : le client a ensuite confirmé explicitement
          ("c'est confirmé, les formalités administratives sont gérées
          par nous et nous accompagnons complètement nos clients") —
          réponse remise à jour pour affirmer la prise en charge
          complète des démarches (montage du dossier + dépôt en
          mairie), tout en conservant les seuils réels vérifiés (moins
          de 5 m² : aucune formalité ; 5-20 m² : déclaration préalable,
          CERFA 16702 ; plus de 20 m² : permis de construire, CERFA
          16703 ; seuil à 40 m² en zone PLU si surface de plancher du
          terrain <150 m² — art. R.421-14 b du Code de l'urbanisme),
          appliqués aux tailles réelles Studio (18 m²) et Panorama
          (jusqu'à 40 m²).

        Structure alignée sur exocoms_theme en v19.0.1.0.48 (voir README
        "Blocs non éditables comme sur exocoms_theme") : plus de
        <div id="wrap" class="oe_structure"> autour du contenu réel —
        seul un placeholder réellement vide en bas de page sert de point
        d'insertion pour le Website Builder.
    -->
    <template id="aide_faq_page" name="Capsule House - Aide - FAQ">
        <t t-call="website.layout">
            <t t-set="title" t-if="request.env.lang == 'fr_FR'">Questions fréquentes | Capsule House</t>
            <t t-set="title" t-if="request.env.lang != 'fr_FR'">Frequently asked questions | Capsule House</t>
            <t t-set="head">
                <!-- SEO page-spécifique (v19.0.1.0.63), voir layout.xml. -->
                <meta name="description" content="Questions fréquentes sur les pods Capsule House : livraison, installation, financement, garantie et plus."/>
                <link rel="canonical" href="https://capsule-house.fr/faq"/>
                <meta property="og:title" content="Questions fréquentes | Capsule House"/>
                <meta property="og:url" content="https://capsule-house.fr/faq"/>
            </t>
            <div class="ch-aide-breadcrumb" t-if="request.env.lang == 'fr_FR'">
                <a href="/">Accueil</a>
                <span class="sep">/</span>
                <span>Aide</span>
            </div>
            <div class="ch-aide-breadcrumb" t-if="request.env.lang != 'fr_FR'">
                <a href="/">Home</a>
                <span class="sep">/</span>
                <span>Help</span>
            </div>
            <div class="ch-aide-layout">
                <t t-call="capsule_house_theme.aide_sidebar"/>
                <t t-call="capsule_house_theme.aide_faq_section"/>
            </div>
            <div class="oe_structure oe_empty" id="oe_structure_ch_aide_faq_bottom"/>
        </t>
    </template>
</odoo>
