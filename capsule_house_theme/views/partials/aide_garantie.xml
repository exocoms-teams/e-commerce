<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="aide_garantie_content_fr" name="Help content garantie fr">
        <div class="oe_structure" id="oe_structure_ch_aide_garantie_content_fr" t-if="request.env.lang == 'fr_FR'">
                            <section class="ch-aide-content">
                                <h1 class="ch-aide-title">Garantie constructeur</h1>
                                <p class="ch-aide-subtitle">Chaque pod Capsule House est couvert par une garantie constructeur de 10 ans.</p>
                            </section>
                            <section class="ch-aide-content">
                                <div class="ch-aide-warranty">
                                    <div class="ch-aide-warranty-number">10 ans</div>
                                    <div class="ch-aide-warranty-text">Structure, étanchéité et isolation garanties dès la réception, sans démarche supplémentaire de votre part.</div>
                                </div>
                            </section>
                            <section class="ch-aide-content">
                                <div class="ch-aide-coverage">
                                    <div class="ch-aide-coverage-col ok">
                                        <div class="ch-aide-coverage-title">
                                            <i class="fa fa-check ch-icon-small"/> Couvert</div>
                                        <ul class="ch-aide-coverage-list">
                                            <li>
                                                <i class="fa fa-check ch-icon-small"/> Structure et ossature</li>
                                            <li>
                                                <i class="fa fa-check ch-icon-small"/> Étanchéité de la toiture</li>
                                            <li>
                                                <i class="fa fa-check ch-icon-small"/> Isolation thermique</li>
                                            <li>
                                                <i class="fa fa-check ch-icon-small"/> Vitrage et joints d'origine</li>
                                        </ul>
                                    </div>
                                    <div class="ch-aide-coverage-col ko">
                                        <div class="ch-aide-coverage-title">
                                            <i class="fa fa-times ch-icon-small"/> Non couvert</div>
                                        <ul class="ch-aide-coverage-list">
                                            <li>
                                                <i class="fa fa-times ch-icon-small"/> Usure normale des finitions</li>
                                            <li>
                                                <i class="fa fa-times ch-icon-small"/> Dommages accidentels ou climatiques</li>
                                            <li>
                                                <i class="fa fa-times ch-icon-small"/> Modifications non autorisées</li>
                                        </ul>
                                    </div>
                                </div>
                            </section>
                            <section class="ch-aide-content">
                                <h2 class="ch-aide-card-title">Comment déclarer un sinistre</h2>
                                <div class="ch-aide-steps">
                                    <div class="ch-aide-steps-item">
                                        <div class="ch-aide-steps-number">1</div>
                                        <div class="ch-aide-steps-text">
                                            <strong>Contactez le SAV</strong> avec votre numéro de commande et des photos du problème.</div>
                                    </div>
                                    <div class="ch-aide-steps-item">
                                        <div class="ch-aide-steps-number">2</div>
                                        <div class="ch-aide-steps-text">
                                            <strong>Diagnostic à distance ou visite technique</strong> sous 5 jours ouvrés.</div>
                                    </div>
                                    <div class="ch-aide-steps-item">
                                        <div class="ch-aide-steps-number">3</div>
                                        <div class="ch-aide-steps-text">
                                            <strong>Intervention ou remplacement</strong> pris en charge si couvert par la garantie.</div>
                                    </div>
                                </div>
                            </section>
                        </div>
    </template>
    <template id="aide_garantie_content_en" name="Help content garantie en">
        <div class="oe_structure" id="oe_structure_ch_aide_garantie_content_en" t-if="request.env.lang != 'fr_FR'">
                            <section class="ch-aide-content">
                                <h1 class="ch-aide-title">Manufacturer warranty</h1>
                                <p class="ch-aide-subtitle">Every Capsule House pod is covered by a 10-year manufacturer warranty.</p>
                            </section>
                            <section class="ch-aide-content">
                                <div class="ch-aide-warranty">
                                    <div class="ch-aide-warranty-number">10 years</div>
                                    <div class="ch-aide-warranty-text">Structure, weatherproofing and insulation guaranteed from delivery, with no extra steps on your part.</div>
                                </div>
                            </section>
                            <section class="ch-aide-content">
                                <div class="ch-aide-coverage">
                                    <div class="ch-aide-coverage-col ok">
                                        <div class="ch-aide-coverage-title">
                                            <i class="fa fa-check ch-icon-small"/> Covered</div>
                                        <ul class="ch-aide-coverage-list">
                                            <li>
                                                <i class="fa fa-check ch-icon-small"/> Structure and frame</li>
                                            <li>
                                                <i class="fa fa-check ch-icon-small"/> Roof weatherproofing</li>
                                            <li>
                                                <i class="fa fa-check ch-icon-small"/> Thermal insulation</li>
                                            <li>
                                                <i class="fa fa-check ch-icon-small"/> Original glazing and seals</li>
                                        </ul>
                                    </div>
                                    <div class="ch-aide-coverage-col ko">
                                        <div class="ch-aide-coverage-title">
                                            <i class="fa fa-times ch-icon-small"/> Not covered</div>
                                        <ul class="ch-aide-coverage-list">
                                            <li>
                                                <i class="fa fa-times ch-icon-small"/> Normal wear of finishes</li>
                                            <li>
                                                <i class="fa fa-times ch-icon-small"/> Accidental or weather damage</li>
                                            <li>
                                                <i class="fa fa-times ch-icon-small"/> Unauthorized modifications</li>
                                        </ul>
                                    </div>
                                </div>
                            </section>
                            <section class="ch-aide-content">
                                <h2 class="ch-aide-card-title">How to file a claim</h2>
                                <div class="ch-aide-steps">
                                    <div class="ch-aide-steps-item">
                                        <div class="ch-aide-steps-number">1</div>
                                        <div class="ch-aide-steps-text">
                                            <strong>Contact support</strong> with your order number and photos of the issue.</div>
                                    </div>
                                    <div class="ch-aide-steps-item">
                                        <div class="ch-aide-steps-number">2</div>
                                        <div class="ch-aide-steps-text">
                                            <strong>Remote diagnosis or technical visit</strong> within 5 business days.</div>
                                    </div>
                                    <div class="ch-aide-steps-item">
                                        <div class="ch-aide-steps-number">3</div>
                                        <div class="ch-aide-steps-text">
                                            <strong>Repair or replacement</strong> covered if included under warranty.</div>
                                    </div>
                                </div>
                            </section>
                        </div>
    </template>
    <template id="aide_garantie_section" name="Help section garantie">
        <t t-call="capsule_house_theme.aide_garantie_content_fr"/>
        <t t-call="capsule_house_theme.aide_garantie_content_en"/>
    </template>
</odoo>
