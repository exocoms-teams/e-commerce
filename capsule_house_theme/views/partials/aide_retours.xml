<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="aide_retours_content_fr" name="Help content retours fr">
        <div class="oe_structure" id="oe_structure_ch_aide_retours_content_fr" t-if="request.env.lang == 'fr_FR'">
                            <section class="ch-aide-content">
                                <h1 class="ch-aide-title">Retours &amp; rétractation</h1>
                                <p class="ch-aide-subtitle">Nos pods sont fabriqués sur mesure : les conditions de retour diffèrent d'un achat standard.</p>
                            </section>
                            <section class="ch-aide-content">
                                <div class="ch-aide-callout ch-aide-callout-alert">
                                    <i class="fa fa-exclamation-triangle ch-icon-small ch-aide-callout-icon"/>
                                    <div>
                                        <div class="ch-aide-callout-title">Le droit de rétractation standard de 14 jours ne s'applique pas après lancement de la fabrication</div>
                                        <div class="ch-aide-callout-text">Nos pods étant personnalisés à la commande, la rétractation n'est possible que dans la fenêtre décrite ci-dessous.</div>
                                    </div>
                                </div>
                            </section>
                            <section class="ch-aide-content">
                                <div class="ch-aide-cards">
                                    <div class="ch-aide-card">
                                        <div class="ch-aide-card-title">Avant fabrication</div>
                                        <div class="ch-aide-card-text">Vous disposez de 48h après confirmation de commande pour annuler et être intégralement remboursé, avant le lancement en atelier.</div>
                                    </div>
                                    <div class="ch-aide-card">
                                        <div class="ch-aide-card-title">Après livraison</div>
                                        <div class="ch-aide-card-text">Tout défaut constaté doit être signalé sous 48h avec photos à l'appui pour ouvrir une réclamation.</div>
                                    </div>
                                    <div class="ch-aide-card">
                                        <div class="ch-aide-card-title">Procédure</div>
                                        <div class="ch-aide-card-text">Contactez le service client avec votre numéro de commande ; un conseiller revient vers vous sous 48h ouvrées.</div>
                                    </div>
                                </div>
                            </section>
                            <section class="ch-aide-content">
                                <a href="/contactus" class="ch-btn ch-btn-cta">Contacter le service client</a>
                            </section>
                        </div>
    </template>
    <template id="aide_retours_content_en" name="Help content retours en">
        <div class="oe_structure" id="oe_structure_ch_aide_retours_content_en" t-if="request.env.lang != 'fr_FR'">
                            <section class="ch-aide-content">
                                <h1 class="ch-aide-title">Returns &amp; withdrawal</h1>
                                <p class="ch-aide-subtitle">Our pods are custom-built to order: return conditions differ from a standard purchase.</p>
                            </section>
                            <section class="ch-aide-content">
                                <div class="ch-aide-callout ch-aide-callout-alert">
                                    <i class="fa fa-exclamation-triangle ch-icon-small ch-aide-callout-icon"/>
                                    <div>
                                        <div class="ch-aide-callout-title">The standard 14-day withdrawal right no longer applies once manufacturing has started</div>
                                        <div class="ch-aide-callout-text">Since our pods are custom-made to order, withdrawal is only possible within the window described below.</div>
                                    </div>
                                </div>
                            </section>
                            <section class="ch-aide-content">
                                <div class="ch-aide-cards">
                                    <div class="ch-aide-card">
                                        <div class="ch-aide-card-title">Before manufacturing</div>
                                        <div class="ch-aide-card-text">You have 48 hours after order confirmation to cancel and be fully refunded, before production begins.</div>
                                    </div>
                                    <div class="ch-aide-card">
                                        <div class="ch-aide-card-title">After delivery</div>
                                        <div class="ch-aide-card-text">Any defect found must be reported within 48 hours, with supporting photos, to open a claim.</div>
                                    </div>
                                    <div class="ch-aide-card">
                                        <div class="ch-aide-card-title">Procedure</div>
                                        <div class="ch-aide-card-text">Contact customer service with your order number; an advisor will get back to you within 48 business hours.</div>
                                    </div>
                                </div>
                            </section>
                            <section class="ch-aide-content">
                                <a href="/contactus" class="ch-btn ch-btn-cta">Contact customer service</a>
                            </section>
                        </div>
    </template>
    <template id="aide_retours_section" name="Help section retours">
        <t t-call="capsule_house_theme.aide_retours_content_fr"/>
        <t t-call="capsule_house_theme.aide_retours_content_en"/>
    </template>
</odoo>
