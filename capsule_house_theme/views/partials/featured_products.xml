<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        "Meilleures ventes" — attend `featured_products`, une liste de dicts
        déjà aplatis par CapsuleHouseWebsite._serialize_products()
        (controllers/main.py), elle-même construite à partir de produits
        filtrés sur request.website.id (voir homepage()).

        Les étoiles ne s'affichent que si rating_count > 0 (vraie donnée,
        pas de note fabriquée). Le prix barré ne s'affiche que si un vrai
        compare_list_price existe et dépasse le prix courant. Scopé à
        notre site via _scope_layout_views() (external id
        capsule_house_theme.partial_featured_products).

        Traduction FR/EN (v19.0.1.0.37) : oubliée en v.36 (retour
        client explicite : "la partie meilleures ventes n'est pas non
        plus traduite") — même convention t-if/t-else sur
        request.env.lang que hero.xml/footer.xml. Les données produit
        elles-mêmes (item['name'], item['category_name']) ne sont pas
        traduites, comme partout ailleurs dans ce module.

        CARROUSEL : les cartes défilent en continu dans une piste en
        boucle ; les flèches déclenchent séparément un déplacement animé
        de quatre cartes. Jusqu'à 16 produits sont affichés. L'animation
        automatique respecte la préférence de réduction des animations.
        Le comportement est piloté dans main.js, indépendamment de
        Bootstrap.

        CORRECTIF LIENS CASSÉS (v19.0.1.0.105) : retour client — "les
        produit sur mon carrousel ne me mène nul par". Les 4 liens de
        chaque carte utilisaient t-attf-href="/shop/#{ item['url'] }" —
        or item['url'] (= product.website_url, voir
        _serialize_products() dans controllers/main.py) contient DÉJÀ
        le chemin complet ("/shop/..."), c'est un champ Odoo natif déjà
        préfixé. Le "/shop/" ajouté ici en dur préfixait donc une
        DEUXIÈME fois, produisant un lien cassé du type
        "/shop//shop/nom-du-produit-1" (404). Comparaison avec
        controllers/main.py (hero_data(), 'url': item['url']) qui
        utilisait déjà item['url'] SANS le re-préfixer, correctement —
        seule cette section (Meilleures ventes) avait le bug. Fix :
        t-att-href="item['url']" directement sur les 4 liens (image,
        nom, bouton "+" FR/EN), sans "/shop/" en dur.
    -->
    <template id="partial_featured_products" name="Capsule House - Meilleures ventes">
        <section class="ch-bestsellers" aria-labelledby="ch-bestsellers-title">
            <div class="container">
                <div class="ch-bestsellers-head" t-if="request.env.lang == 'fr_FR'">
                    <h2 id="ch-bestsellers-title" class="ch-section-title">Meilleures ventes</h2>
                    <a href="/shop" class="ch-btn ch-btn-cta">Voir tous les modèles →</a>
                </div>
                <div class="ch-bestsellers-head" t-if="request.env.lang != 'fr_FR'">
                    <h2 id="ch-bestsellers-title" class="ch-section-title">Best sellers</h2>
                    <a href="/shop" class="ch-btn ch-btn-cta">See all models →</a>
                </div>

                <t t-if="featured_products">
                    <div class="ch-bestsellers-carousel-wrap">
                        <div id="ch_bestsellers_carousel" class="ch-bestsellers-carousel"
                             role="group" aria-roledescription="carousel"
                             t-att-aria-label="'Meilleures ventes' if request.env.lang == 'fr_FR' else 'Best sellers'">
                            <div class="ch-bestsellers-viewport">
                                <div class="ch-bestsellers-track">
                                    <t t-foreach="featured_products" t-as="item">
                                        <div class="ch-bestsellers-slide" role="group" aria-roledescription="slide"
                                             t-att-aria-label="('Produit %s sur %s' if request.env.lang == 'fr_FR' else 'Product %s of %s') % (item_index + 1, len(featured_products))">
                                                <div class="ch-product-card">
                                                    <a t-att-href="item['url']" class="ch-product-card-img">
                                                        <img t-attf-src="/web/image/product.template/#{ item['id'] }/image_512"
                                                             t-att-alt="item['name']"
                                                             loading="lazy" decoding="async"/>
                                                        <!-- Image juste pour le developpement et non en production -->
                                                        <!-- <img src="capsule_house_theme/static/src/img/heroapplication.jpg" alt="Product" name="image_1920"/>   -->
                                                    </a>
                                                    <div class="ch-product-card-body">
                                                        <a t-att-href="item['url']" class="ch-product-card-name" t-esc="item['name']"/>
                                                        <span class="ch-product-card-spec" t-if="item['category_name']" t-esc="item['category_name']"/>
                                                        <div class="ch-product-card-rating" t-if="item['rating_count']">
                                                            <i class="fa fa-star"/>
                                                            <span t-esc="'(%s)' % item['rating_count']"/>
                                                        </div>
                                                        <div class="ch-product-card-price-row">
                                                            <span class="ch-product-card-price"
                                                                  t-esc="item['price']"
                                                                  t-options="{'widget': 'monetary', 'display_currency': item['currency']}"/>
                                                            <span class="ch-product-card-compare-price" t-if="item['has_discount']"
                                                                  t-esc="item['compare_price']"
                                                                  t-options="{'widget': 'monetary', 'display_currency': item['currency']}"/>
                                                        </div>
                                                    </div>
                                                    <t t-if="request.env.lang == 'fr_FR'">
                                                        <a t-att-href="item['url']" class="ch-product-card-add"
                                                           t-att-aria-label="'Voir le modèle %s' % item['name']">
                                                            <i class="fa fa-plus" aria-hidden="true"/>
                                                        </a>
                                                    </t>
                                                    <t t-else="">
                                                        <a t-att-href="item['url']" class="ch-product-card-add"
                                                           t-att-aria-label="'View model %s' % item['name']">
                                                            <i class="fa fa-plus" aria-hidden="true"/>
                                                        </a>
                                                    </t>
                                                </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            <t t-if="len(featured_products) > 4">
                                <button class="ch-bestsellers-arrow ch-bestsellers-arrow-prev" type="button"
                                        data-ch-slide="prev"
                                        t-att-aria-label="'Produits précédents' if request.env.lang == 'fr_FR' else 'Previous products'">
                                    <i class="fa fa-chevron-left" aria-hidden="true"/>
                                </button>
                                <button class="ch-bestsellers-arrow ch-bestsellers-arrow-next" type="button"
                                        data-ch-slide="next"
                                        t-att-aria-label="'Produits suivants' if request.env.lang == 'fr_FR' else 'Next products'">
                                    <i class="fa fa-chevron-right" aria-hidden="true"/>
                                </button>
                            </t>
                        </div>
                    </div>
                </t>
                <p t-else="" class="ch-featured-empty">
                    <t t-if="request.env.lang == 'fr_FR'">Les modules Capsule House arrivent très bientôt.</t>
                    <t t-else="">Capsule House models are coming very soon.</t>
                </p>
            </div>
        </section>
    </template>
</odoo>
