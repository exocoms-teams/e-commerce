<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Moyens de paiement affichés comme options proposées, sans dépendre
         de l'activation des fournisseurs dans Odoo. -->

    <template id="partial_home_payment_methods_fr" name="Capsule House - Accueil : moyens de paiement FR">
        <section class="ch-payment-section" data-snippet="s_ch_payment_methods" data-name="Capsule House Paiements">
            <div class="container">
                <div class="ch-payment-inner">
                    <span class="ch-payment-label oe_editable"><i class="fa fa-lock ch-icon-small"/> Paiements sécurisés</span>
                    <div class="ch-payment-badges" data-ch-payment-badges="1">
                        <span class="ch-payment-badge"><i class="fa fa-money ch-icon-small"/><span>En espèces</span></span>
                        <span class="ch-payment-badge"><i class="fa fa-exchange ch-icon-small"/><span>Par virement</span></span>
                        <span class="ch-payment-badge"><i class="fa fa-credit-card ch-icon-small"/><span>Par carte bancaire</span></span>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="partial_home_payment_methods_en" name="Capsule House - Accueil : moyens de paiement EN">
        <section class="ch-payment-section" data-snippet="s_ch_payment_methods" data-name="Capsule House Payment Methods">
            <div class="container">
                <div class="ch-payment-inner">
                    <span class="ch-payment-label oe_editable"><i class="fa fa-lock ch-icon-small"/> Secure payments</span>
                    <div class="ch-payment-badges" data-ch-payment-badges="1">
                        <span class="ch-payment-badge"><i class="fa fa-money ch-icon-small"/><span>Cash</span></span>
                        <span class="ch-payment-badge"><i class="fa fa-exchange ch-icon-small"/><span>Bank transfer</span></span>
                        <span class="ch-payment-badge"><i class="fa fa-credit-card ch-icon-small"/><span>Bank card</span></span>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="partial_home_payment_methods" name="Capsule House - Accueil : moyens de paiement">
        <t t-if="request.env.lang == 'fr_FR'" t-call="capsule_house_theme.partial_home_payment_methods_fr"/>
        <t t-if="request.env.lang != 'fr_FR'" t-call="capsule_house_theme.partial_home_payment_methods_en"/>
    </template>
</odoo>
