<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Hero de la page /avis. Contrairement à exocoms_theme (qui utilise
        une photo de fond, static/src/img/heroavis.jpg), on n'a pas de
        photo réelle pour ce site : plutôt que d'en fabriquer une ou de
        réutiliser celle d'exocoms (pas la nôtre), on reprend le même
        dégradé doux que le reste du thème (variables ch-bg-soft /
        ch-tan-2), cohérent avec le hero de l'accueil.

        Traduction FR/EN (v19.0.1.0.36) : même schéma que
        exocoms_theme (avis_hero_fr / avis_hero_en, deux templates
        complets + un aiguilleur qui choisit selon request.env.lang),
        plutôt que des t-if/t-else inline comme sur hero.xml/footer.xml
        — plus lisible ici vu que tout le bloc change de langue.

        Tous scopés à notre site via _scope_layout_views() (external
        ids capsule_house_theme.avis_hero / avis_hero_fr / avis_hero_en).

        Édition native comme sur le hero d'accueil (v19.0.1.0.52, voir
        README "Blocs non éditables comme sur exocoms_theme") : le vrai
        avis_hero.xml d'exocoms porte data-snippet + data-name +
        o_colored_level sur la <section>, oe_editable sur l'eyebrow, le
        titre, le sous-titre et le bouton "Écrire un avis", et un
        placeholder interne <div class="oe_structure oe_empty"
        id="oe_structure_avis_hero_extra"/> juste avant la fermeture de
        la <section> — ce module n'avait jusqu'ici copié ni l'un ni
        l'autre, contrairement au hero d'accueil (déjà corrigé en
        19.0.1.0.49/50/51). Reproduit ici à l'identique.

        CAUSE TROUVÉE (v19.0.1.0.56, voir hero.xml pour l'analyse
        complète via comparaison DOM en direct) : ajout de
        `oe_img_bg o_bg_img_center o_bg_img_origin_border_box` sur la
        <section>, classes qui déclenchent l'ajout automatique par
        Odoo de `data-oe-model`/`data-oe-id`/`data-oe-xpath` +
        `o_editable` DIRECTEMENT sur la section (pas seulement ses
        enfants oe_editable). `o_colored_level` seul était
        insuffisant. Aucune image de fond définie en style inline :
        rien ne change visuellement, le dégradé CSS existant
        (.ch-avis-hero dans avis.css) reste inchangé.
    -->
    <template id="avis_hero_fr" name="Capsule House - Avis Hero FR">
        <section class="ch-avis-hero o_colored_level oe_img_bg o_bg_img_center o_bg_img_origin_border_box" data-snippet="s_ch_avis_hero" data-name="Capsule House Avis Hero">
            <div class="container ch-avis-hero-inner text-center">
                <div class="ch-avis-hero-eyebrow oe_editable">
                    <span class="ch-avis-hero-stars">
                        <i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/>
                    </span>
                    Avis clients vérifiés
                </div>

                <h1 class="ch-avis-hero-title oe_editable">
                    Ce que disent<br/><span class="ch-hero-title-accent">nos clients</span>
                </h1>

                <p class="ch-avis-hero-sub oe_editable">
                    Partagez votre expérience avec Capsule House et aidez
                    d'autres futurs propriétaires à faire leur choix.
                </p>

                <a href="#avis-form" class="ch-btn ch-btn-black ch-avis-hero-btn oe_editable">
                    <i class="fa fa-pencil"/> Écrire un avis
                </a>
            </div>

            <div class="oe_structure oe_empty" id="oe_structure_ch_avis_hero_extra"/>
        </section>
    </template>

    <template id="avis_hero_en" name="Capsule House - Avis Hero EN">
        <section class="ch-avis-hero o_colored_level oe_img_bg o_bg_img_center o_bg_img_origin_border_box" data-snippet="s_ch_avis_hero" data-name="Capsule House Avis Hero">
            <div class="container ch-avis-hero-inner text-center">
                <div class="ch-avis-hero-eyebrow oe_editable">
                    <span class="ch-avis-hero-stars">
                        <i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/>
                    </span>
                    Verified customer reviews
                </div>

                <h1 class="ch-avis-hero-title oe_editable">
                    What our<br/><span class="ch-hero-title-accent">customers say</span>
                </h1>

                <p class="ch-avis-hero-sub oe_editable">
                    Share your experience with Capsule House and help other
                    future owners make their choice.
                </p>

                <a href="#avis-form" class="ch-btn ch-btn-black ch-avis-hero-btn oe_editable">
                    <i class="fa fa-pencil"/> Write a review
                </a>
            </div>

            <div class="oe_structure oe_empty" id="oe_structure_ch_avis_hero_extra"/>
        </section>
    </template>

    <!-- Aiguilleur — choisit quel template complet appeler selon la langue -->
    <template id="avis_hero" name="Capsule House - Avis Hero">
        <t t-if="request.env.lang == 'fr_FR'" t-call="capsule_house_theme.avis_hero_fr"/>
        <t t-if="request.env.lang != 'fr_FR'" t-call="capsule_house_theme.avis_hero_en"/>
    </template>
</odoo>
