<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Contenu de la page /avis : stats calculées, filtres, grille
        d'avis publiés, formulaire de dépôt. `avis_list` / `stats` /
        `sent` sont fournis par CapsuleHouseWebsite.avis_page()
        (controllers/main.py) — jamais de chiffre fabriqué ici : si
        `stats` est False (aucun avis publié), on affiche "Aucun avis
        pour le moment" plutôt qu'un chiffre inventé.

        Traduction FR/EN (v19.0.1.0.36) : contrairement à avis_hero.xml
        (dupliqué en 2 templates complets), ici on garde UN SEUL
        template avec les boucles dynamiques (stats/avis_list)
        partagées, et seuls les libellés statiques autour sont
        dupliqués en t-if/t-else sur request.env.lang — dupliquer les
        boucles elles-mêmes serait source d'erreurs (deux endroits à
        maintenir pour la même logique).

        Scopée à notre site via _scope_layout_views() (external id
        capsule_house_theme.avis_content).
    -->
    <template id="avis_content" name="Capsule House - Avis Content">
        <div class="ch-avis-content">

            <!-- STATS -->
            <div class="ch-avis-stats-section">
                <div class="container ch-avis-stats-inner">
                    <div class="ch-avis-score-block">
                        <t t-if="stats">
                            <div class="ch-avis-score-big"><t t-out="stats['avg']"/></div>
                            <div class="ch-avis-score-stars-big">
                                <t t-foreach="range(int(stats['avg']))" t-as="s">
                                    <i class="fa fa-star"/>
                                </t>
                                <t t-if="stats['avg'] % 1 >= 0.5">
                                    <i class="fa fa-star-half-o"/>
                                </t>
                            </div>
                            <div class="ch-avis-score-total">
                                <t t-if="request.env.lang == 'fr_FR'"><t t-out="stats['total']"/> avis vérifiés</t>
                                <t t-else=""><t t-out="stats['total']"/> verified reviews</t>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="ch-avis-score-big">—</div>
                            <div class="ch-avis-score-total">
                                <t t-if="request.env.lang == 'fr_FR'">Aucun avis pour le moment</t>
                                <t t-else="">No reviews yet</t>
                            </div>
                        </t>
                    </div>
                    <div class="ch-avis-bars-block">
                        <t t-foreach="[5,4,3,2,1]" t-as="star">
                            <div class="ch-avis-bar-row">
                                <div class="ch-avis-bar-label"><t t-out="star"/> <i class="fa fa-star"/></div>
                                <div class="ch-avis-bar-track">
                                    <div t-if="stats" class="ch-avis-bar-fill ch-avis-bar-anim"
                                         t-att-data-width="str(stats['dist'][star])" style="width:0%"/>
                                    <div t-else="" class="ch-avis-bar-fill" style="width:0%"/>
                                </div>
                                <div class="ch-avis-bar-pct">
                                    <t t-if="stats" t-out="stats['dist'][star]"/><t t-else="">0</t>%
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- FILTRES -->
            <div class="ch-avis-filters">
                <div class="container ch-avis-filters-inner">
                    <t t-if="request.env.lang == 'fr_FR'">
                        <span class="ch-avis-filter-label">Filtrer :</span>
                        <button class="ch-avis-filter-btn active" data-filter="all">Tous les avis</button>
                        <button class="ch-avis-filter-btn" data-filter="5"><i class="fa fa-star"/> 5 étoiles</button>
                        <button class="ch-avis-filter-btn" data-filter="4"><i class="fa fa-star"/> 4 étoiles</button>
                        <button class="ch-avis-filter-btn" data-filter="3"><i class="fa fa-star"/> 3 étoiles</button>
                        <button class="ch-avis-filter-btn" data-filter="2"><i class="fa fa-star"/> 2 étoiles</button>
                        <button class="ch-avis-filter-btn" data-filter="1"><i class="fa fa-star"/> 1 étoile</button>
                    </t>
                    <t t-else="">
                        <span class="ch-avis-filter-label">Filter:</span>
                        <button class="ch-avis-filter-btn active" data-filter="all">All reviews</button>
                        <button class="ch-avis-filter-btn" data-filter="5"><i class="fa fa-star"/> 5 stars</button>
                        <button class="ch-avis-filter-btn" data-filter="4"><i class="fa fa-star"/> 4 stars</button>
                        <button class="ch-avis-filter-btn" data-filter="3"><i class="fa fa-star"/> 3 stars</button>
                        <button class="ch-avis-filter-btn" data-filter="2"><i class="fa fa-star"/> 2 stars</button>
                        <button class="ch-avis-filter-btn" data-filter="1"><i class="fa fa-star"/> 1 star</button>
                    </t>
                </div>
            </div>

            <!-- GRILLE -->
            <div class="ch-avis-body">
                <div class="container ch-avis-grid" id="avis-grid">
                    <t t-if="not avis_list">
                        <p class="ch-avis-empty" t-if="request.env.lang == 'fr_FR'">
                            Aucun avis publié pour le moment. Soyez le premier à
                            partager votre expérience avec Capsule House !
                        </p>
                        <p class="ch-avis-empty" t-if="request.env.lang != 'fr_FR'">
                            No reviews published yet. Be the first to share your
                            experience with Capsule House!
                        </p>
                    </t>
                    <t t-foreach="avis_list" t-as="avis">
                        <div t-attf-class="ch-avis-card #{'featured' if avis.rating == 5 else ''}"
                             t-att-data-rating="avis.rating">
                            <div class="ch-avis-card-head">
                                <div class="ch-avis-avatar"><t t-out="avis.name[0].upper()"/></div>
                                <div>
                                    <div class="ch-avis-name"><t t-out="avis.name"/></div>
                                    <div class="ch-avis-date"><t t-out="avis.date"/></div>
                                </div>
                            </div>
                            <div class="ch-avis-stars">
                                <t t-foreach="range(avis.rating)" t-as="s"><i class="fa fa-star"/></t>
                                <t t-foreach="range(5 - avis.rating)" t-as="s"><i class="fa fa-star-o"/></t>
                            </div>
                            <p class="ch-avis-text"><t t-out="avis.comment"/></p>
                            <div class="ch-avis-card-footer">
                                <t t-if="avis.product">
                                    <div class="ch-avis-product-tag"><i class="fa fa-tag"/> <t t-out="avis.product"/></div>
                                </t>
                                <div class="ch-avis-verified" t-if="request.env.lang == 'fr_FR'"><i class="fa fa-check-circle"/> Achat vérifié</div>
                                <div class="ch-avis-verified" t-if="request.env.lang != 'fr_FR'"><i class="fa fa-check-circle"/> Verified purchase</div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- FORMULAIRE -->
            <div class="ch-avis-form-section" id="avis-form">
                <div class="container ch-avis-form-inner">
                    <t t-if="request.env.lang == 'fr_FR'">
                        <div class="ch-avis-form-header">
                            <div class="ch-avis-section-eyebrow">Votre avis compte</div>
                            <h2 class="ch-avis-form-title">Partagez votre expérience</h2>
                            <p class="ch-avis-form-sub">Votre retour aide les autres futurs propriétaires à faire le bon choix.</p>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="ch-avis-form-header">
                            <div class="ch-avis-section-eyebrow">Your review matters</div>
                            <h2 class="ch-avis-form-title">Share your experience</h2>
                            <p class="ch-avis-form-sub">Your feedback helps other future owners make the right choice.</p>
                        </div>
                    </t>
                    <div class="ch-avis-form-card">
                        <t t-if="sent">
                            <t t-if="request.env.lang == 'fr_FR'">
                                <div class="ch-avis-success-msg">
                                    <div class="ch-avis-success-icon"><i class="fa fa-check"/></div>
                                    <div class="ch-avis-success-title">Merci pour votre avis !</div>
                                    <p class="ch-avis-success-text">Votre commentaire est en attente de validation<br/>et sera publié prochainement.</p>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="ch-avis-success-msg">
                                    <div class="ch-avis-success-icon"><i class="fa fa-check"/></div>
                                    <div class="ch-avis-success-title">Thank you for your review!</div>
                                    <p class="ch-avis-success-text">Your comment is awaiting approval<br/>and will be published shortly.</p>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                        <form action="/avis/submit" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <t t-if="request.env.lang == 'fr_FR'">
                                <div class="ch-avis-star-picker-wrap">
                                    <label class="ch-avis-star-picker-label">Votre note <span class="ch-avis-req">*</span></label>
                                    <div class="ch-avis-star-picker" id="avis-star-picker">
                                        <button type="button" class="ch-avis-star-btn" data-val="1">&#xf005;</button>
                                        <button type="button" class="ch-avis-star-btn" data-val="2">&#xf005;</button>
                                        <button type="button" class="ch-avis-star-btn" data-val="3">&#xf005;</button>
                                        <button type="button" class="ch-avis-star-btn" data-val="4">&#xf005;</button>
                                        <button type="button" class="ch-avis-star-btn" data-val="5">&#xf005;</button>
                                    </div>
                                    <div class="ch-avis-star-hint" id="avis-star-hint">Cliquez pour noter</div>
                                    <input type="hidden" name="rating" id="avis-rating-input" value="5" required="required"/>
                                </div>
                                <div class="ch-avis-form-row">
                                    <div class="ch-avis-form-group">
                                        <label class="ch-avis-form-label" for="av_nom">Nom<span class="ch-avis-req"> *</span></label>
                                        <input class="ch-avis-input" type="text" name="name" id="av_nom" required="required" placeholder="Votre nom"/>
                                    </div>
                                    <div class="ch-avis-form-group">
                                        <label class="ch-avis-form-label" for="av_product">Modèle acheté</label>
                                        <input class="ch-avis-input" type="text" name="product" id="av_product" placeholder="Ex : Pod Studio 18 m²"/>
                                    </div>
                                </div>
                                <div class="ch-avis-form-group">
                                    <label class="ch-avis-form-label" for="av_comment">Votre commentaire<span class="ch-avis-req"> *</span></label>
                                    <textarea class="ch-avis-textarea" name="comment" id="av_comment" required="required" placeholder="Décrivez votre expérience avec ce pod ou notre service..." rows="5"/>
                                </div>
                                <button type="submit" class="ch-btn ch-btn-black ch-avis-submit">
                                    <i class="fa fa-paper-plane"/> Publier mon avis
                                </button>
                            </t>
                            <t t-else="">
                                <div class="ch-avis-star-picker-wrap">
                                    <label class="ch-avis-star-picker-label">Your rating <span class="ch-avis-req">*</span></label>
                                    <div class="ch-avis-star-picker" id="avis-star-picker">
                                        <button type="button" class="ch-avis-star-btn" data-val="1">&#xf005;</button>
                                        <button type="button" class="ch-avis-star-btn" data-val="2">&#xf005;</button>
                                        <button type="button" class="ch-avis-star-btn" data-val="3">&#xf005;</button>
                                        <button type="button" class="ch-avis-star-btn" data-val="4">&#xf005;</button>
                                        <button type="button" class="ch-avis-star-btn" data-val="5">&#xf005;</button>
                                    </div>
                                    <div class="ch-avis-star-hint" id="avis-star-hint">Click to rate</div>
                                    <input type="hidden" name="rating" id="avis-rating-input" value="5" required="required"/>
                                </div>
                                <div class="ch-avis-form-row">
                                    <div class="ch-avis-form-group">
                                        <label class="ch-avis-form-label" for="av_nom">Name<span class="ch-avis-req"> *</span></label>
                                        <input class="ch-avis-input" type="text" name="name" id="av_nom" required="required" placeholder="Your name"/>
                                    </div>
                                    <div class="ch-avis-form-group">
                                        <label class="ch-avis-form-label" for="av_product">Model purchased</label>
                                        <input class="ch-avis-input" type="text" name="product" id="av_product" placeholder="E.g.: Pod Studio 18 sqm"/>
                                    </div>
                                </div>
                                <div class="ch-avis-form-group">
                                    <label class="ch-avis-form-label" for="av_comment">Your comment<span class="ch-avis-req"> *</span></label>
                                    <textarea class="ch-avis-textarea" name="comment" id="av_comment" required="required" placeholder="Describe your experience with this pod or our service..." rows="5"/>
                                </div>
                                <button type="submit" class="ch-btn ch-btn-black ch-avis-submit">
                                    <i class="fa fa-paper-plane"/> Publish my review
                                </button>
                            </t>
                        </form>
                        </t>
                    </div>
                </div>
            </div>

        </div>

        <!-- SCRIPTS : mêmes interactions que exocoms_theme (barres animées
             au scroll, filtres par note, sélecteur d'étoiles cliquable),
             adaptées à nos classes .ch-avis-*. Les indices FR/EN de
             notation reprennent la même détection JS que exocoms_theme
             (document.documentElement.lang), pas de QWeb ici : léger,
             et cohérent avec l'attribut lang que website.layout pose
             déjà nativement sur <html>. -->
        <script>
        (function () {
            var bars = document.querySelectorAll('.ch-avis-bar-fill.ch-avis-bar-anim');
            if (bars.length) {
                var obs = new IntersectionObserver(function (entries) {
                    entries.forEach(function (e) {
                        if (!e.isIntersecting) return;
                        obs.unobserve(e.target);
                        var w = e.target.dataset.width || '0';
                        setTimeout(function () { e.target.style.width = w + '%'; }, 100);
                    });
                }, { threshold: 0.2 });
                bars.forEach(function (b) { obs.observe(b); });
            }

            var filterBtns = document.querySelectorAll('.ch-avis-filter-btn');
            var cards = document.querySelectorAll('.ch-avis-card');
            filterBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    filterBtns.forEach(function (b) { b.classList.remove('active'); });
                    this.classList.add('active');
                    var f = this.dataset.filter;
                    cards.forEach(function (c) {
                        c.style.display = (f === 'all' || c.dataset.rating === f) ? '' : 'none';
                    });
                });
            });

            var isFr = (document.documentElement.lang || '').toLowerCase().indexOf('fr') === 0;
            var hints = isFr
                ? ['', 'Mauvais', 'Passable', 'Bien', 'Très bien', 'Excellent !']
                : ['', 'Poor', 'Fair', 'Good', 'Very good', 'Excellent!'];
            var starBtns = document.querySelectorAll('.ch-avis-star-btn');
            var hintEl = document.getElementById('avis-star-hint');
            var ratingInput = document.getElementById('avis-rating-input');
            var currentRating = 0;
            function setStars(n) {
                starBtns.forEach(function (b) { b.classList.toggle('active', +b.dataset.val &lt;= n); });
                if (hintEl) hintEl.textContent = n > 0 ? hints[n] : (isFr ? 'Cliquez pour noter' : 'Click to rate');
                if (ratingInput) ratingInput.value = n || '';
                currentRating = n;
            }
            starBtns.forEach(function (btn) {
                btn.addEventListener('mouseenter', function () { setStars(+this.dataset.val); });
                btn.addEventListener('click', function () { currentRating = +this.dataset.val; setStars(currentRating); });
            });
            var picker = document.getElementById('avis-star-picker');
            if (picker) picker.addEventListener('mouseleave', function () { setStars(currentRating); });

            document.querySelectorAll('a[href="#avis-form"]').forEach(function (a) {
                a.addEventListener('click', function (e) {
                    e.preventDefault();
                    var el = document.getElementById('avis-form');
                    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            });
        })();
        </script>
    </template>
</odoo>
