                                <span class="ch-gamme-card-tagline">Foldable structure — formats to be defined</span>
                                <span class="ch-gamme-card-cta">View range <i class="fa fa-arrow-right"/></span>
                            </a>
                        </section>

                    </div>
                </div>
            </div>

        </div>

    </template>
</odoo>
