<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ============================================================ -->
        <!-- 1. CATÉGORIES DE PRODUITS (product.category)                 -->
        <!-- ============================================================ -->
        <record id="cat_studio" model="product.category">
            <field name="name">Studio</field>
        </record>
        <record id="cat_duo" model="product.category">
            <field name="name">Duo</field>
        </record>
        <record id="cat_panorama" model="product.category">
            <field name="name">Panorama</field>
        </record>
        <record id="cat_accessoires" model="product.category">
            <field name="name">Accessoires</field>
        </record>
        
        <!-- ============================================================ -->
        <!-- 2. ATTRIBUTS DE FILTRES BOUTIQUE (product.attribute)        -->
        <!-- ============================================================ -->
        <record id="attr_surface" model="product.attribute">
            <field name="name">Surface (m²)</field>
            <field name="create_variant">no_variant</field>
        </record>
        <record id="attr_delais" model="product.attribute">
            <field name="name">Delais (jours)</field>
            <field name="create_variant">no_variant</field>
        </record>
        <record id="attr_materiaux" model="product.attribute">
            <field name="name">Materiaux</field>
            <field name="create_variant">no_variant</field>
        </record>
        <record id="attr_usage" model="product.attribute">
            <field name="name">Usage</field>
            <field name="create_variant">no_variant</field>
        </record>
        <record id="attr_garantie" model="product.attribute">
            <field name="name">Garantie</field>
            <field name="create_variant">no_variant</field>
        </record>
        <record id="attr_isolation" model="product.attribute">
            <field name="name">Niveau d'isolation</field>
            <field name="create_variant">no_variant</field>
        </record>
        
        <!-- ============================================================ -->
        <!-- 3. VALEURS DES ATTRIBUTS (product.attribute.value)          -->
        <!-- ============================================================ -->
        <!-- Surface -->
        <record id="val_surface_15_20" model="product.attribute.value">
            <field name="name">15-20 m²</field>
            <field name="attribute_id" ref="attr_surface"/>
        </record>
        <record id="val_surface_20_30" model="product.attribute.value">
            <field name="name">20-30 m²</field>
            <field name="attribute_id" ref="attr_surface"/>
        </record>
        <record id="val_surface_30_45" model="product.attribute.value">
            <field name="name">30-45 m²</field>
            <field name="attribute_id" ref="attr_surface"/>
        </record>
        
        <!-- Delais -->
        <record id="val_delais_1_2" model="product.attribute.value">
            <field name="name">1 ou 2 jours</field>
            <field name="attribute_id" ref="attr_delais"/>
        </record>
        <record id="val_delais_3_6" model="product.attribute.value">
            <field name="name">3 à 6 jours</field>
            <field name="attribute_id" ref="attr_delais"/>
        </record>
        <record id="val_delais_7_plus" model="product.attribute.value">
            <field name="name">7 jours ou plus</field>
            <field name="attribute_id" ref="attr_delais"/>
        </record>
        
        <!-- Materiaux -->
        <record id="val_mat_bois" model="product.attribute.value">
            <field name="name">Bois</field>
            <field name="attribute_id" ref="attr_materiaux"/>
        </record>
        <record id="val_mat_verre" model="product.attribute.value">
            <field name="name">Verre</field>
            <field name="attribute_id" ref="attr_materiaux"/>
        </record>
        <record id="val_mat_fer" model="product.attribute.value">
            <field name="name">Fer</field>
            <field name="attribute_id" ref="attr_materiaux"/>
        </record>
        
        <!-- Usage -->
        <record id="val_usage_bureau" model="product.attribute.value">
            <field name="name">Bureau</field>
            <field name="attribute_id" ref="attr_usage"/>
        </record>
        <record id="val_usage_atelier" model="product.attribute.value">
            <field name="name">Atelier</field>
            <field name="attribute_id" ref="attr_usage"/>
        </record>
        <record id="val_usage_habitation" model="product.attribute.value">
            <field name="name">Habitation</field>
            <field name="attribute_id" ref="attr_usage"/>
        </record>
        <record id="val_usage_loisir" model="product.attribute.value">
            <field name="name">Loisir</field>
            <field name="attribute_id" ref="attr_usage"/>
        </record>
        <record id="val_usage_accessoire" model="product.attribute.value">
            <field name="name">Accessoire</field>
            <field name="attribute_id" ref="attr_usage"/>
        </record>
        
        <!-- Garantie -->
        <record id="val_garantie_2ans" model="product.attribute.value">
            <field name="name">2 ans</field>
            <field name="attribute_id" ref="attr_garantie"/>
        </record>
        <record id="val_garantie_5ans" model="product.attribute.value">
            <field name="name">5 ans</field>
            <field name="attribute_id" ref="attr_garantie"/>
        </record>
        <record id="val_garantie_10ans" model="product.attribute.value">
            <field name="name">10 ans</field>
            <field name="attribute_id" ref="attr_garantie"/>
        </record>
        
        <!-- Isolation -->
        <record id="val_iso_standard" model="product.attribute.value">
            <field name="name">Standard</field>
            <field name="attribute_id" ref="attr_isolation"/>
        </record>
        <record id="val_iso_haute" model="product.attribute.value">
            <field name="name">Haute performance</field>
            <field name="attribute_id" ref="attr_isolation"/>
        </record>
        <record id="val_iso_na" model="product.attribute.value">
            <field name="name">Non applicable</field>
            <field name="attribute_id" ref="attr_isolation"/>
        </record>
    </data>
</odoo>
