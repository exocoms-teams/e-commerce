<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- ========================================== -->
        <!-- CATÉGORIES PRIVÉES (Interne / Inventaire)  -->
        <!-- ========================================== -->
        
        <!-- Catégorie Racine -->
        <record id="cat_private_capsule_root" model="product.category">
            <field name="name">Capsule Houses</field>
        </record>

        <!-- Catégories Principales -->
        <record id="cat_private_residentiel" model="product.category">
            <field name="name">Habitat Résidentiel</field>
            <field name="parent_id" ref="cat_private_capsule_root"/>
        </record>
        
        <record id="cat_private_pro" model="product.category">
            <field name="name">Espaces Professionnels</field>
            <field name="parent_id" ref="cat_private_capsule_root"/>
        </record>

        <!-- ========================================== -->
        <!-- CATÉGORIES PUBLIQUES (Site Web e-commerce) -->
        <!-- ========================================== -->
        
        <!-- Catégories Principales Web -->
        <record id="cat_public_residentiel" model="product.public.category">
            <field name="name">Capsules Résidentielles</field>
            <field name="sequence">10</field>
        </record>

        <record id="cat_public_pro" model="product.public.category">
            <field name="name">Capsules Professionnelles</field>
            <field name="sequence">20</field>
        </record>

        <!-- Sous-catégories Web : Résidentiel -->
        <record id="subcat_public_studio" model="product.public.category">
            <field name="name">Studios Compacts</field>
            <field name="parent_id" ref="cat_public_residentiel"/>
            <field name="sequence">11</field>
        </record>

        <!-- Sous-catégories Web : Professionnel -->
        <record id="subcat_public_bureau" model="product.public.category">
            <field name="name">Bureaux de Jardin</field>
            <field name="parent_id" ref="cat_public_pro"/>
            <field name="sequence">21</field>
        </record>

    </data>
</odoo>