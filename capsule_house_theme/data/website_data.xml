<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Volontairement vide de website.menu / website.page statiques.

        Sur cette base mutualisée, un website.menu (ou toute donnée scopée
        site) créé ici en XML data aurait website_id=False au moment du
        chargement — le site "Capsule House" n'existe pas encore à ce
        stade, il est créé dynamiquement par _get_website() dans
        __init__.py. Un menu avec website_id=False serait rattaché au menu
        racine générique et pourrait fuiter vers d'autres sites de la base.

        La création du site, de son company_id, de son logo et de son menu
        (Accueil, Boutique) est donc entièrement gérée par le hook Python
        (post_init_hook -> run_theme_maintenance -> _get_website /
        _setup_menus), qui pose website_id explicitement à chaque étape.
        Voir __init__.py pour le détail.
    -->
    <data noupdate="1">
        <record id="sale_order_demo" model="sale.order">
            <field name="partner_id" ref="base.partner_admin"/>
            <!-- La société de la commande doit être cohérente avec le partner -->
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="base.partner_admin" model="res.partner">
            <!-- Remplace la société par 'False' (aucune société = partagé par toutes) -->
            <field name="company_id" eval="False"/>
        </record>

        <record id="partner_client_exocoms" model="res.partner">
            <field name="name">Client Exocoms</field>
            <!-- Référence vers la société principale du système -->
            <field name="company_id" ref="base.main_company"/>
        </record>
    </data>
</odoo>
