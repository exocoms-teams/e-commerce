<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Active le paramètre système pour la gestion des variantes -->
        <record id="enable_product_attributes_parameter" model="ir.config_parameter">
            <field name="key">product.group_product_variant</field>
            <field name="value">True</field>
        </record>
        
        <!-- 2. Hérite du groupe Vendeur pour lui ajouter le droit des variantes -->
        <record id="sales_team.group_sale_salesman" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('product.group_product_variant'))]"/>
        </record>

        <record id="product.list0" model="product.pricelist">
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>