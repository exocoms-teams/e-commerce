<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Force l'activation de la gestion des attributs et variantes -->
        <record id="enable_product_attributes_parameter" model="ir.config_parameter">
            <field name="key">product.group_product_variant</field>
            <field name="value">True</field>
        </record>
        
        <!-- Active l'option dans le groupe de sécurité Ventes / Produits -->
        <record id="group_product_variant_user" model="res.groups">
            <field name="id" ref="product.group_product_variant"/>
            <!-- Ajoute automatiquement tous les utilisateurs du groupe Ventes -->
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>
    </data>
</odoo>