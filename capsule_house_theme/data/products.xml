            <field name="description_sale">Studio étendu avec espace cuisine équipé et salle d'eau premium.</field>
            <field name="attribute_line_ids" eval="[(0, 0, {
                'attribute_id': ref('attr_exterior_color'),
                'value_ids': [(6, 0, [ref('val_color_white'), ref('val_color_wood')])]
            }), (0, 0, {
                'attribute_id': ref('attr_insulation'),
                'value_ids': [(6, 0, [ref('val_insul_standard'), ref('val_insul_extreme')])]
            })]"/>
        </record>

