<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================== -->
        <!-- ARTICLES : CATÉGORIE RÉSIDENTIELLE (Sous-cat: Studios Compacts)-->
        <!-- ============================================================== -->

        <!-- Produit 1 -->
        <record id="product_capsule_luna" model="product.template">
            <field name="name">Capsule Luna - 18m²</field>
            <field name="type">consu</field>
            <field name="categ_id" ref="cat_private_residentiel"/>
            <field name="public_categ_ids" eval="[(6, 0, [ref('subcat_public_studio')])]"/>
            <field name="list_price">28500.00</field>
            <field name="is_published">True</field>
            <field name="description_sale">Un studio minimaliste parfait pour un Airbnb ou une chambre d'amis, avec baie vitrée panoramique.</field>
            <field name="attribute_line_ids" eval="[(0, 0, {
                'attribute_id': ref('attr_exterior_color'),
                'value_ids': [(6, 0, [ref('val_color_white'), ref('val_color_black')])]
            })]"/>
        </record>

        <!-- Produit 2 -->
        <record id="product_capsule_nova" model="product.template">
