<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Attribut : Couleur Extérieure -->
        <record id="attr_exterior_color" model="product.attribute">
            <field name="name">Couleur Extérieure</field>
            <field name="display_type">color</field>
        </record>

        <!-- Valeurs : Couleur Extérieure -->
        <record id="val_color_white" model="product.attribute.value">
            <field name="name">Blanc Spatial</field>
            <field name="attribute_id" ref="attr_exterior_color"/>
            <field name="html_color">#FFFFFF</field>
        </record>
        <record id="val_color_black" model="product.attribute.value">
            <field name="name">Noir Mat</field>
            <field name="attribute_id" ref="attr_exterior_color"/>
            <field name="html_color">#000000</field>
        </record>
        <record id="val_color_wood" model="product.attribute.value">
            <field name="name">Finition Bois</field>
            <field name="attribute_id" ref="attr_exterior_color"/>
            <field name="html_color">#8B5A2B</field>
        </record>

        <!-- Attribut : Niveau d'isolation -->
        <record id="attr_insulation" model="product.attribute">
            <field name="name">Niveau d'isolation</field>
            <field name="display_type">radio</field>
        </record>

        <!-- Valeurs : Niveau d'isolation -->
        <record id="val_insul_standard" model="product.attribute.value">
            <field name="name">Standard (4 Saisons)</field>
            <field name="attribute_id" ref="attr_insulation"/>
        </record>
        <record id="val_insul_extreme" model="product.attribute.value">
            <field name="name">Extrême (Grand Nord)</field>
            <field name="attribute_id" ref="attr_insulation"/>
        </record>

    </data>
</odoo>