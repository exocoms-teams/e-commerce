        <record id="product_test_michelin_crossclimate2" model="product.template">
            <field name="name">MICHELIN CROSSCLIMATE 2 185/65 R15 92 T XL</field>
            <field name="image_1920" type="base64"
                file="tire_catalog/static/src/img/demo/michelin_crossclimate_2/pneu-michelin-crossclimate-2-1.jpg" />
            <field name="purchase_ok">True</field>
