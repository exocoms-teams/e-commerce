            <field name="list_price">73</field>
            <field name="categ_id" ref="tire_catalog.tire_category_car" />
            <field name="default_code">2808328</field>
            <field name="product_tag_ids"
                eval="[(6, 0, [
                        ref('tire_catalog.tag_4_saisons'),
                        ref('tire_catalog.tag_runflat'),
                        ref('tire_catalog.tag_xl')
                    ])]" />
            <field name="is_published">True</field>
            <field name="website_sequence">10005</field>
            <field name="description_ecommerce">
                MICHELIN CrossClimate 2 offre une sécurité toutes saisons plus durable que ses
                principaux concurrents.
                Doté d’une bande de roulement assurant un contact optimal avec la route, ce pneu sûr
                résiste à l'aquaplanage. Sa distance d'arrêt est plus courte sur route mouillée,
                même
                lorsqu'il est usé.
                Conçu pour assurer votre sécurité plus longtemps avec une durée de vie plus longue,
                ce
                pneu très durable affiche une distance de freinage sur routes sèches plus courte que
                ses
                principaux concurrents.
                Le composé de sa bande de roulement, qui s'adapte aux conditions routières les plus
                variées, offre une traction exceptionnelle sur neige, pour une conduite plus
                confiante
                tout au long de l'année.
            </field>
            <field name="tire_brand">Michelin</field>
            <field name="tire_model">CrossClimate 2</field>
            <field name="tire_usage_id" ref="tire_catalog.usage_road" />
            <field name="tire_width">185</field>
            <field name="tire_height">65</field>
            <field name="tire_construction">radial</field>
            <field name="tire_rim">15</field>
            <field name="tire_tread_pattern_id"
                ref="tire_catalog.pattern_car_suv_asymmetric_directional" />
            <field name="tire_load_index">92</field>
            <field name="tire_speed_index">T</field>
            <field name="tire_specific_approval">Non</field>
            <field name="tire_extra_load">true</field>
            <field name="tire_runflat">false</field>
            <field name="tire_seal">false</field>
            <field name="tire_season">all</field>
            <field name="tire_snow_homologation">m_s_3pmsf</field>
            <field name="tire_new_or_retreaded">new</field>
            <field name="tire_sidewall_lettering">sbl</field>
            <field name="tire_characteristics"></field>
            <field name="tire_eprel">https://eprel.ec.europa.eu/qr/1954859</field>
