<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_monetique" model="ir.ui.view">
        <field name="name">product.template.form.monetique.specs</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Fiche Monétique" name="monetique_specs">
                    <group>
                        <group string="Classification">
                            <field name="monetique_category"/>
                            <field name="pci_dss_certified"/>
                            <field name="bank_certified_model"/>
                        </group>
                        <group string="Caractéristiques techniques">
                            <field name="connectivity_type"/>
                            <field name="battery_life_hours"/>
                            <field name="warranty_months"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
