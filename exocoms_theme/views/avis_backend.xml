<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Modération des avis clients déposés via /avis. -->

    <record id="view_exocoms_avis_list" model="ir.ui.view">
        <field name="name">exocoms.avis.list</field>
        <field name="model">exocoms.avis</field>
        <field name="arch" type="xml">
            <list string="Avis clients" editable="top" decoration-muted="state == 'published'">
                <field name="date"/>
                <field name="name"/>
                <field name="rating"/>
                <field name="product"/>
                <field name="website_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_exocoms_avis_form" model="ir.ui.view">
        <field name="name">exocoms.avis.form</field>
        <field name="model">exocoms.avis</field>
        <field name="arch" type="xml">
            <form string="Avis client">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="rating"/>
                            <field name="product"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="website_id"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group>
                        <field name="comment"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_exocoms_avis_search" model="ir.ui.view">
        <field name="name">exocoms.avis.search</field>
        <field name="model">exocoms.avis</field>
        <field name="arch" type="xml">
            <search string="Avis clients">
                <field name="name"/>
                <field name="product"/>
                <filter string="En attente" name="filter_pending" domain="[('state','=','pending')]"/>
                <filter string="Publiés" name="filter_published" domain="[('state','=','published')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Site" name="group_website" context="{'group_by':'website_id'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_exocoms_avis" model="ir.actions.act_window">
        <field name="name">Avis clients</field>
        <field name="res_model">exocoms.avis</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help">Aucun avis pour le moment — ils apparaîtront ici dès qu'un client en soumettra un via /avis.</field>
    </record>

    <menuitem id="menu_exocoms_avis_root"
              name="Avis clients"
              sequence="90"
              action="action_exocoms_avis"/>

</odoo>
