<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Modération des avis clients déposés via /avis. -->

    <record id="view_exocoms_avis_list" model="ir.ui.view">
        <field name="name">exocoms.avis.list</field>
        <field name="model">exocoms.avis</field>
        <field name="arch" type="xml">
            <list string="Avis clients" editable="top" decoration-muted="state == 'published'">
                <field name="date"/>
                <field name="name"/>
                <field name="rating"/>
                <field name="product"/>
                <field name="website_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_exocoms_avis_form" model="ir.ui.view">
        <field name="name">exocoms.avis.form</field>
        <field name="model">exocoms.avis</field>
        <field name="arch" type="xml">
            <form string="Avis client">
                <header>
                    <button name="action_translate_missing" type="object"
                            string="Traduire vers l'autre langue" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="rating"/>
                            <field name="product"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="website_id"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group>
                        <field name="comment"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue de recherche custom retirée temporairement (RNG invalide au
         déploiement, cause exacte pas encore isolée) — Odoo fournit une
         recherche par défaut sur le modèle en son absence, donc aucune
         perte de fonctionnalité bloquante. À réintroduire plus tard une
         fois testée hors production. -->

    <record id="action_exocoms_avis" model="ir.actions.act_window">
        <field name="name">Avis clients</field>
        <field name="res_model">exocoms.avis</field>
        <field name="view_mode">list,form</field>
        <field name="help">Aucun avis pour le moment — ils apparaîtront ici dès qu'un client en soumettra un via /avis.</field>
    </record>

    <menuitem id="menu_exocoms_avis_root"
              name="Avis clients"
              sequence="90"
              action="action_exocoms_avis"/>

</odoo>
