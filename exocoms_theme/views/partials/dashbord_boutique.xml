                        </div>

                    </aside>

                    <!-- ===== CONTENT ===== -->
                    <div class="exo-dashboard-content">

                        <div class="exo-breadcrumb-bar">
                            <a href="/boutique" id="exo-bc-home">Produits</a>
                            <span class="exo-bc-sep" id="exo-bc-sep" style="display:none"> / </span>
                            <span class="exo-bc-current" id="exo-bc-current" />
                        </div>

                        <div class="exo-content-header">
                            <h3 class="exo-content-title">Nos Produits</h3>
                            <div class="exo-filter-sort">
                                <label>Trier par :</label>
                                <select id="exo-sort-select">
                                    <option value="/shop">En vedette</option>
                                    <option value="/shop?order=create_date+desc">Nouvelles arrivées</option>
                                    <option value="/shop?order=name+asc">Nom (A-Z)</option>
                                    <option value="/shop?order=list_price+asc">Prix - Croissant</option>
                                    <option value="/shop?order=list_price+desc">Prix - Décroissant</option>
                                </select>
                            </div>
                        </div>

                        <div class="exo-price-bar">
                            <span class="exo-price-bar-label">Fourchette de prix :</span>
                            <span id="exo-price-min">0 €</span>
                            <div class="exo-price-slider-inline">
                                <div class="exo-range-track">
                                    <div class="exo-range-fill" id="exo-range-fill" />
                                </div>
                                <input type="range" id="exo-range-min" class="exo-range" min="0"
                                    max="7750" value="0" step="10" />
                                <input type="range" id="exo-range-max" class="exo-range" min="0"
                                    max="7750" value="7750" step="10" />
                            </div>
                            <span id="exo-price-max">7 750 €</span>
                            <button class="exo-price-apply" id="exo-price-apply">Appliquer</button>
                        </div>

                        <div class="exo-shop-odoo">
                            <iframe src="/shop" class="exo-shop-frame" id="exo-shop-frame"
                                name="exo-shop-frame" />
                        </div>

                    </div>

                </div>
            </div>
        </section>

        <script><![CDATA[
        window.addEventListener('load', function () {

            /* === FOURCHETTE DE PRIX === */
            var rangeMin = document.getElementById('exo-range-min');
            var rangeMax = document.getElementById('exo-range-max');
            var priceMin = document.getElementById('exo-price-min');
            var priceMax = document.getElementById('exo-price-max');
            var fill     = document.getElementById('exo-range-fill');
            var applyBtn = document.getElementById('exo-price-apply');

            function fmt(v) {
                return parseInt(v).toLocaleString('fr-FR') + ',00 €';
            }

            function updateSlider() {
                var min = parseInt(rangeMin.value);
                var max = parseInt(rangeMax.value);
                if (min > max) { rangeMin.value = max; min = max; }
                var pct1 = (min / 7750) * 100;
                var pct2 = (max / 7750) * 100;
                if (fill) { fill.style.left = pct1 + '%'; fill.style.width = (pct2 - pct1) + '%'; }
                if (priceMin) priceMin.textContent = fmt(min);
                if (priceMax) priceMax.textContent = fmt(max);
            }

            if (rangeMin && rangeMax) {
                rangeMin.addEventListener('input', updateSlider);
                rangeMax.addEventListener('input', updateSlider);
                updateSlider();
            }

            if (applyBtn) {
                applyBtn.addEventListener('click', function() {
                    var iframe = document.getElementById('exo-shop-frame');
                    if (!iframe) return;
                    iframe.src = '/shop?min_price=' + rangeMin.value + '&max_price=' + rangeMax.value;
                });
            }

            /* === FILTRE TRI === */
            var sortSel = document.getElementById('exo-sort-select');
            if (sortSel) {
                sortSel.addEventListener('change', function() {
                    var iframe = document.getElementById('exo-shop-frame');
                    if (iframe) iframe.src = sortSel.value;
                });
            }

            /* === BREADCRUMB === */
            var breadcrumbPath = [];

            function updateBreadcrumb(label, level) {
                var sep = document.getElementById('exo-bc-sep');
                var cur = document.getElementById('exo-bc-current');
                if (!cur) return;
                breadcrumbPath = breadcrumbPath.slice(0, level);
                breadcrumbPath[level] = label;
                if (breadcrumbPath.length === 0) {
                    cur.innerHTML = '';
                    if (sep) sep.style.display = 'none';
                } else {
                    cur.innerHTML = breadcrumbPath.join(' / ');
                    if (sep) sep.style.display = 'inline';
                }
            }

            /* === ACCORDION NIVEAU 1 === */
            document.querySelectorAll('.exo-l1-header').forEach(function(h) {
                if (h.classList.contains('exo-l1-header-disabled')) return;
                var body = h.nextElementSibling;
                var chev = h.querySelector('.exo-l1-chevron');
                if (body) body.style.display = 'none';

                h.addEventListener('click', function(e) {
                    if (e.target.tagName === 'A') return;
                    e.preventDefault();
                    if (!body) return;
                    var isOpen = body.style.display !== 'none';

                    var parent = h.closest('.exo-cat1-group');
                    if (parent) {
                        parent.querySelectorAll('.exo-l1-header').forEach(function(sib) {
                            if (sib === h) return;
                            var sibBody = sib.nextElementSibling;
                            var sibChev = sib.querySelector('.exo-l1-chevron');
                            if (sibBody) sibBody.style.display = 'none';
                            if (sibChev) { sibChev.style.transform = ''; sibChev.style.color = ''; }
                            if (sibBody) {
                                sibBody.querySelectorAll('.exo-l2-header').forEach(function(l2h) {
                                    var l2b = l2h.nextElementSibling;
                                    var l2c = l2h.querySelector('.exo-l2-chevron');
                                    if (l2b) l2b.style.display = 'none';
                                    if (l2c) { l2c.style.transform = ''; l2c.style.color = ''; }
                                });
                            }
                        });
                    }

                    if (isOpen) {
                        body.style.display = 'none';
                        if (chev) { chev.style.transform = ''; chev.style.color = ''; }
                    } else {
                        body.style.display = 'flex';
                        body.style.flexDirection = 'column';
                        if (chev) { chev.style.transform = 'rotate(90deg)'; chev.style.color = '#0d4dff'; }
                    }
                });

                var link = h.querySelector('a');
                if (link) {
                    link.addEventListener('click', function() {
                        updateBreadcrumb(link.textContent.trim(), 0);
                    });
                }
            });

            /* === ACCORDION NIVEAU 2 === */
            document.querySelectorAll('.exo-l2-header').forEach(function(h) {
                if (h.classList.contains('exo-l2-header-disabled')) return;
                var body = h.nextElementSibling;
                var chev = h.querySelector('.exo-l2-chevron');
                if (body && body.classList.contains('exo-l2-body')) body.style.display = 'none';

                h.addEventListener('click', function(e) {
                    if (e.target.tagName === 'A') return;
                    e.preventDefault();
                    if (!body || !body.classList.contains('exo-l2-body')) return;
                    var isOpen = body.style.display !== 'none';

                    var parentL1 = h.closest('.exo-l1-body');
                    if (parentL1) {
                        parentL1.querySelectorAll('.exo-l2-header').forEach(function(sib) {
                            if (sib === h) return;
                            var sibBody = sib.nextElementSibling;
                            var sibChev = sib.querySelector('.exo-l2-chevron');
                            if (sibBody && sibBody.classList.contains('exo-l2-body')) sibBody.style.display = 'none';
                            if (sibChev) { sibChev.style.transform = ''; sibChev.style.color = ''; }
                        });
                    }

                    if (isOpen) {
                        body.style.display = 'none';
                        if (chev) { chev.style.transform = ''; chev.style.color = ''; }
                    } else {
                        body.style.display = 'flex';
                        body.style.flexDirection = 'column';
                        if (chev) { chev.style.transform = 'rotate(90deg)'; chev.style.color = '#0d4dff'; }
                    }
                });

                var link = h.querySelector('a');
                if (link) {
                    link.addEventListener('click', function() {
                        updateBreadcrumb(link.textContent.trim(), 1);
                    });
                }
            });

            /* === ACCORDION NIVEAU 3 (ex: modèles SUNMI) === */
            document.querySelectorAll('.exo-l3-header').forEach(function(h) {
                var body = h.nextElementSibling;
                var chev = h.querySelector('.exo-l3-chevron');
                if (body && body.classList.contains('exo-l3-body')) body.style.display = 'none';

                h.addEventListener('click', function(e) {
                    if (e.target.tagName === 'A') return;
                    e.preventDefault();
                    if (!body || !body.classList.contains('exo-l3-body')) return;
                    var isOpen = body.style.display !== 'none';

                    var parentL2 = h.closest('.exo-l2-body');
                    if (parentL2) {
                        parentL2.querySelectorAll('.exo-l3-header').forEach(function(sib) {
                            if (sib === h) return;
                            var sibBody = sib.nextElementSibling;
                            var sibChev = sib.querySelector('.exo-l3-chevron');
                            if (sibBody && sibBody.classList.contains('exo-l3-body')) sibBody.style.display = 'none';
                            if (sibChev) { sibChev.style.transform = ''; sibChev.style.color = ''; }
                        });
                    }

                    if (isOpen) {
                        body.style.display = 'none';
                        if (chev) { chev.style.transform = ''; chev.style.color = ''; }
                    } else {
                        body.style.display = 'flex';
                        body.style.flexDirection = 'column';
                        if (chev) { chev.style.transform = 'rotate(90deg)'; chev.style.color = '#0d4dff'; }
                    }
                });

                var link = h.querySelector('a');
                if (link) {
                    link.addEventListener('click', function() {
                        updateBreadcrumb(link.textContent.trim(), 2);
                    });
                }
            });

            /* Feuilles */
            document.querySelectorAll('.exo-leaf').forEach(function(a) {
                if (a.classList.contains('exo-leaf-disabled')) return;
                a.addEventListener('click', function() {
                    updateBreadcrumb(a.textContent.trim(), 3);
                });
            });

        });
        ]]></script>

    </template>

</odoo>