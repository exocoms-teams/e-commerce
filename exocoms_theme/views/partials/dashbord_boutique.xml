                                    <a href="#" target="exo-shop-frame">Solutions Professionnelles
                                        Spécifiques</a>
                                    <i class="fa fa-chevron-right exo-l1-chevron" />
                                </div>
                                <div class="exo-l1-body">
                                    <a href="#" class="exo-leaf" target="exo-shop-frame">Points de
                                        ventes</a>
                                    <a href="#" class="exo-leaf" target="exo-shop-frame">Domotique</a>
                                    <a href="#" class="exo-leaf" target="exo-shop-frame">PLV /
                                        Marketing</a>
                                </div>
                            </div>
                            <div class="exo-l1-item">
                                <div class="exo-l1-header">
                                    <a href="#" target="exo-shop-frame">Solutions Télécom</a>
                                    <i class="fa fa-chevron-right exo-l1-chevron" />
                                </div>
                                <div class="exo-l1-body">
                                    <a href="#" class="exo-leaf" target="exo-shop-frame">Centre
                                        d'appel</a>
                                    <a href="#" class="exo-leaf" target="exo-shop-frame">
                                        Visioconférence</a>
                                    <a href="#" class="exo-leaf" target="exo-shop-frame">
                                        Collaboration</a>
                                    <a href="#" class="exo-leaf" target="exo-shop-frame">Communication
                                        unifiée</a>
                                </div>
