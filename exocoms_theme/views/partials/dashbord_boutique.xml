        <script><![CDATA[
        document.addEventListener('DOMContentLoaded', function () {

            /* ACCORDION NIVEAU 1 */
            document.querySelectorAll('.exo-l1-header').forEach(function(h) {
                if (h.classList.contains('exo-l1-header-disabled')) return;
                var body = h.nextElementSibling;
                var chev = h.querySelector('.exo-l1-chevron');
                if (body) body.style.display = 'none';
                h.addEventListener('click', function(e) {
                    if (e.target.tagName === 'A') return;
                    e.preventDefault();
                    if (!body) return;
                    var isOpen = body.style.display !== 'none';
                    var parent = h.closest('.exo-cat1-group');
                    if (parent) {
                        parent.querySelectorAll('.exo-l1-header').forEach(function(sib) {
                            if (sib === h) return;
                            var sb = sib.nextElementSibling;
                            var sc = sib.querySelector('.exo-l1-chevron');
                            if (sb) sb.style.display = 'none';
                            if (sc) { sc.style.transform = ''; sc.style.color = ''; }
                        });
                    }
                    if (isOpen) {
                        body.style.display = 'none';
                        if (chev) { chev.style.transform = ''; chev.style.color = ''; }
                    } else {
                        body.style.display = 'flex';
                        body.style.flexDirection = 'column';
                        if (chev) { chev.style.transform = 'rotate(90deg)'; chev.style.color = '#0d4dff'; }
                    }
                });
            });

            /* ACCORDION NIVEAU 2 */
            document.querySelectorAll('.exo-l2-header').forEach(function(h) {
                if (h.classList.contains('exo-l2-header-disabled')) return;
                var body = h.nextElementSibling;
                var chev = h.querySelector('.exo-l2-chevron');
                if (body && body.classList.contains('exo-l2-body')) body.style.display = 'none';
                h.addEventListener('click', function(e) {
                    if (e.target.tagName === 'A') return;
                    e.preventDefault();
                    if (!body || !body.classList.contains('exo-l2-body')) return;
                    var isOpen = body.style.display !== 'none';
                    var parentL1 = h.closest('.exo-l1-body');
                    if (parentL1) {
                        parentL1.querySelectorAll('.exo-l2-header').forEach(function(sib) {
                            if (sib === h) return;
                            var sb = sib.nextElementSibling;
                            var sc = sib.querySelector('.exo-l2-chevron');
                            if (sb && sb.classList.contains('exo-l2-body')) sb.style.display = 'none';
                            if (sc) { sc.style.transform = ''; sc.style.color = ''; }
                        });
                    }
                    if (isOpen) {
                        body.style.display = 'none';
                        if (chev) { chev.style.transform = ''; chev.style.color = ''; }
                    } else {
                        body.style.display = 'flex';
                        body.style.flexDirection = 'column';
                        if (chev) { chev.style.transform = 'rotate(90deg)'; chev.style.color = '#0d4dff'; }
                    }
                });
            });

            /* ACCORDION NIVEAU 3 */
            document.querySelectorAll('.exo-l3-header').forEach(function(h) {
                var body = h.nextElementSibling;
                var chev = h.querySelector('.exo-l3-chevron');
                if (body && body.classList.contains('exo-l3-body')) body.style.display = 'none';
                h.addEventListener('click', function(e) {
                    if (e.target.tagName === 'A') return;
                    e.preventDefault();
                    if (!body || !body.classList.contains('exo-l3-body')) return;
                    var isOpen = body.style.display !== 'none';
                    if (isOpen) {
                        body.style.display = 'none';
                        if (chev) { chev.style.transform = ''; chev.style.color = ''; }
                    } else {
