<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="services_hero">
        <section class="services-hero-section">

            <!-- COUCHE 1 : Photo de fond -->
            <div class="services-hero-bg o_editable o_bg_img_opt_show"
                 style="background-image: url('/exocoms_theme/static/src/img/heroservice.jpg');"/>

            <!-- COUCHE 2 : Overlay bleu nuit -->
            <div class="services-hero-overlay-dark"/>

            <!-- COUCHE 3 : Grille SVG décorative modules -->
            <svg class="services-hero-svg" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
                <rect x="680" y="40"  width="64" height="64" rx="12" fill="none"         stroke="#2a5a85" stroke-width="1.2"/>
                <rect x="760" y="40"  width="64" height="64" rx="12" fill="none"         stroke="#2a5a85" stroke-width="1.2"/>
                <rect x="840" y="40"  width="64" height="64" rx="12" fill="#0d4dff" opacity="0.15" stroke="#4d8aff" stroke-width="1.2"/>
                <rect x="920" y="40"  width="64" height="64" rx="12" fill="none"         stroke="#2a5a85" stroke-width="1.2"/>
                <rect x="680" y="120" width="64" height="64" rx="12" fill="#0d4dff" opacity="0.15" stroke="#4d8aff" stroke-width="1.2"/>
                <rect x="760" y="120" width="64" height="64" rx="12" fill="none"         stroke="#2a5a85" stroke-width="1.2"/>
                <rect x="840" y="120" width="64" height="64" rx="12" fill="none"         stroke="#2a5a85" stroke-width="1.2"/>
                <rect x="920" y="120" width="64" height="64" rx="12" fill="#0d4dff" opacity="0.15" stroke="#4d8aff" stroke-width="1.2"/>
                <rect x="680" y="200" width="64" height="64" rx="12" fill="none"         stroke="#2a5a85" stroke-width="1.2"/>
                <rect x="760" y="200" width="64" height="64" rx="12" fill="#0d4dff" opacity="0.15" stroke="#4d8aff" stroke-width="1.2"/>
                <rect x="840" y="200" width="64" height="64" rx="12" fill="none"         stroke="#2a5a85" stroke-width="1.2"/>
                <rect x="920" y="200" width="64" height="64" rx="12" fill="none"         stroke="#2a5a85" stroke-width="1.2"/>
                <rect x="680" y="280" width="64" height="64" rx="12" fill="#0d4dff" opacity="0.15" stroke="#4d8aff" stroke-width="1.2"/>
                <rect x="760" y="280" width="64" height="64" rx="12" fill="none"         stroke="#2a5a85" stroke-width="1.2"/>
                <rect x="840" y="280" width="64" height="64" rx="12" fill="none"         stroke="#2a5a85" stroke-width="1.2"/>
                <rect x="920" y="280" width="64" height="64" rx="12" fill="none"         stroke="#2a5a85" stroke-width="1.2"/>
            </svg>

            <!-- COUCHE 4 : Overlay + contenu (inchangé) -->
            <div class="services-hero-overlay">
                <div class="services-hero-content">
                    <t t-if="request.env.lang == 'fr_FR'">
                        <div class="services-hero-badge oe_editable">
                            <span class="hero-dot"/>
                            Solutions expertes · Depuis 2010
                        </div>
                        <h1 class="oe_editable">
                            Des solutions expertes pour faire avancer votre entreprise
                        </h1>
                        <p class="oe_editable">
                            EXOCOMS accompagne les entreprises avec des services
                            innovants, fiables et adaptés à leurs besoins
                            en informatique, monétique, réseaux et infrastructures.
                        </p>
                        <div class="services-hero-buttons">
                            <a href="/services" class="services-hero-btn-primary oe_editable">
                                <i class="fa fa-arrow-right"/> Découvrir nos services
                            </a>
                            <a href="/contactus" class="services-hero-btn-secondary oe_editable">
                                <i class="fa fa-envelope"/> Nous contacter
                            </a>
                        </div>
                        <div class="services-hero-trust oe_editable">
                            <span><i class="fa fa-check"/> Expertise certifiée</span>
                            <span><i class="fa fa-check"/> Support 7j/7</span>
                            <span><i class="fa fa-check"/> +200 clients accompagnés</span>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="services-hero-badge oe_editable">
                            <span class="hero-dot"/>
                            Expert solutions · Since 2010
                        </div>
                        <h1 class="oe_editable">
                            Expert solutions to move your business forward
                        </h1>
                        <p class="oe_editable">
                            EXOCOMS supports businesses with innovative, reliable services
                            tailored to their needs in IT, payment processing,
                            networking and infrastructure.
                        </p>
                        <div class="services-hero-buttons">
                            <a href="/en/services" class="services-hero-btn-primary oe_editable">
                                <i class="fa fa-arrow-right"/> Discover our services
                            </a>
                            <a href="/en/contactus" class="services-hero-btn-secondary oe_editable">
                                <i class="fa fa-envelope"/> Contact us
                            </a>
                        </div>
                        <div class="services-hero-trust oe_editable">
                            <span><i class="fa fa-check"/> Certified expertise</span>
                            <span><i class="fa fa-check"/> Support 7/7</span>
                            <span><i class="fa fa-check"/> +200 clients supported</span>
                        </div>
                    </t>
                </div>
                <div class="oe_structure oe_empty" id="oe_structure_services_hero_extra"/>
            </div>

        </section>
    </template>
</odoo>