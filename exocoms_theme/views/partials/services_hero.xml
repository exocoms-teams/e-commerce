            <div class="oe_structure oe_empty" id="oe_structure_services_hero_extra"/>
        </section>
    </template>

    <!-- Aiguilleur — choisit quel template complet appeler selon la langue -->
    <template id="services_hero" name="Exocoms Services Hero">
        <t t-if="request.env.lang == 'fr_FR'" t-call="exocoms_theme.services_hero_fr"/>
        <t t-if="request.env.lang != 'fr_FR'" t-call="exocoms_theme.services_hero_en"/>
    </template>

</odoo>