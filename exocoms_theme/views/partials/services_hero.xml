<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="services_hero">
        <section class="services-hero-v2-section">
            <!-- Grille de connexion décorative -->
            <svg class="services-hero-v2-grid" viewBox="0 0 1000 300" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
                <circle cx="700" cy="60" r="2.5" fill="#4d8aff"/>
                <circle cx="820" cy="40" r="2.5" fill="#4d8aff"/>
                <circle cx="900" cy="100" r="2.5" fill="#4d8aff"/>
                <circle cx="760" cy="140" r="2.5" fill="#4d8aff"/>
                <circle cx="930" cy="170" r="2.5" fill="#4d8aff"/>
                <line x1="700" y1="60" x2="820" y2="40" stroke="#2a5a85" stroke-width="1"/>
                <line x1="820" y1="40" x2="900" y2="100" stroke="#2a5a85" stroke-width="1"/>
                <line x1="900" y1="100" x2="760" y2="140" stroke="#2a5a85" stroke-width="1"/>
                <line x1="900" y1="100" x2="930" y2="170" stroke="#2a5a85" stroke-width="1"/>
                <line x1="700" y1="60" x2="760" y2="140" stroke="#2a5a85" stroke-width="1" opacity="0.6"/>
            </svg>

            <!-- Bouton options (point-virgule) -->
            <div class="services-hero-v2-options">
                <i class="fa fa-ellipsis-h"/>
            </div>

            <div class="services-hero-v2-content">

                <t t-if="request.env.lang == 'fr_FR'">
                    <div class="services-hero-v2-badge oe_editable">
                        <span class="services-hero-v2-dot"/>
                        Solutions expertes · Depuis 2010
                    </div>
                    <h1 class="oe_editable">
                        Des solutions expertes pour faire avancer votre entreprise
                    </h1>
                    <p class="oe_editable">
                        EXOCOMS accompagne les entreprises avec des services
                        innovants, fiables et adaptés à leurs besoins en
                        informatique, monétique, réseaux et infrastructures.
                    </p>
                    <div class="services-hero-v2-buttons">
                        <a href="/services" class="services-hero-v2-btn-primary oe_editable">
                            Découvrir nos services
                        </a>
                        <a href="/contactus" class="services-hero-v2-btn-secondary oe_editable">
                            Nous contacter
                        </a>
                    </div>
                    <p class="services-hero-v2-trust oe_editable">
                        Expertise certifiée · Support 7j/7 · +200 clients accompagnés
                    </p>
                </t>
                <t t-else="">
                    <div class="services-hero-v2-badge oe_editable">
                        <span class="services-hero-v2-dot"/>
                        Expert solutions · Since 2010
                    </div>
                    <h1 class="oe_editable">
                        Expert solutions to move your business forward
                    </h1>
                    <p class="oe_editable">
                        EXOCOMS supports businesses with innovative, reliable
                        services tailored to their needs in IT, payment
                        processing, networking and infrastructure.
                    </p>
                    <div class="services-hero-v2-buttons">
                        <a href="/en/services" class="services-hero-v2-btn-primary oe_editable">
                            Discover our services
                        </a>
                        <a href="/en/contactus" class="services-hero-v2-btn-secondary oe_editable">
                            Contact us
                        </a>
                    </div>
                    <p class="services-hero-v2-trust oe_editable">
                        Certified expertise · Support 7/7 · +200 clients supported
                    </p>
                </t>

            </div>

            <!-- Image encadrée à droite -->
            <div class="services-hero-v2-image-frame o_editable o_bg_img_opt_show"
                 style="background-image: url('/exocoms_theme/static/src/img/heroservice.jpg');"/>

            <div class="oe_structure oe_empty" id="oe_structure_services_hero_v2_extra"/>
        </section>
    </template>
</odoo>