<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- CONTENU — stats, filtres, grille d'avis, formulaire de dépôt d'avis.
         avis_list / stats / sent sont fournis par le contrôleur Python
         (route /avis). Texte français brut, traduction via i18n/en.po. -->
    <template id="avis_content" name="Exocoms Avis Content">
        <div class="avis-content">

            <!-- STATS -->
            <div class="avis-stats-section">
                <div class="container avis-stats-inner">
                    <div class="avis-score-block">
                        <t t-if="stats">
                            <div class="avis-score-big"><t t-out="stats['avg']"/></div>
                            <div class="avis-score-stars-big">
                                <t t-foreach="range(int(stats['avg']))" t-as="s">
                                    <i class="fa fa-star"/>
                                </t>
                                <t t-if="stats['avg'] % 1 >= 0.5">
                                    <i class="fa fa-star-half-o"/>
                                </t>
                            </div>
                            <div class="avis-score-total"><t t-out="stats['total']"/> avis vérifiés</div>
                        </t>
                        <t t-else="">
                            <div class="avis-score-big">—</div>
                            <div class="avis-score-total">Aucun avis pour le moment</div>
                        </t>
                    </div>
                    <div class="avis-bars-block">
                        <t t-foreach="[5,4,3,2,1]" t-as="star">
                            <div class="avis-bar-row">
                                <div class="avis-bar-label"><t t-out="star"/> <i class="fa fa-star"/></div>
                                <div class="avis-bar-track">
                                    <div t-if="stats" class="avis-bar-fill avis-bar-anim"
                                         t-att-data-width="str(stats['dist'][star])" style="width:0%"/>
                                    <div t-else="" class="avis-bar-fill" style="width:0%"/>
                                </div>
                                <div class="avis-bar-pct">
                                    <t t-if="stats" t-out="stats['dist'][star]"/><t t-else="">0</t>%
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- FILTRES -->
            <div class="avis-filters">
                <div class="container avis-filters-inner">
                    <span class="avis-filter-label">Filtrer :</span>
                    <button class="avis-filter-btn active" data-filter="all">Tous les avis</button>
                    <button class="avis-filter-btn" data-filter="5"><i class="fa fa-star"/> 5 étoiles</button>
                    <button class="avis-filter-btn" data-filter="4"><i class="fa fa-star"/> 4 étoiles</button>
                    <button class="avis-filter-btn" data-filter="3"><i class="fa fa-star"/> 3 étoiles</button>
                    <button class="avis-filter-btn" data-filter="2"><i class="fa fa-star"/> 2 étoiles</button>
                    <button class="avis-filter-btn" data-filter="1"><i class="fa fa-star"/> 1 étoile</button>
                </div>
            </div>

            <!-- GRILLE -->
            <div class="avis-body">
                <div class="container avis-grid" id="avis-grid">
                    <t t-foreach="avis_list" t-as="avis">
                        <div t-attf-class="avis-card {{ 'featured' if avis.rating == 5 else '' }}"
                             t-att-data-rating="avis.rating">
                            <div class="avis-card-head">
                                <div class="avis-avatar"><t t-out="avis.name[0].upper()"/></div>
                                <div>
                                    <div class="avis-name"><t t-out="avis.name"/></div>
                                    <div class="avis-date"><t t-out="avis.date"/></div>
                                </div>
                            </div>
                            <div class="avis-stars">
                                <t t-foreach="range(avis.rating)" t-as="s"><i class="fa fa-star"/></t>
                                <t t-foreach="range(5 - avis.rating)" t-as="s"><i class="fa fa-star-o"/></t>
                            </div>
                            <p class="avis-text"><t t-out="avis.comment"/></p>
                            <div class="avis-card-footer">
                                <t t-if="avis.product">
                                    <div class="avis-product-tag"><i class="fa fa-tag"/> <t t-out="avis.product"/></div>
                                </t>
                                <div class="avis-verified"><i class="fa fa-check-circle"/> Achat vérifié</div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- FORMULAIRE -->
            <div class="avis-form-section" id="avis-form">
                <div class="container avis-form-inner">
                    <div class="avis-form-header">
                        <div class="avis-section-eyebrow">Votre avis compte</div>
                        <h2 class="avis-form-title">Partagez votre expérience</h2>
                        <p class="avis-form-sub">Votre retour aide les autres clients à faire le bon choix.</p>
                    </div>
                    <div class="avis-form-card">
                        <t t-if="sent">
                            <div class="avis-success-msg">
                                <div class="avis-success-icon"><i class="fa fa-check"/></div>
                                <div class="avis-success-title">Merci pour votre avis !</div>
                                <p class="avis-success-text">Votre commentaire est en attente de validation<br/>et sera publié prochainement.</p>
                            </div>
                        </t>
                        <t t-else="">
                            <form action="/avis/submit" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="avis-star-picker-wrap">
                                    <label class="avis-star-picker-label">Votre note <span style="color:#ef4444">*</span></label>
                                    <div class="avis-star-picker" id="avis-star-picker">
                                        <button type="button" class="avis-star-btn" data-val="1">&#xf005;</button>
                                        <button type="button" class="avis-star-btn" data-val="2">&#xf005;</button>
                                        <button type="button" class="avis-star-btn" data-val="3">&#xf005;</button>
                                        <button type="button" class="avis-star-btn" data-val="4">&#xf005;</button>
                                        <button type="button" class="avis-star-btn" data-val="5">&#xf005;</button>
                                    </div>
                                    <div class="avis-star-hint" id="avis-star-hint">Cliquez pour noter</div>
                                    <input type="hidden" name="rating" id="avis-rating-input" value="5" required=""/>
                                </div>
                                <div class="avis-form-row">
                                    <div class="avis-form-group">
                                        <label class="avis-form-label" for="av_nom">Nom<span class="req"> *</span></label>
                                        <input class="avis-input" type="text" name="name" id="av_nom" required="" placeholder="Votre nom"/>
                                    </div>
                                    <div class="avis-form-group">
                                        <label class="avis-form-label" for="av_product">Produit acheté</label>
                                        <input class="avis-input" type="text" name="product" id="av_product" placeholder="Ex : Terminal de paiement Ingenico"/>
                                    </div>
                                </div>
                                <div class="avis-form-group">
                                    <label class="avis-form-label" for="av_comment">Votre commentaire<span class="req"> *</span></label>
                                    <textarea class="avis-textarea" name="comment" id="av_comment" required="" placeholder="Décrivez votre expérience avec ce produit ou notre service..." rows="5"/>
                                </div>
                                <button type="submit" class="avis-submit">
                                    <i class="fa fa-paper-plane"/> Publier mon avis
                                </button>
                            </form>
                        </t>
                    </div>
                </div>
            </div>

        </div>

        <!-- SCRIPTS -->
        <script>
        (function () {
            var bars = document.querySelectorAll('.avis-bar-fill.avis-bar-anim');
            if (bars.length) {
                var obs = new IntersectionObserver(function (entries) {
                    entries.forEach(function (e) {
                        if (!e.isIntersecting) return;
                        obs.unobserve(e.target);
                        var w = e.target.dataset.width || '0';
                        setTimeout(function () { e.target.style.width = w + '%'; }, 100);
                    });
                }, { threshold: 0.2 });
                bars.forEach(function (b) { obs.observe(b); });
            }

            var filterBtns = document.querySelectorAll('.avis-filter-btn');
            var cards = document.querySelectorAll('.avis-card');
            filterBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    filterBtns.forEach(function (b) { b.classList.remove('active'); });
                    this.classList.add('active');
                    var f = this.dataset.filter;
                    cards.forEach(function (c) {
                        c.style.display = (f === 'all' || c.dataset.rating === f) ? '' : 'none';
                    });
                });
            });

            var isFr = (document.documentElement.lang || '').toLowerCase().indexOf('fr') === 0;
            var hints = isFr
                ? ['', 'Mauvais', 'Passable', 'Bien', 'Très bien', 'Excellent !']
                : ['', 'Poor', 'Fair', 'Good', 'Very good', 'Excellent!'];
            var starBtns = document.querySelectorAll('.avis-star-btn');
            var hintEl = document.getElementById('avis-star-hint');
            var ratingInput = document.getElementById('avis-rating-input');
            var currentRating = 0;
            function setStars(n) {
                starBtns.forEach(function (b) { b.classList.toggle('active', +b.dataset.val &lt;= n); });
                if (hintEl) hintEl.textContent = n > 0 ? hints[n] : (isFr ? 'Cliquez pour noter' : 'Click to rate');
                if (ratingInput) ratingInput.value = n || '';
                currentRating = n;
            }
            starBtns.forEach(function (btn) {
                btn.addEventListener('mouseenter', function () { setStars(+this.dataset.val); });
                btn.addEventListener('click', function () { currentRating = +this.dataset.val; setStars(currentRating); });
            });
            var picker = document.getElementById('avis-star-picker');
            if (picker) picker.addEventListener('mouseleave', function () { setStars(currentRating); });

            document.querySelectorAll('a[href="#avis-form"]').forEach(function (a) {
                a.addEventListener('click', function (e) {
                    e.preventDefault();
                    var el = document.getElementById('avis-form');
                    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            });
        })();
        </script>
    </template>

</odoo>
