<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         TEMPLATE DU SNIPPET — structure reconnue par le Website Builder
         Classes clés pour activer les options natives :
         - data-snippet / data-name : identifient le bloc dans l'éditeur
         - o_colored_level : active l'option "Couleur de fond" (palette)
         - oe_img_bg / o_bg_img_center : active l'option "Image de fond"
         - row + col-lg-* : colonnes redimensionnables nativement
         - pt*/pb* : paddings gérés par les poignées natives Odoo
         ═══════════════════════════════════════════════════════════ -->

    <template id="hero_section" name="Exocoms Hero">
        <section class="s_exocoms_hero o_colored_level pt64 pb64 oe_img_bg o_bg_img_center"
                 data-snippet="s_exocoms_hero"
                 data-name="Exocoms Hero"
                 style="background-image: url('/exocoms_theme/static/src/img/high-tech-view-futuristic-earth.jpg');">

            <!-- Filtre de couleur — option native "Filtre" (intensité réglable dans l'éditeur) -->
            <div class="o_we_bg_filter bg-black-50"/>

            <!-- Grille SVG décorative — élément non éditable, purement visuel -->
            <svg class="s_exocoms_hero_svg o_not_editable" viewBox="0 0 1000 600"
                 preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
                <circle cx="700" cy="60"  r="2.5" fill="#4d8aff"/>
                <circle cx="820" cy="40"  r="2.5" fill="#4d8aff"/>
                <circle cx="900" cy="100" r="2.5" fill="#4d8aff"/>
                <circle cx="760" cy="140" r="2.5" fill="#4d8aff"/>
                <line x1="700" y1="60"  x2="820" y2="40"  stroke="#4d8aff" stroke-width="0.8" opacity="0.5"/>
                <line x1="820" y1="40"  x2="900" y2="100" stroke="#4d8aff" stroke-width="0.8" opacity="0.5"/>
                <line x1="900" y1="100" x2="760" y2="140" stroke="#4d8aff" stroke-width="0.8" opacity="0.5"/>
            </svg>

            <!-- Conteneur Bootstrap standard — la Website Builder reconnaît .row/.col-lg-* -->
            <div class="container s_allow_columns">
                <div class="row">
                    <div class="col-lg-7 pt32 pb32">

                        <!-- Badge — éditable texte simple -->
                        <span class="badge rounded-pill s_exocoms_hero_badge oe_editable">
                            Partenaire technologique depuis 2010
                        </span>

                        <!-- Titre — balise h1 standard, l'éditeur propose nativement
                             police/taille/couleur/alignement sur tout texte -->
                        <h1 class="text-white oe_editable">
                            Votre infrastructure IT, gérée par un seul partenaire
                        </h1>

                        <!-- Paragraphe — éditable -->
                        <p class="lead text-white-75 oe_editable">
                            Informatique, télécommunications, sécurité et monétique —
                            sans contrainte technique.
                        </p>

                        <!-- Boutons — utilise les classes btn natives Odoo,
                             reconnues par l'option "Style de bouton" -->
                        <div class="s_exocoms_hero_buttons">
                            <a href="/shop" class="btn btn-primary mb-2">
                                Découvrir nos produits
                            </a>
                            <a href="/contactus" class="btn btn-outline-light mb-2">
                                Nous contacter
                            </a>
                        </div>

                    </div>
                    <!-- Colonne vide à droite — redimensionnable, l'utilisateur peut y glisser
                         une image ou un autre bloc via le Website Builder -->
                    <div class="col-lg-5 d-none d-lg-block"/>
                </div>
            </div>
        </section>
    </template>

    <!-- ═══════════════════════════════════════════════════════════
         ENREGISTREMENT DANS LE PANNEAU "AJOUTER UN BLOC" — RETIRÉ
         L'ID 'snippet_structure' n'existe pas dans cette version d'Odoo
         et empêchait le chargement complet du module (ParseError).
         Le snippet reste pleinement fonctionnel avec ses options de
         structure (image, couleur, colonnes, padding) sans cet
         enregistrement — il n'est utile que si tu veux pouvoir
         glisser-déposer ce bloc depuis le panneau sur une AUTRE page.
         ═══════════════════════════════════════════════════════════ -->

</odoo>