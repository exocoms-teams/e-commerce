<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="hero_section">
        <section class="hero-section">
            <!-- Image de fond éditable -->
            <div class="hero-bg o_editable o_bg_img_opt_show"
                 style="background-image: url('/exocoms_theme/static/src/img/high-tech-view-futuristic-earth.jpg');"/>
            <!-- Overlay gradient -->
            <div class="hero-overlay">
                <div class="hero-content">

                    <t t-if="request.env.lang == 'fr_FR'">
                        <!-- Badge éditable -->
                        <div class="hero-badge oe_editable">
                            <span class="hero-dot"/>
                            Partenaire technologique certifié · Depuis 2010
                        </div>
                        <!-- Titre éditable -->
                        <h1 class="oe_editable">
                            Votre partenaire technologique au quotidien
                        </h1>
                        <!-- Description éditable -->
                        <p class="oe_editable">
                            Exocoms Group accompagne particuliers et entreprises
                            avec des solutions complètes en informatique,
                            télécommunications, sécurité et infrastructures —
                            pour piloter votre activité sans contraintes techniques.
                        </p>
                        <!-- Boutons éditables -->
                        <div class="hero-buttons">
                            <a href="/boutique" class="hero-btn-primary oe_editable">
                                <i class="fa fa-th-large"/> Découvrir nos produits
                            </a>
                            <a href="/contactus" class="hero-btn-secondary oe_editable">
                                <i class="fa fa-envelope"/> Nous contacter
                            </a>
                        </div>
                        <!-- Trust signals éditables -->
                        <div class="hero-trust oe_editable">
                            <span><i class="fa fa-check"/> Intervention rapide</span>
                            <span><i class="fa fa-check"/> Support 7j/7</span>
                            <span><i class="fa fa-check"/> +200 clients accompagnés</span>
                        </div>
                    </t>
                    <t t-else="">
                        <!-- Badge -->
                        <div class="hero-badge oe_editable">
                            <span class="hero-dot"/>
                            Certified technology partner · Since 2010
                        </div>
                        <!-- Title -->
                        <h1 class="oe_editable">
                            Your everyday technology partner
                        </h1>
                        <!-- Description -->
                        <p class="oe_editable">
                            Exocoms Group supports individuals and businesses
                            with comprehensive solutions in IT,
                            telecommunications, security and infrastructure —
                            to run your business without technical constraints.
                        </p>
                        <!-- Buttons -->
                        <div class="hero-buttons">
                            <a href="/en/shop" class="hero-btn-primary oe_editable">
                                <i class="fa fa-th-large"/> Discover our products
                            </a>
                            <a href="/en/contactus" class="hero-btn-secondary oe_editable">
                                <i class="fa fa-envelope"/> Contact us
                            </a>
                        </div>
                        <!-- Trust signals -->
                        <div class="hero-trust oe_editable">
                            <span><i class="fa fa-check"/> Fast response</span>
                            <span><i class="fa fa-check"/> Support 7/7</span>
                            <span><i class="fa fa-check"/> +200 clients supported</span>
                        </div>
                    </t>

                </div>
                <div class="oe_structure oe_empty" id="oe_structure_hero_extra"/>
            </div>
        </section>
        <!-- ── BANDEAU DÉFILANT SERVICES ── -->
        <div class="exo-ticker-wrap">
            <div class="exo-ticker">
                <t t-if="request.env.lang == 'fr_FR'">
                    <a href="/services#monetique" class="exo-ticker-item oe_editable">
                        <span class="exo-ticker-icon"><i class="fa fa-credit-card"/></span>
                        Monétique
                    </a>
                    <a href="/services#encaissement" class="exo-ticker-item oe_editable">
                        <span class="exo-ticker-icon"><i class="fa fa-money"/></span>
                        Encaissement
                    </a>
                    <a href="/services#affichage" class="exo-ticker-item oe_editable">
                        <span class="exo-ticker-icon"><i class="fa fa-tv"/></span>
                        Affichage dynamique
                    </a>
                    <a href="/services#informatique" class="exo-ticker-item oe_editable">
                        <span class="exo-ticker-icon"><i class="fa fa-desktop"/></span>
                        Informatique
                    </a>
                    <a href="/services#telecom" class="exo-ticker-item oe_editable">
                        <span class="exo-ticker-icon"><i class="fa fa-phone"/></span>
                        Télécom
                    </a>
                    <a href="/services#distributeur" class="exo-ticker-item oe_editable">
                        <span class="exo-ticker-icon"><i class="fa fa-cube"/></span>
                        Distributeur
                    </a>
                    <!-- Duplication pour boucle infinie -->
                    <a href="/services#monetique" class="exo-ticker-item">
