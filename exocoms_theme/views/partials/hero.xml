<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="hero_section">
        <section class="hero-section">
            <div class="hero-overlay">
                <div class="hero-content">

                    <!-- Badge -->
                    <div class="hero-badge">
                        <span class="hero-dot"/>
                        Partenaire technologique certifié · Depuis 2010
                    </div>

                    <h1>Votre partenaire technologique au quotidien</h1>

                    <p>
                        Exocoms Group accompagne particuliers et entreprises
                        avec des solutions complètes en informatique,
                        télécommunications, sécurité et infrastructures —
                        pour piloter votre activité sans contraintes techniques.
                    </p>

                    <!-- Double CTA -->
                    <div class="hero-buttons">
                        <a href="/boutique" class="hero-btn-primary">
                            <i class="fa fa-th-large"/> Découvrir nos produits
                        </a>
                        <a href="/contact" class="hero-btn-secondary">
                            <i class="fa fa-envelope"/> Nous contacter
                        </a>
                    </div>

                    <!-- Trust signals -->
                    <div class="hero-trust">
                        <span><i class="fa fa-check"/> Intervention rapide</span>
                        <span><i class="fa fa-check"/> Support 7j/7</span>
                        <span><i class="fa fa-check"/> +200 clients accompagnés</span>
                    </div>

                </div>
            </div>
        </section>

        <!-- ── BANDEAU DÉFILANT SERVICES ── -->
        <div class="exo-ticker-wrap">
            <div class="exo-ticker">
                <a href="/services#monetique" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-credit-card"/></span>
                    Monétique
                </a>
                <a href="/services#encaissement" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-money"/></span>
                    Encaissement
                </a>
                <a href="/services#affichage" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-tv"/></span>
                    Affichage dynamique
                </a>
                <a href="/services#informatique" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-desktop"/></span>
                    Informatique
                </a>
                <a href="/services#telecom" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-phone"/></span>
                    Télécom
                </a>
                <a href="/services#distributeur" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-cube"/></span>
