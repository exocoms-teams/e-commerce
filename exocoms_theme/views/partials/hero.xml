                <t t-else="">
                    <a href="/en/services#monetique" class="exo-ticker-item oe_editable">
                        <span class="exo-ticker-icon"><i class="fa fa-credit-card"/></span>
                        Payment
                    </a>
                    <a href="/en/services#encaissement" class="exo-ticker-item oe_editable">
                        <span class="exo-ticker-icon"><i class="fa fa-money"/></span>
                        Cash Register
                    </a>
                    <a href="/en/services#affichage" class="exo-ticker-item oe_editable">
                        <span class="exo-ticker-icon"><i class="fa fa-tv"/></span>
                        Digital Signage
                    </a>
                    <a href="/en/services#informatique" class="exo-ticker-item oe_editable">
                        <span class="exo-ticker-icon"><i class="fa fa-desktop"/></span>
                        IT
                    </a>
                    <a href="/en/services#telecom" class="exo-ticker-item oe_editable">
                        <span class="exo-ticker-icon"><i class="fa fa-phone"/></span>
                        Telecom
                    </a>
                    <a href="/en/services#distributeur" class="exo-ticker-item oe_editable">
                        <span class="exo-ticker-icon"><i class="fa fa-cube"/></span>
                        Distributor
                    </a>
                    <!-- Duplication for infinite loop -->
                    <a href="/en/services#monetique" class="exo-ticker-item">
                        <span class="exo-ticker-icon"><i class="fa fa-credit-card"/></span>
                        Payment
                    </a>
                    <a href="/en/services#encaissement" class="exo-ticker-item">
                        <span class="exo-ticker-icon"><i class="fa fa-money"/></span>
