                    </a>
                    <a href="/en/services#informatique" class="exo-ticker-item">
                        <span class="exo-ticker-icon"><i class="fa fa-desktop"/></span>
                        IT
                    </a>
                    <a href="/en/services#telecom" class="exo-ticker-item">
