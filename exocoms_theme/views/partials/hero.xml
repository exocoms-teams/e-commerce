<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="hero_section">
        <section class="hero-section">
            <div class="hero-overlay">
                <div class="hero-content">
                    <h1 data-oe-model="ir.ui.view"
                        data-oe-field="arch"
                        contenteditable="False">
                        Votre partenaire technologique au quotidien
                    </h1>
                    <p data-oe-model="ir.ui.view"
                       data-oe-field="arch"
                       contenteditable="False">
                        Exocoms Group accompagne particuliers et entreprises avec des solutions complètes en informatique, télécommunications, sécurité et infrastructures — pour piloter votre activité sans contraintes techniques.
                    </p>
                    <div class="hero-buttons">
                        <a href="/boutique" class="hero-btn-primary">
                            Découvrir nos produits
                        </a>
                    </div>
                </div>
                <div class="oe_structure oe_empty" id="oe_structure_hero_extra"/>
            </div>
        </section>
        <!-- ── BANDEAU DÉFILANT SERVICES ── -->
        <div class="exo-ticker-wrap">
            <div class="exo-ticker">
                <a href="/services#monetique" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-credit-card"/></span>
                    Monétique
                </a>
                <a href="/services#encaissement" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-cash-register"/></span>
                    Encaissement
                </a>
                <a href="/services#affichage" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-tv"/></span>
                    Affichage dynamique
                </a>
                <a href="/services#informatique" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-desktop"/></span>
                    Informatique
                </a>
                <a href="/services#telecom" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-phone"/></span>
                    Télécom
                </a>
                <a href="/services#distributeur" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-cube"/></span>
                    Distributeur
                </a>
                <!-- Duplication pour boucle infinie -->
                <a href="/services#monetique" class="exo-ticker-item">
