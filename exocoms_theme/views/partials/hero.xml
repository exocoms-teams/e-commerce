<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="hero_section" name="Exocoms Hero">
        <t t-set="is_fr" t-value="request.env.lang == 'fr_FR'"/>

        <section class="s_exocoms_hero o_colored_level pt64 pb64 oe_img_bg o_bg_img_center"
                 data-snippet="s_exocoms_hero"
                 data-name="Exocoms Hero"
                 style="background-image: url('/exocoms_theme/static/src/img/high-tech-view-futuristic-earth.jpg');">

            <div class="o_we_bg_filter bg-black-50"/>

            <svg xmlns="http://www.w3.org/2000/svg" class="s_exocoms_hero_svg o_not_editable"
                 viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice">
                <circle cx="700" cy="60" r="2.5" fill="#4d8aff"/>
                <circle cx="820" cy="40" r="2.5" fill="#4d8aff"/>
                <circle cx="900" cy="100" r="2.5" fill="#4d8aff"/>
                <circle cx="760" cy="140" r="2.5" fill="#4d8aff"/>
                <circle cx="660" cy="190" r="2.5" fill="#4d8aff"/>
                <circle cx="850" cy="210" r="2.5" fill="#4d8aff"/>
                <circle cx="950" cy="180" r="2.5" fill="#4d8aff"/>
                <circle cx="730" cy="250" r="2.5" fill="#4d8aff"/>
                <circle cx="880" cy="270" r="2.5" fill="#4d8aff"/>
                <circle cx="980" cy="310" r="2.5" fill="#4d8aff"/>
                <line x1="700" y1="60" x2="820" y2="40" stroke="#4d8aff" stroke-width="0.8" opacity="0.5"/>
                <line x1="820" y1="40" x2="900" y2="100" stroke="#4d8aff" stroke-width="0.8" opacity="0.5"/>
                <line x1="900" y1="100" x2="760" y2="140" stroke="#4d8aff" stroke-width="0.8" opacity="0.5"/>
                <line x1="760" y1="140" x2="660" y2="190" stroke="#4d8aff" stroke-width="0.8" opacity="0.5"/>
                <line x1="760" y1="140" x2="850" y2="210" stroke="#4d8aff" stroke-width="0.8" opacity="0.5"/>
                <line x1="850" y1="210" x2="950" y2="180" stroke="#4d8aff" stroke-width="0.8" opacity="0.5"/>
                <line x1="660" y1="190" x2="730" y2="250" stroke="#4d8aff" stroke-width="0.8" opacity="0.5"/>
                <line x1="850" y1="210" x2="880" y2="270" stroke="#4d8aff" stroke-width="0.8" opacity="0.5"/>
                <line x1="950" y1="180" x2="980" y2="310" stroke="#4d8aff" stroke-width="0.8" opacity="0.5"/>
                <line x1="700" y1="60" x2="760" y2="140" stroke="#4d8aff" stroke-width="0.8" opacity="0.3"/>
            </svg>

            <div class="container s_allow_columns">
                <div class="row">
                    <div class="col-lg-7 pt32 pb32">

                        <div class="s_exocoms_hero_badge oe_editable">
                            <span class="s_exocoms_hero_dot"/>
                            <t t-esc="is_fr and 'Partenaire technologique certifié · Depuis 2010' or 'Certified technology partner · Since 2010'"/>
                        </div>
                        <h1 class="text-white oe_editable">
                            <t t-esc="is_fr and 'Votre partenaire technologique au quotidien' or 'Your everyday technology partner'"/>
                        </h1>
                        <p class="lead text-white-75 oe_editable">
                            <t t-if="is_fr">
                                Exocoms Group accompagne particuliers et entreprises
                                avec des solutions complètes en informatique,
                                télécommunications, sécurité et infrastructures —
                                pour piloter votre activité sans contraintes techniques.
                            </t>
                            <t t-if="not is_fr">
                                Exocoms Group supports individuals and businesses
                                with comprehensive solutions in IT,
                                telecommunications, security and infrastructure —
                                to run your business without technical constraints.
                            </t>
                        </p>
                        <div class="s_exocoms_hero_buttons">
                            <a t-att-href="is_fr and '/boutique' or '/en/shop'" class="btn btn-primary mb-2 oe_editable">
                                <i class="fa fa-th-large"/>
                                <t t-esc="is_fr and ' Découvrir nos produits' or ' Discover our products'"/>
                            </a>
                            <a t-att-href="is_fr and '/contactus' or '/en/contactus'" class="btn btn-outline-light mb-2 oe_editable">
                                <i class="fa fa-envelope"/>
                                <t t-esc="is_fr and ' Nous contacter' or ' Contact us'"/>
                            </a>
                        </div>
                        <div class="s_exocoms_hero_trust oe_editable">
                            <t t-if="is_fr">
                                <span><i class="fa fa-check"/> Intervention rapide</span>
                                <span><i class="fa fa-check"/> Support 7j/7</span>
                                <span><i class="fa fa-check"/> +200 clients accompagnés</span>
                            </t>
                            <t t-if="not is_fr">
                                <span><i class="fa fa-check"/> Fast response</span>
                                <span><i class="fa fa-check"/> Support 7/7</span>
                                <span><i class="fa fa-check"/> +200 clients supported</span>
                            </t>
                        </div>

                    </div>
                    <div class="col-lg-5 d-none d-lg-block"/>
                </div>
            </div>

            <div class="oe_structure oe_empty" id="oe_structure_hero_extra"/>
        </section>
    </template>

    <template id="hero_ticker" name="Exocoms Hero Ticker">
        <t t-set="is_fr" t-value="request.env.lang == 'fr_FR'"/>
        <div class="exo-ticker-wrap">
            <div class="exo-ticker">
                <a t-att-href="is_fr and '/services#monetique' or '/en/services#monetique'" class="exo-ticker-item oe_editable">
                    <span class="exo-ticker-icon"><i class="fa fa-credit-card"/></span>
                    <t t-esc="is_fr and 'Monétique' or 'Payment'"/>
                </a>
                <a t-att-href="is_fr and '/services#encaissement' or '/en/services#encaissement'" class="exo-ticker-item oe_editable">
                    <span class="exo-ticker-icon"><i class="fa fa-money"/></span>
                    <t t-esc="is_fr and 'Encaissement' or 'Cash Register'"/>
                </a>
                <a t-att-href="is_fr and '/services#affichage' or '/en/services#affichage'" class="exo-ticker-item oe_editable">
                    <span class="exo-ticker-icon"><i class="fa fa-tv"/></span>
                    <t t-esc="is_fr and 'Affichage dynamique' or 'Digital Signage'"/>
                </a>
                <a t-att-href="is_fr and '/services#informatique' or '/en/services#informatique'" class="exo-ticker-item oe_editable">
                    <span class="exo-ticker-icon"><i class="fa fa-desktop"/></span>
                    <t t-esc="is_fr and 'Informatique' or 'IT'"/>
                </a>
                <a t-att-href="is_fr and '/services#telecom' or '/en/services#telecom'" class="exo-ticker-item oe_editable">
                    <span class="exo-ticker-icon"><i class="fa fa-phone"/></span>
                    <t t-esc="is_fr and 'Télécom' or 'Telecom'"/>
                </a>
                <a t-att-href="is_fr and '/services#distributeur' or '/en/services#distributeur'" class="exo-ticker-item oe_editable">
                    <span class="exo-ticker-icon"><i class="fa fa-cube"/></span>
                    <t t-esc="is_fr and 'Distributeur' or 'Distributor'"/>
                </a>
                <a t-att-href="is_fr and '/services#monetique' or '/en/services#monetique'" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-credit-card"/></span>
                    <t t-esc="is_fr and 'Monétique' or 'Payment'"/>
                </a>
                <a t-att-href="is_fr and '/services#encaissement' or '/en/services#encaissement'" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-money"/></span>
                    <t t-esc="is_fr and 'Encaissement' or 'Cash Register'"/>
                </a>
                <a t-att-href="is_fr and '/services#affichage' or '/en/services#affichage'" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-tv"/></span>
                    <t t-esc="is_fr and 'Affichage dynamique' or 'Digital Signage'"/>
                </a>
                <a t-att-href="is_fr and '/services#informatique' or '/en/services#informatique'" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-desktop"/></span>
                    <t t-esc="is_fr and 'Informatique' or 'IT'"/>
                </a>
                <a t-att-href="is_fr and '/services#telecom' or '/en/services#telecom'" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-phone"/></span>
                    <t t-esc="is_fr and 'Télécom' or 'Telecom'"/>
                </a>
                <a t-att-href="is_fr and '/services#distributeur' or '/en/services#distributeur'" class="exo-ticker-item">
                    <span class="exo-ticker-icon"><i class="fa fa-cube"/></span>
                    <t t-esc="is_fr and 'Distributeur' or 'Distributor'"/>
                </a>
            </div>
        </div>
    </template>

</odoo>