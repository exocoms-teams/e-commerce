<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="hero_section">
        <section class="hero-section">
            <div class="hero-overlay">
                <div class="hero-content">
                    <!-- Titre éditable -->
                    <h1 data-oe-model="ir.ui.view"
                        data-oe-field="arch"
                        contenteditable="False">
                        Votre partenaire technologique au quotidien
                    </h1>
                    <!-- Paragraphe éditable -->
                    <p data-oe-model="ir.ui.view"
                       data-oe-field="arch"
                       contenteditable="False">
                        Exocoms Group accompagne les particuliers et entreprises avec des solutions
                        complètes en informatique, télécommunications, sécurité et infrastructures.
                        Notre objectif est de vous offrir des services fiables, innovants et adaptés à vos besoins.
                    </p>
                    <div class="hero-buttons">
                        <a href="/boutique" class="hero-btn-primary">
                            Découvrir nos produits
                        </a>
                    </div>
                </div>
                <!-- Zone éditable sous le contenu hero -->
                <div class="oe_structure oe_empty" id="oe_structure_hero_extra"/>
            </div>
        </section>
    </template>
</odoo>