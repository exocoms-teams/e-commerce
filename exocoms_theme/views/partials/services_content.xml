<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- =========================================================
         SERVICES CONTENT
    ========================================================== -->

    <template id="services_content">

        <section class="services-content-section">

            <div class="container">

                <!-- HEADER -->

                <div class="section-header">

                    <h2>Nos services</h2>

                    <p>
                        Des expertises complètes pour accompagner
                        votre transformation digitale
                    </p>

                </div>

                <!-- SERVICES GRID -->

                <div class="services-grid">

                    <!-- MONETIQUE -->

                    <div class="service-card">

                        <img
                            src="/exocoms_theme/static/src/img/cont1.jpg"
                            alt="Monétique"
                        />

                        <div class="service-overlay"></div>

                        <div class="service-content">

                            <div class="service-icon">
                                <i class="fa fa-credit-card"></i>
                            </div>

                            <h3>Monétique</h3>

                            <p>
                                Solutions de paiement électronique,
                                TPE fixes et mobiles et logiciels
                                monétiques sécurisés.
                            </p>

                            <a href="#monetique-details" class="service-link"> Découvrir <i
                                    class="fa fa-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                    <!-- ENCAISSEMENT -->

                    <div class="service-card">

                        <img
                            src="/exocoms_theme/static/src/img/cont2.jpg"
                            alt="Encaissement"
                        />

                        <div class="service-overlay"></div>

                        <div class="service-content">

                            <div class="service-icon">
                                <i class="fa fa-cash-register"></i>
                            </div>

                            <h3>Système d'encaissement</h3>

                            <p>
                                Caisses tactiles, logiciels de caisse
                                et solutions adaptées aux commerces.
                            </p>

                            <a href="#encaissement-details" class="service-link"> Découvrir <i
                                    class="fa fa-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                    <!-- AFFICHAGE -->

                    <div class="service-card">

                        <img
                            src="/exocoms_theme/static/src/img/cont3.jpg"
                            alt="Affichage dynamique"
                        />

                        <div class="service-overlay"></div>

                        <div class="service-content">

                            <div class="service-icon">
                                <i class="fa fa-tv"></i>
                            </div>

                            <h3>Affichage dynamique</h3>

                            <p>
                                Écrans professionnels et diffusion
                                de contenus pour magasins et entreprises.
                            </p>

                            <a href="#affichage-details" class="service-link"> Découvrir <i
                                    class="fa fa-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                    <!-- INFORMATIQUE -->

                    <div class="service-card">

                        <img
                            src="/exocoms_theme/static/src/img/cont4.jpg"
                            alt="Informatique"
                        />

                        <div class="service-overlay"></div>

                        <div class="service-content">

                            <div class="service-icon">
                                <i class="fa fa-desktop"></i>
                            </div>

                            <h3>Opération télécom<br/>Téléphonie d'entreprise
                            </h3>

                            <p>
                                Matériel informatique, cybersécurité,
                                réseaux et infrastructures IT.
                            </p>

                            <a href="#informatique-details" class="service-link"> Découvrir <i
                                    class="fa fa-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                    <!-- TELECOM -->

                    <div class="service-card">

                        <img
                            src="/exocoms_theme/static/src/img/cont5.jpg"
                            alt="Télécom"
                        />

                        <div class="service-overlay"></div>

                        <div class="service-content">

                            <div class="service-icon">
                                <i class="fa fa-broadcast-tower"></i>
                            </div>

                            <h3>Informatique-InfogéranceIT<br/>Cybersécurité</h3>

                            <p>
                                Connectivité, téléphonie d’entreprise
                                et infrastructures réseaux modernes.
                            </p>

                            <a href="#telecom-details" class="service-link"> Découvrir <i
                                    class="fa fa-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                    <!-- SUPPORT -->

                    <div class="service-card">

                        <img
                            src="/exocoms_theme/static/src/img/cont6.jpg"
                            alt="Support"
                        />

                        <div class="service-overlay"></div>

                        <div class="service-content">

                            <div class="service-icon">
                                <i class="fa fa-headset"></i>
                            </div>

                            <h3>Distributeur automatique</h3>

                            <p>
                                Assistance technique et accompagnement
                                pour le suivi de vos solutions 24h/24.
                            </p>

                            <a href="#support-details" class="service-link"> Découvrir <i
                                    class="fa fa-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </section>

        <!-- =========================================================
             DETAILS
        ========================================================== -->

        <section id="monetique-details" class="service-detail-section">

            <div class="container">

                <div class="service-detail-content">

                    <h2>Monétique</h2>

                    <p>
                        EXOCOMS propose des solutions monétiques
                        modernes adaptées aux entreprises,
                        commerces et institutions.
                    </p>

                </div>

            </div>

        </section>

    </template>

</odoo>