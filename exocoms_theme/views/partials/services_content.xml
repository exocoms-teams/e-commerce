<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- =========================================================
         SERVICES CONTENT
    ========================================================== -->

    <template id="services_content">

        <section class="services-content-section">

            <div class="container">

                <!-- HEADER -->

                <div class="section-header">

                    <h2>Nos services</h2>

                    <p>
                        Des expertises complètes pour accompagner
                        votre transformation digitale
                    </p>

                </div>

                <!-- GRID -->

                <div class="services-grid">

                    <!-- MONETIQUE -->

                    <div class="service-card">

                        <img
                            src="/exocoms_theme/static/src/img/cont1.jpg"
                            alt="Monétique"
                        />

                        <div class="service-overlay"></div>

                        <div class="service-content">

                            <div class="service-icon">
                                <i class="fa fa-credit-card"></i>
                            </div>

                            <h3>Monétique</h3>

                            <p>
                                Solutions de paiement électronique,
                                TPE fixes et mobiles, PIN Pad
                                et logiciels monétiques sécurisés.
                            </p>

                            <a href="#">
                                Découvrir
                                <i class="fa fa-arrow-right"></i>
                            </a>

                        </div>

                    </div>

                    <!-- ENCAISSEMENT -->

                    <div class="service-card">

                        <img
                            src="/exocoms_theme/static/src/img/cont2.jpg"
                            alt="Encaissement"
                        />

                        <div class="service-overlay"></div>

                        <div class="service-content">

                            <div class="service-icon">
                                <i class="fa fa-cash-register"></i>
                            </div>

                            <h3>Systèmes d'encaissement</h3>

                            <p>
                                Caisses tactiles, logiciels de caisse,
                                imprimantes et solutions adaptées
                                aux commerces et entreprises.
                            </p>

                            <a href="#">
                                Découvrir
                                <i class="fa fa-arrow-right"></i>
                            </a>

                        </div>

                    </div>

                    <!-- AFFICHAGE -->

                    <div class="service-card">

                        <img
                            src="/exocoms_theme/static/src/img/cont3.jpg"
                            alt="Affichage dynamique"
                        />

                        <div class="service-overlay"></div>

                        <div class="service-content">

                            <div class="service-icon">
                                <i class="fa fa-tv"></i>
