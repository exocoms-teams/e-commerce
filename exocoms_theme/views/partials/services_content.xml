                            </p>

                            <a href="#">
                                Découvrir
                                <i class="fa fa-arrow-right"></i>
                            </a>

                        </div>

                    </div>

                    <!-- INFORMATIQUE -->

                    <div class="service-card">

                        <img
                            src="/exocoms_theme/static/src/img/cont2.jpg"
                            alt="Informatique"
                        />

                        <div class="service-overlay"></div>

                        <div class="service-content">

                            <div class="service-icon">
                                <i class="fa fa-desktop"></i>
