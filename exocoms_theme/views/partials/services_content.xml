<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="services_content">
        <section class="services-content-section">
            <div class="container">
                <div class="section-header">
                    <t t-if="request.env.lang == 'fr_FR'">
                        <h2>Nos métiers</h2>
                        <p>Des expertises complètes pour accompagner votre transformation digitale</p>
                    </t>
                    <t t-else="">
                        <h2>Our expertise</h2>
                        <p>Comprehensive skills to support your digital transformation</p>
                    </t>
                </div>
                <div class="services-grid">
                    <t t-if="request.env.lang == 'fr_FR'">
                        <!-- MONÉTIQUE -->
                        <div class="service-detail-card">
                            <div class="service-detail-card-img">
                                <img src="/exocoms_theme/static/src/img/1.webp" alt="Monétique"/>
                            </div>
                            <div class="service-detail-card-body">
                                <h3>Monétique</h3>
                                <p>La <strong>monétique</strong> regroupe les technologies permettant
                                    d'effectuer des paiements électroniques (cartes bancaires, sans
                                    contact, mobile). Elle facilite des transactions rapides, sécurisées
                                    et fluides pour les clients comme pour les commerçants. Moderne et
                                    essentielle, elle optimise l'expérience d'achat, réduit les délais
                                    d'encaissement et améliore la gestion des paiements.</p>
                            </div>
                        </div>
                        <!-- ENCAISSEMENT -->
                        <div class="service-detail-card">
                            <div class="service-detail-card-img">
                                <img src="/exocoms_theme/static/src/img/2.webp" alt="Système d'encaissement"/>
                            </div>
                            <div class="service-detail-card-body">
                                <h3>Système d'encaissement</h3>
                                <p>Les <strong>systèmes d'encaissement</strong> représentent l'ensemble
                                    des outils, processus et technologies permettant aux entreprises,
                                    commerçants et institutions de collecter, traiter et sécuriser les
                                    paiements. Essentiels à la gestion de la trésorerie, ces systèmes
                                    évoluent constamment avec les innovations technologiques et les
                                    nouvelles attentes des consommateurs.</p>
                            </div>
                        </div>
                        <!-- AFFICHAGE -->
                        <div class="service-detail-card">
                            <div class="service-detail-card-img">
                                <img src="/exocoms_theme/static/src/img/3.webp" alt="Affichage dynamique"/>
                            </div>
                            <div class="service-detail-card-body">
                                <h3>Affichage dynamique</h3>
                                <p>L'<strong>affichage dynamique</strong> utilise des écrans numériques
                                    pour diffuser des contenus (images, vidéos, informations) en temps
                                    réel. Facilement pilotable à distance, il permet d'adapter les
                                    messages selon le contexte et le public. Moderne et attractif, il
                                    améliore la communication, renforce l'image de marque et capte
                                    efficacement l'attention.</p>
                            </div>
                        </div>
                        <!-- INFORMATIQUE -->
                        <div class="service-detail-card">
                            <div class="service-detail-card-img">
                                <img src="/exocoms_theme/static/src/img/4.webp" alt="Informatique"/>
                            </div>
                            <div class="service-detail-card-body">
                                <h3>Informatique - Infogérance IT Cybersécurité</h3>
                                <p>L'<strong>informatique</strong> et l'<strong>infogérance IT</strong>
                                    assurent la gestion, la maintenance et la supervision des systèmes
                                    et réseaux afin de garantir leur bon fonctionnement au quotidien. La
                                    <strong>cybersécurité</strong> complète cet ensemble en protégeant les
                                    données et les infrastructures contre les menaces. Ensemble, elles
                                    permettent d'assurer performance, sécurité et continuité d'activité.</p>
                            </div>
                        </div>
                        <!-- TELECOM -->
                        <div class="service-detail-card">
                            <div class="service-detail-card-img">
                                <img src="/exocoms_theme/static/src/img/5.webp" alt="Télécom"/>
                            </div>
                            <div class="service-detail-card-body">
                                <h3>Opérateur télécom Téléphonie d'entreprise</h3>
                                <p>Les <strong>opérateurs télécom</strong> et la <strong>téléphonie
                                    d'entreprise</strong> regroupent les solutions de communication
                                    professionnelles (appels, VoIP, standard téléphonique). Elles
                                    permettent des échanges fiables, flexibles et adaptés aux besoins
                                    des entreprises. Modernes et évolutives, elles optimisent la gestion
                                    des appels, améliorent la relation client et facilitent la
                                    collaboration.</p>
                            </div>
                        </div>
                        <!-- DISTRIBUTEUR -->
                        <div class="service-detail-card">
                            <div class="service-detail-card-img">
                                <img src="/exocoms_theme/static/src/img/6.webp" alt="Distributeur automatique"/>
                            </div>
                            <div class="service-detail-card-body">
                                <h3>Distributeur automatique</h3>
                                <p>Les <strong>distributeurs automatiques</strong> permettent de
                                    proposer en libre-service des produits (boissons, snacks, etc.)
                                    accessibles 24h/24. Connectés et supervisés à distance, ils
                                    permettent de suivre les ventes, les stocks et l'état des machines
                                    en temps réel. Pratiques et autonomes, ils optimisent la gestion,
                                    améliorent le service client et maximisent la performance des points
                                    de vente.</p>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <!-- PAYMENT -->
                        <div class="service-detail-card">
                            <div class="service-detail-card-img">
                                <img src="/exocoms_theme/static/src/img/1.webp" alt="Payment"/>
                            </div>
                            <div class="service-detail-card-body">
                                <h3>Payment processing</h3>
                                <p><strong>Payment processing</strong> encompasses the technologies
                                    enabling electronic payments (bank cards, contactless, mobile).
                                    It facilitates fast, secure and seamless transactions for both
                                    customers and merchants. Modern and essential, it optimises the
                                    shopping experience, reduces payment processing times and improves
                                    payment management.</p>
                            </div>
                        </div>
                        <!-- CASH REGISTER -->
                        <div class="service-detail-card">
                            <div class="service-detail-card-img">
                                <img src="/exocoms_theme/static/src/img/2.webp" alt="Cash register system"/>
                            </div>
                            <div class="service-detail-card-body">
                                <h3>Cash register system</h3>
                                <p><strong>Cash register systems</strong> encompass all the tools,
                                    processes and technologies enabling businesses, merchants and
                                    institutions to collect, process and secure payments. Essential
                                    for cash flow management, these systems are constantly evolving
                                    with technological innovations and new consumer expectations.</p>
                            </div>
                        </div>
                        <!-- DIGITAL SIGNAGE -->
                        <div class="service-detail-card">
                            <div class="service-detail-card-img">
                                <img src="/exocoms_theme/static/src/img/3.webp" alt="Digital signage"/>
                            </div>
                            <div class="service-detail-card-body">
                                <h3>Digital signage</h3>
                                <p><strong>Digital signage</strong> uses digital screens to broadcast
                                    content (images, videos, information) in real time. Easily managed
                                    remotely, it allows messages to be adapted to context and audience.
                                    Modern and eye-catching, it improves communication, strengthens
                                    brand image and effectively captures attention.</p>
                            </div>
                        </div>
                        <!-- IT -->
                        <div class="service-detail-card">
                            <div class="service-detail-card-img">
                                <img src="/exocoms_theme/static/src/img/4.webp" alt="IT"/>
                            </div>
                            <div class="service-detail-card-body">
                                <h3>IT - Managed IT Cybersecurity</h3>
                                <p><strong>IT management</strong> and <strong>managed IT services</strong>
                                    ensure the management, maintenance and supervision of systems and
                                    networks to guarantee their smooth day-to-day operation.
                                    <strong>Cybersecurity</strong> complements this by protecting data
                                    and infrastructure against threats. Together, they ensure
                                    performance, security and business continuity.</p>
                            </div>
                        </div>
                        <!-- TELECOM -->
                        <div class="service-detail-card">
                            <div class="service-detail-card-img">
                                <img src="/exocoms_theme/static/src/img/5.webp" alt="Telecom"/>
                            </div>
                            <div class="service-detail-card-body">
                                <h3>Telecom operator Business telephony</h3>
                                <p><strong>Telecom operators</strong> and <strong>business
                                    telephony</strong> encompass professional communication solutions
                                    (calls, VoIP, telephone exchange). They enable reliable, flexible
                                    exchanges adapted to business needs. Modern and scalable, they
                                    optimise call management, improve customer relations and facilitate
                                    collaboration.</p>
                            </div>
                        </div>
                        <!-- VENDING MACHINE -->
                        <div class="service-detail-card">
                            <div class="service-detail-card-img">
                                <img src="/exocoms_theme/static/src/img/6.webp" alt="Vending machine"/>
                            </div>
                            <div class="service-detail-card-body">
                                <h3>Vending machine</h3>
                                <p><strong>Vending machines</strong> offer self-service products
                                    (drinks, snacks, etc.) accessible 24/7. Connected and remotely
                                    monitored, they allow real-time tracking of sales, stock levels
                                    and machine status. Practical and autonomous, they optimise
                                    management, improve customer service and maximise point-of-sale
                                    performance.</p>
                            </div>
                        </div>
                    </t>
                </div>
                <!-- Zone éditable -->
                <div class="oe_structure oe_empty" id="oe_structure_services_content_extra"/>
            </div>
        </section>
    </template>
</odoo>