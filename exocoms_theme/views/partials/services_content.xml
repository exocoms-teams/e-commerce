<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- =========================================================
         SERVICES CONTENT
    ========================================================== -->

    <template id="services_content">

        <section class="services-content-section">

            <div class="container">

                <!-- HEADER -->

                <div class="section-header">

                    <h2>Nos services</h2>

                    <p>
                        Des expertises complètes pour accompagner
                        votre transformation digitale
                    </p>

                </div>

                <!-- SERVICES GRID -->

                <div class="services-grid">

                    <!-- MONETIQUE -->

                    <div class="service-card">

                        <img src="/exocoms_theme/static/src/img/cont1.jpg" alt="Monétique" />

                        <div class="service-overlay"></div>

                        <div class="service-content">

                            <div class="service-icon">
                                <i class="fa fa-credit-card"></i>
                            </div>

                            <h3>Monétique</h3>

                            <p>
                                Solutions de paiement électronique,
                                TPE fixes et mobiles et logiciels
                                monétiques sécurisés.
                            </p>

                            <a href="#" class="service-link" onclick="showService('monetique-details')"> Découvrir <i class="fa fa-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                    <!-- ENCAISSEMENT -->

                    <div class="service-card">

                        <img src="/exocoms_theme/static/src/img/cont2.jpg" alt="Encaissement" />

                        <div class="service-overlay"></div>

                        <div class="service-content">

                            <div class="service-icon">
                                <i class="fa fa-cash-register"></i>
                            </div>

                            <h3>Système d'encaissement</h3>

                            <p>
                                Caisses tactiles, logiciels de caisse
                                et solutions adaptées aux commerces.
                            </p>

                            <a href="#" class="service-link" onclick="showService('encaissement-details')"> Découvrir <i class="fa fa-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                    <!-- AFFICHAGE -->

                    <div class="service-card">

                        <img src="/exocoms_theme/static/src/img/cont3.jpg" alt="Affichage dynamique" />

                        <div class="service-overlay"></div>

                        <div class="service-content">

                            <div class="service-icon">
                                <i class="fa fa-tv"></i>
                            </div>

                            <h3>Affichage dynamique</h3>

                            <p>
                                Écrans professionnels et diffusion
                                de contenus pour magasins et entreprises.
                            </p>

                            <a href="#" class="service-link" onclick="showService('affichage-details')"> Découvrir <i class="fa fa-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                    <!-- INFORMATIQUE -->

                    <div class="service-card">

                        <img src="/exocoms_theme/static/src/img/cont4.jpg" alt="Informatique" />

                        <div class="service-overlay"></div>

                        <div class="service-content">

                            <div class="service-icon">
                                <i class="fa fa-desktop"></i>
                            </div>

                            <h3>Opération télécom<br />
 Téléphonie d'entreprise </h3>

                            <p>
                                Matériel informatique, cybersécurité,
                                réseaux et infrastructures IT.
                            </p>

                            <a href="#" class="service-link" onclick="showService('informatique-details')"> Découvrir <i class="fa fa-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                    <!-- TELECOM -->

                    <div class="service-card">

                        <img src="/exocoms_theme/static/src/img/cont5.jpg" alt="Télécom" />

                        <div class="service-overlay"></div>

                        <div class="service-content">

                            <div class="service-icon">
                                <i class="fa fa-broadcast-tower"></i>
                            </div>

                            <h3>Informatique-InfogéranceIT<br />
 Cybersécurité</h3>

                            <p>
                                Connectivité, téléphonie d’entreprise
                                et infrastructures réseaux modernes.
                            </p>

                            <a href="#" class="service-link" onclick="showService('telecom-details')"> Découvrir <i class="fa fa-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                    <!-- SUPPORT -->

                    <div class="service-card">

                        <img src="/exocoms_theme/static/src/img/cont6.jpg" alt="Support" />

                        <div class="service-overlay"></div>

                        <div class="service-content">

                            <div class="service-icon">
                                <i class="fa fa-headset"></i>
                            </div>

                            <h3>Distributeur automatique</h3>

                            <p>
                                Assistance technique et accompagnement
                                pour le suivi de vos solutions 24h/24.
                            </p>

                            <a href="#" class="service-link" onclick="showService('support-details')"> Découvrir <i class="fa fa-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </section>

        <!-- =========================================================
             DETAILS
        ========================================================== -->

        <!-- =========================================================
     MONETIQUE DETAILS ========================================================== -->

        <section id="monetique-details" class="service-detail-section">

            <div class="container">

                <div class="service-detail-content">

                    <h2>Monétique</h2>

                    <p> La <strong>monétique</strong> regroupe les technologies permettant
                        d’effectuer des paiements électroniques (cartes bancaires, sans contact,
                        mobile). Elle facilite des transactions rapides, sécurisées et fluides pour
                        les clients comme pour les commerçants. Moderne et essentielle, elle
                        optimise l’expérience d’achat, réduit les délais d’encaissement et améliore
                        la gestion des paiements. </p>

                </div>

            </div>

        </section>

        <!-- =========================================================
     ENCAISSEMENT DETAILS ========================================================== -->

        <section id="encaissement-details" class="service-detail-section">

            <div class="container">

                <div class="service-detail-content">

                    <h2>Système d'encaissement</h2>

                    <p> Les <strong>systèmes d’encaissement</strong> représentent l’ensemble des
                        outils, processus et technologies permettant aux entreprises, commerçants et
                        institutions de collecter, traiter et sécuriser les paiements. Essentiels à
                        la gestion de la trésorerie, ces systèmes évoluent constamment avec les
                        innovations technologiques et les nouvelles attentes des consommateurs. </p>

                </div>

            </div>

        </section>

        <!-- =========================================================
     AFFICHAGE DETAILS ========================================================== -->

        <section id="affichage-details" class="service-detail-section">

            <div class="container">

                <div class="service-detail-content">

                    <h2>Affichage dynamique</h2>

                    <p> L’<strong>affichage dynamique</strong> utilise des écrans numériques pour
                        diffuser des contenus (images, vidéos, informations) en temps réel.
                        Facilement pilotable à distance, il permet d’adapter les messages selon le
                        contexte et le public. Moderne et attractif, il améliore la communication,
                        renforce l’image de marque et capte efficacement l’attention. </p>

                </div>

            </div>

        </section>

        <!-- =========================================================
     INFORMATIQUE DETAILS ========================================================== -->

        <section id="informatique-details" class="service-detail-section">

            <div class="container">

                <div class="service-detail-content">

                    <h2> Opération télécom<br />
 Téléphonie d'entreprise </h2>

                    <p> Les <string>opérateurs télécom</string> et la <strong>téléphonie
                            d’entreprise</strong> regroupent les solutions de communication
                        professionnelles (appels, VoIP, standard téléphonique). Elles permettent des
                        échanges fiables, flexibles et adaptés aux besoins des entreprises. Modernes
                        et évolutives, elles optimisent la gestion des appels, améliorent la
                        relation client et facilitent la collaboration. </p>

                </div>

            </div>

        </section>

        <!-- =========================================================
     TELECOM DETAILS ========================================================== -->

        <section id="telecom-details" class="service-detail-section">

            <div class="container">

                <div class="service-detail-content">

                    <h2> Informatique-InfogéranceIT<br />
 Cybersécurité </h2>

                    <p> L’<strong>informatique</strong> et l’<strong>infogéranceIT</strong> assurent
                        la gestion, la maintenance et la supervision des systèmes et réseaux afin de
                        garantir leur bon fonctionnement au quotidien. La <strong>cybersécurité</strong>
                        complète cet ensemble en protégeant les données et les infrastructures
                        contre les menaces. Ensemble, elles permettent d’assurer performance,
                        sécurité et continuité d’activité. </p>

                </div>

            </div>

        </section>

        <!-- =========================================================
     SUPPORT DETAILS ========================================================== -->

        <section id="support-details" class="service-detail-section">

            <div class="container">

                <div class="service-detail-content">

                    <h2>Distributeur automatique</h2>

                    <p> Les <strong>distributeurs automatiques</strong> permettent de proposer en
                        libre-service des produits (boissons, snacks, etc.) accessibles 24h/24.
                        Connectés et supervisés à distance, ils permettent de suivre les ventes, les
                        stocks et l’état des machines en temps réel. Pratiques et autonomes, ils
                        optimisent la gestion, améliorent le service client et maximisent la
                        performance des points de vente. </p>

                </div>

            </div>

        </section>

        <script type="text/javascript">

            function showService(id) {

                /* cacher toutes les sections */

                document.querySelectorAll('.service-detail-section')
                    .forEach(section => {
                        section.classList.remove('active');
                    });

                /* afficher la bonne section */

                document.getElementById(id)
                    .classList.add('active');
            }

        </script>

    </template>

</odoo>