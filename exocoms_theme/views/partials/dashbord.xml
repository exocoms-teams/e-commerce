        <script> window.addEventListener('load', function () { /* === NIVEAU 1 : catégories principales === */ var toggles = document.querySelectorAll('.exo-toggle'); toggles.forEach(function(toggle) { var body = toggle.nextElementSibling; var chevron = toggle.querySelector('.exo-chevron'); body.style.maxHeight = '0px'; body.style.overflow = 'hidden'; body.style.transition = 'max-height 0.32s ease'; toggle.addEventListener('click', function() { var isOpen = body.style.maxHeight !== '0px'; /* Ferme tous */ document.querySelectorAll('.exo-submenu-body').forEach(function(b) { b.style.maxHeight = '0px'; }); document.querySelectorAll('.exo-chevron').forEach(function(c) { c.style.transform = ''; c.style.color = ''; }); if (!isOpen) { body.style.maxHeight = body.scrollHeight + 500 + 'px'; chevron.style.transform = 'rotate(-180deg)'; chevron.style.color = '#0d4dff'; } }); }); /* === NIVEAU 2 : sous-items === */ var subToggles = document.querySelectorAll('.exo-sub-toggle'); subToggles.forEach(function(subToggle) { var subBody = subToggle.nextElementSibling; var subChevron = subToggle.querySelector('.exo-sub-chevron'); subBody.style.display = 'none'; subToggle.addEventListener('click', function(e) { /* Empêche le lien parent de naviguer */ var link = subToggle.querySelector('a'); if (e.target === link) { return; } e.preventDefault(); var isOpen = subBody.style.display !== 'none'; subBody.style.display = isOpen ? 'none' : 'flex'; subChevron.style.transform = isOpen ? '' : 'rotate(90deg)'; subChevron.style.color = isOpen ? '' : '#0d4dff'; /* Recalcule la hauteur du parent */ var parentBody = subToggle.closest('.exo-submenu-body'); if (parentBody) { parentBody.style.maxHeight = parentBody.scrollHeight + 500 + 'px'; } }); }); }); </script>
