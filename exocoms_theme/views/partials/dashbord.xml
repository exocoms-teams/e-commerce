        <script>
            <![CDATA[
        window.addEventListener('load', function () {
 
            /* === NIVEAU 1 — déplie/replie les sous-catégories === */
            document.querySelectorAll('.exo-l1-header').forEach(function(h) {
                var body = h.nextElementSibling;
                var chev = h.querySelector('.exo-l1-chevron');
                body.style.display = 'none';
 
                h.addEventListener('click', function(e) {
                    if (e.target.tagName === 'A') return;
                    e.preventDefault();
                    var isOpen = body.style.display !== 'none';
 
                    /* Ferme tous les L1 du même groupe */
                    var parent = h.closest('.exo-cat1-group');
                    if (parent) {
                        parent.querySelectorAll('.exo-l1-header').forEach(function(sib) {
                            if (sib === h) return;
                            var sibBody = sib.nextElementSibling;
                            var sibChev = sib.querySelector('.exo-l1-chevron');
                            if (sibBody) sibBody.style.display = 'none';
                            if (sibChev) { sibChev.style.transform = ''; sibChev.style.color = ''; }
                            if (sibBody) {
                                sibBody.querySelectorAll('.exo-l2-header').forEach(function(l2h) {
                                    var l2b = l2h.nextElementSibling;
                                    var l2c = l2h.querySelector('.exo-l2-chevron');
                                    if (l2b) l2b.style.display = 'none';
                                    if (l2c) { l2c.style.transform = ''; l2c.style.color = ''; }
                                });
                            }
                        });
                    }
 
                    if (isOpen) {
                        body.style.display = 'none';
                        chev.style.transform = '';
                        chev.style.color = '';
                        body.querySelectorAll('.exo-l2-header').forEach(function(l2h) {
                            var l2b = l2h.nextElementSibling;
                            var l2c = l2h.querySelector('.exo-l2-chevron');
                            if (l2b) l2b.style.display = 'none';
                            if (l2c) { l2c.style.transform = ''; l2c.style.color = ''; }
                        });
                    } else {
                        body.style.display = 'flex';
                        body.style.flexDirection = 'column';
                        chev.style.transform = 'rotate(90deg)';
                        chev.style.color = '#0d4dff';
                    }
                });
            });
 
            /* === NIVEAU 2 — déplie/replie les marques === */
            document.querySelectorAll('.exo-l2-header').forEach(function(h) {
                var body = h.nextElementSibling;
                var chev = h.querySelector('.exo-l2-chevron');
                body.style.display = 'none';
 
                h.addEventListener('click', function(e) {
                    if (e.target.tagName === 'A') return;
                    e.preventDefault();
                    var isOpen = body.style.display !== 'none';
 
                    /* Ferme tous les L2 du même L1 */
                    var parentL1 = h.closest('.exo-l1-body');
                    if (parentL1) {
                        parentL1.querySelectorAll('.exo-l2-header').forEach(function(sib) {
                            if (sib === h) return;
                            var sibBody = sib.nextElementSibling;
                            var sibChev = sib.querySelector('.exo-l2-chevron');
                            if (sibBody) sibBody.style.display = 'none';
                            if (sibChev) { sibChev.style.transform = ''; sibChev.style.color = ''; }
                        });
                    }
 
                    if (isOpen) {
                        body.style.display = 'none';
                        chev.style.transform = '';
                        chev.style.color = '';
                    } else {
                        body.style.display = 'flex';
                        body.style.flexDirection = 'column';
                        chev.style.transform = 'rotate(90deg)';
                        chev.style.color = '#0d4dff';
                    }
                });
            });
 
            /* === LIENS sidebar — chargent dans l'iframe === */
            document.querySelectorAll('.exo-l1-header a, .exo-l2-header a, .exo-leaf').forEach(function(a) {
                a.addEventListener('click', function(e) {
                    var href = a.getAttribute('href');
                    if (!href || href === '#') return;
                    /* Le target="exo-shop-frame" s'occupe du chargement dans l'iframe */
                });
            });
 
        });
        ]]>
        </script>
