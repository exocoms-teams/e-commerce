<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="dashboard_menu" name="Dashboard Accueil Carousels">

        <div class="exo-carousels-fullwidth">

            <!-- ── NOUVEAUTÉS ── -->
            <div class="exo-products-section">
                <div class="exo-section-header">
                    <h3>Nouveautés</h3>
                    <a href="/shop">Voir plus</a>
                </div>
                <div class="exo-carousel-wrapper">
                    <button class="exo-carousel-btn exo-carousel-prev" data-target="carousel-new">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <div class="exo-products-carousel" id="carousel-new">
                        <t t-set="new_products"
                            t-value="request.env['product.template'].sudo().search([
                                ('is_published', '=', True)
                            ], limit=8, order='create_date desc')"/>
                        <t t-foreach="new_products" t-as="product">
                            <t t-set="ribbon"
                                t-value="request.env['product.ribbon'].sudo().browse([])"/>
                            <t t-set="product_variants"
                                t-value="{product: product.product_variant_id}"/>
                            <t t-set="previewed_attribute_values" t-value="{}"/>
                            <t t-set="product_href"
                                t-value="'/shop/' + slug(product)"/>
                            <t t-set="show_ribbons" t-value="False"/>
                            <t t-set="show_variations" t-value="False"/>
                            <div class="exo-product-card-big">
                                <t t-call="website_sale.products_item"/>
                            </div>
                        </t>
                    </div>
                    <button class="exo-carousel-btn exo-carousel-next" data-target="carousel-new">
                        <i class="fa fa-chevron-right"/>
                    </button>
                </div>
            </div>

            <!-- ── MEILLEURES VENTES ── -->
            <div class="exo-products-section">
                <div class="exo-section-header">
                    <h3>Meilleures ventes</h3>
                    <a href="/shop">Voir plus</a>
                </div>
                <div class="exo-carousel-wrapper">
                    <button class="exo-carousel-btn exo-carousel-prev" data-target="carousel-best">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <div class="exo-products-carousel" id="carousel-best">
                        <t t-set="best_products"
                            t-value="request.env['product.template'].sudo().search([
                                ('is_published', '=', True)
                            ], limit=8, order='write_date desc')"/>
                        <t t-foreach="best_products" t-as="product">
                            <t t-set="ribbon"
                                t-value="request.env['product.ribbon'].sudo().browse([])"/>
                            <t t-set="product_variants"
                                t-value="{product: product.product_variant_id}"/>
                            <t t-set="previewed_attribute_values" t-value="{}"/>
                            <t t-set="product_href"
                                t-value="'/shop/' + slug(product)"/>
                            <t t-set="show_ribbons" t-value="False"/>
                            <t t-set="show_variations" t-value="False"/>
                            <div class="exo-product-card-big">
                                <t t-call="website_sale.products_item"/>
                            </div>
                        </t>
                    </div>
                    <button class="exo-carousel-btn exo-carousel-next" data-target="carousel-best">
                        <i class="fa fa-chevron-right"/>
                    </button>
                </div>
            </div>

            <!-- ── VUS RÉCEMMENT ── -->
            <div class="exo-products-section">
                <div class="exo-section-header">
                    <h3>Vus récemment</h3>
                    <a href="/shop">Voir plus</a>
                </div>
                <div class="exo-carousel-wrapper">
                    <button class="exo-carousel-btn exo-carousel-prev" data-target="carousel-recent">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <div class="exo-products-carousel" id="carousel-recent">
                        <t t-set="recent_ids"
                            t-value="request.session.get('website_sale_history', [])[:8]"/>
                        <t t-set="recent_products"
                            t-value="request.env['product.template'].sudo().browse(recent_ids).filtered('is_published')"/>
                        <t t-if="recent_products">
                            <t t-foreach="recent_products" t-as="product">
                                <t t-set="ribbon"
                                    t-value="request.env['product.ribbon'].sudo().browse([])"/>
                                <t t-set="product_variants"
                                    t-value="{product: product.product_variant_id}"/>
                                <t t-set="previewed_attribute_values" t-value="{}"/>
                                <t t-set="product_href"
                                    t-value="'/shop/' + slug(product)"/>
                                <t t-set="show_ribbons" t-value="False"/>
                                <t t-set="show_variations" t-value="False"/>
                                <div class="exo-product-card-big">
                                    <t t-call="website_sale.products_item"/>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="exo-product-card-big d-flex align-items-center justify-content-center text-muted" style="min-width:200px">
                                Aucun produit consulté récemment.
                            </div>
                        </t>
                    </div>
                    <button class="exo-carousel-btn exo-carousel-next" data-target="carousel-recent">
                        <i class="fa fa-chevron-right"/>
                    </button>
                </div>
            </div>

        </div>

        <script><![CDATA[
        (function() {
            document.querySelectorAll('.exo-carousel-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var id  = btn.getAttribute('data-target');
                    var el  = document.getElementById(id);
                    if (!el) return;
                    var card = el.querySelector('.exo-product-card-big');
                    var w    = card ? card.offsetWidth + 16 : 300;
                    var dir  = btn.classList.contains('exo-carousel-prev') ? -1 : 1;
                    el.scrollBy({ left: dir * w, behavior: 'smooth' });
                });
            });
            ['carousel-new', 'carousel-best', 'carousel-recent'].forEach(function(id) {
                var el = document.getElementById(id);
                if (!el) return;
                setInterval(function() {
                    var max = el.scrollWidth - el.clientWidth;
                    if (el.scrollLeft >= max - 10) {
                        el.scrollTo({ left: 0, behavior: 'smooth' });
                    } else {
                        var card = el.querySelector('.exo-product-card-big');
                        var w = card ? card.offsetWidth + 16 : 300;
                        el.scrollBy({ left: w, behavior: 'smooth' });
                    }
                }, 4000);
            });
        })();
        ]]></script>

    </template>

</odoo>