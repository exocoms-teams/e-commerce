<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ACCUEIL — carousels uniquement -->
    <template id="dashboard_menu" name="Dashboard Accueil Carousels">

        <div class="exo-carousels-fullwidth">

            <!-- NOUVEAUTÉS -->
            <div class="exo-products-section">
                <div class="exo-section-header">
                    <h3>Nouveautés</h3>
                    <a href="/boutique">Voir plus</a>
                </div>
                <div class="exo-products-carousel" id="carousel-new">
                    <t t-set="new_products"
                        t-value="request.env['product.template'].sudo().search([('is_published', '=', True)], limit=5, order='create_date desc')" />
                    <t t-foreach="new_products" t-as="product">
                        <a t-attf-href="/shop/{{ slug(product) }}"
                            class="exo-product-card exo-product-card-big">
                            <div class="exo-product-card-img-wrap">
                                <img
                                    t-attf-src="/web/image/product.template/{{ product.id }}/image_512"
                                    t-att-alt="product.name" />
                            </div>
                            <div class="exo-product-card-body">
                                <h4 t-esc="product.name" />
                                <p t-esc="product.categ_id.name" />
                                <span>
                                    <t t-esc="product.currency_id.symbol" />
                                    <t t-esc="'%.2f' % product.list_price" />
                                </span>
                            </div>
                        </a>
                    </t>
                </div>
            </div>

            <!-- MEILLEURES VENTES -->
            <div class="exo-products-section">
                <div class="exo-section-header">
                    <h3>Meilleures ventes</h3>
                    <a href="/boutique">Voir plus</a>
                </div>
                <div class="exo-products-carousel" id="carousel-best">
                    <t t-set="best_products"
                        t-value="request.env['product.template'].sudo().search([('is_published', '=', True)], limit=5, order='write_date desc')" />
                    <t t-foreach="best_products" t-as="product">
                        <a t-attf-href="/shop/{{ slug(product) }}"
                            class="exo-product-card exo-product-card-big">
                            <div class="exo-product-card-img-wrap">
                                <img
                                    t-attf-src="/web/image/product.template/{{ product.id }}/image_512"
                                    t-att-alt="product.name" />
                            </div>
                            <div class="exo-product-card-body">
                                <h4 t-esc="product.name" />
                                <p t-esc="product.categ_id.name" />
                                <span>
                                    <t t-esc="product.currency_id.symbol" />
                                    <t t-esc="'%.2f' % product.list_price" />
                                </span>
                            </div>
                        </a>
                    </t>
                </div>
            </div>

        </div>

    </template>

</odoo>