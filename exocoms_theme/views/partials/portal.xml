<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        PORTAL LAYOUT — applique le header/footer Exocoms sur les pages portail.
        portal.frontend_layout hérite de website.layout, donc le header/footer
        est déjà géré par website_layout_custom (boutique.xml).
        On n'a pas besoin de les remplacer ici — ce fichier peut rester minimal.
    -->
    <template id="exo_portal_layout"
              inherit_id="portal.frontend_layout"
              name="Portal Custom Header Footer">

        <!-- Le header/footer est géré par website_layout_custom qui hérite
             de website.layout, parent commun de portal.frontend_layout.
             Aucune modification nécessaire ici. -->

    </template>

</odoo>