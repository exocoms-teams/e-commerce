<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="boutique_sidebar"
              inherit_id="website_sale.products"
              name="Boutique Sidebar">
        <xpath expr="//div[contains(@class,'o_wsale_products_grid_before_rail')]" position="replace">
            <div class="o_wsale_products_grid_before_rail vh-100 overflow-y-scroll px-2">
                <t t-call="exocoms_theme.dashboard_menu_boutiques_sidebar"/>
            </div>
        </xpath>
    </template>

    <template id="website_layout_custom"
              inherit_id="website.layout"
              name="Custom Header Footer">
        <xpath expr="//header[@id='top']" position="replace">
            <t t-call="exocoms_theme.custom_header"/>
        </xpath>
        <xpath expr="//footer" position="replace">
            <t t-call="exocoms_theme.custom_footer"/>
        </xpath>
    </template>

</odoo>