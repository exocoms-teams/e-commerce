<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="boutique_inject_sidebar"
              inherit_id="website_sale.products"
              name="Boutique — Sidebar Custom">

        <!-- Injecte notre sidebar avant la grille produits -->
        <xpath expr="//div[@id='products_grid']" position="before">
            <t t-call="exocoms_theme.dashboard_menu_boutiques_sidebar"/>
        </xpath>

    </template>

</odoo>