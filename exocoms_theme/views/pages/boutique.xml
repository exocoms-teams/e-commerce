<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        BOUTIQUE SIDEBAR — remplace l'aside natif du shop par la sidebar Exocoms.
        position="replace" sur l'aside est safe : l'aside n'est pas un hook éditeur.
    -->
    <template id="boutique_sidebar"
              inherit_id="website_sale.products"
              name="Boutique Sidebar">

        <xpath expr="//t[@t-set='hasLeftColumn']" position="replace">
            <t t-set="hasLeftColumn" t-value="True"/>
        </xpath>

        <xpath expr="//t[@t-set='wsale_has_filters_btn']" position="replace">
            <t t-set="wsale_has_filters_btn" t-value="False"/>
        </xpath>

        <xpath expr="//t[@t-set='wsale_has_filters_btn_lg']" position="replace">
            <t t-set="wsale_has_filters_btn_lg" t-value="False"/>
        </xpath>

        <xpath expr="//aside[@id='products_grid_before']" position="replace">
            <aside id="products_grid_before"
                   class="position-sticky align-self-start col-3 clearfix pt-2">
                <t t-call="exocoms_theme.dashboard_menu_boutiques_sidebar"/>
            </aside>
        </xpath>

    </template>

    <!--
        HEADER / FOOTER CUSTOM — remplace le header et footer natifs Odoo.

        En mode visiteur  → ton header/footer Exocoms s'affiche.
        En mode éditeur   → le header/footer natif Odoo est conservé pour que
                            l'éditeur website garde tous ses hooks d'édition.

        La variable "editable_mode" est injectée par Odoo automatiquement
        quand l'utilisateur clique sur "Edit" dans le backend website.
    -->
    <template id="website_layout_custom"
              inherit_id="website.layout"
              name="Custom Header Footer">

        <xpath expr="//header[@id='top']" position="replace">
            <t t-if="not editable_mode">
                <t t-call="exocoms_theme.custom_header"/>
            </t>
            <t t-else="">
                <!-- Mode éditeur : on garde le header natif Odoo intact -->
                <header id="top"/>
            </t>
        </xpath>

        <xpath expr="//footer" position="replace">
            <t t-if="not editable_mode">
                <t t-call="exocoms_theme.custom_footer"/>
            </t>
            <!-- Mode éditeur : footer natif supprimé proprement, pas de doublon -->
        </xpath>

    </template>

</odoo>