<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="boutique_inject_sidebar"
              inherit_id="website_sale.products"
              name="Boutique — Sidebar Custom">

        <!-- Remplace le layout natif website.layout par notre custom_layout -->
        <xpath expr="//t[@t-call='website.layout']" position="attributes">
            <attribute name="t-call">exocoms_theme.custom_layout</attribute>
        </xpath>

        <!-- Injecte notre sidebar AVANT la colonne produits -->
        <xpath expr="//div[@id='products_grid']" position="before">
            <t t-call="exocoms_theme.dashboard_menu_boutiques_sidebar"/>
        </xpath>

    </template>

</odoo>