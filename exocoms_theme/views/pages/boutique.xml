<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="boutique_sidebar"
              inherit_id="website_sale.products"
              name="Boutique Sidebar">

        <xpath expr="//t[@t-set='hasLeftColumn']" position="replace">
            <t t-set="hasLeftColumn" t-value="True"/>
        </xpath>

        <xpath expr="//t[@t-set='wsale_has_filters_btn']" position="replace">
            <t t-set="wsale_has_filters_btn" t-value="False"/>
        </xpath>

        <xpath expr="//aside[@id='products_grid_before']" position="replace">
            <aside id="products_grid_before"
                   class="position-sticky align-self-start col-3 clearfix pt-2">
                <t t-call="exocoms_theme.dashboard_menu_boutiques_sidebar"/>
            </aside>
        </xpath>

    </template>

    <template id="website_layout_custom"
              inherit_id="website.layout"
              name="Custom Header Footer">
        <xpath expr="//header[@id='top']" position="replace">
            <t t-call="exocoms_theme.custom_header"/>
        </xpath>
        <xpath expr="//footer" position="replace">
            <t t-call="exocoms_theme.custom_footer"/>
        </xpath>
    </template>

</odoo>