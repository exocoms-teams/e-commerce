<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template
        id="home"
        name="Homepage">

        <t t-call="website.layout">

              <!-- CSS -->
            <link
                rel="stylesheet"
                href="/exocoms_theme/static/src/css/layout.css"/>

            <link
                rel="stylesheet"
                href="/exocoms_theme/static/src/css/header.css"/>

            <link
                rel="stylesheet"
                href="/exocoms_theme/static/src/css/hero.css"/>

            <link
                rel="stylesheet"
                href="/exocoms_theme/static/src/css/footer.css"/>

            <!-- JS -->
            <script
                type="text/javascript"
                src="/exocoms_theme/static/src/js/main.js">
            </script>

            <!-- HEADER -->
            <t t-call="exocoms_theme.custom_header" />

            <!-- HERO -->
            <t t-call="exocoms_theme.hero_section" />

            <!-- FOOTER -->
            <t t-call="exocoms_theme.custom_footer" />

        </t>

    </template>

</odoo>