<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="home" name="Accueil">

        <t t-call="exocoms_theme.custom_layout">

            <!-- Hero — texte éditable -->
            <t t-call="exocoms_theme.hero_section"/>

            <!-- Zone libre accueil — le client peut ajouter des blocs ici -->
            <div class="oe_structure oe_empty" id="oe_structure_home_after_hero"/>

            <!-- Carousels produits -->
            <t t-call="exocoms_theme.dashboard_menu"/>

            <!-- Zone libre entre carousels et features -->
            <div class="oe_structure oe_empty" id="oe_structure_home_middle"/>

            <!-- Témoignages + Features + Paiement -->
            <t t-call="exocoms_theme.features_section"/>

            <!-- Zone libre en bas de page -->
            <div class="oe_structure oe_empty" id="oe_structure_home_bottom"/>

        </t>

    </template>

</odoo>