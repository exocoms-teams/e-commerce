<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="avis_page" name="Avis clients">
        <t t-call="exocoms_theme.custom_layout">

            <!-- SEO PAGE AVIS -->
            <t t-set="head">
                <title>Avis clients | Exocoms Group — Ce que pensent nos clients</title>
                <meta name="description" content="Découvrez les avis vérifiés de nos clients professionnels sur les terminaux de paiement TPE, caisses enregistreuses et services Exocoms Group."/>
                <meta name="keywords" content="avis clients TPE, avis terminal paiement, témoignages Exocoms, avis caisse enregistreuse"/>
                <meta name="robots" content="index, follow"/>
                <link rel="canonical" href="https://www.exocoms.fr/avis"/>
                <meta property="og:type" content="website"/>
                <meta property="og:title" content="Avis clients | Exocoms Group"/>
                <meta property="og:description" content="Avis vérifiés de nos clients professionnels sur nos terminaux de paiement et services."/>
                <meta property="og:image" content="/exocoms_theme/static/src/img/EXOCOMS.png"/>
                <meta property="og:url" content="https://www.exocoms.fr/avis"/>
                <meta name="twitter:card" content="summary_large_image"/>
                <meta name="twitter:title" content="Avis clients Exocoms Group"/>
                <meta name="twitter:description" content="Avis vérifiés de nos clients professionnels."/>
                <meta name="twitter:image" content="/exocoms_theme/static/src/img/EXOCOMS.png"/>
                <script type="application/ld+json">
                {
                    "@context": "https://schema.org",
                    "@type": "WebPage",
                    "name": "Avis clients Exocoms Group",
                    "url": "https://www.exocoms.fr/avis",
                    "isPartOf": {
                        "@type": "Organization",
                        "name": "Exocoms Group"
                    }
                }
                </script>
            </t>

            <t t-call="exocoms_theme.avis_hero"/>
            <div class="oe_structure oe_empty" id="oe_structure_avis_after_hero"/>
            <t t-call="exocoms_theme.avis_content"/>
            <div class="oe_structure oe_empty" id="oe_structure_avis_bottom"/>

        </t>
    </template>

</odoo>
