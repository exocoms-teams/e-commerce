<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="infogerance_page" name="Infogérance">
        <t t-call="exocoms_theme.custom_layout">

            <t t-set="head">
                <title>Infogérance IT | Exocoms Group — Gestion &amp; Maintenance Informatique</title>
                <meta name="description" content="Exocoms Group propose des services d'infogérance IT complets : maintenance, supervision, cybersécurité, cloud et support technique pour entreprises."/>
                <meta name="keywords" content="infogérance, maintenance informatique, cybersécurité, cloud, supervision réseau, support IT, managed IT services"/>
                <meta name="robots" content="index, follow"/>
                <link rel="canonical" href="https://www.exocoms.fr/infogerance"/>
                <meta property="og:type" content="website"/>
                <meta property="og:title" content="Infogérance IT | Exocoms Group — Gestion &amp; Maintenance Informatique"/>
                <meta property="og:description" content="Services d'infogérance IT : maintenance, supervision, cybersécurité, cloud et support technique pour entreprises."/>
                <meta property="og:image" content="/exocoms_theme/static/src/img/EXOCOMS.png"/>
                <meta property="og:url" content="https://www.exocoms.fr/infogerance"/>
                <meta name="twitter:card" content="summary_large_image"/>
                <meta name="twitter:title" content="Infogérance IT | Exocoms Group"/>
                <meta name="twitter:description" content="Services d'infogérance IT complets pour les entreprises."/>
                <meta name="twitter:image" content="/exocoms_theme/static/src/img/EXOCOMS.png"/>
                <script type="application/ld+json">
                {
                    "@context": "https://schema.org",
                    "@type": "Service",
                    "name": "Infogérance IT Exocoms Group",
                    "description": "Services complets d'infogérance IT : maintenance, supervision, cybersécurité, cloud et support technique.",
                    "url": "https://www.exocoms.fr/infogerance",
                    "provider": {
                        "@type": "Organization",
                        "name": "Exocoms Group",
                        "telephone": "+33-01-84-79-37-55",
                        "address": {
                            "@type": "PostalAddress",
                            "addressLocality": "Paris",
                            "addressCountry": "FR"
                        }
                    },
                    "areaServed": {
                        "@type": "Country",
                        "name": "France"
                    }
                }
                </script>
            </t>

            <!-- HERO -->
            <section class="s_exocoms_services_hero o_colored_level pt32 pb32 oe_img_bg o_bg_img_center"
                     data-snippet="s_exocoms_services_hero"
                     data-name="Infogerance Hero"
                     style="background-image: url('/exocoms_theme/static/src/img/heroservice.jpg');">
                <div class="o_we_bg_filter bg-black-50"/>
                <div class="container s_allow_columns">
                    <div class="row">
                        <div class="col-lg-9 pt32 pb32 mx-auto">
                            <t t-if="request.env.lang == 'fr_FR'">
                                <div class="s_exocoms_services_hero_badge oe_editable">
                                    <i class="fa fa-server"/>
                                    Infogérance IT
                                </div>
                                <h1 class="text-white oe_editable">
                                    L'infogérance informatique en toute tranquillité avec Exocoms
                                </h1>
                                <p class="lead text-white-75 oe_editable" style="font-weight: 700;">
                                    Maintenance, supervision, cybersécurité et cloud —
                                    confiez votre système d'information à nos experts.
                                </p>
                                <div class="s_exocoms_services_hero_tags oe_editable">
                                    <a href="#maintenance" class="s_exocoms_services_hero_tag">Maintenance</a>
                                    <a href="#supervision" class="s_exocoms_services_hero_tag">Supervision</a>
                                    <a href="#cybersecurite" class="s_exocoms_services_hero_tag">Cybersécurité</a>
                                    <a href="#cloud" class="s_exocoms_services_hero_tag">Cloud</a>
                                    <a href="#support" class="s_exocoms_services_hero_tag">Support</a>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="s_exocoms_services_hero_badge oe_editable">
                                    <i class="fa fa-server"/>
                                    Managed IT Services
                                </div>
                                <h1 class="text-white oe_editable">
                                    Managed IT services with peace of mind from Exocoms
                                </h1>
                                <p class="lead text-white-75 oe_editable" style="font-weight: 700;">
                                    Maintenance, monitoring, cybersecurity and cloud —
                                    entrust your information system to our experts.
                                </p>
                                <div class="s_exocoms_services_hero_tags oe_editable">
                                    <a href="#maintenance" class="s_exocoms_services_hero_tag">Maintenance</a>
                                    <a href="#supervision" class="s_exocoms_services_hero_tag">Monitoring</a>
                                    <a href="#cybersecurite" class="s_exocoms_services_hero_tag">Cybersecurity</a>
                                    <a href="#cloud" class="s_exocoms_services_hero_tag">Cloud</a>
                                    <a href="#support" class="s_exocoms_services_hero_tag">Support</a>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </section>

            <div class="oe_structure oe_empty" id="oe_structure_infogerance_after_hero"/>

            <!-- SERVICES INFOGÉRANCE -->
            <section class="services-content-section" id="maintenance">
                <div class="container">
                    <div class="section-header">
                        <t t-if="request.env.lang == 'fr_FR'">
                            <h2>Nos services d'infogérance</h2>
                            <p>Des solutions complètes pour la gestion de votre infrastructure IT</p>
                        </t>
                        <t t-else="">
                            <h2>Our managed IT services</h2>
                            <p>Complete solutions for managing your IT infrastructure</p>
                        </t>
                    </div>
                    <div class="services-grid">
                        <t t-if="request.env.lang == 'fr_FR'">
                            <!-- MAINTENANCE -->
                            <div class="service-detail-card" id="supervision">
                                <div class="service-detail-card-img">
                                    <img src="/exocoms_theme/static/src/img/4.webp" alt="Maintenance informatique"/>
                                </div>
                                <div class="service-detail-card-body">
                                    <h3>Maintenance informatique</h3>
                                    <p>La <strong>maintenance informatique</strong> garantit le bon fonctionnement
                                        de vos équipements (serveurs, postes de travail, réseaux). Nous assurons
                                        la maintenance préventive et corrective pour minimiser les interruptions
                                        et optimiser les performances de votre infrastructure.</p>
                                    <a href="/shop/category/informatique-reseaux-1" class="btn btn-primary mt16">En savoir plus</a>
                                </div>
                            </div>
                            <!-- SUPERVISION -->
                            <div class="service-detail-card">
                                <div class="service-detail-card-img">
                                    <img src="/exocoms_theme/static/src/img/3.webp" alt="Supervision réseau"/>
                                </div>
                                <div class="service-detail-card-body">
                                    <h3>Supervision réseau</h3>
                                    <p>La <strong>supervision réseau</strong> permet de surveiller en temps réel
                                        l'état de votre infrastructure IT. Alertes, métriques et rapports
                                        automatiques vous permettent d'anticiper les pannes et d'assurer une
                                        disponibilité optimale de vos services.</p>
                                    <a href="/shop/category/informatique-reseaux-1" class="btn btn-primary mt16">En savoir plus</a>
                                </div>
                            </div>
                            <!-- CYBERSÉCURITÉ -->
                            <div class="service-detail-card" id="cybersecurite">
                                <div class="service-detail-card-img">
                                    <img src="/exocoms_theme/static/src/img/2.webp" alt="Cybersécurité"/>
                                </div>
                                <div class="service-detail-card-body">
                                    <h3>Cybersécurité</h3>
                                    <p>La <strong>cybersécurité</strong> protège vos données et vos systèmes
                                        contre les menaces informatiques. Audit de sécurité, pare-feu,
                                        antivirus, sauvegarde sécurisée et plan de reprise d'activité
                                        (PRA) pour une protection complète de votre entreprise.</p>
                                    <a href="/shop/category/informatique-reseaux-1" class="btn btn-primary mt16">En savoir plus</a>
                                </div>
                            </div>
                            <!-- CLOUD -->
                            <div class="service-detail-card" id="cloud">
                                <div class="service-detail-card-img">
                                    <img src="/exocoms_theme/static/src/img/6.webp" alt="Cloud &amp; Hébergement"/>
                                </div>
                                <div class="service-detail-card-body">
                                    <h3>Cloud &amp; Hébergement</h3>
                                    <p>Le <strong>Cloud</strong> vous offre flexibilité et scalabilité pour
                                        héberger vos données et applications. Migration, gestion et
                                        optimisation de votre environnement cloud (serveurs dédiés,
                                        VPS, stockage distant, SaaS) adaptés à vos besoins.</p>
                                    <a href="/shop/category/informatique-reseaux-1" class="btn btn-primary mt16">En savoir plus</a>
                                </div>
                            </div>
                            <!-- SUPPORT TECHNIQUE -->
                            <div class="service-detail-card" id="support">
                                <div class="service-detail-card-img">
                                    <img src="/exocoms_theme/static/src/img/1.webp" alt="Support technique"/>
                                </div>
                                <div class="service-detail-card-body">
                                    <h3>Support technique</h3>
                                    <p>Le <strong>support technique</strong> vous accompagne au quotidien
                                        pour résoudre vos problèmes informatiques. Helpdesk, assistance
                                        à distance et intervention sur site pour une prise en charge
                                        rapide et efficace de vos incidents.</p>
                                    <a href="/shop/category/informatique-reseaux-1" class="btn btn-primary mt16">En savoir plus</a>
                                </div>
                            </div>
                            <!-- SAUVEGARDE -->
                            <div class="service-detail-card">
                                <div class="service-detail-card-img">
                                    <img src="/exocoms_theme/static/src/img/5.webp" alt="Sauvegarde"/>
                                </div>
                                <div class="service-detail-card-body">
                                    <h3>Sauvegarde &amp; Continuité</h3>
                                    <p>La <strong>sauvegarde</strong> et la <strong>continuité d'activité</strong>
                                        assurent la protection de vos données critiques. Solutions de backup
                                        automatisées, réplication et restauration rapide pour garantir
                                        l'intégrité et la disponibilité de vos informations.</p>
                                    <a href="/shop/category/informatique-reseaux-1" class="btn btn-primary mt16">En savoir plus</a>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <!-- MAINTENANCE -->
                            <div class="service-detail-card" id="monitoring">
                                <div class="service-detail-card-img">
                                    <img src="/exocoms_theme/static/src/img/4.webp" alt="IT Maintenance"/>
                                </div>
                                <div class="service-detail-card-body">
                                    <h3>IT Maintenance</h3>
                                    <p><strong>IT maintenance</strong> ensures the smooth operation of your
                                        equipment (servers, workstations, networks). We provide preventive
                                        and corrective maintenance to minimise downtime and optimise your
                                        infrastructure performance.</p>
                                    <a href="/shop/category/informatique-reseaux-1" class="btn btn-primary mt16">Learn more</a>
                                </div>
                            </div>
                            <!-- MONITORING -->
                            <div class="service-detail-card">
                                <div class="service-detail-card-img">
                                    <img src="/exocoms_theme/static/src/img/3.webp" alt="Network Monitoring"/>
                                </div>
                                <div class="service-detail-card-body">
                                    <h3>Network Monitoring</h3>
                                    <p><strong>Network monitoring</strong> provides real-time surveillance of
                                        your IT infrastructure. Automatic alerts, metrics and reports help
                                        you anticipate failures and ensure optimal service availability.</p>
                                    <a href="/shop/category/informatique-reseaux-1" class="btn btn-primary mt16">Learn more</a>
                                </div>
                            </div>
                            <!-- CYBERSECURITY -->
                            <div class="service-detail-card" id="cybersecurity">
                                <div class="service-detail-card-img">
                                    <img src="/exocoms_theme/static/src/img/2.webp" alt="Cybersecurity"/>
                                </div>
                                <div class="service-detail-card-body">
                                    <h3>Cybersecurity</h3>
                                    <p><strong>Cybersecurity</strong> protects your data and systems against
                                        IT threats. Security audit, firewall, antivirus, secure backup and
                                        business continuity plan (BCP) for complete protection.</p>
                                    <a href="/shop/category/informatique-reseaux-1" class="btn btn-primary mt16">Learn more</a>
                                </div>
                            </div>
                            <!-- CLOUD -->
                            <div class="service-detail-card" id="cloud-en">
                                <div class="service-detail-card-img">
                                    <img src="/exocoms_theme/static/src/img/6.webp" alt="Cloud &amp; Hosting"/>
                                </div>
                                <div class="service-detail-card-body">
                                    <h3>Cloud &amp; Hosting</h3>
                                    <p><strong>Cloud</strong> offers flexibility and scalability for hosting
                                        your data and applications. Migration, management and optimisation
                                        of your cloud environment (dedicated servers, VPS, remote storage,
                                        SaaS) tailored to your needs.</p>
                                    <a href="/shop/category/informatique-reseaux-1" class="btn btn-primary mt16">Learn more</a>
                                </div>
                            </div>
                            <!-- SUPPORT -->
                            <div class="service-detail-card" id="support-en">
                                <div class="service-detail-card-img">
                                    <img src="/exocoms_theme/static/src/img/1.webp" alt="Technical Support"/>
                                </div>
                                <div class="service-detail-card-body">
                                    <h3>Technical Support</h3>
                                    <p><strong>Technical support</strong> helps you resolve your IT issues
                                        on a daily basis. Helpdesk, remote assistance and on-site
                                        intervention for fast and efficient incident handling.</p>
                                    <a href="/shop/category/informatique-reseaux-1" class="btn btn-primary mt16">Learn more</a>
                                </div>
                            </div>
                            <!-- BACKUP -->
                            <div class="service-detail-card">
                                <div class="service-detail-card-img">
                                    <img src="/exocoms_theme/static/src/img/5.webp" alt="Backup"/>
                                </div>
                                <div class="service-detail-card-body">
                                    <h3>Backup &amp; Continuity</h3>
                                    <p><strong>Backup</strong> and <strong>business continuity</strong> ensure
                                        the protection of your critical data. Automated backup solutions,
                                        replication and fast restoration to guarantee the integrity and
                                        availability of your information.</p>
                                    <a href="/shop/category/informatique-reseaux-1" class="btn btn-primary mt16">Learn more</a>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </section>

            <div class="oe_structure oe_empty" id="oe_structure_infogerance_middle"/>

            <!-- POURQUOI NOUS -->
            <section class="services-features-section">
                <div class="container">
                    <div class="section-header">
                        <t t-if="request.env.lang == 'fr_FR'">
                            <h2>Pourquoi choisir Exocoms pour votre infogérance ?</h2>
                            <p>Un partenaire de confiance pour la gestion de votre IT</p>
                        </t>
                        <t t-else="">
                            <h2>Why choose Exocoms for managed IT?</h2>
                            <p>A trusted partner for your IT management</p>
                        </t>
                    </div>
                    <div class="services-features-grid">
                        <t t-if="request.env.lang == 'fr_FR'">
                            <div class="services-feature-card hover-lift">
                                <i class="fa fa-clock"></i>
                                <h4>Réactivité 24/7</h4>
                                <p>Intervention rapide sur site ou à distance, y compris les jours fériés.</p>
                            </div>
                            <div class="services-feature-card hover-lift">
                                <i class="fa fa-certificate"></i>
                                <h4>Expertise certifiée</h4>
                                <p>Une équipe de professionnels qualifiés à votre service.</p>
                            </div>
                            <div class="services-feature-card hover-lift">
                                <i class="fa fa-chart-line"></i>
                                <h4>Suivi personnalisé</h4>
                                <p>Tableaux de bord, rapports mensuels et recommandations sur mesure.</p>
                            </div>
                            <div class="services-feature-card hover-lift">
                                <i class="fa fa-euro-sign"></i>
                                <h4>Forfaits adaptés</h4>
                                <p>Des formules flexibles pour toutes les tailles d'entreprises.</p>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="services-feature-card hover-lift">
                                <i class="fa fa-clock"></i>
                                <h4>24/7 Responsiveness</h4>
                                <p>Fast on-site or remote intervention, including holidays.</p>
                            </div>
                            <div class="services-feature-card hover-lift">
                                <i class="fa fa-certificate"></i>
                                <h4>Certified expertise</h4>
                                <p>A team of qualified professionals at your service.</p>
                            </div>
                            <div class="services-feature-card hover-lift">
                                <i class="fa fa-chart-line"></i>
                                <h4>Personalised follow-up</h4>
                                <p>Dashboards, monthly reports and tailored recommendations.</p>
                            </div>
                            <div class="services-feature-card hover-lift">
                                <i class="fa fa-euro-sign"></i>
                                <h4>Flexible plans</h4>
                                <p>Adaptable plans for businesses of all sizes.</p>
                            </div>
                        </t>
                    </div>
                </div>
            </section>

            <!-- CTA ABONNEMENT -->
            <section class="exo-cta-section" style="background: #0d4dff; padding: 60px 0; text-align: center;">
                <div class="container">
                    <t t-if="request.env.lang == 'fr_FR'">
                        <h2 style="color: #fff; font-size: 32px; margin-bottom: 16px;">Vous avez un projet d'infogérance ?</h2>
                        <p style="color: rgba(255,255,255,0.85); font-size: 18px; max-width: 600px; margin: 0 auto 24px;">
                            Découvrez nos formules d'abonnement et laissez nos experts gérer votre infrastructure.
                        </p>
                        <a href="/shop/category/informatique-reseaux-1" class="btn btn-light btn-lg" style="font-weight: 700; padding: 14px 40px;">
                            Voir les abonnements <i class="fa fa-arrow-right ml8"/>
                        </a>
                    </t>
                    <t t-else="">
                        <h2 style="color: #fff; font-size: 32px; margin-bottom: 16px;">Have a managed IT project?</h2>
                        <p style="color: rgba(255,255,255,0.85); font-size: 18px; max-width: 600px; margin: 0 auto 24px;">
                            Discover our subscription plans and let our experts manage your infrastructure.
                        </p>
                        <a href="/shop/category/informatique-reseaux-1" class="btn btn-light btn-lg" style="font-weight: 700; padding: 14px 40px;">
                            View plans <i class="fa fa-arrow-right ml8"/>
                        </a>
                    </t>
                </div>
            </section>

            <div class="oe_structure oe_empty" id="oe_structure_infogerance_bottom"/>

        </t>
    </template>

</odoo>
