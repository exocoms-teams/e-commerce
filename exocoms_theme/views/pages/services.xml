<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="services_page" name="Nos Services">

        <t t-call="exocoms_theme.custom_layout">

            <!-- Hero services — texte éditable -->
            <t t-call="exocoms_theme.services_hero"/>

            <!-- Zone libre après hero -->
            <div class="oe_structure oe_empty" id="oe_structure_services_after_hero"/>

            <!-- Grille des métiers -->
            <t t-call="exocoms_theme.services_content"/>

            <!-- Zone libre entre services et features -->
            <div class="oe_structure oe_empty" id="oe_structure_services_middle"/>

            <!-- Pourquoi choisir EXOCOMS -->
            <t t-call="exocoms_theme.services_features"/>

            <!-- Processus -->
            <t t-call="exocoms_theme.process_section"/>

            <!-- Zone libre en bas -->
            <div class="oe_structure oe_empty" id="oe_structure_services_bottom"/>

        </t>

    </template>

</odoo>