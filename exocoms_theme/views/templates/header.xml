<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_header" name="Custom Header">


        <header class="exo-header">

            <div class="exo-header-container">

                <!-- LOGO -->

                <a href="/" class="exo-logo">

                    <img
                        src="/exocoms_theme/static/src/img/EXOCOMS.png"
                        alt="Exocoms Logo"/>

                </a>

                <!-- NAVIGATION -->

                <nav class="exo-nav">

                    <!-- ACCUEIL -->

                    <a href="/" class="exo-nav-link">
                        Accueil
                    </a>

                    <a href="/services" class="exo-nav-link">
                        <i class="fa fa-briefcase" /> Nos services </a>

                    <!-- INFORMATIQUE -->

                   

                </nav>

                <!-- ICONES -->

                <div class="exo-header-icons">

                    <a href="/shop/cart">
                        <i class="fa fa-shopping-cart"/>
                    </a>

                    <a href="/shop">
                        <i class="fa fa-search"/>
                    </a>

                    <a href="/my/home">
                        <i class="fa fa-user"/>
                    </a>

                </div>

            </div>

        </header>
        
        <script>

    document.addEventListener("DOMContentLoaded", function () {

        const dropdowns = document.querySelectorAll(".exo-dropdown");

        dropdowns.forEach(dropdown => {

            let timeout;

            dropdown.addEventListener("mouseenter", () => {

                clearTimeout(timeout);

                dropdown.classList.add("active");

            });

            dropdown.addEventListener("mouseleave", () => {

                timeout = setTimeout(() => {

                    dropdown.classList.remove("active");

                }, 300);

            });

        });

    });

</script>

    </template>

</odoo>