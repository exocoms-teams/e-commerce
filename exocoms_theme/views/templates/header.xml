<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         HEADER — héritage déclaratif de website.layout
         S'applique à TOUTES les pages du site (y compris les pages
         natives Odoo : panier, paiement, 404, compte client...)
         priority="1000" garantit la stabilité face à l'éditeur
         visuel ou d'autres extensions de website.layout.
         ═══════════════════════════════════════════════════════════ -->

    <template id="custom_header" inherit_id="website.layout" name="Exocoms Header" priority="1000">
        <xpath expr="//div[@id='wrapwrap']/header" position="replace">
            <header class="exo-header">
                <div class="exo-header-container">

                    <!-- LOGO -->
                    <a href="/" class="exo-logo">
                        <img src="/exocoms_theme/static/src/img/EXOCOMS.png"
                             alt="Exocoms Group — Terminaux de paiement et caisses enregistreuses"/>
                    </a>

                    <!-- NAVIGATION DESKTOP -->
                    <nav class="exo-nav" id="exo-nav" aria-label="Navigation principale">
                        <t t-set="current_path" t-value="request.httprequest.path"/>
                        <t t-set="is_shop" t-value="'/shop' in current_path"/>
                        <t t-set="is_services" t-value="'/services' in current_path"/>
                        <t t-set="is_home" t-value="not is_shop and not is_services"/>
                        <t t-if="request.env.lang == 'fr_FR'">
                            <a href="/" t-att-class="'exo-nav-link active' if is_home else 'exo-nav-link'">Accueil</a>
                            <a href="/shop" t-att-class="'exo-nav-link active' if is_shop else 'exo-nav-link'">Boutique</a>
                            <a href="/services" t-att-class="'exo-nav-link active' if is_services else 'exo-nav-link'">Nos services</a>
                        </t>
                        <t t-else="">
                            <a href="/en" t-att-class="'exo-nav-link active' if is_home else 'exo-nav-link'">Home</a>
                            <a href="/en/shop" t-att-class="'exo-nav-link active' if is_shop else 'exo-nav-link'">Shop</a>
                            <a href="/en/services" t-att-class="'exo-nav-link active' if is_services else 'exo-nav-link'">Our Services</a>
                        </t>
                    </nav>

                    <!-- ICONES DROITE -->
                    <div class="exo-header-icons">
                        <a href="/shop/cart" class="exo-icon-btn" title="Panier" aria-label="Panier">
                            <i class="fa fa-shopping-cart" aria-hidden="true"/>
                        </a>
                        <a href="/shop/wishlist" class="exo-icon-btn" title="Favoris" aria-label="Liste de souhaits">
                            <i class="fa fa-heart" aria-hidden="true"/>
                        </a>
                        <button type="button" class="exo-icon-btn" title="Rechercher" aria-label="Ouvrir la recherche"
                                data-bs-toggle="modal" data-bs-target="#o_search_modal">
                            <i class="fa fa-search" aria-hidden="true"/>
                        </button>
                        <!-- SÉLECTEUR DE LANGUE — natif Odoo -->
                        <t t-call="website.placeholder_header_language_selector">
                            <t t-set="_div_classes" t-valuef="exo-language-selector"/>
                        </t>

                        <div class="exo-profile-dropdown">
                            <button class="exo-icon-btn" aria-label="Mon compte" aria-expanded="false" aria-haspopup="true">
                                <i class="fa fa-user" aria-hidden="true"/>
                            </button>
                            <div class="exo-profile-menu" role="menu">
                                <t t-if="request.env.user._is_public()">
                                    <a href="/web/login" role="menuitem">
                                        <i class="fa fa-sign-in" aria-hidden="true"/>
                                        <t t-if="request.env.lang == 'fr_FR'">Connexion</t>
                                        <t t-else="">Sign in</t>
                                    </a>
                                </t>
                                <t t-else="">
                                    <a href="/my/home" role="menuitem">
                                        <i class="fa fa-user-circle" aria-hidden="true"/>
                                        <span>
                                            <t t-if="request.env.lang == 'fr_FR'">Mon compte</t>
                                            <t t-else="">My account</t>
                                        </span>
                                    </a>
                                    <a href="/web/session/logout?redirect=/" role="menuitem">
                                        <i class="fa fa-sign-out" aria-hidden="true"/>
                                        <span>
                                            <t t-if="request.env.lang == 'fr_FR'">Déconnexion</t>
                                            <t t-else="">Logout</t>
                                        </span>
                                    </a>
                                </t>
                            </div>
                        </div>

                        <!-- BURGER MENU MOBILE -->
                        <button class="exo-burger" id="exo-burger" type="button"
                                aria-label="Menu" aria-expanded="false" aria-controls="exo-nav">
                            <span></span>
                            <span></span>
                            <span></span>
                        </button>
                    </div>

                </div>

                <!-- MENU MOBILE DRAWER -->
                <div class="exo-mobile-nav" id="exo-mobile-nav" aria-hidden="true">
                    <nav aria-label="Navigation mobile">
                        <t t-if="request.env.lang == 'fr_FR'">
                            <a href="/" class="exo-mobile-link">Accueil</a>
                            <a href="/shop" class="exo-mobile-link">Boutique</a>
                            <a href="/services" class="exo-mobile-link">Nos services</a>
                        </t>
                        <t t-else="">
                            <a href="/en" class="exo-mobile-link">Home</a>
                            <a href="/en/shop" class="exo-mobile-link">Shop</a>
                            <a href="/en/services" class="exo-mobile-link">Our Services</a>
                        </t>
                    </nav>
                </div>

            </header>
        </xpath>
    </template>

</odoo>