<odoo>
    <template id="custom_header" name="Custom Header">
        <header class="exo-header">
            <div class="exo-header-container">
                <!--  LOGO  -->
                <a href="/" class="exo-logo">
                    <img src="/exocoms_theme/static/src/img/EXOCOMS.png" alt="Exocoms Logo" />
                </a>
                <!--  NAVIGATION  -->
                <nav class="exo-nav">
                    <a href="/" class="exo-nav-link">Accueil</a>
                    <a href="/services" class="exo-nav-link">
                        <i class="fa fa-briefcase" />
 Nos services </a>
                </nav>
                <!--  ICONES  -->
                <div class="exo-header-icons">
                    <!--  PANIER  -->
                    <a href="/shop/cart" class="exo-icon-btn" title="Panier">
                        <i class="fa fa-shopping-cart" />
                    </a>
                    <!--  SEARCH — formulaire simple natif Odoo  -->
                    <form class="exo-search-form" action="/shop" method="get">
                        <i class="fa fa-search exo-search-icon" />
                        <input type="search" name="search" class="exo-search-input" placeholder="Rechercher..." autocomplete="off" />
                        <button type="submit" class="exo-search-btn">
                            <i class="fa fa-arrow-right" />
                        </button>
                    </form>
                    <!--  PROFIL  -->
                    <div class="exo-profile-dropdown">
                        <button class="exo-profile-btn">
                            <i class="fa fa-user" />
                        </button>
                        <div class="exo-profile-menu">
                            <t t-if="request.env.user._is_public()">
                                <a href="/web/login">
                                    <i class="fa fa-sign-in" />
 Login </a>
                            </t>
                            <t t-else="">
                                <a href="/my/home">
                                    <i class="fa fa-user-circle" />
                                    <span>My Account</span>
                                </a>
                                <a href="/web/session/logout?redirect=/">
                                    <i class="fa fa-sign-out" />
                                    <span>Logout</span>
                                </a>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <script>
            <![CDATA[ document.addEventListener("DOMContentLoaded", function () { /* === PROFIL DROPDOWN === */ var profileDropdown = document.querySelector(".exo-profile-dropdown"); if (profileDropdown) { var profileTimeout; profileDropdown.addEventListener("mouseenter", function() { clearTimeout(profileTimeout); profileDropdown.classList.add("active"); }); profileDropdown.addEventListener("mouseleave", function() { profileTimeout = setTimeout(function() { profileDropdown.classList.remove("active"); }, 300); }); } /* === SEARCH — expand au focus === */ var searchForm = document.querySelector(".exo-search-form"); var searchInput = document.querySelector(".exo-search-input"); if (searchForm && searchInput) { searchInput.addEventListener("focus", function() { searchForm.classList.add("exo-search-expanded"); }); searchInput.addEventListener("blur", function() { if (!searchInput.value) { searchForm.classList.remove("exo-search-expanded"); } }); } }); ]]>
        </script>
    </template>
</odoo>