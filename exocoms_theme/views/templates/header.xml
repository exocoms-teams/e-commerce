<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_header" name="Custom Header">


        <header class="exo-header">

            <div class="exo-header-container">

                <!-- LOGO -->

                <a href="/" class="exo-logo">

                    <img src="/exocoms_theme/static/src/img/EXOCOMS.png" alt="Exocoms Logo" />

                </a>

                <!-- NAVIGATION -->

                <nav class="exo-nav">

                    <!-- ACCUEIL -->

                    <a href="/" class="exo-nav-link">
                        Accueil
                    </a>

                    <a href="/services" class="exo-nav-link">
                        <i class="fa fa-briefcase" />
 Nos services </a>

                    <!-- INFORMATIQUE -->


                </nav>

                <!-- ICONES -->

                <div class="exo-header-icons">

                    <a href="/shop/cart">
                        <i class="fa fa-shopping-cart" />
                    </a>

                    <a href="/shop">
                        <i class="fa fa-search" />
                    </a>

                    <div class="exo-profile-dropdown">
                        <button class="exo-profile-btn">
                            <i class="fa fa-user" />
                        </button>

                        <div class="exo-profile-menu">
                            <!-- UTILISATEUR NON CONNECTÉ -->
                            <t t-if="request.env.user._is_public()">
                                <a href="/web/login" title="compte">
                                    <i class="fa fa-sign-in"></i> Login </a>
                            </t>
                            <!-- UTILISATEUR CONNECTÉ -->
                            <t t-else="">
                                <a href="/my/home" title="Compte">
                                    <i class="fa fa-user-circle" />
                                    <span>My Account</span>
                                </a>
                                <a href="/web/session/logout?redirect=/">
                                    <i class="fa fa-sign-out"></i>
                                    <span>Logout</span>
                                </a>
                            </t>
                        </div>
                    </div>

                </div>

            </div>

        </header>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
            const profileDropdown = document.querySelector(".exo-profile-dropdown");

            if (profileDropdown) {
            let profileTimeout;

            profileDropdown.addEventListener("mouseenter", () => {
            clearTimeout(profileTimeout);
            profileDropdown.classList.add("active");
            });

            profileDropdown.addEventListener("mouseleave", () => {
            profileTimeout = setTimeout(() => {
            profileDropdown.classList.remove("active");
            }, 300);
            });
            }
            });
        </script>
    </template>

</odoo>