<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="services_features">
        <section class="services-features-section">
            <div class="container">
                <div class="section-header">
                    <t t-if="request.env.lang == 'fr_FR'">
                        <h2>Pourquoi choisir EXOCOMS ?</h2>
                        <p>Des solutions professionnelles fiables et un accompagnement complet</p>
                    </t>
                    <t t-else="">
                        <h2>Why choose EXOCOMS?</h2>
                        <p>Reliable professional solutions and comprehensive support</p>
                    </t>
                </div>
                <div class="services-features-grid">
                    <t t-if="request.env.lang == 'fr_FR'">
                        <div class="services-feature-card hover-lift">
                            <i class="fa fa-shield-alt"></i>
                            <h4>Expertise reconnue</h4>
                            <p>Plus de 12 ans d'expérience au service des entreprises.</p>
                        </div>
                        <div class="services-feature-card hover-lift">
                            <i class="fa fa-headset"></i>
                            <h4>Support 24/7</h4>
                            <p>Une équipe dédiée disponible à tout moment.</p>
                        </div>
                        <div class="services-feature-card hover-lift">
                            <i class="fa fa-cogs"></i>
                            <h4>Solutions sur mesure</h4>
                            <p>Des solutions adaptées à vos besoins spécifiques.</p>
                        </div>
                        <div class="services-feature-card hover-lift">
                            <i class="fa fa-user-shield"></i>
                            <h4>Sécurité &amp; fiabilité</h4>
                            <p>Des technologies fiables et des données protégées.</p>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="services-feature-card hover-lift">
                            <i class="fa fa-shield-alt"></i>
                            <h4>Recognised expertise</h4>
                            <p>Over 12 years of experience serving businesses.</p>
                        </div>
                        <div class="services-feature-card hover-lift">
                            <i class="fa fa-headset"></i>
                            <h4>24/7 Support</h4>
                            <p>A dedicated team available at any time.</p>
                        </div>
                        <div class="services-feature-card hover-lift">
                            <i class="fa fa-cogs"></i>
                            <h4>Tailored solutions</h4>
                            <p>Solutions adapted to your specific needs.</p>
                        </div>
                        <div class="services-feature-card hover-lift">
                            <i class="fa fa-user-shield"></i>
                            <h4>Security &amp; reliability</h4>
                            <p>Reliable technologies and protected data.</p>
                        </div>
                    </t>
                </div>
            </div>
        </section>
    </template>

    <template id="process_section">
        <section class="services-process-section">
            <div class="container">
                <div class="section-header">
                    <t t-if="request.env.lang == 'fr_FR'">
                        <h2>Notre approche</h2>
                        <p>Une méthodologie claire pour garantir votre réussite</p>
                    </t>
                    <t t-else="">
                        <h2>Our approach</h2>
                        <p>A clear methodology to guarantee your success</p>
                    </t>
                </div>
                <div class="services-process-grid">
                    <t t-if="request.env.lang == 'fr_FR'">
                        <div class="services-process-card">
                            <div class="services-process-number">1</div>
                            <i class="fa fa-search"></i>
                            <h4>Analyse</h4>
                            <p>Étude de vos besoins et de votre environnement.</p>
                        </div>
                        <div class="services-process-card">
                            <div class="services-process-number">2</div>
                            <i class="fa fa-clipboard-check"></i>
                            <h4>Conception</h4>
                            <p>Création de la solution adaptée à vos objectifs.</p>
                        </div>
                        <div class="services-process-card">
                            <div class="services-process-number">3</div>
                            <i class="fa fa-cogs"></i>
                            <h4>Déploiement</h4>
                            <p>Installation, configuration et mise en service.</p>
                        </div>
                        <div class="services-process-card">
                            <div class="services-process-number">4</div>
                            <i class="fa fa-users"></i>
                            <h4>Accompagnement</h4>
                            <p>Support, formation et suivi personnalisé.</p>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="services-process-card">
                            <div class="services-process-number">1</div>
                            <i class="fa fa-search"></i>
                            <h4>Analysis</h4>
                            <p>Assessment of your needs and environment.</p>
                        </div>
                        <div class="services-process-card">
                            <div class="services-process-number">2</div>
                            <i class="fa fa-clipboard-check"></i>
                            <h4>Design</h4>
                            <p>Creation of the solution tailored to your goals.</p>
                        </div>
                        <div class="services-process-card">
                            <div class="services-process-number">3</div>
                            <i class="fa fa-cogs"></i>
                            <h4>Deployment</h4>
                            <p>Installation, configuration and commissioning.</p>
                        </div>
                        <div class="services-process-card">
                            <div class="services-process-number">4</div>
                            <i class="fa fa-users"></i>
                            <h4>Support</h4>
                            <p>Support, training and personalised follow-up.</p>
                        </div>
                    </t>
                </div>
            </div>
        </section>
    </template>
</odoo>