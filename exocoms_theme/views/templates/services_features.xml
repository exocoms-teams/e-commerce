<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- =======================================================
         SECTION FEATURES
    ======================================================== -->

    <template id="services_features">

        <section class="exo-features-section">

            <div class="container">

                <!-- TITRE -->

                <div class="section-header">

                    <h2>Pourquoi choisir EXOCOMS ?</h2>

                    <p>
                        Des solutions professionnelles fiables et un accompagnement complet
                    </p>

                </div>

                <!-- FEATURES -->

                <div class="exo-features">

                    <!-- ITEM 1 -->

                    <div class="exo-feature-item hover-lift">

                        <i class="fa fa-shield-alt"></i>

                        <h4>Expertise reconnue</h4>

                        <p>
                            Plus de 12 ans d’expérience
                            au service des entreprises.
                        </p>

                    </div>

                    <!-- ITEM 2 -->

                    <div class="exo-feature-item hover-lift">

                        <i class="fa fa-headset"></i>

                        <h4>Support 24/7</h4>

                        <p>
                            Une équipe dédiée disponible
                            à tout moment.
                        </p>

                    </div>

                    <!-- ITEM 3 -->

                    <div class="exo-feature-item hover-lift">

                        <i class="fa fa-cogs"></i>

                        <h4>Solutions sur mesure</h4>

                        <p>
                            Des solutions adaptées à vos
                            besoins spécifiques.
                        </p>

                    </div>

                    <!-- ITEM 4 -->

                    <div class="exo-feature-item hover-lift">

                        <i class="fa fa-user-shield"></i>

                        <h4>Sécurité &amp; fiabilité</h4>

                        <p>
                            Des technologies fiables
                            et des données protégées.
                        </p>

                    </div>

                </div>

            </div>

        </section>

    </template>

    <!-- =======================================================
         SECTION PROCESS
    ======================================================== -->

    <template id="process_section">

        <section class="exo-process-section">

            <div class="container">

                <!-- TITRE -->

                <div class="section-header">

                    <h2>Notre approche</h2>

                    <p>
                        Une méthodologie claire pour garantir votre réussite
                    </p>

                </div>

                <!-- PROCESS GRID -->

                <div class="exo-process-grid">

                    <!-- ITEM 1 -->

                    <div class="exo-process-item">

                        <div class="exo-process-number">1</div>

                        <i class="fa fa-search"></i>

                        <h4>Analyse</h4>

                        <p>
                            Étude de vos besoins et de votre environnement.
                        </p>

                    </div>

                    <!-- ITEM 2 -->

                    <div class="exo-process-item">

                        <div class="exo-process-number">2</div>

                        <i class="fa fa-clipboard-check"></i>

                        <h4>Conception</h4>

                        <p>
                            Création de la solution adaptée à vos objectifs.
                        </p>

                    </div>

                    <!-- ITEM 3 -->

                    <div class="exo-process-item">

                        <div class="exo-process-number">3</div>

                        <i class="fa fa-cogs"></i>

                        <h4>Déploiement</h4>

                        <p>
                            Installation, configuration et mise en service.
                        </p>

                    </div>

                    <!-- ITEM 4 -->

                    <div class="exo-process-item">

                        <div class="exo-process-number">4</div>

                        <i class="fa fa-users"></i>

                        <h4>Accompagnement</h4>

                        <p>
                            Support, formation et suivi personnalisé.
                        </p>

                    </div>

                </div>

            </div>

        </section>

    </template>

</odoo>