<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="custom_layout" name="Custom Layout">

        <t t-call="website.layout">

            <!-- CSS Modern Design System -->
            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/layout.css" />
            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/header.css" />
            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/hero.css" />
            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/features.css" />
            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/footer.css" />
            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/cards.css" />
            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/animations.css" />
            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/sections.css" />
            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/pages.css" />
            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/categories.css" />
            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/odoo-integration.css" />
            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/responsive.css" />

            <!-- Font Awesome Icons -->
            <link rel="stylesheet"
                href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

            <!-- HEADER -->
            <t t-call="exocoms_theme.custom_header" />

            <!-- CONTENU -->
            <t t-out="0" />

            <!-- FEATURES -->
            <t t-call="exocoms_theme.features_section" />

            <!-- FOOTER -->
            <t t-call="exocoms_theme.custom_footer" />

        </t>

    </template>

</odoo>