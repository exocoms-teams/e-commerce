<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- CSS chargés sur TOUTES les pages via ir.asset -->
    <record id="exocoms_theme_assets" model="ir.asset">
        <field name="name">Exocoms Theme CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/exocoms_theme/static/src/css/layout.css</field>
    </record>

    <record id="exocoms_header_css" model="ir.asset">
        <field name="name">Exocoms Header CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/exocoms_theme/static/src/css/header.css</field>
    </record>

    <record id="exocoms_home_css" model="ir.asset">
        <field name="name">Exocoms Home CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/exocoms_theme/static/src/css/home.css</field>
    </record>

    <record id="exocoms_hero_css" model="ir.asset">
        <field name="name">Exocoms Hero CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/exocoms_theme/static/src/css/hero.css</field>
    </record>

    <record id="exocoms_features_css" model="ir.asset">
        <field name="name">Exocoms Features CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/exocoms_theme/static/src/css/features.css</field>
    </record>

    <record id="exocoms_products_css" model="ir.asset">
        <field name="name">Exocoms Products CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/exocoms_theme/static/src/css/products.css</field>
    </record>

    <record id="exocoms_footer_css" model="ir.asset">
        <field name="name">Exocoms Footer CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/exocoms_theme/static/src/css/footer.css</field>
    </record>

    <record id="exocoms_categories_css" model="ir.asset">
        <field name="name">Exocoms Categories CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/exocoms_theme/static/src/css/categories.css</field>
    </record>

    <record id="exocoms_dashbord_css" model="ir.asset">
        <field name="name">Exocoms Dashboard CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/exocoms_theme/static/src/css/dashbord.css</field>
    </record>

    <record id="exocoms_dashbord_boutique_css" model="ir.asset">
        <field name="name">Exocoms Dashboard Boutique CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/exocoms_theme/static/src/css/dashbord_boutique.css</field>
    </record>

    <record id="exocoms_cta_css" model="ir.asset">
        <field name="name">Exocoms CTA CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/exocoms_theme/static/src/css/cta.css</field>
    </record>

    <record id="exocoms_services_hero_css" model="ir.asset">
        <field name="name">Exocoms Services Hero CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/exocoms_theme/static/src/css/services_hero.css</field>
    </record>

    <record id="exocoms_services_features_css" model="ir.asset">
        <field name="name">Exocoms Services Features CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/exocoms_theme/static/src/css/services_features.css</field>
    </record>

    <record id="exocoms_services_content_css" model="ir.asset">
        <field name="name">Exocoms Services Content CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/exocoms_theme/static/src/css/services_content.css</field>
    </record>

    <record id="exocoms_animations_css" model="ir.asset">
        <field name="name">Exocoms Animations CSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">/exocoms_theme/static/src/css/animations.css</field>
    </record>

    <!-- custom_layout — reste pour les pages existantes -->
    <template id="custom_layout" name="Custom Layout">
        <t t-call="website.layout">
            <t t-call="exocoms_theme.custom_header" />
            <t t-out="0" />
            <t t-call="exocoms_theme.custom_footer" />
        </t>
    </template>

    <!-- Boutique — injecte header + footer + sidebar dans website_sale.products -->
    <template id="boutique_theme_assets"
        inherit_id="website_sale.products"
        name="Boutique Theme">

        <xpath expr="//header[@id='top']" position="replace">
            <t t-call="exocoms_theme.custom_header" />
        </xpath>

        <xpath expr="//footer" position="replace">
            <t t-call="exocoms_theme.custom_footer" />
        </xpath>

        <xpath expr="//div[@id='products_grid']" position="before">
            <t t-call="exocoms_theme.dashboard_menu_boutiques_sidebar" />
        </xpath>

    </template>

</odoo>