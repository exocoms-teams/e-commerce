<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_layout" name="Custom Layout">

        <t t-call="website.layout">

            <!-- CSS -->
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/layout.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/header.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/home.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/hero.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/features.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/products.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/footer.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/categories.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/dashbord.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/dashbord_boutique.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/cta.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/services_hero.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/services_features.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/services_content.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/animations.css" />
            <link rel="stylesheet"
                href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

            <!-- HEADER -->
            <t t-call="exocoms_theme.custom_header" />

            <!-- CONTENU -->
            <t t-out="0" />

            <!-- FOOTER -->
            <t t-call="exocoms_theme.custom_footer" />

        </t>

    </template>

    <!-- Template séparé pour la boutique — injecte CSS + header + footer dans website_sale.products -->
    <template id="boutique_theme_assets"
        inherit_id="website_sale.products"
        name="Boutique Theme Assets">

        <xpath expr="//head" position="inside">
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/layout.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/header.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/footer.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/dashbord_boutique.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/products.css" />
            <link rel="stylesheet" href="/exocoms_theme/static/src/css/animations.css" />
            <link rel="stylesheet"
                href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
        </xpath>

        <xpath expr="//header[@id='top']" position="replace">
            <t t-call="exocoms_theme.custom_header" />
        </xpath>

        <xpath expr="//footer" position="replace">
            <t t-call="exocoms_theme.custom_footer" />
        </xpath>

        <xpath expr="//div[@id='products_grid']" position="before">
            <t t-call="exocoms_theme.dashboard_menu_boutiques_sidebar" />
        </xpath>

    </template>

</odoo>