<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_layout" name="Custom Layout">
        <t t-call="website.layout">

            <t t-set="head">
                 <link rel="stylesheet"
                  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
                <!-- Description -->
                <meta name="description" content="Exocoms Group — Spécialiste des terminaux de paiement TPE, caisses enregistreuses, monétique et solutions de paiement pour professionnels."/>

                <!-- Robots -->
                <meta name="robots" content="index, follow"/>

                <!-- Open Graph -->
                <meta property="og:type" content="website"/>
                <meta property="og:site_name" content="Exocoms Group"/>
                <meta property="og:title" content="Exocoms Group — TPE &amp; Caisses Enregistreuses"/>
                <meta property="og:description" content="Spécialiste des terminaux de paiement TPE, caisses enregistreuses et solutions monétiques pour professionnels."/>
                <meta property="og:image" content="/exocoms_theme/static/src/img/EXOCOMS.png"/>

                <!-- Twitter Card -->
                <meta name="twitter:card" content="summary_large_image"/>
                <meta name="twitter:title" content="Exocoms Group — TPE &amp; Caisses Enregistreuses"/>
                <meta name="twitter:description" content="Spécialiste TPE, caisses enregistreuses et monétique."/>
                <meta name="twitter:image" content="/exocoms_theme/static/src/img/EXOCOMS.png"/>

                <!-- Schema.org Organisation -->
                <script type="application/ld+json">
                {
                    "@context": "https://schema.org",
                    "@type": "Organization",
                    "name": "Exocoms Group",
                    "url": "https://www.exocoms.fr",
                    "logo": "/exocoms_theme/static/src/img/EXOCOMS.png",
                    "contactPoint": {
                        "@type": "ContactPoint",
                        "telephone": "+33-01-84-79-37-55",
                        "contactType": "customer service",
                        "availableLanguage": "French"
                    },
                    "address": {
                        "@type": "PostalAddress",
                        "addressLocality": "Paris",
                        "addressCountry": "FR"
                    }
                }
                </script>
            </t>

            <t t-out="0"/>
        </t>
    </template>
</odoo>