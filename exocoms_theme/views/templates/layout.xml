<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        LAYOUT CUSTOM — wrapper principal de toutes les pages Exocoms.
        Le header et le footer sont gérés par website_layout_custom (boutique.xml)
        qui hérite de website.layout et les remplace proprement.
        Ici on se contente d'appeler website.layout et d'injecter le contenu de la page.
    -->
    <template id="custom_layout" name="Custom Layout">
        <t t-call="website.layout">
            <t t-out="0"/>
        </t>
    </template>

</odoo>