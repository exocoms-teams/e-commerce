<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_layout" name="Custom Layout">
        <t t-call="website.layout">

            <!-- SEO : balises méta globales injectées dans le <head> -->
            <t t-set="head">
                <!-- Description par défaut (écrasée par les pages si besoin) -->
                <meta name="description"
                      t-att-content="website.meta_description or 'Exocoms Group — Spécialiste des terminaux de paiement TPE, caisses enregistreuses, monétique et solutions de paiement pour professionnels.'"/>

                <!-- Robots -->
                <meta name="robots" content="index, follow"/>

                <!-- Canonical -->
                <link rel="canonical" t-att-href="request.httprequest.url"/>

                <!-- Open Graph (partage réseaux sociaux) -->
                <meta property="og:type" content="website"/>
                <meta property="og:site_name" content="Exocoms Group"/>
                <meta property="og:title"
                      t-att-content="website.name or 'Exocoms Group'"/>
                <meta property="og:description"
                      t-att-content="website.meta_description or 'Spécialiste des terminaux de paiement TPE, caisses enregistreuses et solutions monétiques pour professionnels.'"/>
                <meta property="og:image"
                      content="/exocoms_theme/static/src/img/EXOCOMS.png"/>
                <meta property="og:url"
                      t-att-content="request.httprequest.url"/>

                <!-- Twitter Card -->
                <meta name="twitter:card" content="summary_large_image"/>
                <meta name="twitter:title"
                      t-att-content="website.name or 'Exocoms Group'"/>
                <meta name="twitter:description"
                      t-att-content="website.meta_description or 'Spécialiste TPE, caisses enregistreuses et monétique.'"/>
                <meta name="twitter:image"
                      content="/exocoms_theme/static/src/img/EXOCOMS.png"/>

                <!-- Schema.org Organisation -->
                <script type="application/ld+json">
                {
                    "@context": "https://schema.org",
                    "@type": "Organization",
                    "name": "Exocoms Group",
                    "url": "https://www.exocoms.fr",
                    "logo": "/exocoms_theme/static/src/img/EXOCOMS.png",
                    "contactPoint": {
                        "@type": "ContactPoint",
                        "telephone": "+33-01-84-79-37-55",
                        "contactType": "customer service",
                        "availableLanguage": "French"
                    },
                    "address": {
                        "@type": "PostalAddress",
                        "addressLocality": "Paris",
                        "addressCountry": "FR"
                    }
                }
                </script>
            </t>

            <t t-out="0"/>
        </t>
    </template>

</odoo>