<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="custom_layout" name="Custom Layout">

        <t t-call="website.layout">

            <!-- CSS - DESIGN SYSTEM & CORE -->
            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/layout.css" />

            <!-- CSS - COMPONENTS -->
            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/header.css" />

            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/home.css" />

            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/hero.css" />

            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/features.css" />

            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/products.css" />

            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/footer.css" />

            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/categories.css" />

            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/dashbord.css" />

            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/cta.css" />

            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/services_hero.css" />

            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/services_features.css" />

            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/services_content.css" />

            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/services_content.css" />


            <!-- CSS - ANIMATIONS & UTILITIES -->
            <link rel="stylesheet"
                href="/exocoms_theme/static/src/css/animations.css" />

            <!-- FONT AWESOME -->
            <link rel="stylesheet"
                href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

            <!-- HEADER -->
            <t t-call="exocoms_theme.custom_header" />

            <!-- CONTENU -->
            <t t-out="0" />

            <!-- FOOTER -->
            <t t-call="exocoms_theme.custom_footer" />

        </t>

    </template>

</odoo>