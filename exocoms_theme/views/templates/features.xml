<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="features_section">

        <!-- SECTION TÉMOIGNAGES — carousel auto-défilant alimenté par les
             VRAIS avis publiés (home_avis_list / home_avis_stats fournis
             par le contrôleur index(), même source que la page /avis).
             Texte statique dupliqué t-if/t-else fr_FR, comme partout
             ailleurs dans ce thème. -->
        <div class="exo-testimonials">
            <div class="exo-testimonials-header">
                <t t-if="request.env.lang == 'fr_FR'">
                    <div>
                        <span class="exo-testimonials-badge">TEMOIGNAGES</span>
                        <h2>Ce que disent nos clients</h2>
                    </div>
                    <a href="/avis" class="exo-testimonials-voir-tout">
                        Voir tous les avis <i class="fa fa-arrow-right"></i>
                    </a>
                </t>
                <t t-else="">
                    <div>
                        <span class="exo-testimonials-badge">TESTIMONIALS</span>
                        <h2>What our clients say</h2>
                    </div>
                    <a href="/avis" class="exo-testimonials-voir-tout">
                        View all reviews <i class="fa fa-arrow-right"></i>
                    </a>
                </t>
            </div>

            <t t-if="home_avis_list">
                <div class="exo-testimonials-track-wrap">
                    <div class="exo-testimonials-track" id="exo-testimonials-track">
                        <t t-foreach="home_avis_list" t-as="avis">
                            <div class="exo-testimonial-card">
                                <div class="exo-testimonial-quote">&#8221;</div>
                                <div class="exo-stars">
                                    <t t-foreach="range(avis.rating)" t-as="s">&#9733;</t>
                                </div>
                                <blockquote><t t-out="avis.comment"/></blockquote>
                                <div class="exo-testimonial-author">
                                    <div class="exo-author-avatar" style="background:#0d4dff;">
                                        <t t-out="avis.name[0].upper()"/>
                                    </div>
                                    <div>
                                        <strong><t t-out="avis.name"/></strong>
                                        <t t-if="avis.product">
                                            <span><t t-out="avis.product"/></span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <div class="exo-testimonials-rating">
                    <div class="exo-stars exo-stars-lg">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                    <t t-if="request.env.lang == 'fr_FR'">
                        <p><strong><t t-out="home_avis_stats['avg']"/> / 5</strong> — <t t-out="home_avis_stats['total']"/> avis vérifiés</p>
                    </t>
                    <t t-else="">
                        <p><strong><t t-out="home_avis_stats['avg']"/> / 5</strong> — <t t-out="home_avis_stats['total']"/> verified reviews</p>
                    </t>
                </div>
            </t>
            <t t-else="">
                <t t-if="request.env.lang == 'fr_FR'">
                    <p style="text-align:center;color:#5a6480;">Soyez le premier à partager votre expérience.</p>
                </t>
                <t t-else="">
                    <p style="text-align:center;color:#5a6480;">Be the first to share your experience.</p>
                </t>
            </t>

            <div class="exo-testimonials-cta">
                <t t-if="request.env.lang == 'fr_FR'">
                    <a href="/avis#avis-form" class="exo-testimonials-write-btn">
                        <i class="fa fa-pencil"></i> Écrire un avis
                    </a>
                </t>
                <t t-else="">
                    <a href="/avis#avis-form" class="exo-testimonials-write-btn">
                        <i class="fa fa-pencil"></i> Write a review
                    </a>
                </t>
            </div>
        </div>

        <div class="oe_structure oe_empty" id="oe_structure_after_testimonials"/>

        <!-- SECTION FEATURES -->
        <section class="exo-features">
            <t t-if="request.env.lang == 'fr_FR'">
                <div class="exo-feature-item">
                    <i class="fa fa-cube"></i>
                    <div><h4>Retours faciles</h4><p>Retours sous 30 jours avec remboursement rapide.</p></div>
                </div>
                <div class="exo-feature-item">
                    <i class="fa fa-truck"></i>
                    <div><h4>Livraison rapide</h4><p>Livraison partout en France et Europe.</p></div>
                </div>
                <div class="exo-feature-item">
                    <i class="fa fa-lock"></i>
                    <div><h4>Paiement sécurisé</h4><p>Transactions 100% sécurisées et cryptées.</p></div>
                </div>
                <div class="exo-feature-item">
                    <i class="fa fa-shield"></i>
                    <div><h4>Qualité garantie</h4><p>Produits testés et certifiés par nos experts.</p></div>
                </div>
            </t>
            <t t-else="">
                <div class="exo-feature-item">
                    <i class="fa fa-cube"></i>
                    <div><h4>Easy returns</h4><p>Returns within 30 days with fast refund.</p></div>
                </div>
                <div class="exo-feature-item">
                    <i class="fa fa-truck"></i>
                    <div><h4>Fast delivery</h4><p>Delivery across France and Europe.</p></div>
                </div>
                <div class="exo-feature-item">
                    <i class="fa fa-lock"></i>
                    <div><h4>Secure payment</h4><p>100% secure and encrypted transactions.</p></div>
                </div>
                <div class="exo-feature-item">
                    <i class="fa fa-shield"></i>
                    <div><h4>Guaranteed quality</h4><p>Products tested and certified by our experts.</p></div>
                </div>
            </t>
        </section>

        <!-- BANDE PAIEMENT SÉCURISÉ -->
        <div class="exo-payment-bar">
            <t t-if="request.env.lang == 'fr_FR'">
                <span class="exo-payment-bar-title">Paiement sécurisé</span>
            </t>
            <t t-else="">
                <span class="exo-payment-bar-title">Secure payment</span>
            </t>
            <div class="exo-payment-logos">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80" class="exo-pay-logo">
                    <rect width="120" height="80" rx="8" fill="#1a1f71"/>
                    <text x="60" y="52" font-family="Arial" font-size="28" font-weight="900" fill="white" text-anchor="middle">VISA</text>
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80" class="exo-pay-logo">
                    <rect width="120" height="80" rx="8" fill="white" stroke="#eee" stroke-width="2"/>
                    <circle cx="46" cy="40" r="24" fill="#eb001b"/>
                    <circle cx="74" cy="40" r="24" fill="#f79e1b"/>
                    <path d="M60 20a24 24 0 0 1 0 40A24 24 0 0 1 60 20z" fill="#ff5f00"/>
                </svg>
                <img src="/exocoms_theme/static/src/img/cb.jpg" alt="CB" class="exo-pay-logo"/>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80" class="exo-pay-logo">
                    <rect width="120" height="80" rx="8" fill="#2e77bc"/>
                    <text x="60" y="36" font-family="Arial" font-size="14" font-weight="900" fill="white" text-anchor="middle">AMERICAN</text>
                    <text x="60" y="54" font-family="Arial" font-size="14" font-weight="900" fill="white" text-anchor="middle">EXPRESS</text>
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80" class="exo-pay-logo">
                    <rect width="120" height="80" rx="8" fill="white" stroke="#eee" stroke-width="2"/>
                    <text font-family="Arial" font-size="22" font-weight="900" y="48" x="60" text-anchor="middle">
                        <tspan fill="#003087">Pay</tspan><tspan fill="#009cde">Pal</tspan>
                    </text>
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80" class="exo-pay-logo">
                    <rect width="120" height="80" rx="8" fill="#0d4dff"/>
                    <t t-if="request.env.lang == 'fr_FR'">
                        <text x="60" y="34" font-family="Arial" font-size="14" font-weight="700" fill="white" text-anchor="middle">Virement</text>
                        <text x="60" y="54" font-family="Arial" font-size="14" font-weight="700" fill="white" text-anchor="middle">bancaire</text>
                    </t>
                    <t t-else="">
                        <text x="60" y="34" font-family="Arial" font-size="14" font-weight="700" fill="white" text-anchor="middle">Bank</text>
                        <text x="60" y="54" font-family="Arial" font-size="14" font-weight="700" fill="white" text-anchor="middle">Transfer</text>
                    </t>
                </svg>
            </div>
        </div>

        <!-- SCRIPT — carousel témoignages (défilement auto + pause au survol) -->
        <script>
        (function () {
            var track = document.getElementById('exo-testimonials-track');
            if (!track || track.dataset.init) return;
            track.dataset.init = '1';
            var originals = [].slice.call(track.children);
            if (originals.length &lt; 2) return;
            originals.forEach(function (n) { track.appendChild(n.cloneNode(true)); });
            var paused = false;
            track.addEventListener('mouseenter', function () { paused = true; });
            track.addEventListener('mouseleave', function () { paused = false; });
            var pos = 0;
            (function step() {
                if (!paused) {
                    pos += 0.6;
                    var half = track.scrollWidth / 2;
                    if (half > 0 &amp;&amp; pos >= half) pos -= half;
                    track.scrollLeft = pos;
                }
                requestAnimationFrame(step);
            })();
        })();
        </script>
    </template>
</odoo>
