<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="features_section">

        <section class="exo-features">

            <!-- ITEM -->
            <div class="exo-feature-item">
                <i class="fa fa-cube"></i>
                <div>
                    <h4>Retours faciles</h4>
                    <p>Retours sous 30 jours avec remboursement rapide.</p>
                </div>
            </div>

            <!-- ITEM -->
            <div class="exo-feature-item">
                <i class="fa fa-truck"></i>
                <div>
                    <h4>Livraison rapide</h4>
                    <p>Livraison partout en France et Europe.</p>
                </div>
            </div>

            <!-- ITEM -->
            <div class="exo-feature-item">
                <i class="fa fa-lock"></i>
                <div>
                    <h4>Paiement sécurisé</h4>
                    <p>Transactions 100% sécurisées et cryptées.</p>
                </div>
            </div>

            <!-- ITEM -->
            <div class="exo-feature-item">
                <i class="fa fa-shield"></i>
                <div>
                    <h4>Qualité garantie</h4>
                    <p>Produits testés et certifiés par nos experts.</p>
                </div>
            </div>

        </section>

        <!-- BANDE PAIEMENT SÉCURISÉ -->
        <div class="exo-payment-bar">
            <span class="exo-payment-bar-title">Paiement sécurisé</span>
            <div class="exo-payment-logos">

                <!-- VISA -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80" class="exo-pay-logo">
                    <rect width="120" height="80" rx="8" fill="#1a1f71" />
                    <text x="60" y="52" font-family="Arial" font-size="28" font-weight="900"
                        fill="white" text-anchor="middle">VISA</text>
                </svg>

                <!-- MASTERCARD -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80" class="exo-pay-logo">
                    <rect width="120" height="80" rx="8" fill="white" stroke="#eee" stroke-width="2" />
                    <circle cx="46" cy="40" r="24" fill="#eb001b" />
                    <circle cx="74" cy="40" r="24" fill="#f79e1b" />
                    <path d="M60 20a24 24 0 0 1 0 40A24 24 0 0 1 60 20z" fill="#ff5f00" />
                </svg>

                <!-- CB -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80" class="exo-pay-logo">
                    <rect width="120" height="80" rx="8" fill="#0072bc" />
                    <text x="60" y="52" font-family="Arial" font-size="32" font-weight="900"
                        fill="white" text-anchor="middle">CB</text>
                </svg>

                <!-- AMERICAN EXPRESS -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80" class="exo-pay-logo">
                    <rect width="120" height="80" rx="8" fill="#2e77bc" />
                    <text x="60" y="36" font-family="Arial" font-size="14" font-weight="900"
                        fill="white" text-anchor="middle">AMERICAN</text>
                    <text x="60" y="54" font-family="Arial" font-size="14" font-weight="900"
                        fill="white" text-anchor="middle">EXPRESS</text>
                </svg>

                <!-- PAYPAL — texte recentré et réduit pour tenir dans le cadre -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80" class="exo-pay-logo">
                    <rect width="120" height="80" rx="8" fill="white" stroke="#eee" stroke-width="2" />
                    <text x="60" y="50" font-family="Arial" font-size="26" font-weight="900"
                        text-anchor="middle">
                        <tspan fill="#003087">Pay</tspan>
                        <tspan fill="#009cde">Pal</tspan>
                    </text>
                </svg>

                <!-- VIREMENT BANCAIRE — fond plus visible, texte agrandi -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80" class="exo-pay-logo">
                    <rect width="120" height="80" rx="8" fill="#0d4dff" />
                    <text x="60" y="34" font-family="Arial" font-size="14" font-weight="700"
                        fill="white" text-anchor="middle">Virement</text>
                    <text x="60" y="54" font-family="Arial" font-size="14" font-weight="700"
                        fill="white" text-anchor="middle">bancaire</text>
                </svg>

            </div>
        </div>

    </template>

</odoo>