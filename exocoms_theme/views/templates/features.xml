<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="features_section">

        <section class="exo-features">

            <!-- ITEM -->
            <div class="exo-feature-item">
                <i class="fa fa-cube"></i>
                <div>
                    <h4>Retours faciles</h4>
                    <p>Retours sous 30 jours avec remboursement rapide.</p>
                </div>
            </div>

            <!-- ITEM -->
            <div class="exo-feature-item">
                <i class="fa fa-truck"></i>
                <div>
                    <h4>Livraison rapide</h4>
                    <p>Livraison partout en France et Europe.</p>
                </div>
            </div>

            <!-- ITEM -->
            <div class="exo-feature-item">
                <i class="fa fa-lock"></i>
                <div>
                    <h4>Paiement sécurisé</h4>
                    <p>Transactions 100% sécurisées et cryptées.</p>
                </div>
            </div>

            <!-- ITEM -->
            <div class="exo-feature-item">
                <i class="fa fa-shield"></i>
                <div>
                    <h4>Qualité garantie</h4>
                    <p>Produits testés et certifiés par nos experts.</p>
                </div>
            </div>

        </section>

        <!-- BANDE PAIEMENT SÉCURISÉ -->
        <div class="exo-payment-bar">
            <span class="exo-payment-bar-title">Paiement sécurisé</span>
            <div class="exo-payment-logos">

                <!-- VISA -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 500" class="exo-pay-logo">
                    <rect width="780" height="500" rx="40" fill="#1a1f71" />
                    <text x="390" y="320" font-family="Arial" font-size="220" font-weight="900"
                        fill="white" text-anchor="middle">VISA</text>
                </svg>

                <!-- MASTERCARD -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 152 108" class="exo-pay-logo">
                    <circle cx="52" cy="54" r="52" fill="#eb001b" />
                    <circle cx="100" cy="54" r="52" fill="#f79e1b" />
                    <path d="M76 18.4a52 52 0 0 1 0 71.2A52 52 0 0 1 76 18.4z" fill="#ff5f00" />
                </svg>

                <!-- CB -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80" class="exo-pay-logo">
                    <rect width="120" height="80" rx="8" fill="#0072bc" />
                    <text x="60" y="52" font-family="Arial" font-size="32" font-weight="900"
                        fill="white" text-anchor="middle">CB</text>
                </svg>

                <!-- AMERICAN EXPRESS -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 500" class="exo-pay-logo">
                    <rect width="780" height="500" rx="40" fill="#2e77bc" />
                    <text x="390" y="280" font-family="Arial" font-size="110" font-weight="900"
                        fill="white" text-anchor="middle">AMERICAN</text>
                    <text x="390" y="390" font-family="Arial" font-size="110" font-weight="900"
                        fill="white" text-anchor="middle">EXPRESS</text>
                </svg>

                <!-- PAYPAL -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 80" class="exo-pay-logo">
                    <text x="10" y="58" font-family="Arial" font-size="52" font-weight="900"
                        fill="#003087">Pay</text>
                    <text x="108" y="58" font-family="Arial" font-size="52" font-weight="900"
                        fill="#009cde">Pal</text>
                </svg>

                <!-- VIREMENT BANCAIRE — même viewBox ratio que CB -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 80" class="exo-pay-logo">
                    <rect width="120" height="80" rx="8" fill="#f0f4ff" stroke="#c0ceff"
                        stroke-width="3" />
                    <text x="60" y="28" font-family="Arial" font-size="16" font-weight="700"
                        fill="#0d4dff" text-anchor="middle">Virement</text>
                    <text x="60" y="52" font-family="Arial" font-size="16" font-weight="700"
                        fill="#0d4dff" text-anchor="middle">bancaire</text>
                </svg>

            </div>
        </div>

    </template>

</odoo>