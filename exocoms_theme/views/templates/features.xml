        <!-- SCRIPT — carousel témoignages (défilement auto + pause au survol,
             même logique que pm-avis-track de Planet Mobil) -->
        <script>
        (function () {
            var track = document.getElementById('exo-testimonials-track');
            if (!track || track.dataset.init) return;
            track.dataset.init = '1';
            var originals = [].slice.call(track.children);
            originals.forEach(function (n) { track.appendChild(n.cloneNode(true)); });
            var paused = false;
            track.addEventListener('mouseenter', function () { paused = true; });
            track.addEventListener('mouseleave', function () { paused = false; });
            var pos = 0;
            (function step() {
                if (!paused) {
                    pos += 0.6;
                    var half = track.scrollWidth / 2;
                    if (half > 0 &amp;&amp; pos >= half) pos -= half;
                    track.scrollLeft = pos;
                }
                requestAnimationFrame(step);
            })();
        })();
        </script>
