<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="features_section">

        <section class="exo-features-section">

            <div class="container">

                <div class="section-header">
                    <h2>Pourquoi nous choisir ?</h2>
                    <p>Des solutions fiables, des experts passionnés, un service exceptionnel</p>
                </div>

                <div class="exo-features">

                    <!-- ITEM 1 -->
                    <div class="exo-feature-item hover-lift">
                        <i class="fa fa-truck"></i>
                        <h4>Livraison rapide</h4>
                        <p>
                            Expédition partout en France et en Europe 
                            avec suivi en temps réel.
                        </p>
                    </div>

                    <!-- ITEM 2 -->
                    <div class="exo-feature-item hover-lift">
                        <i class="fa fa-undo"></i>
                        <h4>Retours faciles</h4>
                        <p>
                            Retours sans frais sous 30 jours 
                            avec remboursement rapide.
                        </p>
                    </div>

                    <!-- ITEM 3 -->
                    <div class="exo-feature-item hover-lift">
                        <i class="fa fa-shield"></i>
                        <h4>Paiement sécurisé</h4>
                        <p>
                            Transactions 100% sécurisées et cryptées 
                            avec les meilleurs protocoles.
                        </p>
                    </div>

                    <!-- ITEM 4 -->
                    <div class="exo-feature-item hover-lift">
                        <i class="fa fa-headset"></i>
                        <h4>Support 24/7</h4>
                        <p>
                            Équipe d'experts disponible pour vous aider 
                            à tout moment.
                        </p>
                    </div>

                </div>

            </div>

        </section>

    </template>

</odoo>