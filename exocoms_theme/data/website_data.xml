<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- MENUS -->
        <record id="menu_solutions" model="website.menu">
            <field name="name">Solutions</field>
            <field name="url">/solutions</field>
            <field name="sequence">10</field>
        </record>
        <record id="menu_terminaux" model="website.menu">
            <field name="name">Terminaux</field>
            <field name="url">/shop</field>
            <field name="sequence">20</field>
        </record>
        <record id="menu_tarifs" model="website.menu">
            <field name="name">Tarifs</field>
            <field name="url">/shop</field>
            <field name="sequence">30</field>
        </record>
        <record id="menu_a_propos" model="website.menu">
            <field name="name">À propos</field>
            <field name="url">/a-propos</field>
            <field name="sequence">40</field>
        </record>
        <record id="menu_contact" model="website.menu">
            <field name="name">Contact</field>
            <field name="url">/contact</field>
            <field name="sequence">50</field>
        </record>

        <!-- VUES NATIVES ACTIVES -->
        <record id="website_sale.products_categories" model="ir.ui.view">
            <field name="active">True</field>
        </record>
        <record id="website_sale.search" model="ir.ui.view">
            <field name="active">True</field>
        </record>
        <record id="website_sale.filter_products_price" model="ir.ui.view">
            <field name="active">True</field>
        </record>

        <!-- NOM + LOGO DU SITE -->
        <record id="website.default_website" model="website">
            <field name="name">Exocoms Group</field>
            <field name="logo" type="base64" file="exocoms_theme/static/src/img/EXOCOMS.png"/>
        </record>

    </data>
</odoo>