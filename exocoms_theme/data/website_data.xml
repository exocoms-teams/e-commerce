<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- MENUS -->
        <record id="menu_solutions" model="website.menu">
            <field name="name">Solutions</field>
            <field name="url">/solutions</field>
            <field name="sequence">10</field>
        </record>
        <record id="menu_terminaux" model="website.menu">
            <field name="name">Terminaux</field>
            <field name="url">/shop</field>
            <field name="sequence">20</field>
        </record>
        <record id="menu_tarifs" model="website.menu">
            <field name="name">Tarifs</field>
            <field name="url">/shop</field>
            <field name="sequence">30</field>
        </record>
        <record id="menu_a_propos" model="website.menu">
            <field name="name">À propos</field>
            <field name="url">/a-propos</field>
            <field name="sequence">40</field>
        </record>
        <record id="menu_contact" model="website.menu">
            <field name="name">Contact</field>
            <field name="url">/contact</field>
            <field name="sequence">50</field>
        </record>

        <!-- VUES NATIVES ACTIVES -->
        <record id="website_sale.products_categories" model="ir.ui.view">
            <field name="active">True</field>
        </record>
        <record id="website_sale.search" model="ir.ui.view">
            <field name="active">True</field>
        </record>
        <record id="website_sale.filter_products_price" model="ir.ui.view">
            <field name="active">True</field>
        </record>

        <!-- SEO PAGE ACCUEIL -->
        <record id="exocoms_theme.home" model="ir.ui.view">
            <field name="meta_description">Exocoms Group, votre spécialiste en terminaux de paiement TPE INGENICO, SUNMI, PAX, caisses enregistreuses tactiles et solutions monétiques pour professionnels. Livraison France et Europe.</field>
            <field name="name">Accueil | Exocoms Group — TPE, Caisses Enregistreuses &amp; Monétique</field>
        </record>

        <!-- SEO PAGE SERVICES -->
        <record id="exocoms_theme.services_page" model="ir.ui.view">
            <field name="meta_description">Exocoms Group propose des services complets : installation et maintenance de TPE, caisse enregistreuse, support technique, formation et pièces détachées pour professionnels.</field>
            <field name="name">Nos Services | Exocoms Group — Maintenance, Installation &amp; Support TPE</field>
        </record>

        <!-- SEO PAGE MENTIONS LÉGALES -->
        <record id="exocoms_theme.mentions_legales" model="ir.ui.view">
            <field name="meta_description">Mentions légales du site Exocoms Group — Informations légales, éditeur du site et conditions d'utilisation.</field>
            <field name="name">Mentions Légales | Exocoms Group</field>
        </record>

        <!-- NOM DU SITE WEB -->
        <record id="website.default_website" model="website">
            <field name="name">Exocoms Group</field>
        </record>

    </data>
</odoo>