<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="menu_solutions" model="website.menu">
            <field name="name">Solutions</field>
            <field name="url">/solutions</field>
            <field name="sequence">10</field>
        </record>

        <record id="menu_terminaux" model="website.menu">
            <field name="name">Terminaux</field>
            <field name="url">/shop</field>
            <field name="sequence">20</field>
        </record>

        <record id="menu_tarifs" model="website.menu">
            <field name="name">Tarifs</field>
            <field name="url">/shop</field>
            <field name="sequence">30</field>
        </record>

        <record id="menu_a_propos" model="website.menu">
            <field name="name">À propos</field>
            <field name="url">/a-propos</field>
            <field name="sequence">40</field>
        </record>

        <record id="menu_contact" model="website.menu">
            <field name="name">Contact</field>
            <field name="url">/contact</field>
            <field name="sequence">50</field>
        </record>

    </data>

    <data>
        <!-- Active la sidebar catégories -->
        <record id="website_sale.products_categories" model="ir.ui.view">
            <field name="active">True</field>
        </record>

        <!-- Style produits Chips + Center Content -->
        <record id="website.website" model="website">
            <field name="shop_opt_products_design_classes">o_wsale_products_opt_design_chips</field>
        </record>

        <!-- Active Center Content -->
        <record id="website_sale.products_shop_title_align" model="ir.ui.view">
            <field name="active">True</field>
        </record>
    </data>

</odoo>