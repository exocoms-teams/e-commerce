<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="review_sophie" model="planet.review">
            <field name="name">Sophie L.</field>
            <field name="rating">5</field>
            <field name="product">iPhone 15</field>
            <field name="comment">Livraison ultra rapide et téléphone nickel. Je recommande à 100% !</field>
            <field name="is_published">True</field>
        </record>

        <record id="review_karim" model="planet.review">
            <field name="name">Karim B.</field>
            <field name="rating">5</field>
            <field name="product">Samsung Galaxy S24</field>
            <field name="comment">Très bon service client, ils ont répondu à toutes mes questions avant l'achat. Au top.</field>
            <field name="is_published">True</field>
        </record>

        <record id="review_marie" model="planet.review">
            <field name="name">Marie D.</field>
            <field name="rating">4</field>
            <field name="product">AirPods Pro</field>
            <field name="comment">Bon rapport qualité-prix, emballage soigné. Petit délai de livraison mais rien de grave.</field>
            <field name="is_published">True</field>
        </record>

        <record id="review_thomas" model="planet.review">
            <field name="name">Thomas R.</field>
            <field name="rating">5</field>
            <field name="product"></field>
            <field name="comment">Deuxième commande chez Planet Mobil, toujours aussi satisfait. Des vrais pros !</field>
            <field name="is_published">True</field>
        </record>

    </data>
</odoo>