<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="product_pm_delivery_standard" model="product.product">
            <field name="name">Standard delivery</field>
        </record>

        <record id="delivery_pm_standard" model="delivery.carrier">
            <field name="name">Standard delivery</field>
            <field name="sequence">1</field>
            <field name="delivery_type">fixed</field>
            <field name="fixed_price">4.99</field>
            <field name="free_over">True</field>
            <field name="amount">50.0</field>
            <field name="is_published">True</field>
            <field name="product_id" ref="product_pm_delivery_standard"/>
            <field name="country_ids" eval="[(4, ref('base.fr'))]"/>
        </record>

        <record id="product_pm_delivery_express" model="product.product">
            <field name="name">Express delivery 24h</field>
        </record>

        <record id="delivery_pm_express" model="delivery.carrier">
            <field name="name">Express delivery 24h</field>
            <field name="sequence">2</field>
            <field name="delivery_type">fixed</field>
            <field name="fixed_price">9.99</field>
            <field name="is_published">True</field>
            <field name="product_id" ref="product_pm_delivery_express"/>
            <field name="country_ids" eval="[(4, ref('base.fr'))]"/>
        </record>

    </data>
</odoo>
