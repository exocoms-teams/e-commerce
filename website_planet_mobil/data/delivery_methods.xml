<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="pm_delivery_standard_tmpl" model="product.template">
            <field name="name">Livraison standard</field>
            <field name="detailed_type">service</field>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">4.99</field>
        </record>

        <record id="delivery_pm_standard" model="delivery.carrier">
            <field name="name">Livraison standard</field>
            <field name="sequence">1</field>
            <field name="delivery_type">fixed</field>
            <field name="fixed_price">4.99</field>
            <field name="free_over">True</field>
            <field name="amount">50.0</field>
            <field name="is_published">True</field>
            <field name="product_id" eval="env['product.template'].browse(ref('pm_delivery_standard_tmpl')).product_variant_id.id"/>
            <field name="country_ids" eval="[(4, ref('base.fr'))]"/>
        </record>

        <record id="pm_delivery_express_tmpl" model="product.template">
            <field name="name">Livraison express 24h</field>
            <field name="detailed_type">service</field>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">9.99</field>
        </record>

        <record id="delivery_pm_express" model="delivery.carrier">
            <field name="name">Livraison express 24h</field>
            <field name="sequence">2</field>
            <field name="delivery_type">fixed</field>
            <field name="fixed_price">9.99</field>
            <field name="is_published">True</field>
            <field name="product_id" eval="env['product.template'].browse(ref('pm_delivery_express_tmpl')).product_variant_id.id"/>
            <field name="country_ids" eval="[(4, ref('base.fr'))]"/>
        </record>

    </data>
</odoo>
