<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="footer_planet_mobil" inherit_id="website.layout" name="Footer Planet Mobil">
        <xpath expr="//footer" position="replace">
            <footer class="o_footer_planet_mobil">
                <div class="container">
                    <div class="row">

                        <!-- Colonne 1 : Liens utiles -->
                        <div class="col-lg-4">
                            <h5>Liens utiles</h5>
                            <ul class="list-unstyled">
                                <li><a href="/">Page d'accueil</a></li>
                                <li><a href="/about">À propos de nous</a></li>
                                <li><a href="/shop">Produits</a></li>
                                <li><a href="/interventions">Interventions</a></li>
                                <li><a href="/mentions-legales">Mentions légales</a></li>
                                <li><a href="/contactus">Contactez-nous</a></li>
                            </ul>
                        </div>

                        <!-- Colonne 2 : EXOCOMS Group -->
                        <div class="col-lg-4">
                            <h5>EXOCOMS Group</h5>
                            <ul class="list-unstyled">
                                <li>
                                    <a href="/contactus">
                                        <i class="fa fa-envelope"/> Contactez-nous
                                    </a>
                                </li>
                                <li>
                                    <a href="mailto:contact@planet-mobil.com">
                                        <i class="fa fa-at"/> contact@planet-mobil.com
                                    </a>
                                </li>
                                <li>
                                    <a href="tel:+33664978050">
                                        <i class="fa fa-phone"/> +33 (0)6 64 97 80 50
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <!-- Colonne 3 : Suivez-nous -->
                        <div class="col-lg-4">
                            <h5>Suivez-nous</h5>
                            <ul class="list-unstyled">
                                <li>
                                    <a t-att-href="website.social_facebook or '#'" target="_blank" rel="noopener">
                                        <i class="fa fa-facebook-square"/> Facebook
                                    </a>
                                </li>
                                <li>
                                    <a t-att-href="website.social_twitter or '#'" target="_blank" rel="noopener">
                                        <i class="fa fa-twitter"/> Twitter
                                    </a>
                                </li>
                                <li>
                                    <a t-att-href="website.social_instagram or '#'" target="_blank" rel="noopener">
                                        <i class="fa fa-instagram"/> Instagram
                                    </a>
                                </li>
                                <li>
                                    <a t-att-href="website.social_youtube or '#'" target="_blank" rel="noopener">
                                        <i class="fa fa-youtube-play"/> YouTube
                                    </a>
                                </li>
                                <li>
                                    <a href="/cookie-policy">Politique de cookies</a>
                                </li>
                            </ul>
                        </div>

                    </div>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>