d: #1e40af; padding: 2rem 2.5rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; box-sizing: border-box; } .tsp-newsletter-text h3 { color: #fff; font-size: 1.1rem; font-weight: 500; margin: 0 0 4px; } .tsp-newsletter-text p { color: rgba(255,255,255,0.8); font-size: 0.875rem; margin: 0; } .tsp-newsletter .js_subscribe_wrap { display: flex; gap: 8px; align-items: center; min-width: 360px; } .tsp-newsletter .js_subscribe_value { flex: 1 1 auto; padding: 10px 14px; border-radius: 6px; border: none; font-size: 0.875rem; } .tsp-newsletter-btn { padding: 10px 20px; background: #fff; color: #2563eb; border: none; border-radius: 6px; font-size: 0.875rem; font-weight: 500; cursor: pointer; white-space: nowrap; } .tsp-newsletter .js_subscribed_wrap { color: #fff; } </style>
