<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="footer" name="Planet Mobil - Footer">

        <style>
            .o_footer { background: var(--white) !important; }
            .o_footer .tsp-footer-links a { color: var(--muted) !important; }
            .o_footer .tsp-footer-links a:hover { color: var(--blue) !important; }
            .o_footer .tsp-link-blue { color: var(--blue) !important; }
            .o_footer_copyright { display: none !important; }

            /* Mise en page du formulaire newsletter Odoo */
            .tsp-newsletter .js_subscribe_wrap { display: flex; gap: 8px; align-items: center; }
            .tsp-newsletter .js_subscribe_value { flex: 1 1 auto; }
            .tsp-newsletter .js_subscribed_wrap { color: #fff; }
        </style>

        <!-- NEWSLETTER -->
        <div class="tsp-newsletter">
            <div class="tsp-newsletter-text">
                <h3>📧 Restez informé !</h3>
                <p>Inscrivez-vous pour ne rater aucune offre exclusive Planet Mobil</p>
            </div>

            
            <div class="tsp-newsletter-form s_newsletter_subscribe_form s_newsletter_list js_subscribe"
                 data-list-id="3" data-name="Newsletter Form">
                <div class="js_subscribed_wrap d-none">
                    <p class="tsp-newsletter-thanks" style="margin:0;">
                        <i class="fa fa-check-circle-o" role="img"/> Merci, vous êtes bien inscrit !
                    </p>
                </div>
                <div class="js_subscribe_wrap">
                    <input type="email" name="email"
                           class="js_subscribe_value form-control"
                           placeholder="Votre adresse email..."/>
                    <button type="button" class="tsp-newsletter-btn js_subscribe_btn o_submit">S'inscrire</button>
                </div>
            </div>
        </div>

        <footer class="tsp-footer">
            <div class="tsp-footer-grid">

                <div class="tsp-footer-col">
                    <div class="tsp-footer-logo">🌍 PLANET <span>MOBIL</span></div>
                    <p class="tsp-footer-desc">
                        Chez <strong>Planet-mobil</strong>, nous sommes une équipe passionnée
                        de tech-addicts et de conseillers experts, réunis par une mission commune :
                        vous offrir la meilleure expérience d'achat tech en ligne.
                    </p>
                </div>

                <div class="tsp-footer-col">
                    <h4 class="tsp-footer-title">Liens utiles</h4>
                    <ul class="tsp-footer-links">
                        <li><a href="/">Page d'accueil</a></li>
                        <li><a href="#">À propos de nous</a></li>
                        <li><a href="/shop">Produits</a></li>
                        <li><a href="/mentions-legales">Mentions légales</a></li>
                        <li><a href="/contact">Contactez-nous</a></li>
                        
                    </ul>
                </div>

                <div class="tsp-footer-col">
                    <h4 class="tsp-footer-title">EXOCOMS Group</h4>
                    <ul class="tsp-footer-links">
                        <li><a href="/contact"><i class="fa fa-envelope"/> Contactez-nous</a></li>
                        <li><a href="mailto:contact@planet-mobil.com"><i class="fa fa-at"/> contact@planet-mobil.com</a></li>
                        <li><a href="tel:+33664978050"><i class="fa fa-phone"/> +33 (0)6 64 97 80 50</a></li>
                    </ul>
                </div>

                <div class="tsp-footer-col">
                    <h4 class="tsp-footer-title">Suivez-nous</h4>
                    <ul class="tsp-footer-links">
                        <li><a href="#"><i class="fa fa-facebook-square"/> Facebook</a></li>
                        <li><a href="#"><i class="fa fa-twitter"/> Twitter</a></li>
                        <li><a href="#"><i class="fa fa-instagram"/> Instagram</a></li>
                        <li><a href="#"><i class="fa fa-youtube-play"/> YouTube</a></li>
                    </ul>
                    <div style="margin-top:16px;">
                        <a href="/cookie-policy" class="tsp-link-blue" style="font-size:0.85rem;">Politique de cookies</a>
                    </div>
                </div>

            </div>

            <div class="tsp-footer-bottom">
                <p>Copyright © 2025 - EXOCOMS Group | Tous droits réservés</p>
            </div>
        </footer>

    </template>

    <template id="footer_replace" inherit_id="website.layout" name="Planet Mobil - Remplacement du footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo" t-ignore="true" t-if="not no_footer">
                <t t-call="website_planet_mobil.footer"/>
            </div>
        </xpath>
    </template>

</odoo>