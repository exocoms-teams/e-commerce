<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fragment réutilisable : barre de catégories horizontale -->
    <template id="alt_category_nav_fragment" name="Planet Mobil - Fragment barre catégories">
        <nav class="alt-cat-nav">
            <div class="alt-cat-nav-inner">
                <a href="/shop" class="alt-cat-nav-item">
                    <i class="fa fa-th-large" /> Tous les produits
                </a>
                <a href="/shop?x_is_promotion=1" class="alt-cat-nav-item">
                    <i class="fa fa-bolt" /> Promotions
                </a>
                <a href="/shop?order=publish_date+desc" class="alt-cat-nav-item">
                    <i class="fa fa-certificate" /> Nouveautés
                </a>
                <t t-set="_pm_native_ids"
                    t-value="request.env['ir.model.data'].sudo().search([('model', '=', 'product.public.category')]).mapped('res_id')" />
                <t t-set="nav_cats"
                    t-value="request.env['product.public.category'].sudo().search([('parent_id', '=', False), ('id', 'not in', _pm_native_ids)])" />
                <t t-foreach="nav_cats" t-as="nc">
                    <a t-att-href="'/shop/category/' + slug(nc)" class="alt-cat-nav-item">
                        <t t-out="nc.name" />
                    </a>
                </t>
                <a href="/avis" class="alt-cat-nav-item">
                    <i class="fa fa-star-o" /> Avis clients
                </a>
                <a href="/contact" class="alt-cat-nav-item alt-cat-nav-contact">
                    <i class="fa fa-phone" /> Contact
                </a>
            </div>
        </nav>
    </template>

    <template id="layout" name="Planet Mobil - Layout principal">
        <t t-call="website.layout">
            <t t-call="website_planet_mobil.alt_category_nav_fragment" />
            <div class="tsp-wrapper">
                <nav class="tsp-sidebar">
                    <ul class="tsp-nav">
                        <li class="tsp-nav-item tsp-nav-active">
                            <a href="/accueil"><i class="fa fa-bars"/> Accueil</a>
                        </li>
                        <li class="tsp-nav-item">
                            <a href="/shop?x_is_promotion=1"><i class="fa fa-star-o"/> Promotions</a>
                        </li>
                        <li class="tsp-nav-item">
                            <a href="/shop?order=publish_date+desc"><i class="fa fa-star-o"/> Nouveautes</a>
                        </li>
                        <li class="tsp-nav-item tsp-nav-dropdown">
                            <a href="/shop">
                                <i class="fa fa-th-large"/> Tous les produits
                                <i class="fa fa-chevron-down tsp-chevron"/>
                            </a>
                            <ul class="tsp-submenu">
                                <t t-set="_pm_native_ids2"
                                    t-value="request.env['ir.model.data'].sudo().search([('model', '=', 'product.public.category')]).mapped('res_id')" />
                                <t t-set="categories"
                                    t-value="request.env['product.public.category'].sudo().search([('parent_id', '=', False), ('id', 'not in', _pm_native_ids2)])"/>
                                <t t-foreach="categories" t-as="cat">
                                    <li>
                                        <a t-att-href="'/shop/category/' + slug(cat)">
                                            <i class="fa fa-tag"/> <t t-out="cat.name"/>
                                        </a>
                                    </li>
                                </t>
                            </ul>
                        </li>
                        <li class="tsp-nav-item">
                            <a href="/avis"><i class="fa fa-star-o"/> Avis</a>
                        </li>
                        <li class="tsp-nav-item">
                            <a href="/contact"><i class="fa fa-phone"/> Contact</a>
                        </li>
                    </ul>
                </nav>
                <main class="tsp-main">
                    <t t-out="0"/>
                </main>
            </div>
        </t>
    </template>

    
</odoo>
