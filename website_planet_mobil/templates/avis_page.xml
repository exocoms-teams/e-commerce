<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="avis_page" name="Planet Mobil - Avis clients">
        <t t-call="website_planet_mobil.layout">

            <div id="wrap" class="oe_structure">
                <div id="oe_structure_avis_top" class="oe_structure oe_empty" />
                <div class="avis-hero">
                    <h1>⭐ Avis de nos clients</h1>
                    <p>Ce que pensent nos clients de Planet Mobil</p>
                </div>

                <div id="oe_structure_avis_stats" class="oe_structure oe_empty" />
                <t t-if="stats">
                    <div class="avis-stats">
                        <div class="avis-stat-main">
                            <div class="note">
                                <t t-out="stats['avg']" />
                            </div>
                            <div class="stars-big">
                                <t t-foreach="range(int(stats['avg']))" t-as="s">
                                    <i class="fa fa-star" />
                                </t>
                                <t t-if="stats['avg'] % 1 >= 0.5">
                                    <i class="fa fa-star-half-o" />
                                </t>
                            </div>
                            <p>Basé sur <t t-out="stats['total']" /> avis vérifiés</p>
                        </div>
                        <div class="avis-stat-bars">
                            <t t-foreach="[5,4,3,2,1]" t-as="star">
                                <div class="avis-bar-row">
                                    <span><t t-out="star" /> ⭐</span>
                                    <div class="avis-bar-bg">
                                        <div class="avis-bar-fill"
                                            t-att-style="'width:' + str(stats['dist'][star]) + '%'" />
                                    </div>
                                    <span><t t-out="stats['dist'][star]" />%</span>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="avis-stats" style="text-align:center; padding:32px;">
                        <p style="color:var(--muted)">Aucun avis pour le moment.</p>
                    </div>
                </t>
                <div id="oe_structure_avis_grid" class="oe_structure oe_empty" />
                <div class="avis-grid">
                    <t t-foreach="avis_list" t-as="avis">
                        <div class="avis-card">
                            <div class="avis-card-header">
                                <div class="avis-avatar">
                                    <t t-out="avis.name[0].upper()" />
                                </div>
                                <div class="avis-author-info">
                                    <h4>
                                        <t t-out="avis.name" />
                                    </h4>
                                    <span>
                                        <t t-out="avis.date" />
                                    </span>
                                </div>
                            </div>
                            <div class="avis-card-stars">
                                <t t-foreach="range(avis.rating)" t-as="s">
                                    <i class="fa fa-star" />
                                </t>
                                <t t-foreach="range(5 - avis.rating)" t-as="s">
                                    <i class="fa fa-star-o" style="color:#d1d5db" />
                                </t>
                            </div>
                            <p class="avis-card-text">
                                <t t-out="avis.comment" />
                            </p>
                            <t t-if="avis.product">
                                <div class="avis-card-product">
                                    <i class="fa fa-tag" />
                                    <t t-out="avis.product" />
                                </div>
                            </t>
                            <div class="avis-verified"><i class="fa fa-check-circle" /> Achat
                                vérifié</div>
                        </div>
                    </t>
                </div>

                <div class="avis-form-wrap">
                    <h2>Laisser un avis</h2>
                    <form action="/avis/submit" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                        <div class="form-group">
                            <label>Nom *</label>
                            <input type="text" name="name" required="1" class="form-control"
                                placeholder="Votre nom" />
                        </div>
                        <div class="form-group">
                            <label>Note *</label>
                            <select name="rating" class="form-control">
                                <option value="5">⭐⭐⭐⭐⭐</option>
                                <option value="4">⭐⭐⭐⭐</option>
                                <option value="3">⭐⭐⭐</option>
                                <option value="2">⭐⭐</option>
                                <option value="1">⭐</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Produit acheté</label>
                            <input type="text" name="product" class="form-control"
                                placeholder="Ex: iPhone 15 Pro Max" />
                        </div>
                        <div class="form-group">
                            <label>Commentaire *</label>
                            <textarea name="comment" required="1" class="form-control"
                                placeholder="Votre avis..." />
                        </div>
                        <button type="submit" class="form-submit">
                            <i class="fa fa-paper-plane" /> Envoyer mon avis </button>
                    </form>
                </div>
                <div id="oe_structure_avis_bottom" class="oe_structure oe_empty" />
            </div>
        </t>
    </template>

</odoo>