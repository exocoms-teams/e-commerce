                    <div class="pm-star-picker" id="pm-star-picker">
                        <button type="button" class="pm-star-btn" data-val="1">&#xf005;</button>
                        <button type="button" class="pm-star-btn" data-val="2">&#xf005;</button>
                        <button type="button" class="pm-star-btn" data-val="3">&#xf005;</button>
                        <button type="button" class="pm-star-btn" data-val="4">&#xf005;</button>
                        <button type="button" class="pm-star-btn" data-val="5">&#xf005;</button>
