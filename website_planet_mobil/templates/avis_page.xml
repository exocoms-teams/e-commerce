    </div>
</div>

<div id="oe_structure_avis_bottom" class="oe_structure oe_empty" />

<!-- ═══════════ SCRIPTS ═══════════ -->
<script>
(function () {
    /* ── Barres animées au scroll ── */
    var bars = document.querySelectorAll('.pm-bar-fill.pm-bar-anim');
    if (bars.length) {
        var obs = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (!e.isIntersecting) return;
                obs.unobserve(e.target);
                var w = e.target.dataset.width || '0';
                setTimeout(function () {
                    e.target.style.width = w + '%';
                }, 100);
            });
        }, { threshold: 0.2 });
        bars.forEach(function (b) { obs.observe(b); });
    }

    /* ── Filtres par note ── */
    var filterBtns = document.querySelectorAll('.pm-filter-btn');
    var cards = document.querySelectorAll('.pm-avis-card');
    filterBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
            filterBtns.forEach(function (b) { b.classList.remove('active'); });
            this.classList.add('active');
            var f = this.dataset.filter;
            cards.forEach(function (c) {
                if (f === 'all' || c.dataset.rating === f) {
                    c.style.display = '';
                } else {
                    c.style.display = 'none';
                }
            });
        });
    });

    /* ── Star picker ── */
    var hints = ['', 'Mauvais', 'Passable', 'Bien', 'Très bien', 'Excellent !'];
    var starBtns = document.querySelectorAll('.pm-star-btn');
    var hintEl = document.getElementById('pm-star-hint');
    var ratingInput = document.getElementById('pm-rating-input');
    var currentRating = 0;

    function setStars(n) {
        starBtns.forEach(function (b) {
            b.classList.toggle('active', +b.dataset.val &lt;= n);
        });
        if (hintEl) hintEl.textContent = n > 0 ? hints[n] : 'Cliquez pour noter';
        if (ratingInput) ratingInput.value = n || '';
        currentRating = n;
    }

    starBtns.forEach(function (btn) {
        btn.addEventListener('mouseenter', function () { setStars(+this.dataset.val); });
        btn.addEventListener('click', function () { currentRating = +this.dataset.val; setStars(currentRating); });
    });
    document.getElementById('pm-star-picker') &amp;&amp;
    document.getElementById('pm-star-picker').addEventListener('mouseleave', function () {
        setStars(currentRating);
    });

    /* ── Smooth scroll ancre ── */
    document.querySelectorAll('a[href="#avis-form"]').forEach(function (a) {
        a.addEventListener('click', function (e) {
            e.preventDefault();
            var el = document.getElementById('avis-form');
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    });
})();
</script>

</div>
</t>
</template>
