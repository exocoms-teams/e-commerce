<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="shop_layout" name="Planet Mobil - Shop"
            inherit_id="website_sale.products">

            <!-- Supprime la sidebar native -->
            <xpath expr="//aside[@id='products_grid_before']" position="replace" />

            <!-- Injecte notre sidebar avant la grille produits -->
            <xpath expr="//div[hasclass('o_wsale_products_main_row')]" position="before">
                <nav class="tsp-sidebar">
                    <ul class="tsp-nav">
                        <li class="tsp-nav-item">
                            <a href="/accueil"><i class="fa fa-bars" /> Accueil</a>
                        </li>
                        <li class="tsp-nav-item">
                            <a href="/shop?x_is_promotion=1"><i class="fa fa-star-o" /> Promotions</a>
                        </li>
                        <li class="tsp-nav-item">
                            <a href="/shop?order=publish_date+desc"><i class="fa fa-star-o" /> Nouveautes</a>
                        </li>
                        <li class="tsp-nav-item tsp-nav-dropdown">
                            <a href="/shop">
                                <i class="fa fa-th-large" /> Tous les produits <i
                                    class="fa fa-chevron-down tsp-chevron" />
                            </a>
                            <ul class="tsp-submenu">
                                <li>
                                    <a href="/shop/category/smartphones-1"><i class="fa fa-mobile" />
                                        Smartphones</a>
                                </li>
                                <li>
                                    <a href="/shop/category/montres-2"><i class="fa fa-clock-o" />
                                        Montres connectees</a>
                                </li>
                                <li>
                                    <a href="/shop/category/accessoires-3"><i class="fa fa-shield" />
                                        Coques et Accessoires</a>
                                </li>
                                <li>
                                    <a href="/shop/category/tv-4"><i class="fa fa-television" /> TV
                                        et Audio</a>
                                </li>
                            </ul>
                        </li>
                        <li class="tsp-nav-item">
                            <a href="/avis"><i class="fa fa-star-o" /> Avis</a>
                        </li>
                        <li class="tsp-nav-item">
                            <a href="/contact"><i class="fa fa-phone" /> Contact</a>
                        </li>
                    </ul>
                </nav>
            </xpath>

            <!-- Injecte la barre de filtres avant la grille produits -->
            <xpath expr="//h1[hasclass('o_wsale_shop_title')]" position="after">


                <div class="tsp-filter-bar">
                    <div class="tsp-filter-group">
                        <label>Prix</label>
                        <div class="tsp-filter-price">
                            <input type="number" placeholder="Min" class="tsp-filter-input"
                                id="filter-price-min" />
                            <span>-</span>
                            <input type="number" placeholder="Max" class="tsp-filter-input"
                                id="filter-price-max" />
                        </div>
                    </div>

                    <div class="tsp-filter-group">
                        <label>Marque</label>
                        <div class="tsp-custom-select" data-filter="marque">
                            <div class="tsp-custom-selected">Toutes <i
                                    class="fa fa-chevron-down" /></div>
                            <ul class="tsp-custom-options">
                                <li data-value="">Toutes</li>
                                <!--Peupler par js-->
                            </ul>
                        </div>
                    </div>

                    <div class="tsp-filter-group">
                        <label>Couleur</label>
                        <div class="tsp-custom-select" data-filter="couleur">
                            <div class="tsp-custom-selected">Toutes <i
                                    class="fa fa-chevron-down" /></div>
                            <ul class="tsp-custom-options">
                                <li data-value="">Toutes</li>
                                <!--peupler par js-->
                            </ul>
                        </div>
                    </div>

                    <div class="tsp-filter-group">
                        <label>Promotion</label>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <input type="checkbox" id="filter-promotion"/>
                            <label for="filter-promotion" style="font-size:0.88rem; cursor:pointer;">En promotion</label>
                        </div>
                    </div>

                    <!--filtres dynamiques par categorie injectés par JS-->
                    <div id="tsp-category-filters"></div>

                    <button class="tsp-filter-btn" id="tsp-apply-filters">
                        <i class="fa fa-filter" /> Filtrer </button>
                </div>

            </xpath>

        </template>

    </data>
</odoo>