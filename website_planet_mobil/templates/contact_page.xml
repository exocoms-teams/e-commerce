<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="contact_page" name="Planet Mobil - Contact">
        <t t-call="website_planet_mobil.layout">

            <div id="wrap" class="oe_structure">
                <div id="oe_structure_contact_top" class="oe_structure oe_empty" />
                <div class="contact-hero">
                    <h1>📞 Contactez-nous</h1>
                    <p>Notre équipe est disponible pour répondre à toutes vos questions</p>
                </div>

                <div id="oe_structure_contact_middle" class="oe_structure oe_empty" />

                <div class="contact-layout">
                    <div class="contact-infos">
                        <div class="contact-info-card">
                            <div class="contact-info-icon">
                                <i class="fa fa-map-marker" />
                            </div>
                            <div>
                                <h4>Notre adresse</h4>
                                <p>15 Rue de la Technologie<br />75008 Paris, France</p>
                            </div>
                        </div>
                        <div class="contact-info-card">
                            <div class="contact-info-icon">
                                <i class="fa fa-phone" />
                            </div>
                            <div>
                                <h4>Téléphone</h4>
                                <p>+33 (0)6 64 97 80 50<br />Lun–Ven, 9h–18h</p>
                            </div>
                        </div>
                        <div class="contact-info-card">
                            <div class="contact-info-icon">
                                <i class="fa fa-envelope" />
                            </div>
                            <div>
                                <h4>Email</h4>
                                <p>contact@exocoms.com<br />Réponse sous 24h</p>
                            </div>
                        </div>
                        <div class="contact-info-card">
                            <div class="contact-info-icon">
                                <i class="fa fa-clock-o" />
                            </div>
                            <div>
                                <h4>Horaires</h4>
                                <p>Lundi – Vendredi : 9h – 18h<br />Samedi : 10h – 16h</p>
                            </div>
                        </div>
                    </div>

                    <div class="contact-form-wrap">
                        <h2><i class="fa fa-paper-plane" style="color:#2c4ecb;margin-right:8px" />Envoyer
                            un message</h2>
                        <div class="s_website_form">
                            <form class="o_mark_required" action="/website_form/mail.mail"
                                method="post"
                                data-model-name="mail.mail" data-success-mode="redirect"
                                data-success-page="/contact">
                                <div class="form-row">
                                    <div class="s_website_form_field col-md-6 form-group">
                                        <label class="s_website_form_label">Nom *</label>
                                        <input type="text" name="contact_name"
                                            placeholder="Votre nom"
                                            required="1" class="form-control s_website_form_input" />
                                    </div>
                                    <div class="s_website_form_field col-md-6 form-group">
                                        <label class="s_website_form_label">Prénom *</label>
                                        <input type="text" name="partner_name"
                                            placeholder="Votre prénom"
                                            required="1" class="form-control s_website_form_input" />
                                    </div>
                                </div>
                                <div class="s_website_form_field form-group">
                                    <label class="s_website_form_label">Adresse email *</label>
                                    <input type="email" name="email_from"
                                        placeholder="exemple@email.com"
                                        required="1" class="form-control s_website_form_input" />
                                </div>
                                <div class="s_website_form_field form-group">
                                    <label class="s_website_form_label">Sujet</label>
                                    <input type="text" name="subject" placeholder="Votre sujet"
                                        class="form-control s_website_form_input" />
                                </div>
                                <div class="s_website_form_field form-group">
                                    <label class="s_website_form_label">Votre question *</label>
                                    <textarea name="body_html"
                                        placeholder="Décrivez votre question..."
                                        required="1" class="form-control s_website_form_input" />
                                </div>
                                <input type="hidden" name="email_to" value="contact@exocoms.com" />
                                <div class="s_website_form_submit">
                                    <button class="form-submit" type="submit">
                                        <i class="fa fa-paper-plane" /> Envoyer le message </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div id="oe_structure_contact_bottom" class="oe_structure oe_empty" />
            </div>
        </t>
    </template>

</odoo>