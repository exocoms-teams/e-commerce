<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="contact_page" name="Planet Mobil - Contact">

        <t t-call="website_planet_mobil.layout">

            <div id="wrap" class="oe_structure">
                <div id="oe_structure_contact_top" class="oe_structure oe_empty"
                    data-editor-message-default="true"
                    data-editor-message="DRAG BUILDING BLOCKS HERE" />
                <div class="contact-hero">
                    <h1>📞 Contactez-nous</h1>
                    <p>Notre équipe est disponible pour répondre à toutes vos questions</p>
                </div>

                <div id="oe_structure_contact_middle" class="oe_structure oe_empty"
                    data-editor-message-default="true"
                    data-editor-message="DRAG BUILDING BLOCKS HERE" />

                <div id="oe_structure_contact_bottom" class="oe_structure oe_empty"
                    data-editor-message-default="true"
                    data-editor-message="DRAG BUILDING BLOCKS HERE" />
                <section class="s_website_form_cover o_colored_level pb88 o_full_screen_height"
                    data-snippet="s_website_form_cover" data-name="Form Cover">
                    <div class="container-fluid">
                        <div class="row s_nb_column_fixed o_grid_mode" data-row-count="14">


                            <div
                                class="px-4 o_colored_level rounded border o_cc o_cc1 g-col-lg-5 o_grid_item col-lg-5 shadow g-height-13"
                                style="--box-border-bottom-left-radius: 15px; --box-border-bottom-right-radius: 15px; --box-border-top-right-radius: 15px; --box-border-top-left-radius: 15px; --box-border-left-width: 0px; --box-border-bottom-width: 0px; --box-border-right-width: 0px; --box-border-top-width: 0px; z-index: 2; grid-area: 2 / 7 / 15 / 12; --grid-item-padding-y: 20px; box-shadow: rgb(156, 198, 239) 0px 8px 16px 0px !important; border-style: double !important; border-left-color: var(--o-color-2) !important; border-bottom-color: var(--o-color-2) !important; border-right-color: var(--o-color-2) !important; border-top-color: var(--o-color-2) !important; --grid-item-padding-x: 20px;">
                                <h2>
                                    <span style="font-size: 32px;">
                                        <font style="color: rgb(91, 124, 250);">➤</font>
                                    </span>
                                    <font style="color: rgb(91, 124, 250);">
                                        <span class="h3-fs">
                                            <strong> </strong>
                                        </span>
                                    </font>
                                    <font>
                                        <span class="h3-fs">
                                            <strong>Envoyer un message</strong>
                                        </span>
                                    </font>
                                </h2>
                                <section class="s_website_form pt16 pb0" data-vcss="001"
                                    data-snippet="s_website_form" data-name="Form">
                                    <div class="container-fluid">
                                        <form action="/website/form/" method="post"
                                            enctype="multipart/form-data"
                                            class="o_mark_required" data-mark="*"
                                            data-pre-fill="true" data-model_name="crm.lead"
                                            data-success-mode="message"
                                            data-success-page="/contactus-thank-you">
                                            <div class="s_website_form_rows row s_col_no_bgcolor">
                                                <div data-name="Field"
                                                    class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required col-lg-6"
                                                    data-type="char" data-translated-name="Nom">
                                                    <label class="s_website_form_label"
                                                        style="width: 200px" for="o6egv76stxhp">
                                                        <span
                                                            class="s_website_form_label_content">
                                                            Nom</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input
                                                        class="form-control s_website_form_input"
                                                        type="text" name="contact_name" required=""
                                                        placeholder="Votre nom"
                                                        id="o6egv76stxhp" data-fill-with="name" />
                                                </div>
                                                <div style="animation-name: dummy;"
                                                    data-name="Field"
                                                    class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required col-lg-6"
                                                    data-type="char"
                                                    data-translated-name="Custom Text">
                                                    <label class="s_website_form_label"
                                                        style="width: 200px" for="or92i5hnx2z">
                                                        <span
                                                            class="s_website_form_label_content">
                                                            Prenom</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input
                                                        class="form-control s_website_form_input"
                                                        type="text" name="Prenom"
                                                        id="or92i5hnx2z" required=""
                                                        placeholder="Votre prénom" />
                                                </div>
                                                <div data-name="Field"
                                                    class="s_website_form_field mb-3 col-12 s_website_form_custom"
                                                    data-type="tel"
                                                    data-translated-name="N° de téléphone">
                                                    <label class="s_website_form_label"
                                                        style="width: 200px" for="o5kd9r1k9cv3">
                                                        <span
                                                            class="s_website_form_label_content">N°
                                                            de téléphone</span>
                                                    </label>
                                                    <input
                                                        class="form-control s_website_form_input"
                                                        type="tel" name="phone"
                                                        placeholder="ex.: 06 11 22 33 44"
                                                        id="o5kd9r1k9cv3" data-fill-with="phone" />
                                                </div>
                                                <div data-name="Field"
                                                    class="s_website_form_field mb-3 col-12 s_website_form_model_required"
                                                    data-type="email"
                                                    data-translated-name="Adresse email">
                                                    <label class="s_website_form_label"
                                                        style="width: 200px" for="osvrnmgdmje">
                                                        <span
                                                            class="s_website_form_label_content">Adresse
                                                            email</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input
                                                        class="form-control s_website_form_input"
                                                        type="email" name="email_from"
                                                        required=""
                                                        placeholder="exemple@email.com"
                                                        id="osvrnmgdmje" data-fill-with="email" />
                                                </div>

                                                <div data-name="Field"
                                                    class="s_website_form_field mb-3 col-12 s_website_form_model_required"
                                                    data-type="char"
                                                    data-translated-name="Sujet">
                                                    <label class="s_website_form_label"
                                                        style="width: 200px" for="ovpwtl9fs0i">
                                                        <span
                                                            class="s_website_form_label_content">
                                                            Sujet</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input
                                                        class="form-control s_website_form_input"
                                                        type="text" name="name" required=""
                                                        value="" placeholder="Votre sujet"
                                                        id="ovpwtl9fs0i"
                                                        data-fill-with="undefined" />
                                                </div>
                                                <div data-name="Field"
                                                    class="s_website_form_field mb-3 col-12 s_website_form_custom s_website_form_required pb4"
                                                    data-type="text"
                                                    data-translated-name="Your Question">
                                                    <label class="s_website_form_label"
                                                        style="width: 200px" for="oz239pavu8x">
                                                        <span
                                                            class="s_website_form_label_content">Votre
                                                            question</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <textarea
                                                        class="form-control s_website_form_input"
                                                        name="description" required=""
                                                        placeholder="Décrivez votre question"
                                                        id="oz239pavu8x" rows="5" />
                                                </div>
                                                <div
                                                    class="mb-0 py-2 col-12 s_website_form_submit col-lg-4 offset-lg-7 text-center s_website_form_no_submit_label"
                                                    data-name="Submit Button">
                                                    <div style="width: 200px;"
                                                        class="s_website_form_label">
                                                        <br />
                                                    </div>
                                                    <span id="s_website_form_result" />
                                                    <a href="#" role="button"
                                                        class="btn btn-primary s_website_form_send o_translate_inline">
                                                        Envoyer</a>
                                                </div>
                                            </div>
                                        </form>
                                        <div class="s_website_form_end_message d-none">
                                            <div class="oe_structure">
                                                <section
                                                    class="s_text_block o_colored_level rounded px-5 text-center pb96 pt80"
                                                    data-snippet="s_text_block">
                                                    <i
                                                        class="fa fa-paper-plane fa-2x mb-3 rounded-circle text-bg-success"
                                                        role="img" aria-hidden="true"
                                                        title="Success" />
                                                    <h1 class="fw-bolder">Merci pour votre
                                                        message</h1>
                                                    <p class="lead mb-0">Notre équipe vous répondra
                                                        dans les plus brefs délais. En attendant,
                                                        nous vous invitons à visiter notre <a
                                                            href="/"
                                                            class="o_translate_inline">site web</a>
                                                        .</p>
                                                </section>
                                            </div>
                                        </div>
                                    </div>
                                </section>
                            </div>
                            <div
                                class="col-lg-4 o_colored_level g-height-3 g-col-lg-4 o_grid_item"
                                style="z-index: 8; grid-area: 5 / 2 / 8 / 6;">
                                <div
                                    class="s_card card o_cc mt-0 o_cc1 o_colored_level flex-lg-row o_card_img_horizontal shadow"
                                    data-vxml="001" data-snippet="s_card" data-name="Card"
                                    style="max-width: 100%; --card-img-size-h: 24.99999999%; --card-img-ratio-align: 48%; box-shadow: rgb(156, 198, 239) 0px 8px 16px 0px !important;">
                                    <figure
                                        class="o_card_img_wrapper mb-0 o_card_img_adjust_v ratio ratio-1x1">
                                        <span
                                            class="fa fa-phone o_card_img o_editable_media text-o-color-3 mx-auto d-block fa-2x rounded-start rounded-circle shadow img-thumbnail"
                                            style="background-color: rgb(91, 124, 250);" />
                                    </figure>
                                    <div class="card-body">
                                        <h2 class="h3-fs" style="text-align: left;">
                                            <span style="font-size: 28px;">Téléphone</span>
                                            <br />
                                        </h2>
                                        <p style="text-align: left;">
                                            <font class="text-600">+33 (0)6 64 97 80
                                                50,&amp;nbsp;Lun-Ven, 9h-18h</font>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div
                                class="col-lg-4 o_colored_level g-height-3 g-col-lg-4 o_grid_item"
                                style="z-index: 9; grid-area: 8 / 2 / 11 / 6;">
                                <div
                                    class="s_card card o_cc mt-0 o_cc1 shadow o_colored_level o_card_img_horizontal flex-lg-row"
                                    data-vxml="001" data-snippet="s_card" data-name="Card"
                                    style="max-width: 100%; --card-img-size-h: 24.99999999%; --card-img-ratio-align: 48%; box-shadow: rgb(156, 198, 239) 0px 8px 16px 0px !important;">
                                    <figure
                                        class="o_card_img_wrapper mb-0 o_card_img_adjust_v ratio ratio-1x1">
                                        <span
                                            class="fa fa-envelope-o o_card_img o_editable_media text-o-color-3 mx-auto d-block fa-2x rounded-circle rounded-start img-thumbnail shadow"
                                            style="background-color: rgb(91, 124, 250);" />
                                    </figure>
                                    <div class="card-body">
                                        <h2 class="h3-fs" style="text-align: left;">
                                            <span style="font-size: 28px;">Email</span>
                                            <br />
                                        </h2>
                                        <p style="text-align: left;">
                                            <a href="mailto:contact@exocoms.com"
                                                class="o_translate_inline">
                                                <font class="text-600">contact@exocoms.com</font>
                                            </a>
                                            <font class="text-600">, réponse sous 24h</font>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div
                                class="col-lg-4 o_colored_level g-height-3 g-col-lg-4 o_grid_item"
                                style="z-index: 10; grid-area: 11 / 2 / 14 / 6;">
                                <div
                                    class="s_card card o_cc mt-0 o_cc1 shadow o_colored_level flex-lg-row o_card_img_horizontal"
                                    data-vxml="001" data-snippet="s_card" data-name="Card"
                                    style="max-width: 100%; --card-img-size-h: 24.99999999%; --card-img-ratio-align: 48%; box-shadow: rgb(156, 198, 239) 0px 8px 16px 0px !important;">
                                    <figure
                                        class="o_card_img_wrapper mb-0 o_card_img_adjust_v ratio ratio-1x1">
                                        <span
                                            class="fa fa-clock-o o_card_img o_editable_media text-o-color-3 mx-auto d-block rounded-start fa-2x rounded-circle img-thumbnail shadow"
                                            style="background-color: rgb(91, 124, 250);" />
                                    </figure>
                                    <div class="card-body">
                                        <h2 class="h3-fs" style="text-align: left;">
                                            <span style="font-size: 28px;">Horaires</span>
                                            <br />
                                        </h2>
                                        <p style="text-align: left;">
                                            <font class="text-600">Lundi - Vendredi : 9h-18h</font>
                                        </p>
                                        <p style="text-align: left;">
                                            <font class="text-600">Samedi : 10h 16h</font>
                                            <br />
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div
                                class="o_colored_level o_grid_item g-col-lg-4 col-12 g-height-5 col-lg-4"
                                style="z-index: 7; grid-area: 2 / 2 / 7 / 6;">
                                <div
                                    class="s_card card o_cc mt-0 o_colored_level o_cc1 shadow o_card_img_horizontal flex-lg-row"
                                    data-vxml="001" data-snippet="s_card" data-name="Card"
                                    style="max-width: 100%; --card-img-size-h: 24.99999999%; box-shadow: rgb(156, 198, 239) 0px 8px 16px 0px !important;">
                                    <figure
                                        class="o_card_img_wrapper mb-0 o_card_img_adjust_v ratio ratio-1x1">
                                        <span
                                            class="fa o_card_img o_editable_media d-block mx-auto text-o-color-3 rounded-circle fa-map-marker fa-2x shadow img-thumbnail rounded-start"
                                            style="background-color: rgb(91, 124, 250);" />
                                    </figure>
                                    <div class="card-body">
                                        <h2 class="h3-fs" style="text-align: left;">
                                            <span style="font-size: 28px;">Notre adresse</span>
                                        </h2>
                                        <p style="text-align: left;">
                                            <font class="text-600">15 Rue de la Technologie,
                                                75008 Paris France</font>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

</odoo>