<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <template id="category_page" name="TechShop Pro - Catalogue">
        <t t-call="website_planet_mobil.layout">

            <section class="tsp-section">
                <div class="tsp-section-header">
                    <h2 class="tsp-section-title">
                        <t t-if="category">
                            <t t-out="category"/>
                        </t>
                        <t t-else="">
                            Tous les produits
                        </t>
                    </h2>
                </div>

                <div class="tsp-filter-bar">
                    <div class="tsp-filter-group">
                        <label>Prix</label>
                        <div class="tsp-filter-price">
                            <input type="number" placeholder="Min" class="tsp-filter-input"/>
                            <span>-</span>
                            <input type="number" placeholder="Max" class="tsp-filter-input"/>
                        </div>
                    </div>

                    <div class="tsp-filter-group">
                        <label>Marque</label>
                        <div class="tsp-custom-select" data-filter="marque">
                            <div class="tsp-custom-selected">Toutes <i class="fa fa-chevron-down"/></div>
                            <ul class="tsp-custom-options">
                                <li data-value="">Toutes</li>
                                <t t-if="brands">
                                    <t t-foreach="brands" t-as="brand">
                                        <li t-att-data-value="brand">
                                            <input type="checkbox" t-att-id="'marque-' + brand"/>
                                            <label t-att-for="'marque-' + brand"><t t-out="brand"/></label>
                                        </li>
                                    </t>
                                </t>
                                <t t-else="">
                                    <li data-value="apple">
                                        <input type="checkbox" id="marque-apple"/>
                                        <label for="marque-apple">Apple</label>
                                    </li>
                                    <li data-value="samsung">
                                        <input type="checkbox" id="marque-samsung"/>
                                        <label for="marque-samsung">Samsung</label>
                                    </li>
                                    <li data-value="sony">
                                        <input type="checkbox" id="marque-sony"/>
                                        <label for="marque-sony">Sony</label>
                                    </li>
                                    <li data-value="lg">
                                        <input type="checkbox" id="marque-lg"/>
                                        <label for="marque-lg">LG</label>
                                    </li>                                
                                </t>
                            </ul>
                        </div>
                    </div>

                    <div class="tsp-filter-group">
                        <label>Note</label>
                        <div class="tsp-custom-select" data-filter="note">
                            <div class="tsp-custom-selected">Toutes <i class="fa fa-chevron-down"/></div>
                            <ul class="tsp-custom-options">
                                <li data-value="5">
                                    <input type="checkbox" id="note-5"/>
                                    <label for="note-5">⭐⭐⭐⭐⭐</label>
                                </li>
                                <li data-value="4">
                                    <input type="checkbox" id="note-4"/>
                                    <label for="note-4">⭐⭐⭐⭐ et +</label>
                                </li>
                                <li data-value="3">
                                    <input type="checkbox" id="note-3"/>
                                    <label for="note-3">⭐⭐⭐ et +</label>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="tsp-filter-group">
                        <label>Couleur</label>
                        <div class="tsp-custom-select" data-filter="couleur">
                            <div class="tsp-custom-selected">Toutes <i class="fa fa-chevron-down"/> </div>
                            <ul class="tsp-custom-options">
                                <li data-value="">Toutes</li>
                                <t t-if="colors">
                                    <t t-foreach="colors" t-as="color">
                                        <li t-att-data-value="color">
                                            <input type="checkbox" t-att-id="'couleur-' + color"/>
                                            <label t-att-for="'couleur-' + color"><t t-out="color"/></label>                                   
                                        </li>
                                    </t>
                                </t>
                                <t t-else="">
                                    <li data-value="noir">
                                        <input type="checkbox" id="couleur-noir"/>
                                        <label for="couleur-noir">Noir</label>
                                    </li>
                                    <li data-value="blanc">
                                        <input type="checkbox" id="couleur-blanc"/>
                                        <label for="couleur-blanc">Blanc</label>
                                    </li>
                                    <li data-value="bleu">
                                        <input type="checkbox" id="couleur-bleu"/>
                                        <label for="couleur-bleu">Bleu</label>
                                    </li>
                                    <li data-value="rouge">
                                        <input type="checkbox" id="couleur-rouge"/>
                                        <label for="couleur-rouge">Rouge</label>
                                    </li>
                                    <li data-value="rose">
                                        <input type="checkbox" id="couleur-rose"/>
                                        <label for="couleur-rose">Rose</label>
                                    </li>
                                    <li data-value="or">
                                        <input type="checkbox" id="couleur-or"/>
                                        <label for="couleur-or">Or</label>
                                    </li>                           
                                </t>
                            </ul>
                        </div>
                    </div>

                   

                    <t t-if="category == 'Smartphones'">
                        <div class="tsp-filter-group">
                            <label>Système</label>
                            <div class="tsp-custom-select" data-filter="systeme">
                                <div class="tsp-custom-selected">Tous <i class="fa fa-chevron-down"/></div>
                                <ul class="tsp-custom-options">
                                <li data-value="ios">
                                    <input type="checkbox" id="systeme-ios"/>
                                    <label for="systeme-ios">iOS</label>
                                </li>
                                <li data-value="android">
                                    <input type="checkbox" id="systeme-android"/>
                                    <label for="systeme-android">Android</label>
                                </li>
                                </ul>
                            </div>
                        </div>

                        <div class="tsp-filter-group">
                            <label>Stockage</label>
                            <div class="tsp-custom-select" data-filter="stockage">
                                <div class="tsp-custom-selected">Tous <i class="fa fa-chevron-down"/></div>
                                <ul class="tsp-custom-options">
                                    <li data-value="64">
                                        <input type="checkbox" id="stockage-64"/>
                                        <label for="stockage-64">64 GB</label>
                                    </li>
                                    <li data-value="128">
                                        <input type="checkbox" id="stockage-128"/>
                                        <label for="stockage-128">128 GB</label>
                                    </li>
                                    <li data-value="256">
                                        <input type="checkbox" id="stockage-256"/>
                                        <label for="stockage-256">256 GB</label>
                                    </li>
                                    <li data-value="512">
                                        <input type="checkbox" id="stockage-512"/>
                                        <label for="stockage-512">512 GB</label>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="tsp-filter-group">
                            <label>Taille écran</label>
                            <div class="tsp-custom-select" data-filter="taille">
                                <div class="tsp-custom-selected">Toutes <i class="fa fa-chevron-down"/></div>
                                <ul class="tsp-custom-options">
                                    <li data-value="5">
                                        <input type="checkbox" id="taille-5"/>
                                        <label for="taille-5">5"</label>
                                    </li>
                                    <li data-value="6">
                                        <input type="checkbox" id="taille-6"/>
                                        <label for="taille-6">6"</label>
                                    </li>
                                    <li data-value="6.5">
                                        <input type="checkbox" id="taille-6.5"/>
                                        <label for="taille-6.5">6.5"</label>
                                    </li>
                                    <li data-value="7">
                                        <input type="checkbox" id="taille-7"/>
                                        <label for="taille-7">7"</label>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>

                    <t t-if="category=='Montres'">
                        <div class="tsp-filter-group">
                            <label>Compatibilité</label>
                            <div class="tsp-custom-select" data-filter="compatibilite">
                                <div class="tsp-custom-selected">Toutes <i class="fa fa-chevron-down"/></div>
                                <ul class="tsp-custom-options">
                                    <li data-value="ios">
                                        <input type="checkbox" id="compat-ios"/>
                                        <label for="compat-ios">iOS</label>
                                    </li>
                                    <li data-value="android">
                                        <input type="checkbox" id="compat-android"/>
                                        <label for="compat-android">Android</label>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>

                    <t t-if="category=='Televisions'">
                        <div class="tsp-filter-group">
                            <label>Taille</label>
                            <div class="tsp-custom-select" data-filter="taille">
                                <div class="tsp-custom-selected">Toutes <i class="fa fa-chevron-down"/></div>
                                <ul class="tsp-custom-options">
                                    <li data-value="43">
                                        <input type="checkbox" id="taille-43"/>
                                        <label for="taille-43">43"</label>
                                    </li>
                                    <li data-value="55">
                                        <input type="checkbox" id="taille-55"/>
                                        <label for="taille-55">55"</label>
                                    </li>
                                    <li data-value="65">
                                        <input type="checkbox" id="taille-65"/>
                                        <label for="taille-65">65"</label>
                                    </li>
                                    <li data-value="75">
                                        <input type="checkbox" id="taille-75"/>
                                        <label for="taille-75">75"</label>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="tsp-filter-group">
                            <label>Resolution</label>
                            <div class="tsp-custom-select" data-filter="resolution">
                                <div class="tsp-custom-selected">Toutes <i class="fa fa-chevron-down"/></div>
                                <ul class="tsp-custom-options">
                                    <li data-value="4k">
                                        <input type="checkbox" id="resolution-4k"/>
                                        <label for="resolution-4k">4K</label>
                                    </li>
                                    <li data-value="8k">
                                        <input type="checkbox" id="resolution-8k"/>
                                        <label for="resolution-8k">8K</label>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>

                    <t t-if="category == 'Accessoires'">
                        <div class="tsp-filter-group">
                            <label>Compatibilité</label>
                            <div class="tsp-custom-select" data-filter="compatibilite">
                                <div class="tsp-custom-selected">Toutes <i class="fa fa-chevron-down"/></div>
                                <ul class="tsp-custom-options">
                                    <li data-value="iphone">
                                        <input type="checkbox" id="compat-iphone"/>
                                        <label for="compat-iphone">iPhone</label>
                                    </li>
                                    <li data-value="samsung">
                                        <input type="checkbox" id="compat-samsung"/>
                                        <label for="compat-samsung">Samsung</label>
                                    </li>
                                    <li data-value="universel">
                                        <input type="checkbox" id="compat-universel"/>
                                        <label for="compat-universel">Universel</label>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>

                    <button class="tsp-filter-btn">
                        <i class="fa fa-filter"/> Filtrer
                    </button>
                </div>



                <div class="tsp-products-grid">
                    <t t-foreach="products" t-as="product">
                        <a t-attf-href="/shop/product/#{product['id'] if isinstance(product, dict) else product.id}" class="tsp-card-link">
                            <div class="tsp-card">
                                <div class="tsp-card-img-wrap">
                                    <t t-if="product['badge'] if isinstance(product, dict) else product.badge">
                                        <span class="tsp-badge-new">
                                            <t t-out="product['badge'] if isinstance(product, dict) else product.badge"/>
                                        </span>
                                    </t>
                                    <img
                                        t-att-src="product['image_url'] if isinstance(product, dict) else '/web/image/planet.product/' + str(product.id) + '/image'"
                                        t-att-alt="product['name'] if isinstance(product, dict) else product.name"
                                        class="tsp-card-img"
                                        onerror="this.parentElement.classList.add('tsp-img-placeholder')"
                                    />
                                    <button class="tsp-wishlist-btn">
                                        <i class="fa fa-heart-o"/>
                                    </button>
                                </div>
                                <div class="tsp-card-body">
                                    <div class="tsp-stars">
                                        <t t-set="prod_rating" t-value="int(product['rating'] if isinstance(product, dict) else product.rating)"/>
                                        <t t-foreach="range(5)" t-as="star_i">
                                            <i t-if="star_i &lt; prod_rating" class="fa fa-star tsp-star-on"/>
                                            <i t-else="" class="fa fa-star tsp-star-off"/>
                                        </t>
                                        <span class="tsp-stars-count">(<t t-out="prod_rating"/>)</span>
                                    </div>
                                    <h3 class="tsp-card-name"><t t-out="product['name'] if isinstance(product, dict) else product.name"/></h3>
                                    <p class="tsp-card-desc"><t t-out="product['description'] if isinstance(product, dict) else product.description"/></p>
                                    <div class="tsp-card-footer">
                                        <span class="tsp-price"><t t-out="product['price'] if isinstance(product, dict) else product.price"/>
                                            €
                                        </span>
                                        <button class="tsp-btn tsp-btn-add" onclick="event.stopPropagation();">
                                            <i class="fa fa-shopping-cart"/> Ajouter
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </t>
                </div>
            </section>

        </t>
    </template>

</odoo>
