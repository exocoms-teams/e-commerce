<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="header_mobile_links" name="Planet Mobil - Header Mobile Links"
            inherit_id="website.template_header_mobile">

            <xpath expr="//t[@t-call='website.navbar_nav']" position="after">
                <li class="nav-item border-top px-0">
                    <a href="/shop?x_is_promotion=1" class="nav-link p-3 text-wrap">
                        <i class="fa fa-star-o me-2" /> Promotions </a>
                </li>
                <li class="nav-item border-top px-0">
                    <a href="/shop?order=publish_date+desc" class="nav-link p-3 text-wrap">
                        <i class="fa fa-star-o me-2" /> Nouveautés </a>
                </li>
                <li class="nav-item border-top px-0 dropdown">
                    <a href="/shop"
                        class="nav-link p-3 text-wrap d-flex justify-content-between align-items-center"
                        data-bs-toggle="collapse" data-bs-target="#mobile_categories">
                        <span><i class="fa fa-th-large me-2" /> Tous les produits</span>
                        <i class="fa fa-chevron-down" />
                    </a>
                    <div id="mobile_categories" class="collapse ps-3">
                        <t t-set="categories"
                            t-value="request.env['product.public.category'].sudo().search([('parent_id', '=', False)])" />
                        <t t-foreach="categories" t-as="cat">
                            <a t-att-href="'/shop/category/' + slug(cat)"
                                class="nav-link p-2 text-wrap">
                                <i class="fa fa-tag me-2" />
                                <t t-out="cat.name" />
                            </a>
                        </t>
                    </div>
                </li>
                <li class="nav-item border-top px-0">
                    <a href="/avis" class="nav-link p-3 text-wrap">
                        <i class="fa fa-star-o me-2" /> Avis </a>
                </li>
                <li class="nav-item border-top border-bottom px-0">
                    <a href="/contact" class="nav-link p-3 text-wrap">
                        <i class="fa fa-phone me-2" /> Contact </a>
                </li>
            </xpath>

        </template>
    </data>
</odoo>