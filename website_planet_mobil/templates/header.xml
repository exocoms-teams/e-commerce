<?xml version="1.0" encoding="utf-8"?>
<odoo>

    
    <template id="top_bar" inherit_id="website.layout"
        name="Planet Mobil Top Bar">
        <xpath expr="//header" position="before">
            <div id="top-bar">
                <div class="container">
                    <span>
                        <i class="bi bi-telephone-fill"></i>
                        +33 (0)6 64 97 80 50
                        |
                        <i class="bi bi-envelope-fill"></i>
                        contact@planet-mobil.com
                        |
                        <i class="bi bi-clock-fill"></i>
                        Lun-Ven : 9h - 18h
                    </span>
                </div>
            </div>
        </xpath>
    </template>

    <!-- SIDEBAR -->
    <template id="sidebar" inherit_id="website.layout"
        name="Planet Mobil Sidebar">
        <xpath expr="//div[@id='wrapwrap']" position="before">
            <nav id="sidebar">
                <ul class="sidebar-nav">
                    <li class="sidebar-item">
                        <a href="/" class="sidebar-link">
                            <i class="bi bi-house-fill sidebar-icon"></i>
                            <span>Accueil</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="/shop/category/apple-iphone-106"
                            class="sidebar-link">
                            <i class="bi bi-phone sidebar-icon"></i>
                            <span>Smartphones</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="/shop/category/apple-apple-watch-105"
                            class="sidebar-link">
                            <i class="bi bi-smartwatch sidebar-icon"></i>
                            <span>Apple Watch</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="/shop?search=airpods"
                            class="sidebar-link">
                            <i class="bi bi-headphones sidebar-icon"></i>
                            <span>AirPods</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="/shop?search=coque"
                            class="sidebar-link">
                            <i class="bi bi-shield sidebar-icon"></i>
                            <span>Coques et Protection</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="/shop?search=chargeur"
                            class="sidebar-link">
                            <i class="bi bi-plug sidebar-icon"></i>
                            <span>Chargeurs et Cables</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="/shop?search=accessoires"
                            class="sidebar-link">
                            <i class="bi bi-bag sidebar-icon"></i>
                            <span>Accessoires</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="/contactus" class="sidebar-link">
                            <i class="bi bi-telephone sidebar-icon"></i>
                            <span>Contact</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </xpath>
    </template>

</odoo>