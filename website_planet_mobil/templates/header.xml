<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="header_mobile_links" name="Planet Mobil - Header Mobile Links"
            inherit_id="website.template_header_mobile">

            <xpath expr="//t[@t-call='website.placeholder_header_text_element']" position="after">
                <li class="border-top">
                    <ul class="navbar-nav">
                        <li class="nav-item border-top px-0">
                            <a href="/shop?x_is_promotion=1" class="nav-link p-3 text-wrap">Promotions</a>
                        </li>
                        <li class="nav-item border-top px-0">
                            <a href="/shop?order=publish_date+desc" class="nav-link p-3 text-wrap">Nouveautés</a>
                        </li>
                        <li class="nav-item border-top px-0">
                            <a href="/avis" class="nav-link p-3 text-wrap">Avis</a>
                        </li>
                        <li class="nav-item border-top border-bottom px-0">
                            <a href="/contact" class="nav-link p-3 text-wrap">Contact</a>
                        </li>
                    </ul>
                </li>
            </xpath>

        </template>
    </data>
</odoo>
