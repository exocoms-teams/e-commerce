<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--HEADER-->
        <template id="header_default_replace" name="Planet Mobil - Header Default"
            inherit_id="website.template_header_default">
            <xpath expr="//t[@t-call='website.navbar']" position="replace">
                <t t-call="website.navbar">
                    <t t-set="_navbar_classes" t-valuef="d-none d-lg-block shadow-sm" />
                    <div id="o_main_nav"
                        t-attf-class="o_main_nav #{header_content_width} tsp-header-bar">

                        <!-- Gauche : Logo -->
                        <t t-call="website.placeholder_header_brand" _link_class.f="tsp-header-logo" />

                        <!-- Centre : Barre de recherche -->
                        <ul class="navbar-nav tsp-header-search-wrap">
                            <t t-call="website.placeholder_header_search_box"
                                _layout.f=""
                                _item_class.f="tsp-header-search-item"
                                _input_classes.f="tsp-search-input"
                                _submit_classes.f="tsp-search-btn" />
                        </ul>

                        <!-- Droite : Compte + Favoris + Panier -->
                        <ul class="navbar-nav align-items-center gap-2 flex-shrink-0 justify-content-end tsp-header-actions">

                            <!-- Connexion / Mon compte -->
                            <li class="nav-item">
                                <t t-if="not request.env.user._is_public()">
                                    <a href="/my/account" class="pm-topbtn pm-topbtn-account" title="Mon compte">
                                        <i class="fa fa-user-circle-o fa-lg"/>
                                        <span class="pm-topbtn-label">Mon compte</span>
                                    </a>
                                </t>
                                <t t-else="">
                                    <a href="/web/login" class="pm-topbtn pm-topbtn-login" title="Connexion">
                                        <i class="fa fa-sign-in fa-lg"/>
                                        <span class="pm-topbtn-label">Connexion</span>
                                    </a>
                                </t>
                            </li>

                            <!-- Favoris (Wishlist) -->
                            <li class="nav-item">
                                <a href="/wishlist" class="pm-topicon" title="Mes favoris">
                                    <i class="fa fa-heart-o fa-lg"/>
                                </a>
                            </li>

                            <!-- Panier -->
                            <li class="nav-item">
                                <a href="/shop/cart" class="pm-topicon pm-topicon-cart" title="Mon panier">
                                    <i class="fa fa-shopping-cart fa-lg"/>
                                    <span class="pm-cart-badge o_cart_quantity" style="display:none;">0</span>
                                </a>
                            </li>

                        </ul>
                    </div>
                </t>
            </xpath>
        </template>

        <!--MENU
        MOBILE-->
        <template id="header_mobile_links" name="Planet Mobil - Header Mobile Links"
            inherit_id="website.template_header_mobile">

            <xpath expr="//t[@t-call='website.placeholder_header_text_element']" position="replace">
                <li class="nav-item border-top px-0 tsp-mobile-nav-item">
                    <a href="/" class="nav-link p-3 text-wrap">
                        <i class="fa fa-home me-2" /> Accueil </a>
                </li>
                <li class="nav-item border-top px-0 tsp-mobile-nav-item">
                    <a href="/shop?x_is_promotion=1" class="nav-link p-3 text-wrap">
                        <i class="fa fa-star-o me-2" /> Promotions </a>
                </li>
                <li class="nav-item border-top px-0 tsp-mobile-nav-item">
                    <a href="/shop?order=publish_date+desc" class="nav-link p-3 text-wrap">
                        <i class="fa fa-star-o me-2" /> Nouveautés </a>
                </li>
                <li class="nav-item border-top px-0 tsp-mobile-nav-item dropdown">
                    <a href="/shop"
                        class="nav-link p-3 text-wrap d-flex justify-content-between align-items-center"
                        data-bs-toggle="collapse" data-bs-target="#mobile_categories">
                        <span><i class="fa fa-th-large me-2" /> Tous les produits</span>
                        <i class="fa fa-chevron-down" />
                    </a>
                    <div id="mobile_categories" class="collapse ps-3">
                        <t t-set="_native_cat_ids"
                            t-value="request.env['ir.model.data'].sudo().search([('model', '=', 'product.public.category'), ('module', '!=', 'website_planet_mobil')]).mapped('res_id')" />
                        <t t-set="categories"
                            t-value="request.env['product.public.category'].sudo().search([('parent_id', '=', False), ('id', 'not in', _native_cat_ids)])" />
                        <t t-foreach="categories" t-as="cat">
                            <a t-att-href="'/shop/category/' + slug(cat)"
                                class="nav-link p-2 text-wrap">
                                <i class="fa fa-tag me-2" />
                                <t t-out="cat.name" />
                            </a>
                        </t>
                    </div>
                </li>
                <li class="nav-item border-top px-0 tsp-mobile-nav-item">
                    <a href="/avis" class="nav-link p-3 text-wrap">
                        <i class="fa fa-star-o me-2" /> Avis </a>
                </li>
            </xpath>
        </template>

        <template id="header_cta_contact" name="Planet Mobil - Contact Us Link"
            inherit_id="website.header_call_to_action">
            <xpath expr="//a[hasclass('btn_cta')]" position="attributes">
                <attribute name="href">/contact</attribute>
            </xpath>
        </template>

    </data>
</odoo>