<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layout" inherit_id="website.layout"
        name="Planet Mobil Layout">
        <xpath expr="//header" position="replace">

            
            <div id="top-bar">
                <div class="container">
                    <span>
                        📞 +33 (0)6 64 97 80 50
                        &#160;|&#160;;
                        📧 contact@planet-mobil.com
                        &#160;;|&#160;;
                        🕐 Lun-Ven : 9h - 18h
                    </span>
                </div>
            </div>

            <
            <header id="main-header">
                <div class="container">
                    <div class="header-inner">

                        
                        <a href="/" class="header-logo">
                            <span class="logo-icon">🌍</span>
                            <span class="logo-text">Planet-Mobil</span>
                        </a>

                        
                        <div class="header-search">
                            <form action="/shop" method="get">
                                <input
                                    type="text"
                                    name="search"
                                    placeholder="Rechercher un produit..."
                                    class="search-input"/>
                                <button type="submit" class="search-btn">
                                    🔍
                                </button>
                            </form>
                        </div>

                        
                        <div class="header-icons">
                            <a href="/web/login"
                                class="header-icon"
                                title="Mon compte">
                                <span>👤</span>
                            </a>
                            <a href="/shop/wishlist"
                                class="header-icon"
                                title="Favoris">
                                <span>❤️</span>
                            </a>
                            <a href="/shop/cart"
                                class="header-icon cart-icon"
                                title="Panier">
                                <span>🛒</span>
                                <span class="cart-count">0</span>
                            </a>
                        </div>

                    </div>
                </div>
            </header>

            
            <div id="page-wrapper">

                
                <nav id="sidebar">
                    <ul class="sidebar-nav">
                        <li class="sidebar-item">
                            <a href="/" class="sidebar-link">
                                <span class="sidebar-icon">🏠</span>
                                <span>Accueil</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a href="/shop/category/apple-iphone-106"
                                class="sidebar-link">
                                <span class="sidebar-icon">📱</span>
                                <span>Smartphones</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a href="/shop/category/apple-apple-watch-105"
                                class="sidebar-link">
                                <span class="sidebar-icon">⌚</span>
                                <span>Apple Watch</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a href="/shop?search=airpods"
                                class="sidebar-link">
                                <span class="sidebar-icon">🎧</span>
                                <span>AirPods</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a href="/shop?search=coque"
                                class="sidebar-link">
                                <span class="sidebar-icon">🛡️</span>
                                <span>Coques &amp; Protection</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a href="/shop?search=chargeur"
                                class="sidebar-link">
                                <span class="sidebar-icon">🔌</span>
                                <span>Chargeurs &amp; Câbles</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a href="/shop?search=accessoires"
                                class="sidebar-link">
                                <span class="sidebar-icon">🎒</span>
                                <span>Accessoires</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a href="/contactus" class="sidebar-link">
                                <span class="sidebar-icon">📞</span>
                                <span>Contact</span>
                            </a>
                        </li>
                    </ul>
                </nav>

                
                <div id="main-content">
                    <t t-out="0"/>
                </div>

            </div>

        </xpath>
    </template>
</odoo>