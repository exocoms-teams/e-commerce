<template id="header_styles" name="Planet Mobil - Header Styles" inherit_id="website.assets_frontend">
<xpath expr="." position="inside">
<style> @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap'); #wrapwrap > header, .o_header_standard { background: #fff !important; border-bottom: 1px solid #f1f5f9 !important; box-shadow: none !important; font-family: 'Inter', sans-serif !important; transition: box-shadow 0.3s ease, background 0.3s ease !important; } #wrapwrap > header.o_header_scrolled, .o_header_standard.o_header_scrolled { box-shadow: 0 4px 24px rgba(0,0,0,0.08) !important; backdrop-filter: blur(12px) !important; background: rgba(255,255,255,0.95) !important; } .tsp-header-bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 0 40px; height: 68px; max-width: 1400px; margin: 0 auto; width: 100%; } a.tsp-header-logo, .tsp-header-logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none !important; flex-shrink: 0; font-family: 'Inter', sans-serif !important; } a.tsp-header-logo img { height: 36px; width: auto; } a.tsp-header-logo .navbar-brand-name, a.tsp-header-logo span:not([class]) { font-size: 1.15rem; font-weight: 900; color: #0f172a; letter-spacing: -0.02em; } .tsp-header-search-wrap { flex: 1; max-width: 520px; margin: 0 auto; list-style: none; padding: 0; } .tsp-header-search-item, .tsp-header-search-wrap .nav-item { width: 100%; } .tsp-header-search-wrap form, .tsp-header-search-wrap .input-group { width: 100%; display: flex; gap: 0; border-radius: 50px; overflow: hidden; border: 1.5px solid #e2e8f0; background: #f8fafc; transition: border-color 0.2s, box-shadow 0.2s; } .tsp-header-search-wrap form:focus-within, .tsp-header-search-wrap .input-group:focus-within { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.1); background: #fff; } input.tsp-search-input, .tsp-header-search-wrap input[type="search"], .tsp-header-search-wrap .form-control { flex: 1; background: transparent !important; border: none !important; outline: none !important; box-shadow: none !important; font-size: 0.875rem; font-family: 'Inter', sans-serif; color: #0f172a; padding: 0 18px !important; height: 42px; } input.tsp-search-input::placeholder, .tsp-header-search-wrap input::placeholder { color: #94a3b8; font-size: 0.875rem; } button.tsp-search-btn, .tsp-header-search-wrap button[type="submit"], .tsp-header-search-wrap .btn { background: linear-gradient(135deg, #2563eb, #7c3aed) !important; border: none !important; color: #fff !important; padding: 0 20px !important; height: 42px; border-radius: 0 !important; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; transition: opacity 0.2s; flex-shrink: 0; } button.tsp-search-btn:hover, .tsp-header-search-wrap button[type="submit"]:hover { opacity: 0.88; } .tsp-header-actions { display: flex; align-items: center; gap: 4px; flex-shrink: 0; list-style: none; padding: 0; margin: 0; } .tsp-header-actions .nav-link, .tsp-header-actions a.nav-link { font-size: 0.875rem; font-weight: 600; color: #374151 !important; padding: 8px 12px !important; border-radius: 10px; transition: background 0.2s, color 0.2s; white-space: nowrap; font-family: 'Inter', sans-serif; display: flex; align-items: center; gap: 6px; } .tsp-header-actions .nav-link:hover, .tsp-header-actions a.nav-link:hover { background: #f1f5f9; color: #0f172a !important; } .tsp-header-actions .o_nav_link_btn, .tsp-header-actions a.o_nav_link_btn { background: linear-gradient(135deg, #2563eb, #7c3aed) !important; color: #fff !important; border: none !important; font-weight: 700 !important; padding: 9px 18px !important; border-radius: 50px !important; font-size: 0.875rem; transition: transform 0.2s, box-shadow 0.2s !important; box-shadow: 0 4px 14px rgba(37,99,235,0.3) !important; } .tsp-header-actions .o_nav_link_btn:hover, .tsp-header-actions a.o_nav_link_btn:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(37,99,235,0.4) !important; color: #fff !important; background: linear-gradient(135deg, #1d4ed8, #6d28d9) !important; } .tsp-header-actions .badge, .tsp-header-actions .position-absolute { background: linear-gradient(135deg, #ef4444, #dc2626) !important; color: #fff !important; font-size: 0.62rem !important; font-weight: 700 !important; min-width: 18px; height: 18px; border-radius: 99px; display: flex !important; align-items: center; justify-content: center; padding: 0 4px !important; border: 2px solid #fff; box-shadow: 0 2px 6px rgba(239,68,68,0.4); } .tsp-header-actions .nav-item .fa { font-size: 1.15rem; color: #374151; transition: color 0.2s; } .tsp-header-actions .nav-item:hover .fa { color: #2563eb; } .tsp-header-actions .dropdown-menu { border: 1px solid #e2e8f0 !important; border-radius: 14px !important; box-shadow: 0 16px 48px rgba(0,0,0,0.1) !important; padding: 8px !important; font-family: 'Inter', sans-serif; margin-top: 8px !important; } .tsp-header-actions .dropdown-item { border-radius: 8px !important; font-size: 0.875rem !important; font-weight: 500 !important; color: #374151 !important; padding: 8px 14px !important; transition: background 0.15s !important; } .tsp-header-actions .dropdown-item:hover { background: #f1f5f9 !important; color: #0f172a !important; } #top_menu_collapse, .navbar-collapse { background: #fff !important; font-family: 'Inter', sans-serif !important; } #top_menu_collapse::before, .navbar-collapse::before { content: 'PLANET MOBIL'; display: block; background: linear-gradient(135deg, #2563eb, #7c3aed); color: #fff; font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 900; letter-spacing: 0.04em; padding: 18px 20px; border-bottom: none; } .tsp-mobile-nav-item { margin: 2px 10px; border-radius: 12px; overflow: hidden; } .tsp-mobile-nav-item.border-top { border-top: none !important; } .tsp-mobile-nav-item > a.nav-link { font-family: 'Inter', sans-serif !important; font-size: 0.92rem !important; font-weight: 600 !important; color: #1e293b !important; padding: 13px 16px !important; display: flex !important; align-items: center !important; gap: 12px !important; border-radius: 12px !important; transition: background 0.18s, color 0.18s !important; text-decoration: none !important; } .tsp-mobile-nav-item > a.nav-link:hover { background: #f1f5f9 !important; color: #2563eb !important; } .tsp-mobile-nav-item > a.nav-link.active, .tsp-mobile-nav-item > a.nav-link[aria-current="page"] { background: linear-gradient(135deg, #2563eb, #7c3aed) !important; color: #fff !important; } .tsp-mobile-nav-item > a.nav-link .fa { width: 22px; text-align: center; font-size: 0.95rem; color: #94a3b8; flex-shrink: 0; transition: color 0.18s; } .tsp-mobile-nav-item > a.nav-link:hover .fa { color: #2563eb; } .tsp-mobile-nav-item > a.nav-link.active .fa, .tsp-mobile-nav-item > a.nav-link[aria-current="page"] .fa { color: rgba(255,255,255,0.85) !important; } .tsp-mobile-nav-item > a.nav-link .fa-chevron-down { margin-left: auto; font-size: 0.7rem; color: #cbd5e1; width: auto; } #mobile_categories { background: #f8fafc; border-radius: 10px; margin: 0 10px 8px; padding: 6px !important; border: 1px solid #e2e8f0; } #mobile_categories .nav-link { font-size: 0.875rem !important; font-weight: 500 !important; color: #475569 !important; padding: 9px 14px !important; border-radius: 8px !important; transition: background 0.15s !important; font-family: 'Inter', sans-serif !important; display: flex !important; align-items: center !important; gap: 8px !important; } #mobile_categories .nav-link:hover { background: #e2e8f0 !important; color: #0f172a !important; } #mobile_categories .fa-tag { color: #2563eb; font-size: 0.8rem; } @media (max-width: 1024px) { .tsp-header-bar { padding: 0 24px; } .tsp-header-search-wrap { max-width: 360px; } } @media (max-width: 768px) { .tsp-header-bar { padding: 0 16px; height: 60px; } .tsp-header-search-wrap { display: none; } } </style>
</xpath>
</template>
<template id="header_announcement" name="Planet Mobil - Barre d'annonce" inherit_id="website.layout">
<xpath expr="//header" position="before">
<style> .pm-topbar { background: linear-gradient(90deg, #0f172a, #1e3a8a 50%, #0f172a); font-family: 'Inter', sans-serif; font-size: 0.78rem; font-weight: 600; color: rgba(255,255,255,0.85); padding: 8px 40px; text-align: center; display: flex; align-items: center; justify-content: center; gap: 32px; position: relative; overflow: hidden; } .pm-topbar::before { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(37,99,235,0.12), transparent); animation: pmTopbarShine 4s ease infinite; } @keyframes pmTopbarShine { 0%,100% { opacity: 0; transform: translateX(-100%); } 50% { opacity: 1; transform: translateX(100%); } } .pm-topbar-item { display: flex; align-items: center; gap: 7px; position: relative; z-index: 1; } .pm-topbar-item i { color: #63b3ed; font-size: 0.8rem; } .pm-topbar-sep { width: 1px; height: 12px; background: rgba(255,255,255,0.15); } .pm-topbar-highlight { color: #fbbf24; font-weight: 700; } .pm-topbar-close { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); background: none; border: none; color: rgba(255,255,255,0.4); cursor: pointer; font-size: 0.85rem; padding: 4px 8px; border-radius: 4px; transition: color 0.2s; } .pm-topbar-close:hover { color: rgba(255,255,255,0.8); } @media (max-width: 768px) { .pm-topbar { gap: 16px; padding: 8px 40px 8px 16px; font-size: 0.72rem; } .pm-topbar-sep { display: none; } .pm-topbar-item:not(:first-child) { display: none; } } </style>
<div class="pm-topbar" id="pm-topbar">
<div class="pm-topbar-item">
<i class="fa fa-rocket"/>
Livraison offerte dès
<span class="pm-topbar-highlight">50€</span>
</div>
<div class="pm-topbar-sep"/>
<div class="pm-topbar-item">
<i class="fa fa-undo"/>
Retours gratuits sous
<span class="pm-topbar-highlight">30 jours</span>
</div>
<div class="pm-topbar-sep"/>
<div class="pm-topbar-item">
<i class="fa fa-shield"/>
Paiement
<span class="pm-topbar-highlight">100% sécurisé</span>
</div>
<button class="pm-topbar-close" id="pm-topbar-close" aria-label="Fermer">
<i class="fa fa-times"/>
</button>
</div>
<script> (function () { var btn = document.getElementById('pm-topbar-close'); var bar = document.getElementById('pm-topbar'); if (btn && bar) { btn.addEventListener('click', function () { bar.style.transition = 'max-height 0.3s ease, opacity 0.3s ease, padding 0.3s ease'; bar.style.maxHeight = '0'; bar.style.opacity = '0'; bar.style.paddingTop = '0'; bar.style.paddingBottom = '0'; setTimeout(function () { bar.style.display = 'none'; }, 320); }); } })(); </script>
</xpath>
</template>
<template id="header_default_replace" name="Planet Mobil - Header Default" inherit_id="website.template_header_default">
<xpath expr="//t[@t-call='website.navbar']" position="replace">
<t t-call="website.navbar">
<t t-set="_navbar_classes" t-valuef="d-none d-lg-block shadow-sm"/>
<div id="o_main_nav" t-attf-class="o_main_nav #{header_content_width} tsp-header-bar">
<t t-call="website.placeholder_header_brand" _link_class.f="tsp-header-logo"/>
<ul class="navbar-nav tsp-header-search-wrap">
<t t-call="website.placeholder_header_search_box" _layout.f="" _item_class.f="tsp-header-search-item" _input_classes.f="tsp-search-input" _submit_classes.f="tsp-search-btn"/>
</ul>
<ul class="navbar-nav align-items-center gap-2 flex-shrink-0 justify-content-end tsp-header-actions">
<t t-call="portal.placeholder_user_sign_in" _link_class.f="o_nav_link_btn nav-link border px-3"/>
<t t-call="portal.user_dropdown" _user_name="True" _item_class.f="dropdown" _link_class.f="nav-link border-0" _dropdown_menu_class.f="dropdown-menu-end"/>
<t t-call="website_sale_wishlist.header_wishlist_link" _item_class.f="nav-item" _link_class.f="nav-link" _icon.f="true" _icon_wrap_class.f="position-relative d-inline-block" _badge_class.f="position-absolute top-0 start-100 translate-middle"/>
<t t-call="website_sale.header_cart_link" _item_class.f="nav-item" _link_class.f="nav-link" _icon.f="true" _icon_wrap_class.f="position-relative d-inline-block" _badge_class.f="position-absolute top-0 start-100 translate-middle"/>
</ul>
</div>
</t>
</xpath>
</template>
<template id="header_mobile_links" name="Planet Mobil - Header Mobile Links" inherit_id="website.template_header_mobile">
<xpath expr="//t[@t-call='website.placeholder_header_text_element']" position="replace">
<li class="nav-item border-top px-0 tsp-mobile-nav-item">
<a href="/" class="nav-link p-3 text-wrap">
<i class="fa fa-home me-2"/>
Accueil
</a>
</li>
<li class="nav-item border-top px-0 tsp-mobile-nav-item">
<a href="/shop?x_is_promotion=1" class="nav-link p-3 text-wrap">
<i class="fa fa-tag me-2"/>
Promotions
</a>
</li>
<li class="nav-item border-top px-0 tsp-mobile-nav-item">
<a href="/shop?order=publish_date+desc" class="nav-link p-3 text-wrap">
<i class="fa fa-star me-2"/>
Nouveautés
</a>
</li>
<li class="nav-item border-top px-0 tsp-mobile-nav-item dropdown">
<a href="/shop" class="nav-link p-3 text-wrap d-flex justify-content-between align-items-center" data-bs-toggle="collapse" data-bs-target="#mobile_categories">
<span>
<i class="fa fa-th-large me-2"/>
Tous les produits
</span>
<i class="fa fa-chevron-down"/>
</a>
<div id="mobile_categories" class="collapse ps-3">
<t t-set="categories" t-value="request.env['product.public.category'].sudo().search([('parent_id', '=', False)])"/>
<t t-foreach="categories" t-as="cat">
<a t-att-href="'/shop/category/' + slug(cat)" class="nav-link p-2 text-wrap">
<i class="fa fa-tag me-2"/>
<t t-out="cat.name"/>
</a>
</t>
</div>
</li>
<li class="nav-item border-top px-0 tsp-mobile-nav-item">
<a href="/avis" class="nav-link p-3 text-wrap">
<i class="fa fa-star-o me-2"/>
Avis
</a>
</li>
</xpath>
</template>
<template id="header_cta_contact" name="Planet Mobil - Contact Us Link" inherit_id="website.header_call_to_action">
<xpath expr="//a[hasclass('btn_cta')]" position="attributes">
<attribute name="href">/contact</attribute>
</xpath>
</template>
</data>
</odoo>