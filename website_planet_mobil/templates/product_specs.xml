<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="product_specs_inherit" inherit_id="website_sale.product" name="Planet Mobil - Caractéristiques produit">

        <!-- 1. Boutons Imprimer/Partager dans la colonne droite, après le bouton Ajouter au panier -->
        <xpath expr="//div[@id='add_to_cart']" position="after">
            <div class="pm-specs-actions" style="display:flex; gap:10px; margin-top:16px; justify-content:flex-end;">
                <button class="pm-specs-btn pm-btn-print" onclick="window.print()"
                    style="display:inline-flex; align-items:center; gap:8px; font-size:0.85rem; font-weight:600; padding:9px 18px; border-radius:50px; background:#f1f5f9; color:#475569; border:1px solid #e2e8f0; cursor:pointer;">
                    <i class="fa fa-print"/> Imprimer
                </button>
                <button class="pm-specs-btn pm-btn-share" id="pm-share-btn"
                    style="display:inline-flex; align-items:center; gap:8px; font-size:0.85rem; font-weight:600; padding:9px 18px; border-radius:50px; background:#2563eb; color:#fff; border:none; cursor:pointer;">
                    <i class="fa fa-share-alt"/> Partager
                </button>
            </div>
        </xpath>

        <!-- 2. Tableau des caractéristiques en bas de page -->
        <xpath expr="//div[@id='product_detail_main']" position="after">

            <div class="container" id="pm-specs-block" style="margin:48px auto; padding:0 24px;">

                <style>
                    .pm-specs-title { font-size:1.2rem; font-weight:700; color:#0f172a; margin:0 0 16px 0; }
                    .pm-specs-table { width:100%; border-collapse:collapse; border:1px solid #e2e8f0; border-radius:12px; overflow:hidden; }
                    .pm-specs-table tr:nth-child(even) { background:#f8fafc; }
                    .pm-specs-table td { padding:12px 18px; font-size:0.875rem; border-bottom:1px solid #f1f5f9; }
                    .pm-specs-label { font-weight:600; color:#64748b; width:40%; }
                    .pm-specs-value { color:#0f172a; }
                    .pm-toast { position:fixed; bottom:32px; left:50%; transform:translateX(-50%) translateY(20px); background:#0f172a; color:#fff; font-size:0.85rem; font-weight:600; padding:12px 24px; border-radius:50px; opacity:0; transition:all 0.3s; z-index:9999; pointer-events:none; }
                    .pm-toast.show { opacity:1; transform:translateX(-50%) translateY(0); }
                    @media print {
                        body * { visibility:hidden; }
                        #pm-specs-block, #pm-specs-block * { visibility:visible; }
                        #pm-specs-block { position:absolute; top:0; left:0; width:100%; padding:40px; }
                        .pm-specs-actions { display:none !important; }
                        .pm-print-header { display:block !important; text-align:center; margin-bottom:24px; border-bottom:2px solid #e2e8f0; padding-bottom:16px; }
                    }
                </style>

                <div class="pm-print-header" style="display:none;">
                    <div style="font-size:1.4rem; font-weight:900;">PLANET MOBIL</div>
                    <div style="color:#64748b; margin-top:4px;"><t t-out="product.name"/></div>
                </div>

                <h2 class="pm-specs-title">Caractéristiques</h2>

                <t t-if="product.attribute_line_ids">
                    <table class="pm-specs-table">
                        <t t-foreach="product.attribute_line_ids" t-as="line">
                            <tr>
                                <td class="pm-specs-label"><t t-out="line.attribute_id.name"/></td>
                                <td class="pm-specs-value"><t t-out="', '.join(line.value_ids.mapped('name'))"/></td>
                            </tr>
                        </t>
                    </table>
                </t>
                <t t-else="">
                    <p style="color:#94a3b8; font-style:italic;">Caractéristiques non renseignées.</p>
                </t>

            </div>

            <div class="pm-toast" id="pm-toast-specs"></div>

            <script>
            (function () {
                function showToast(msg) {
                    var t = document.getElementById('pm-toast-specs');
                    if (!t) return;
                    t.textContent = msg;
                    t.classList.add('show');
                    setTimeout(function () { t.classList.remove('show'); }, 2800);
                }
                var btn = document.getElementById('pm-share-btn');
                if (!btn) return;
                btn.addEventListener('click', function () {
                    var url = window.location.href;
                    var name = document.querySelector('h1[itemprop="name"], .product_name h1, h1.o_shop_product_title');
                    var title = (name ? name.textContent.trim() : document.title) + ' — Planet Mobil';
                    if (navigator.share) {
                        navigator.share({ title: title, url: url }).catch(function(){});
                    } else {
                        navigator.clipboard.writeText(url).then(function () {
                            showToast('✓ Lien copié !');
                        }).catch(function () {
                            var inp = document.createElement('input');
                            document.body.appendChild(inp);
                            inp.value = url;
                            inp.select();
                            document.execCommand('copy');
                            document.body.removeChild(inp);
                            showToast('✓ Lien copié !');
                        });
                    }
                });
            })();
            </script>

        </xpath>
    </template>

</odoo>
