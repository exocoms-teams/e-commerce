<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="homepage" name="Planet Mobil - Accueil">
        <t t-call="website_planet_mobil.layout">

           
            <section class="tsp-hero">
                <div class="tsp-hero-content">
                    <h1 class="tsp-hero-title">Bienvenue chez PLANET MOBIL</h1>
                    <p class="tsp-hero-subtitle">Découvrez les dernières technologies au meilleur prix</p>
                    <a href="/shop" class="tsp-btn-hero">Découvrir nos produits ›</a>
                </div>
            </section>

            
            <section class="tsp-section">
                <div class="tsp-section-header">
                    <h2 class="tsp-section-title"><span class="tsp-section-icon">🔥</span> Top Ventes</h2>
                    <a href="/shop?filter=top-ventes" class="tsp-voir-tout">Voir tout ›</a>
                </div>
                <div class="tsp-products-grid">
                    <t t-foreach="top_ventes" t-as="product">
                        <div class="tsp-card">
                            <div class="tsp-card-img-wrap">
                                <img t-att-src="product['image_url'] if isinstance(product, dict) else '/web/image/planet.product/' + str(product.id) + '/image'"
                                     t-att-alt="product['name'] if isinstance(product, dict) else product.name"
                                     class="tsp-card-img"
                                     onerror="this.parentElement.classList.add('tsp-img-placeholder')"/>
                                <button class="tsp-wishlist-btn"><i class="fa fa-heart-o"/></button>
                            </div>
                            <div class="tsp-card-body">
                                <div class="tsp-stars">
                                    <t t-set="prod_rating" t-value="int(product['rating'] if isinstance(product, dict) else product.rating)"/>
                                    <t t-foreach="range(5)" t-as="star_i">
                                        <i t-if="star_i &lt; prod_rating" class="fa fa-star tsp-star-on"/>
                                        <i t-else="" class="fa fa-star tsp-star-off"/>
                                    </t>
                                    <span class="tsp-stars-count">(<t t-out="product['rating'] if isinstance(product, dict) else product.rating"/>)</span>
                                </div>
                                <h3 class="tsp-card-name"><t t-out="product['name'] if isinstance(product, dict) else product.name"/></h3>
                                <p class="tsp-card-desc"><t t-out="product['description'] if isinstance(product, dict) else product.description"/></p>
                                <div class="tsp-card-footer">
                                    <span class="tsp-price"><t t-out="product['price'] if isinstance(product, dict) else product.price"/>€</span>
                                    <button class="tsp-btn-add"><i class="fa fa-shopping-cart"/> Ajouter</button>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </section>

            
            <section class="tsp-section">
                <div class="tsp-section-header">
                    <h2 class="tsp-section-title"><span class="tsp-section-icon">✨</span> Nouveautés</h2>
                    <a href="/shop?filter=nouveautes" class="tsp-voir-tout">Voir tout ›</a>
                </div>
                <div class="tsp-products-grid">
                    <t t-foreach="nouveautes" t-as="product">
                        <div class="tsp-card">
                            <div class="tsp-card-img-wrap">
                                <t t-set="prod_badge" t-value="product['badge'] if isinstance(product, dict) else product.badge"/>
                                <t t-if="prod_badge">
                                    <span class="tsp-badge-new"><t t-out="prod_badge"/></span>
                                </t>
                                <img t-att-src="product['image_url'] if isinstance(product, dict) else '/web/image/planet.product/' + str(product.id) + '/image'"
                                     t-att-alt="product['name'] if isinstance(product, dict) else product.name"
                                     class="tsp-card-img"
                                     onerror="this.parentElement.classList.add('tsp-img-placeholder')"/>
                                <button class="tsp-wishlist-btn"><i class="fa fa-heart-o"/></button>
                            </div>
                            <div class="tsp-card-body">
                                <div class="tsp-stars">
                                    <t t-set="prod_rating" t-value="int(product['rating'] if isinstance(product, dict) else product.rating)"/>
                                    <t t-foreach="range(5)" t-as="star_i">
                                        <i t-if="star_i &lt; prod_rating" class="fa fa-star tsp-star-on"/>
                                        <i t-else="" class="fa fa-star tsp-star-off"/>
                                    </t>
                                    <span class="tsp-stars-count">(<t t-out="product['rating'] if isinstance(product, dict) else product.rating"/>)</span>
                                </div>
                                <h3 class="tsp-card-name"><t t-out="product['name'] if isinstance(product, dict) else product.name"/></h3>
                                <p class="tsp-card-desc"><t t-out="product['description'] if isinstance(product, dict) else product.description"/></p>
                                <div class="tsp-card-footer">
                                    <span class="tsp-price"><t t-out="product['price'] if isinstance(product, dict) else product.price"/>€</span>
                                    <button class="tsp-btn-add"><i class="fa fa-shopping-cart"/> Ajouter</button>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </section>

           *
            <section class="tsp-promo">
                <div class="tsp-promo-inner">
                    <h2 class="tsp-promo-title">Offres exceptionnelles</h2>
                    <p class="tsp-promo-subtitle">Jusqu'à -50% sur une sélection de produits</p>
                    <a href="/promotions" class="tsp-btn-promo">Profiter des promotions</a>
                </div>
            </section>

        </t>
    </template>

</odoo>
