<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="homepage" name="Planet Mobil - Accueil">
        <t t-call="website_planet_mobil.layout">
            <div id="wrap" class="oe_structure">

                <!-- HERO -->
                <div id="oe_structure_homepage_hero" class="oe_structure oe_empty"/>
                <section class="tsp-hero">
                    <div class="tsp-hero-content">
                        <h1 class="tsp-hero-title">Bienvenue chez PLANET MOBIL</h1>
                        <p class="tsp-hero-subtitle">Decouvrez les dernieres technologies au meilleur prix</p>
                        <a href="/catalogue" class="tsp-btn-hero">Decouvrir nos produits</a>
                    </div>
                </section>

                <!-- TOP VENTES -->
                <div id="oe_structure_homepage_top_vente" class="oe_structure oe_empty"/>
                <section class="tsp-section">
                    <div class="tsp-section-header">
                        <h2 class="tsp-section-title">Top Ventes</h2>
                        <a href="/catalogue?category=top-ventes" class="tsp-voir-tout">Voir tout</a>
                    </div>
                    <div class="tsp-products-grid">

                        <!-- Vrais produits Odoo -->
                        <t t-if="not use_fake">
                            <t t-foreach="top_ventes" t-as="product">
                                <a t-att-href="product.website_url" class="tsp-card-link">
                                    <div class="tsp-card">
                                        <div class="tsp-card-img-wrap">
                                            <img t-attf-src="/web/image/product.template/#{product.id}/image_512"
                                                 t-att-alt="product.name"
                                                 class="tsp-card-img"/>
                                            <button class="tsp-wishlist-btn"><i class="fa fa-heart-o"/></button>
                                        </div>
                                        <div class="tsp-card-body">
                                            <h3 class="tsp-card-name"><t t-out="product.name"/></h3>
                                            <p class="tsp-card-desc"><t t-out="product.description_sale"/></p>
                                            <div class="tsp-card-footer">
                                                <span class="tsp-price"><t t-out="product.list_price"/> €</span>
                                                <a t-att-href="product.website_url" class="tsp-btn tsp-btn-add">
                                                    <i class="fa fa-shopping-cart"/> Voir
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </t>
                        </t>

                        <!-- Fake produits (base vide) -->
                        <t t-if="use_fake">
                            <t t-foreach="top_ventes" t-as="product">
                                <a t-attf-href="/shop/product/{{ product['id'] }}" class="tsp-card-link">
                                    <div class="tsp-card">
                                        <div class="tsp-card-img-wrap">
                                            <img t-att-src="product['image_url']"
                                                 t-att-alt="product['name']"
                                                 class="tsp-card-img"/>
                                            <button class="tsp-wishlist-btn"><i class="fa fa-heart-o"/></button>
                                        </div>
                                        <div class="tsp-card-body">
                                            <div class="tsp-stars">
                                                <t t-set="prod_rating" t-value="int(product['rating'])"/>
                                                <t t-foreach="range(5)" t-as="star_i">
                                                    <i t-if="star_i &lt; prod_rating" class="fa fa-star tsp-star-on"/>
                                                    <i t-else="" class="fa fa-star tsp-star-off"/>
                                                </t>
                                            </div>
                                            <h3 class="tsp-card-name"><t t-out="product['name']"/></h3>
                                            <p class="tsp-card-desc"><t t-out="product['description']"/></p>
                                            <div class="tsp-card-footer">
                                                <span class="tsp-price"><t t-out="product['price']"/> €</span>
                                                <button class="tsp-btn tsp-btn-add">
                                                    <i class="fa fa-shopping-cart"/> Ajouter
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </t>
                        </t>

                    </div>
                </section>

                <!-- NOUVEAUTES -->
                <div id="oe_structure_homepage_nouveautes" class="oe_structure oe_empty"/>
                <section class="tsp-section">
                    <div class="tsp-section-header">
                        <h2 class="tsp-section-title">Nouveautes</h2>
                        <a href="/catalogue?category=Nouveautes" class="tsp-voir-tout">Voir tout</a>
                    </div>
                    <div class="tsp-products-grid">

                        <!-- Vrais produits Odoo -->
                        <t t-if="not use_fake">
                            <t t-foreach="nouveautes" t-as="product">
                                <a t-att-href="product.website_url" class="tsp-card-link">
                                    <div class="tsp-card">
                                        <div class="tsp-card-img-wrap">
                                            <img t-attf-src="/web/image/product.template/#{product.id}/image_512"
                                                 t-att-alt="product.name"
                                                 class="tsp-card-img"/>
                                            <button class="tsp-wishlist-btn"><i class="fa fa-heart-o"/></button>
                                        </div>
                                        <div class="tsp-card-body">
                                            <h3 class="tsp-card-name"><t t-out="product.name"/></h3>
                                            <p class="tsp-card-desc"><t t-out="product.description_sale"/></p>
                                            <div class="tsp-card-footer">
                                                <span class="tsp-price"><t t-out="product.list_price"/> €</span>
                                                <a t-att-href="product.website_url" class="tsp-btn tsp-btn-add">
                                                    <i class="fa fa-shopping-cart"/> Voir
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </t>
                        </t>

                        <!-- Fake produits (base vide) -->
                        <t t-if="use_fake">
                            <t t-foreach="nouveautes" t-as="product">
                                <a t-attf-href="/shop/product/{{ product['id'] }}" class="tsp-card-link">
                                    <div class="tsp-card">
                                        <div class="tsp-card-img-wrap">
                                            <t t-if="product['badge']">
                                                <span class="tsp-badge-new"><t t-out="product['badge']"/></span>
                                            </t>
                                            <img t-att-src="product['image_url']"
                                                 t-att-alt="product['name']"
                                                 class="tsp-card-img"/>
                                            <button class="tsp-wishlist-btn"><i class="fa fa-heart-o"/></button>
                                        </div>
                                        <div class="tsp-card-body">
                                            <div class="tsp-stars">
                                                <t t-set="prod_rating" t-value="int(product['rating'])"/>
                                                <t t-foreach="range(5)" t-as="star_i">
                                                    <i t-if="star_i &lt; prod_rating" class="fa fa-star tsp-star-on"/>
                                                    <i t-else="" class="fa fa-star tsp-star-off"/>
                                                </t>
                                            </div>
                                            <h3 class="tsp-card-name"><t t-out="product['name']"/></h3>
                                            <p class="tsp-card-desc"><t t-out="product['description']"/></p>
                                            <div class="tsp-card-footer">
                                                <span class="tsp-price"><t t-out="product['price']"/> €</span>
                                                <button class="tsp-btn tsp-btn-add">
                                                    <i class="fa fa-shopping-cart"/> Ajouter
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </t>
                        </t>

                    </div>
                </section>

                <!-- PROMO -->
                <div id="oe_structure_homepage_bottom" class="oe_structure oe_empty"/>
                <section class="tsp-promo">
                    <div class="tsp-promo-inner">
                        <h2 class="tsp-promo-title">Offres exceptionnelles</h2>
                        <p class="tsp-promo-subtitle">Jusqu'a -50% sur une selection de produits</p>
                        <a href="/catalogue?category=Promotions" class="tsp-btn-promo">Profiter des promotions</a>
                    </div>
                </section>

                <!-- AVIS (statique pour l'instant) -->
                <div id="oe_structure_homepage_avis" class="oe_structure oe_empty"/>
                <div class="avis-hero">
                    <h1>Avis de nos clients</h1>
                    <p>Ce que pensent nos clients de Planet Mobil</p>
                </div>
                <div class="avis-stats">
                    <div class="avis-stat-main">
                        <div class="note">4.6</div>
                        <div class="stars-big">
                            <i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/>
                            <i class="fa fa-star"/><i class="fa fa-star-half-o"/>
                        </div>
                        <p>Base sur 248 avis verifies</p>
                    </div>
                    <div class="avis-stat-bars">
                        <div class="avis-bar-row"><span>5 etoiles</span><div class="avis-bar-bg"><div class="avis-bar-fill" style="width:72%"/></div><span>72%</span></div>
                        <div class="avis-bar-row"><span>4 etoiles</span><div class="avis-bar-bg"><div class="avis-bar-fill" style="width:18%"/></div><span>18%</span></div>
                        <div class="avis-bar-row"><span>3 etoiles</span><div class="avis-bar-bg"><div class="avis-bar-fill" style="width:6%"/></div><span>6%</span></div>
                        <div class="avis-bar-row"><span>2 etoiles</span><div class="avis-bar-bg"><div class="avis-bar-fill" style="width:3%"/></div><span>3%</span></div>
                        <div class="avis-bar-row"><span>1 etoile</span><div class="avis-bar-bg"><div class="avis-bar-fill" style="width:1%"/></div><span>1%</span></div>
                    </div>
                </div>
                <div class="avis-grid">
                    <div class="avis-card">
                        <div class="avis-card-header"><div class="avis-avatar">ML</div><div class="avis-author-info"><h4>Marie L.</h4><span>12 janvier 2026</span></div></div>
                        <div class="avis-card-stars"><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/></div>
                        <p class="avis-card-title">Livraison ultra rapide !</p>
                        <p class="avis-card-text">Commande passee le soir, recue le lendemain matin. Produit exactement comme decrit.</p>
                        <div class="avis-card-product"><i class="fa fa-tag"/> iPhone 15 Pro Max</div>
                        <div class="avis-verified"><i class="fa fa-check-circle"/> Achat verifie</div>
                    </div>
                    <div class="avis-card">
                        <div class="avis-card-header"><div class="avis-avatar">TK</div><div class="avis-author-info"><h4>Thomas K.</h4><span>5 fevrier 2026</span></div></div>
                        <div class="avis-card-stars"><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/></div>
                        <p class="avis-card-title">Excellent rapport qualite/prix</p>
                        <p class="avis-card-text">La montre est magnifique, les fonctionnalites sont top. Tres bonne experience.</p>
                        <div class="avis-card-product"><i class="fa fa-tag"/> Apple Watch Series 9</div>
                        <div class="avis-verified"><i class="fa fa-check-circle"/> Achat verifie</div>
                    </div>
                    <div class="avis-card">
                        <div class="avis-card-header"><div class="avis-avatar">SB</div><div class="avis-author-info"><h4>Sophie B.</h4><span>18 fevrier 2026</span></div></div>
                        <div class="avis-card-stars"><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star-o" style="color:#d1d5db"/></div>
                        <p class="avis-card-title">Tres satisfaite de mon casque</p>
                        <p class="avis-card-text">La reduction de bruit est impressionnante, ideal pour travailler.</p>
                        <div class="avis-card-product"><i class="fa fa-tag"/> Sony WH-1000XM5</div>
                        <div class="avis-verified"><i class="fa fa-check-circle"/> Achat verifie</div>
                    </div>
                    <div class="avis-card">
                        <div class="avis-card-header"><div class="avis-avatar">AD</div><div class="avis-author-info"><h4>Alexandre D.</h4><span>2 mars 2026</span></div></div>
                        <div class="avis-card-stars"><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/></div>
                        <p class="avis-card-title">Le meilleur smartphone Android</p>
                        <p class="avis-card-text">Photos epoustouflantes, fluidite parfaite, autonomie excellente.</p>
                        <div class="avis-card-product"><i class="fa fa-tag"/> Samsung Galaxy S21 Ultra</div>
                        <div class="avis-verified"><i class="fa fa-check-circle"/> Achat verifie</div>
                    </div>
                    <div class="avis-card">
                        <div class="avis-card-header"><div class="avis-avatar">CM</div><div class="avis-author-info"><h4>Clara M.</h4><span>15 mars 2026</span></div></div>
                        <div class="avis-card-stars"><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/></div>
                        <p class="avis-card-title">TV incroyable pour le gaming</p>
                        <p class="avis-card-text">L'image OLED est a couper le souffle. Le mode gaming 120Hz fait la difference.</p>
                        <div class="avis-card-product"><i class="fa fa-tag"/> LG OLED C3 55</div>
                        <div class="avis-verified"><i class="fa fa-check-circle"/> Achat verifie</div>
                    </div>
                    <div class="avis-card">
                        <div class="avis-card-header"><div class="avis-avatar">JP</div><div class="avis-author-info"><h4>Jean-Pierre V.</h4><span>28 mars 2026</span></div></div>
                        <div class="avis-card-stars"><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star"/><i class="fa fa-star-half-o"/></div>
                        <p class="avis-card-title">Bon produit, site agreable</p>
                        <p class="avis-card-text">Le site est tres bien concu. Le Pixel 8 Pro est excellent, l'IA integree est utile.</p>
                        <div class="avis-card-product"><i class="fa fa-tag"/> Google Pixel 8 Pro</div>
                        <div class="avis-verified"><i class="fa fa-check-circle"/> Achat verifie</div>
                    </div>
                </div>

                <!-- CONTACT supprimé → bloc natif Odoo via Website Builder -->
                <div id="oe_structure_homepage_contact" class="oe_structure oe_empty"/>

                <div id="oe_structure_homepage_end" class="oe_structure oe_empty"/>
            </div>
        </t>
    </template>
</odoo>