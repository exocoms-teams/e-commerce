                <!-- ═══════════════════════════════════════════
                     SCRIPTS
                ═══════════════════════════════════════════ -->
                <script>
                (function() {
                    /* Carrousel avis — défilement auto */
                    function initAvis() {
                        var track = document.getElementById('alt-avis-track');
                        if (!track || track.dataset.init) return;
                        track.dataset.init = '1';
                        var kids = [].slice.call(track.children);
                        if (kids.length &lt; 2) return;
                        kids.forEach(function(n) { track.appendChild(n.cloneNode(true)); });
                        var paused = false;
                        track.addEventListener('mouseenter', function() { paused = true; });
                        track.addEventListener('mouseleave', function() { paused = false; });
                        var pos = 0;
                        (function step() {
                            if (!paused) {
                                pos += 0.5;
                                var half = track.scrollWidth / 2;
                                if (half > 0 &amp;&amp; pos >= half) pos -= half;
                                track.scrollLeft = pos;
                            }
                            requestAnimationFrame(step);
                        })();
                    }
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', initAvis);
                    } else { initAvis(); }
                })();
                </script>

            </div>
        </t>
    </template>
