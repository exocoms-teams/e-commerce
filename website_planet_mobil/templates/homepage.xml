<odoo>
    <template id="homepage" inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="replace">

            <div id="wrap" class="oe_structure">

                
                <aside id="sidebar">

                    <div class="sidebar-logo">
                        <h2>Planet-Mobil</h2>
                    </div>

                    <nav class="sidebar-nav">

                        <a href="/" class="sidebar-link active">
                            <i class="bi bi-house"></i>
                            <span>Accueil</span>
                        </a>

                        <a href="/shop/category/iphone" class="sidebar-link">
                            <i class="bi bi-phone"></i>
                            <span>iPhone</span>
                        </a>

                        <a href="/shop/category/apple-watch" class="sidebar-link">
                            <i class="bi bi-smartwatch"></i>
                            <span>Apple Watch</span>
                        </a>

                        <a href="/shop/category/airpods" class="sidebar-link">
                            <i class="bi bi-headphones"></i>
                            <span>AirPods</span>
                        </a>

                        <a href="/shop/category/accessoires" class="sidebar-link">
                            <i class="bi bi-grid"></i>
                            <span>Accessoires</span>
                        </a>

                        <a href="/contactus" class="sidebar-link">
                            <i class="bi bi-envelope"></i>
                            <span>Contact</span>
                        </a>

                    </nav>
                </aside>

                
                <main id="main-content">

                    
                    <section id="top-bar">
                        <div class="container top-bar-inner">
                            <div class="top-left">
                                +33 (0)6 64 97 80 50
                            </div>
                            <div class="top-center">
                                Livraison gratuite dès 99€
                            </div>
                            <div class="top-right">
                                Lun-Ven : 9h-18h
                            </div>
                        </div>
                    </section>

                    
                    <section class="hero-section">
                        <div class="hero-bg"></div>

                        <div class="container hero-inner">

                            <div class="hero-content">

                                <span class="hero-badge">
                                    NOUVELLE COLLECTION 2025
                                </span>

                                <h1 class="hero-title">
                                    Votre univers
                                    <span class="hero-highlight">
                                        smartphone premium
                                    </span>
                                </h1>

                                <p class="hero-subtitle">
                                    iPhone, Apple Watch, AirPods et accessoires tech dans une expérience moderne inspirée de l’Apple Store.
                                </p>

                                <div class="hero-buttons">
                                    <a href="/shop" class="btn-primary-hero">
                                        Découvrir la boutique
                                    </a>
                                    <a href="/shop" class="btn-outline-hero">
                                        Nouveautés
                                    </a>
                                </div>

                            </div>

                            <div class="hero-device">
                                <img
                                    src="/website_planet_mobil/static/src/img/iphone-hero.png"
                                    alt="iPhone"
                                    class="hero-phone"
                                />
                            </div>

                        </div>
                    </section>

                
                    <section class="reassurance-section">
                        <div class="container reassurance-grid">

                            <div class="reassurance-item">
                                <i class="bi bi-truck"></i>
                                <span>Livraison rapide</span>
                            </div>

                            <div class="reassurance-item">
                                <i class="bi bi-shield-check"></i>
                                <span>Paiement sécurisé</span>
                            </div>

                            <div class="reassurance-item">
                                <i class="bi bi-patch-check"></i>
                                <span>Garantie 24 mois</span>
                            </div>

                            <div class="reassurance-item">
                                <i class="bi bi-headset"></i>
                                <span>Support premium</span>
                            </div>

                        </div>
                    </section>

                    
                    <section class="products-section">
                        <div class="container">

                            <div class="section-header">
                                <div>
                                    <h2 class="section-title">Nouveautés</h2>
                                    <p class="section-sub">Les dernières sorties Apple</p>
                                </div>
                                <a href="/shop" class="btn-see-all">Voir tout</a>
                            </div>

                            <div class="products-grid">
                                <div class="empty-products">
                                    Les produits nouveautés apparaîtront ici
                                </div>
                            </div>

                        </div>
                    </section>

                    
                    <section class="products-section bg-light">
                        <div class="container">

                            <div class="section-header">
                                <div>
                                    <h2 class="section-title">Meilleures ventes</h2>
                                    <p class="section-sub">Les préférés de nos clients</p>
                                </div>
                                <a href="/shop" class="btn-see-all">Voir tout</a>
                            </div>

                            <div class="products-grid">
                                <div class="empty-products">
                                    Les best sellers apparaîtront ici
                                </div>
                            </div>

                        </div>
                    </section>

                    
                    <section class="promo-banner">
                        <div class="container banner-inner">

                            <div class="banner-content">
                                <span class="banner-label">AIRPODS PRO</span>
                                <h2>Audio spatial immersif.</h2>
                                <p>Découvrez une nouvelle génération d’expérience sonore.</p>

                                <a href="/shop" class="btn-primary-hero">
                                    Acheter maintenant
                                </a>
                            </div>

                            <div class="banner-image">
                                <img
                                    src="/website_planet_mobil/static/src/img/airpods-banner.png"
                                    alt="AirPods"
                                />
                            </div>

                        </div>
                    </section>

                    
                    <section class="reviews-section">
                        <div class="container">

                            <div class="section-header center">
                                <div>
                                    <h2 class="section-title">Avis de nos clients</h2>
                                    <p class="section-sub">Ils nous font confiance</p>
                                </div>
                            </div>

                            <div class="reviews-grid">

                                <div class="review-card">
                                    <div class="review-stars">★★★★★</div>
                                    <p class="review-text">
                                        Excellent service, livraison rapide et produits de qualité.
                                    </p>
                                    <div class="review-author">
                                        <div class="review-avatar">M</div>
                                        <div>
                                            <div class="review-name">Marie L.</div>
                                            <div class="review-verified">Client vérifié</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="review-card">
                                    <div class="review-stars">★★★★★</div>
                                    <p class="review-text">
                                        Site très professionnel et prix imbattables.
                                    </p>
                                    <div class="review-author">
                                        <div class="review-avatar">T</div>
                                        <div>
                                            <div class="review-name">Thomas B.</div>
                                            <div class="review-verified">Client vérifié</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="review-card">
                                    <div class="review-stars">★★★★★</div>
                                    <p class="review-text">
                                        Mon Apple Watch est magnifique.
                                    </p>
                                    <div class="review-author">
                                        <div class="review-avatar">S</div>
                                        <div>
                                            <div class="review-name">Sophie M.</div>
                                            <div class="review-verified">Client vérifié</div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </section>

                    
                    <section class="newsletter-section">
                        <div class="container newsletter-inner">

                            <div class="newsletter-text">
                                <h2>Restez informé !</h2>
                                <p>Inscrivez-vous et recevez nos offres en avant-première.</p>
                            </div>

                            <form class="newsletter-form">
                                <input
                                    type="email"
                                    placeholder="Votre adresse email..."
                                    class="newsletter-input"
                                />
                                <button type="submit" class="newsletter-btn">
                                    S’inscrire
                                </button>
                            </form>

                        </div>
                    </section>

                    <!-- FOOTER -->
                    <footer id="main-footer">
                        <div class="container footer-grid">

                            <div>
                                <h3 class="footer-title">Planet-Mobil</h3>
                                <p class="footer-desc">
                                    Chez Planet-mobil, nous sommes plus qu'une simple boutique en ligne. Nous sommes une équipe passionnée de tech-addicts, de conseillers experts et de perfectionnistes du service client, tous réunis par une mission commune : vous offrir la meilleure expérience d'achat tech en ligne.
                                   Nous croyons que la technologie devrait être accessible, intuitive et transformative. Nous sélectionnons méticuleusement les produits tech les plus innovants pour simplifier votre quotidien et vous connecter à l'avenir.
                                </p>
                            </div>

                            <div>
                                <h3 class="footer-title">Liens utiles</h3>
                                <ul class="footer-links">
                                    <li><a href="/">Accueil</a></li>
                                    <li><a href="/shop">Boutique</a></li>
                                    <li><a href="/contactus">Contact</a></li>
                                </ul>
                            </div>

                            <div>
                                <h3 class="footer-title">Produits</h3>
                                <ul class="footer-links">
                                    <li><a href="#">iPhone</a></li>
                                    <li><a href="#">AirPods</a></li>
                                    <li><a href="#">Apple Watch</a></li>
                                </ul>
                            </div>

                            <div>
                                <h3 class="footer-title">Contact</h3>
                                <ul class="footer-links">
                                    <li>+33 (0)6 64 97 80 50</li>
                                    <li>contact@planet-mobil.com</li>
                                    <li>Lun-Ven : 9h-18h</li>
                                </ul>
                            </div>

                        </div>
                    </footer>

                </main>
            </div>

        </xpath>
    </template>
</odoo>