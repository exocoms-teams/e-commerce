<odoo>
    <template id="homepage" name="Planet Mobil - Accueil">
        <t t-call="website_planet_mobil.layout">
            <div id="wrap" class="oe_structure">
                <div id="oe_structure_homepage_hero" class="oe_structure oe_empty" />
                <section class="tsp-hero">
                    <div class="tsp-hero-content">
                        <h1 class="tsp-hero-title">Bienvenue chez PLANET MOBIL</h1>
                        <p class="tsp-hero-subtitle">Decouvrez les dernieres technologies au
                            meilleur
                            prix</p>
                        <a href="/shop" class="tsp-btn-hero">Decouvrir nos produits</a>
                    </div>
                </section>
                <div id="oe_structure_homepage_top_vente" class="oe_structure oe_empty" />
                <section class="tsp-section">
                    <div class="tsp-section-header">
                        <h2 class="tsp-section-title">Top Ventes</h2>
                        <a href="/shop?filter=top-ventes" class="tsp-voir-tout">Voir tout</a>
                    </div>
                    <div class="tsp-products-grid">
                        <t t-foreach="top_ventes" t-as="product">
                            <div class="tsp-card">
                                <a
                                    t-attf-href="/shop/product/#{product['id'] if isinstance(product, dict) else product.id}"
                                    class="tsp-card-link">

                                    <div class="tsp-card-img-wrap">
                                        <img
                                            t-att-src="product['image_url'] if isinstance(product, dict) else '/web/image/product.template/' + str(product.id) + '/image_1920'"
                                            t-att-alt="product['name'] if isinstance(product, dict) else product.name"
                                            class="tsp-card-img"
                                            onerror="this.parentElement.classList.add('tsp-img-placeholder')" />
                                        <button class="tsp-wishlist-btn">
                                            <i class="fa fa-heart-o" />
                                        </button>
                                    </div>
                                    <div class="tsp-card-body">
                                        <div class="tsp-stars">
                                            <t t-set="prod_rating"
                                                t-value="int(product['rating'] if isinstance(product, dict) else product.website_rating_count)" />
                                            <t t-foreach="range(5)" t-as="star_i">
                                                <i t-if="star_i &lt; prod_rating"
                                                    class="fa fa-star tsp-star-on" />
                                                <i t-else="" class="fa fa-star tsp-star-off" />
                                            </t>
                                            <span class="tsp-stars-count"> ( <t
                                                    t-out="product['rating'] if isinstance(product, dict) else product.website_rating_count" />
                                                ) </span>
                                        </div>
                                        <h3 class="tsp-card-name">
                                            <t
                                                t-out="product['name'] if isinstance(product, dict) else product.name" />
                                        </h3>
                                        <p class="tsp-card-desc">
                                            <t
                                                t-out="product['description'] if isinstance(product, dict) else product.description_sale" />
                                        </p>
                                        <div class="tsp-card-footer">
                                            <span class="tsp-price">
                                                <t
                                                    t-out="product['price'] if isinstance(product, dict) else product.list_price" />
                                                euro </span>
                                            <button class="tsp-btn-add">
                                                <i class="fa fa-shopping-cart" /> Ajouter </button>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </t>
                    </div>
                </section>
                <div id="oe_structure_homepage_nouveautes" class="oe_structure oe_empty" />
                <section class="tsp-section">
                    <div class="tsp-section-header">
                        <h2 class="tsp-section-title">Nouveautes</h2>
                        <a href="/shop?filter=nouveautes" class="tsp-voir-tout">Voir tout</a>
                    </div>
                    <div class="tsp-products-grid">
                        <t t-foreach="nouveautes" t-as="product">
                            <div class="tsp-card">
                                <a
                                    t-attf-href="/shop/product/#{product['id'] if isinstance(product, dict) else product.id}"
                                    class="tsp-card-link">

                                    <div class="tsp-card-img-wrap">
                                        <t t-set="prod_badge"
                                            t-value="product['badge'] if isinstance(product, dict) else product.website_ribbon_id.html" />
                                        <t t-if="prod_badge">
                                            <span class="tsp-badge-new">
                                                <t t-out="prod_badge" />
                                            </span>
                                        </t>
                                        <img
                                            t-att-src="product['image_url'] if isinstance(product, dict) else '/web/image/product.template/' + str(product.id) + '/image_1920'"
                                            t-att-alt="product['name'] if isinstance(product, dict) else product.name"
                                            class="tsp-card-img"
                                            onerror="this.parentElement.classList.add('tsp-img-placeholder')" />
                                        <button class="tsp-wishlist-btn">
                                            <i class="fa fa-heart-o" />
                                        </button>
                                    </div>
                                    <div class="tsp-card-body">
                                        <div class="tsp-stars">
                                            <t t-set="prod_rating"
                                                t-value="int(product['rating'] if isinstance(product, dict) else product.website_rating_count)" />
                                            <t t-foreach="range(5)" t-as="star_i">
                                                <i t-if="star_i &lt; prod_rating"
                                                    class="fa fa-star tsp-star-on" />
                                                <i t-else="" class="fa fa-star tsp-star-off" />
                                            </t>
                                            <span class="tsp-stars-count"> ( <t
                                                    t-out="product['rating'] if isinstance(product, dict) else product.website_rating_count" />
                                                ) </span>
                                        </div>
                                        <h3 class="tsp-card-name">
                                            <t
                                                t-out="product['name'] if isinstance(product, dict) else product.name" />
                                        </h3>
                                        <p class="tsp-card-desc">
                                            <t
                                                t-out="product['description'] if isinstance(product, dict) else product.description_sale" />
                                        </p>
                                        <div class="tsp-card-footer">
                                            <span class="tsp-price">
                                                <t
                                                    t-out="product['price'] if isinstance(product, dict) else product.list_price" />
                                                euro </span>
                                            <button class="tsp-btn-add">
                                                <i class="fa fa-shopping-cart" /> Ajouter </button>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </t>
                    </div>
                </section>
                <div id="oe_structure_homepage_bottom" class="oe_structure oe_empty" />
                <section class="tsp-promo">
                    <div class="tsp-promo-inner">
                        <h2 class="tsp-promo-title">Offres exceptionnelles</h2>
                        <p class="tsp-promo-subtitle">Jusqu'a -50% sur une selection de produits</p>
                        <a href="/promotions" class="tsp-btn-promo">Profiter des promotions</a>
                    </div>
                </section>
                <div id="oe_structure_homepage_avis" class="oe_structure oe_empty" />
                <div class="avis-hero">
                    <h1>Avis de nos clients</h1>
                    <p>Ce que pensent nos clients de Planet Mobil</p>
                </div>
                <div class="avis-stats">
                    <div class="avis-stat-main">
                        <div class="note">4.6</div>
                        <div class="stars-big">
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star-half-o" />
                        </div>
                        <p>Base sur 248 avis verifies</p>
                    </div>
                    <div class="avis-stat-bars">
                        <div class="avis-bar-row">
                            <span>5 etoiles</span>
                            <div class="avis-bar-bg">
                                <div class="avis-bar-fill" style="width:72%" />
                            </div>
                            <span>72%</span>
                        </div>
                        <div class="avis-bar-row">
                            <span>4 etoiles</span>
                            <div class="avis-bar-bg">
                                <div class="avis-bar-fill" style="width:18%" />
                            </div>
                            <span>18%</span>
                        </div>
                        <div class="avis-bar-row">
                            <span>3 etoiles</span>
                            <div class="avis-bar-bg">
                                <div class="avis-bar-fill" style="width:6%" />
                            </div>
                            <span>6%</span>
                        </div>
                        <div class="avis-bar-row">
                            <span>2 etoiles</span>
                            <div class="avis-bar-bg">
                                <div class="avis-bar-fill" style="width:3%" />
                            </div>
                            <span>3%</span>
                        </div>
                        <div class="avis-bar-row">
                            <span>1 etoile</span>
                            <div class="avis-bar-bg">
                                <div class="avis-bar-fill" style="width:1%" />
                            </div>
                            <span>1%</span>
                        </div>
                    </div>
                </div>
                <div class="avis-grid">
                    <div class="avis-card">
                        <div class="avis-card-header">
                            <div class="avis-avatar">ML</div>
                            <div class="avis-author-info">
                                <h4>Marie L.</h4>
                                <span>12 janvier 2026</span>
                            </div>
                        </div>
                        <div class="avis-card-stars">
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                        </div>
                        <p class="avis-card-title">Livraison ultra rapide !</p>
                        <p class="avis-card-text">Commande passee le soir, recue le lendemain matin.
                            Produit exactement comme decrit, je suis ravie de mon achat.</p>
                        <div class="avis-card-product">
                            <i class="fa fa-tag" /> iPhone 15 Pro Max </div>
                        <div class="avis-verified">
                            <i class="fa fa-check-circle" /> Achat verifie </div>
                    </div>
                    <div class="avis-card">
                        <div class="avis-card-header">
                            <div class="avis-avatar">TK</div>
                            <div class="avis-author-info">
                                <h4>Thomas K.</h4>
                                <span>5 fevrier 2026</span>
                            </div>
                        </div>
                        <div class="avis-card-stars">
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                        </div>
                        <p class="avis-card-title">Excellent rapport qualite/prix</p>
                        <p class="avis-card-text">La montre est magnifique, les fonctionnalites sont
                            top. Service client tres reactif. Tres bonne experience.</p>
                        <div class="avis-card-product">
                            <i class="fa fa-tag" /> Apple Watch Series 9 </div>
                        <div class="avis-verified">
                            <i class="fa fa-check-circle" /> Achat verifie </div>
                    </div>
                    <div class="avis-card">
                        <div class="avis-card-header">
                            <div class="avis-avatar">SB</div>
                            <div class="avis-author-info">
                                <h4>Sophie B.</h4>
                                <span>18 fevrier 2026</span>
                            </div>
                        </div>
                        <div class="avis-card-stars">
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star-o" style="color:#d1d5db" />
                        </div>
                        <p class="avis-card-title">Tres satisfaite de mon casque</p>
                        <p class="avis-card-text">La reduction de bruit est impressionnante, ideal
                            pour
                            travailler. Livraison un peu lente mais produit parfait.</p>
                        <div class="avis-card-product">
                            <i class="fa fa-tag" /> Sony WH-1000XM5 </div>
                        <div class="avis-verified">
                            <i class="fa fa-check-circle" /> Achat verifie </div>
                    </div>
                    <div class="avis-card">
                        <div class="avis-card-header">
                            <div class="avis-avatar">AD</div>
                            <div class="avis-author-info">
                                <h4>Alexandre D.</h4>
                                <span>2 mars 2026</span>
                            </div>
                        </div>
                        <div class="avis-card-stars">
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                        </div>
                        <p class="avis-card-title">Le meilleur smartphone Android</p>
                        <p class="avis-card-text">Photos epoustouflantes, fluidite parfaite,
                            autonomie
                            excellente. Un achat que je ne regrette pas du tout !</p>
                        <div class="avis-card-product">
                            <i class="fa fa-tag" /> Samsung Galaxy S21 Ultra </div>
                        <div class="avis-verified">
                            <i class="fa fa-check-circle" /> Achat verifie </div>
                    </div>
                    <div class="avis-card">
                        <div class="avis-card-header">
                            <div class="avis-avatar">CM</div>
                            <div class="avis-author-info">
                                <h4>Clara M.</h4>
                                <span>15 mars 2026</span>
                            </div>
                        </div>
                        <div class="avis-card-stars">
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                        </div>
                        <p class="avis-card-title">TV incroyable pour le gaming</p>
                        <p class="avis-card-text">L'image OLED est a couper le souffle. Le mode
                            gaming
                            120Hz fait vraiment la difference. Livraison soignee.</p>
                        <div class="avis-card-product">
                            <i class="fa fa-tag" /> LG OLED C3 55 </div>
                        <div class="avis-verified">
                            <i class="fa fa-check-circle" /> Achat verifie </div>
                    </div>
                    <div class="avis-card">
                        <div class="avis-card-header">
                            <div class="avis-avatar">JP</div>
                            <div class="avis-author-info">
                                <h4>Jean-Pierre V.</h4>
                                <span>28 mars 2026</span>
                            </div>
                        </div>
                        <div class="avis-card-stars">
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star" />
                            <i class="fa fa-star-half-o" />
                        </div>
                        <p class="avis-card-title">Bon produit, site agreable</p>
                        <p class="avis-card-text">Le site est tres bien concu, navigation intuitive.
                            Le
                            Pixel 8 Pro est excellent, l'IA integree est utile au quotidien.</p>
                        <div class="avis-card-product">
                            <i class="fa fa-tag" /> Google Pixel 8 Pro </div>
                        <div class="avis-verified">
                            <i class="fa fa-check-circle" /> Achat verifie </div>
                    </div>
                </div>
                <div id="oe_structure_homepage_contact" class="oe_structure oe_empty" />
                <div class="contact-hero">
                    <h1>Contactez-nous</h1>
                    <p>Notre equipe est disponible pour repondre a toutes vos questions</p>
                </div>
                <div class="contact-layout">
                    <div class="contact-infos">
                        <div class="contact-info-card">
                            <div class="contact-info-icon">
                                <i class="fa fa-map-marker" />
                            </div>
                            <div>
                                <h4>Notre adresse</h4>
                                <p>58 Rue de Monceau, 75008 Paris</p>
                            </div>
                        </div>
                        <div class="contact-info-card">
                            <div class="contact-info-icon">
                                <i class="fa fa-phone" />
                            </div>
                            <div>
                                <h4>Telephone</h4>
                                <p>+33 (0)6 64 97 80 50</p>
                            </div>
                        </div>
                        <div class="contact-info-card">
                            <div class="contact-info-icon">
                                <i class="fa fa-envelope" />
                            </div>
                            <div>
                                <h4>Email</h4>
                                <p>contact@planet-mobil.com</p>
                            </div>
                        </div>
                        <div class="contact-info-card">
                            <div class="contact-info-icon">
                                <i class="fa fa-clock-o" />
                            </div>
                            <div>
                                <h4>Horaires</h4>
                                <p>Lundi-Vendredi: 9h-18h</p>
                            </div>
                        </div>
                    </div>
                    <div class="contact-form-wrap">
                        <h2>
                            <i class="fa fa-paper-plane" style="color:#2c4ecb;margin-right:8px" />
                            Envoyer un message </h2>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Nom *</label>
                                <input type="text" name="nom" placeholder="Votre nom" required="1" />
                            </div>
                            <div class="form-group">
                                <label>Prenom *</label>
                                <input type="text" name="prenom" placeholder="Votre prenom"
                                    required="1" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Adresse email *</label>
                            <input type="email" name="email" placeholder="exemple@email.com"
                                required="1" />
                        </div>
                        <div class="form-group">
                            <label>Sujet</label>
                            <select name="sujet">
                                <option value="">Selectionnez un sujet</option>
                                <option>Question sur un produit</option>
                                <option>Suivi de commande</option>
                                <option>Retour / Remboursement</option>
                                <option>Probleme technique</option>
                                <option>Autre</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Votre question *</label>
                            <textarea name="question" placeholder="Decrivez votre question..."
                                required="1" />
                        </div>
                        <button class="form-submit" type="submit">
                            <i class="fa fa-paper-plane" /> Envoyer le message </button>
                    </div>
                </div>
                <div id="oe_structure_homepage_end" class="oe_structure oe_empty" />
            </div>
        </t>
    </template>
</odoo>