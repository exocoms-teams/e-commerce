<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_planet_product_form" model="ir.ui.view">
        <field name="name">planet.product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Planet Mobil">
                    <field name="x_brand"/>
                    <field name="x_is_top_vente"/>
                    <field name="x_is_nouveaute"/>
                    <field name="x_is_promotion"/>
                </group>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Specifications" name="planet_specs">
                    <field name="x_specs" 
                           placeholder="Ex: Processeur: Apple A17 Pro&#10;Mémoire: 256 GB&#10;Écran: 6.7 pouces"/>
                </page>
            </xpath>

        </field>
    </record>
</odoo>