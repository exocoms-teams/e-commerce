<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="planet_attribute_form_view" model="ir.ui.view">
            <field name="name">product.attribute.form.inherit</field>
            <field name="model">product.attribute</field>
            <field name="inherit_id" ref="product.product_attribute_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='value_ids']" position="before">
                    <field name="x_product_categ_ids" widget="many2many_tags"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>