<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="planet_mobil_homepage" inherit_id="website.homepage" name="Planet Mobil Home">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Section Hero -->
                <section class="s_hero_section text-center position-relative" style="background-color: #f8f9fa; padding: 60px 0;">
                    <div class="container">
                        <h1 style="color: #007bff; font-weight: bold;">Bienvenue chez Planet Mobil</h1>
                        <p class="lead">Votre expert en accessoires et réparations mobiles.</p>
                        <a href="/shop" class="btn btn-primary btn-lg">Découvrir nos produits</a>
                    </div>
                </section>
                
                <!-- Tu pourras ajouter tes autres sections ici plus tard -->
            </div>
        </xpath>
    </template>
</odoo>