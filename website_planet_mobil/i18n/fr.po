"            overflow: hidden;\n"
"            text-align: center;\n"
"        }\n"
"        .pm-contact-hero::before {\n"
"            content: '';\n"
"            position: absolute;\n"
"            width: 700px; height: 700px;\n"
"            border-radius: 50%;\n"
"            background: radial-gradient(circle, rgba(37,99,235,0.14) 0%, transparent 70%);\n"
"            top: -200px; left: 50%;\n"
"            transform: translateX(-50%);\n"
"            pointer-events: none;\n"
"        }\n"
"        /* Ligne animée en haut */\n"
"        .pm-contact-topbar {\n"
"            position: absolute; top: 0; left: 0; right: 0;\n"
"            height: 3px;\n"
"            background: linear-gradient(90deg, #2563eb, #7c3aed, #2563eb);\n"
"            background-size: 200% 100%;\n"
"            animation: pmGradMove 4s linear infinite;\n"
"        }\n"
"        @keyframes pmGradMove { 0% { background-position: 0%; } 100% { background-position: 200%; } }\n"
"        .pm-contact-hero-inner {\n"
"            position: relative; z-index: 2;\n"
"            max-width: 680px;\n"
"            margin: 0 auto;\n"
"            animation: pmFadeUp 0.8s ease both;\n"
"        }\n"
"        @keyframes pmFadeUp { from { opacity:0; transform:translateY(30px); } to { opacity:1; transform:translateY(0); } }\n"
"        .pm-contact-eyebrow {\n"
"            display: inline-flex;\n"
"            align-items: center;\n"
"            gap: 8px;\n"
"            background: rgba(99,179,237,0.12);\n"
"            border: 1px solid rgba(99,179,237,0.3);\n"
"            color: #63b3ed;\n"
"            font-size: 0.75rem;\n"
"            font-weight: 700;\n"
"            letter-spacing: 0.14em;\n"
"            text-transform: uppercase;\n"
"            padding: 6px 16px;\n"
"            border-radius: 50px;\n"
"            margin-bottom: 24px;\n"
"        }\n"
"        .pm-contact-eyebrow-dot {\n"
"            width: 6px; height: 6px;\n"
"            background: #63b3ed;\n"
"            border-radius: 50%;\n"
"            animation: pmDotPulse 1.4s infinite;\n"
"        }\n"
"        @keyframes pmDotPulse { 0%,100%{transform:scale(1);opacity:1;} 50%{transform:scale(1.7);opacity:0.5;} }\n"
"        .pm-contact-hero h1 {\n"
"            font-size: clamp(2rem, 4.5vw, 3.2rem);\n"
"            font-weight: 900;\n"
"            color: #fff;\n"
"            line-height: 1.1;\n"
"            margin: 0 0 18px;\n"
"        }\n"
"        .pm-contact-hero h1 span {\n"
"            background: linear-gradient(135deg, #63b3ed, #a78bfa);\n"
"            -webkit-background-clip: text;\n"
"            -webkit-text-fill-color: transparent;\n"
"            background-clip: text;\n"
"        }\n"
"        .pm-contact-hero p {\n"
"            font-size: 1.05rem;\n"
"            color: rgba(255,255,255,0.55);\n"
"            line-height: 1.7;\n"
"            margin: 0;\n"
"        }\n"
"\n"
"        /* ══════════════════════════════════════\n"
"           LAYOUT PRINCIPAL\n"
"        ══════════════════════════════════════ */\n"
"        .pm-contact-body {\n"
"            background: #f8fafc;\n"
"            padding: 72px 40px 80px;\n"
"        }\n"
"        .pm-contact-wrap {\n"
"            max-width: 1160px;\n"
"            margin: 0 auto;\n"
"            display: grid;\n"
"            grid-template-columns: 1fr 1.5fr;\n"
"            gap: 48px;\n"
"            align-items: start;\n"
"        }\n"
"\n"
"        /* ══════════════════════════════════════\n"
"           COLONNE GAUCHE — infos\n"
"        ══════════════════════════════════════ */\n"
"        .pm-contact-info {}\n"
"        .pm-contact-info-title {\n"
"            font-size: 1.5rem;\n"
"            font-weight: 800;\n"
"            color: #0f172a;\n"
"            margin-bottom: 8px;\n"
"        }\n"
"        .pm-contact-info-sub {\n"
"            font-size: 0.9rem;\n"
"            color: #64748b;\n"
"            margin-bottom: 36px;\n"
"            line-height: 1.6;\n"
"        }\n"
"\n"
"        /* Cartes contact */\n"
"        .pm-info-cards {\n"
"            display: flex;\n"
"            flex-direction: column;\n"
"            gap: 16px;\n"
"            margin-bottom: 36px;\n"
"        }\n"
"        .pm-info-card {\n"
"            display: flex;\n"
"            align-items: center;\n"
"            gap: 18px;\n"
"            background: #fff;\n"
"            border: 1px solid #e2e8f0;\n"
"            border-radius: 16px;\n"
"            padding: 20px 24px;\n"
"            text-decoration: none !important;\n"
"            transition: all 0.25s ease;\n"
"            position: relative;\n"
"            overflow: hidden;\n"
"        }\n"
"        .pm-info-card::before {\n"
"            content: '';\n"
"            position: absolute;\n"
"            left: 0; top: 0; bottom: 0;\n"
"            width: 3px;\n"
"            background: linear-gradient(180deg, #2563eb, #7c3aed);\n"
"            transform: scaleY(0);\n"
"            transition: transform 0.25s ease;\n"
"            transform-origin: top;\n"
"        }\n"
"        .pm-info-card:hover {\n"
"            transform: translateX(5px);\n"
"            box-shadow: 0 8px 28px rgba(37,99,235,0.1);\n"
"            border-color: transparent;\n"
"        }\n"
"        .pm-info-card:hover::before { transform: scaleY(1); }\n"
"        .pm-info-card-icon {\n"
"            width: 48px; height: 48px;\n"
"            border-radius: 12px;\n"
"            display: flex; align-items: center; justify-content: center;\n"
"            font-size: 1.05rem;\n"
"            flex-shrink: 0;\n"
"        }\n"
"        .pm-info-card:nth-child(1) .pm-info-card-icon { background: #dbeafe; color: #2563eb; }\n"
"        .pm-info-card:nth-child(2) .pm-info-card-icon { background: #dcfce7; color: #16a34a; }\n"
"        .pm-info-card:nth-child(3) .pm-info-card-icon { background: #fef3c7; color: #d97706; }\n"
"        .pm-info-card:nth-child(4) .pm-info-card-icon { background: #fce7f3; color: #db2777; }\n"
"        .pm-info-card-label {\n"
"            font-size: 0.72rem;\n"
"            font-weight: 700;\n"
"            letter-spacing: 0.1em;\n"
"            text-transform: uppercase;\n"
"            color: #94a3b8;\n"
"            margin-bottom: 3px;\n"
"        }\n"
"        .pm-info-card-value {\n"
"            font-size: 0.9rem;\n"
"            font-weight: 600;\n"
"            color: #0f172a;\n"
"            line-height: 1.4;\n"
"        }\n"
"        .pm-info-card-sub {\n"
"            font-size: 0.78rem;\n"
"            color: #94a3b8;\n"
"            margin-top: 2px;\n"
"        }\n"
"\n"
"        /* Réseaux sociaux */\n"
"        .pm-contact-social-title {\n"
"            font-size: 0.8rem;\n"
"            font-weight: 700;\n"
"            color: #94a3b8;\n"
"            letter-spacing: 0.1em;\n"
"            text-transform: uppercase;\n"
"            margin-bottom: 14px;\n"
"        }\n"
"        .pm-contact-social {\n"
"            display: flex;\n"
"            gap: 10px;\n"
"        }\n"
"        .pm-contact-social-btn {\n"
"            width: 42px; height: 42px;\n"
"            border-radius: 10px;\n"
"            background: #fff;\n"
"            border: 1px solid #e2e8f0;\n"
"            display: flex; align-items: center; justify-content: center;\n"
"            color: #64748b !important;\n"
"            text-decoration: none !important;\n"
"            font-size: 1rem;\n"
"            transition: all 0.25s;\n"
"        }\n"
"        .pm-contact-social-btn:hover { transform: translateY(-3px); border-color: transparent; }\n"
"        .pm-contact-social-btn.fb:hover { background: #1877f2; color: #fff !important; }\n"
"        .pm-contact-social-btn.ig:hover { background: linear-gradient(135deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888); color: #fff !important; }\n"
"        .pm-contact-social-btn.tw:hover { background: #1da1f2; color: #fff !important; }\n"
"        .pm-contact-social-btn.yt:hover { background: #ff0000; color: #fff !important; }\n"
"\n"
"        /* ══════════════════════════════════════\n"
"           COLONNE DROITE — formulaire\n"
"        ══════════════════════════════════════ */\n"
"        .pm-contact-form-card {\n"
"            background: #fff;\n"
"            border-radius: 24px;\n"
"            border: 1px solid #e2e8f0;\n"
"            padding: 44px 44px;\n"
"            box-shadow: 0 4px 32px rgba(0,0,0,0.06);\n"
"            position: relative;\n"
"            overflow: hidden;\n"
"        }\n"
"        .pm-contact-form-card::before {\n"
"            content: '';\n"
"            position: absolute;\n"
"            top: 0; left: 0; right: 0;\n"
"            height: 3px;\n"
"            background: linear-gradient(90deg, #2563eb, #7c3aed);\n"
"        }\n"
"        .pm-form-title {\n"
"            font-size: 1.4rem;\n"
"            font-weight: 800;\n"
"            color: #0f172a;\n"
"            margin-bottom: 6px;\n"
"        }\n"
"        .pm-form-sub {\n"
"            font-size: 0.875rem;\n"
"            color: #64748b;\n"
"            margin-bottom: 32px;\n"
"        }\n"
"\n"
"        /* Champs */\n"
"        .pm-form-row {\n"
"            display: grid;\n"
"            grid-template-columns: 1fr 1fr;\n"
"            gap: 16px;\n"
"        }\n"
"        .pm-form-group {\n"
"            margin-bottom: 20px;\n"
"        }\n"
"        .pm-form-group.full { grid-column: 1 / -1; }\n"
"        .pm-form-label {\n"
"            display: block;\n"
"            font-size: 0.8rem;\n"
"            font-weight: 600;\n"
"            color: #374151;\n"
"            margin-bottom: 7px;\n"
"            letter-spacing: 0.02em;\n"
"        }\n"
"        .pm-form-label .req { color: #ef4444; margin-left: 2px; }\n"
"        .pm-form-input,\n"
"        .pm-form-textarea {\n"
"            width: 100%;\n"
"            background: #f8fafc;\n"
"            border: 1.5px solid #e2e8f0;\n"
"            border-radius: 10px;\n"
"            font-size: 0.9rem;\n"
"            font-family: 'Inter', sans-serif;\n"
"            color: #0f172a;\n"
"            padding: 12px 16px;\n"
"            outline: none;\n"
"            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;\n"
"            box-sizing: border-box;\n"
"        }\n"
"        .pm-form-input::placeholder,\n"
"        .pm-form-textarea::placeholder { color: #c0ccd8; }\n"
"        .pm-form-input:focus,\n"
"        .pm-form-textarea:focus {\n"
"            border-color: #2563eb;\n"
"            background: #fff;\n"
"            box-shadow: 0 0 0 3px rgba(37,99,235,0.1);\n"
"        }\n"
"        .pm-form-textarea { resize: vertical; min-height: 130px; }\n"
"\n"
"        /* Sujet — select stylisé */\n"
"        .pm-form-select-wrap { position: relative; }\n"
"        .pm-form-select {\n"
"            width: 100%;\n"
"            background: #f8fafc;\n"
"            border: 1.5px solid #e2e8f0;\n"
"            border-radius: 10px;\n"
"            font-size: 0.9rem;\n"
"            font-family: 'Inter', sans-serif;\n"
"            color: #0f172a;\n"
"            padding: 12px 40px 12px 16px;\n"
"            outline: none;\n"
"            appearance: none;\n"
"            -webkit-appearance: none;\n"
"            cursor: pointer;\n"
"            transition: border-color 0.2s, box-shadow 0.2s;\n"
"            box-sizing: border-box;\n"
"        }\n"
"        .pm-form-select:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.1); background: #fff; }\n"
"        .pm-form-select-arrow {\n"
"            position: absolute;\n"
"            right: 14px; top: 50%;\n"
"            transform: translateY(-50%);\n"
"            color: #94a3b8;\n"
"            pointer-events: none;\n"
"            font-size: 0.75rem;\n"
"        }\n"
"\n"
"        /* Bouton submit */\n"
"        .pm-form-submit {\n"
"            display: inline-flex;\n"
"            align-items: center;\n"
"            gap: 10px;\n"
"            background: linear-gradient(135deg, #2563eb, #7c3aed);\n"
"            color: #fff !important;\n"
"            font-weight: 700;\n"
"            font-size: 0.95rem;\n"
"            padding: 14px 32px;\n"
"            border-radius: 50px;\n"
"            text-decoration: none !important;\n"
"            transition: transform 0.2s, box-shadow 0.2s;\n"
"            box-shadow: 0 6px 24px rgba(37,99,235,0.35);\n"
"            cursor: pointer;\n"
"            border: none;\n"
"            width: 100%;\n"
"            justify-content: center;\n"
"            margin-top: 4px;\n"
"            font-family: 'Inter', sans-serif;\n"
"        }\n"
"        .pm-form-submit:hover {\n"
"            transform: translateY(-2px);\n"
"            box-shadow: 0 12px 32px rgba(37,99,235,0.45);\n"
"            color: #fff !important;\n"
"        }\n"
"\n"
"        /* Message succès */\n"
"        .pm-success-msg {\n"
"            text-align: center;\n"
"            padding: 48px 24px;\n"
"        }\n"
"        .pm-success-icon {\n"
"            width: 72px; height: 72px;\n"
"            border-radius: 50%;\n"
"            background: linear-gradient(135deg, #22c55e, #16a34a);\n"
"            display: flex; align-items: center; justify-content: center;\n"
"            font-size: 1.8rem;\n"
"            color: #fff;\n"
"            margin: 0 auto 20px;\n"
"            animation: pmBounceIn 0.5s ease;\n"
"        }\n"
"        @keyframes pmBounceIn {\n"
"            0%   { transform: scale(0); opacity: 0; }\n"
"            60%  { transform: scale(1.15); }\n"
"            100% { transform: scale(1); opacity: 1; }\n"
"        }\n"
"        .pm-success-title {\n"
"            font-size: 1.5rem;\n"
"            font-weight: 800;\n"
"            color: #0f172a;\n"
"            margin-bottom: 10px;\n"
"        }\n"
"        .pm-success-text {\n"
"            font-size: 0.9rem;\n"
"            color: #64748b;\n"
"            line-height: 1.7;\n"
"        }\n"
"\n"
"        /* ══════════════════════════════════════\n"
"           FAQ\n"
"        ══════════════════════════════════════ */\n"
"        .pm-faq {\n"
"            background: #fff;\n"
"            padding: 72px 40px 80px;\n"
"            border-top: 1px solid #f1f5f9;\n"
"        }\n"
"        .pm-faq-inner {\n"
"            max-width: 760px;\n"
"            margin: 0 auto;\n"
"        }\n"
"        .pm-faq-header {\n"
"            text-align: center;\n"
"            margin-bottom: 48px;\n"
"        }\n"
"        .pm-section-eyebrow {\n"
"            display: inline-block;\n"
"            font-size: 0.72rem;\n"
"            font-weight: 700;\n"
"            letter-spacing: 0.15em;\n"
"            text-transform: uppercase;\n"
"            color: #2563eb;\n"
"            background: #dbeafe;\n"
"            padding: 5px 14px;\n"
"            border-radius: 50px;\n"
"            margin-bottom: 14px;\n"
"        }\n"
"        .pm-faq-title {\n"
"            font-size: clamp(1.5rem, 3vw, 2rem);\n"
"            font-weight: 800;\n"
"            color: #0f172a;\n"
"            margin: 0;\n"
"        }\n"
"        .pm-faq-item {\n"
"            border: 1px solid #e2e8f0;\n"
"            border-radius: 14px;\n"
"            margin-bottom: 12px;\n"
"            overflow: hidden;\n"
"            transition: box-shadow 0.2s;\n"
"        }\n"
"        .pm-faq-item.open { box-shadow: 0 4px 20px rgba(37,99,235,0.08); border-color: #bfdbfe; }\n"
"        .pm-faq-question {\n"
"            display: flex;\n"
"            align-items: center;\n"
"            justify-content: space-between;\n"
"            gap: 16px;\n"
"            padding: 20px 24px;\n"
"            cursor: pointer;\n"
"            font-size: 0.95rem;\n"
"            font-weight: 600;\n"
"            color: #0f172a;\n"
"            user-select: none;\n"
"            transition: color 0.2s;\n"
"        }\n"
"        .pm-faq-item.open .pm-faq-question { color: #2563eb; }\n"
"        .pm-faq-chevron {\n"
"            width: 28px; height: 28px;\n"
"            border-radius: 8px;\n"
"            background: #f1f5f9;\n"
"            display: flex; align-items: center; justify-content: center;\n"
"            font-size: 0.75rem;\n"
"            color: #64748b;\n"
"            flex-shrink: 0;\n"
"            transition: all 0.25s;\n"
"        }\n"
"        .pm-faq-item.open .pm-faq-chevron {\n"
"            background: #dbeafe;\n"
"            color: #2563eb;\n"
"            transform: rotate(180deg);\n"
"        }\n"
"        .pm-faq-answer {\n"
"            display: none;\n"
"            padding: 0 24px 20px;\n"
"            font-size: 0.875rem;\n"
"            color: #475569;\n"
"            line-height: 1.75;\n"
"        }\n"
"        .pm-faq-item.open .pm-faq-answer { display: block; }\n"
"\n"
"        /* ══════════════════════════════════════\n"
"           RESPONSIVE\n"
"        ══════════════════════════════════════ */\n"
"        @media (max-width: 900px) {\n"
"            .pm-contact-wrap { grid-template-columns: 1fr; }\n"
"            .pm-contact-hero { padding: 80px 24px 60px; }\n"
"            .pm-contact-body { padding: 48px 24px 60px; }\n"
"            .pm-contact-form-card { padding: 32px 28px; }\n"
"            .pm-faq { padding: 60px 24px; }\n"
"        }\n"
"        @media (max-width: 540px) {\n"
"            .pm-form-row { grid-template-columns: 1fr; }\n"
"            .pm-form-group.full { grid-column: auto; }\n"
"        }"
msgstr ""

