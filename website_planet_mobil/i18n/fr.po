#. module: website_planet_mobil
#: model_terms:ir.ui.view,arch_db:website_planet_mobil.avis_page
msgid "@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n"
"    #wrap { font-family: 'Inter', sans-serif; }\n"
"\n"
"    /* ══════════════════════════════════════\n"
"       HERO\n"
"    ══════════════════════════════════════ */\n"
"    .pm-avis-hero {\n"
"        position: relative;\n"
"        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 40%, #db2777 100%);\n"
"        padding: 48px 40px 40px;\n"
"        overflow: hidden;\n"
"        text-align: center;\n"
"    }\n"
"    /* Formes décoratives flottantes */\n"
"    .pm-avis-hero::before {\n"
"        content: '';\n"
"        position: absolute;\n"
"        width: 500px; height: 500px;\n"
"        border-radius: 50%;\n"
"        background: rgba(255,255,255,0.06);\n"
"        top: -180px; right: -100px;\n"
"        pointer-events: none;\n"
"    }\n"
"    .pm-avis-hero::after {\n"
"        content: '';\n"
"        position: absolute;\n"
"        width: 320px; height: 320px;\n"
"        border-radius: 50%;\n"
"        background: rgba(255,255,255,0.05);\n"
"        bottom: -120px; left: -60px;\n"
"        pointer-events: none;\n"
"    }\n"
"    /* Barre blanche translucide en haut */\n"
"    .pm-avis-topbar {\n"
"        position: absolute; top: 0; left: 0; right: 0;\n"
"        height: 3px;\n"
"        background: rgba(255,255,255,0.35);\n"
"    }\n"
"    .pm-avis-hero-inner {\n"
"        position: relative; z-index: 2;\n"
"        max-width: 680px;\n"
"        margin: 0 auto;\n"
"        animation: pmFadeUp 0.8s ease both;\n"
"    }\n"
"    @keyframes pmFadeUp { from{opacity:0;transform:translateY(30px)} to{opacity:1;transform:translateY(0)} }\n"
"    .pm-avis-eyebrow {\n"
"        display: inline-flex;\n"
"        align-items: center;\n"
"        gap: 8px;\n"
"        background: rgba(255,255,255,0.15);\n"
"        border: 1px solid rgba(255,255,255,0.3);\n"
"        color: #fff;\n"
"        font-size: 0.75rem;\n"
"        font-weight: 700;\n"
"        letter-spacing: 0.14em;\n"
"        text-transform: uppercase;\n"
"        padding: 6px 16px;\n"
"        border-radius: 50px;\n"
"        margin-bottom: 24px;\n"
"        backdrop-filter: blur(8px);\n"
"    }\n"
"    .pm-avis-eyebrow-stars { display: flex; gap: 2px; }\n"
"    .pm-avis-eyebrow-stars i { color: #fde68a; font-size: 0.7rem; }\n"
"    .pm-avis-hero h1 {\n"
"        font-size: clamp(2rem, 4.5vw, 3.2rem);\n"
"        font-weight: 900;\n"
"        color: #fff;\n"
"        line-height: 1.1;\n"
"        margin: 0 0 16px;\n"
"    }\n"
"    .pm-avis-hero h1 span {\n"
"        background: linear-gradient(135deg, #fde68a, #fbbf24);\n"
"        -webkit-background-clip: text;\n"
"        -webkit-text-fill-color: transparent;\n"
"        background-clip: text;\n"
"    }\n"
"    .pm-avis-hero p {\n"
"        font-size: 1.05rem;\n"
"        color: rgba(255,255,255,0.72);\n"
"        line-height: 1.7;\n"
"        margin: 0 0 36px;\n"
"    }\n"
"    .pm-avis-hero-btn {\n"
"        display: inline-flex;\n"
"        align-items: center;\n"
"        gap: 10px;\n"
"        background: #fff;\n"
"        color: #4f46e5 !important;\n"
"        font-weight: 800;\n"
"        font-size: 0.9rem;\n"
"        padding: 13px 28px;\n"
"        border-radius: 50px;\n"
"        text-decoration: none !important;\n"
"        transition: transform 0.2s, box-shadow 0.2s;\n"
"        box-shadow: 0 6px 32px rgba(0,0,0,0.2);\n"
"    }\n"
"    .pm-avis-hero-btn:hover {\n"
"        transform: translateY(-2px);\n"
"        box-shadow: 0 12px 40px rgba(0,0,0,0.28);\n"
"        color: #4f46e5 !important;\n"
"    }\n"
"\n"
"    /* ══════════════════════════════════════\n"
"       STATS SECTION\n"
"    ══════════════════════════════════════ */\n"
"    .pm-avis-stats-section {\n"
"        background: #f8fafc;\n"
"        padding: 64px 40px;\n"
"        border-bottom: 1px solid #e2e8f0;\n"
"    }\n"
"    .pm-avis-stats-inner {\n"
"        max-width: 900px;\n"
"        margin: 0 auto;\n"
"        display: grid;\n"
"        grid-template-columns: auto 1fr;\n"
"        gap: 56px;\n"
"        align-items: center;\n"
"    }\n"
"    /* Score global */\n"
"    .pm-score-block { text-align: center; }\n"
"    .pm-score-big {\n"
"        font-size: 5rem;\n"
"        font-weight: 900;\n"
"        color: #0f172a;\n"
"        line-height: 1;\n"
"        margin-bottom: 8px;\n"
"    }\n"
"    .pm-score-stars-big {\n"
"        display: flex;\n"
"        justify-content: center;\n"
"        gap: 4px;\n"
"        margin-bottom: 8px;\n"
"    }\n"
"    .pm-score-stars-big i { color: #fbbf24; font-size: 1.4rem; }\n"
"    .pm-score-total {\n"
"        font-size: 0.82rem;\n"
"        color: #94a3b8;\n"
"        font-weight: 500;\n"
"    }\n"
"    /* Barres */\n"
"    .pm-bars-block { flex: 1; }\n"
"    .pm-bar-row {\n"
"        display: flex;\n"
"        align-items: center;\n"
"        gap: 12px;\n"
"        margin-bottom: 10px;\n"
"    }\n"
"    .pm-bar-row:last-child { margin-bottom: 0; }\n"
"    .pm-bar-label {\n"
"        display: flex;\n"
"        align-items: center;\n"
"        gap: 4px;\n"
"        font-size: 0.82rem;\n"
"        font-weight: 600;\n"
"        color: #475569;\n"
"        width: 36px;\n"
"        flex-shrink: 0;\n"
"        justify-content: flex-end;\n"
"    }\n"
"    .pm-bar-label i { color: #fbbf24; font-size: 0.75rem; }\n"
"    .pm-bar-track {\n"
"        flex: 1;\n"
"        height: 8px;\n"
"        background: #e2e8f0;\n"
"        border-radius: 99px;\n"
"        overflow: hidden;\n"
"    }\n"
"    .pm-bar-fill {\n"
"        height: 100%;\n"
"        border-radius: 99px;\n"
"        background: linear-gradient(90deg, #fbbf24, #f59e0b);\n"
"        width: 0%;\n"
"        transition: width 1s cubic-bezier(.4,0,.2,1);\n"
"    }\n"
"    .pm-bar-pct {\n"
"        font-size: 0.78rem;\n"
"        font-weight: 600;\n"
"        color: #94a3b8;\n"
"        width: 34px;\n"
"        flex-shrink: 0;\n"
"    }\n"
"    /* Message confirmation submit */\n"
"    .pm-success-msg {\n"
"        text-align: center;\n"
"        padding: 48px 24px;\n"
"    }\n"
"    .pm-success-icon {\n"
"        width: 72px; height: 72px;\n"
"        border-radius: 50%;\n"
"        background: linear-gradient(135deg, #22c55e, #16a34a);\n"
"        display: flex; align-items: center; justify-content: center;\n"
"        font-size: 1.8rem;\n"
"        color: #fff;\n"
"        margin: 0 auto 20px;\n"
"        animation: pmBounceIn 0.5s ease;\n"
"    }\n"
"    @keyframes pmBounceIn {\n"
"        0%   { transform: scale(0); opacity: 0; }\n"
"        60%  { transform: scale(1.15); }\n"
"        100% { transform: scale(1); opacity: 1; }\n"
"    }\n"
"    .pm-success-title {\n"
"        font-size: 1.5rem;\n"
"        font-weight: 800;\n"
"        color: #0f172a;\n"
"        margin-bottom: 10px;\n"
"    }\n"
"    .pm-success-text {\n"
"        font-size: 0.9rem;\n"
"        color: #64748b;\n"
"        line-height: 1.7;\n"
"    }\n"
"\n"
"    /* CTA écrire */\n"
"    .pm-write-block { text-align: center; }\n"
"    .pm-write-btn {\n"
"        display: inline-flex;\n"
"        flex-direction: column;\n"
"        align-items: center;\n"
"        gap: 8px;\n"
"        background: linear-gradient(135deg, #2563eb, #7c3aed);\n"
"        color: #fff !important;\n"
"        font-weight: 700;\n"
"        font-size: 0.9rem;\n"
"        padding: 20px 28px;\n"
"        border-radius: 20px;\n"
"        text-decoration: none !important;\n"
"        transition: transform 0.2s, box-shadow 0.2s;\n"
"        box-shadow: 0 6px 24px rgba(37,99,235,0.3);\n"
"    }\n"
"    .pm-write-btn:hover {\n"
"        transform: translateY(-3px);\n"
"        box-shadow: 0 12px 32px rgba(37,99,235,0.45);\n"
"        color: #fff !important;\n"
"    }\n"
"    .pm-write-btn .pm-write-icon {\n"
"        width: 44px; height: 44px;\n"
"        border-radius: 12px;\n"
"        background: rgba(255,255,255,0.15);\n"
"        display: flex; align-items: center; justify-content: center;\n"
"        font-size: 1.2rem;\n"
"    }\n"
"    .pm-write-btn span { font-size: 0.8rem; opacity: 0.8; font-weight: 500; }\n"
"\n"
"    /* ══════════════════════════════════════\n"
"       FILTRES\n"
"    ══════════════════════════════════════ */\n"
"    .pm-avis-filters {\n"
"        background: #fff;\n"
"        padding: 28px 40px;\n"
"        border-bottom: 1px solid #f1f5f9;\n"
"        position: sticky;\n"
"        top: 0;\n"
"        z-index: 50;\n"
"        box-shadow: 0 2px 12px rgba(0,0,0,0.04);\n"
"    }\n"
"    .pm-avis-filters-inner {\n"
"        max-width: 1200px;\n"
"        margin: 0 auto;\n"
"        display: flex;\n"
"        align-items: center;\n"
"        gap: 12px;\n"
"        flex-wrap: wrap;\n"
"    }\n"
"    .pm-filter-label {\n"
"        font-size: 0.8rem;\n"
"        font-weight: 700;\n"
"        color: #64748b;\n"
"        text-transform: uppercase;\n"
"        letter-spacing: 0.08em;\n"
"        margin-right: 4px;\n"
"    }\n"
"    .pm-filter-btn {\n"
"        display: inline-flex;\n"
"        align-items: center;\n"
"        gap: 6px;\n"
"        background: #f8fafc;\n"
"        border: 1.5px solid #e2e8f0;\n"
"        color: #475569;\n"
"        font-size: 0.82rem;\n"
"        font-weight: 600;\n"
"        padding: 8px 16px;\n"
"        border-radius: 50px;\n"
"        cursor: pointer;\n"
"        transition: all 0.2s;\n"
"        font-family: 'Inter', sans-serif;\n"
"    }\n"
"    .pm-filter-btn i { color: #fbbf24; }\n"
"    .pm-filter-btn:hover, .pm-filter-btn.active {\n"
"        background: #0f172a;\n"
"        border-color: #0f172a;\n"
"        color: #fff;\n"
"    }\n"
"    .pm-filter-btn.active i { color: #fbbf24; }\n"
"\n"
"    /* ══════════════════════════════════════\n"
"       GRILLE AVIS\n"
"    ══════════════════════════════════════ */\n"
"    .pm-avis-body {\n"
"        background: #f8fafc;\n"
"        padding: 56px 40px 80px;\n"
"    }\n"
"    .pm-avis-grid {\n"
"        display: grid;\n"
"        grid-template-columns: repeat(3, 1fr);\n"
"        gap: 20px;\n"
"        max-width: 1200px;\n"
"        margin: 0 auto;\n"
"    }\n"
"    .pm-avis-card {\n"
"        background: #fff;\n"
"        border-radius: 20px;\n"
"        padding: 28px;\n"
"        border: 1px solid #e2e8f0;\n"
"        transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;\n"
"        display: flex;\n"
"        flex-direction: column;\n"
"        gap: 14px;\n"
"        position: relative;\n"
"        overflow: hidden;\n"
"    }\n"
"    .pm-avis-card::after {\n"
"        content: '\\f10d';\n"
"        font-family: FontAwesome;\n"
"        position: absolute;\n"
"        top: 16px; right: 20px;\n"
"        font-size: 2.5rem;\n"
"        color: rgba(37,99,235,0.05);\n"
"        line-height: 1;\n"
"        pointer-events: none;\n"
"    }\n"
"    .pm-avis-card:hover {\n"
"        transform: translateY(-5px);\n"
"        box-shadow: 0 16px 40px rgba(0,0,0,0.08);\n"
"        border-color: #bfdbfe;\n"
"    }\n"
"    .pm-avis-card-head {\n"
"        display: flex;\n"
"        align-items: center;\n"
"        gap: 14px;\n"
"    }\n"
"    .pm-avis-avatar {\n"
"        width: 48px; height: 48px;\n"
"        border-radius: 50%;\n"
"        background: linear-gradient(135deg, #2563eb, #7c3aed);\n"
"        color: #fff;\n"
"        font-size: 1.1rem;\n"
"        font-weight: 800;\n"
"        display: flex; align-items: center; justify-content: center;\n"
"        flex-shrink: 0;\n"
"        letter-spacing: -0.02em;\n"
"    }\n"
"    .pm-avis-name {\n"
"        font-size: 0.95rem;\n"
"        font-weight: 700;\n"
"        color: #0f172a;\n"
"        margin-bottom: 2px;\n"
"    }\n"
"    .pm-avis-date {\n"
"        font-size: 0.75rem;\n"
"        color: #94a3b8;\n"
"    }\n"
"    .pm-avis-stars {\n"
"        display: flex;\n"
"        gap: 3px;\n"
"    }\n"
"    .pm-avis-stars i.fa-star { color: #fbbf24; font-size: 0.9rem; }\n"
"    .pm-avis-stars i.fa-star-o { color: #e2e8f0; font-size: 0.9rem; }\n"
"    .pm-avis-text {\n"
"        font-size: 0.875rem;\n"
"        color: #475569;\n"
"        line-height: 1.75;\n"
"        flex: 1;\n"
"        margin: 0;\n"
"    }\n"
"    .pm-avis-card-footer {\n"
"        display: flex;\n"
"        align-items: center;\n"
"        justify-content: space-between;\n"
"        flex-wrap: wrap;\n"
"        gap: 8px;\n"
"    }\n"
"    .pm-avis-product-tag {\n"
"        display: inline-flex;\n"
"        align-items: center;\n"
"        gap: 6px;\n"
"        background: #f1f5f9;\n"
"        color: #475569;\n"
"        font-size: 0.75rem;\n"
"        font-weight: 600;\n"
"        padding: 5px 12px;\n"
"        border-radius: 50px;\n"
"    }\n"
"    .pm-avis-product-tag i { color: #2563eb; font-size: 0.75rem; }\n"
"    .pm-avis-verified {\n"
"        display: flex;\n"
"        align-items: center;\n"
"        gap: 5px;\n"
"        font-size: 0.75rem;\n"
"        font-weight: 600;\n"
"        color: #16a34a;\n"
"    }\n"
"    /* Mise en avant — carte 5 étoiles */\n"
"    .pm-avis-card.featured {\n"
"        border-color: #fef08a;\n"
"        background: linear-gradient(135deg, #fffdf0 0%, #fff 60%);\n"
"    }\n"
"    .pm-avis-card.featured::before {\n"
"        content: '';\n"
"        position: absolute;\n"
"        top: 0; left: 0; right: 0;\n"
"        height: 2px;\n"
"        background: linear-gradient(90deg, #fbbf24, #f59e0b);\n"
"    }\n"
"\n"
"    /* ══════════════════════════════════════\n"
"       FORMULAIRE AVIS\n"
"    ══════════════════════════════════════ */\n"
"    .pm-avis-form-section {\n"
"        background: #fff;\n"
"        padding: 80px 40px;\n"
"        border-top: 1px solid #f1f5f9;\n"
"    }\n"
"    .pm-avis-form-inner {\n"
"        max-width: 680px;\n"
"        margin: 0 auto;\n"
"    }\n"
"    .pm-form-section-header {\n"
"        text-align: center;\n"
"        margin-bottom: 48px;\n"
"    }\n"
"    .pm-section-eyebrow {\n"
"        display: inline-block;\n"
"        font-size: 0.72rem;\n"
"        font-weight: 700;\n"
"        letter-spacing: 0.15em;\n"
"        text-transform: uppercase;\n"
"        color: #2563eb;\n"
"        background: #dbeafe;\n"
"        padding: 5px 14px;\n"
"        border-radius: 50px;\n"
"        margin-bottom: 14px;\n"
"    }\n"
"    .pm-form-section-title {\n"
"        font-size: clamp(1.5rem, 3vw, 2rem);\n"
"        font-weight: 800;\n"
"        color: #0f172a;\n"
"        margin: 0 0 10px;\n"
"    }\n"
"    .pm-form-section-sub {\n"
"        font-size: 0.9rem;\n"
"        color: #64748b;\n"
"    }\n"
"\n"
"    /* Carte formulaire */\n"
"    .pm-avis-form-card {\n"
"        background: #f8fafc;\n"
"        border-radius: 24px;\n"
"        border: 1px solid #e2e8f0;\n"
"        padding: 44px;\n"
"        position: relative;\n"
"        overflow: hidden;\n"
"    }\n"
"    .pm-avis-form-card::before {\n"
"        content: '';\n"
"        position: absolute;\n"
"        top: 0; left: 0; right: 0;\n"
"        height: 3px;\n"
"        background: linear-gradient(90deg, #fbbf24, #f59e0b);\n"
"    }\n"
"\n"
"    /* Star picker interactif */\n"
"    .pm-star-picker-wrap {\n"
"        margin-bottom: 28px;\n"
"    }\n"
"    .pm-star-picker-label {\n"
"        font-size: 0.8rem;\n"
"        font-weight: 700;\n"
"        color: #374151;\n"
"        margin-bottom: 12px;\n"
"        display: block;\n"
"        letter-spacing: 0.02em;\n"
"    }\n"
"    .pm-star-picker {\n"
"        display: flex;\n"
"        gap: 8px;\n"
"    }\n"
"    .pm-star-btn {\n"
"        font-size: 2rem;\n"
"        color: #e2e8f0;\n"
"        cursor: pointer;\n"
"        transition: transform 0.15s, color 0.15s;\n"
"        line-height: 1;\n"
"        background: none;\n"
"        border: none;\n"
"        padding: 0;\n"
"        font-family: FontAwesome;\n"
"    }\n"
"    .pm-star-btn:hover,\n"
"    .pm-star-btn.active { color: #fbbf24; transform: scale(1.2); }\n"
"    .pm-star-hint {\n"
"        font-size: 0.78rem;\n"
"        color: #94a3b8;\n"
"        margin-top: 8px;\n"
"        min-height: 18px;\n"
"        font-style: italic;\n"
"    }\n"
"\n"
"    /* Champs */\n"
"    .pm-avis-form-row {\n"
"        display: grid;\n"
"        grid-template-columns: 1fr 1fr;\n"
"        gap: 16px;\n"
"    }\n"
"    .pm-avis-form-group { margin-bottom: 20px; }\n"
"    .pm-avis-form-label {\n"
"        display: block;\n"
"        font-size: 0.8rem;\n"
"        font-weight: 600;\n"
"        color: #374151;\n"
"        margin-bottom: 7px;\n"
"        letter-spacing: 0.02em;\n"
"    }\n"
"    .pm-avis-form-label .req { color: #ef4444; margin-left: 2px; }\n"
"    .pm-avis-input,\n"
"    .pm-avis-textarea {\n"
"        width: 100%;\n"
"        background: #fff;\n"
"        border: 1.5px solid #e2e8f0;\n"
"        border-radius: 10px;\n"
"        font-size: 0.9rem;\n"
"        font-family: 'Inter', sans-serif;\n"
"        color: #0f172a;\n"
"        padding: 12px 16px;\n"
"        outline: none;\n"
"        transition: border-color 0.2s, box-shadow 0.2s;\n"
"        box-sizing: border-box;\n"
"    }\n"
"    .pm-avis-input::placeholder,\n"
"    .pm-avis-textarea::placeholder { color: #c0ccd8; }\n"
"    .pm-avis-input:focus,\n"
"    .pm-avis-textarea:focus {\n"
"        border-color: #fbbf24;\n"
"        box-shadow: 0 0 0 3px rgba(251,191,36,0.12);\n"
"    }\n"
"    .pm-avis-textarea { resize: vertical; min-height: 120px; }\n"
"    .pm-hidden-rating {\n"
"        display: none;\n"
"    }\n"
"    .pm-avis-submit {\n"
"        display: flex;\n"
"        align-items: center;\n"
"        justify-content: center;\n"
"        gap: 10px;\n"
"        background: linear-gradient(135deg, #fbbf24, #f59e0b);\n"
"        color: #0f172a;\n"
"        font-weight: 800;\n"
"        font-size: 0.95rem;\n"
"        padding: 14px 32px;\n"
"        border-radius: 50px;\n"
"        border: none;\n"
"        cursor: pointer;\n"
"        width: 100%;\n"
"        margin-top: 8px;\n"
"        font-family: 'Inter', sans-serif;\n"
"        transition: transform 0.2s, box-shadow 0.2s;\n"
"        box-shadow: 0 6px 24px rgba(251,191,36,0.35);\n"
"    }\n"
"    .pm-avis-submit:hover {\n"
"        transform: translateY(-2px);\n"
"        box-shadow: 0 12px 32px rgba(251,191,36,0.5);\n"
"    }\n"
"\n"
"    /* ══════════════════════════════════════\n"
"       RESPONSIVE\n"
"    ══════════════════════════════════════ */\n"
"    @media (max-width: 1024px) {\n"
"        .pm-avis-grid { grid-template-columns: repeat(2, 1fr); }\n"
"        .pm-avis-stats-inner { grid-template-columns: auto 1fr; gap: 36px; }\n"
"        .pm-write-block { grid-column: 1 / -1; justify-self: center; }\n"
"    }\n"
"    @media (max-width: 768px) {\n"
"        .pm-avis-hero { padding: 36px 24px 28px; }\n"
"        .pm-avis-stats-section { padding: 48px 24px; }\n"
"        .pm-avis-stats-inner { grid-template-columns: 1fr; gap: 32px; text-align: center; }\n"
"        .pm-avis-filters { padding: 18px 24px; }\n"
"        .pm-avis-body { padding: 40px 24px 60px; }\n"
"        .pm-avis-grid { grid-template-columns: 1fr; }\n"
"        .pm-avis-form-section { padding: 60px 24px; }\n"
"        .pm-avis-form-card { padding: 32px 24px; }\n"
"        .pm-avis-form-row { grid-template-columns: 1fr; }\n"
"        .pm-score-block { justify-self: center; }\n"
"    }"
