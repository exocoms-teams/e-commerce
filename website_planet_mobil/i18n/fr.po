"\n"
"                    /* ══════════════════════════════════════\n"
"                       PROMO BANNER\n"
"                    ══════════════════════════════════════ */\n"
"                    .pm-promo {\n"
"                        margin: 0 40px 0;\n"
"                        border-radius: 28px;\n"
"                        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #312e81 100%);\n"
"                        overflow: hidden;\n"
"                        position: relative;\n"
"                        padding: 70px 70px;\n"
"                    }\n"
"                    /* Cercles décoratifs */\n"
"                    .pm-promo::before, .pm-promo::after {\n"
"                        content: '';\n"
"                        position: absolute;\n"
"                        border-radius: 50%;\n"
"                        background: rgba(255,255,255,0.04);\n"
"                    }\n"
"                    .pm-promo::before { width: 500px; height: 500px; top: -200px; right: -100px; }\n"
"                    .pm-promo::after  { width: 300px; height: 300px; bottom: -100px; left: 40%; }\n"
"                    .pm-promo-inner {\n"
"                        position: relative; z-index: 2;\n"
"                        display: flex;\n"
"                        align-items: center;\n"
"                        justify-content: space-between;\n"
"                        gap: 40px;\n"
"                        flex-wrap: wrap;\n"
"                    }\n"
"                    .pm-promo-left {}\n"
"                    .pm-promo-tag {\n"
"                        display: inline-flex; align-items: center; gap: 8px;\n"
"                        background: rgba(251,191,36,0.15);\n"
"                        border: 1px solid rgba(251,191,36,0.35);\n"
"                        color: #fbbf24;\n"
"                        font-size: 0.75rem;\n"
"                        font-weight: 700;\n"
"                        letter-spacing: 0.12em;\n"
"                        text-transform: uppercase;\n"
"                        padding: 6px 14px;\n"
"                        border-radius: 50px;\n"
"                        margin-bottom: 20px;\n"
"                    }\n"
"                    .pm-promo-title {\n"
"                        font-size: clamp(1.8rem, 3.5vw, 2.8rem);\n"
"                        font-weight: 900;\n"
"                        color: #fff;\n"
"                        margin: 0 0 12px;\n"
"                        line-height: 1.1;\n"
"                    }\n"
"                    .pm-promo-title em {\n"
"                        font-style: normal;\n"
"                        color: #fbbf24;\n"
"                    }\n"
"                    .pm-promo-sub {\n"
"                        font-size: 1rem;\n"
"                        color: rgba(255,255,255,0.6);\n"
"                        margin: 0;\n"
"                    }\n"
"                    .pm-promo-right {\n"
"                        text-align: center;\n"
"                        flex-shrink: 0;\n"
"                    }\n"
"                    .pm-promo-badge {\n"
"                        display: flex;\n"
"                        flex-direction: column;\n"
"                        align-items: center;\n"
"                        justify-content: center;\n"
"                        width: 130px; height: 130px;\n"
"                        border-radius: 50%;\n"
"                        background: linear-gradient(135deg, #fbbf24, #f59e0b);\n"
"                        color: #0f172a;\n"
"                        margin-bottom: 24px;\n"
"                        box-shadow: 0 0 0 8px rgba(251,191,36,0.15), 0 0 0 16px rgba(251,191,36,0.07);\n"
"                        animation: pmSpin 10s linear infinite;\n"
"                    }\n"
"                    @keyframes pmSpin {\n"
"                        from { box-shadow: 0 0 0 8px rgba(251,191,36,0.15), 0 0 0 16px rgba(251,191,36,0.07); }\n"
"                        50%  { box-shadow: 0 0 0 12px rgba(251,191,36,0.25), 0 0 0 22px rgba(251,191,36,0.1); }\n"
"                        to   { box-shadow: 0 0 0 8px rgba(251,191,36,0.15), 0 0 0 16px rgba(251,191,36,0.07); }\n"
"                    }\n"
"                    .pm-promo-badge-pct  { font-size: 2.6rem; font-weight: 900; line-height: 1; }\n"
"                    .pm-promo-badge-text { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.05em; }\n"
"                    .pm-btn-promo {\n"
"                        display: inline-flex; align-items: center; gap: 10px;\n"
"                        background: #fbbf24;\n"
"                        color: #0f172a !important;\n"
"                        font-weight: 800;\n"
"                        font-size: 0.95rem;\n"
"                        padding: 15px 32px;\n"
"                        border-radius: 50px;\n"
"                        text-decoration: none !important;\n"
"                        transition: transform 0.2s, box-shadow 0.2s;\n"
"                        box-shadow: 0 8px 28px rgba(251,191,36,0.4);\n"
"                    }\n"
"                    .pm-btn-promo:hover {\n"
"                        transform: translateY(-3px);\n"
"                        box-shadow: 0 14px 36px rgba(251,191,36,0.55);\n"
"                        color: #0f172a !important;\n"
"                    }\n"
"\n"
"                    /* ══════════════════════════════════════\n"
"                       AVIS\n"
"                    ══════════════════════════════════════ */\n"
"                    .pm-avis {\n"
"                        padding: 48px 40px;\n"
"                        background: #f8fafc;\n"
"                    }\n"
"                    .pm-avis-header {\n"
"                        display: flex;\n"
"                        align-items: flex-end;\n"
"                        justify-content: space-between;\n"
"                        max-width: 1200px;\n"
"                        margin: 0 auto 40px;\n"
"                        flex-wrap: wrap;\n"
"                        gap: 20px;\n"
"                    }\n"
"                    .pm-avis-score {\n"
"                        display: flex;\n"
"                        align-items: center;\n"
"                        gap: 16px;\n"
"                        margin-top: 16px;\n"
"                    }\n"
"                    .pm-score-num {\n"
"                        font-size: 3.5rem;\n"
"                        font-weight: 900;\n"
"                        color: #0f172a;\n"
"                        line-height: 1;\n"
"                    }\n"
"                    .pm-score-stars { display: flex; gap: 3px; margin-bottom: 5px; }\n"
"                    .pm-score-stars i { color: #fbbf24; font-size: 1rem; }\n"
"                    .pm-score-count { font-size: 0.83rem; color: #64748b; }\n"
"                    .pm-avis-voir-tout {\n"
"                        display: inline-flex; align-items: center; gap: 8px;\n"
"                        color: #2563eb !important;\n"
"                        font-weight: 600;\n"
"                        font-size: 0.9rem;\n"
"                        text-decoration: none !important;\n"
"                        padding: 10px 20px;\n"
"                        border: 1.5px solid #2563eb;\n"
"                        border-radius: 50px;\n"
"                        transition: all 0.2s;\n"
"                    }\n"
"                    .pm-avis-voir-tout:hover {\n"
"                        background: #2563eb;\n"
"                        color: #fff !important;\n"
"                    }\n"
"                    .pm-avis-track-wrap {\n"
"                        overflow: hidden;\n"
"                        position: relative;\n"
"                        max-width: 1200px;\n"
"                        margin: 0 auto;\n"
"                    }\n"
"                    .pm-avis-track-wrap::before,\n"
"                    .pm-avis-track-wrap::after {\n"
"                        content: '';\n"
"                        position: absolute;\n"
"                        top: 0; bottom: 0;\n"
"                        width: 80px;\n"
"                        z-index: 2;\n"
"                        pointer-events: none;\n"
"                    }\n"
"                    .pm-avis-track-wrap::before { left: 0; background: linear-gradient(to right, #f8fafc, transparent); }\n"
"                    .pm-avis-track-wrap::after  { right: 0; background: linear-gradient(to left, #f8fafc, transparent); }\n"
"                    .pm-avis-track {\n"
"                        display: flex;\n"
"                        gap: 20px;\n"
"                        padding: 12px 0;\n"
"                        overflow-x: auto;\n"
"                        scrollbar-width: none;\n"
"                        -ms-overflow-style: none;\n"
"                    }\n"
"                    .pm-avis-track::-webkit-scrollbar { display: none; }\n"
"                    .pm-avis-card {\n"
"                        flex: 0 0 320px;\n"
"                        background: #fff;\n"
"                        border-radius: 20px;\n"
"                        padding: 28px;\n"
"                        border: 1px solid #e2e8f0;\n"
"                        transition: transform 0.3s, box-shadow 0.3s;\n"
"                    }\n"
"                    .pm-avis-card:hover {\n"
"                        transform: translateY(-4px);\n"
"                        box-shadow: 0 12px 32px rgba(0,0,0,0.08);\n"
"                    }\n"
"                    .pm-avis-card-head {\n"
"                        display: flex;\n"
"                        align-items: center;\n"
"                        gap: 14px;\n"
"                        margin-bottom: 16px;\n"
"                    }\n"
"                    .pm-avis-avatar {\n"
"                        width: 46px; height: 46px;\n"
"                        border-radius: 50%;\n"
"                        background: linear-gradient(135deg, #2563eb, #7c3aed);\n"
"                        color: #fff;\n"
"                        font-size: 1.1rem;\n"
"                        font-weight: 800;\n"
"                        display: flex; align-items: center; justify-content: center;\n"
"                        flex-shrink: 0;\n"
"                    }\n"
"                    .pm-avis-name { font-weight: 700; color: #0f172a; font-size: 0.95rem; }\n"
"                    .pm-avis-date { font-size: 0.78rem; color: #94a3b8; }\n"
"                    .pm-avis-stars { display: flex; gap: 3px; margin-bottom: 14px; }\n"
"                    .pm-avis-stars i { color: #fbbf24; font-size: 0.9rem; }\n"
"                    .pm-avis-stars i.empty { color: #e2e8f0; }\n"
"                    .pm-avis-text {\n"
"                        font-size: 0.875rem;\n"
"                        color: #475569;\n"
"                        line-height: 1.7;\n"
"                        margin: 0 0 14px;\n"
"                    }\n"
"                    .pm-avis-product {\n"
"                        display: inline-flex; align-items: center; gap: 6px;\n"
"                        background: #f1f5f9;\n"
"                        color: #475569;\n"
"                        font-size: 0.78rem;\n"
"                        padding: 5px 12px;\n"
"                        border-radius: 50px;\n"
"                        margin-bottom: 12px;\n"
"                    }\n"
"                    .pm-avis-verified {\n"
"                        display: flex; align-items: center; gap: 6px;\n"
"                        font-size: 0.78rem;\n"
"                        color: #16a34a;\n"
"                        font-weight: 600;\n"
"                    }\n"
"                    .pm-avis-cta {\n"
"                        text-align: center;\n"
"                        margin-top: 40px;\n"
"                    }\n"
"\n"
"                    /* ══════════════════════════════════════\n"
"                       NEWSLETTER\n"
"                    ══════════════════════════════════════ */\n"
"                    .pm-newsletter {\n"
"                        padding: 48px 40px;\n"
"                        background: #0f172a;\n"
"                        position: relative;\n"
"                        overflow: hidden;\n"
"                    }\n"
"                    .pm-newsletter::before {\n"
"                        content: '';\n"
"                        position: absolute;\n"
"                        width: 600px; height: 600px;\n"
"                        border-radius: 50%;\n"
"                        background: rgba(37,99,235,0.08);\n"
"                        top: -200px; right: -100px;\n"
"                    }\n"
"                    .pm-newsletter-inner {\n"
"                        position: relative; z-index: 2;\n"
"                        max-width: 600px;\n"
"                        margin: 0 auto;\n"
"                        text-align: center;\n"
"                    }\n"
"                    .pm-newsletter-title {\n"
"                        font-size: clamp(1.6rem, 3vw, 2.2rem);\n"
"                        font-weight: 800;\n"
"                        color: #fff;\n"
"                        margin-bottom: 12px;\n"
"                    }\n"
"                    .pm-newsletter-sub {\n"
"                        color: rgba(255,255,255,0.55);\n"
"                        font-size: 0.95rem;\n"
"                        margin-bottom: 36px;\n"
"                        line-height: 1.7;\n"
"                    }\n"
"                    .pm-newsletter-form {\n"
"                        display: flex;\n"
"                        gap: 12px;\n"
"                        max-width: 480px;\n"
"                        margin: 0 auto;\n"
"                    }\n"
"                    .pm-newsletter-input {\n"
"                        flex: 1;\n"
"                        background: rgba(255,255,255,0.08);\n"
"                        border: 1px solid rgba(255,255,255,0.15);\n"
"                        color: #fff;\n"
"                        font-size: 0.9rem;\n"
"                        padding: 14px 20px;\n"
"                        border-radius: 50px;\n"
"                        outline: none;\n"
"                        transition: border-color 0.2s;\n"
"                    }\n"
"                    .pm-newsletter-input::placeholder { color: rgba(255,255,255,0.35); }\n"
"                    .pm-newsletter-input:focus { border-color: rgba(99,179,237,0.5); }\n"
"                    .pm-newsletter-btn {\n"
"                        display: inline-flex; align-items: center; gap: 8px;\n"
"                        background: linear-gradient(135deg, #2563eb, #7c3aed);\n"
"                        color: #fff !important;\n"
"                        font-weight: 700;\n"
"                        font-size: 0.9rem;\n"
"                        padding: 14px 26px;\n"
"                        border-radius: 50px;\n"
"                        text-decoration: none !important;\n"
"                        transition: transform 0.2s, box-shadow 0.2s;\n"
"                        box-shadow: 0 6px 20px rgba(37,99,235,0.4);\n"
"                        border: none; cursor: pointer;\n"
"                        white-space: nowrap;\n"
"                    }\n"
"                    .pm-newsletter-btn:hover {\n"
"                        transform: translateY(-2px);\n"
"                        box-shadow: 0 10px 28px rgba(37,99,235,0.55);\n"
"                    }\n"
"\n"
"                    /* ══════════════════════════════════════\n"
"                       RESPONSIVE\n"
"                    ══════════════════════════════════════ */\n"
"                    @media (max-width: 1100px) {\n"
"                        .pm-features-grid { grid-template-columns: repeat(2, 1fr); }\n"
"                        .pm-cat-grid { grid-template-columns: 1fr 1fr; grid-template-rows: 200px 200px 200px; }\n"
"                        .pm-cat-card:first-child { grid-row: span 1; }\n"
"                    }\n"
"                    @media (max-width: 768px) {\n"
"                        .pm-hero-content { padding: 0 28px; }\n"
"                        .pm-hero-indicators, .pm-scroll-hint { left: 28px; right: 28px; }\n"
"                        .pm-features { padding: 60px 24px; }\n"
"                        .pm-features-grid { grid-template-columns: 1fr; }\n"
"                        .pm-categories { padding: 60px 24px; }\n"
"                        .pm-cat-grid { grid-template-columns: 1fr; grid-template-rows: none; }\n"
"                        .pm-cat-card { height: 200px; }\n"
"                        .pm-promo { margin: 0 24px; padding: 48px 32px; }\n"
"                        .pm-promo-inner { flex-direction: column; text-align: center; }\n"
"                        .pm-promo-badge { margin: 0 auto 24px; }\n"
"                        .pm-avis { padding: 60px 24px; }\n"
"                        .pm-newsletter { padding: 60px 24px; }\n"
"                        .pm-newsletter-form { flex-direction: column; }\n"
"                    }"
msgstr ""

