#. module: website_planet_mobil
#: model_terms:ir.ui.view,arch_db:website_planet_mobil.footer
msgid "/* ══════════════════════════════════════\n"
"       RESET ODOO\n"
"    ══════════════════════════════════════ */\n"
"    .o_footer { background: #0a0f1e !important; }\n"
"    .o_footer_copyright { display: none !important; }\n"
"\n"
"    /* ══════════════════════════════════════\n"
"       FOOTER PRINCIPAL\n"
"    ══════════════════════════════════════ */\n"
"    .pm-footer {\n"
"        background: #0a0f1e;\n"
"        font-family: 'Inter', -apple-system, sans-serif;\n"
"        width: 100%;\n"
"        box-sizing: border-box;\n"
"        position: relative;\n"
"        overflow: hidden;\n"
"    }\n"
"\n"
"    /* Ligne dégradée animée en haut */\n"
"    .pm-footer-topbar {\n"
"        height: 3px;\n"
"        background: linear-gradient(90deg, #2563eb, #7c3aed, #2563eb);\n"
"        background-size: 200% 100%;\n"
"        animation: pmGradientMove 4s linear infinite;\n"
"    }\n"
"    @keyframes pmGradientMove {\n"
"        0%   { background-position: 0% 0%; }\n"
"        100% { background-position: 200% 0%; }\n"
"    }\n"
"\n"
"    /* Cercles décoratifs d'arrière-plan */\n"
"    .pm-footer::before {\n"
"        content: '';\n"
"        position: absolute;\n"
"        width: 600px; height: 600px;\n"
"        border-radius: 50%;\n"
"        background: rgba(37,99,235,0.04);\n"
"        top: -200px; right: -150px;\n"
"        pointer-events: none;\n"
"    }\n"
"    .pm-footer::after {\n"
"        content: '';\n"
"        position: absolute;\n"
"        width: 400px; height: 400px;\n"
"        border-radius: 50%;\n"
"        background: rgba(124,58,237,0.04);\n"
"        bottom: 60px; left: -100px;\n"
"        pointer-events: none;\n"
"    }\n"
"\n"
"    /* ── Bandeau confiance ── */\n"
"    .pm-footer-trust {\n"
"        position: relative; z-index: 2;\n"
"        display: flex;\n"
"        align-items: center;\n"
"        justify-content: center;\n"
"        gap: 0;\n"
"        border-bottom: 1px solid rgba(255,255,255,0.06);\n"
"        max-width: 1200px;\n"
"        margin: 0 auto;\n"
"        padding: 0 40px;\n"
"    }\n"
"    .pm-trust-item {\n"
"        display: flex;\n"
"        align-items: center;\n"
"        gap: 12px;\n"
"        padding: 22px 32px;\n"
"        border-right: 1px solid rgba(255,255,255,0.06);\n"
"        flex: 1;\n"
"        transition: background 0.25s;\n"
"    }\n"
"    .pm-trust-item:last-child { border-right: none; }\n"
"    .pm-trust-item:hover { background: rgba(255,255,255,0.03); }\n"
"    .pm-trust-icon {\n"
"        width: 40px; height: 40px;\n"
"        border-radius: 10px;\n"
"        display: flex; align-items: center; justify-content: center;\n"
"        font-size: 1rem;\n"
"        flex-shrink: 0;\n"
"    }\n"
"    .pm-trust-item:nth-child(1) .pm-trust-icon { background: rgba(37,99,235,0.15); color: #63b3ed; }\n"
"    .pm-trust-item:nth-child(2) .pm-trust-icon { background: rgba(22,163,74,0.15); color: #4ade80; }\n"
"    .pm-trust-item:nth-child(3) .pm-trust-icon { background: rgba(251,191,36,0.15); color: #fbbf24; }\n"
"    .pm-trust-item:nth-child(4) .pm-trust-icon { background: rgba(236,72,153,0.15); color: #f472b6; }\n"
"    .pm-trust-label {\n"
"        font-size: 0.82rem;\n"
"        font-weight: 700;\n"
"        color: #e2e8f0;\n"
"        margin-bottom: 2px;\n"
"    }\n"
"    .pm-trust-sub {\n"
"        font-size: 0.74rem;\n"
"        color: rgba(255,255,255,0.4);\n"
"    }\n"
"\n"
"    /* ── Grille principale ── */\n"
"    .pm-footer-body {\n"
"        position: relative; z-index: 2;\n"
"        max-width: 1200px;\n"
"        margin: 0 auto;\n"
"        padding: 56px 40px 48px;\n"
"        display: grid;\n"
"        grid-template-columns: 2fr 1fr 1fr 1fr;\n"
"        gap: 48px;\n"
"        align-items: start;\n"
"    }\n"
"\n"
"    /* Colonne 1 : Brand */\n"
"    .pm-footer-brand {}\n"
"    .pm-footer-logo {\n"
"        display: inline-flex;\n"
"        align-items: center;\n"
"        gap: 10px;\n"
"        margin-bottom: 20px;\n"
"        text-decoration: none !important;\n"
"    }\n"
"    .pm-footer-logo-icon {\n"
"        width: 40px; height: 40px;\n"
"        border-radius: 10px;\n"
"        background: linear-gradient(135deg, #2563eb, #7c3aed);\n"
"        display: flex; align-items: center; justify-content: center;\n"
"        font-size: 1.1rem;\n"
"        flex-shrink: 0;\n"
"    }\n"
"    .pm-footer-logo-text {\n"
"        font-size: 1.2rem;\n"
"        font-weight: 900;\n"
"        letter-spacing: -0.02em;\n"
"        line-height: 1;\n"
"    }\n"
"    .pm-footer-logo-text .pm-blue { color: #63b3ed; }\n"
"    .pm-footer-logo-text .pm-white { color: #fff; }\n"
"    .pm-footer-desc {\n"
"        font-size: 0.875rem;\n"
"        color: rgba(255,255,255,0.5);\n"
"        line-height: 1.75;\n"
"        margin: 0 0 28px;\n"
"    }\n"
"    .pm-footer-desc strong { color: rgba(255,255,255,0.8); font-weight: 600; }\n"
"\n"
"    /* Réseaux sociaux */\n"
"    .pm-footer-social {\n"
"        display: flex;\n"
"        gap: 10px;\n"
"    }\n"
"    .pm-social-btn {\n"
"        width: 40px; height: 40px;\n"
"        border-radius: 10px;\n"
"        background: rgba(255,255,255,0.06);\n"
"        border: 1px solid rgba(255,255,255,0.08);\n"
"        display: flex; align-items: center; justify-content: center;\n"
"        color: rgba(255,255,255,0.6) !important;\n"
"        text-decoration: none !important;\n"
"        font-size: 0.95rem;\n"
"        transition: all 0.25s ease;\n"
"    }\n"
"    .pm-social-btn:hover {\n"
"        transform: translateY(-3px);\n"
"        border-color: transparent;\n"
"    }\n"
"    .pm-social-btn.fb:hover  { background: #1877f2; color: #fff !important; }\n"
"    .pm-social-btn.tw:hover  { background: #1da1f2; color: #fff !important; }\n"
"    .pm-social-btn.ig:hover  { background: linear-gradient(135deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888); color: #fff !important; }\n"
"    .pm-social-btn.yt:hover  { background: #ff0000; color: #fff !important; }\n"
"\n"
"    /* Colonnes liens */\n"
"    .pm-footer-col {}\n"
"    .pm-footer-col-title {\n"
"        font-size: 0.72rem;\n"
"        font-weight: 700;\n"
"        letter-spacing: 0.14em;\n"
"        text-transform: uppercase;\n"
"        color: rgba(255,255,255,0.9);\n"
"        margin-bottom: 20px;\n"
"        position: relative;\n"
"        padding-bottom: 12px;\n"
"    }\n"
"    .pm-footer-col-title::after {\n"
"        content: '';\n"
"        position: absolute;\n"
"        left: 0; bottom: 0;\n"
"        width: 24px; height: 2px;\n"
"        border-radius: 2px;\n"
"        background: linear-gradient(90deg, #2563eb, #7c3aed);\n"
"    }\n"
"    .pm-footer-links {\n"
"        list-style: none;\n"
"        padding: 0; margin: 0;\n"
"        display: flex;\n"
"        flex-direction: column;\n"
"        gap: 12px;\n"
"    }\n"
"    .pm-footer-links li a {\n"
"        display: inline-flex;\n"
"        align-items: center;\n"
"        gap: 9px;\n"
"        font-size: 0.875rem;\n"
"        color: rgba(255,255,255,0.5) !important;\n"
"        text-decoration: none !important;\n"
"        transition: color 0.2s, gap 0.2s;\n"
"        line-height: 1;\n"
"    }\n"
"    .pm-footer-links li a .fa {\n"
"        font-size: 0.8rem;\n"
"        width: 14px;\n"
"        text-align: center;\n"
"        color: rgba(255,255,255,0.25) !important;\n"
"        transition: color 0.2s;\n"
"        flex-shrink: 0;\n"
"    }\n"
"    .pm-footer-links li a:hover {\n"
"        color: #fff !important;\n"
"        gap: 12px;\n"
"    }\n"
"    .pm-footer-links li a:hover .fa {\n"
"        color: #63b3ed !important;\n"
"    }\n"
"\n"
"    /* Contact spécial */\n"
"    .pm-contact-item {\n"
"        display: flex;\n"
"        align-items: flex-start;\n"
"        gap: 12px;\n"
"        margin-bottom: 16px;\n"
"    }\n"
"    .pm-contact-item:last-child { margin-bottom: 0; }\n"
"    .pm-contact-icon {\n"
"        width: 32px; height: 32px;\n"
"        border-radius: 8px;\n"
"        background: rgba(255,255,255,0.06);\n"
"        display: flex; align-items: center; justify-content: center;\n"
"        font-size: 0.8rem;\n"
"        color: #63b3ed;\n"
"        flex-shrink: 0;\n"
"        margin-top: 1px;\n"
"    }\n"
"    .pm-contact-label {\n"
"        font-size: 0.72rem;\n"
"        color: rgba(255,255,255,0.35);\n"
"        font-weight: 600;\n"
"        text-transform: uppercase;\n"
"        letter-spacing: 0.08em;\n"
"        margin-bottom: 3px;\n"
"    }\n"
"    .pm-contact-value {\n"
"        font-size: 0.875rem;\n"
"        color: rgba(255,255,255,0.7);\n"
"        text-decoration: none !important;\n"
"        transition: color 0.2s;\n"
"        line-height: 1.4;\n"
"        display: block;\n"
"    }\n"
"    a.pm-contact-value:hover { color: #63b3ed !important; }\n"
"\n"
"    /* ── Bloc paiement style alternate.de ── */\n"
"    .pm-footer-payment {\n"
"        position: relative; z-index: 2;\n"
"        border-top: 1px solid rgba(255,255,255,0.06);\n"
"        padding: 32px 40px;\n"
"        text-align: center;\n"
"    }\n"
"    .pm-payment-title {\n"
"        font-size: 1rem;\n"
"        font-weight: 700;\n"
"        color: rgba(255,255,255,0.6);\n"
"        margin-bottom: 28px;\n"
"        text-transform: uppercase;\n"
"        letter-spacing: 0.12em;\n"
"    }\n"
"    .pm-payment-logos {\n"
"        display: flex;\n"
"        align-items: center;\n"
"        justify-content: center;\n"
"        gap: 24px;\n"
"        flex-wrap: wrap;\n"
"    }\n"
"    .pm-payment-logo {\n"
"        background: rgba(255,255,255,0.96);\n"
"        border-radius: 10px;\n"
"        padding: 0 24px;\n"
"        display: flex;\n"
"        align-items: center;\n"
"        justify-content: center;\n"
"        height: 60px;\n"
"        min-width: 110px;\n"
"        box-sizing: border-box;\n"
"        transition: opacity 0.2s, box-shadow 0.2s;\n"
"    }\n"
"    .pm-payment-logo:hover { opacity: 0.85; box-shadow: 0 4px 14px rgba(0,0,0,0.25); }\n"
"    .pm-payment-logo img {\n"
"        height: 38px;\n"
"        width: auto;\n"
"        display: block;\n"
"    }\n"
"    .pm-payment-logo.mc { padding: 0 16px; }\n"
"    .pm-payment-logo.mc img { height: 44px; }\n"
"\n"
"    /* ── Barre de fond ── */\n"
"    .pm-footer-bottom {\n"
"        position: relative; z-index: 2;\n"
"        border-top: 1px solid rgba(255,255,255,0.06);\n"
"    }\n"
"    .pm-footer-bottom-inner {\n"
"        max-width: 1200px;\n"
"        margin: 0 auto;\n"
"        padding: 20px 40px;\n"
"        display: flex;\n"
"        align-items: center;\n"
"        justify-content: space-between;\n"
"        flex-wrap: wrap;\n"
"        gap: 16px;\n"
"    }\n"
"    .pm-footer-copy {\n"
"        font-size: 0.78rem;\n"
"        color: rgba(255,255,255,0.3);\n"
"    }\n"
"    .pm-footer-copy span { color: rgba(255,255,255,0.5); }\n"
"    .pm-footer-bottom-links {\n"
"        display: flex;\n"
"        align-items: center;\n"
"        gap: 24px;\n"
"    }\n"
"    .pm-footer-bottom-links a {\n"
"        font-size: 0.78rem;\n"
"        color: rgba(255,255,255,0.35) !important;\n"
"        text-decoration: none !important;\n"
"        transition: color 0.2s;\n"
"    }\n"
"    .pm-footer-bottom-links a:hover { color: rgba(255,255,255,0.7) !important; }\n"
"    .pm-footer-bottom-sep {\n"
"        width: 1px; height: 12px;\n"
"        background: rgba(255,255,255,0.1);\n"
"    }\n"
"    /* Logos paiement */\n"
"    .pm-payment-badges {\n"
"        display: flex;\n"
"        align-items: center;\n"
"        gap: 8px;\n"
"    }\n"
"    .pm-payment-badge {\n"
"        background: rgba(255,255,255,0.07);\n"
"        border: 1px solid rgba(255,255,255,0.1);\n"
"        border-radius: 6px;\n"
"        padding: 4px 10px;\n"
"        font-size: 0.72rem;\n"
"        font-weight: 700;\n"
"        color: rgba(255,255,255,0.45);\n"
"        letter-spacing: 0.04em;\n"
"        display: flex;\n"
"        align-items: center;\n"
"        gap: 5px;\n"
"    }\n"
"    .pm-payment-badge .fa { color: rgba(255,255,255,0.5); font-size: 0.9rem; }\n"
"\n"
"    /* ══ RESPONSIVE ══ */\n"
"    @media (max-width: 1024px) {\n"
"        .pm-footer-body { grid-template-columns: 1.5fr 1fr 1fr; gap: 36px; }\n"
"        .pm-footer-brand { grid-column: 1 / -1; }\n"
"        .pm-footer-trust { flex-wrap: wrap; }\n"
"        .pm-trust-item { min-width: 200px; border-right: none; border-bottom: 1px solid rgba(255,255,255,0.06); }\n"
"    }\n"
"    @media (max-width: 768px) {\n"
"        .pm-footer-body { grid-template-columns: 1fr 1fr; padding: 40px 24px; }\n"
"        .pm-footer-trust { padding: 0 24px; }\n"
"        .pm-trust-item { padding: 16px 20px; }\n"
"        .pm-footer-bottom-inner { flex-direction: column; text-align: center; padding: 20px 24px; }\n"
"        .pm-footer-bottom-links { flex-wrap: wrap; justify-content: center; }\n"
"    }\n"
"    @media (max-width: 480px) {\n"
"        .pm-footer-body { grid-template-columns: 1fr; }\n"
"        .pm-footer-brand { grid-column: auto; }\n"
"    }"
msgstr ""

