#. module: website_planet_mobil
#: model_terms:ir.ui.view,arch_db:website_planet_mobil.homepage
msgid "(function () {\n"
"                    /* ── Particules hero ── */\n"
"                    function initParticles() {\n"
"                        var wrap = document.getElementById('pm-particles');\n"
"                        if (!wrap) return;\n"
"                        for (var i = 0; i < 28; i++) {\n"
"                            var p = document.createElement('div');\n"
"                            p.className = 'pm-particle';\n"
"                            var size = Math.random() * 4 + 1;\n"
"                            p.style.cssText = [\n"
"                                'width:' + size + 'px',\n"
"                                'height:' + size + 'px',\n"
"                                'left:' + Math.random() * 100 + '%',\n"
"                                'animation-duration:' + (Math.random() * 12 + 8) + 's',\n"
"                                'animation-delay:' + (Math.random() * 10) + 's'\n"
"                            ].join(';');\n"
"                            wrap.appendChild(p);\n"
"                        }\n"
"                    }\n"
"\n"
"                    /* ── Carrousel hero ── */\n"
"                    function initHero() {\n"
"                        var slides = document.querySelectorAll('.pm-hero-slide');\n"
"                        var indicators = document.querySelectorAll('.pm-indicator');\n"
"                        if (!slides.length) return;\n"
"                        var current = 0;\n"
"                        function goTo(n) {\n"
"                            slides[current].classList.remove('active');\n"
"                            indicators[current] && indicators[current].classList.remove('active');\n"
"                            current = (n + slides.length) % slides.length;\n"
"                            slides[current].classList.add('active');\n"
"                            indicators[current] && indicators[current].classList.add('active');\n"
"                        }\n"
"                        indicators.forEach(function(ind) {\n"
"                            ind.addEventListener('click', function() {\n"
"                                goTo(+this.dataset.slide);\n"
"                            });\n"
"                        });\n"
"                        setInterval(function() { goTo(current + 1); }, 5000);\n"
"                    }\n"
"\n"
"                    /* ── Typewriter hero ── */\n"
"                    function initTypewriter() {\n"
"                        var el = document.getElementById('pm-typed-text');\n"
"                        if (!el) return;\n"
"                        var lang = (document.documentElement.lang || 'fr').toLowerCase();\n"
"                        var words = lang.startsWith('en')\n"
"                            ? (el.dataset.wordsEn || '').split(',')\n"
"                            : (el.dataset.wordsFr || '').split(',');\n"
"                        var wi = 0, ci = 0, deleting = false;\n"
"                        function tick() {\n"
"                            var word = words[wi];\n"
"                            if (!deleting) {\n"
"                                el.textContent = word.slice(0, ++ci);\n"
"                                if (ci === word.length) { deleting = true; setTimeout(tick, 1800); return; }\n"
"                            } else {\n"
"                                el.textContent = word.slice(0, --ci);\n"
"                                if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; }\n"
"                            }\n"
"                            setTimeout(tick, deleting ? 50 : 80);\n"
"                        }\n"
"                        setTimeout(tick, 1200);\n"
"                    }\n"
"\n"
"                    /* ── Compteurs animés ── */\n"
"                    function initCounters() {\n"
"                        var els = document.querySelectorAll('.pm-stat-num[data-count]');\n"
"                        if (!els.length) return;\n"
"                        var observer = new IntersectionObserver(function(entries) {\n"
"                            entries.forEach(function(entry) {\n"
"                                if (!entry.isIntersecting) return;\n"
"                                observer.unobserve(entry.target);\n"
"                                var el = entry.target;\n"
"                                var target = +el.dataset.count;\n"
"                                var suffix = el.dataset.suffix || '';\n"
"                                var duration = 1600;\n"
"                                var start = performance.now();\n"
"                                function animate(now) {\n"
"                                    var progress = Math.min((now - start) / duration, 1);\n"
"                                    var ease = 1 - Math.pow(1 - progress, 3);\n"
"                                    var val = Math.round(ease * target);\n"
"                                    el.textContent = val.toLocaleString('fr-FR') + suffix;\n"
"                                    if (progress < 1) requestAnimationFrame(animate);\n"
"                                }\n"
"                                requestAnimationFrame(animate);\n"
"                            });\n"
"                        }, { threshold: 0.3 });\n"
"                        els.forEach(function(el) { observer.observe(el); });\n"
"                    }\n"
"\n"
"                    /* ── Carrousel avis ── */\n"
"                    function initAvis() {\n"
"                        var track = document.getElementById('pm-avis-track');\n"
"                        if (!track || track.dataset.init) return;\n"
"                        track.dataset.init = '1';\n"
"                        var originals = [].slice.call(track.children);\n"
"                        originals.forEach(function(n) { track.appendChild(n.cloneNode(true)); });\n"
"                        var paused = false;\n"
"                        track.addEventListener('mouseenter', function() { paused = true; });\n"
"                        track.addEventListener('mouseleave', function() { paused = false; });\n"
"                        var pos = 0;\n"
"                        (function step() {\n"
"                            if (!paused) {\n"
"                                pos += 0.65;\n"
"                                var half = track.scrollWidth / 2;\n"
"                                if (half > 0 && pos >= half) pos -= half;\n"
"                                track.scrollLeft = pos;\n"
"                            }\n"
"                            requestAnimationFrame(step);\n"
"                        })();\n"
"                    }\n"
"\n"
"                    /* ── Init ── */\n"
"                    function init() {\n"
"                        initParticles();\n"
"                        initHero();\n"
"                        initTypewriter("
msgstr ""

