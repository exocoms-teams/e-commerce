msgid "/* ── Fonts & Reset ── */\n"
"                    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n"
"                    #wrap { font-family: 'Inter', sans-serif; }\n"
"\n"
"                    /* ══════════════════════════════════════\n"
"                       HERO\n"
"                    ══════════════════════════════════════ */\n"
"                    .pm-hero {\n"
"                        position: relative;\n"
"                        min-height: 60vh;\n"
"                        display: flex;\n"
"                        align-items: center;\n"
"                        overflow: hidden;\n"
"                        background: #0a0f1e;\n"
"                    }\n"
"                    .pm-hero-slides {\n"
"                        position: absolute; inset: 0;\n"
"                    }\n"
"                    .pm-hero-slide {\n"
"                        position: absolute; inset: 0;\n"
"                        background-size: cover;\n"
"                        background-position: center;\n"
"                        opacity: 0;\n"
"                        transition: opacity 1.2s ease;\n"
"                        transform: scale(1.05);\n"
"                        animation: pmSlideZoom 8s ease forwards;\n"
"                    }\n"
"                    .pm-hero-slide.active { opacity: 1; }\n"
"                    @keyframes pmSlideZoom {\n"
"                        from { transform: scale(1.08); }\n"
"                        to   { transform: scale(1.0); }\n"
"                    }\n"
"                    .pm-hero-overlay {\n"
"                        position: absolute; inset: 0;\n"
"                        background: linear-gradient(\n"
"                            135deg,\n"
"                            rgba(5,10,30,0.92) 0%,\n"
"                            rgba(10,20,60,0.75) 50%,\n"
"                            rgba(5,10,30,0.85) 100%\n"
"                        );\n"
"                    }\n"
"                    /* Particules décoratives */\n"
"                    .pm-hero-particles {\n"
"                        position: absolute; inset: 0;\n"
"                        overflow: hidden;\n"
"                        pointer-events: none;\n"
"                    }\n"
"                    .pm-particle {\n"
"                        position: absolute;\n"
"                        width: 2px; height: 2px;\n"
"                        background: rgba(99,179,237,0.6);\n"
"                        border-radius: 50%;\n"
"                        animation: pmFloat linear infinite;\n"
"                    }\n"
"                    @keyframes pmFloat {\n"
"                        0%   { transform: translateY(100vh) rotate(0deg); opacity: 0; }\n"
"                        10%  { opacity: 1; }\n"
"                        90%  { opacity: 1; }\n"
"                        100% { transform: translateY(-100px) rotate(720deg); opacity: 0; }\n"
"                    }\n"
"                    .pm-hero-content {\n"
"                        position: relative; z-index: 10;\n"
"                        max-width: 860px;\n"
"                        padding: 40px 60px 100px;\n"
"                        animation: pmFadeUp 0.9s ease both;\n"
"                    }\n"
"                    @keyframes pmFadeUp {\n"
"                        from { opacity: 0; transform: translateY(40px); }\n"
"                        to   { opacity: 1; transform: translateY(0); }\n"
"                    }\n"
"                    .pm-hero-badge {\n"
"                        display: inline-flex;\n"
"                        align-items: center;\n"
"                        gap: 8px;\n"
"                        background: rgba(99,179,237,0.15);\n"
"                        border: 1px solid rgba(99,179,237,0.35);\n"
"                        color: #63b3ed;\n"
"                        font-size: 0.78rem;\n"
"                        font-weight: 600;\n"
"                        letter-spacing: 0.12em;\n"
"                        text-transform: uppercase;\n"
"                        padding: 6px 16px;\n"
"                        border-radius: 50px;\n"
"                        margin-bottom: 28px;\n"
"                        animation: pmFadeUp 0.9s 0.1s ease both;\n"
"                    }\n"
"                    .pm-hero-badge-dot {\n"
"                        width: 7px; height: 7px;\n"
"                        background: #63b3ed;\n"
"                        border-radius: 50%;\n"
"                        animation: pmPulse 1.4s infinite;\n"
"                    }\n"
"                    @keyframes pmPulse {\n"
"                        0%,100% { transform: scale(1); opacity:1; }\n"
"                        50%     { transform: scale(1.6); opacity:0.5; }\n"
"                    }\n"
"                    .pm-hero-title {\n"
"                        font-size: clamp(2.4rem, 5vw, 4rem);\n"
"                        font-weight: 900;\n"
"                        line-height: 1.1;\n"
"                        color: #fff;\n"
"                        margin: 0 0 20px;\n"
"                        animation: pmFadeUp 0.9s 0.2s ease both;\n"
"                    }\n"
"                    .pm-hero-title span {\n"
"                        background: linear-gradient(135deg, #63b3ed, #a78bfa);\n"
"                        -webkit-background-clip: text;\n"
"                        -webkit-text-fill-color: transparent;\n"
"                        background-clip: text;\n"
"                    }\n"
"                    .pm-hero-sub {\n"
"                        font-size: 1.15rem;\n"
"                        color: rgba(255,255,255,0.68);\n"
"                        margin-bottom: 40px;\n"
"                        line-height: 1.7;\n"
"                        animation: pmFadeUp 0.9s 0.3s ease both;\n"
"                    }\n"
"                    .pm-hero-btns {\n"
"                        display: flex;\n"
"                        gap: 16px;\n"
"                        flex-wrap: wrap;\n"
"                        animation: pmFadeUp 0.9s 0.4s ease both;\n"
"                    }\n"
"                    .pm-btn-primary {\n"
"                        display: inline-flex; align-items: center; gap: 10px;\n"
"                        background: linear-gradient(135deg, #2563eb, #7c3aed);\n"
"                        color: #fff !important;\n"
"                        font-weight: 700;\n"
"                        font-size: 0.95rem;\n"
"                        padding: 15px 32px;\n"
"                        border-radius: 50px;\n"
"                        text-decoration: none !important;\n"
"                        transition: transform 0.2s, box-shadow 0.2s;\n"
"                        box-shadow: 0 8px 32px rgba(37,99,235,0.45);\n"
"                        position: relative;\n"
"                        overflow: hidden;\n"
"                    }\n"
"                    .pm-btn-primary::before {\n"
"                        content: '';\n"
"                        position: absolute; inset: 0;\n"
"                        background: linear-gradient(135deg, #7c3aed, #2563eb);\n"
"                        opacity: 0;\n"
"                        transition: opacity 0.3s;\n"
"                    }\n"
"                    .pm-btn-primary:hover { transform: translateY(-3px); box-shadow: 0 14px 40px rgba(37,99,235,0.55); }\n"
"                    .pm-btn-primary:hover::before { opacity: 1; }\n"
"                    .pm-btn-primary span { position: relative; z-index: 1; }\n"
"                    .pm-btn-secondary {\n"
"                        display: inline-flex; align-items: center; gap: 10px;\n"
"                        background: rgba(255,255,255,0.08);\n"
"                        border: 1px solid rgba(255,255,255,0.25);\n"
"                        color: #fff !important;\n"
"                        font-weight: 600;\n"
"                        font-size: 0.95rem;\n"
"                        padding: 14px 28px;\n"
"                        border-radius: 50px;\n"
"                        text-decoration: none !important;\n"
"                        transition: background 0.2s, transform 0.2s;\n"
"                        backdrop-filter: blur(8px);\n"
"                    }\n"
"                    .pm-btn-secondary:hover {\n"
"                        background: rgba(255,255,255,0.18);\n"
"                        transform: translateY(-2px);\n"
"                    }\n"
"                    /* Indicateurs hero */\n"
"                    .pm-hero-indicators {\n"
"                        position: absolute;\n"
"                        bottom: 40px; left: 60px;\n"
"                        z-index: 10;\n"
"                        display: flex; gap: 10px;\n"
"                    }\n"
"                    .pm-indicator {\n"
"                        width: 28px; height: 3px;\n"
"                        background: rgba(255,255,255,0.3);\n"
"                        border-radius: 2px;\n"
"                        cursor: pointer;\n"
"                        transition: all 0.3s;\n"
"                    }\n"
"                    .pm-indicator.active {\n"
"                        width: 56px;\n"
"                        background: #63b3ed;\n"
"                    }\n"
"                    /* Scroll indicator */\n"
"                    .pm-scroll-hint {\n"
"                        position: absolute;\n"
"                        bottom: 38px; right: 60px;\n"
"                        z-index: 10;\n"
"                        display: flex; align-items: center; gap: 10px;\n"
"                        color: rgba(255,255,255,0.45);\n"
"                        font-size: 0.78rem;\n"
"                        letter-spacing: 0.1em;\n"
"                        text-transform: uppercase;\n"
"                    }\n"
"                    .pm-scroll-line {\n"
"                        width: 40px; height: 1px;\n"
"                        background: rgba(255,255,255,0.3);\n"
"                    }\n"
"\n"
"                    /* ══════════════════════════════════════\n"
"                       AVANTAGES\n"
"                    ══════════════════════════════════════ */\n"
"                    .pm-features {\n"
"                        padding: 48px 40px;\n"
"                        background: #f8fafc;\n"
"                    }\n"
"                    .pm-section-header {\n"
"                        text-align: center;\n"
"                        margin-bottom: 56px;\n"
"                    }\n"
"                    .pm-section-eyebrow {\n"
"                        display: inline-block;\n"
"                        font-size: 0.75rem;\n"
"                        font-weight: 700;\n"
"                        letter-spacing: 0.15em;\n"
"                        text-transform: uppercase;\n"
"                        color: #2563eb;\n"
"                        background: #dbeafe;\n"
"                        padding: 5px 14px;\n"
"                        border-radius: 50px;\n"
"                        margin-bottom: 16px;\n"
"                    }\n"
"                    .pm-section-title {\n"
"                        font-size: clamp(1.6rem, 3vw, 2.2rem);\n"
"                        font-weight: 800;\n"
"                        color: #0f172a;\n"
"                        margin: 0 0 14px;\n"
"                        line-height: 1.2;\n"
"                    }\n"
"                    .pm-section-desc {\n"
"                        font-size: 1rem;\n"
"                        color: #64748b;\n"
"                        max-width: 500px;\n"
"                        margin: 0 auto;\n"
"                        line-height: 1.7;\n"
"                    }\n"
"                    .pm-features-grid {\n"
"                        display: grid;\n"
"                        grid-template-columns: repeat(4, 1fr);\n"
"                        gap: 24px;\n"
"                        max-width: 1200px;\n"
"                        margin: 0 auto;\n"
"                    }\n"
"                    .pm-feature-card {\n"
"                        background: #fff;\n"
"                        border-radius: 20px;\n"
"                        padding: 36px 28px;\n"
"                        border: 1px solid #e2e8f0;\n"
"                        transition: all 0.3s ease;\n"
"                        position: relative;\n"
"                        overflow: hidden;\n"
"                    }\n"
"                    .pm-feature-card::before {\n"
"                        content: '';\n"
"                        position: absolute;\n"
"                        top: 0; left: 0; right: 0;\n"
"                        height: 3px;\n"
"                        background: linear-gradient(90deg, #2563eb, #7c3aed);\n"
"                        transform: scaleX(0);\n"
"                        transition: transform 0.3s ease;\n"
"                        transform-origin: left;\n"
"                    }\n"
"                    .pm-feature-card:hover {\n"
"                        transform: translateY(-8px);\n"
"                        box-shadow: 0 20px 48px rgba(37,99,235,0.12);\n"
"                        border-color: transparent;\n"
"                    }\n"
"                    .pm-feature-card:hover::before { transform: scaleX(1); }\n"
"                    .pm-feature-icon-wrap {\n"
"                        width: 58px; height: 58px;\n"
"                        border-radius: 16px;\n"
"                        display: flex; align-items: center; justify-content: center;\n"
"                        font-size: 1.4rem;\n"
"                        margin-bottom: 22px;\n"
"                    }\n"
"                    .pm-feature-card:nth-child(1) .pm-feature-icon-wrap { background: #dbeafe; color: #2563eb; }\n"
"                    .pm-feature-card:nth-child(2) .pm-feature-icon-wrap { background: #dcfce7; color: #16a34a; }\n"
"                    .pm-feature-card:nth-child(3) .pm-feature-icon-wrap { background: #fef3c7; color: #d97706; }\n"
"                    .pm-feature-card:nth-child(4) .pm-feature-icon-wrap { background: #fce7f3; color: #db2777; }\n"
"                    .pm-feature-title {\n"
"                        font-size: 1rem;\n"
"                        font-weight: 800;\n"
"                        color: #0f172a;\n"
"                        margin-bottom: 10px;\n"
"                    }\n"
"                    .pm-feature-text {\n"
"                        font-size: 0.875rem;\n"
"                        color: #64748b;\n"
"                        line-height: 1.65;\n"
"                        margin: 0;\n"
"                    }\n"
"\n"
"                    /* ══════════════════════════════════════\n"
"                       CATEGORIES\n"
"                    ══════════════════════════════════════ */\n"
"                    .pm-categories {\n"
"                        padding: 48px 40px;\n"
"                        background: #fff;\n"
"                    }\n"
"                    .pm-cat-grid {\n"
"                        display: grid;\n"
"                        grid-template-columns: 2fr 1fr 1fr;\n"
"                        grid-template-rows: 240px 240px;\n"
"                        gap: 16px;\n"
"                        max-width: 1200px;\n"
"                        margin: 0 auto;\n"
"                    }\n"
"                    .pm-cat-card {\n"
"                        position: relative;\n"
"                        border-radius: 20px;\n"
"                        overflow: hidden;\n"
"                        display: flex;\n"
"                        align-items: flex-end;\n"
"                        text-decoration: none !important;\n"
"                        background: #1e293b;\n"
"                    }\n"
"                    .pm-cat-card:first-child { grid-row: span 2; }\n"
"                    .pm-cat-bg {\n"
"                        position: absolute; inset: 0;\n"
"                        background-size: cover;\n"
"                        background-position: center;\n"
"                        transition: transform 0.5s ease;\n"
"                    }\n"
"                    .pm-cat-card:hover .pm-cat-bg { transform: scale(1.07); }\n"
"                    .pm-cat-overlay {\n"
"                        position: absolute; inset: 0;\n"
"                        background: linear-gradient(0deg, rgba(5,10,30,0.82) 0%, rgba(5,10,30,0.15) 55%, transparent 100%);\n"
"                    }\n"
"                    .pm-cat-info {\n"
"                        position: relative; z-index: 2;\n"
"                        padding: 28px;\n"
"                        width: 100%;\n"
"                    }\n"
"                    .pm-cat-label {\n"
"                        font-size: 0.72rem;\n"
"                        font-weight: 700;\n"
"                        letter-spacing: 0.12em;\n"
"                        text-transform: uppercase;\n"
"                        color: rgba(255,255,255,0.6);\n"
"                        margin-bottom: 6px;\n"
"                    }\n"
"                    .pm-cat-name {\n"
"                        font-size: 1.4rem;\n"
"                        font-weight: 800;\n"
"                        color: #fff;\n"
"                        margin: 0 0 14px;\n"
"                    }\n"
"                    .pm-cat-card:first-child .pm-cat-name { font-size: 2rem; }\n"
"                    .pm-cat-link {\n"
"                        display: inline-flex;\n"
"                        align-items: center;\n"
"                        gap: 8px;\n"
"                        background: rgba(255,255,255,0.15);\n"
"                        border: 1px solid rgba(255,255,255,0.25);\n"
"                        color: #fff;\n"
