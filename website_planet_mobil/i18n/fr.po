"                                color: #0f172a;\n"
"                            }\n"
"                            .pm-btn-share {\n"
"                                background: linear-gradient(135deg, #2563eb, #7c3aed);\n"
"                                color: #fff;\n"
"                            }\n"
"                            .pm-btn-share:hover {\n"
"                                opacity: 0.9;\n"
"                                transform: translateY(-1px);\n"
"                            }\n"
"                            .tsp-specs-table {\n"
"                                width: 100%;\n"
"                                border-collapse: collapse;\n"
"                                border-radius: 12px;\n"
"                                overflow: hidden;\n"
"                                border: 1px solid #e2e8f0;\n"
"                            }\n"
"                            .tsp-specs-table tr:nth-child(even) {\n"
"                                background: #f8fafc;\n"
"                            }\n"
"                            .tsp-specs-label {\n"
"                                padding: 12px 18px;\n"
"                                font-size: 0.85rem;\n"
"                                font-weight: 600;\n"
"                                color: #64748b;\n"
"                                width: 40%;\n"
"                                border-bottom: 1px solid #f1f5f9;\n"
"                            }\n"
"                            .tsp-specs-value {\n"
"                                padding: 12px 18px;\n"
"                                font-size: 0.875rem;\n"
"                                color: #0f172a;\n"
"                                border-bottom: 1px solid #f1f5f9;\n"
"                            }\n"
"                            /* Toast notification */\n"
"                            .pm-toast {\n"
"                                position: fixed;\n"
"                                bottom: 32px;\n"
"                                left: 50%;\n"
"                                transform: translateX(-50%) translateY(20px);\n"
"                                background: #0f172a;\n"
"                                color: #fff;\n"
"                                font-size: 0.85rem;\n"
"                                font-weight: 600;\n"
"                                padding: 12px 24px;\n"
"                                border-radius: 50px;\n"
"                                opacity: 0;\n"
"                                transition: all 0.3s;\n"
"                                z-index: 9999;\n"
"                                pointer-events: none;\n"
"                            }\n"
"                            .pm-toast.show {\n"
"                                opacity: 1;\n"
"                                transform: translateX(-50%) translateY(0);\n"
"                            }\n"
"                            /* Styles impression */\n"
"                            @media print {\n"
"                                body * { visibility: hidden; }\n"
"                                #pm-specs-block,\n"
"                                #pm-specs-block * { visibility: visible; }\n"
"                                #pm-specs-block {\n"
"                                    position: absolute;\n"
"                                    top: 0; left: 0;\n"
"                                    width: 100%;\n"
"                                    padding: 40px;\n"
"                                }\n"
"                                .pm-specs-actions { display: none; }\n"
"                                .pm-print-header {\n"
"                                    display: block !important;\n"
"                                    text-align: center;\n"
"                                    margin-bottom: 24px;\n"
"                                    padding-bottom: 16px;\n"
"                                    border-bottom: 2px solid #e2e8f0;\n"
"                                }\n"
"                                .pm-print-logo {\n"
"                                    font-size: 1.4rem;\n"
"                                    font-weight: 900;\n"
"                                    color: #0f172a;\n"
"                                    margin-bottom: 6px;\n"
"                                }\n"
"                                .pm-print-url {\n"
"                                    font-size: 0.78rem;\n"
"                                    color: #94a3b8;\n"
"                                }\n"
"                            }"
