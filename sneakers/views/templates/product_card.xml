<?xml version="1.0" encoding="UTF-8"?>
<odoo>

<template id="product_card" name="Sneakers Product Card">

<div class="sn-product-card">


    <div class="sn-product-image">

        <a t-att-href="'/product/%s' % product.id">


            <span class="sn-product-badge">
                NEW
            </span>


            <img
                t-if="product.image_1920"
                t-att-src="'/web/image/product.template/%s/image_1920' % product.id"
                t-att-alt="product.name"/>


        </a>


    </div>



    <div class="sn-product-info">


        <span class="sn-product-brand"
              t-if="product.brand_id">

            <t t-out="product.brand_id.name"/>

        </span>



        <h3>
            <t t-out="product.name"/>
        </h3>



        <div class="sn-product-price">

            $

            <t t-out="product.list_price"/>

        </div>



        <button
            type="button"
            class="sn-add-cart sn-add-to-cart-btn"
            t-att-data-product-id="product.product_variant_id.id">

            Add to Cart

        </button>


    </div>


</div>


</template>

</odoo>