<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="product_card" name="Sneakers Product Card">

        <div class="sn-product-card">

            <!-- Product Image -->
            <div class="sn-product-image">

                <a t-att-href="product_url or '/product'">

                    <span class="sn-product-badge">
                        <t t-out="product_badge"/>
                    </span>

                    <img
                        t-att-src="product_image"
                        t-att-alt="product_name"/>

                </a>

                <!-- Hover Actions -->
                <div class="sn-product-actions">

                    <button class="sn-action-btn"
                        title="Wishlist" 
                        t-att-data-product-id="product_id" 
                        aria-pressed="false">

                        <i class="fa fa-heart"/>

                    </button>
                    
                </div>

            </div>

            <!-- Product Information -->
            <div class="sn-product-info">

                <div class="sn-product-rating">

                    <i class="fa fa-star"/>
                    <i class="fa fa-star"/>
                    <i class="fa fa-star"/>
                    <i class="fa fa-star"/>
                    <i class="fa fa-star"/>

                </div>

                <h3>

                    <t t-out="product_name"/>

                </h3>

                <p class="sn-product-meta">
                    <t t-out="product_brand"/> · <t t-out="product_color"/> · <t t-out="product_size"/>
                    <t t-if="not product_in_stock"> · Out of Stock</t>
                </p>

                <div class="sn-product-price">

                    <span class="sn-current-price">

                        <t t-out="product_price"/>

                    </span>

                    <span class="sn-old-price">

                        <t t-out="product_old_price"/>

                    </span>

                </div>

                <div class="sn-add-cart">

                    Add to Cart

                </div>

            </div>

        </div>

    </template>

</odoo>
