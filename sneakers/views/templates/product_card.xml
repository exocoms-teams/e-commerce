<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="product_card" name="Sneakers Product Card">

        <div class="sn-product-card">

            <!-- Product Image -->
            <div class="sn-product-image">

                <span class="sn-product-badge">

                    <t t-out="product_badge"/>

                </span>

                <img
                    t-att-src="product_image"
                    t-att-alt="product_name"/>

                <!-- Hover Actions -->
                <div class="sn-product-actions">

                    <button class="sn-action-btn" title="Wishlist">

                        <i class="fa fa-heart"/>

                    </button>

                    <button class="sn-action-btn" title="Quick View">

                        <i class="fa fa-eye"/>

                    </button>

                    <button class="sn-action-btn" title="Compare">

                        <i class="fa fa-exchange"/>

                    </button>

                </div>

            </div>

            <!-- Product Information -->
            <div class="sn-product-info">

                <div class="sn-product-rating">

                    <i class="fa fa-star"/>
                    <i class="fa fa-star"/>
                    <i class="fa fa-star"/>
                    <i class="fa fa-star"/>
                    <i class="fa fa-star"/>

                </div>

                <h3>

                    <t t-out="product_name"/>

                </h3>

                <div class="sn-product-price">

                    <span class="sn-current-price">

                        <t t-out="product_price"/>

                    </span>

                    <span class="sn-old-price">

                        <t t-out="product_old_price"/>

                    </span>

                </div>

                <a href="/shop" class="sn-add-cart">

                    Add to Cart

                </a>

            </div>

        </div>

    </template>

</odoo>