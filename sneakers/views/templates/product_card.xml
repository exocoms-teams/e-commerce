<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="product_card" name="Sneakers Product Card">

        <div class="sn-product-card"
            t-att-data-product-id="product.product_variant_id.id if product else product_id"
            t-att-data-wish-id="wish_id if wishlist_page else ''">


            <!-- Product Image -->
            <div class="sn-product-image">


                <a t-att-href="'/product/%s' % (product.id if product else product_id)">


                    <!-- Badge -->
                    <t t-if="product">
                    <t t-if="product.website_published">
                        <span class="sn-product-badge">New</span>
                    </t>
                </t>

                <t t-if="not product and product_badge">
                    <span class="sn-product-badge">
                        <t t-out="product_badge"/>
                    </span>
                </t>


                    <!-- Main Image -->
                    <t t-if="product">

                        <img
                            t-att-src="'/web/image/product.template/%s/image_256' % product.id"
                            t-att-alt="product.name"/>

                    </t>

                    <t t-if="not product and product_image">

                        <img
                            t-att-src="product_image"
                            t-att-alt="product_name"/>

                    </t>


                </a>


                <!-- Hover Actions -->
                <div class="sn-product-actions">

                    <!-- Page Wishlist -->
                    <t t-if="wishlist_page">

                        <button class="sn-action-btn sn-remove-wishlist"
                                title="Remove from wishlist"
                                t-att-data-wish-id="wish_id"
                                type="button">

                            <i class="fa fa-trash"/>

                        </button>

                    </t>

                    <!-- Toutes les autres pages -->
                    <t t-else="">

                        <button class="sn-action-btn sn-product-wishlist sn-btn-heart"
                                title="Add to wishlist"
                                t-att-data-product-id="product.product_variant_id.id"
                                aria-pressed="false"
                                type="button">

                            <svg class="sn-heart-filled" viewBox="0 0 512 512" width="16" height="16" aria-hidden="true">
                                <path d="M47.6 302.5c14.9 119.2 105.5 199.4 215.5 213.6 22.3 2.8 44.6-.6 65.4-10.8 22.5-10.8 48 4.6 63.5 23.2 7.1 8.6 15.3 16.1 24.4 22.5 138.5 94.5 240.7 48.2 282-18.3l2.5-2.3c18.4-17.1 36.8-37 53.6-58.8 18.2-23.6 33.2-49.1 44.3-75.6 5.5-13.1 8.2-27.3 8.2-41.7 0-27.6-13.4-53.2-35.2-71.6C435.5 93.6 393.4 72 343 72c-49.3 0-95.1 20.7-127.1 56.2C183.5 92.6 138.2 72 89 72 54.7 72 22.7 86.4 0 110.3l-1.5 1.4C12.4 122.3 28.6 141 47.6 160.1V302.5z"/>
                            </svg>
                            <svg class="sn-heart-outline" viewBox="0 0 512 512" width="16" height="16" aria-hidden="true">
                                <path d="M225.8 468.2l-2.5-2.3L48.1 303.2C17.4 274.7 0 234.7 0 192.8C0 93.2 92.8 0 208 0h4c106.1 0 192 85.9 192 192c0 103.2-75.7 189-174.3 203.8l-2.2 4.3zM495.5 192c0 84.3-59.3 156.5-137.5 176.4c-17.6 4.5-36.2-.4-51.4-13.2l-3.2-2.7c-15.3-13.1-36.6-18.1-58.2-10.7l-2.5.9c-9.1 3.4-18.7 3.4-27.8 0l-2.5-.9c-21.6-7.4-42.9-2.4-58.2 10.7l-3.2 2.7c-15.2 12.8-33.8 17.7-51.4 13.2C59.3 348.5 0 276.3 0 192C0 86 86 0 192 0h4c93.4 0 170 63.5 188.4 149.7c2.8 13.2 5.2 26.6 7.2 40.1C417.8 169.3 456 199.3 456 240c0 21.5-5.1 41.9-14.3 60.2C450.6 318.1 495.5 256.5 495.5 192z"/>
                            </svg>

                        </button>

                    </t>

                </div>

            </div>



            <!-- Product Information -->
            <div class="sn-product-info">


                <!-- Rating -->
            <div class="sn-product-rating">

                <t t-set="rating"
                t-value="product_ratings.get(product.id, 0) if product_ratings else 0"/>


                <t t-foreach="[1,2,3,4,5]" t-as="star">

                    <i t-att-class="
                        'fa fa-star'
                        if star &lt;= rating
                        else 'fa fa-star-o'
                    "/>

                </t>

                <span class="sn-rating-value">
                    (<t t-out="'%.1f' % rating"/>)
                </span>

            </div>

                <!-- Name -->
                <h3>

                    <t t-out="product.name if product else product_name"/>

                </h3>



                <!-- Price -->
                    <div class="sn-product-price">

                        <span class="sn-current-price">
                            $
                            <t t-if="product">
                                <t t-out="'%.2f' % product.list_price"/>
                            </t>

                            <t t-if="not product">
                                <t t-out="product_price"/>
                            </t>
                        </span>


                        <t t-if="product and product.compare_list_price">

                            <span class="sn-old-price">
                                $
                                <t t-out="'%.2f' % product.compare_list_price"/>
                            </span>

                        </t>


                        <t t-if="not product and product_old_price">

                            <span class="sn-old-price">
                                $
                                <t t-out="product_old_price"/>
                            </span>

                        </t>

                    </div>



                <!-- Add Cart -->
                <button class="sn-add-cart"

                        t-att-data-product-id="product.product_variant_id.id if product else product_id"
                        t-att-data-template-id="product.id if product else product_id"
                        t-att-data-product-name="product.name if product else product_name"
                        t-att-data-product-price="product.list_price if product else product_price"
                        t-att-data-product-image="('/web/image/product.template/%s/image_1024' % product.id) if product else product_image"
                        t-att-data-stock="product.product_variant_id.qty_available if product else 0"
                        t-att-data-cart-qty="0">

                    Add to Cart

                </button>


            </div>


        </div>


    </template>


</odoo>