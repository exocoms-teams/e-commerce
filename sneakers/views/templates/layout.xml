<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template
        id="layout"
        inherit_id="website.layout"
        name="Sneakers Layout">

        <xpath expr="//html" position="attributes">
            <attribute name="t-att-dir">('rtl' if request.env.lang and request.env.lang.startswith('ar') else 'ltr')</attribute>
        </xpath>

        <xpath expr="//header" position="replace">

            <t t-call="sneakers.header"/>

        </xpath>

        <xpath expr="//footer" position="replace">

            <t t-call="sneakers.footer"/>

        </xpath>

    </template>

</odoo>
