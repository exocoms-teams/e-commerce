<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="header" name="Sneakers Header">

        <header>

            <!-- TOP BAR  -->

            <div class="sn-topbar">

                <div class="mn-container">

                    <div class="sn-topbar-left">
                        <i class="fa fa-truck" aria-hidden="true"/>
                        <span>Free shipping on orders over $100</span>
                    </div>

                    <div class="sn-topbar-center">
                        <i class="fa fa-fire" aria-hidden="true"/>
                        <span>Summer Sale - Up to 50% OFF</span>
                    </div>

                    <div class="sn-topbar-right">

                        <select class="sn-language-switcher" aria-label="Change language" onchange="window.location.href='/website/lang/' + this.value + '?r=' + encodeURIComponent(window.location.pathname)">
                            <option value="en" t-att-selected="request.context.get('lang', 'en_US').startswith('en')">English</option>
                            <option value="fr" t-att-selected="request.context.get('lang', 'en_US').startswith('fr')">Français</option>
                            <option value="ar" t-att-selected="request.context.get('lang', 'en_US').startswith('ar')">العربية</option>
                        </select>

                    </div>

                </div>

            </div>

            <!-- ================= MAIN HEADER ================= -->

            <div class="sn-header">

                <div class="mn-container">

                    <!-- Logo -->

                    <div class="sn-logo">

                        <a href="/">

                            <svg class="sn-logo-mark" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M2.5 15.5c2.2-.3 3.6-1 5.2-2.6 1.6-1.6 2.3-3.9 4.3-3.9 1.8 0 2.3 1.4 3.6 2.3 1.3.9 2.7 1 4.4.6.9-.2 1.5-.4 2-.6v3.2c0 1.4-1.3 2.5-2.9 2.5H5.4c-1.5 0-2.7-.6-2.9-1.5z" fill="currentColor"/>
                                <path d="M2.5 15.5V13c1.6-.2 2.7-.7 3.9-1.7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" fill="none"/>
                            </svg>

                            <div>
                                <h2>SNEAKERS</h2>
                                <small>Premium Footwear</small>
                            </div>

                        </a>

                    </div>

                    <!-- Navigation -->

                    <nav class="sn-nav">

                        <ul>
                            <li><a href="/">Home</a></li>
                            <li><a href="/shop-sneakers?category=men">Men</a></li>
                            <li><a href="/shop-sneakers?category=women">Women</a></li>
                            <li><a href="/shop-sneakers?category=kids">Kids</a></li>
                            <li><a href="/shop-sneakers?category=sports">Sports</a></li>
                            <li><a href="/shop-sneakers?category=lifestyle">Lifestyle</a></li>
                            <li><a href="/shop-sneakers?category=new_arrivals">New</a></li>
                        </ul>

                    </nav>

                    <!-- Right Side -->

                    <div class="sn-actions">

                        <!-- Search with category filter (EF-004) -->

                        <form class="sn-search" action="/shop-sneakers" method="get">
                            
                                <select name="category" class="sn-search-category" aria-label="Filter by category">
                                    <option value="">All</option>
                                    <option value="men">Men</option>
                                    <option value="women">Women</option>
                                    <option value="kids">Kids</option>
                                    <option value="running">Running</option>
                                    <option value="basketball">Basketball</option>
                                    <option value="lifestyle">Lifestyle</option>
                                </select>

                                <input
                                    type="search"
                                    name="search"
                                    placeholder="Search sneakers..."
                                    aria-label="Search products"/>
                        
                                <button type="submit" aria-label="Search">
                                    <i class="fa fa-search" aria-hidden="true"/>
                                </button>
                        </form>

                        <!-- Wishlist -->

                        <a href="/wishlist" class="sn-icon" aria-label="Wishlist">
                            <i class="fa fa-heart" aria-hidden="true"/>
                            <span class="sn-wishlist-count">0</span>
                        </a>

                        <!-- Cart -->

                        <a href="/shop/cart" class="sn-icon" aria-label="Cart">
                            <i class="fa fa-shopping-cart" aria-hidden="true"/>
                            <span class="sn-cart-count">0</span>
                        </a>

                        <!-- Account -->
                        <t t-if="request.env.user._is_public()">
                            <a href="/my/login" class="sn-icon" aria-label="Sign In">
                                <i class="fa fa-user" aria-hidden="true"/>
                            </a>
                        </t>
                        <t t-else="">
                            <div class="sn-account-wrap">
                                <a href="/my/account" class="sn-icon" aria-label="My Account">
                                    <i class="fa fa-user" aria-hidden="true"/>
                                </a>
                                <div class="sn-account-dropdown">
                                    <a href="/my"><i class="fa fa-th-large" aria-hidden="true"/> Account</a>
                                    <a href="/my/orders"><i class="fa fa-shopping-bag" aria-hidden="true"/> Orders</a>
                                    <a href="/my/invoices?filterby=invoices"><i class="fa fa-file-text-o" aria-hidden="true"/> Invoices</a>
                                    <a href="/my/account"><i class="fa fa-cog" aria-hidden="true"/> Profile</a>
                                    <a href="/web/session/logout" class="sn-account-logout"><i class="fa fa-sign-out" aria-hidden="true"/> Logout</a>
                                </div>
                            </div>
                        </t>

                    </div>

                </div>

            </div>

        </header>

    </template>

</odoo>