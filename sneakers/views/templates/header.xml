<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="header" name="Sneakers Header">

        <header>

            <!-- TOP BAR  -->

            <div class="sn-topbar">

                <div class="mn-container">

                    <div class="sn-topbar-left">
                        <i class="fa fa-truck" aria-hidden="true"/>
                        <span>Free shipping on orders over $100</span>
                    </div>

                    <div class="sn-topbar-center">
                        <i class="fa fa-fire" aria-hidden="true"/>
                        <span>Summer Sale - Up to 50% OFF</span>
                    </div>

                    <div class="sn-topbar-right">

                        <select class="sn-language-switcher" aria-label="Change language">
                            <option value="en" t-att-selected="'selected' if request.lang.code == 'en_US' else None">English</option>
                            <option value="ar" t-att-selected="'selected' if request.lang.code == 'ar_001' else None">العربية</option>
                            <option value="fr" t-att-selected="'selected' if request.lang.code == 'fr_FR' else None">Français</option>
                        </select>

                    </div>

                </div>

            </div>

            <!-- ================= MAIN HEADER ================= -->

            <div class="sn-header">

                <div class="mn-container">

                    <!-- Logo -->

                    <div class="sn-logo">

                        <a href="/">

                            <svg class="sn-logo-mark" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M2.5 15.5c2.2-.3 3.6-1 5.2-2.6 1.6-1.6 2.3-3.9 4.3-3.9 1.8 0 2.3 1.4 3.6 2.3 1.3.9 2.7 1 4.4.6.9-.2 1.5-.4 2-.6v3.2c0 1.4-1.3 2.5-2.9 2.5H5.4c-1.5 0-2.7-.6-2.9-1.5z" fill="currentColor"/>
                                <path d="M2.5 15.5V13c1.6-.2 2.7-.7 3.9-1.7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" fill="none"/>
                            </svg>

                            <div>
                                <h2>SNEAKERS</h2>
                                <small>Premium Footwear</small>
                            </div>

                        </a>

                    </div>

                    <!-- Navigation -->

                    <nav class="sn-nav">

                        <ul>
                            <li><a href="/">Home</a></li>
                            <li><a href="/shop-sneakers">Shop</a></li>
                            <li><a href="/shop-sneakers?category=men">Men</a></li>
                            <li><a href="/shop-sneakers?category=women">Women</a></li>
                            <li><a href="/shop-sneakers?category=sports">Sports</a></li>
                            <li><a href="/shop-sneakers?category=new_arrivals">New Arrivals</a></li>
                            <li><a href="/shop-sneakers?category=sale">Sale</a></li>
                        </ul>

                    </nav>

                    <!-- Right Side -->

                    <div class="sn-actions">

                        <!-- Search with category filter (EF-004) -->

                        <form class="sn-search" action="/shop-sneakers" method="get">

                            <select name="category" class="sn-search-category" aria-label="Filter by category">
                                <option value="">All</option>
                                <option value="men">Men</option>
                                <option value="women">Women</option>
                                <option value="kids">Kids</option>
                                <option value="running">Running</option>
                                <option value="basketball">Basketball</option>
                                <option value="lifestyle">Lifestyle</option>
                            </select>

                            <input
                                type="search"
                                name="search"
                                placeholder="Search sneakers..."
                                aria-label="Search products"/>

                            <button type="submit" aria-label="Search">
                                <i class="fa fa-search" aria-hidden="true"/>
                            </button>

                        </form>

                        <!-- Wishlist -->

                        <a href="/wishlist" class="sn-icon" aria-label="Wishlist">
                            <i class="fa fa-heart" aria-hidden="true"/>
                            <span class="sn-wishlist-count" style="display:none;">0</span>
                        </a>

                        <!-- Cart -->

                        <a href="/cart" class="sn-icon" aria-label="Cart">
                            <i class="fa fa-shopping-cart" aria-hidden="true"/>
                            <span class="sn-cart-count"
                                t-att-style="'' if request.cart and request.cart.cart_quantity else 'display:none'"
                                t-out="request.cart.cart_quantity if request.cart else 0"/>
                        </a>

                    </div>

                </div>

            </div>

        </header>

    </template>

</odoo>