<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_about" name="Sneakers About Us">
        <t t-call="website.layout">
            <main class="sn-static-page">
                <div class="sn-static-hero">
                    <div class="container">
                        <p class="sn-static-label">ABOUT US</p>
                        <h1>Our Story</h1>
                        <p class="sn-static-subtitle">Premium sneakers for every lifestyle since 2020.</p>
                    </div>
                </div>
                <div class="container sn-static-content">
                    <h2>Who We Are</h2>
                    <p>SNEAKERS is a premium footwear destination curating the world's best sneaker brands. We believe every step should feel exceptional.</p>
                    <p>From running to basketball, lifestyle to skateboarding — we bring you authentic, high-quality sneakers backed by expert knowledge and dedicated customer service.</p>
                    <h2>Our Mission</h2>
                    <p>To make premium sneakers accessible to everyone while providing an unmatched shopping experience. Quality, comfort, and style — without compromise.</p>
                    <h2>Why Choose Us</h2>
                    <ul style="list-style-type:disc">
                        <li>Authentic products directly from brands</li>
                        <li>Free shipping on orders over $100</li>
                        <li>30-day hassle-free returns</li>
                        <li>Expert customer support</li>
                    </ul>
                </div>
            </main>
        </t>
    </template>

    <template id="page_faq" name="Sneakers FAQ">
        <t t-call="website.layout">
            <main class="sn-static-page">
                <div class="sn-static-hero">
                    <div class="container">
                        <p class="sn-static-label">SUPPORT</p>
                        <h1>Frequently Asked Questions</h1>
                        <p class="sn-static-subtitle">Find answers to common questions about our products and services.</p>
                    </div>
                </div>
                <div class="container sn-static-content">
                    <h2>Shipping &amp; Delivery</h2>
                    <div class="sn-faq-item">
                        <button class="sn-faq-question">
                            <span>How long does shipping take?</span>
                            <span class="sn-faq-icon">+</span>
                        </button>
                        <div class="sn-faq-answer">
                            <p>Standard shipping takes 3-5 business days. Express shipping is available at checkout for 1-2 business day delivery.</p>
                        </div>
                    </div>
                    <div class="sn-faq-item">
                        <button class="sn-faq-question">
                            <span>Is shipping free?</span>
                            <span class="sn-faq-icon">+</span>
                        </button>
                        <div class="sn-faq-answer">
                            <p>Yes! We offer free standard shipping on all orders over $100.</p>
                        </div>
                    </div>

                    <h2>Returns &amp; Exchanges</h2>
                    <div class="sn-faq-item">
                        <button class="sn-faq-question">
                            <span>Can I return my order?</span>
                            <span class="sn-faq-icon">+</span>
                        </button>
                        <div class="sn-faq-answer">
                            <p>Yes, you can return unworn items within 30 days of delivery for a full refund.</p>
                        </div>
                    </div>
                    <div class="sn-faq-item">
                        <button class="sn-faq-question">
                            <span>How do I start a return?</span>
                            <span class="sn-faq-icon">+</span>
                        </button>
                        <div class="sn-faq-answer">
                            <p>Contact our support team or visit your order history to initiate a return.</p>
                        </div>
                    </div>

                    <h2>Products</h2>
                    <div class="sn-faq-item">
                        <button class="sn-faq-question">
                            <span>Are your products authentic?</span>
                            <span class="sn-faq-icon">+</span>
                        </button>
                        <div class="sn-faq-answer">
                            <p>Absolutely. All products are sourced directly from authorized brand distributors.</p>
                        </div>
                    </div>
                    <div class="sn-faq-item">
                        <button class="sn-faq-question">
                            <span>How do I find my size?</span>
                            <span class="sn-faq-icon">+</span>
                        </button>
                        <div class="sn-faq-answer">
                            <p>Each product page includes a size guide. If you're between sizes, we recommend sizing up.</p>
                        </div>
                    </div>

                    <h2>Account &amp; Orders</h2>
                    <div class="sn-faq-item">
                        <button class="sn-faq-question">
                            <span>How do I track my order?</span>
                            <span class="sn-faq-icon">+</span>
                        </button>
                        <div class="sn-faq-answer">
                            <p>Once your order ships, you'll receive a tracking number via email. You can also check your order status in your account.</p>
                        </div>
                    </div>
                    <div class="sn-faq-item">
                        <button class="sn-faq-question">
                            <span>Can I cancel my order?</span>
                            <span class="sn-faq-icon">+</span>
                        </button>
                        <div class="sn-faq-answer">
                            <p>Orders can be cancelled within 1 hour of placement. After that, please contact support.</p>
                        </div>
                    </div>
                </div>
            </main>
        </t>
    </template>

    <template id="page_careers" name="Sneakers Careers">
        <t t-call="website.layout">
            <main class="sn-static-page">
                <div class="sn-static-hero">
                    <div class="container">
                        <p class="sn-static-label">CAREERS</p>
                        <h1>Join Our Team</h1>
                        <p class="sn-static-subtitle">Help us redefine the sneaker shopping experience.</p>
                    </div>
                </div>
                <div class="container sn-static-content">
                    <h2>Why Work at SNEAKERS?</h2>
                    <p>We're a passionate team of sneaker enthusiasts building the future of footwear retail. Join us and work with the world's top brands.</p>
                    <h2>Open Positions</h2>
                    <p>We're always looking for talented people. Send your resume to <strong>careers@sneakers.com</strong> and tell us why you'd be a great fit.</p>
                    <ul style="list-style-type:disc">
                        <li>Software Engineers</li>
                        <li>Product Designers</li>
                        <li>Marketing Specialists</li>
                        <li>Customer Experience Team</li>
                    </ul>
                </div>
            </main>
        </t>
    </template>

    <template id="page_shipping" name="Sneakers Shipping">
        <t t-call="website.layout">
            <main class="sn-static-page">
                <div class="sn-static-hero">
                    <div class="container">
                        <p class="sn-static-label">SHIPPING</p>
                        <h1>Shipping Information</h1>
                        <p class="sn-static-subtitle">Fast, reliable delivery to your doorstep.</p>
                    </div>
                </div>
                <div class="container sn-static-content">
                    <h2>Shipping Options</h2>
                    <ul>
                        <li><strong>Standard Shipping (3-5 days):</strong> Free on orders over $100, otherwise $9.99</li>
                        <li><strong>Express Shipping (1-2 days):</strong> $19.99</li>
                    </ul>
                    <h2>International Shipping</h2>
                    <p>We currently ship to select countries. International shipping rates and delivery times vary by destination.</p>
                    <h2>Order Tracking</h2>
                    <p>You'll receive a tracking number via email once your order ships. Track your package in real-time through your account dashboard.</p>
                </div>
            </main>
        </t>
    </template>

    <template id="page_returns" name="Sneakers Returns">
        <t t-call="website.layout">
            <main class="sn-static-page">
                <div class="sn-static-hero">
                    <div class="container">
                        <p class="sn-static-label">RETURNS</p>
                        <h1>Returns &amp; Exchanges</h1>
                        <p class="sn-static-subtitle">Hassle-free returns within 30 days.</p>
                    </div>
                </div>
                <div class="container sn-static-content">
                    <h2>Return Policy</h2>
                    <p>We want you to love your purchase. If you're not completely satisfied, you can return unworn items within 30 days of delivery for a full refund.</p>
                    <h2>How to Return</h2>
                    <ol>
                        <li>Log in to your account and go to Order History</li>
                        <li>Select the order containing the item you want to return</li>
                        <li>Follow the return instructions</li>
                        <li>Ship the item back using the prepaid label</li>
                    </ol>
                    <h2>Exchange Policy</h2>
                    <p>Need a different size or color? Initiate an exchange through your order history and we'll ship the new item as soon as we receive your return.</p>
                </div>
            </main>
        </t>
    </template>

    <template id="page_privacy_policy" name="Sneakers Privacy Policy">
        <t t-call="website.layout">
            <main class="sn-static-page">
                <div class="sn-static-hero">
                    <div class="container">
                        <p class="sn-static-label">LEGAL</p>
                        <h1>Privacy Policy</h1>
                        <p class="sn-static-subtitle">How we protect your data.</p>
                    </div>
                </div>
                <div class="container sn-static-content">
                    <h2>Information We Collect</h2>
                    <p>We collect information you provide directly: name, email, shipping address, and payment details when you make a purchase.</p>
                    <h2>How We Use Your Information</h2>
                    <ul style="list-style-type:disc">
                        <li>To process and fulfill your orders</li>
                        <li>To communicate about your orders and account</li>
                        <li>To improve our products and services</li>
                        <li>To send promotional communications (with your consent)</li>
                    </ul>
                    <h2>Data Security</h2>
                    <p>We implement industry-standard security measures to protect your personal information. Your payment data is encrypted and never stored on our servers.</p>
                    <h2>Contact Us</h2>
                    <p>For privacy-related inquiries, contact us at <strong>privacy@sneakers.com</strong>.</p>
                </div>
            </main>
        </t>
    </template>

</odoo>
