<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="page_cart" name="Sneakers Cart">

        <t t-call="website.layout">

            <!-- CART HEADER -->

            <section class="sn-cart-header">

                <div class="mn-container">

                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">
                            Shopping Cart
                        </span>

                        <h2>
                            Review Your Cart
                        </h2>

                        <p>
                            Check your selected sneakers before proceeding
                            to checkout.
                        </p>

                    </div>

                </div>

            </section>

            <!-- CART CONTENT -->

            <section class="sn-cart">

                <div class="mn-container">

                    <section class="sn-cart">

                        <div class="mn-container">

                            <div class="sn-cart-layout">

                                <div class="sn-cart-items">

                                    <div class="sn-cart-items">
                                    

                                    <t t-if="order and order.order_line.filtered(lambda l: l.product_id)">

                                    <t t-foreach="order.order_line.filtered(lambda l: l.product_id)" t-as="line">


                                    <article
                                        class="sn-cart-item"
                                        t-att-data-line-id="line.id"
                                        t-att-data-product-id="line.product_id.id">
                                    

                                        <!-- IMAGE -->
                                        <div class="sn-cart-image">

                                            <img
                                                t-att-src="line.product_id.image_128 
                                                    and '/web/image/product.product/%s/image_128' % line.product_id.id 
                                                    or '/web/static/img/placeholder.png'"
                                                t-att-alt="line.product_id.name"/>

                                        </div>



                                        <!-- INFO -->
                                        <div class="sn-cart-info">


                                            <!-- CATEGORY -->
                                            <span class="sn-cart-category">

                                                <t t-foreach="line.product_id.product_tmpl_id.public_categ_ids"
                                                t-as="cat">

                                                    <span class="sn-category">
                                                        <t t-out="cat.name"/>
                                                    </span>

                                                </t>

                                            </span>



                                            <!-- PRODUCT NAME -->
                                            <h3>
                                                <t t-out="line.product_id.name"/>
                                            </h3>



                                            <!-- ATTRIBUTES SIZE / COLOR -->

                                            <div class="sn-cart-attributes">

                                                <t t-if="line.product_template_attribute_value_ids">

                                                    <t t-foreach="line.product_template_attribute_value_ids"
                                                    t-as="attribute">

                                                        <span>
                                                            <t t-out="attribute.attribute_id.name"/>
                                                            :
                                                            <t t-out="attribute.name"/>
                                                        </span>

                                                    </t>

                                                </t>

                                            </div>



                                            <!-- PRICE -->
                                            <div class="sn-cart-price">

                                                $
                                                <t t-out="line.price_unit"/>

                                            </div>


                                        </div>




                                        <!-- QUANTITY -->
                                        <div class="sn-cart-quantity">


                                            <button
                                                class="sn-qty-btn"
                                                data-action="decrease">

                                                -

                                            </button>



                                            <input
                                                class="sn-qty-input"
                                                type="number"
                                                t-att-value="line.product_uom_qty"
                                                min="1"/>



                                            <button
                                                class="sn-qty-btn"
                                                data-action="increase">

                                                +

                                            </button>


                                        </div>




                                        <!-- TOTAL -->

                                        <div class="sn-cart-total">

                                            $
                                            <t t-out="line.price_subtotal"/>

                                        </div>




                                        <!-- REMOVE -->

                                        <button
                                            class="sn-cart-remove"
                                            type="button">

                                            <i class="fa fa-trash"></i>

                                        </button>


                                    </article>


                                                                                </t>


                                                                            </t>


                                                                            <t t-else="">

                                        <div class="sn-cart-empty">

                                            <i class="fa fa-shopping-cart"></i>

                                            <h3>Your cart is empty</h3>

                                            <p>
                                                Browse our catalog and add your favorite sneakers.
                                            </p>

                                            <a href="/shop-sneakers" class="sn-btn-primary">
                                                Continue Shopping
                                            </a>

                                        </div>

                                    </t>


                                    </div>

                                </div>
                                <!-- ORDER SUMMARY -->                       

                                <aside class="sn-cart-summary">

                                    <aside class="sn-cart-summary">

                                        <div class="sn-summary-card">

                                            <h3>
                                                Order Summary
                                            </h3>

                                            <div class="sn-summary-row">

                                                <span>Subtotal</span>

                                                <span>
                                                    $
                                                    <t t-out="order.amount_untaxed if order else 0"/>
                                                </span>

                                            </div>

                                           <div class="sn-summary-row">

                                                <span>Shipping</span>

                                                <span>
                                                    $
                                                    <t t-out="order.amount_delivery if order else 0"/>
                                                </span>

                                            </div>

                                            <div class="sn-summary-row">

                                                <span>Estimated Tax</span>

                                                <span>
                                                    $
                                                    <t t-out="order.amount_tax if order else 0"/>
                                                </span>

                                            </div>

                                            <div class="sn-summary-divider"></div>

                                            <div class="sn-summary-row sn-summary-total">

                                                <span>Total</span>

                                                <span>
                                                    $
                                                    <t t-out="order.amount_total if order else 0"/>
                                                </span>

                                            </div>
                                            
                                            <button class="sn-checkout-btn">
                                                <a href="/checkout">
                                                    Proceed to Checkout
                                                </a>
                                            </button>

                                            <a href="/shop-sneakers" class="sn-continue-shopping">

                                                ← Continue Shopping

                                            </a>

                                        </div>

                                        <!-- PROMO CODE -->
                                        <div class="sn-promo-card">

                                            <h4>Promo Code</h4>

                                            <div class="sn-promo-form">

                                                <input
                                                    type="text"
                                                    placeholder="Enter promo code"/>

                                                <button>

                                                    Apply

                                                </button>

                                            </div>

                                        </div>

                                    </aside>

                                </aside>

                            </div>

                        </div>

                    </section>

                </div>

            </section>

        </t>

    </template>

</odoo>