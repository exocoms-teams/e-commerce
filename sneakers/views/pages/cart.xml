<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="page_cart" name="Sneakers Cart">

        <t t-call="website.layout">

            <div class="oe_structure oe_empty"/>

            <!-- CART HEADER -->

            <section class="sn-cart-header oe_structure oe_empty">

                <div class="mn-container">

                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">
                            Shopping Cart
                        </span>

                        <h2>
                            Review Your Cart
                        </h2>

                        <p>
                            Check your selected sneakers before proceeding
                            to checkout.
                        </p>

                    </div>

                </div>

            </section>

            <!-- CART CONTENT -->

            <section class="sn-cart oe_structure oe_empty">

                <div class="mn-container">

                    <section class="sn-cart">

                        <div class="mn-container">

                            <div class="sn-cart-layout">

                                <div class="sn-cart-items">

                                    <div class="sn-cart-items">  
                                    
                                        <!-- product 1 -->

                                    <article class="sn-cart-item">

                                        <div class="sn-cart-image">

                                            <img src="/sneakers/static/src/img/products/product-1.jpg"
                                                alt="Nike Air Max"/>

                                        </div>

                                        <div class="sn-cart-info">

                                            <span class="sn-cart-category">Running Shoes</span>

                                            <h3>Nike Air Max 270</h3>

                                            <div class="sn-cart-attributes">

                                                <span>Size : 42</span>

                                                <span>Color : Black</span>

                                            </div>

                                            <div class="sn-cart-price">$180.00</div>

                                        </div>

                                        <div class="sn-cart-quantity">

                                            <button class="sn-qty-btn"> - </button>

                                            <input
                                                type="number"
                                                value="1"
                                                min="1"/>

                                            <button class="sn-qty-btn"> + </button>

                                        </div>

                                       <div class="sn-cart-total">$180.00</div>

                                        
                                        <button class="sn-cart-remove">

                                            <i class="fa fa-trash"></i>

                                        </button>

                                    </article>

                                    <!-- product 2 -->

                                    <article class="sn-cart-item">
                                         <div class="sn-cart-image">

                                            <img src="/sneakers/static/src/img/products/product-2.jpg"
                                                alt="Adidas Ultraboost"/>

                                        </div>

                                        <div class="sn-cart-info">

                                            <span class="sn-cart-category">
                                                Lifestyle
                                            </span>

                                            <h3>Adidas Ultraboost </h3>

                                            <div class="sn-cart-attributes">

                                                <span>Size : 41</span>

                                                <span>Color : White</span>

                                            </div>

                                            <div class="sn-cart-price">$220.00</div>

                                        </div>

                                        <div class="sn-cart-quantity">

                                            <button class="sn-qty-btn"> - </button>

                                            <input
                                                type="number"
                                                value="2"
                                                min="1"/>

                                            <button class="sn-qty-btn"> + </button>

                                        </div>

                                        <div class="sn-cart-total">$440.00</div>

                                        <button class="sn-cart-remove">

                                            <i class="fa fa-trash"></i>

                                        </button>

                                    </article>

                                </div>

                                </div>
                                
                                <!-- ORDER SUMMARY -->
                                <aside class="sn-cart-summary">

                                    <div class="sn-summary-card">

                                        <h3>Order Summary</h3>

                                        <div class="sn-summary-row">
                                            <span>Subtotal</span>
                                            <span class="sn-order-subtotal">$0.00</span>
                                        </div>

                                        <div class="sn-summary-row">
                                            <span>Shipping</span>
                                            <span class="sn-order-shipping">$0.00</span>
                                        </div>

                                        <div class="sn-summary-row">
                                            <span>Estimated Tax</span>
                                            <span class="sn-order-tax">$0.00</span>
                                        </div>

                                        <div class="sn-summary-divider"></div>

                                        <div class="sn-summary-row sn-summary-total">
                                            <span>Total</span>
                                            <span class="sn-order-total">$0.00</span>
                                        </div>

                                        <a href="/checkout">
                                            <button class="sn-checkout-btn">
                                                Proceed to Checkout
                                            </button>
                                        </a>

                                        <a href="/shop-sneakers" class="sn-continue-shopping">
                                            ← Continue Shopping
                                        </a>

                                    </div>

                                    <!-- PROMO CODE -->
                                    <div class="sn-promo-card">

                                        <h4>Promo Code</h4>

                                        <div class="sn-promo-form">

                                            <input
                                                type="text"
                                                placeholder="Enter promo code"/>

                                            <button>Apply</button>

                                        </div>

                                    </div>

                                </aside>

                            </div>

                        </div>

                    </section>

                </div>

            </section>

        </t>

    </template>

</odoo>