<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="page_cart" name="Sneakers Cart">

        <t t-call="website.layout">

            <!-- CART HEADER -->

            <section class="sn-cart-header">

                <div class="mn-container">

                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">
                            Shopping Cart
                        </span>

                        <h2>
                            Review Your Cart
                        </h2>

                        <p>
                            Check your selected sneakers before proceeding
                            to checkout.
                        </p>

                    </div>

                </div>

            </section>

            <!-- CART CONTENT -->

            <section class="sn-cart">

                <div class="mn-container">

                    <div class="sn-cart">

                        <div class="mn-container">

                            <div class="sn-cart-layout">

                                <div class="sn-cart-items">

                                    <t t-if="not cart_items">
                                        <div class="sn-cart-empty">
                                            <i class="fa fa-shopping-cart"></i>
                                            <h3>Your cart is empty</h3>
                                            <p>Browse our catalog and add your favorite sneakers.</p>
                                            <a href="/shop-sneakers" class="sn-btn-primary">Continue Shopping</a>
                                        </div>
                                    </t>

                                    <!-- Gabarit caché : cart.js clone ce bloc pour l'état "panier vide" sans
                                         rechargement (suppression du dernier article en AJAX), afin de rester
                                         traduit sans dupliquer le texte en dur dans le JS. -->
                                    <div id="sn-cart-empty-template" style="display:none">
                                        <div class="sn-cart-empty">
                                            <i class="fa fa-shopping-cart"></i>
                                            <h3>Your cart is empty</h3>
                                            <p>Browse our catalog and add your favorite sneakers.</p>
                                            <a href="/shop-sneakers" class="sn-btn-primary">Continue Shopping</a>
                                        </div>
                                    </div>

                                    <t t-foreach="cart_items" t-as="item">
                                        <article class="sn-cart-item" t-att-data-line-id="item['line_id']">

                                            <div class="sn-cart-image">

                                                <a t-att-href="item['product_url']">
                                                    <img t-att-src="item['product_image']"
                                                        t-att-alt="item['product_name']"/>
                                                </a>

                                            </div>

                                            <div class="sn-cart-info">

                                                <span class="sn-cart-category" t-out="item['product_category']"/>

                                                <h3><a t-att-href="item['product_url']" t-out="item['product_name']"/></h3>

                                                <div class="sn-cart-attributes">

                                                    <span t-if="item['product_size']">Size : <t t-out="item['product_size']"/></span>

                                                    <span t-if="item['product_color']">Color : <t t-out="item['product_color']"/></span>

                                                </div>

                                                <div class="sn-cart-price" t-out="item['unit_price_html']"/>

                                            </div>

                                            <div class="sn-cart-quantity">

                                                <button class="sn-qty-btn"> - </button>

                                                <input
                                                    type="number"
                                                    t-att-value="item['qty']"
                                                    min="1"/>

                                                <button class="sn-qty-btn"> + </button>

                                            </div>

                                           <div class="sn-cart-total" t-out="item['line_total_html']"/>


                                            <button class="sn-cart-remove">

                                                <i class="fa fa-trash"></i>

                                            </button>

                                        </article>
                                    </t>

                                </div>
                                <!-- ORDER SUMMARY -->                       

                                <aside class="sn-cart-summary">

                                    <div class="sn-cart-summary">

                                        <div class="sn-summary-card">

                                            <h3>
                                                Order Summary
                                            </h3>

                                            <div class="sn-summary-row">

                                                <span>Subtotal</span>

                                                <span class="sn-order-subtotal" t-out="cart_subtotal_html"/>

                                            </div>

                                            <div class="sn-summary-row">

                                                <span>Shipping</span>

                                                <span class="sn-order-shipping">Free</span>

                                            </div>

                                            <div class="sn-summary-row">

                                                <span>Estimated Tax</span>

                                                <span class="sn-order-tax" t-out="cart_tax_html"/>

                                            </div>

                                            <div class="sn-summary-divider"></div>

                                            <div class="sn-summary-row sn-summary-total">

                                                <span>Total</span>

                                                <span class="sn-order-total" t-out="cart_total_html"/>

                                            </div>
                                            
                                            <button class="sn-checkout-btn" t-att-data-empty-label="cart_empty_checkout_label">
                                                <a href="/checkout">
                                                    Proceed to Checkout
                                                </a>
                                            </button>

                                            <a href="/shop-sneakers" class="sn-continue-shopping">

                                                ← Continue Shopping

                                            </a>

                                        </div>

                                        <!-- PROMO CODE -->
                                        <div class="sn-promo-card">

                                            <h4>Promo Code</h4>

                                            <div class="sn-promo-form">

                                                <input
                                                    type="text"
                                                    placeholder="Enter promo code"/>

                                                <button>

                                                    Apply

                                                </button>

                                            </div>

                                        </div>

                                    </div>

                                </aside>

                            </div>

                        </div>

                    </div>

                </div>

            </section>

        </t>

    </template>

</odoo>