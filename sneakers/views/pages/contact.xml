<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="page_contact" name="Sneakers Contact">

        <t t-call="website.layout">

            <div class="oe_structure oe_empty"/>

            <!-- CONTACT HEADER -->
            <section class="sn-contact-header oe_structure oe_empty">

                <div class="mn-container">

                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">Contact</span>

                        <h2>Get in Touch</h2>

                        <p>Have a question or need help? We'd love to hear from you.</p>

                    </div>

                </div>

            </section>

            <!-- CONTACT CONTENT -->
            <section class="sn-contact oe_structure oe_empty">

                <div class="mn-container">

                    <div class="sn-contact-layout">

                        <!-- Contact Form -->
                        <div class="sn-contact-form">

                            <div class="sn-checkout-card">

                                <h3>Send us a Message</h3>

                                <form action="/website_form" method="post" class="sn-contact-form-fields" data-model="mail.mail">

                                    <input type="hidden" name="model_name" value="mail.mail"/>

                                    <div class="sn-form-grid">

                                        <div class="sn-form-group">
                                            <label for="name">Name</label>
                                            <input type="text" name="name" id="name" placeholder="Your name" required="required"/>
                                        </div>

                                        <div class="sn-form-group">
                                            <label for="email">Email</label>
                                            <input type="email" name="email_from" id="email" placeholder="your@email.com" required="required"/>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label for="phone">Phone</label>
                                            <input type="tel" name="phone" id="phone" placeholder="+212 6 00 00 00 00"/>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label for="subject">Subject</label>
                                            <select name="subject" id="subject" required="required">
                                                <option value="">Select a subject</option>
                                                <option value="order">Order Inquiry</option>
                                                <option value="returns">Returns &amp; Exchanges</option>
                                                <option value="shipping">Shipping</option>
                                                <option value="other">Other</option>
                                            </select>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label for="body">Message</label>
                                            <textarea name="body" id="body" rows="5" placeholder="How can we help you?" required="required"/>
                                        </div>

                                    </div>

                                    <button type="submit" class="sn-submit-btn">
                                        Send Message
                                    </button>

                                </form>

                            </div>

                        </div>

                        <!-- Contact Info -->
                        <div class="sn-contact-info">

                            <div class="sn-checkout-card">

                                <h3>Contact Information</h3>

                                <div class="sn-info-item">
                                    <i class="fa fa-map-marker"></i>
                                    <div>
                                        <strong>Address</strong>
                                        <p>Casablanca, Morocco</p>
                                    </div>
                                </div>

                                <div class="sn-info-item">
                                    <i class="fa fa-phone"></i>
                                    <div>
                                        <strong>Phone</strong>
                                        <p>+212 6 00 00 00 00</p>
                                    </div>
                                </div>

                                <div class="sn-info-item">
                                    <i class="fa fa-envelope"></i>
                                    <div>
                                        <strong>Email</strong>
                                        <p>contact@monetiques.fr</p>
                                    </div>
                                </div>

                                <div class="sn-info-item">
                                    <i class="fa fa-clock-o"></i>
                                    <div>
                                        <strong>Hours</strong>
                                        <p>Mon - Fri: 9:00 AM - 6:00 PM</p>
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </section>

        </t>

    </template>

</odoo>
