<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Home Page-->

    <template id="page_home" name="Sneakers Home">

        <t t-call="website.layout">

            <t t-set="title" t-value="'SNEAKERS - Premium Footwear | Sneakers, Running, Basketball'"/>
            <t t-set="description" t-value="'Discover premium sneakers for men, women, and kids. Nike, Adidas, Puma, New Balance. Free shipping on orders over $100.'"/>
            <t t-set="og_title" t-value="'SNEAKERS - Premium Footwear'"/>
            <t t-set="og_description" t-value="'Discover premium sneakers for every lifestyle. Free shipping on orders over $100.'"/>

            <div class="oe_structure oe_empty"/>

            <!-- HERO SLIDER  -->
            <section class="sn-hero oe_structure oe_empty">
                <div class="sn-hero-slider">

                    <!-- Slide 1  -->
                    <article class="sn-slide active">

                        <img class="sn-slide-bg"
                            src="/sneakers/static/src/img/hero/hero-1.jpg"
                            alt="Sneakers Hero"/>

                        <div class="sn-slide-overlay"/>

                        <div class="mn-container sn-slide-inner">
                            <div class="sn-slide-text">

                                <span class="sn-badge">New Collection 2026</span>

                                <h1>Discover the Future<span>of Sneakers</span></h1>

                                <p>Discover premium sneakers from the world's
                                   leading brands. Performance, comfort and
                                   modern style in one place.</p>

                                <div class="sn-buttons">
                                    <a href="/shop" class="sn-btn-primary">Shop Now</a>
                                    <a href="#categories" class="sn-btn-outline">Explore Collection</a>
                                </div>

                            </div>
                        </div>

                    </article>

                    <!-- Slide 2 -->
                    <article class="sn-slide">

                        <img class="sn-slide-bg"
                            src="/sneakers/static/src/img/hero/hero-2.jpg"
                            alt="Running Shoes"/>

                        <div class="sn-slide-overlay"/>

                        <div class="mn-container sn-slide-inner">
                            <div class="sn-slide-text">

                                <span class="sn-badge">Limited Edition</span>

                                <h1>Run Faster<span>Every Day</span></h1>

                                <p>Designed for athletes and everyday comfort.
                                   Lightweight, durable and stylish.</p>

                                <div class="sn-buttons">
                                    <a href="/shop?category=running" class="sn-btn-primary">Shop Running</a>
                                    <a href="/shop" class="sn-btn-outline">Learn More</a>
                                </div>

                            </div>
                        </div>

                    </article>

                    <!-- Slide 3 -->
                    <article class="sn-slide">

                        <img class="sn-slide-bg"
                            src="/sneakers/static/src/img/hero/hero-3.jpg"
                            alt="Sale Sneakers"/>

                        <div class="sn-slide-overlay"/>

                        <div class="mn-container sn-slide-inner">
                            <div class="sn-slide-text">

                                <span class="sn-badge">Up To 50% OFF</span>

                                <h1>Summer Sale<span>Starts Today</span></h1>

                                <p>Take advantage of exclusive discounts on
                                   the biggest sneaker brands before stocks
                                   run out.</p>

                                <div class="sn-buttons">
                                    <a href="/shop?category=sale" class="sn-btn-primary">Shop Sale</a>
                                    <a href="/shop" class="sn-btn-outline">View Offers</a>
                                </div>

                            </div>
                        </div>

                    </article>

                </div>

                <button class="sn-slider-prev" type="button" aria-label="Previous slide">&#10094;</button>
                <button class="sn-slider-next" type="button" aria-label="Next slide">&#10095;</button>

                <div class="sn-slider-dots">
                    <span class="active"></span>
                    <span></span>
                    <span></span>
                </div>

            </section>

            <!-- CATEGORIES SECTION -->

            <section id="categories" class="sn-categories oe_structure oe_empty">

                <div class="mn-container">

                    <!-- Section Header -->

                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">
                            Shop by Category
                        </span>

                        <h2>
                            Find Your Perfect Pair
                        </h2>

                        <p>Browse our carefully selected collections for every
                            lifestyle and activity.</p>

                    </div>

                    <!-- Categories Grid -->

                    <div class="sn-categories-grid">

                        <!-- Men -->
                        <a href="/shop?category=men" class="sn-category-card">

                            <img
                                src="/sneakers/static/src/img/categories/men.jpg"
                                alt="Men Sneakers"/>

                            <div class="sn-category-overlay">

                                <h3>Men</h3>

                                <span>Explore Collection</span>

                            </div>

                        </a>

                        <!-- Women -->
                        <a href="/shop?category=women" class="sn-category-card">

                            <img
                                src="/sneakers/static/src/img/categories/women.jpg"
                                alt="Women Sneakers"/>

                            <div class="sn-category-overlay">

                                <h3>Women</h3>

                                <span>Explore Collection</span>

                            </div>

                        </a>

                        <!-- Running -->
                        <a href="/shop?category=running" class="sn-category-card">

                            <img
                                src="/sneakers/static/src/img/categories/running.jpg"
                                alt="Running Shoes"/>

                            <div class="sn-category-overlay">

                                <h3>Running</h3>

                                <span>Explore Collection</span>

                            </div>

                        </a>

                        <!-- Basketball -->
                        <a href="/shop?category=basketball" class="sn-category-card">

                            <img
                                src="/sneakers/static/src/img/categories/basketball.jpg"
                                alt="Basketball Shoes"/>

                            <div class="sn-category-overlay">

                                <h3>Basketball</h3>

                                <span>Explore Collection</span>

                            </div>

                        </a>

                        <!--Lifestyle-->
                        <a href="/shop?category=lifestyle" class="sn-category-card">

                            <img
                                src="/sneakers/static/src/img/categories/lifestyle.jpg"
                                alt="Lifestyle Shoes"/>

                            <div class="sn-category-overlay">

                                <h3>Lifestyle</h3>

                                <span>Explore Collection</span>

                            </div>

                        </a>

                        <!--Training-->
                        <a href="/shop?category=training" class="sn-category-card">

                            <img
                                src="/sneakers/static/src/img/categories/training.jpg"
                                alt="Training Shoes"/>

                            <div class="sn-category-overlay">

                                <h3>Training</h3>

                                <span>Explore Collection</span>

                            </div>

                        </a>

                    </div>

                </div>

            </section>

            <!-- POPULAR PRODUCTS -->
            <section class="sn-popular-products oe_structure oe_empty">

                <div class="mn-container">

                    <!-- Section Header -->
                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">
                            Best Sellers
                        </span>

                        <h2>
                            Popular Products
                        </h2>

                        <p>
                            Discover our customers' favorite sneakers combining
                            comfort, performance and style.
                        </p>

                    </div>

                    <!-- Products Grid -->
                    <div class="sn-products-grid">
                        

                        <!-- Product 1 -->
                        <t t-call="sneakers.product_card">
                            <t t-set="product_id" t-value="1"/>
                            <t t-set="product_name" t-value="'Nike Air Max 270'"/>
                            <t t-set="product_price" t-value="'$189.00'"/>
                            <t t-set="product_old_price" t-value="'$229.00'"/>
                            <t t-set="product_image" t-value="'/sneakers/static/src/img/products/product-1.jpg'"/>
                            <t t-set="product_badge" t-value="'NEW'"/>
                        </t>

                        <!-- Product 2 -->
                        <t t-call="sneakers.product_card">
                            <t t-set="product_id" t-value="2"/>
                            <t t-set="product_name" t-value="'Adidas Ultraboost'"/>
                            <t t-set="product_price" t-value="'$175.00'"/>
                            <t t-set="product_old_price" t-value="'$210.00'"/>
                            <t t-set="product_image" t-value="'/sneakers/static/src/img/products/product-2.jpg'"/>
                            <t t-set="product_badge" t-value="'HOT'"/>
                        </t>

                        <!-- Product 3 -->
                        <t t-call="sneakers.product_card">
                            <t t-set="product_id" t-value="3"/>
                            <t t-set="product_name" t-value="'Puma RS-X'"/>
                            <t t-set="product_price" t-value="'$145.00'"/>
                            <t t-set="product_old_price" t-value="'$180.00'"/>
                            <t t-set="product_image" t-value="'/sneakers/static/src/img/products/product-3.jpg'"/>
                            <t t-set="product_badge" t-value="'SALE'"/>
                        </t>

                        <!-- Product 4 -->
                        <t t-call="sneakers.product_card">
                            <t t-set="product_id" t-value="4"/>
                            <t t-set="product_name" t-value="'New Balance 550'"/>
                            <t t-set="product_price" t-value="'$165.00'"/>
                            <t t-set="product_old_price" t-value="'$195.00'"/>
                            <t t-set="product_image" t-value="'/sneakers/static/src/img/products/product-4.jpg'"/>
                            <t t-set="product_badge" t-value="'NEW'"/>
                        </t>

                        <!-- Product 5 -->
                        <t t-call="sneakers.product_card">
                            <t t-set="product_id" t-value="5"/>
                            <t t-set="product_name" t-value="'Nike Dunk Low'"/>
                            <t t-set="product_price" t-value="'$155.00'"/>
                            <t t-set="product_old_price" t-value="'$190.00'"/>
                            <t t-set="product_image" t-value="'/sneakers/static/src/img/products/product-5.jpg'"/>
                            <t t-set="product_badge" t-value="'BEST'"/>
                        </t>

                        <!-- Product 6 -->
                        <t t-call="sneakers.product_card">
                            <t t-set="product_id" t-value="6"/>
                            <t t-set="product_name" t-value="'Jordan One High'"/>
                            <t t-set="product_price" t-value="'$249.00'"/>
                            <t t-set="product_old_price" t-value="'$299.00'"/>
                            <t t-set="product_image" t-value="'/sneakers/static/src/img/products/product-6.jpg'"/>
                            <t t-set="product_badge" t-value="'LIMITED'"/>
                        </t>

                        <!-- Product 7 -->
                        <t t-call="sneakers.product_card">
                            <t t-set="product_id" t-value="7"/>
                            <t t-set="product_name" t-value="'Converse Chuck 70'"/>
                            <t t-set="product_price" t-value="'$119.00'"/>
                            <t t-set="product_old_price" t-value="'$149.00'"/>
                            <t t-set="product_image" t-value="'/sneakers/static/src/img/products/product-7.jpg'"/>
                            <t t-set="product_badge" t-value="'SALE'"/>
                        </t>

                        <!-- Product 8 -->
                        <t t-call="sneakers.product_card">
                            <t t-set="product_id" t-value="8"/>
                            <t t-set="product_name" t-value="'Asics Gel Kayano'"/>
                            <t t-set="product_price" t-value="'$199.00'"/>
                            <t t-set="product_old_price" t-value="'$235.00'"/>
                            <t t-set="product_image" t-value="'/sneakers/static/src/img/products/product-8.jpg'"/>
                            <t t-set="product_badge" t-value="'NEW'"/>
                        </t>

                    </div>

                    <!-- Button -->
                    <div class="sn-products-button">

                        <a href="/shop" class="sn-btn-primary">View All Products</a>

                    </div>

                </div>

            </section>

            <!-- WHY CHOOSE US / FEATURES -->

            <section class="sn-features oe_structure oe_empty">

                <div class="mn-container">

                    <!-- Section Header -->
                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">
                            Why Choose Us
                        </span>

                        <h2>
                            Shopping Made Easy
                        </h2>

                        <p>
                            We provide premium products and exceptional service to
                            make every purchase a great experience.
                        </p>

                    </div>

                    <!-- Features Grid -->

                    <div class="sn-features-grid">

                        <!-- Feature 1 -->
                        <div class="sn-feature-card">

                            <div class="sn-feature-icon">

                                <i class="fa fa-truck"/>

                            </div>

                            <h3>Free Shipping</h3>

                            <p>
                                Enjoy free delivery on all orders above $100.
                            </p>

                        </div>

                        <!-- Feature 2 -->
                        <div class="sn-feature-card">

                            <div class="sn-feature-icon">

                                <i class="fa fa-refresh"/>

                            </div>

                            <h3>Easy Returns</h3>

                            <p>
                                Return your products within 30 days with no hassle.
                            </p>

                        </div>

                        <!-- Feature 3 -->
                        <div class="sn-feature-card">

                            <div class="sn-feature-icon">

                                <i class="fa fa-lock"/>

                            </div>

                            <h3>Secure Payment</h3>

                            <p>
                                Your payments are protected with secure encryption.
                            </p>

                        </div>

                        <!-- Feature 4 -->
                        <div class="sn-feature-card">

                            <div class="sn-feature-icon">

                                <i class="fa fa-headphones"/>

                            </div>

                            <h3>24/7 Support</h3>

                            <p>
                                Our support team is available anytime you need help.
                            </p>

                        </div>

                    </div>

                </div>

            </section>

            <!-- BRANDS SECTION -->

            <section class="sn-brands oe_structure oe_empty">

                <div class="mn-container">

                    <!-- Section Header -->
                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">
                            Trusted Brands
                        </span>

                        <h2>
                            Our Top Brands
                        </h2>

                        <p>
                            We collaborate with the world's leading sneaker brands
                            to provide authentic and premium-quality products.
                        </p>

                    </div>

                    <!-- Brands Grid -->
                    <div class="sn-brands-grid">

                        <div class="sn-brand-card">
                            <img src="/sneakers/static/src/img/brands/nike.png"
                                 alt="Nike"/>
                        </div>

                        <div class="sn-brand-card">
                            <img src="/sneakers/static/src/img/brands/adidas.png"
                                 alt="Adidas"/>
                        </div>

                        <div class="sn-brand-card">
                            <img src="/sneakers/static/src/img/brands/newbalance.png"
                                 alt="New Balance"/>
                        </div>

                        <div class="sn-brand-card">
                            <img src="/sneakers/static/src/img/brands/vans.png"
                                 alt="Vans"/>
                        </div>

                        <div class="sn-brand-card">
                            <img src="/sneakers/static/src/img/brands/converse.png"
                                 alt="Converse"/>
                        </div>

                    </div>

                </div>

            </section>

            <!-- NEWSLETTER -->

            <section class="sn-newsletter oe_structure oe_empty">

                <div class="mn-container">

                    <div class="sn-newsletter-content">

                        <div class="sn-newsletter-text">

                            <span class="sn-section-subtitle">
                                Newsletter
                            </span>

                            <h2>
                                Stay Updated With Our Latest Offers
                            </h2>

                            <p>
                                Subscribe to receive exclusive promotions,
                                new arrivals and limited edition sneaker releases.
                            </p>

                        </div>

                        <div class="sn-newsletter-form">

                            <form action="#" method="post">

                                <input
                                    type="email"
                                    placeholder="Enter your email address"
                                    required="required"/>

                                <button type="submit">Subscribe</button>

                            </form>

                        </div>

                    </div>

                </div>

            </section>

        </t>

    </template>

</odoo>