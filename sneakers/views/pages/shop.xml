<?xml version="1.0" encoding="UTF-8"?>
<odoo>

<template id="shop_page" name="Sneakers Shop">

<t t-call="website.layout">

    <div class="oe_structure oe_empty"/>


    <!-- SHOP BANNER -->

            <section class="sn-shop-banner oe_structure oe_empty">


        <div class="mn-container">


            <div class="sn-shop-banner__content">


                <span class="sn-shop-subtitle">

                    Sneakers Collection

                </span>



                <h1>

                    Shop All Sneakers

                </h1>



                <p>

                    Discover our latest collection with premium quality,
                    modern design and exclusive offers.

                </p>




                <!-- Breadcrumb -->


                <div class="sn-breadcrumb">


                    <a href="/">
                        Home
                    </a>


                    <span>
                        /
                    </span>


                    <span>
                        Shop
                    </span>



                </div>



            </div>


        </div>


    </section>





    <!-- SHOP CONTENT -->


            <section class="sn-shop oe_structure oe_empty">


        <div class="mn-container">


            <div class="sn-shop-layout">





                <!-- SIDEBAR -->


                <aside class="sn-shop-sidebar">



                    <!-- Categories -->


                    <div class="sn-filter-box">


                        <h3>
                            Categories
                        </h3>
                        <ul class="sn-filter-list">

                            <t t-if="subcategories">

                                <t t-foreach="subcategories" t-as="subcategory">

                                    <li>

                                        <t t-if="selected_category">
                                            <a t-att-href="'/shop-sneakers?category=%s&amp;subcategory=%s' % (selected_category.name.lower(), subcategory.id)">
                                                <t t-out="subcategory.name"/>
                                            </a>
                                        </t>

                                        <t t-else="">
                                            <a t-att-href="'/shop-sneakers?subcategory=%s' % subcategory.id">
                                                <t t-out="subcategory.name"/>
                                            </a>
                                        </t>

                                    </li>

                                </t>

                            </t>

                            <t t-else="">

                                <li>
                                    No categories available
                                </li>

                            </t>

                        </ul>
                    </div>





                    <!-- Brands -->


                    <div class="sn-filter-box">


                        <h3>
                            Brands
                        </h3>

                        <t t-foreach="brands" t-as="brand">

                            <label class="sn-checkbox">

                                <input 
                                    type="checkbox"
                                    t-att-value="brand.id"
                                    t-att-data-brand-name="brand.name"
                                />

                                <t t-out="brand.name"/>

                            </label>

                        </t>
                    </div>


                    <!-- Sizes -->


                    <div class="sn-filter-box">

                        <h3>
                            Sizes
                        </h3>

                        <div class="sn-size-list">

                            <t t-foreach="sizes" t-as="size">

                                <button
                                    type="button"
                                    class="sn-size-btn"
                                    t-att-data-size="size.name">

                                    <t t-out="size.name"/>

                                </button>

                            </t>

                        </div>

                    </div>

                    <!-- Colors -->

                    <div class="sn-filter-box">

                        <h3>
                            Colors
                        </h3>


                        <div class="sn-color-list">

                            <t t-foreach="colors" t-as="color">

                                <span
                                    class="sn-color-swatch"
                                    t-att-data-color-id="color.id"
                                    t-att-title="color.name"
                                    t-att-style="'background-color:%s; border:1px solid #d1d5db;' % color.html_color">
                                </span>

                            </t>

                        </div>

                    </div>

                    <!-- Price -->

                    <div class="sn-filter-box">

                        <h3>
                            Price
                        </h3>


                        <div class="sn-price-filter">

                            <div class="sn-price-labels">

                                <span class="sn-price-label-min">
                                    $0
                                </span>


                                <span class="sn-price-label-max">
                                    $500
                                </span>

                            </div>


                            <div class="sn-price-range-wrap">

                                <input
                                    type="range"
                                    class="sn-price-min"
                                    min="0"
                                    max="500"
                                    value="0"
                                    step="5"/>


                                <input
                                    type="range"
                                    class="sn-price-slider"
                                    min="0"
                                    max="500"
                                    value="500"
                                    step="5"/>

                            </div>

                        </div>

                    </div>

                    <!-- Availability -->

                    <div class="sn-filter-box">

                        <h3>
                            Availability
                        </h3>


                        <label class="sn-checkbox">

                            <input
                                type="radio"
                                name="availability"
                                class="sn-availability-toggle"
                                value="in_stock"/>

                            In Stock

                        </label>


                        <label class="sn-checkbox">

                            <input
                                type="radio"
                                name="availability"
                                class="sn-availability-toggle"
                                value="out_of_stock"/>

                            Out of Stock

                        </label>


                    </div>

                </aside>
                                <!-- PRODUCTS -->


                <div class="sn-shop-products">



                    <!-- Sorting Bar -->


                    <div class="sn-sorting-bar">



                        <!-- Products Counter -->


                        <div class="sn-products-count">


                            <p>


                                Showing


                                <strong>

                                    <t t-out="len(products)"/>

                                </strong>



                                products



                            </p>



                        </div>







                        <!-- Actions -->


                        <div class="sn-sorting-actions">





                            <!-- Sort -->


                            <div class="sn-sort-box">


                                <label for="sort-products">


                                    Sort by


                                </label>



                                <select 
                                    id="sort-products"
                                    class="sn-sort-select">


                                    <option value="popular">

                                        Popularity

                                    </option>



                                    <option value="newest">

                                        Newest

                                    </option>



                                    <option value="price-low">

                                        Price : Low to High

                                    </option>



                                    <option value="price-high">

                                        Price : High to Low

                                    </option>



                                </select>



                            </div>







                            <!-- View Mode -->


                            <div class="sn-view-mode">


                                <button aria-label="List View">


                                    <i class="fa-solid fa-list"></i>


                                </button>



                            </div>



                        </div>




                    </div>








                    <!-- Active Filters -->


                    <div class="sn-active-filters">


                        <button class="sn-clear-filters">


                            Clear All


                        </button>



                    </div>









                    <!-- PRODUCT GRID -->

<div class="sn-product-grid">


    <t t-foreach="products" t-as="p">


        <t t-call="sneakers.product_card">

            <t t-set="product" t-value="p"/>

        </t>


    </t>


</div>

                                        <!-- Pagination -->


                    <div class="sn-shop-pagination">


                        <nav class="sn-pagination">



                            <button class="sn-page-btn">


                                <i class="fa fa-chevron-left"></i>


                            </button>





                            <button class="sn-page-btn active">

                                1

                            </button>





                            <button class="sn-page-btn">

                                2

                            </button>





                            <button class="sn-page-btn">

                                3

                            </button>





                            <span class="sn-pagination-dots">

                                ...

                            </span>





                            <button class="sn-page-btn">

                                10

                            </button>





                            <button class="sn-page-btn">


                                <i class="fa fa-chevron-right"></i>


                            </button>





                        </nav>



                    </div>





                </div>
                <!-- END sn-shop-products -->




            </div>
            <!-- END sn-shop-layout -->



        </div>
        <!-- END mn-container -->



    </section>
    <!-- END sn-shop -->



</t>


</template>


</odoo>
