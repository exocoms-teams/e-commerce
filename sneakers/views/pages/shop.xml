<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="shop_page" name="Sneakers Shop">

        <t t-call="website.layout">

            <!-- SHOP BANNER -->
            <section class="sn-shop-banner">

                <div class="mn-container">

                    <div class="sn-shop-banner__content">

                        <span class="sn-shop-subtitle">
                            Sneakers Collection
                        </span>

                        <h1>
                            Shop All Sneakers
                        </h1>

                        <p>
                            Discover our latest collection with premium quality,
                            modern design and exclusive offers.
                        </p>

                        <!-- Breadcrumb -->

                        <div class="sn-breadcrumb">

                            <a href="/">Home</a>

                            <span>/</span>

                            <span>Shop</span>

                        </div>

                    </div>

                </div>

            </section>

            <!-- SHOP CONTENT -->
            <section class="sn-shop">

                <div class="mn-container">

                    <div class="sn-shop-layout">

                        <aside class="sn-shop-sidebar">

                            <div class="sn-filter-box">

                                <h3>Categories</h3>

                                <ul class="sn-filter-list">

                                    <li>
                                        <a t-att-href="all_categories_url"
                                            t-att-class="'active' if not active_category_id else None"
                                            t-att-aria-current="'page' if not active_category_id else None">All</a>
                                    </li>

                                    <t t-foreach="category_links" t-as="category">
                                        <li>
                                            <a t-att-href="category['url']"
                                                t-att-class="'active' if category['active'] else None"
                                                t-att-aria-current="'page' if category['active'] else None">
                                                <t t-out="category['name']"/>
                                            </a>
                                        </li>
                                    </t>

                                </ul>

                            </div>

                            <div class="sn-filter-box">

                                <h3>Brands</h3>

                                <t t-foreach="brand_links" t-as="brand_link">
                                    <label class="sn-checkbox">

                                        <input type="checkbox"
                                            t-att-checked="'checked' if brand_link['active'] else None"
                                            t-attf-onchange="location.href='#{brand_link['url']}'"/>

                                        <t t-out="brand_link['label']"/>

                                    </label>
                                </t>

                            </div>

                            <div class="sn-filter-box">

                                <h3>Sizes</h3>

                                <div class="sn-size-list">

                                    <t t-foreach="size_links" t-as="size_link">
                                        <button t-attf-class="#{'active' if size_link['active'] else ''}"
                                            t-attf-onclick="location.href='#{size_link['url']}'">
                                            <t t-out="size_link['label']"/>
                                        </button>
                                    </t>

                                </div>

                            </div>

                            <div class="sn-filter-box">

                                <h3>Colors</h3>

                                <div class="sn-color-list">

                                    <t t-foreach="color_links" t-as="color_link">
                                        <span t-attf-class="sn-color #{color_link['key']} #{'active' if color_link['active'] else ''}"
                                            t-att-title="color_link['label']"
                                            t-attf-onclick="location.href='#{color_link['url']}'"></span>
                                    </t>

                                </div>

                            </div>

                            <div class="sn-filter-box">

                                <h3>Price</h3>

                                <div class="sn-price-range">

                                    <div class="sn-price-range-values">
                                        <span>$<t t-out="active_price_min"/></span>
                                        <span>$<t t-out="active_price_max"/></span>
                                    </div>

                                    <div class="sn-price-range-slider">

                                        <div class="sn-price-range-track"></div>
                                        <div class="sn-price-range-fill"
                                            t-attf-style="left:#{price_min_pct}%;right:#{100 - price_max_pct}%;"></div>

                                        <input type="range"
                                            class="sn-price-range-min"
                                            t-att-min="catalog_price_min"
                                            t-att-max="catalog_price_max"
                                            t-att-value="active_price_min"
                                            aria-label="Prix minimum"
                                            onchange="var u=new window.URL(window.location.href); u.searchParams.set('price_min', Math.min(this.value, u.searchParams.get('price_max') || this.max)); u.searchParams.delete('page'); window.location.href=u.toString();"/>

                                        <input type="range"
                                            class="sn-price-range-max"
                                            t-att-min="catalog_price_min"
                                            t-att-max="catalog_price_max"
                                            t-att-value="active_price_max"
                                            aria-label="Prix maximum"
                                            onchange="var u=new window.URL(window.location.href); u.searchParams.set('price_max', Math.max(this.value, u.searchParams.get('price_min') || this.min)); u.searchParams.delete('page'); window.location.href=u.toString();"/>

                                    </div>

                                </div>

                            </div>

                            <div class="sn-filter-box">

                                <h3>Availability</h3>

                                <t t-foreach="availability_links" t-as="avail_link">
                                    <label class="sn-checkbox">

                                        <input type="checkbox"
                                            t-att-checked="'checked' if avail_link['active'] else None"
                                            t-attf-onchange="location.href='#{avail_link['url']}'"/>

                                        <t t-out="avail_link['label']"/>

                                    </label>
                                </t>

                            </div>

                        </aside>

                        <!-- PRODUCTS -->

                        <div class="sn-shop-products">

                            <!-- Sorting Bar -->

                            <div class="sn-sorting-bar">

                                <!-- Products Counter -->

                                <div class="sn-products-count">

                                    <p>

                                        Showing
                                        <strong><t t-out="range_start"/> - <t t-out="range_end"/></strong>
                                        of
                                        <strong><t t-out="total_products"/></strong>
                                        products
                                        <t t-if="search"> for "<t t-out="search"/>"</t>

                                    </p>

                                </div>

                                <!-- Actions -->

                                <div class="sn-sorting-actions">

                                    <!-- Sort -->

                                    <div class="sn-sort-box">

                                        <label for="sort-products">

                                            Sort by

                                        </label>

                                        <select id="sort-products"
                                            onchange="window.location.href = this.options[this.selectedIndex].dataset.url;">

                                            <t t-foreach="sort_links" t-as="sort_option">
                                                <option t-att-value="sort_option['value']"
                                                    t-att-data-url="sort_option['url']"
                                                    t-att-selected="'selected' if sort_option['value'] == sort_by else None">
                                                    <t t-out="sort_option['label']"/>
                                                </option>
                                            </t>

                                        </select>

                                    </div>

                                    <!-- View Mode list -->

                                    <div class="sn-view-mode">

                                        <button
                                            aria-label="List View">

                                            <i class="fa-solid fa-list"></i>

                                        </button>

                                    </div>

                                </div>

                            </div>

                            <!-- Active Filters -->

                            <div class="sn-active-filters" t-if="has_active_filters">

                                <t t-foreach="active_filter_tags" t-as="filter_tag">
                                    <a class="sn-filter-chip" t-att-href="filter_tag['url']">
                                        <t t-out="filter_tag['label']"/>
                                        <span aria-hidden="true">×</span>
                                    </a>
                                </t>

                                <a class="sn-clear-filters" t-att-href="clear_filters_url">Clear All</a>

                            </div>

                            <!-- Product Grid -->

                            <div class="sn-product-grid">

                                <t t-foreach="products" t-as="product">

                                    <t t-call="sneakers.product_card">
                                        <t t-set="product_id" t-value="product['product_id']"/>
                                        <t t-set="product_name" t-value="product['product_name']"/>
                                        <t t-set="product_image" t-value="product['product_image']"/>
                                        <t t-set="product_price" t-value="product['product_price']"/>
                                        <t t-set="product_old_price" t-value="product['product_old_price']"/>
                                        <t t-set="product_badge" t-value="product['product_badge']"/>
                                        <t t-set="product_url" t-value="product['product_url']"/>
                                        <t t-set="product_brand" t-value="product['product_brand']"/>
                                        <t t-set="product_color" t-value="product['product_color']"/>
                                        <t t-set="product_size" t-value="product['product_size']"/>
                                        <t t-set="product_in_stock" t-value="product['product_in_stock']"/>
                                    </t>

                                </t>

                            </div>

                            <!-- Pagination -->

                            <t t-if="total_pages > 1">
                                <div class="sn-shop-pagination">
                                    <nav class="sn-pagination">
                                        <a t-if="prev_url" t-att-href="prev_url" class="sn-page-btn"><i class="fa fa-chevron-left"></i></a>
                                        <t t-foreach="pages" t-as="page_link">
                                            <a t-att-href="page_link['url']"
                                                t-attf-class="sn-page-btn#{' active' if page_link['active'] else ''}">
                                                <t t-out="page_link['number']"/>
                                            </a>
                                        </t>
                                        <a t-if="next_url" t-att-href="next_url" class="sn-page-btn"><i class="fa fa-chevron-right"></i></a>
                                    </nav>
                                </div>
                            </t>


                        </div>

                    </div>

                </div>

            </section>

        </t>

    </template>

</odoo>