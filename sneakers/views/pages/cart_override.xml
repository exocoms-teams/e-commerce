<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Sneaker cart design, ONLY on websites with the theme flag on.
         The stock website_sale.checkout_layout call is kept byte-for-byte
         untouched: we merely skip it (t-if) on sneaker websites, so every
         other website keeps rendering Odoo's standard cart. -->
    <template id="cart_override" inherit_id="website_sale.cart" name="Sneakers Cart Override">
        <xpath expr="//t[@t-call='website_sale.checkout_layout']" position="before">
            <t t-if="website.x_sneakers_theme">
                <t t-set="order" t-value="website_sale_order"/>
                <t t-set="delivery_price" t-value="0"/>
                <t t-set="delivery_methods" t-value="[]"/>
                <t t-set="order_total" t-value="website_sale_order.amount_total if website_sale_order else 0"/>
                <t t-call="website.layout">
                    <t t-call="sneakers.page_cart_content"/>
                </t>
            </t>
        </xpath>
        <xpath expr="//t[@t-call='website_sale.checkout_layout']" position="attributes">
            <attribute name="t-if">not website.x_sneakers_theme</attribute>
        </xpath>
    </template>

</odoo>
