<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <template
        id="page_wishlist"
        name="Wishlist">

        <t t-call="website.layout">

            <div class="oe_structure oe_empty"/>

            <div id="wrap">

                <!-- Wishlist Header -->
                <section class="sn-wishlist-header oe_structure oe_empty">

                    <div class="mn-container">

                        <div class="sn-section-header">

                            <span class="sn-section-subtitle">
                                Wishlist
                            </span>

                            <h2>
                                Your Favorite Sneakers
                            </h2>

                            <p>
                                Save your favorite sneakers in one place and easily move them
                                to your shopping cart whenever you're ready.
                            </p>

                        </div>

                    </div>

                </section>

                <!-- Wishlist Products -->
                <section class="sn-wishlist-products oe_structure oe_empty">

                    <div class="mn-container">

                        <div class="sn-wishlist-top">

                            <div>

                                <h3>
                                    Saved Items
                                </h3>

                                <p>
                                    6 products saved in your wishlist.
                                </p>

                            </div>

                                <a href="/shop-sneakers" class="sn-btn-outline-wl">

                                Continue Shopping →

                            </a>

                        </div>

                        <div class="sn-products-grid">

                            <!-- Product 1 -->
                            <t t-call="sneakers.product_card"/>

                            <!-- Product 2 -->
                            <t t-call="sneakers.product_card"/>

                            <!-- Product 3 -->
                            <t t-call="sneakers.product_card"/>

                            <!-- Product 4 -->
                            <t t-call="sneakers.product_card"/>

                            <!-- Product 5 -->
                            <t t-call="sneakers.product_card"/>

                            <!-- Product 6 -->
                            <t t-call="sneakers.product_card"/>

                        </div>

                    </div>

                </section>

                <!-- Empty Wishlist -->
                <section class="sn-empty-wishlist oe_structure oe_empty">

                    <div class="mn-container">

                        <div class="sn-empty-card">

                            <div class="sn-empty-icon">

                                <i class="fa fa-heart-o" aria-hidden="true"></i>

                            </div>

                            <h3>

                                Your Wishlist is Empty

                            </h3>

                            <p>

                                You haven't added any sneakers to your wishlist yet.
                                Discover our latest collection and save your favorite pairs.

                            </p>

                                <a href="/shop-sneakers" class="sn-btn-primary">

                                    Explore Collection

                                </a>

                                <a href="/" class="sn-btn-outline-wl">

                                    ← Back to Home

                                </a>

                        </div>

                    </div>

                </section>

                
                <!-- ========================================================= -->
                <!-- NEWSLETTER                                                 -->
                <!-- ========================================================= -->

                <!-- Newsletter -->
                <section class="sn-newsletter oe_structure oe_empty">

                    <div class="mn-container">

                        <div class="sn-newsletter-content">

                            <div class="sn-newsletter-text">

                                <span class="sn-section-subtitle">

                                    Newsletter

                                </span>

                                <h2>

                                    Stay Updated with Our Latest Sneakers

                                </h2>

                                <p>

                                    Subscribe to receive exclusive offers, new arrivals,
                                    limited editions and special discounts directly in your inbox.

                                </p>

                            </div>

                            <div class="sn-newsletter-form">

                                <form action="#" method="post">

                                    <input
                                        type="email"
                                        placeholder="Enter your email address"
                                        required="required"/>

                                    <button type="submit">Subscribe</button>

                                </form>

                            </div>

                        </div>

                    </div>

                </section>

                <section class="sn-wishlist-summary oe_structure oe_empty">

                    <div class="mn-container">

                        <div class="sn-summary-box">

                            <div>
                                <h3>Love these sneakers?</h3>
                                <p>
                                    Move your favorite items to your shopping cart and complete
                                    your purchase in just a few clicks.
                                </p>
                            </div>

                            <a href="/cart" class="sn-btn-primary">

                                View Cart

                            </a>

                        </div>

                    </div>

                </section>


            </div>

        </t>

    </template>

</odoo>