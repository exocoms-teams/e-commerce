<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="page_checkout" name="Sneakers Checkout">

        <t t-call="website.layout">

            <t t-set="body_class" t-value="'sn-checkout-page'"/>
            <t t-set="title" t-value="'Checkout — Sneakers'"/>
            <t t-set="description" t-value="'Complete your order securely. Fast checkout with multiple payment options.'"/>
            <div class="oe_structure oe_empty"/>

            <!-- CHECKOUT HEADER -->
            <section class="sn-checkout-header oe_structure oe_empty">

                <div class="mn-container">

                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">
                            Checkout
                        </span>

                        <h2>
                            Complete Your Order
                        </h2>

                        <p>
                            Enter your shipping information and review your
                            order before confirming your purchase.
                        </p>

                    </div>

                </div>

            </section>

            <!-- CHECKOUT PROGRESS  -->
            <section class="sn-checkout-progress oe_structure oe_empty">

                <div class="mn-container">

                    <div class="sn-progress-container">

                        <div class="sn-progress-line"></div>

                        <div class="sn-progress-step active">

                            <div class="sn-step-circle">1</div>

                            <span>Cart</span>

                        </div>

                        <div class="sn-progress-step">

                            <div class="sn-step-circle">
                                2
                            </div>

                            <span>Address</span>

                        </div>

                        <div class="sn-progress-step">

                            <div class="sn-step-circle">
                                3
                            </div>

                            <span>Shipping</span>

                        </div>

                        <div class="sn-progress-step">

                            <div class="sn-step-circle">
                                4
                            </div>

                            <span>Payment</span>

                        </div>

                    </div>

                </div>

            </section>

            <!-- CHECKOUT CONTENT -->
            <section class="sn-checkout oe_structure oe_empty">

                <div class="mn-container">

                    <div class="sn-checkout-layout">

                        <div class="sn-checkout-form">

                            <div class="sn-checkout-form">

                                <div class="sn-checkout-card">

                                    <h3>Billing Address</h3>

                                    <div class="sn-form-grid">

                                        <div class="sn-form-group">
                                            <label>First Name</label>
                                            <input type="text" placeholder="John"/>
                                        </div>

                                        <div class="sn-form-group">
                                            <label>Last Name</label>
                                            <input type="text" placeholder="Doe"/>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label>Email Address</label>
                                            <input type="email" placeholder="john@example.com"/>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label>Phone Number</label>
                                            <input type="tel" placeholder="+212 6 00 00 00 00"/>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label>Street Address</label>
                                            <input type="text" placeholder="123 Main Street"/>
                                        </div>

                                        <div class="sn-form-group">
                                            <label>City</label>
                                            <input type="text" placeholder="Casablanca"/>
                                        </div>

                                        <div class="sn-form-group">
                                            <label>Postal Code</label>
                                            <input type="text" placeholder="20000"/>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label>Country</label>
                                            <select>
                                                <option>Morocco</option>
                                                <option>France</option>
                                                <option>Spain</option>
                                            </select>
                                        </div>

                                    </div>

                                </div>

                                <!-- SHIPPING METHOD -->
                                <div class="sn-checkout-card">

                                    <h3>Shipping Method</h3>

                                    <t t-if="delivery_methods">
                                        <form method="post" action="/shop/select_delivery_method" class="sn-delivery-method">
                                            <t t-foreach="delivery_methods" t-as="method">
                                                <label class="sn-radio-card">
                                                    <input type="radio" name="delivery_method_id" t-att-value="method.id" t-att-checked="method.id == delivery_carrier"/>
                                                    <div>
                                                        <strong t-esc="method.name"/>
                                                        <p t-if="method.carrier_description" t-esc="method.carrier_description"/>
                                                    </div>
                                                    <t t-if="method.product_id">
                                                        <t t-if="method.product_id.lst_price > 0">
                                                            <span t-esc="'%.2f $' % method.product_id.lst_price"/>
                                                        </t>
                                                        <t t-else="">
                                                            <span>Free</span>
                                                        </t>
                                                    </t>
                                                </label>
                                            </t>
                                        </form>
                                    </t>
                                    <t t-else="">
                                        <label class="sn-radio-card">
                                            <input type="radio" name="shipping" checked="checked"/>
                                            <div>
                                                <strong>Standard Delivery</strong>
                                                <p>3-5 business days</p>
                                            </div>
                                            <span>Free</span>
                                        </label>
                                    </t>

                                </div>

                                <!-- PAYMENT METHOD -->
                                <div class="sn-checkout-card">

                                    <h3>Payment Method</h3>

                                    <label class="sn-radio-card">
                                        <input type="radio" name="payment" value="card"/>
                                        <div>
                                            <div class="sn-radio-title">
                                                <i class="fa fa-credit-card"></i>
                                                <strong>Credit Card</strong>
                                            </div>
                                            <p>Visa, Mastercard, American Express</p>
                                        </div>
                                    </label>

                                    <label class="sn-radio-card">
                                        <input type="radio" name="payment" value="paypal"/>
                                        <div>
                                            <div class="sn-radio-title">
                                                <i class="fa fa-paypal"></i>
                                                <strong>PayPal</strong>
                                            </div>
                                            <p>Pay via your PayPal account</p>
                                        </div>
                                    </label>

                                    <label class="sn-radio-card">
                                        <input type="radio" name="payment" value="cash"/>
                                        <div>
                                            <div class="sn-radio-title">
                                                <i class="fa fa-money"></i>
                                                <strong>Cash on Delivery</strong>
                                            </div>
                                            <p>Pay when your order arrives</p>
                                        </div>
                                    </label>

                                </div>

                            </div>

                        </div>

                       <aside class="sn-checkout-summary">
                            <div class="sn-summary-card">

                                <h3>
                                    Order Summary
                                </h3>

                                <!-- Dynamic Cart Lines -->

                                <t t-foreach="order.order_line" t-as="line">
                                    <div class="sn-summary-product">

                                        <t t-if="line.product_id.image_256">
                                            <img t-att-src="'/web/image/product.product/%d/image_128' % line.product_id.id"
                                                t-att-alt="line.product_id.name"/>
                                        </t>
                                        <t t-else="">
                                            <img src="/sneakers/static/src/img/products/product-1.jpg"
                                                t-att-alt="line.product_id.name"/>
                                        </t>

                                        <div>
                                            <h4 t-esc="line.product_id.name"/>
                                            <span t-esc="'Qty : %d' % line.product_uom_qty"/>
                                        </div>

                                        <strong t-esc="currency.symbol + '%.2f' % line.price_subtotal"/>

                                    </div>
                                </t>

                                <!-- Totals -->

                                <div class="sn-summary-divider"></div>

                                <div class="sn-summary-row">
                                    <span>Subtotal</span>
                                    <span t-esc="currency.symbol + '%.2f' % order.amount_untaxed"/>
                                </div>

                                <div class="sn-summary-row">
                                    <span>Shipping</span>
                                    <t t-if="delivery_price > 0">
                                        <span t-esc="currency.symbol + '%.2f' % delivery_price"/>
                                    </t>
                                    <t t-else="">
                                        <span>Free</span>
                                    </t>
                                </div>

                                <div class="sn-summary-row">
                                    <span>Tax</span>
                                    <span t-esc="currency.symbol + '%.2f' % order.amount_tax"/>
                                </div>

                                <div class="sn-promo-section">
                                    <t t-set="redirect" t-value="'/shop/checkout'"/>
                                    <t t-call="website_sale.coupon_form"/>
                                </div>

                                <div class="sn-summary-divider"></div>

                                <div class="sn-summary-row sn-summary-total">
                                    <span>Total</span>
                                    <span t-esc="currency.symbol + '%.2f' % order.amount_total"/>
                                </div>

                                <!-- Place Order -->

                                <a href="/shop/payment" class="sn-place-order-btn" style="display:block;text-align:center;text-decoration:none;">
                                    Place Order
                                </a>

                                <!-- Back -->

                                <a href="/shop/cart" class="sn-back-cart">

                                    ← Back to Cart

                                </a>

                            </div>

                        </aside>

                    </div>

                </div>

            </section>

        </t>

    </template>

</odoo>