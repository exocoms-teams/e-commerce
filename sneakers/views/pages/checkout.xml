<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="page_checkout" name="Sneakers Checkout">

        <t t-call="website.layout">

            <t t-set="title" t-value="'Checkout | SNEAKERS Premium Footwear'"/>
            <t t-set="description" t-value="'Complete your order securely at SNEAKERS.'"/>

            <div class="oe_structure oe_empty"/>

            <!-- CHECKOUT HEADER -->
            <section class="sn-checkout-header oe_structure oe_empty">

                <div class="mn-container">

                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">
                            Checkout
                        </span>

                        <h2>
                            Complete Your Order
                        </h2>

                        <p>
                            Enter your shipping information and review your
                            order before confirming your purchase.
                        </p>

                    </div>

                </div>

            </section>

            <!-- CHECKOUT PROGRESS  -->
            <section class="sn-checkout-progress oe_structure oe_empty">

                <div class="mn-container">

                    <div class="sn-progress-container">

                        <div class="sn-progress-line"></div>

                        <div class="sn-progress-step active">

                            <div class="sn-step-circle">1</div>

                            <span>Cart</span>

                        </div>

                        <div class="sn-progress-step">

                            <div class="sn-step-circle">
                                2
                            </div>

                            <span>Address</span>

                        </div>

                        <div class="sn-progress-step">

                            <div class="sn-step-circle">
                                3
                            </div>

                            <span>Shipping</span>

                        </div>

                        <div class="sn-progress-step">

                            <div class="sn-step-circle">
                                4
                            </div>

                            <span>Payment</span>

                        </div>

                    </div>

                </div>

            </section>

            <!-- CHECKOUT CONTENT -->
            <section class="sn-checkout oe_structure oe_empty">

                <div class="mn-container">

                    <div class="sn-checkout-layout">

                        <div class="sn-checkout-form">

                            <div class="sn-checkout-form">

                                <div class="sn-checkout-card">

                                    <h3>Billing Address</h3>

                                    <div class="sn-form-grid">

                                        <div class="sn-form-group">
                                            <label>First Name</label>
                                            <input type="text" name="name" t-att-value="partner.name or ''" placeholder="John"/>
                                        </div>

                                        <div class="sn-form-group">
                                            <label>Email Address</label>
                                            <input type="email" name="email" t-att-value="partner.email or ''" placeholder="john@example.com"/>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label>Phone Number</label>
                                            <input type="tel" name="phone" t-att-value="partner.phone or ''" placeholder="+212 6 00 00 00 00"/>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label>Street Address</label>
                                            <input type="text" name="street" t-att-value="partner.street or ''" placeholder="123 Main Street"/>
                                        </div>

                                        <div class="sn-form-group">
                                            <label>City</label>
                                            <input type="text" name="city" t-att-value="partner.city or ''" placeholder="Casablanca"/>
                                        </div>

                                        <div class="sn-form-group">
                                            <label>Postal Code</label>
                                            <input type="text" name="zip" t-att-value="partner.zip or ''" placeholder="20000"/>
                                        </div>

                                    <div class="sn-form-group full">
                                        <label>Country</label>
                                        <select name="country_id">
                                            <t t-foreach="countries" t-as="country">
                                                <option t-att-value="country.id"
                                                        t-att-selected="partner.country_id and partner.country_id.id == country.id">
                                                    <t t-out="country.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>

                                    </div>

                                </div>

                                <!-- SHIPPING METHOD -->
                                <div class="sn-checkout-card" t-if="delivery_methods">

                                    <h3>Shipping Method</h3>

                                    <t t-foreach="delivery_methods" t-as="method">
                                        <label class="sn-radio-card">
                                            <input type="radio" name="carrier_id"
                                                   t-att-value="method.id"
                                                   t-att-checked="order.carrier_id and order.carrier_id.id == method.id"/>
                                            <div>
                                                <strong t-out="method.name"/>
                                                <p t-if="method.fixed_price">
                                                    <t t-out="'%.2f' % method.fixed_price"/> $
                                                </p>
                                                <p t-else="">Free</p>
                                            </div>
                                        </label>
                                    </t>

                                </div>

                                <!-- PAYMENT METHOD -->
                                <div class="sn-checkout-card" t-if="payment_providers">

                                    <h3>Payment Method</h3>

                                    <t t-foreach="payment_providers" t-as="provider">
                                        <label class="sn-radio-card">
                                            <input type="radio" name="payment_provider_id"
                                                   t-att-value="provider.id"
                                                   t-att-checked="provider.code == 'wire_transfer'"/>
                                            <div>
                                                <div class="sn-radio-title">
                                                    <strong t-out="provider.name"/>
                                                </div>
                                                <p t-if="provider.auth_msg" t-out="provider.auth_msg"/>
                                            </div>
                                        </label>
                                    </t>

                                </div>

                            </div>

                        </div>

                       <aside class="sn-checkout-summary">
                            <div class="sn-summary-card">

                                <h3>Order Summary</h3>

                                <!-- Order Lines -->
                                <t t-if="order_lines">
                                    <t t-foreach="order_lines" t-as="line">
                                        <div class="sn-summary-product">
                                            <img t-if="line.product_id.image_256"
                                                 t-att-src="'/web/image/product.product/%d/image_256' % line.product_id.id"
                                                 t-att-alt="line.product_id.name"/>
                                            <img t-else=""
                                                 src="/sneakers/static/src/img/products/product-1.jpg"
                                                 t-att-alt="line.product_id.name"/>
                                            <div>
                                                <h4 t-out="line.name"/>
                                                <span>Qty: <t t-out="line.product_uom_qty"/></span>
                                            </div>
                                            <strong t-out="'%.2f $' % line.price_subtotal"/>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <p style="color:#999;text-align:center;padding:20px 0;">Your cart is empty</p>
                                </t>

                                <!-- Totals -->
                                <div class="sn-summary-divider"/>

                                <div class="sn-summary-row">
                                    <span>Subtotal</span>
                                    <span t-out="'%.2f $' % subtotal"/>
                                </div>

                                <div class="sn-summary-row" t-if="delivery_price > 0">
                                    <span>Shipping</span>
                                    <span t-out="'%.2f $' % delivery_price"/>
                                </div>
                                <div class="sn-summary-row" t-else="">
                                    <span>Shipping</span>
                                    <span>Free</span>
                                </div>

                                <div class="sn-summary-row" t-if="tax > 0">
                                    <span>Tax</span>
                                    <span t-out="'%.2f $' % tax"/>
                                </div>

                                <div class="sn-summary-divider"/>

                                <div class="sn-summary-row sn-summary-total">
                                    <span>Total</span>
                                    <span t-out="'%.2f $' % total"/>
                                </div>

                                <!-- Place Order -->
                                <button class="sn-place-order-btn" type="submit" form="sn-checkout-form">
                                    Place Order
                                </button>

                                <!-- Back -->
                                <a href="/cart" class="sn-back-cart">
                                    ← Back to Cart
                                </a>

                            </div>

                        </aside>

                    </div>

                </div>

            </section>

        </t>

    </template>

</odoo>