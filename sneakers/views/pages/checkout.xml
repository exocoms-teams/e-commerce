<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="page_checkout" name="Sneakers Checkout">

        <t t-call="website.layout">

            <div class="oe_structure oe_empty"/>

            <!-- CHECKOUT HEADER -->
            <section class="sn-checkout-header oe_structure oe_empty">

                <div class="mn-container">

                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">
                            Checkout
                        </span>

                        <h2>
                            Complete Your Order
                        </h2>

                        <p>
                            Enter your shipping information and review your
                            order before confirming your purchase.
                        </p>

                    </div>

                </div>

            </section>

            <!-- CHECKOUT PROGRESS  -->
            <section class="sn-checkout-progress oe_structure oe_empty">

                <div class="mn-container">

                    <div class="sn-progress-container">

                        <div class="sn-progress-line"></div>

                        <div class="sn-progress-step active">

                            <div class="sn-step-circle">1</div>

                            <span>Cart</span>

                        </div>

                        <div class="sn-progress-step">

                            <div class="sn-step-circle">
                                2
                            </div>

                            <span>Address</span>

                        </div>

                        <div class="sn-progress-step">

                            <div class="sn-step-circle">
                                3
                            </div>

                            <span>Shipping</span>

                        </div>

                        <div class="sn-progress-step">

                            <div class="sn-step-circle">
                                4
                            </div>

                            <span>Payment</span>

                        </div>

                    </div>

                </div>

            </section>

            <!-- CHECKOUT CONTENT -->
            <section class="sn-checkout oe_structure oe_empty">

                <div class="mn-container">

                    <div class="sn-checkout-layout">

                        <div class="sn-checkout-form">

                            <div class="sn-checkout-form">

                                <div class="sn-checkout-card">

                                    <h3>Billing Address</h3>

                                    <div class="sn-form-grid">

                                        <div class="sn-form-group">
                                            <label>First Name</label>
                                            <input type="text" placeholder="John"/>
                                        </div>

                                        <div class="sn-form-group">
                                            <label>Last Name</label>
                                            <input type="text" placeholder="Doe"/>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label>Email Address</label>
                                            <input type="email" placeholder="john@example.com"/>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label>Phone Number</label>
                                            <input type="tel" placeholder="+212 6 00 00 00 00"/>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label>Street Address</label>
                                            <input type="text" placeholder="123 Main Street"/>
                                        </div>

                                        <div class="sn-form-group">
                                            <label>City</label>
                                            <input type="text" placeholder="Casablanca"/>
                                        </div>

                                        <div class="sn-form-group">
                                            <label>Postal Code</label>
                                            <input type="text" placeholder="20000"/>
                                        </div>

                                        <div class="sn-form-group full">
                                            <label>Country</label>
                                            <select>
                                                <option>Morocco</option>
                                                <option>France</option>
                                                <option>Spain</option>
                                            </select>
                                        </div>

                                    </div>

                                </div>

                                <!-- SHIPPING METHOD -->
                                <div class="sn-checkout-card">

                                    <h3>Shipping Method</h3>

                                    <label class="sn-radio-card">

                                        <input type="radio" name="shipping" checked="checked"/>

                                        <div>
                                            <strong>Standard Delivery</strong>
                                            <p>3-5 business days</p>
                                        </div>

                                        <span>Free</span>

                                    </label>

                                    <label class="sn-radio-card">

                                        <input type="radio" name="shipping"/>

                                        <div>
                                            <strong>Express Delivery</strong>
                                            <p>24-48 hours</p>
                                        </div>

                                        <span>$15.00</span>

                                    </label>

                                </div>

                                <!-- PAYMENT METHOD -->
                                <div class="sn-checkout-card">

                                    <h3>Payment Method</h3>

                                    <label class="sn-radio-card">
                                        <input type="radio" name="payment" value="card"/>
                                        <div>
                                            <div class="sn-radio-title">
                                                <i class="fa fa-credit-card"></i>
                                                <strong>Credit Card</strong>
                                            </div>
                                            <p>Visa, Mastercard, American Express</p>
                                        </div>
                                    </label>

                                    <label class="sn-radio-card">
                                        <input type="radio" name="payment" value="paypal"/>
                                        <div>
                                            <div class="sn-radio-title">
                                                <i class="fa fa-paypal"></i>
                                                <strong>PayPal</strong>
                                            </div>
                                            <p>Pay via your PayPal account</p>
                                        </div>
                                    </label>

                                    <label class="sn-radio-card">
                                        <input type="radio" name="payment" value="cash"/>
                                        <div>
                                            <div class="sn-radio-title">
                                                <i class="fa fa-money"></i>
                                                <strong>Cash on Delivery</strong>
                                            </div>
                                            <p>Pay when your order arrives</p>
                                        </div>
                                    </label>

                                </div>

                            </div>

                            <!-- PAYMENT DETAILS (Step 4 — affiché dynamiquement par JS) -->
                            <div class="sn-checkout-card" id="sn-card-payment-details">

                                <!-- Champs carte bancaire -->
                                <div class="sn-payment-section sn-payment-section--card">
                                    <h3>Card Details</h3>
                                    <div class="sn-form-grid">
                                        <div class="sn-form-group full">
                                            <label>Card Number</label>
                                            <input type="text" placeholder="1234  5678  9012  3456" maxlength="19"/>
                                        </div>
                                        <div class="sn-form-group">
                                            <label>Expiry Date</label>
                                            <input type="text" placeholder="MM / YY" maxlength="7"/>
                                        </div>
                                        <div class="sn-form-group">
                                            <label>CVV</label>
                                            <input type="text" placeholder="123" maxlength="4"/>
                                        </div>
                                        <div class="sn-form-group full">
                                            <label>Cardholder Name</label>
                                            <input type="text" placeholder="John Doe"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Section PayPal -->
                                <div class="sn-payment-section sn-payment-section--paypal">
                                    <h3>PayPal</h3>
                                    <p>
                                        You will complete your payment securely via PayPal.
                                        No real account required.
                                    </p>
                                    <div class="sn-paypal-mock">
                                        <i class="fa fa-paypal"/>
                                        <span>Paying via PayPal</span>
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </section>

        </t>

    </template>

</odoo>