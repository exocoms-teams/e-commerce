<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="page_product" name="Sneakers Product">

        <t t-call="website.layout">

            <!-- PRODUCT HEADER -->
            <section class="sn-product-header">

                <div class="mn-container">

                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">Premium Sneakers</span>

                        <h2>Nike Air Max 270</h2>

                        <p>

                            Discover premium comfort, lightweight cushioning and
                            a modern design made for everyday performance.

                        </p>

                    </div>

                </div>

            </section>

            <!-- PRODUCT DETAILS -->
            <section class="sn-product-details">

                <div class="mn-container">

                    <div class="sn-product-layout">

                        <!-- PRODUCT GALLERY -->
                        <div class="sn-product-gallery">

                            <div class="sn-product-main-image">

                                <img
                                    src="/sneakers/static/src/img/products/product-1.jpg"
                                    alt="Nike Air Max 270"/>

                            </div>

                            <div class="sn-product-thumbnails">
                                <div class="sn-product-thumb active">

                                    <img
                                        src="/sneakers/static/src/img/products/product-1.jpg"
                                        alt="Nike Air Max 270"/>

                                </div>

                                <div class="sn-product-thumb">

                                    <img
                                        src="/sneakers/static/src/img/products/product-2.jpg"
                                        alt="Nike Air Max 270"/>

                                </div>

                                <div class="sn-product-thumb">

                                    <img
                                        src="/sneakers/static/src/img/products/product-3.jpg"
                                        alt="Nike Air Max 270"/>

                                </div>

                                <div class="sn-product-thumb">

                                    <img
                                        src="/sneakers/static/src/img/products/product-4.jpg"
                                        alt="Nike Air Max 270"/>

                                </div>

                            </div>

                        </div>

                        <!-- PRODUCT INFORMATION -->

                        <div class="sn-product-content">

                            <!-- Product Title -->
                            <div class="sn-product-title">
                                <span class="sn-product-brand">Nike</span>

                                <h1>Air Max 270</h1>

                                <span class="sn-product-sku">

                                    SKU : NK-AM270-001

                                </span>

                            </div>

                            <!-- Rating -->
                             <div class="sn-product-rating">

                                <div class="sn-stars">

                                    <i class="fa fa-star"/>
                                    <i class="fa fa-star"/>
                                    <i class="fa fa-star"/>
                                    <i class="fa fa-star"/>
                                    <i class="fa fa-star"/>

                                </div>

                                <span class="sn-rating-value">

                                    4.9

                                </span>

                                <span class="sn-review-count">

                                    (124 Reviews)

                                </span>

                            </div>

                            <!-- Price -->
                            <div class="sn-product-price">

                                <span class="sn-current-price">

                                    $180.00

                                </span>

                                <span class="sn-old-price">

                                    $220.00

                                </span>

                                <span class="sn-discount">

                                    -18%

                                </span>

                            </div>

                            <!-- Short Description -->
                            <div class="sn-product-description-short">

                                <p>

                                    The Nike Air Max 270 combines modern style with exceptional comfort.
                                    Featuring lightweight cushioning and breathable materials,
                                    it is designed for everyday wear and athletic performance.

                                </p>

                            </div>

                            <!-- Colors -->
                            <div class="sn-product-colors">

                                <h4>Color</h4>

                                <div class="sn-color-options">

                                    <span class="sn-color active black"></span>

                                    <span class="sn-color white"></span>

                                    <span class="sn-color blue"></span>

                                    <span class="sn-color red"></span>

                                </div>

                            </div>

                            <!-- Sizes -->
                            <div class="sn-product-sizes">

                                <h4>Size</h4>

                                <div class="sn-size-options">

                                    <button>39</button>

                                    <button>40</button>

                                    <button class="active">41</button>

                                    <button>42</button>

                                    <button>43</button>

                                    <button>44</button>

                                </div>

                            </div>

                            <!-- Quantity -->
                            <div class="sn-product-quantity">

                                <h4>Quantity</h4>

                                <div class="sn-quantity-selector">

                                    <button> - </button>

                                    <input
                                        type="number"
                                        value="1"
                                        min="1"/>

                                    <button> + </button>

                                </div>

                            </div>

                            <!-- Action Buttons -->
                            <div class="sn-products-actions">

                                <button class="sn-add-cart-btn-product">

                                    Add to Cart

                                </button>

                                <button class="sn-buy-now-btn-product">

                                    Buy Now

                                </button>

                            </div>

                            <!-- Product Meta -->
                            <div class="sn-product-meta">

                                <div>

                                    <strong>Category :</strong>

                                    Running

                                </div>

                                <div>

                                    <strong>Brand :</strong>

                                    Nike

                                </div>

                                <div>

                                    <strong>Availability :</strong>

                                    In Stock

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </section>

            <!-- ========================================================= -->
            <!-- PRODUCT TABS                                              -->
