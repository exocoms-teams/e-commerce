<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="page_product" name="Sneakers Product">

        <t t-call="website.layout">

            <!-- PRODUCT HEADER -->
            <section class="sn-product-header">

                <div class="mn-container">

                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">Premium Sneakers</span>

                        <h2><t t-out="product_name"/></h2>

                        <p>

                            Discover premium comfort, lightweight cushioning and
                            a modern design made for everyday performance.

                        </p>

                    </div>

                </div>

            </section>

            <!-- PRODUCT DETAILS -->
            <section class="sn-product-details">

                <div class="mn-container">

                    <div class="sn-product-layout">

                        <!-- PRODUCT GALLERY -->
                        <div class="sn-product-gallery">

                            <div class="sn-product-main-image">

                                <img
                                    t-att-src="product_image"
                                    t-att-alt="product_name"/>

                            </div>

                            <div class="sn-product-thumbnails">
                                <div class="sn-product-thumb active">

                                    <img
                                        src="/sneakers/static/src/img/products/product-1.jpg"
                                        alt="Nike Air Max 270"/>

                                </div>

                                <div class="sn-product-thumb">

                                    <img
                                        src="/sneakers/static/src/img/products/product-2.jpg"
                                        alt="Nike Air Max 270"/>

                                </div>

                                <div class="sn-product-thumb">

                                    <img
                                        src="/sneakers/static/src/img/products/product-3.jpg"
                                        alt="Nike Air Max 270"/>

                                </div>

                                <div class="sn-product-thumb">

                                    <img
                                        src="/sneakers/static/src/img/products/product-4.jpg"
                                        alt="Nike Air Max 270"/>

                                </div>

                            </div>

                        </div>

                        <!-- PRODUCT INFORMATION -->

                        <div class="sn-product-content">

                            <!-- Product Title -->
                            <div class="sn-product-title">
                                <span class="sn-product-brand"><t t-out="product_brand"/></span>

                                <h1><t t-out="product_name"/></h1>

                                <span class="sn-product-sku" t-if="product.default_code">

                                    SKU : <t t-out="product.default_code"/>

                                </span>

                            </div>

                            <!-- Rating -->
                             <div class="sn-product-rating">

                                <div class="sn-stars">
                                    <t t-foreach="range(5)" t-as="star_index">
                                        <i t-attf-class="fa fa-star#{'' if star_index &lt; round(rating_avg) else '-o'}"/>
                                    </t>
                                </div>

                                <span class="sn-rating-value" t-if="rating_count">

                                    <t t-out="'%.1f' % rating_avg"/>

                                </span>

                                <span class="sn-review-count">
                                    <t t-if="rating_count">(<t t-out="rating_count"/> Reviews)</t>
                                    <t t-else="">No reviews yet</t>
                                </span>

                            </div>

                            <!-- Price -->
                            <div class="sn-product-price">

                                <span class="sn-current-price">

                                    <t t-out="product_price_html"/>

                                </span>

                                <span class="sn-old-price">

                                    $220.00

                                </span>

                                <span class="sn-discount">

                                    -18%

                                </span>

                            </div>

                            <!-- Short Description -->
                            <div class="sn-product-description-short" t-if="product_description">

                                <p>

                                    <t t-out="product_description"/>

                                </p>

                            </div>

                            <!-- Colors -->
                            <div class="sn-product-colors" t-if="product_color">

                                <h4>Color</h4>

                                <div class="sn-color-options">

                                    <span t-attf-class="sn-color active #{product_color_key}"></span>

                                    <span class="sn-color white"></span>

                                    <span class="sn-color blue"></span>

                                    <span class="sn-color red"></span>

                                </div>

                            </div>

                            <!-- Sizes -->
                            <div class="sn-product-sizes" t-if="product_size">

                                <h4>Size</h4>

                                <div class="sn-size-options">

                                    <button>39</button>

                                    <button>40</button>

                                    <button class="active"><t t-out="product_size"/></button>

                                    <button>42</button>

                                    <button>43</button>

                                    <button>44</button>

                                </div>

                            </div>

                            <!-- Quantity -->
                            <div class="sn-product-quantity">

                                <h4>Quantity</h4>

                                <div class="sn-quantity-selector">

                                    <button> - </button>

                                    <input
                                        type="number"
                                        value="1"
                                        min="1"/>

                                    <button> + </button>

                                </div>

                            </div>

                            <!-- Action Buttons -->
                            <div class="sn-buttons">
                                    <form t-attf-action="/cart/add/#{product.id}" method="post" class="sn-add-to-cart-form">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="sn-btn-primary">Add to Cart</button>
                                    </form>
                                    <a href="#categories" class="sn-btn-outline-wl">Buy Now</a>
                            </div>

                            <!-- Product Meta -->
                            <div class="sn-product-meta">

                                <div t-if="product_category">

                                    <strong>Category :</strong>

                                    <t t-out="product_category"/>

                                </div>

                                <div>

                                    <strong>Brand :</strong>

                                    <t t-out="product_brand"/>

                                </div>

                                <div>

                                    <strong>Availability :</strong>

                                    <t t-out="'In Stock' if product_in_stock else 'Out of Stock'"/>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </section>

            <!-- ========================================================= -->
            <!-- PRODUCT TABS                                              -->
