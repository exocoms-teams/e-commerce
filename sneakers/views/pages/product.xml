<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="page_product" name="Sneakers Product">

        <t t-call="website.layout">


            <!-- PRODUCT HEADER -->
            <section class="sn-product-header">

                <div class="mn-container">

                    <div class="sn-section-header">

                        <span class="sn-section-subtitle">
                            Premium Sneakers
                        </span>

                        <h2>
                            <t t-out="product.name"/>
                        </h2>

                        <p>
                            <t t-out="product.description_sale"/>
                        </p>

                    </div>

                </div>

            </section>


            <!-- PRODUCT DETAILS -->
            <section class="sn-product-details">

                <div class="mn-container">

                    <div class="sn-product-layout">




                        <!-- PRODUCT GALLERY -->
<div class="sn-product-gallery">


    <!-- MAIN IMAGE -->
    <div class="sn-product-main-image">

        <t t-if="product.image_1920">

            <img
                t-att-src="'/web/image/product.template/%s/image_1920' % product.id"
                t-att-alt="product.name"/>

        </t>

        <t t-elif="product.product_template_image_ids">

            <img
                t-att-src="'/web/image/product.image/%s/image_1920' % product.product_template_image_ids[0].id"
                t-att-alt="product.name"/>

        </t>

        <t t-else="">

            <img
                src="/sneakers/static/src/img/products/product-1.jpg"
                t-att-alt="product.name"/>

        </t>

    </div>



    <!-- THUMBNAILS -->
    <div class="sn-product-thumbnails">


        <!-- Image principale -->
        <t t-if="product.image_1920">

            <div class="sn-product-thumb active">

                <img
                    t-att-src="'/web/image/product.template/%s/image_1920' % product.id"
                    t-att-alt="product.name"/>

            </div>

        </t>



        <!-- Images eCommerce Media -->

        <t t-foreach="product.product_template_image_ids"
           t-as="image">

            <div class="sn-product-thumb">

                <img
                    t-att-src="'/web/image/product.image/%s/image_1920' % image.id"
                    t-att-alt="product.name"/>

            </div>

        </t>


    </div>


</div>



                        <!-- PRODUCT INFORMATION -->
                        <div class="sn-product-content">


                            <!-- TITLE -->

                            <div class="sn-product-title">

                                <span class="sn-product-brand">

                                    <t t-out="product.brand_id.name"/>

                                </span>


                                <h1>
                                    <t t-out="product.name"/>
                                </h1>


                                <span class="sn-product-sku">

                                    SKU :
                                    <t t-out="product.default_code"/>

                                </span>

                            </div>



                            <!-- Rating -->

                            <div class="sn-product-rating">

                                <div class="sn-stars">

                                    <i class="fa fa-star"/>
                                    <i class="fa fa-star"/>
                                    <i class="fa fa-star"/>
                                    <i class="fa fa-star"/>
                                    <i class="fa fa-star"/>

                                </div>


                                <span class="sn-rating-value">
                                    4.9
                                </span>


                                <span class="sn-review-count">
                                    Reviews
                                </span>


                            </div>



                            <!-- PRICE -->

                            <div class="sn-product-price">


                                <span class="sn-current-price">

                                    $
                                    <t t-out="product.list_price"/>

                                </span>


                                <t t-if="product.old_price">

                                    <span class="sn-old-price">

                                        $
                                        <t t-out="product.old_price"/>

                                    </span>

                                </t>



                            </div>



                            <!-- DESCRIPTION -->

                            <div class="sn-product-description-short">

                                <p>

                                    <t t-out="product.description_sale"/>

                                </p>

                            </div>
<!-- COLORS -->
<div class="sn-product-colors">

    <h4>Color</h4>

    <div class="sn-color-options">

        <span class="sn-color active black"></span>
        <span class="sn-color white"></span>
        <span class="sn-color blue"></span>
        <span class="sn-color red"></span>

    </div>

</div>


<!-- SIZES -->
<div class="sn-product-sizes">

    <h4>Size</h4>

    <div class="sn-size-options">

        <button>39</button>
        <button>40</button>
        <button class="active">41</button>
        <button>42</button>
        <button>43</button>
        <button>44</button>

    </div>

</div>


<!-- QUANTITY -->
<div class="sn-product-quantity">

    <h4>Quantity</h4>


    <div class="sn-quantity-selector">


        <button class="sn-qty-btn"
                data-action="decrease">
            -
        </button>



        <input
            class="sn-qty-input"
            type="number"
            value="1"
            min="1"
            max="99"/>



        <button class="sn-qty-btn"
                data-action="increase">
            +
        </button>


    </div>

</div>



<!-- BUTTONS -->
<div class="sn-buttons">

    <button
        type="button"
        class="sn-btn-primary sn-add-to-cart-btn"
        t-att-data-product-id="product.product_variant_id.id">

        Add to Cart

    </button>

    <a href="#categories"
       class="sn-btn-outline-wl">
        Buy Now
    </a>

</div>



<!-- PRODUCT META -->
<div class="sn-product-meta">


    <div>

        <strong>Category :</strong>

        <t t-foreach="product.public_categ_ids"
           t-as="category">

            <span>
                <t t-out="category.name"/>
            </span>

        </t>

    </div>



    <div>

        <strong>Brand :</strong>

        <t t-out="product.brand_id.name"/>

    </div>



    <div>

    

    <strong>Availability :</strong>

    In Stock


    </div>


</div>


</div>
</div>
</div>
</section>



<!-- PRODUCT TABS -->

<section class="sn-product-tabs">

    <div class="mn-container">

        <div class="sn-tabs">


            <button class="sn-tab-btn active"
                    data-tab="description"
                    aria-selected="true">

                Description

            </button>


            <button class="sn-tab-btn"
                    data-tab="specifications"
                    aria-selected="false">

                Specifications

            </button>


            <button class="sn-tab-btn"
                    data-tab="reviews"
                    aria-selected="false">

                Reviews

            </button>


        </div>



        <div id="tab-description"
             class="sn-tab-panel active">

            <p>
                <t t-out="product.description_sale"/>
            </p>

        </div>



        <div id="tab-specifications"
             class="sn-tab-panel"
             hidden="hidden">

            <p>
                <strong>Brand:</strong>
                <t t-out="product.brand_id.name"/>
            </p>


            <p>
                <strong>SKU:</strong>
                <t t-out="product.default_code"/>
            </p>


            <p>
                <strong>Price:</strong>
                <t t-out="product.list_price"/>
            </p>

        </div>



        <div id="tab-reviews"
             class="sn-tab-panel"
             hidden="hidden">

            <p>
                No reviews available yet.
            </p>

        </div>


    </div>

</section>



            <!-- RELATED PRODUCTS -->

            <section class="sn-related-products">


            <div class="mn-container">


            <div class="sn-section-header"
                style="text-align:center;margin-bottom:45px;">


            <span class="sn-section-subtitle">

            You May Also Like

            </span>


            <h2>

            Related Products

            </h2>


            </div>



            <div class="sn-products-grid">


            <t t-foreach="similar_products" t-as="product">
                <t t-call="sneakers.product_card">
                    <t t-set="product" t-value="product"/>
                </t>
            </t>


            </div>


            </div>


            </section>



</t>

</template>

</odoo>