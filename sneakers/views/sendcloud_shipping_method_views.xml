<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_sendcloud_shipping_method_tree" model="ir.ui.view">

        <field name="name">sendcloud.shipping.method.tree</field>

        <field name="model">sendcloud.shipping.method</field>

        <field name="arch" type="xml">

            <list>
                <field name="name"/>
                <field name="sendcloud_id"/>
                <field name="carrier"/>
                <field name="min_weight"/>
                <field name="max_weight"/>
            </list>

        </field>

    </record>


    <record id="view_sendcloud_shipping_method_form" model="ir.ui.view">

        <field name="name">sendcloud.shipping.method.form</field>

        <field name="model">sendcloud.shipping.method</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>

                        <field name="name"/>
                        <field name="sendcloud_id"/>
                        <field name="carrier"/>
                        <field name="min_weight"/>
                        <field name="max_weight"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


</odoo>
