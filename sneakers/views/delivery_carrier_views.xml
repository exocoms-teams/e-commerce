<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_delivery_carrier_form_sendcloud" model="ir.ui.view">

        <field name="name">delivery.carrier.form.sendcloud</field>

        <field name="model">delivery.carrier</field>

        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='delivery_type']" position="after">

                <field name="sendcloud_public_key" string="SendCloud Public Key" invisible="delivery_type != 'sendcloud'"/>

                <field name="sendcloud_secret_key" string="SendCloud Secret Key" password="True" invisible="delivery_type != 'sendcloud'"/>

                <field name="sendcloud_shipping_method_id" string="SendCloud Shipping Method" domain="[]" invisible="delivery_type != 'sendcloud'"/>

                <field name="sendcloud_test_result" invisible="delivery_type != 'sendcloud'" readonly="1"/>

                <button
                    name="action_test_sendcloud_connection"
                    type="object"
                    string="Test SendCloud Connection"
                    class="btn-primary"
                    invisible="delivery_type != 'sendcloud'"
                />

                <button
                    name="action_import_sendcloud_shipping_methods"
                    type="object"
                    string="Import Shipping Methods"
                    class="btn-secondary"
                    invisible="delivery_type != 'sendcloud'"
                />

            </xpath>

        </field>

    </record>

</odoo>
