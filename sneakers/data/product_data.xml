<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ========================= -->
    <!-- RUNNING -->
    <!-- ========================= -->

    <record id="product_nike_air_max_270" model="product.template">
        <field name="name">Nike Air Max 270</field>
        <field name="default_code">NK-AM270-001</field>
        <field name="list_price">180.00</field>
        <field name="old_price">220.00</field>
        <field name="badge">NEW</field>
        <field name="description_sale">
            Nike Air Max 270 combines modern style with exceptional comfort,
            lightweight cushioning and breathable materials.
        </field>
        <field name="brand_id" ref="brand_nike"/>
        <field name="public_categ_ids"
               eval="[(6,0,[ref('category_running')])]"/>
    </record>


